    (hEdge : f.edge ≠ e.edge) (dir : Bool)
    (havoid : e.edge ∉
      (sourceLemma34_orientedSide G (sourceLemma34_reducedCycle G C hC e earDir)
        (sourceLemma34_reducedCycle_isCycle G C hC e earDir)
        (sourceLemma34_restrictChord G C hC e earDir f hfst hsnd hEdge) dir).path.edges) :
