/-- The escaping edge is deliberately the edge from the central owner's
designated root to the escaping K4 vertex.  Its endpoints are kept in the
owner-labelled K4 for the later component replacement. -/
private noncomputable def sourceLemma38EscapingChord
    [Fintype V] [DecidableEq V] {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (n : ℕ)
    (family : SourceLemma38RootedK4Family G C n) (k : ℕ) (hk : 1 ≤ k)
    (Z : Finset V) (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2))
    (sectionOwner : Fin (4 * k^2) → Fin n)
    (hrootOwner : ∀ j, family.root (sectionOwner j) = ladder.firstVertex j)
    (i : Fin k) (x : V)
    (hxK4 : x ∈ family.vertices (sourceLemma38CentralOwner k hk sectionOwner i))
    (hxOutside : x ∉ (sourceLemma38Qu G C k hk Z data iP matching ladder i).support ∧
      x ∉ (sourceLemma38Qv G C k hk Z data iP matching ladder i).support) :
    SourceLemma34Chord G C := by
  let owner := sourceLemma38CentralOwner k hk sectionOwner i
  have hrootEq : family.root owner = ladder.firstVertex
      (sourceLemma38CentralRungIndex k hk i) := by
    exact hrootOwner _
  have hrootQu : family.root owner ∈
      (sourceLemma38Qu G C k hk Z data iP matching ladder i).support := by
    rw [hrootEq]
    exact sourceLemma38_firstVertex_mem_Qu_of_block G C k hk Z data iP matching ladder i
      (sourceLemma38CentralRungIndex k hk i)
      (sourceLemma38_block_indices k hk i).1
      (sourceLemma38_block_indices k hk i).2.1.le
  have hne : family.root owner ≠ x := by
    intro h
    exact hxOutside.1 (by simpa [h] using hrootQu)
  exact {
    fst := family.root owner
    snd := x
    fst_mem := hC.mem_support _
    snd_mem := hC.mem_support _
    adj := family.complete owner (family.root_mem owner) hxK4 hne
    not_cycle_edge := family.off_cycle owner (family.root_mem owner) hxK4 hne }

/-- Both displayed endpoints of the escaping chord retain their central
owner's K4 provenance. -/
private theorem sourceLemma38_escapingChord_owner_endpoints
    [Fintype V] [DecidableEq V] {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (n : ℕ)
