/-- A source Section-2 ladder, expressed in the two cycle coordinates already
certified by the increasing Lemma-3.6 construction.  The first coordinate is
the anchor-rotated cycle order and the second is its complementary boundary
order.  Reversing the residual indexing makes these respectively the
`u₁,…,uₖ` and `vₖ,…,v₁` visits from the printed definition. -/
private structure SourceLemma36Section2Ladder [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) (n : ℕ) where
  cycle : G.Walk r r
  cycle_def : cycle = C
  cycle_isCycle : cycle.IsCycle
  firstVertex : Fin n → V
  secondVertex : Fin n → V
  rung : ∀ i, G.Walk (firstVertex i) (secondVertex i)
  rung_isPath : ∀ i, (rung i).IsPath
  rung_length_one : ∀ i, (rung i).length = 1
  rung_off_cycle : ∀ i, s(firstVertex i, secondVertex i) ∉ cycle.edges
  rung_internal_disjoint_cycle : ∀ i,
    Disjoint (internalVertices G (rung i)) {v | v ∈ cycle.support}
  rung_disjoint : ∀ i j, i ≠ j →
    Disjoint (↑(rung i).support.toFinset : Set V) (↑(rung j).support.toFinset : Set V)
  first_on_cycle : ∀ i, firstVertex i ∈ cycle.support
  second_on_cycle : ∀ i, secondVertex i ∈ cycle.support
  firstPosition : Fin n →
    Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length
  secondPosition : Fin n →
    Fin (sourceLemma36ComplementOrderAt G C hC k Z data iP).length
  firstPosition_vertex : ∀ i,
    (sourceLemma36RotatedCycleOrder G C data.anchor).get (firstPosition i) = firstVertex i
  secondPosition_vertex : ∀ i,
    (sourceLemma36ComplementOrderAt G C hC k Z data iP).get (secondPosition i) =
      secondVertex i
  /-- The first rail is entirely in the allocated canonical interval.  Together
  with `second_outside_canonical`, this is the missing bridge from the two
  linear coordinates to the printed cyclic ladder order. -/
  first_in_canonical : ∀ i,
    firstVertex i ∈ sourceLemma36CanonicalPieceVertices G C hC k Z data iP
  /-- The second rail is entirely in the complementary interval. -/
  second_outside_canonical : ∀ i,
    secondVertex i ∉ sourceLemma36CanonicalPieceVertices G C hC k Z data iP
  first_arc_order : ∀ i j, i < j → firstPosition i < firstPosition j
  second_arc_order : ∀ i j, i < j → secondPosition j < secondPosition i

/-- A length-one walk has no internal vertices.  This is the exact reason the
residual chord rungs satisfy Section 2's internal-disjointness requirement. -/
private theorem sourceLemma36_internalVertices_empty_of_length_one
    {u v : V} (P : G.Walk u v) (hP : P.length = 1) :
    internalVertices G P = ∅ := by
  cases P with
  | nil => simp at hP
  | cons huv Q =>
    cases Q with
    | nil =>
      apply Set.eq_empty_iff_forall_not_mem.mpr
      intro x hx
      change x ∈ (Walk.cons huv Walk.nil).support ∧ x ≠ _ ∧ x ≠ _ at hx
      simp only [Walk.support_cons, Walk.support_nil, List.mem_cons,
        List.not_mem_nil, or_false] at hx
      rcases hx.1 with h | h
      · exact hx.2.1 h
      · exact hx.2.2 h
    | cons hvw R => simp [Walk.length_cons] at hP

/-- The residual increasing `4k²` ladder is already a genuine source
Section-2 ladder: each selected matching edge is represented by its literal
one-edge path, and reversal of the residual numbering gives the printed
cyclic endpoint order. -/
private noncomputable def sourceLemma36_fourKSquaredLadder_to_section2
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching) :
    SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2) := by
  refine {
    cycle := ladder.cycle
    cycle_def := ladder.cycle_def
    cycle_isCycle := ladder.cycle_isCycle
    firstVertex := fun i => ladder.firstVertex i.rev
    secondVertex := fun i => ladder.secondVertex i.rev
    rung := fun i => ladder.rung i.rev
    rung_isPath := fun i => ladder.rung_isPath i.rev
    rung_length_one := fun i => ladder.rung_length i.rev
    rung_off_cycle := by
      intro i
      rw [ladder.cycle_def]
      exact ladder.rung_off_cycle i.rev
    rung_internal_disjoint_cycle := by
      intro i
      rw [sourceLemma36_internalVertices_empty_of_length_one G (ladder.rung i.rev)
        (ladder.rung_length i.rev)]
      exact Set.empty_disjoint _
    rung_disjoint := by
      intro i j hij
      apply ladder.rung_disjoint i.rev j.rev
      intro h
      apply hij
      exact Fin.rev_injective h
    first_on_cycle := fun i => ladder.first_on_cycle i.rev
    second_on_cycle := fun i => ladder.second_on_cycle i.rev
    firstPosition := fun i => ladder.firstPosition i.rev
    secondPosition := fun i => ladder.secondPosition i.rev
    firstPosition_vertex := fun i => ladder.firstPosition_vertex i.rev
    secondPosition_vertex := fun i => ladder.secondPosition_vertex i.rev
    first_in_canonical := by
      intro i
      have hcandidate : (ladder.selection.edge i.rev).1 ∈
          sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP :=
        matching.matching.1 (ladder.selection.edge i.rev).2
      have hroot := (sourceLemma36_mem_caseB_candidateAt_iff
        G C hC k Z data iP (ladder.selection.edge i.rev)).mp hcandidate |>.1
      rw [ladder.firstVertex_def]
      exact (sourceLemma36_mem_caseB_rootsAt_iff
        G C hC k Z data iP _).mp hroot |>.2
    second_outside_canonical := by
      intro i
      have hcandidate : (ladder.selection.edge i.rev).1 ∈
          sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP :=
        matching.matching.1 (ladder.selection.edge i.rev).2
      rw [ladder.secondVertex_def]
      exact (sourceLemma36_mem_caseB_candidateAt_iff
        G C hC k Z data iP (ladder.selection.edge i.rev)).mp hcandidate |>.2.2
    first_arc_order := by
      intro i j hij
      have hrev : j.rev < i.rev := Fin.rev_lt_rev.mpr hij
      exact ladder.first_arc_order _ _ hrev
    second_arc_order := by
      intro i j hij
      have hrev : j.rev < i.rev := Fin.rev_lt_rev.mpr hij
      exact ladder.second_arc_order _ _ hrev }

/-- The bridge exposes all of the current residual ladder as a Section-2
ladder without adding rootedness or any claim about a later crossing chord. -/
private theorem sourceLemma36_fourKSquaredLadder_section2_bridge
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching) :
    Nonempty (SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2)) :=
  ⟨sourceLemma36_fourKSquaredLadder_to_section2 G C k Z data iP matching ladder⟩

/-- Restrict a certified Section-2 ladder to any increasing family of rungs.
The source high-crossing argument uses exactly this operation after ordering
the rungs crossed by its chosen chord. -/
private noncomputable def sourceLemma36Section2Ladder_restrict
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    {m n : ℕ} (ladder : SourceLemma36Section2Ladder G C k Z data iP matching n)
    (select : Fin m → Fin n) (hselect : StrictMono select) :
    SourceLemma36Section2Ladder G C k Z data iP matching m := by
  refine {
    cycle := ladder.cycle
    cycle_def := ladder.cycle_def
    cycle_isCycle := ladder.cycle_isCycle
    firstVertex := fun i => ladder.firstVertex (select i)
    secondVertex := fun i => ladder.secondVertex (select i)
    rung := fun i => ladder.rung (select i)
    rung_isPath := fun i => ladder.rung_isPath (select i)
    rung_length_one := fun i => ladder.rung_length_one (select i)
    rung_off_cycle := fun i => ladder.rung_off_cycle (select i)
    rung_internal_disjoint_cycle := fun i => ladder.rung_internal_disjoint_cycle (select i)
    rung_disjoint := by
      intro i j hij
      apply ladder.rung_disjoint (select i) (select j)
      intro h
      exact hij (hselect.injective h)
    first_on_cycle := fun i => ladder.first_on_cycle (select i)
    second_on_cycle := fun i => ladder.second_on_cycle (select i)
    firstPosition := fun i => ladder.firstPosition (select i)
    secondPosition := fun i => ladder.secondPosition (select i)
    firstPosition_vertex := fun i => ladder.firstPosition_vertex (select i)
    secondPosition_vertex := fun i => ladder.secondPosition_vertex (select i)
    first_in_canonical := fun i => ladder.first_in_canonical (select i)
    second_outside_canonical := fun i => ladder.second_outside_canonical (select i)
    first_arc_order := fun i j hij => ladder.first_arc_order _ _ (hselect hij)
    second_arc_order := fun i j hij => ladder.second_arc_order _ _ (hselect hij) }

/-- The final index of a nonempty restricted ladder. -/
