            (sourceLemma35RetainedCycle G C hC) k Z data iP matching ladder
            (selected t) (partner (selected t))) ∨
        (∃ selected : Fin k → Fin (2 * k - 1), StrictMono selected ∧
          ∀ t, sourceLemma37CrossSide (sourceLemma35Graph G C hC)
            (sourceLemma35RetainedCycle G C hC) k Z data iP matching ladder
            (selected t) (partner (selected t)))) := by
  apply sourceLemma37_homogeneous_block_family_of_crossing_partners
    (sourceLemma35Graph G C hC) (sourceLemma35RetainedCycle G C hC)
    k hk Z data iP matching ladder
