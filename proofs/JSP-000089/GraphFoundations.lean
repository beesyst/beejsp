        simpa using hQuQv.2
    · rcases hxa with hxa | hxa
      · right
        rw [hxa]
        simpa using hQvQu.1
      · left
        rw [hxa]
        simpa using hQvQu.2
  have hxbCarrier :
      x ∈ (↑(sourceLemma37Qu G C k Z data iP matching ladder
