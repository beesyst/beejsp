      · exact sourceLemma38_mem_Qu_cycle G C k hk Z data iP matching ladder i hQu.2
      · exact sourceLemma38_mem_Qv_cycle G C k hk Z data iP matching ladder i hQv.2
    adj := family.complete owner hx hy hxy
    not_cycle_edge := family.off_cycle owner hx hy hxy }
  refine ⟨chord, owner, rfl, ?_, ?_, ?_⟩
  · exact hx
