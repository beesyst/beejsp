    nlinarith
  obtain ⟨Q, hQA, hQcard⟩ := Finset.exists_subset_card_eq hmany
  let e : Fin (24 * sourceLemma36_c k) ≃ {a // a ∈ Q} :=
    (Finset.equivFinOfCardEq hQcard).symm
  have hrepr : ∀ a : {a // a ∈ Q}, ∃ v, v ∈ P ∧ f v = a.val := by
    intro a
    exact Finset.mem_image.mp (hQA a.property)
  choose vertex hvertex using hrepr
  refine ⟨fun i => (e i).val, fun i => vertex (e i), ?_, ?_, ?_⟩
  · intro i j hij
    exact e.injective (Subtype.ext hij)
  · intro i j hij
    apply e.injective
    apply Subtype.ext
    exact (hvertex (e i)).2.symm.trans
      ((congrArg f hij).trans (hvertex (e j)).2)
  · intro i
    refine ⟨hPmem _ (hvertex (e i)).1, ?_⟩
    change sourceLemma31ComponentAdjacent G C (e i).val (vertex (e i))
    rw [← (hvertex (e i)).2]
    exact hf _ (hvertex (e i)).1

