    dsimp only [root]
    cases E <;> simp [Walk.dropUntil]
  have hrot : E.rotate E.start_mem_support = E := by
    change (E.dropUntil root _).append (E.takeUntil root _) = E
    rw [hdrop]
    simp only [root, Walk.takeUntil_first, Walk.append_nil]
  have hs : E.support = L ++ [root] := by
    simpa only [hrot] using sourceLemma36_rotate_support_eq_order_append_anchor H E hE root E.start_mem_support
  have hmap : E.support.map Subtype.val = D.support := by
    exact (Walk.support_map f E).symm.trans
      (congrArg Walk.support (sourceLemma39_inducedCycle_map G D))
  obtain ⟨p, hp⟩ := sourceLemma37_exists_rotatedCycleOrder_position H E hE root x
  obtain ⟨q, hq⟩ := sourceLemma37_exists_rotatedCycleOrder_position H E hE root y
  obtain ⟨t, ht⟩ := sourceLemma37_exists_rotatedCycleOrder_position H E hE root w
  have idx (v : sourceLemma39CycleVertices G D) (i : Fin L.length) (hi : L.get i = v) :
      D.support.idxOf v.val = i.val := by
    calc
      D.support.idxOf v.val = (E.support.map Subtype.val).idxOf v.val :=
