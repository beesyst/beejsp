/-- Once actual central-rung crossing partners are supplied, the `2k - 1`
blocks either already contain a crossed buffer, or contain an ordered family
of `k` same-side or cross-side partners. -/
private theorem sourceLemma37_homogeneous_block_family_of_crossing_partners
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching)
    (hpartner : ∀ i : Fin (2 * k - 1), ∃ f : SourceLemma34Chord G C,
      sourceLemma34Crosses G C hC.isCycle
        (sourceLemma37CentralRungChord G C k hk Z data iP matching ladder i) f) :
    ∃ partner : Fin (2 * k - 1) → SourceLemma34Chord G C,
      (∀ i, sourceLemma34Crosses G C hC.isCycle
        (sourceLemma37CentralRungChord G C k hk Z data iP matching ladder i) (partner i)) ∧
      ((∃ i, sourceLemma37BlockCrossladder G C k hk Z data iP matching ladder i) ∨
        (∃ selected : Fin k → Fin (2 * k - 1), StrictMono selected ∧
          ∀ t, sourceLemma37SameSide G C k Z data iP matching ladder
            (selected t) (partner (selected t))) ∨
        (∃ selected : Fin k → Fin (2 * k - 1), StrictMono selected ∧
          ∀ t, sourceLemma37CrossSide G C k Z data iP matching ladder
            (selected t) (partner (selected t)))) := by
