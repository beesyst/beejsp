    have hordered := net.blocks.orderedFibre_length
    have hsub := net.blocks.orderedFibre_sublist_path.length_le
    change net.blocks.orderedFibre.length ≤ geom.x_y_path.val.support.length at hsub
    rw [Walk.length_support] at hsub
