      exact hne hidx.symm

/-- The repaired residual 4k²-ladder branch of Lemma 3.8 retains exactly the
K4/component-labelled alternatives needed by the later lifting argument.
This deliberately does not claim the unsupported published rooted conclusion. -/
private inductive SourceLemma38ResidualLabelledResult
    [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsHamiltonianCycle)
    (n k : ℕ)
    (family : SourceLemma38RootedK4Family G C n)
    (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z)
    (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder :
      SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2))
    (sectionOwner : Fin (4 * k^2) → Fin n) : Prop where

  | crossladder :
      Nonempty
        (SourceLemma38LabelledCrossladder
          G C n k family hk Z data iP matching ladder sectionOwner) →
      SourceLemma38ResidualLabelledResult
        C hC n k family hk Z data iP matching ladder sectionOwner

  | truncation :
      Nonempty
        (SourceLemma38LabelledUnrootedTruncationData
          G C n k family hk Z data iP matching ladder sectionOwner) →
      SourceLemma38ResidualLabelledResult
        C hC n k family hk Z data iP matching ladder sectionOwner


/-- Complete the repaired labelled dichotomy for the residual 4k²-ladder
branch: either one central-owner K4 escapes its two block arcs and yields a
labelled k-crossladder, or every central-owner K4 is contained in its two
block arcs and yields the labelled same-side truncation data. -/
private theorem sourceLemma38_residual_labelled_complete
    [Fintype V] [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r)
    (hC : C.IsHamiltonianCycle)
    (n : ℕ)
    (family : SourceLemma38RootedK4Family G C n)
    (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z)
    (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder :
      SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2))
    (sectionOwner : Fin (4 * k^2) → Fin n)
    (hsectionOwner : Function.Injective sectionOwner)
    (hrootOwner :
      ∀ j, family.root (sectionOwner j) = ladder.firstVertex j)
    (hfirstOwner :
      ∀ j, ladder.firstVertex j ∈ family.vertices (sectionOwner j))
    (hsecondOwner :
      ∀ j, ladder.secondVertex j ∈ family.vertices (sectionOwner j)) :
    SourceLemma38ResidualLabelledResult
      (G := G) C hC n k family hk Z data iP matching ladder sectionOwner := by
  classical

  by_cases hinside :
      ∀ i : Fin k, ∀ x,
        x ∈ family.vertices
            (sourceLemma38CentralOwner k hk sectionOwner i) →
          x ∈ (sourceLemma38Qu
              G C k hk Z data iP matching ladder i).support ∨
          x ∈ (sourceLemma38Qv
              G C k hk Z data iP matching ladder i).support

  · exact .truncation
      ⟨sourceLemma38_allInside_labelled_unrooted_truncation
        G C n k family hk Z data iP matching ladder
        sectionOwner hsectionOwner hinside⟩

  · push_neg at hinside
    obtain ⟨i, x, hxK4, hxQu, hxQv⟩ := hinside

    exact .crossladder
      (sourceLemma38_escaping_k4_yields_labelled_crossladder
        G C n family k hk Z data iP matching ladder
        sectionOwner hsectionOwner hrootOwner hfirstOwner hsecondOwner
        i x hxK4 ⟨hxQu, hxQv⟩)

/-- The repaired all-inside conclusion retains the actual proper truncation
and the K4 owner of both endpoints after the selected blocks have been
re-enumerated in their common cyclic order.  In particular, no rootedness
claim is made for a same-side chord. -/
private structure SourceLemma38LabelledProperTruncation [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (n k : ℕ)
    (family : SourceLemma38RootedK4Family G C n) where
  truncation : SourceLemma37UnrootedProperTruncation G C hC k
  chord : Fin k → SourceLemma34Chord G C
  chord_left_endpoint : ∀ t,
    (sourceLemma36RotatedCycleOrder G C truncation.anchor).get (truncation.leftPosition t) =
      (chord t).fst
  chord_right_endpoint : ∀ t,
    (sourceLemma36RotatedCycleOrder G C truncation.anchor).get (truncation.rightPosition t) =
      (chord t).snd
  owner : Fin k → Fin n
  owner_injective : Function.Injective owner
  fst_owner : ∀ t, (chord t).fst ∈ family.vertices (owner t)
  snd_owner : ∀ t, (chord t).snd ∈ family.vertices (owner t)

