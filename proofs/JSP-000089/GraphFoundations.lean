    Nonempty (SourceLemma39ZeroOutsideBranchResult G C k hk) ∨
      SourceLemma39AmbientOrSpectrum G C k := by
  by_cases hY : 4 * C.length ≤ 9 * (sourceLemma31ZeroOutsideVertices G C).card
  · exact Or.inl (sourceLemma39_zeroOutside_branch_complete G C hLongest.1 k hk
      hY hdegree hlarge hgirth)
  · have hZ : 9 * (sourceLemma31ZeroOutsideVertices G C).card < 4 * C.length := by omega
    obtain ⟨shadow⟩ := sourceLemma39_branchII_shadow_application_complete
