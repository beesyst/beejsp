/-- The representation-consistent all-inside enumeration is the decreasing
`Qv` block list followed by the increasing `Qu` block list. -/
private theorem sourceLemma38_sameSide_ordered_entries
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (n k : ℕ)
    (family : SourceLemma38RootedK4Family G C n) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2))
    (sectionOwner : Fin (4 * k^2) → Fin n)
    (truncData : SourceLemma38LabelledUnrootedTruncationData
      G C n k family hk Z data iP matching ladder sectionOwner) :
    ∃ orderedEntries : List (Fin k),
      orderedEntries =
        ((List.finRange k).filter (fun t =>
          (truncData.selected t).chord.fst ∈
              (sourceLemma38Qv G C k hk Z data iP matching ladder t).support ∧
            (truncData.selected t).chord.snd ∈
              (sourceLemma38Qv G C k hk Z data iP matching ladder t).support)).reverse ++
          (List.finRange k).filter (fun t =>
            (truncData.selected t).chord.fst ∈
                (sourceLemma38Qu G C k hk Z data iP matching ladder t).support ∧
              (truncData.selected t).chord.snd ∈
                (sourceLemma38Qu G C k hk Z data iP matching ladder t).support) ∧
      orderedEntries.Nodup ∧ orderedEntries.toFinset = Finset.univ ∧
      orderedEntries.length = k := by
  classical
  let qv : Fin k → Prop := fun t =>
    (truncData.selected t).chord.fst ∈
        (sourceLemma38Qv G C k hk Z data iP matching ladder t).support ∧
      (truncData.selected t).chord.snd ∈
        (sourceLemma38Qv G C k hk Z data iP matching ladder t).support
  let qu : Fin k → Prop := fun t =>
    (truncData.selected t).chord.fst ∈
        (sourceLemma38Qu G C k hk Z data iP matching ladder t).support ∧
      (truncData.selected t).chord.snd ∈
        (sourceLemma38Qu G C k hk Z data iP matching ladder t).support
  let qvEntries := (List.finRange k).filter qv
  let quEntries := (List.finRange k).filter qu
  let orderedEntries := qvEntries.reverse ++ quEntries
  have hsplit : ∀ t : Fin k, qv t ∨ qu t := by
    intro t
    rcases (truncData.selected t).same_side with hqu | hqv
    · exact Or.inr hqu
    · exact Or.inl hqv
  have hdisjoint : ∀ t : Fin k, ¬ (qv t ∧ qu t) := by
    intro t hboth
    exact (sourceLemma38_mem_Qv_outside_canonical G C k hk Z data iP matching ladder t
      (truncData.selected t).chord.fst hboth.1.1)
      (sourceLemma38_mem_Qu_canonical G C k hk Z data iP matching ladder t
        (truncData.selected t).chord.fst hboth.2.1)
  have hqvNodup : qvEntries.Nodup := (List.nodup_finRange k).filter _
  have hquNodup : quEntries.Nodup := (List.nodup_finRange k).filter _
  have hentriesDisjoint : List.Disjoint qvEntries quEntries := by
    rw [List.disjoint_left]
    intro t htqv htqu
    exact hdisjoint t ⟨by simpa [qvEntries] using htqv, by simpa [quEntries] using htqu⟩
  have horderedNodup : orderedEntries.Nodup := by
    apply List.Nodup.append (List.nodup_reverse.mpr hqvNodup) hquNodup
    exact List.disjoint_reverse_left.mpr hentriesDisjoint
  have horderedMem : ∀ t : Fin k, t ∈ orderedEntries := by
    intro t
    rcases hsplit t with hqv | hqu
    · apply List.mem_append.mpr
      left
      rw [List.mem_reverse]
      exact List.mem_filter_of_mem (List.mem_finRange t) (Bool.decide_true hqv)
    · apply List.mem_append.mpr
      right
      exact List.mem_filter_of_mem (List.mem_finRange t) (Bool.decide_true hqu)
  have horderedToFinset : orderedEntries.toFinset = Finset.univ := by
    apply Finset.eq_univ_of_forall
    intro t
    exact List.mem_toFinset.mpr (horderedMem t)
  have horderedLength : orderedEntries.length = k := by
    have hcard := List.toFinset_card_of_nodup horderedNodup
    rw [horderedToFinset] at hcard
    simpa using hcard.symm
  refine ⟨orderedEntries, ?_, horderedNodup, horderedToFinset, horderedLength⟩
  rfl

/-- The finite-list enumeration of the corrected order is injective. -/
