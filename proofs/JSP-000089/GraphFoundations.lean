/-- Interval membership gives the precise printed rail order, not merely
membership on two unspecified cycle segments. -/
private theorem sourceLemma39_section2_rail_intervals
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) {n : ℕ}
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching n) :
    let hf := fun i => (show ladder.firstVertex i ∈ C.support by
      simpa only [ladder.cycle_def] using ladder.first_on_cycle i)
    let hs := fun i => (show ladder.secondVertex i ∈ C.support by
      simpa only [ladder.cycle_def] using ladder.second_on_cycle i)
    (∀ i j t, i ≤ j → (ladder.firstVertex t ∈
      (sourceOrientedCycleSubpath G C (hf i) (hf j)).support ↔ i ≤ t ∧ t ≤ j)) ∧
    (∀ i j t, i ≤ j → (ladder.secondVertex t ∈
      (sourceOrientedCycleSubpath G C (hs j) (hs i)).support ↔ i ≤ t ∧ t ≤ j)) := by
  dsimp only
  have hm : StrictMono ladder.firstPosition := fun i j => ladder.first_arc_order i j
  have ha : StrictAnti ladder.secondPosition := fun i j => ladder.second_arc_order i j
  constructor
  · intro i j t hij
    rw [← sourceOrientedCycleSubpath_support_congr G C
      (sourceLemma36_rotatedPosition_mem_cycle G C hC data.anchor (ladder.firstPosition i))
      (sourceLemma36_rotatedPosition_mem_cycle G C hC data.anchor (ladder.firstPosition j))
      _ _ (ladder.firstPosition_vertex i) (ladder.firstPosition_vertex j)]
    change ladder.firstVertex t ∈ (sourceLemma36RotatedPositionSubpath G C hC
      data.anchor (ladder.firstPosition i) (ladder.firstPosition j)).support ↔ _
    rw [sourceLemma36_mem_positionSubpath_iff G C hC _ _ _ (hm.monotone hij)]
    constructor
    · rintro ⟨p, hip, hpj, hp⟩
      have heq : p = ladder.firstPosition t :=
        (List.nodup_iff_injective_get.mp (sourceLemma36_rotatedCycleOrder_nodup G C hC _))
          (hp.trans (ladder.firstPosition_vertex t).symm)
      subst p
      exact ⟨hm.le_iff_le.mp hip, hm.le_iff_le.mp hpj⟩
    · rintro ⟨hit, htj⟩
      exact ⟨ladder.firstPosition t, hm.monotone hit, hm.monotone htj,
        ladder.firstPosition_vertex t⟩
  · intro i j t hij
    rw [← sourceOrientedCycleSubpath_support_congr G C
      (hC.mem_support ((sourceLemma36ComplementOrderAt G C hC k Z data iP).get (ladder.secondPosition j)))
      (hC.mem_support ((sourceLemma36ComplementOrderAt G C hC k Z data iP).get (ladder.secondPosition i)))
      _ _ (ladder.secondPosition_vertex j) (ladder.secondPosition_vertex i)]
    change ladder.secondVertex t ∈ (sourceLemma36ComplementOrderAtSegment G C hC
      k Z data iP (ladder.secondPosition j) (ladder.secondPosition i)).support ↔ _
    rw [sourceLemma36_mem_complementOrderAtSegment_iff G C hC k Z data iP _ _
      (ha.antitone hij)]
    constructor
    · rintro ⟨p, hjp, hpi, hp⟩
      have heq : p = ladder.secondPosition t :=
        (List.nodup_iff_injective_get.mp (sourceLemma36_complementOrderAt_nodup G C hC k Z data iP))
          (hp.trans (ladder.secondPosition_vertex t).symm)
      subst p
      exact ⟨ha.le_iff_le.mp hpi, ha.le_iff_le.mp hjp⟩
    · rintro ⟨hit, htj⟩
      exact ⟨ladder.secondPosition t, ha.antitone htj, ha.antitone hit,
        ladder.secondPosition_vertex t⟩

private theorem sourceLemma39_section2_rail_separation
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
