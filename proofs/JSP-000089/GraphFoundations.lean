private theorem sourceLemma37_retained_homogeneous_block_family
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsHamiltonianCycle) (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData (sourceLemma35Graph G C hC)
