/-- Source Lemma 3.9, Branch I: the repaired six-way Lemma-3.7 certificate,
together with an actual included witness graph and its original ambient cycle.
The mapping lemmas above preserve its paths, chords, crossing, properness,
vertex distinctness and internal disjointness in G. -/
theorem sourceLemma39_zeroOutside_branch_complete
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsCycle) (k : ℕ) (hk : 1 ≤ k)
    (hY : 4 * C.length ≤ 9 * (sourceLemma31ZeroOutsideVertices G C).card)
    (hdegree : ∀ v, 6 ≤ G.degree v)
    (hlarge : 2^6 * 3^4 * (sourceLemma36_c k)^2 ≤ C.length)
    (hgirth : 5 ≤ G.girth) :
    Nonempty (SourceLemma39ZeroOutsideBranchResult G C k hk) := by
  let H := G.induce {v | v ∈ C.support}
  let D := sourceLemma39InducedCycle G C
  let hD := sourceLemma39_inducedCycle_hamiltonian G C hC
  let J := sourceLemma35Graph H D hD
  let E := sourceLemma35RetainedCycle H D hD
  let hE := sourceLemma35_retainedCycle_hamiltonian H D hD
  obtain ⟨Z, hresult⟩ := sourceLemma39_zeroOutside_induced_complete
    G C hC k hk hY hdegree hlarge hgirth
  let assemble (h : SourceLemma37UnrootedResult J E hE k hk Z) :
      SourceLemma39ZeroOutsideBranchResult G C k hk := {
    graph := J
    cycle := E
    hamiltonian := hE
    graph_le := sourceLemma35_graph_le H D hD
    cycle_map := sourceLemma39_retainedCycle_map G C hC
    roots := Z
    certificate := h }
  cases hresult with
  | directTruncation h =>
    exact ⟨assemble (SourceLemma37UnrootedResult.directTruncation h)⟩
  | directNet h =>
    exact ⟨assemble (SourceLemma37UnrootedResult.directNet h)⟩
  | directCrossladder h =>
    exact ⟨assemble (SourceLemma37UnrootedResult.directCrossladder h)⟩
  | residualBlock h =>
    exact ⟨assemble (SourceLemma37UnrootedResult.residualBlock h)⟩
  | residualTruncation h =>
    exact ⟨assemble (SourceLemma37UnrootedResult.residualTruncation h)⟩
  | residualMesh h =>
    exact ⟨assemble (SourceLemma37UnrootedResult.residualMesh h)⟩

/-- Equal-length traversals following the directed darts of a cycle have the
same endpoint when they start at the same vertex. -/
private theorem sourceLemma33_cycle_darts_endpoint_injective [DecidableEq V]
    {r a b : V} (C : G.Walk r r) (hC : C.IsCycle) (P : G.Walk a b) :
    ∀ {c : V} (Q : G.Walk a c), P.darts ⊆ C.darts → Q.darts ⊆ C.darts →
      P.length = Q.length → b = c := by
  induction P with
  | nil =>
    intro c Q hP hQ hlen
    have hnil : Q.Nil := by rw [Walk.nil_iff_length_eq]; simpa using hlen.symm
    exact hnil.eq
  | @cons a x b hax P ih =>
    intro c Q hP hQ hlen
    cases Q with
    | nil => simp at hlen
    | @cons a y c hay Q =>
      have hd : (⟨(a,x),hax⟩ : G.Dart) = ⟨(a,y),hay⟩ :=
        sourceLemma31_dart_eq_of_same_fst G C hC _ _
          (hP (by simp [Walk.darts_cons])) (hQ (by simp [Walk.darts_cons])) rfl
      have hxy : x = y := congrArg (fun d : G.Dart => d.snd) hd
      subst y
      apply ih Q
      · intro d hd
        exact hP (by simp only [Walk.darts_cons, List.mem_cons]; exact Or.inr hd)
      · intro d hd
        exact hQ (by simp only [Walk.darts_cons, List.mem_cons]; exact Or.inr hd)
      · simpa only [Walk.length_cons, Nat.add_right_cancel_iff] using hlen

/-- With the terminal contact fixed, directed cycle-arc length also uniquely
determines the initial contact. -/
private theorem sourceLemma33_backward_subpath_length_injective [DecidableEq V]
    {r u a b : V} (C : G.Walk r r) (hC : C.IsCycle)
    (hu : u ∈ C.support) (ha : a ∈ C.support) (hb : b ∈ C.support)
    (hlen : (sourceOrientedCycleSubpath G C ha hu).length =
      (sourceOrientedCycleSubpath G C hb hu).length) : a = b := by
  have arcDarts {x y : V} (hx : x ∈ C.support) (hy : y ∈ C.support) :
      (sourceOrientedCycleSubpath G C hx hy).darts ⊆ C.darts := by
    intro d hd
    apply (C.rotate_darts hx).mem_iff.mp
    exact (C.rotate hx).darts_takeUntil_subset _ hd
  apply sourceLemma33_cycle_darts_endpoint_injective G C.reverse hC.reverse
    (sourceOrientedCycleSubpath G C ha hu).reverse
    (sourceOrientedCycleSubpath G C hb hu).reverse
  · intro d hd
    exact Walk.mem_darts_reverse.mpr (arcDarts ha hu (Walk.mem_darts_reverse.mp hd))
  · intro d hd
    exact Walk.mem_darts_reverse.mpr (arcDarts hb hu (Walk.mem_darts_reverse.mp hd))
  · simpa using hlen

/-- Five cycle contacts leave three contacts avoiding both directed forbidden
lengths, and therefore give the complete ordered-pair simple-path property. -/
theorem sourceLemma33_good_path_of_five_cycle_neighbours
    [Fintype V] [DecidableEq V] {r u z : V} (C : G.Walk r r) (K : Set V)
    (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (hK : SourceLemma33ComponentData G C K)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support)
    (hzK : z ∈ K) (hfive : 5 ≤ (sourceLemma33CycleNeighbours G C z).card) :
    ∃ X : Finset V, u ∈ X ∧ sourceLemma33GoodPath G C K X := by
  classical
  let S := sourceLemma33CycleNeighbours G C z
  by_cases huS : u ∈ S
  · obtain ⟨X, hXcard, huX, hXS, _⟩ := sourceLemma33_select_good_four_containing
      G C K hC hgirth hK hzK (by omega) huS
    exact ⟨X, huX, sourceLemma33_good_of_four_cycle_neighbours_path
      G C K hC hgirth hK hzK X hXcard hXS⟩
  obtain ⟨P, hP, hPK⟩ := sourceLemma33_path_to_component_vertex G hK huBoundary huC hzK
  let L := P.length + 1
  let F := S.filter fun y => ∃ hy : y ∈ C.support,
    (sourceOrientedCycleSubpath G C huC hy).length = L
  let B := S.filter fun y => ∃ hy : y ∈ C.support,
    (sourceOrientedCycleSubpath G C hy huC).length = L
  have hF : F.card ≤ 1 := by
    apply Finset.card_le_one.mpr
    intro a ha b hb
    obtain ⟨_, haC, haL⟩ := Finset.mem_filter.mp ha
    obtain ⟨_, hbC, hbL⟩ := Finset.mem_filter.mp hb
    exact sourceLemma33_oriented_subpath_length_injective G C huC haC hbC (haL.trans hbL.symm)
  have hB : B.card ≤ 1 := by
    apply Finset.card_le_one.mpr
    intro a ha b hb
    obtain ⟨_, haC, haL⟩ := Finset.mem_filter.mp ha
    obtain ⟨_, hbC, hbL⟩ := Finset.mem_filter.mp hb
    exact sourceLemma33_backward_subpath_length_injective G C hC huC haC hbC
      (haL.trans hbL.symm)
  have hbad : (F ∪ B).card ≤ 2 := le_trans (Finset.card_union_le _ _) (by omega)
  let safe := S \ (F ∪ B)
  have hcover : S ⊆ safe ∪ (F ∪ B) := by
    intro y hy
    by_cases h : y ∈ F ∪ B
    · exact Finset.mem_union_right _ h
    · exact Finset.mem_union_left _ (Finset.mem_sdiff.mpr ⟨hy,h⟩)
  have hsafe : 3 ≤ safe.card := by
    have hc := le_trans (Finset.card_le_card hcover) (Finset.card_union_le safe (F ∪ B))
    have hs : 5 ≤ S.card := hfive
    omega
  obtain ⟨T, hTsafe, hTcard⟩ := safe.exists_subset_card_eq hsafe
  have hTS : T ⊆ S := fun y hy => (Finset.mem_sdiff.mp (hTsafe hy)).1
  have huT : u ∉ T := fun h => huS (hTS h)
  let X := insert u T
  have hXcard : X.card = 4 := by simp [X, Finset.card_insert_of_not_mem huT, hTcard]
  have huX : u ∈ X := by simp [X]
  have hmem : ∀ a, a ∈ X → a ∈ sourceGraphNeighbourhood G K ∧ a ∈ C.support := by
    intro a ha
    rcases Finset.mem_insert.mp ha with rfl | ha
    · exact ⟨huBoundary, huC⟩
    · obtain ⟨haC, hza⟩ := (mem_sourceLemma33CycleNeighbours G C z a).mp (hTS ha)
      exact ⟨⟨z, hzK, hza.symm⟩, haC⟩
  have rootRoute (v : V) (hv : v ∈ T) (hvC : v ∈ C.support) (N : ℕ)
      (hN : N = (sourceOrientedCycleSubpath G C huC hvC).length ∨
        N = (sourceOrientedCycleSubpath G C hvC huC).length) :
      ∃ R : G.Walk u v, R.IsPath ∧ internalVertices G R ⊆ K ∧ R.length ≠ N := by
    obtain ⟨_, hzv⟩ := (mem_sourceLemma33CycleNeighbours G C z v).mp (hTS hv)
    have hvu : v ≠ u := fun h => huT (h ▸ hv)
    refine ⟨P.concat hzv, sourceLemma33_concat_to_cycle_isPath G hK P hP hPK hzK hvC hvu hzv,
      sourceLemma33_path_via_component_vertex_internal G P hPK hzK hzv, ?_⟩
    intro heq
    have hL : L = N := by simpa [L, Walk.length_concat] using heq
    have hnot := (Finset.mem_sdiff.mp (hTsafe hv)).2
    apply hnot
    rcases hN with hN | hN
    · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hTS hv, hvC, hN.symm.trans hL.symm⟩)
    · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨hTS hv, hvC, hN.symm.trans hL.symm⟩)
  refine ⟨X, huX, hXcard, hmem, ?_⟩
  intro a ha b hb hab
  rcases Finset.mem_insert.mp ha with rfl | haT
  · have hbT := (Finset.mem_insert.mp hb).resolve_left hab.symm
    exact rootRoute b hbT (hmem b hb).2 _ (Or.inl rfl)
  · rcases Finset.mem_insert.mp hb with rfl | hbT
    · obtain ⟨R, hR, hRK, hlen⟩ := rootRoute a haT (hmem a ha).2 _ (Or.inr rfl)
      refine ⟨R.reverse, hR.reverse, ?_, ?_⟩
      · intro w hw
        have hwR : w ∈ R.support := by simpa using hw.1
        exact hRK ⟨hwR, hw.2.2, hw.2.1⟩
      · simpa using hlen
    · obtain ⟨haC, hza⟩ := (mem_sourceLemma33CycleNeighbours G C z a).mp (hTS haT)
      obtain ⟨hbC, hzb⟩ := (mem_sourceLemma33CycleNeighbours G C z b).mp (hTS hbT)
      obtain ⟨R, hR, hRK, hlen⟩ := sourceLemma33_two_edge_path G hK hzK haC hbC hab hza hzb
      refine ⟨R, hR, hRK, ?_⟩
      simpa [hlen] using (sourceLemma33_cycle_subpath_length_ne_two G C hC hgirth
        (hK.disjoint_cycle z hzK) haC hbC hab hza hzb).symm


/-- In the remaining four-contact branch the induced component has minimum
degree at least two; degree three is not asserted at four-contact vertices. -/
private theorem sourceLemma33_component_degree_two [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K)
    (hdegree : ∀ v : V, 6 ≤ G.degree v)
    (hsmall : ∀ z, z ∈ K → (sourceLemma33CycleNeighbours G C z).card ≤ 4) :
    ∀ z : {z // z ∈ K}, 2 ≤ (G.induce K).degree z := by
  intro z
  have hp : G.degree z.1 = (sourceLemma33CycleNeighbours G C z.1).card +
      (G.induce K).degree z := by
    simpa using sourceLemma33_neighbor_card G C hK z.2
  have hd := hdegree z.1
  have hs := hsmall z.1 z.2
  omega

/-- At a non-cut vertex whose component neighbours stay in the selected
block, the degree-two component bound transfers to the induced block. -/
private theorem sourceLemma33_closed_block_degree_two [Fintype V] [DecidableEq V]
    {r z : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K)
    (hdegree : ∀ v : V, 6 ≤ G.degree v)
    (hsmall : ∀ v, v ∈ K → (sourceLemma33CycleNeighbours G C v).card ≤ 4)
    (B : Finset V) (hBK : (↑B : Set V) ⊆ K) (hzB : z ∈ B)
    (hclosed : ∀ v, G.Adj z v → v ∈ K → v ∈ B) :
    2 ≤ (G.induce (↑B : Set V)).degree ⟨z, hzB⟩ := by
  classical
  have hzK := hBK hzB
  rw [← (G.induce (↑B : Set V)).card_neighborSet_eq_degree]
  let e : (G.induce (↑B : Set V)).neighborSet ⟨z,hzB⟩ ≃
      (G.induce K).neighborSet ⟨z,hzK⟩ := {
    toFun := fun a => ⟨⟨a.1.1, hBK a.1.2⟩, a.2⟩
    invFun := fun a => ⟨⟨a.1.1, hclosed a.1.1 a.2 a.1.2⟩, a.2⟩
    left_inv := by intro a; apply Subtype.ext; apply Subtype.ext; rfl
    right_inv := by intro a; apply Subtype.ext; apply Subtype.ext; rfl }
  rw [Fintype.card_congr e]
  simpa only [← (G.induce K).card_neighborSet_eq_degree] using
    sourceLemma33_component_degree_two G C hK hdegree hsmall ⟨z,hzK⟩


/-- At a longest-path endpoint of degree at least two, two distinct neighbours
supply simple routes with different lengths. Their prefixes end at distinct
positions on the original path; adjoining the final edge preserves simplicity. -/
private theorem sourceLemma33_longest_endpoint_two_routes [Fintype V] [DecidableEq V]
    {w x : V} (P : G.Walk w x) (hP : P.IsPath)
    (hmax : ∀ y (Q : G.Walk w y), Q.IsPath → Q.length ≤ P.length)
    (hx : 2 ≤ G.degree x) :
    ∃ R S : G.Walk w x, R.IsPath ∧ S.IsPath ∧ R.length ≠ S.length := by
  classical
  have hcard : 1 < (G.neighborFinset x).card := by
    simpa only [G.card_neighborFinset_eq_degree] using (by omega : 1 < G.degree x)
  obtain ⟨a, ha, b, hb, hab⟩ := Finset.one_lt_card.mp hcard
  have hxa := (G.mem_neighborFinset x a).mp ha
  have hxb := (G.mem_neighborFinset x b).mp hb
  have haP := longestPath_endpoint_neighbor_mem_support G hP hmax hxa
  have hbP := longestPath_endpoint_neighbor_mem_support G hP hmax hxb
  let R := (P.takeUntil a haP).concat hxa.symm
  let S := (P.takeUntil b hbP).concat hxb.symm
  have routePath (c : V) (hc : c ∈ P.support) (hxc : G.Adj x c) :
      ((P.takeUntil c hc).concat hxc.symm).IsPath := by
    apply Walk.IsPath.mk'
    rw [Walk.support_concat]
    exact List.Nodup.concat
      (sourceLemma32_takeUntil_not_end G hP hc hxc.ne.symm)
      (hP.takeUntil hc).support_nodup
  refine ⟨R, S, routePath a haP hxa, routePath b hbP hxb, ?_⟩
  intro heq
  have hlength : (P.takeUntil a haP).length = (P.takeUntil b hbP).length := by
    simpa only [R, S, Walk.length_concat, Nat.add_right_cancel_iff] using heq
  have hapos : P.getVert (P.takeUntil a haP).length = a := by
    rw [← P.getVert_takeUntil haP le_rfl, Walk.getVert_length]
  have hbpos : P.getVert (P.takeUntil b hbP).length = b := by
    rw [← P.getVert_takeUntil hbP le_rfl, Walk.getVert_length]
  exact hab (hapos.symm.trans ((congrArg P.getVert hlength).trans hbpos))

/-- Rotate a longest simple path at an endpoint chord. The successor of the
chord's other endpoint becomes the new endpoint, with the same support and
length, so it can be tested as an additional contact centre. -/
private theorem sourceLemma33_rotate_longest_path [DecidableEq V]
    {w x z zplus : V} (P : G.Walk w x) (hP : P.IsPath)
    (hzP : z ∈ P.support) (hxz : G.Adj x z)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hdropP : P.dropUntil z hzP = Walk.cons hz_zplus tailZ)
    (hmax : ∀ y (Q : G.Walk w y), Q.IsPath → Q.length ≤ P.length) :
    ∃ R : G.Walk w zplus, R.IsPath ∧ R.length = P.length ∧
      (∀ v, v ∈ R.support ↔ v ∈ P.support) ∧
      ∀ y (Q : G.Walk w y), Q.IsPath → Q.length ≤ R.length := by
  let preZ := P.takeUntil z hzP
  let R := (preZ.concat hxz.symm).append tailZ.reverse
  have hPdecomp : preZ.append (Walk.cons hz_zplus tailZ) = P := by
    dsimp [preZ]
    rw [← hdropP]
    exact P.take_spec hzP
  have hP_support : P.support = preZ.support ++ tailZ.support := by
    rw [← hPdecomp, Walk.support_append]
    simp only [Walk.support_cons, List.tail_cons]
  have hR_support : R.support = preZ.support ++ tailZ.support.reverse := by
    dsimp [R]
    have hreverse : tailZ.support.reverse = x :: tailZ.support.reverse.tail := by
      rw [← Walk.support_reverse]
      exact Walk.support_eq_cons tailZ.reverse
    have hreverse_tail : [x] ++ tailZ.support.reverse.tail = tailZ.support.reverse := by
      change x :: tailZ.support.reverse.tail = tailZ.support.reverse
      exact hreverse.symm
    rw [Walk.support_append, Walk.support_concat, Walk.support_reverse]
    simp only [List.concat_eq_append, List.append_assoc]
    rw [hreverse_tail]
  have hRperm : R.support.Perm P.support := by
    rw [hR_support, hP_support]
    exact List.Perm.append_left preZ.support (List.reverse_perm tailZ.support)
  have hRpath : R.IsPath := Walk.IsPath.mk' (hRperm.symm.nodup hP.support_nodup)
  have hP_length : P.length = preZ.length + 1 + tailZ.length := by
    rw [← hPdecomp, Walk.length_append, Walk.length_cons]
    omega
  have hRlength : R.length = P.length := by
    dsimp [R]
    simp only [Walk.length_append, Walk.length_concat, Walk.length_reverse]
    omega
  refine ⟨R, hRpath, hRlength, fun v => hRperm.mem_iff, ?_⟩
  intro y Q hQ
  rw [hRlength]
  exact hmax y Q hQ

/-- In a finite 2-connected graph, vertices of degree two may all be marked.
If every unmarked vertex other than the root has degree at least three, some
marked vertex distinct from the root has two unequal simple root routes.
The centre is selected by endpoint rotation, rather than fixed in advance. -/
private theorem sourceLemma33_two_connected_marked_routes [Fintype V] [DecidableEq V]
    (h2conn : VertexConnectivityAtLeast G 2) (w : V) (T : Set V)
    (hdegreeTwo : ∀ a, 2 ≤ G.degree a)
    (hdegreeThree : ∀ a, a ≠ w → a ∉ T → 3 ≤ G.degree a)
    (hT : ∃ a, a ∈ T ∧ a ≠ w) :
    ∃ v, v ∈ T ∧ v ≠ w ∧ ∃ P Q : G.Walk w v,
      P.IsPath ∧ Q.IsPath ∧ P.length ≠ Q.length := by
  classical
  obtain ⟨x, y, W, hW, hxy, hyW, hmax, hminimal⟩ :=
    exists_extremalLongestPathFrom G hdegreeTwo w
  have hx_ne_w : x ≠ w := by
    intro hxe
    subst x
    rw [Walk.isPath_iff_eq_nil] at hW
    subst W
    obtain ⟨a, hea⟩ := (G.degree_pos_iff_exists_adj w).mp
      (lt_of_lt_of_le (by decide) (hdegreeTwo w))
    let T : G.Walk w a := Walk.cons hea Walk.nil
    have hT : T.IsPath := by
      dsimp [T]
      exact (Walk.cons_isPath_iff hea Walk.nil).mpr ⟨Walk.IsPath.nil, by simpa using hea.ne⟩
    have hcontr : 1 ≤ 0 := by
      simpa [T] using hmax a T hT
    omega
  by_cases hxT : x ∈ T
  · obtain ⟨P, Q, hP, hQ, hne⟩ := sourceLemma33_longest_endpoint_two_routes G W hW hmax
      (hdegreeTwo x)
    exact ⟨x, hxT, hx_ne_w, P, Q, hP, hQ, hne⟩
  have hxDegree : 3 ≤ G.degree x := hdegreeThree x hx_ne_w hxT
  let S : G.Walk y x := sourceLemma32Suffix G W hyW
  have hS : S.IsPath := sourceLemma32Suffix_isPath G hW hyW
  obtain ⟨z, hzS, hzy, hxz, zplus, hz_zplus, tailZ, hzplus_ne_x, hdropZ⟩ :=
    sourceLemma32_choose_x_chord_neighbour G hxDegree hW hmax hminimal hyW hxy
  have hzplusS : zplus ∈ (sourceLemma32Suffix G W hyW).support := by
    have hzplusDrop : zplus ∈ ((sourceLemma32Suffix G W hyW).dropUntil z hzS).support := by
      rw [hdropZ]
      simp only [Walk.support_cons, List.mem_cons]
      exact Or.inr tailZ.start_mem_support
    exact (sourceLemma32Suffix G W hyW).support_dropUntil_subset hzS hzplusDrop
  have hzplus_ne_w : zplus ≠ w := by
    intro hzplusE
    have hzplus_ne_y := sourceLemma32_successor_ne_start G hS hzS hzy hdropZ
    have hstart : w = y :=
      sourceLemma32_start_eq_of_mem_suffix G hW hyW (by simpa [hzplusE] using hzplusS)
    exact hzplus_ne_y (hzplusE.trans hstart)
  by_cases hzplusT : zplus ∈ T
  · have hzW : z ∈ W.support := sourceLemma32Suffix_support_subset G W hyW z hzS
    have hcompose : (sourceLemma32Suffix G W hyW).dropUntil z hzS =
        W.dropUntil z hzW := by
      simpa only [sourceLemma32Suffix] using
        sourceLemma32_dropUntil_compose_of_isPath G hW hyW hzS hzW
    have hdropW : W.dropUntil z hzW = Walk.cons hz_zplus tailZ :=
      hcompose.symm.trans hdropZ
    obtain ⟨R, hR, hlen, _, hRmax⟩ :=
      sourceLemma33_rotate_longest_path G W hW hzW hxz hdropW hmax
    obtain ⟨P, Q, hP, hQ, hne⟩ := sourceLemma33_longest_endpoint_two_routes G R hR hRmax
      (hdegreeTwo zplus)
    exact ⟨zplus, hzplusT, hzplus_ne_w, P, Q, hP, hQ, hne⟩
  have hzplusDegree : 3 ≤ G.degree zplus :=
    hdegreeThree zplus hzplus_ne_w hzplusT
  obtain ⟨hzplusS, hzplus_ne_y, znext, hzplus_znext, tailNext, hdropNext,
    t, htS, hzplus_t, ht_ne_z, ht_ne_znext⟩ :=
    sourceLemma32_choose_zplus_chord_neighbour G hzplusDegree hW hmax hminimal hyW hzS hzy hxz
      hzplus_ne_x hdropZ
  let D : SourceLemma32ChordedCycleData G := sourceLemma32_chorded_cycle_data G hS hxy
    hzS hzy hxz hzplus_ne_x hdropZ hzplusS hzplus_ne_y hdropNext htS hzplus_t ht_ne_z ht_ne_znext
  obtain ⟨v, hvT, hwv⟩ := hT
  have huv : w ≠ v := hwv.symm
  rcases sourceLemma32_two_attachments_to_chorded_cycle G h2conn D huv with ⟨L⟩
  rcases sourceLemma32_normalize_two_attachments G D huv L with ⟨A⟩
  rcases sourceLemma32_first_hit_attachments G D A with ⟨F⟩
  let E : SourceLemma32CycleArcData G D F.r F.s :=
    sourceLemma32_cycle_arcs G D F.r_mem_cycle F.s_mem_cycle F.r_ne_s
  let routes : SourceLemma32DifferentCycleRouteData G D F.r F.s :=
    sourceLemma32_different_cycle_routes G D E
  let P : G.Walk w v := F.Ru.append (routes.R.append F.Rv.reverse)
  let Q : G.Walk w v := F.Ru.append (routes.R'.append F.Rv.reverse)
  refine ⟨v, hvT, hwv, P, Q, ?_, ?_, ?_⟩
  · dsimp [P]
    exact sourceLemma32_attach_cycle_route_isPath G D F routes.R routes.R_path
      routes.R_support_cycle
  · dsimp [Q]
    exact sourceLemma32_attach_cycle_route_isPath G D F routes.R' routes.R'_path
      routes.R'_support_cycle
  · have hP : P.length = F.Ru.length + routes.R.length + F.Rv.length := by
      dsimp [P]
      rw [Walk.length_append, Walk.length_append, Walk.length_reverse]
      omega
    have hQ : Q.length = F.Ru.length + routes.R'.length + F.Rv.length := by
      dsimp [Q]
      rw [Walk.length_append, Walk.length_append, Walk.length_reverse]
      omega
    intro hPQ
    apply routes.length_ne
    omega

/-- Degree-two descent rooted at a prescribed component entry. The chosen
block has no non-cut occurrence of the entry, so a root prefix reaches it
through its cut vertex. -/
private theorem sourceLemma33_rooted_degree_two_block [Fintype V] [DecidableEq V]
    {r k : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K)
    (hdegree : ∀ v, 6 ≤ G.degree v)
    (hsmall : ∀ v, v ∈ K → (sourceLemma33CycleNeighbours G C v).card ≤ 4)
    (hkK : k ∈ K) :
    ∃ (B : Finset V) (b : V), b ∈ B ∧ (↑B : Set V) ⊆ K ∧
      (k ∈ B → k = b) ∧ VertexConnectivityAtLeast (G.induce (↑B : Set V)) 2 ∧
      ∀ x y, x ∈ B → x ≠ b → G.Adj x y → y ∈ K → y ∈ B := by
  classical
  have descend : ∀ n, ∀ (W : Finset V) (b : V), W.card = n →
      (↑W : Set V) ⊆ K → b ∈ W → (k ∈ W → k = b) →
      (G.induce (↑W : Set V)).Connected →
      (∃ x, x ∈ W ∧ x ≠ b) →
      (∀ x y, x ∈ W → x ≠ b → G.Adj x y → y ∈ K → y ∈ W) →
      ∃ (B : Finset V) (a : V), a ∈ B ∧ (↑B : Set V) ⊆ K ∧
        (k ∈ B → k = a) ∧ VertexConnectivityAtLeast (G.induce (↑B : Set V)) 2 ∧
        ∀ x y, x ∈ B → x ≠ a → G.Adj x y → y ∈ K → y ∈ B := by
    intro n
    induction n using Nat.strongRecOn with
    | ind n ih =>
      intro W b hWcard hWK hbW hkW hconnected hnoncut hclosed
      by_cases htwo : VertexConnectivityAtLeast (G.induce (↑W : Set V)) 2
      · exact ⟨W, b, hbW, hWK, hkW, htwo, hclosed⟩
      obtain ⟨v, hvW, hvb⟩ := hnoncut
      have hdv : 2 ≤ (G.induce (↑W : Set V)).degree ⟨v, hvW⟩ :=
        sourceLemma33_closed_block_degree_two G C hK hdegree hsmall W hWK hvW
          (fun y hvy hyK => hclosed v y hvW hvb hvy hyK)
      have hcard : 2 < Fintype.card {v // v ∈ W} := lt_of_le_of_lt hdv
        ((G.induce (↑W : Set V)).degree_lt_card_verts ⟨v, hvW⟩)
      obtain ⟨z, hzDisconnected⟩ := sourceLemma33_exists_cut_vertex_of_card
        (G.induce (↑W : Set V)) hconnected hcard htwo
      have hDisconnected : ¬ (G.induce {v : V | v ∈ W ∧ v ≠ z.1}).Connected :=
        sourceLemma33_original_delete_disconnected G W z hzDisconnected
      let D := G.induce {v : V | v ∈ W ∧ v ≠ z.1}
      have chooseComponent : ∃ c : D.ConnectedComponent,
          (∀ x, x ∈ sourceLemma33DeletionComponent G (↑W : Set V) z.1 c → x ≠ b) ∧
          ∃ q, q ∈ W ∧ q ≠ z.1 ∧
            q ∉ sourceLemma33DeletionComponent G (↑W : Set V) z.1 c := by
        by_cases hbz : b = z.1
        · let p : {v : V | v ∈ W ∧ v ≠ z.1} := ⟨v, hvW, by simpa [← hbz] using hvb⟩
          obtain ⟨q, hq⟩ := sourceLemma33_exists_unreachable_of_not_connected D p hDisconnected
          let c := D.connectedComponentMk p
          refine ⟨c, ?_, q.1, q.2.1, q.2.2, ?_⟩
          · intro x hx hxb
            exact hx.1.2 (hxb.trans hbz)
          · rintro ⟨_, hqc⟩
            exact hq (SimpleGraph.ConnectedComponent.exact hqc.symm)
        · let p : {v : V | v ∈ W ∧ v ≠ z.1} := ⟨b, hbW, hbz⟩
          obtain ⟨q, hq⟩ := sourceLemma33_exists_unreachable_of_not_connected D p hDisconnected
          let c := D.connectedComponentMk q
          refine ⟨c, ?_, b, hbW, hbz, ?_⟩
          · intro x hx hxb
            subst x
            exact hq (SimpleGraph.ConnectedComponent.exact hx.2)
          · rintro ⟨_, hpc⟩
            exact hq (SimpleGraph.ConnectedComponent.exact hpc)
      obtain ⟨c, hc, q, hqW, hqz, hqOutside⟩ := chooseComponent
      let L := sourceLemma33DeletionComponent G (↑W : Set V) z.1 c
      let W' := W.filter fun x => x ∈ L ∨ x = z.1
      have hmem : ∀ x, x ∈ W' ↔ x ∈ L ∨ x = z.1 := by
        intro x
        simp only [W', Finset.mem_filter]
        constructor
        · exact And.right
        · intro hx
          refine ⟨?_, hx⟩
          rcases hx with hxL | rfl
          · exact sourceLemma33_deletionComponent_subset G c hxL
          · exact z.2
      have hsubset : W' ⊆ W := Finset.filter_subset _ _
      have hlt : W'.card < n := by
        rw [← hWcard]
        apply Finset.card_lt_card
        apply (Finset.ssubset_iff_of_subset hsubset).mpr
        exact ⟨q, hqW, fun h => (hmem q).mp h |>.elim hqOutside hqz⟩
      have hcoe : (↑W' : Set V) = L ∪ {z.1} := by
        ext x
        exact hmem x
      apply ih W'.card hlt W' z.1 rfl
      · exact fun x hx => hWK (hsubset hx)
      · exact (hmem z.1).mpr (Or.inr rfl)
      · intro hk
        rcases (hmem k).mp hk with hkL | hkz
        · exact (hc k hkL (hkW (hsubset hk))).elim
        · exact hkz
      · rw [hcoe]
        exact sourceLemma33_connected_set_with_cut G W hconnected z c
      · obtain ⟨a, haL⟩ := sourceLemma33_deletionComponent_nonempty G c
        exact ⟨a, (hmem a).mpr (Or.inl haL), haL.1.2⟩
      · intro x y hx hxz hxy hyK
        have hxL : x ∈ L := ((hmem x).mp hx).resolve_right hxz
        have hyW : y ∈ W := hclosed x y
          (sourceLemma33_deletionComponent_subset G c hxL) (hc x hxL) hxy hyK
        exact (hmem y).mpr
          (sourceLemma33_deletionComponent_neighbour_subset G c hxL hyW hxy)
  let W := (Finset.univ : Finset V).filter fun x => x ∈ K
  have hmem : ∀ x, x ∈ W ↔ x ∈ K := by simp [W]
  have hcoe : (↑W : Set V) = K := by ext x; exact hmem x
  have htwo := sourceLemma33_component_degree_two G C hK hdegree hsmall ⟨k, hkK⟩
  obtain ⟨a, hka⟩ := ((G.induce K).degree_pos_iff_exists_adj ⟨k, hkK⟩).mp (by omega)
  apply descend W.card W k rfl
  · intro x hx; exact (hmem x).mp hx
  · exact (hmem k).mpr hkK
  · intro _; rfl
  · rw [hcoe]
    exact hK.connected
  · exact ⟨a.1, (hmem a.1).mpr a.2, (show G.Adj k a.1 from hka).ne.symm⟩
  · intro x y _ _ _ hy; exact (hmem y).mpr hy

/-- Complete the at-most-four-contact branch by a terminal block away from the
component entry. Low-contact non-cut vertices meet the original endblock
conditions; otherwise extremal rotation selects a four-contact centre with
unequal simple routes from the cut. -/
private theorem sourceLemma33_good_path_at_most_four_complete
    [Fintype V] [DecidableEq V] {r u : V} (C : G.Walk r r)
    (hC : C.IsCycle) (hgirth : 5 ≤ G.girth) (h4conn : VertexConnectivityAtLeast G 4)
    (hdegree : ∀ v, 6 ≤ G.degree v) {K : Set V}
    (hK : SourceLemma33ComponentData G C K)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support)
    (hsmall : ∀ v, v ∈ K → (sourceLemma33CycleNeighbours G C v).card ≤ 4) :
    ∃ X : Finset V, u ∈ X ∧ sourceLemma33GoodPath G C K X := by
  classical
  obtain ⟨k, hkK, huk⟩ := huBoundary
  obtain ⟨B, b, hbB, hBK, hkB, htwo, hclosed⟩ :=
    sourceLemma33_rooted_degree_two_block G C hK hdegree hsmall hkK
  let H := G.induce (↑B : Set V)
  let bb : {v // v ∈ B} := ⟨b, hbB⟩
  have partition (x : {v // v ∈ B}) (hxb : x.1 ≠ b) :
      G.degree x.1 = (sourceLemma33CycleNeighbours G C x.1).card + H.degree x := by
    have hd : H.degree x = (G.induce K).degree ⟨x.1, hBK x.2⟩ := by
      rw [← H.card_neighborSet_eq_degree, ← (G.induce K).card_neighborSet_eq_degree]
      let e : H.neighborSet x ≃ (G.induce K).neighborSet ⟨x.1, hBK x.2⟩ := {
        toFun := fun a => ⟨⟨a.1.1, hBK a.1.2⟩, a.2⟩
        invFun := fun a => ⟨⟨a.1.1, hclosed x.1 a.1.1 x.2 hxb a.2 a.1.2⟩, a.2⟩
        left_inv := by intro a; apply Subtype.ext; apply Subtype.ext; rfl
        right_inv := by intro a; apply Subtype.ext; apply Subtype.ext; rfl }
      exact Fintype.card_congr e
    rw [hd]
    simpa using sourceLemma33_neighbor_card G C hK (hBK x.2)
  by_cases hmarked : ∃ x, x ∈ B ∧ x ≠ b ∧
      4 ≤ (sourceLemma33CycleNeighbours G C x).card
  · let T : Set {v // v ∈ B} := {v | v.1 ≠ b ∧
        4 ≤ (sourceLemma33CycleNeighbours G C v.1).card}
    have hdegreeTwo : ∀ x : {v // v ∈ B}, 2 ≤ H.degree x :=
      degree_two_of_vertexConnectivity H htwo
    have hdegreeThree : ∀ x : {v // v ∈ B}, x ≠ bb → x ∉ T → 3 ≤ H.degree x := by
      intro x hxb hxT
      have hxb' : x.1 ≠ b := fun h => hxb (Subtype.ext h)
      have hlow : ¬ 4 ≤ (sourceLemma33CycleNeighbours G C x.1).card :=
        fun h => hxT ⟨hxb', h⟩
      have hp := partition x hxb'
      have hd := hdegree x.1
      omega
    have hT : ∃ x, x ∈ T ∧ x ≠ bb := by
      obtain ⟨x, hxB, hxb, hfour⟩ := hmarked
      exact ⟨⟨x, hxB⟩, ⟨hxb, hfour⟩, fun h => hxb (congrArg Subtype.val h)⟩
    obtain ⟨z, hzT, _, M, N, hM, hN, hMN⟩ :=
      sourceLemma33_two_connected_marked_routes H htwo bb T hdegreeTwo hdegreeThree hT
    let kk : K := ⟨k, hkK⟩
    let bk : K := ⟨b, hBK hbB⟩
    obtain ⟨W⟩ := hK.connected.preconnected kk bk
    let kinclusion : G.induce K →g G := {
      toFun := Subtype.val
      map_rel' := by intro x y hxy; exact hxy }
    let W' : G.Walk k b := (W.map kinclusion).toPath
    have hW' : W'.IsPath := (W.map kinclusion).toPath.isPath
    have hW'K : ∀ v, v ∈ W'.support → v ∈ K := by
      intro v hv
      have hvmap := Walk.support_toPath_subset (W.map kinclusion) hv
      rw [Walk.support_map] at hvmap
      obtain ⟨x, _, hxv⟩ := List.mem_map.mp hvmap
      exact hxv ▸ x.2
    obtain ⟨a, P, hP, haB, havoid, hsub⟩ :=
      sourceLemma33_first_finset_hit G B W' hW' hbB
    have hPK : ∀ v, v ∈ P.support → v ∈ K := fun v hv => hW'K v (hsub v hv)
    have hab : a = b := by
      by_contra hab
      cases heq : P.reverse with
      | nil => exact hab (hkB haB)
      | @cons a x k hax Q =>
        have hxP : x ∈ P.support := by
          have hxR : x ∈ P.reverse.support := by rw [heq]; simp
          simpa using hxR
        exact havoid x hxP hax.ne.symm (hclosed a x haB hab hax (hPK x hxP))
    subst a
    let rootPrefix : G.Walk u b := Walk.cons huk P
    have hrootPrefix : rootPrefix.IsPath := (Walk.cons_isPath_iff huk P).mpr
      ⟨hP, fun hu => hK.disjoint_cycle u (hPK u hu) huC⟩
    have hrootPrefixK : ∀ v, v ∈ rootPrefix.support → v ≠ u → v ∈ K := by
      intro v hv hvu
      exact hPK v ((List.mem_cons.mp hv).resolve_left hvu)
    have hrootPrefixAvoid : ∀ v, v ∈ rootPrefix.support → v ≠ b → v ∉ B := by
      intro v hv hvb
      rcases List.mem_cons.mp hv with rfl | hvP
      · exact fun huB => hK.disjoint_cycle v (hBK huB) huC
      · exact havoid v hvP hvb
    let inclusion : H →g G := {
      toFun := Subtype.val
      map_rel' := by intro x y hxy; exact hxy }
