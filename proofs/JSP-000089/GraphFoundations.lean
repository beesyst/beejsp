    · rw [Walk.support_reverse, List.mem_reverse] at hzP
      by_cases heq : z = x.val
      · exact Or.inl heq
      have hzw : z ≠ w.val := fun h => hwNot (h ▸ hzI)
      exact (Set.disjoint_left.mp hPC ⟨hzP, heq, hzw⟩ hzC).elim
  have hubs (z : sourceLemma39CycleVertices G C) (hz : z ∉ geom.cPrime.support) :
