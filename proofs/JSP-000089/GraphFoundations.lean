  have hyCanonical := sourceLemma37_mem_Qu_canonical
    G C k hk Z data iP matching ladder j y hy
  obtain ⟨ci, hciCore, hciget⟩ := sourceLemma36_canonicalPiece_position
    G C hC k Z data iP hxCanonical
  obtain ⟨cj, hcjCore, hcjget⟩ := sourceLemma36_canonicalPiece_position
    G C hC k Z data iP hyCanonical
  have hcij : ci < cj := sourceLemma37_Qu_positions_reverse G C k hk Z data iP
    matching ladder j i hji y x hcjget hciget hy hx
  by_cases hnext : iP.1 + 1 < k
  · have hciUpper : ci < data.cutPositions ⟨iP.1 + 1, hnext⟩ := by
      rw [data.corePositions_def iP] at hciCore
      have h := sourceLemma36_core_mem_upper (G := G) C data.anchor data.Z0
        (sourceLemma36_partitionQuota k) data.quota_pos
        data.canonical_orderedZ_length iP hnext hciCore
      simpa [data.cutPositions_def] using h
    have hcjUpper : cj < data.cutPositions ⟨iP.1 + 1, hnext⟩ := by
      rw [data.corePositions_def iP] at hcjCore
      have h := sourceLemma36_core_mem_upper (G := G) C data.anchor data.Z0
        (sourceLemma36_partitionQuota k) data.quota_pos
        data.canonical_orderedZ_length iP hnext hcjCore
      simpa [data.cutPositions_def] using h
    obtain ⟨p', hpval, hpget⟩ :=
      sourceLemma37_canonical_position_reanchor_after G C hC k Z data iP
        hnext ci hciUpper
    obtain ⟨q', hqval, hqget⟩ :=
      sourceLemma37_canonical_position_reanchor_after G C hC k Z data iP
        hnext cj hcjUpper
    have hpp' : p = p' := List.nodup_iff_injective_get.mp
      (sourceLemma36_rotatedCycleOrder_nodup G C hC
        (sourceLemma37SameSideOrderAnchor G C hC k Z data iP))
      (hxp.trans (hpget.trans hciget).symm)
    have hqq' : q = q' := List.nodup_iff_injective_get.mp
      (sourceLemma36_rotatedCycleOrder_nodup G C hC
        (sourceLemma37SameSideOrderAnchor G C hC k Z data iP))
      (hyq.trans (hqget.trans hcjget).symm)
    rw [hpp', hqq']
    apply Fin.mk_lt_mk.mpr
    rw [hpval, hqval]
    omega
  · have hanchor := sourceLemma37_sameSideOrderAnchor_eq_last
      G C hC k Z data iP hnext
    have hp : p = Fin.cast (by simpa [hanchor]) ci := by
      apply List.nodup_iff_injective_get.mp
        (sourceLemma36_rotatedCycleOrder_nodup G C hC
          (sourceLemma37SameSideOrderAnchor G C hC k Z data iP))
      simpa [hanchor] using hxp.trans hciget.symm
    have hq : q = Fin.cast (by simpa [hanchor]) cj := by
      apply List.nodup_iff_injective_get.mp
        (sourceLemma36_rotatedCycleOrder_nodup G C hC
          (sourceLemma37SameSideOrderAnchor G C hC k Z data iP))
      simpa [hanchor] using hyq.trans hcjget.symm
    rw [hp, hq]
    change ci.1 < cj.1
    exact hcij

/-- In one fixed cycle coordinate, a crossing between a chord whose endpoints
are displayed as `Qu, Qv` and a second such chord has the two local mesh
orientations.  The coordinate itself runs through `Qv` before `Qu`, so the
displayed chains are exactly the alternating four-endpoint possibilities. -/
private theorem sourceLemma37_crossSide_four_positions_alternate
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsHamiltonianCycle) (a : V)
    (e f : SourceLemma34Chord G C)
    (hcross : sourceLemma34Crosses G C hC.isCycle e f)
    {pve pvf pue puf : Fin (sourceLemma36RotatedCycleOrder G C a).length}
    (hpve : (sourceLemma36RotatedCycleOrder G C a).get pve = e.snd)
    (hpvf : (sourceLemma36RotatedCycleOrder G C a).get pvf = f.snd)
    (hpue : (sourceLemma36RotatedCycleOrder G C a).get pue = e.fst)
    (hpuf : (sourceLemma36RotatedCycleOrder G C a).get puf = f.fst)
    (hveue : pve < pue) (hvfue : pvf < pue) (hveuf : pve < puf) :
    (pve < pvf ∧ pvf < pue ∧ pue < puf) ∨
      (pvf < pve ∧ pve < puf ∧ puf < pue) := by
  have hcross' : sourceLemma34Crosses G C hC.isCycle
      (SourceLemma34Chord.symm G e) f :=
    sourceLemma34_crosses_left_symm G C hC e f hcross
  obtain ⟨dir, hAt⟩ := (sourceLemma34_crosses_iff_exists_at
    G C hC.isCycle (SourceLemma34Chord.symm G e) f).mp hcross'
  have hfalse : sourceLemma34CrossesAt G C hC.isCycle
      (SourceLemma34Chord.symm G e) f false :=
    sourceLemma34_crossingAt_any_bool G C hC.isCycle
      (SourceLemma34Chord.symm G e) f dir false hAt
  have hside :
      (sourceLemma34_orientedSide G C hC.isCycle
        (SourceLemma34Chord.symm G e) false).path.support =
        (sourceLemma36RotatedPositionSubpath G C hC a pve pue).support := by
    simpa [SourceLemma34Chord.symm] using
      (sourceLemma37_normalizedRung_forwardSide_support_eq_position
        G C hC (SourceLemma34Chord.symm G e) e.snd e.fst a rfl rfl
        pve pue hpve hpue)
  have hnodup := sourceLemma36_rotatedCycleOrder_nodup G C hC a
  have hdis := sourceLemma34_crosses_endpoint_disjoint G C hC.isCycle
    (SourceLemma34Chord.symm G e) f hcross'
  have hpve_ne_pvf : pve ≠ pvf := by
    intro h
    apply hdis.2.2.1
    calc
      f.snd = (sourceLemma36RotatedCycleOrder G C a).get pvf := hpvf.symm
      _ = (sourceLemma36RotatedCycleOrder G C a).get pve := by rw [h]
      _ = e.snd := hpve
  rcases lt_or_gt_of_ne hpve_ne_pvf with hvevf | hvfve
  · have hfv_mem : f.snd ∈
        (sourceLemma34_orientedSide G C hC.isCycle
          (SourceLemma34Chord.symm G e) false).path.support := by
      rw [hside, ← hpvf]
      exact sourceLemma36_position_mem_subpath G C hC a pve pue pvf
        hvevf.le hvfue.le
    rcases hfalse with hfu | hfv
    · exact (hfu.2 hfv_mem).elim
    · have hpueuf : pue < puf := by
        apply lt_of_not_ge
        intro hufue
        apply hfv.2
        rw [hside, ← hpuf]
        exact sourceLemma36_position_mem_subpath G C hC a pve pue puf
          hveuf.le hufue
      exact Or.inl ⟨hvevf, hvfue, hpueuf⟩
  · have hfv_not_mem : f.snd ∉
        (sourceLemma34_orientedSide G C hC.isCycle
          (SourceLemma34Chord.symm G e) false).path.support := by
      intro hmem
      rw [hside] at hmem
      obtain ⟨p, hpvep, -, hpget⟩ :=
        (sourceLemma36_mem_positionSubpath_iff G C hC a pve pue hveue.le f.snd).mp hmem
      have hp : p = pvf := List.nodup_iff_injective_get.mp hnodup
        (hpget.trans hpvf.symm)
      exact (not_le_of_gt hvfve) (by simpa [hp] using hpvep)
    rcases hfalse with hfu | hfv
    · have hpufue : puf < pue := by
        have hle : puf ≤ pue := by
          have hfu_mem :
              f.fst ∈
                (sourceLemma36RotatedPositionSubpath G C hC a pve pue).support := by
            rw [← hside]
            exact hfu.1.1
          obtain ⟨p, -, hpuep, hpget⟩ :=
            (sourceLemma36_mem_positionSubpath_iff
              G C hC a pve pue hveue.le f.fst).mp hfu_mem
          have hp : p = puf := List.nodup_iff_injective_get.mp hnodup
            (hpget.trans hpuf.symm)
          simpa [hp] using hpuep
        apply lt_of_le_of_ne hle
        intro h
        apply hdis.2.1
        calc
          f.fst = (sourceLemma36RotatedCycleOrder G C a).get puf := hpuf.symm
          _ = (sourceLemma36RotatedCycleOrder G C a).get pue := by rw [h]
          _ = e.fst := hpue
      exact Or.inr ⟨hvfve, hveuf, hpufue⟩
    · exact (hfv_not_mem hfv.1.1).elim

/-- Every selected CrossSide partner can be oriented from its `Qu` endpoint
to its `Qv` endpoint.  In the single existing common cycle coordinate, its
four endpoints with the central rung form one of the two explicit alternating
mesh cells; no per-pair coordinate is introduced. -/
private theorem sourceLemma37_crossSide_selected_pair_order
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching)
    (partner : Fin (2 * k - 1) → SourceLemma34Chord G C)
    (selected : Fin k → Fin (2 * k - 1)) (hselected : StrictMono selected)
    (hcross : ∀ t, sourceLemma34Crosses G C hC.isCycle
      (sourceLemma37CentralRungChord G C k hk Z data iP matching ladder (selected t))
      (partner (selected t)))
    (hcrossSide : ∀ t, sourceLemma37CrossSide G C k Z data iP matching ladder
      (selected t) (partner (selected t))) (t : Fin k) :
    ∃ f : SourceLemma34Chord G C,
      (f = partner (selected t) ∨ f = SourceLemma34Chord.symm G (partner (selected t))) ∧
      f.fst ∈ (sourceLemma37Qu G C k Z data iP matching ladder (selected t)).support ∧
      f.snd ∈ (sourceLemma37Qv G C k Z data iP matching ladder (selected t)).support ∧
      let e := sourceLemma37CentralRungChord G C k hk Z data iP matching ladder (selected t)
      e.fst ∈ (sourceLemma37Qu G C k Z data iP matching ladder (selected t)).support ∧
      e.snd ∈ (sourceLemma37Qv G C k Z data iP matching ladder (selected t)).support ∧
      ∃ pve pvf pue puf : Fin (sourceLemma36RotatedCycleOrder G C
          (sourceLemma37SameSideOrderAnchor G C hC k Z data iP)).length,
        (sourceLemma36RotatedCycleOrder G C
          (sourceLemma37SameSideOrderAnchor G C hC k Z data iP)).get pve = e.snd ∧
        (sourceLemma36RotatedCycleOrder G C
          (sourceLemma37SameSideOrderAnchor G C hC k Z data iP)).get pvf = f.snd ∧
        (sourceLemma36RotatedCycleOrder G C
          (sourceLemma37SameSideOrderAnchor G C hC k Z data iP)).get pue = e.fst ∧
        (sourceLemma36RotatedCycleOrder G C
          (sourceLemma37SameSideOrderAnchor G C hC k Z data iP)).get puf = f.fst ∧
        ((pve < pvf ∧ pvf < pue ∧ pue < puf) ∨
          (pvf < pve ∧ pve < puf ∧ puf < pue)) := by
  let e := sourceLemma37CentralRungChord G C k hk Z data iP matching ladder (selected t)
  have hcentral :
      sourceLemma37BlockFirstIndex k (selected t) ≤
        sourceLemma37CentralRungIndex k hk (selected t) ∧
      sourceLemma37CentralRungIndex k hk (selected t) ≤
        sourceLemma37BlockLastIndex k (selected t) :=
    ⟨(sourceLemma37_block_indices k hk (selected t)).1,
      (sourceLemma37_block_indices k hk (selected t)).2.le⟩
  have heQu : e.fst ∈
      (sourceLemma37Qu G C k Z data iP matching ladder (selected t)).support := by
    exact sourceLemma37_firstVertex_mem_Qu_of_block G C k hk Z data iP matching ladder
      (selected t) (sourceLemma37CentralRungIndex k hk (selected t)) hcentral.1 hcentral.2
  have heQv : e.snd ∈
      (sourceLemma37Qv G C k Z data iP matching ladder (selected t)).support := by
    exact sourceLemma37_secondVertex_mem_Qv_of_block G C k hk Z data iP matching ladder
      (selected t) (sourceLemma37CentralRungIndex k hk (selected t)) hcentral.1 hcentral.2
  rcases hcrossSide t with hQuQv | hQvQu
  · refine ⟨partner (selected t), Or.inl rfl, hQuQv.1, hQuQv.2, heQu, heQv, ?_⟩
    obtain ⟨pve, hpve⟩ := sourceLemma37_sameSide_common_position G C k hk Z data iP
      matching ladder (selected t) e.snd (Or.inl heQv)
    obtain ⟨pvf, hpvf⟩ := sourceLemma37_sameSide_common_position G C k hk Z data iP
      matching ladder (selected t) (partner (selected t)).snd (Or.inl hQuQv.2)
    obtain ⟨pue, hpue⟩ := sourceLemma37_sameSide_common_position G C k hk Z data iP
      matching ladder (selected t) e.fst (Or.inr heQu)
    obtain ⟨puf, hpuf⟩ := sourceLemma37_sameSide_common_position G C k hk Z data iP
      matching ladder (selected t) (partner (selected t)).fst (Or.inr hQuQv.1)
    refine ⟨pve, pvf, pue, puf, hpve, hpvf, hpue, hpuf, ?_⟩
    apply sourceLemma37_crossSide_four_positions_alternate G C hC
      (sourceLemma37SameSideOrderAnchor G C hC k Z data iP) e (partner (selected t))
      (hcross t) hpve hpvf hpue hpuf
    · exact sourceLemma37_sameSide_qv_position_lt_qu_position G C k Z data iP
        matching ladder hpve hpue heQv heQu
    · exact sourceLemma37_sameSide_qv_position_lt_qu_position G C k Z data iP
        matching ladder hpvf hpue hQuQv.2 heQu
    · exact sourceLemma37_sameSide_qv_position_lt_qu_position G C k Z data iP
        matching ladder hpve hpuf heQv hQuQv.1
  · let f := SourceLemma34Chord.symm G (partner (selected t))
    have hfQu : f.fst ∈
        (sourceLemma37Qu G C k Z data iP matching ladder (selected t)).support := by
      simpa [f, SourceLemma34Chord.symm] using hQvQu.2
    have hfQv : f.snd ∈
        (sourceLemma37Qv G C k Z data iP matching ladder (selected t)).support := by
      simpa [f, SourceLemma34Chord.symm] using hQvQu.1
    refine ⟨f, Or.inr rfl, hfQu, hfQv, heQu, heQv, ?_⟩
    obtain ⟨pve, hpve⟩ := sourceLemma37_sameSide_common_position G C k hk Z data iP
      matching ladder (selected t) e.snd (Or.inl heQv)
    obtain ⟨pvf, hpvf⟩ := sourceLemma37_sameSide_common_position G C k hk Z data iP
      matching ladder (selected t) f.snd (Or.inl hfQv)
    obtain ⟨pue, hpue⟩ := sourceLemma37_sameSide_common_position G C k hk Z data iP
      matching ladder (selected t) e.fst (Or.inr heQu)
    obtain ⟨puf, hpuf⟩ := sourceLemma37_sameSide_common_position G C k hk Z data iP
      matching ladder (selected t) f.fst (Or.inr hfQu)
    refine ⟨pve, pvf, pue, puf, hpve, hpvf, hpue, hpuf, ?_⟩
    apply sourceLemma37_crossSide_four_positions_alternate G C hC
      (sourceLemma37SameSideOrderAnchor G C hC k Z data iP) e f
      (sourceLemma34_crosses_right_symm G C hC.isCycle e (partner (selected t)) (hcross t))
      hpve hpvf hpue hpuf
    · exact sourceLemma37_sameSide_qv_position_lt_qu_position G C k Z data iP
        matching ladder hpve hpue heQv heQu
    · exact sourceLemma37_sameSide_qv_position_lt_qu_position G C k Z data iP
        matching ladder hpvf hpue hfQv heQu
    · exact sourceLemma37_sameSide_qv_position_lt_qu_position G C k Z data iP
        matching ladder hpve hpuf heQv hfQu

/-- The explicit `Qv ++ reverse Qu` SameSide family is a properly ordered
unrooted chord truncation. -/
private theorem sourceLemma37_sameSide_family_yields_unrooted_proper_truncation
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching)
    (partner : Fin (2 * k - 1) → SourceLemma34Chord G C)
    (selected : Fin k → Fin (2 * k - 1)) (hselected : StrictMono selected)
    (hsame : ∀ t, sourceLemma37SameSide G C k Z data iP matching ladder
      (selected t) (partner (selected t))) :
    Nonempty (SourceLemma37UnrootedProperTruncation G C hC k) := by
  classical
  obtain ⟨orderedEntries, hOrderedShape, hNodup, -, hLength⟩ :=
    sourceLemma37_sameSide_ordered_entries G C k hk Z data iP matching ladder
      partner selected hsame
  let qv : Fin k → Prop := fun t =>
    (partner (selected t)).fst ∈
        (sourceLemma37Qv G C k Z data iP matching ladder (selected t)).support ∧
      (partner (selected t)).snd ∈
        (sourceLemma37Qv G C k Z data iP matching ladder (selected t)).support
  let qu : Fin k → Prop := fun t =>
    (partner (selected t)).fst ∈
        (sourceLemma37Qu G C k Z data iP matching ladder (selected t)).support ∧
      (partner (selected t)).snd ∈
        (sourceLemma37Qu G C k Z data iP matching ladder (selected t)).support
  let qvEntries := (List.finRange k).filter qv
  let quEntries := (List.finRange k).filter qu
  let entry : Fin k → Fin k := fun i =>
    orderedEntries.get (Fin.cast hLength.symm i)
  have hEntryInjective : Function.Injective entry :=
    sourceLemma37_sameSide_entry_injective orderedEntries hNodup hLength
  have hEntryMem : ∀ i : Fin k, entry i ∈ orderedEntries := by
    intro i
    exact List.get_mem orderedEntries (Fin.cast hLength.symm i)
  have hEntrySides : ∀ i : Fin k, qv (entry i) ∨ qu (entry i) := by
    intro i
    simpa only [qv, qu] using sourceLemma37_sameSide_entry_membership
      G C k Z data iP matching ladder partner selected orderedEntries hOrderedShape
      (hEntryMem i)
  let R : Fin k → Fin k → Prop := fun a b =>
    (qv a ∧ (qv b ∧ a < b ∨ qu b)) ∨ (qu a ∧ qu b ∧ b < a)
  have hQvPairwise : qvEntries.Pairwise (· < ·) := by
    simpa only [qvEntries, qv] using sourceLemma37_sameSide_qvEntries_pairwise
      G C k Z data iP matching ladder partner selected
  have hQuPairwise : quEntries.reverse.Pairwise (· > ·) := by
    simpa only [quEntries, qu] using sourceLemma37_sameSide_quEntries_reverse_pairwise
      G C k Z data iP matching ladder partner selected
  have hOrderedPairwise : orderedEntries.Pairwise R := by
    rw [hOrderedShape]
    change (qvEntries ++ quEntries.reverse).Pairwise R
    rw [List.pairwise_append]
    refine ⟨?_, ?_, ?_⟩
    · rw [List.pairwise_iff_get]
      intro i j hij
      have hiQv : qv (qvEntries.get i) :=
        of_decide_eq_true
          (List.mem_filter.mp (List.get_mem qvEntries i)).2
      have hjQv : qv (qvEntries.get j) :=
        of_decide_eq_true
          (List.mem_filter.mp (List.get_mem qvEntries j)).2
      exact Or.inl ⟨hiQv, Or.inl ⟨hjQv,
        List.pairwise_iff_get.mp hQvPairwise i j hij⟩⟩
    · rw [List.pairwise_iff_get]
      intro i j hij
      have hiQu : qu (quEntries.reverse.get i) :=
        of_decide_eq_true
          (List.mem_filter.mp
            (List.mem_reverse.mp (List.get_mem quEntries.reverse i))).2
      have hjQu : qu (quEntries.reverse.get j) :=
        of_decide_eq_true
          (List.mem_filter.mp
            (List.mem_reverse.mp (List.get_mem quEntries.reverse j))).2
      exact Or.inr ⟨hiQu, hjQu,
        List.pairwise_iff_get.mp hQuPairwise i j hij⟩
    · intro a ha b hb
      have haQv : qv a :=
        of_decide_eq_true (List.mem_filter.mp ha).2
      have hbQu : qu b :=
        of_decide_eq_true
          (List.mem_filter.mp (List.mem_reverse.mp hb)).2
      exact Or.inl ⟨haQv, Or.inr hbQu⟩
  have hEntryOrder : ∀ {i j : Fin k}, i < j → R (entry i) (entry j) := by
    intro i j hij
    apply List.pairwise_iff_get.mp hOrderedPairwise
      (Fin.cast hLength.symm i) (Fin.cast hLength.symm j)
    change i.1 < j.1
    exact hij
  let commonAnchor := sourceLemma37SameSideOrderAnchor G C hC k Z data iP
  let commonOrder := sourceLemma36RotatedCycleOrder G C commonAnchor
  have hPositions : ∀ i : Fin k, ∃ p q : Fin commonOrder.length,
      commonOrder.get p = (partner (selected (entry i))).fst ∧
        commonOrder.get q = (partner (selected (entry i))).snd := by
    intro i
    rcases hEntrySides i with hqv | hqu
    · obtain ⟨p, hp⟩ := sourceLemma37_sameSide_common_position
        G C k hk Z data iP matching ladder (selected (entry i))
        (partner (selected (entry i))).fst (Or.inl hqv.1)
      obtain ⟨q, hq⟩ := sourceLemma37_sameSide_common_position
        G C k hk Z data iP matching ladder (selected (entry i))
        (partner (selected (entry i))).snd (Or.inl hqv.2)
      exact ⟨p, q, hp, hq⟩
    · obtain ⟨p, hp⟩ := sourceLemma37_sameSide_common_position
        G C k hk Z data iP matching ladder (selected (entry i))
        (partner (selected (entry i))).fst (Or.inr hqu.1)
      obtain ⟨q, hq⟩ := sourceLemma37_sameSide_common_position
        G C k hk Z data iP matching ladder (selected (entry i))
        (partner (selected (entry i))).snd (Or.inr hqu.2)
      exact ⟨p, q, hp, hq⟩
  choose fstPosition sndPosition hfstPosition hsndPosition using hPositions
  have hPositionNe : ∀ i : Fin k, fstPosition i ≠ sndPosition i := by
    intro i h
    have heq := congrArg commonOrder.get h
    rw [hfstPosition, hsndPosition] at heq
    exact (partner (selected (entry i))).adj.ne heq
  let f : Fin k → SourceLemma34Chord G C := fun i =>
    if fstPosition i < sndPosition i then partner (selected (entry i))
    else SourceLemma34Chord.symm G (partner (selected (entry i)))
  let leftPosition : Fin k → Fin commonOrder.length := fun i =>
    if fstPosition i < sndPosition i then fstPosition i else sndPosition i
  let rightPosition : Fin k → Fin commonOrder.length := fun i =>
    if fstPosition i < sndPosition i then sndPosition i else fstPosition i
  have hLeft : ∀ i, commonOrder.get (leftPosition i) = (f i).fst := by
    intro i
    by_cases h : fstPosition i < sndPosition i
    · simp only [leftPosition, f, h, if_pos]
      simpa only [List.get_eq_getElem] using hfstPosition i
    · simp only [leftPosition, f, h, if_neg, SourceLemma34Chord.symm]
      simpa only [List.get_eq_getElem] using hsndPosition i

  have hRight : ∀ i, commonOrder.get (rightPosition i) = (f i).snd := by
    intro i
    by_cases h : fstPosition i < sndPosition i
    · simp only [rightPosition, f, h, if_pos]
      simpa only [List.get_eq_getElem] using hsndPosition i
    · simp only [rightPosition, f, h, if_neg, SourceLemma34Chord.symm]
      simpa only [List.get_eq_getElem] using hfstPosition i
  have hLeftRight : ∀ i, leftPosition i < rightPosition i := by
    intro i
    by_cases h : fstPosition i < sndPosition i
    · simpa [leftPosition, rightPosition, h]
    · obtain h' | h' := lt_or_gt_of_ne (hPositionNe i)
      · exact (h h').elim
      · simpa [leftPosition, rightPosition, h] using h'
  have hEndpointOrder : ∀ {i j}, i < j → rightPosition i < leftPosition j := by
    intro i j hij
    rcases hEntryOrder hij with hqv | hqu
    · rcases hqv with ⟨hqi, hqj | hquj⟩
