    · by_cases he : z = c
      · exact he ▸ hc
      · have hzh : z ≠ h := fun he => hh (he ▸ hzD)
        exact (Set.disjoint_left.mp houtB ⟨hzB, he, hzh⟩ hzD).elim
    · exact rail.support_dropUntil_subset hc hzR
  · have he := congrArg Walk.length (rail.take_spec hc)
    simp only [Walk.length_append] at he ⊢
    simp only [Walk.length_reverse]
    omega
  · apply sourceLemma39_length_two_of_internal G _ (z := h)
    · rw [Walk.mem_support_append_iff]
      exact Or.inl A.end_mem_support
    · exact fun he => hh (he ▸ haD)
    · exact fun he => hh (he ▸ hsub b rail.end_mem_support)

/-- One splicing proof for all four independently chosen source-net routes.
The six support conditions name the actual opposite carriers and joints. -/
theorem sourceLemma39_net_cycle_replacement
    [DecidableEq V] {a b c d : V}
    (L : G.Walk a b) (K₁ : G.Walk b c) (R : G.Walk c d) (K₂ : G.Walk d a)
    (hL : L.IsPath) (hK₁ : K₁.IsPath) (hR : R.IsPath) (hK₂ : K₂.IsPath)
    (hlen : 2 ≤ L.length)
    (hLK₁ : ∀ z, z ∈ L.support → z ∈ K₁.support → z = b)
    (hLR : Disjoint {z | z ∈ L.support} {z | z ∈ R.support})
    (hLK₂ : ∀ z, z ∈ L.support → z ∈ K₂.support → z = a)
    (hK₁R : ∀ z, z ∈ K₁.support → z ∈ R.support → z = c)
    (hK₁K₂ : Disjoint {z | z ∈ K₁.support} {z | z ∈ K₂.support})
    (hRK₂ : ∀ z, z ∈ R.support → z ∈ K₂.support → z = d) :
    (L.append (K₁.append (R.append K₂))).IsCycle ∧
    (L.append (K₁.append (R.append K₂))).length =
      L.length + R.length + K₁.length + K₂.length ∧
    IsCycleLength G (L.length + R.length + K₁.length + K₂.length) := by
  have hRK : (R.append K₂).IsPath :=
    sourceLemma39_splice_paths G R K₂ hR hK₂ hRK₂
  have hrest : (K₁.append (R.append K₂)).IsPath := by
    apply sourceLemma39_splice_paths G _ _ hK₁ hRK
    intro z hzK hz
    rw [Walk.mem_support_append_iff] at hz
    rcases hz with hzR | hzK₂
    · exact hK₁R z hzK hzR
    · exact (Set.disjoint_left.mp hK₁K₂ hzK hzK₂).elim
  have hcycle : (L.append (K₁.append (R.append K₂))).IsCycle := by
    apply sourceLemma39_splice_cycle G _ _ hL hrest hlen
    intro z hzL hz
    rw [Walk.mem_support_append_iff, Walk.mem_support_append_iff] at hz
    rcases hz with hzK₁ | hzR | hzK₂
    · exact Or.inr (hLK₁ z hzL hzK₁)
    · exact (Set.disjoint_left.mp hLR hzL hzR).elim
    · exact Or.inl (hLK₂ z hzL hzK₂)
  have heq : (L.append (K₁.append (R.append K₂))).length =
      L.length + R.length + K₁.length + K₂.length := by
    simp only [Walk.length_append]
    omega
  exact ⟨hcycle, heq, ⟨a, _, hcycle, heq⟩⟩

/-- Once both actual route families and all four ambient realizations have
been checked, the source numerical argument chooses the successful families
independently. Translation allocates one fixed connector to each summand. -/
theorem sourceLemma39_net_spectrum_of_four_route_families
    {k : ℕ} (hk : 2 ≤ k)
    (aₗ bₗ aᵣ bᵣ : Fin (k^2 - 1) → ℕ)
    (hbₗ : StrictMono bₗ) (hbᵣ : StrictMono bᵣ)
    (Lₗ sₗ tₗ Lᵣ sᵣ tᵣ c₁ c₂ : ℕ)
    (hLₗ : ∀ i, bₗ i ≤ Lₗ) (hLᵣ : ∀ i, bᵣ i ≤ Lᵣ)
    (hposₗ : ∀ i, 0 < aₗ i) (hposᵣ : ∀ i, 0 < aᵣ i)
    (hcycles : ∀ (e f : Bool) (i j : Fin (k^2 - 1)),
      IsCycleLength G
        ((if e then bₗ i + aₗ i + tₗ else sₗ + aₗ i + (Lₗ - bₗ i)) +
         (if f then bᵣ j + aᵣ j + tᵣ else sᵣ + aᵣ j + (Lᵣ - bᵣ j)) + c₁ + c₂)) :
    ∃ A B : Finset ℕ, k ≤ A.card ∧ k ≤ B.card ∧
      (∀ a ∈ A, 0 < a) ∧ (∀ b ∈ B, 0 < b) ∧
      ∀ a ∈ A, ∀ b ∈ B, IsCycleLength G (a + b) := by
  classical
  let l (e : Bool) (i : Fin (k^2 - 1)) :=
    if e then bₗ i + aₗ i + tₗ else sₗ + aₗ i + (Lₗ - bₗ i)
  let r (f : Bool) (j : Fin (k^2 - 1)) :=
    if f then bᵣ j + aᵣ j + tᵣ else sᵣ + aᵣ j + (Lᵣ - bᵣ j)
  have chooseL : ∃ e : Bool, k ≤ (Finset.univ.image (l e)).card := by
    rcases sourceLemma39_reduced_net_route_length_cardinality hk aₗ bₗ hbₗ Lₗ sₗ tₗ hLₗ with h | h
    · exact ⟨true, h⟩
    · exact ⟨false, h⟩
  have chooseR : ∃ f : Bool, k ≤ (Finset.univ.image (r f)).card := by
    rcases sourceLemma39_reduced_net_route_length_cardinality hk aᵣ bᵣ hbᵣ Lᵣ sᵣ tᵣ hLᵣ with h | h
    · exact ⟨true, h⟩
    · exact ⟨false, h⟩
  obtain ⟨e, he⟩ := chooseL
  obtain ⟨f, hf⟩ := chooseR
  let X := Finset.univ.image (l e)
  let Y := Finset.univ.image (r f)
  refine ⟨X.image (fun a => a + c₁), Y.image (fun b => b + c₂), ?_, ?_, ?_, ?_, ?_⟩
  · rw [Finset.card_image_of_injective _ (fun _ _ h => Nat.add_right_cancel h)]
    exact he
  · rw [Finset.card_image_of_injective _ (fun _ _ h => Nat.add_right_cancel h)]
    exact hf
  · intro a ha
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp ha
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hx
    have hp := hposₗ i
    cases e <;> simp only [l, Bool.false_eq_true, if_false, if_true] <;> omega
  · intro b hb
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hb
    obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hy
    have hp := hposᵣ j
    cases f <;> simp only [r, Bool.false_eq_true, if_false, if_true] <;> omega
  · intro a ha b hb
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp ha
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hb
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hy
    have hc := hcycles e f i j
    change IsCycleLength G (l e i + r f j + c₁ + c₂) at hc
    convert hc using 1 <;> omega

/-- Prefix membership in a simple path is exactly its closed index interval. -/
theorem sourceLemma39_net_prefix_mem_iff
    [DecidableEq V] {a b c z : V} (P : G.Walk a b) (hP : P.IsPath)
    (hc : c ∈ P.support) :
    z ∈ (P.takeUntil c hc).support ↔ z ∈ P.support ∧ P.support.idxOf z ≤ P.support.idxOf c := by
  rw [sourceLemma36_support_takeUntil_eq_take_indexOf]
  constructor
  · intro hz
    obtain ⟨i, hi, hiz⟩ := List.mem_take_iff_getElem.mp hz
    have hiL : i < P.support.length := by omega
    have hidx : P.support.idxOf z = i := by
      rw [← hiz]
      exact sourceLemma36_idxOf_get_eq_position P.support hP.support_nodup ⟨i, hiL⟩
    exact ⟨List.mem_of_mem_take hz, by omega⟩
  · rintro ⟨hz, hle⟩
    have hi := List.idxOf_lt_length_iff.mpr hz
    apply List.mem_take_iff_getElem.mpr
    exact ⟨P.support.idxOf z, by omega, List.idxOf_get hi⟩

/-- Suffix membership in a simple path is exactly its closed index interval. -/
theorem sourceLemma39_net_suffix_mem_iff
    [DecidableEq V] {a b c z : V} (P : G.Walk a b) (hP : P.IsPath)
    (hc : c ∈ P.support) :
    z ∈ (P.dropUntil c hc).support ↔ z ∈ P.support ∧ P.support.idxOf c ≤ P.support.idxOf z := by
  rw [sourceLemma36_support_dropUntil_eq_drop_indexOf]
  constructor
  · intro hz
    obtain ⟨i, hi, hiz⟩ := List.mem_drop_iff_getElem.mp hz
    have hiL : P.support.idxOf c + i < P.support.length := by omega
    have hidx : P.support.idxOf z = P.support.idxOf c + i := by
      rw [← hiz]
      exact sourceLemma36_idxOf_get_eq_position P.support hP.support_nodup ⟨_, hiL⟩
    exact ⟨List.mem_of_mem_drop hz, by omega⟩
  · rintro ⟨hz, hle⟩
    have hi := List.idxOf_lt_length_iff.mpr hz
    apply List.mem_drop_iff_getElem.mpr
    refine ⟨P.support.idxOf z - P.support.idxOf c, by omega, ?_⟩
    have heq : P.support.idxOf c + (P.support.idxOf z - P.support.idxOf c) = P.support.idxOf z := by omega
    simpa only [heq, List.get_eq_getElem] using List.idxOf_get hi

/-- Length of a rail prefix is its actual vertex coordinate. -/
theorem sourceLemma39_net_prefix_length
    [DecidableEq V] {a b c : V} (P : G.Walk a b) (hc : c ∈ P.support) :
    (P.takeUntil c hc).length = P.support.idxOf c := by
  have he := congrArg List.length (sourceLemma36_support_takeUntil_eq_take_indexOf G P c hc)
  have hi := List.idxOf_lt_length_iff.mpr hc
  simp only [Walk.length_support, List.length_take] at he
  have hl := P.length_support
  omega

/-- Both source route types for an ordered attachment family on its own rail.
Apply this independently to the left rail and to the reversed right indexing. -/
theorem sourceLemma39_net_route_family
    [DecidableEq V] {r h : V} {n : ℕ}
    (D : G.Walk r r) (p : Fin (n + 2) → V)
    (rail : G.Walk (p 0) (p (Fin.last (n + 1))))
    (attach : ∀ i, G.Walk (p i) h)
    (hrail : rail.IsPath) (hsub : ∀ z, z ∈ rail.support → z ∈ D.support)
    (hp : ∀ i, p i ∈ rail.support)
    (horder : StrictMono (fun i => rail.support.idxOf (p i)))
    (hh : h ∉ D.support) (hattach : ∀ i, (attach i).IsPath)
    (hout : ∀ i, Disjoint (internalVertices G (attach i)) {z | z ∈ D.support})
    (hdis : ∀ i j, i ≠ j → Disjoint (internalVertices G (attach i)) (internalVertices G (attach j))) :
    let mid : Fin n → Fin (n + 2) := fun i => ⟨i.val + 1, by omega⟩
    ∃ routes : Bool → Fin n → G.Walk (p 0) (p (Fin.last (n + 1))),
      (∀ e i, (routes e i).IsPath ∧ 2 ≤ (routes e i).length) ∧
      (∀ e i z, z ∈ (routes e i).support → z ∈ D.support → z ∈ rail.support) ∧
      (∀ e i z, z ∈ (routes e i).support →
        z ∈ rail.support ∨ ∃ j, z ∈ (attach j).support) ∧
      (∀ i, (routes true i).length = rail.support.idxOf (p (mid i)) +
        (attach (mid i)).length + (attach (Fin.last (n + 1))).length) ∧
      (∀ i, (routes false i).length = (attach 0).length +
        (attach (mid i)).length + (rail.length - rail.support.idxOf (p (mid i)))) ∧
      StrictMono (fun i => rail.support.idxOf (p (mid i))) ∧
      (∀ i, rail.support.idxOf (p (mid i)) ≤ rail.length) ∧
      (∀ i, 0 < (attach (mid i)).length) := by
  classical
  dsimp only
  let mid : Fin n → Fin (n + 2) := fun i => ⟨i.val + 1, by omega⟩
  let routes (e : Bool) (i : Fin n) : G.Walk (p 0) (p (Fin.last (n + 1))) :=
    if e then (rail.takeUntil (p (mid i)) (hp _)).append
        ((attach (mid i)).append (attach (Fin.last (n + 1))).reverse)
    else (attach 0).append ((attach (mid i)).reverse.append (rail.dropUntil (p (mid i)) (hp _)))
  have hmid0 (i : Fin n) : mid i ≠ 0 := by
    intro he; have hv := congrArg Fin.val he; dsimp [mid] at hv; omega
  have hmidlast (i : Fin n) : mid i ≠ Fin.last (n + 1) := by
    intro he; have hv := congrArg Fin.val he; dsimp [mid] at hv; simp only [Fin.val_last] at hv; omega
  have pinj : Function.Injective p := by
    intro i j he
    exact horder.injective (congrArg (fun z => rail.support.idxOf z) he)
  have pref (i : Fin n) := sourceLemma39_net_route_prefix G D rail (hp (mid i))
    (attach (mid i)) (attach (Fin.last (n + 1))) hrail (hattach _) (hattach _)
    hsub hh (fun he => hmid0 i (pinj he)) (fun he => hmidlast i (pinj he))
    (hout _) (hout _) (hdis _ _ (hmidlast i))
  have suff (i : Fin n) := sourceLemma39_net_route_suffix G D rail (hp (mid i))
    (attach 0) (attach (mid i)) hrail (hattach _) (hattach _)
    hsub hh (fun he => hmid0 i (pinj he)) (fun he => hmidlast i (pinj he))
    (hout _) (hout _) (hdis _ _ (hmid0 i).symm)
  refine ⟨routes, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro e i
    cases e
    · exact ⟨(suff i).1, (suff i).2.2.2.2⟩
    · exact ⟨(pref i).1, (pref i).2.2.2.2⟩
  · intro e i
    cases e
    · exact (suff i).2.2.1
    · exact (pref i).2.2.1
  · intro e i z hz
    cases e
    · rcases (suff i).2.1 z |>.mp hz with hzA | hzB | hzR
      · exact Or.inr ⟨0, hzA⟩
      · exact Or.inr ⟨mid i, hzB⟩
      · exact Or.inl (rail.support_dropUntil_subset (hp _) hzR)
    · rcases (pref i).2.1 z |>.mp hz with hzR | hzA | hzB
      · exact Or.inl (rail.support_takeUntil_subset (hp _) hzR)
      · exact Or.inr ⟨mid i, hzA⟩
      · exact Or.inr ⟨Fin.last (n + 1), hzB⟩
  · intro i
    have he := (pref i).2.2.2.1
    rw [sourceLemma39_net_prefix_length] at he
    exact he
  · intro i
    have he := (suff i).2.2.2.1
    rw [sourceLemma39_net_prefix_length] at he
    exact he
  · intro i j hij
    apply horder
    change i.val + 1 < j.val + 1
    exact Nat.add_lt_add_right hij 1
  · intro i
    rw [← sourceLemma39_net_prefix_length G rail (hp (mid i))]
    exact rail.length_takeUntil_le _
  · intro i
    change 0 < (attach (mid i)).length
    have hne : p (mid i) ≠ h := fun he => hh (he ▸ hsub _ (hp _))
    have hn := Walk.not_nil_of_ne hne (p := attach (mid i))
    rw [Walk.nil_iff_length_eq] at hn
    omega

/-- The structural rail and attachment carriers, rather than any claimed
universal disjointness of walks, justify all four replacement combinations. -/
theorem sourceLemma39_net_routes_ambient_realization
    [DecidableEq V] {r a b c d u v : V} {n m N M : ℕ}
    (D : G.Walk r r) (L : G.Walk a b) (R : G.Walk c d)
    (K₁ : G.Walk b c) (K₂ : G.Walk d a)
    (lp : Fin N → V) (rp : Fin M → V)
    (left : ∀ i, G.Walk (lp i) u) (right : ∀ j, G.Walk (rp j) v)
    (lroute : Bool → Fin n → G.Walk a b) (rroute : Bool → Fin m → G.Walk c d)
    (hlpath : ∀ e i, (lroute e i).IsPath ∧ 2 ≤ (lroute e i).length)
    (hrpath : ∀ f j, (rroute f j).IsPath)
    (hlD : ∀ e i z, z ∈ (lroute e i).support → z ∈ D.support → z ∈ L.support)
    (hrD : ∀ f j z, z ∈ (rroute f j).support → z ∈ D.support → z ∈ R.support)
    (hlcarrier : ∀ e i z, z ∈ (lroute e i).support →
      z ∈ L.support ∨ ∃ t, z ∈ (left t).support)
    (hrcarrier : ∀ f j z, z ∈ (rroute f j).support →
      z ∈ R.support ∨ ∃ t, z ∈ (right t).support)
    (hLsub : ∀ z, z ∈ L.support → z ∈ D.support)
    (hRsub : ∀ z, z ∈ R.support → z ∈ D.support)
    (hK₁sub : ∀ z, z ∈ K₁.support → z ∈ D.support)
    (hK₂sub : ∀ z, z ∈ K₂.support → z ∈ D.support)
    (hK₁ : K₁.IsPath) (hK₂ : K₂.IsPath)
    (hcross : ∀ i j, Disjoint {z | z ∈ (left i).support} {z | z ∈ (right j).support})
    (hLR : Disjoint {z | z ∈ L.support} {z | z ∈ R.support})
    (hLK₁ : ∀ z, z ∈ L.support → z ∈ K₁.support → z = b)
    (hLK₂ : ∀ z, z ∈ L.support → z ∈ K₂.support → z = a)
    (hK₁R : ∀ z, z ∈ K₁.support → z ∈ R.support → z = c)
    (hK₁K₂ : Disjoint {z | z ∈ K₁.support} {z | z ∈ K₂.support})
    (hRK₂ : ∀ z, z ∈ R.support → z ∈ K₂.support → z = d) :
    ∀ e f i j, IsCycleLength G
      ((lroute e i).length + (rroute f j).length + K₁.length + K₂.length) := by
  intro e f i j
  have hrouteDis : Disjoint {z | z ∈ (lroute e i).support} {z | z ∈ (rroute f j).support} := by
    apply Set.disjoint_left.mpr
    intro z hzL hzR
    rcases hlcarrier e i z hzL with hzrailL | ⟨s, hzs⟩
    · exact Set.disjoint_left.mp hLR hzrailL (hrD f j z hzR (hLsub z hzrailL))
    · rcases hrcarrier f j z hzR with hzrailR | ⟨t, hzt⟩
      · exact Set.disjoint_left.mp hLR (hlD e i z hzL (hRsub z hzrailR)) hzrailR
      · exact Set.disjoint_left.mp (hcross s t) hzs hzt
  exact (sourceLemma39_net_cycle_replacement G (lroute e i) K₁ (rroute f j) K₂
    (hlpath e i).1 hK₁ (hrpath f j) hK₂ (hlpath e i).2
    (fun z hzL hzK => hLK₁ z (hlD e i z hzL (hK₁sub z hzK)) hzK)
    hrouteDis
    (fun z hzL hzK => hLK₂ z (hlD e i z hzL (hK₂sub z hzK)) hzK)
    (fun z hzK hzR => hK₁R z hzK (hrD f j z hzR (hK₁sub z hzK)))
    hK₁K₂
    (fun z hzR hzK => hRK₂ z (hrD f j z hzR (hK₂sub z hzK)) hzK)).2.2

/-- Indices of retained prefix vertices agree with their original indices. -/
theorem sourceLemma39_net_prefix_idx
    [DecidableEq V] {a b c z : V} (P : G.Walk a b) (hc : c ∈ P.support)
    (hz : z ∈ (P.takeUntil c hc).support) :
    (P.takeUntil c hc).support.idxOf z = P.support.idxOf z := by
  conv_rhs => rw [← P.take_spec hc, Walk.support_append, List.idxOf_append_of_mem hz]

/-- The rail between ordered vertices has exactly the closed ambient interval. -/
theorem sourceLemma39_net_rail_segment
    [DecidableEq V] {x y a b : V} (I : G.Walk x y) (hI : I.IsPath)
    (ha : a ∈ I.support) (hb : b ∈ I.support)
    (hab : I.support.idxOf a ≤ I.support.idxOf b) :
    ∃ L : G.Walk a b, L.IsPath ∧
      (∀ z, z ∈ L.support ↔ z ∈ I.support ∧
        I.support.idxOf a ≤ I.support.idxOf z ∧ I.support.idxOf z ≤ I.support.idxOf b) ∧
      (∀ z, z ∈ L.support → L.support.idxOf z = I.support.idxOf z - I.support.idxOf a) := by
  let P := I.takeUntil b hb
  have haP : a ∈ P.support := (sourceLemma39_net_prefix_mem_iff G I hI hb).mpr ⟨ha, hab⟩
  let L := P.dropUntil a haP
  have hP := hI.takeUntil hb
  have hL := hP.dropUntil haP
  have hmem (z : V) : z ∈ L.support ↔ z ∈ I.support ∧
      I.support.idxOf a ≤ I.support.idxOf z ∧ I.support.idxOf z ≤ I.support.idxOf b := by
    change z ∈ (P.dropUntil a haP).support ↔ _
    rw [sourceLemma39_net_suffix_mem_iff G P hP haP]
    constructor
    · rintro ⟨hzP, hle⟩
      have hz := (sourceLemma39_net_prefix_mem_iff G I hI hb).mp hzP
      rw [sourceLemma39_net_prefix_idx G I hb haP, sourceLemma39_net_prefix_idx G I hb hzP] at hle
      exact ⟨hz.1, hle, hz.2⟩
    · rintro ⟨hz, hlow, hupp⟩
      have hzP := (sourceLemma39_net_prefix_mem_iff G I hI hb).mpr ⟨hz, hupp⟩
      refine ⟨hzP, ?_⟩
      rw [sourceLemma39_net_prefix_idx G I hb haP, sourceLemma39_net_prefix_idx G I hb hzP]
      exact hlow
  refine ⟨L, hL, hmem, ?_⟩
  intro z hz
  have hzP : z ∈ P.support := P.support_dropUntil_subset haP hz
  have hlen := sourceLemma39_net_prefix_length G P haP
  have hidxA := sourceLemma39_net_prefix_idx G I hb haP
  have hidxZ := sourceLemma39_net_prefix_idx G I hb hzP
  have hsupport : L.support = P.support.drop (P.support.idxOf a) :=
    sourceLemma36_support_dropUntil_eq_drop_indexOf G P a haP
  have hzpos : L.support.idxOf z < L.support.length := List.idxOf_lt_length_iff.mpr hz
  have hiL : P.support.idxOf a + L.support.idxOf z < P.support.length := by
    have hl := congrArg List.length hsupport
    simp only [List.length_drop] at hl
    omega
  have hgetP : P.support.get ⟨P.support.idxOf a + L.support.idxOf z, hiL⟩ = z := by
    have hget : L.support[L.support.idxOf z]? = some z := by
      rw [List.getElem?_eq_getElem hzpos]
      exact congrArg some (List.idxOf_get hzpos)
    conv at hget => lhs; rw [hsupport]
    rw [List.getElem?_drop] at hget
    simp only [← hsupport] at hget
    rw [List.getElem?_eq_getElem hiL] at hget
    exact Option.some.inj hget
  have he := sourceLemma36_idxOf_get_eq_position P.support hP.support_nodup
