      ((sourceLemma36RotatedCycleOrder G C data.anchor).get (rightPosition i)) := by
    intro i
    exact (sourceLemma36_offCycle_adj (G := G) C (hoff i)).1
  let attachment : ∀ i, G.Walk
      ((sourceLemma36RotatedCycleOrder G C data.anchor).get (leftPosition i))
      ((sourceLemma36RotatedCycleOrder G C data.anchor).get (rightPosition i)) :=
    fun i => Walk.cons (hGadj i) .nil
