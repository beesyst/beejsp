/-- A four-set contributes at most six undirected non-loop edges. -/
private theorem sourceLemma39_fourSet_edges_card {W : Type*} [DecidableEq W]
    (Y : Finset W) (hY : Y.card ≤ 4) :
    (Y.sym2.filter fun e => ¬ e.IsDiag).card ≤ 6 := by
  classical
  have hdiag : (Y.sym2.filter Sym2.IsDiag) = Y.image Sym2.diag := by
    ext e
