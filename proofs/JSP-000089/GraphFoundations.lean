/-- An ambient edge distinct from `f` cannot lie on both oriented sides of `f`. -/
private theorem sourceLemma34_exists_oriented_side_avoiding_edge [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    {u v : V} (huv : G.Adj u v) (f : SourceLemma34Chord G C)
    (hEdge : s(u, v) ≠ f.edge) :
    ∃ dir : Bool, s(u, v) ∉
      (sourceLemma34_orientedSide G C hC f dir).path.edges := by
  by_cases hfalse : s(u, v) ∈
      (sourceLemma34_orientedSide G C hC f false).path.edges
  · refine ⟨true, ?_⟩
    intro htrue
    have hfalseFst : u ∈
        (sourceLemma34_orientedSide G C hC f false).path.support := by
      change s(u, v) ∈ _ at hfalse
      exact Walk.fst_mem_support_of_mem_edges
        (sourceLemma34_orientedSide G C hC f false).path hfalse
    have htrueFst : u ∈
        (sourceLemma34_orientedSide G C hC f true).path.support := by
      change s(u, v) ∈ _ at htrue
      exact Walk.fst_mem_support_of_mem_edges
        (sourceLemma34_orientedSide G C hC f true).path htrue
