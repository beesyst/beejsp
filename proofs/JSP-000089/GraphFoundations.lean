  | directNet h =>
    obtain ⟨data, iP, matching, T, u, w, v, x, y, ⟨net⟩⟩ := h
    exact sourceLemma25_branchI_direct_net_spectrum_complete G R data iP matching T u w v x y net
  | directCrossladder h =>
    obtain ⟨data, iP, matching, ⟨direct⟩⟩ := h
    exact sourceLemma25_branchI_direct_crossladder_spectrum_complete G R data iP matching direct
  | residualBlock h =>
    obtain ⟨data, iP, matching, ladder, i, block⟩ := h
    exact sourceLemma25_branchI_residual_block_spectrum_complete G R data iP matching ladder i block
  | residualTruncation h =>
    obtain ⟨M⟩ := h
    exact sourceLemma25_branchI_residual_truncation_spectrum_complete G R M
  | residualMesh h =>
