        Finset.mem_filter.mpr ⟨Finset.mk_mem_sym2_iff.mpr
          ⟨by simp [Y, hi], by simp [Y, hj]⟩, by simpa using hne⟩⟩
  calc
    _ ≤ (Finset.univ.biUnion E).card := Finset.card_le_card hsub
    _ ≤ ∑ l : Fin n, (E l).card := Finset.card_biUnion_le
    _ ≤ ∑ _l : Fin n, 6 := Finset.sum_le_sum (fun l _ => hE l)
    _ = 6*n := by simp [Nat.mul_comm]

/-- At a designated root, three K4 neighbours are separate from its two cycle
neighbours, giving the five-degree input to the repaired Lemma 3.8. -/
private theorem sourceLemma39_shadow_root_degree {W : Type*} [Fintype W] [DecidableEq W]
    (H : SimpleGraph W) {r : W} (D : H.Walk r r) (hD : D.IsHamiltonianCycle)
    {n : ℕ} (X : Fin n → Finset W) (root : Fin n → W)
    (hcard : ∀ i, (X i).card = 4) (hmem : ∀ i, root i ∈ X i)
