    Nonempty (SourceLemma39AmbientProperTruncation G C k) := by
  classical
  obtain ⟨owner, howner, howned⟩ := sourceLemma39_direct_truncation_owners G shadow data direct
  let oldOrder := sourceLemma36RotatedCycleOrder shadow.graph shadow.cycle data.anchor
  let left := fun i => oldOrder.get (direct.leftPosition i)
  let right := fun i => oldOrder.get (direct.rightPosition i)
