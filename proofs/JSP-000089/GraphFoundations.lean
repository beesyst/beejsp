/-- Concrete Phase 5 interleaving: a complement endpoint after `Qvᵢ`'s
block, together with a crossing of the central rung, makes every right-buffer
rung cross the same foreign chord. -/
private theorem sourceLemma37_Qv_after_rightBuffer_crosses
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching)
    (i : Fin (2 * k - 1)) (f : SourceLemma34Chord G C)
    (hcross : sourceLemma34Crosses G C hC.isCycle
      (sourceLemma37CentralRungChord G C k hk Z data iP matching ladder i) f)
    (x : V) (hxEndpoint : x = f.fst ∨ x = f.snd)
    (hxOutside : x ∉ sourceLemma36CanonicalPieceVertices G C hC k Z data iP)
    (s : Fin (sourceLemma36ComplementOrderAt G C hC k Z data iP).length)
    (hsget : (sourceLemma36ComplementOrderAt G C hC k Z data iP).get s = x)
    (hafter : ladder.secondPosition (sourceLemma37BlockLastIndex k i) < s) :
    ∀ t : Fin k, sourceLemma34Crosses G C hC.isCycle
      (sourceLemma37ResidualRungChord G C k Z data iP matching ladder
        (sourceLemma37RightBufferIndex k hk i t)) f := by
  let middle := sourceLemma37CentralRungIndex k hk i
  let central := sourceLemma37CentralRungChord G C k hk Z data iP matching ladder i
  have hmiddleLast : middle < sourceLemma37BlockLastIndex k i := by
    simpa only [middle] using (sourceLemma37_block_indices k hk i).2
  have hmiddleS : ladder.secondPosition middle < s :=
    (ladder.second_arc_order middle (sourceLemma37BlockLastIndex k i) hmiddleLast).trans hafter
  have hxOutMiddle : x ∉
      (sourceLemma34_orientedSide G C hC.isCycle central false).path.support := by
    exact sourceLemma37_complement_after_second_not_mem_forwardSide
      G C k Z data iP matching ladder middle central rfl rfl x hxOutside s hsget hmiddleS
  obtain ⟨dir, hcrossAt⟩ := hcross
  have hcrossFalse : sourceLemma34CrossesAt G C hC.isCycle central f false :=
    sourceLemma34_crossingAt_any_bool G C hC.isCycle central f dir false hcrossAt
  intro t
  let j := sourceLemma37RightBufferIndex k hk i t
  let rung := sourceLemma37ResidualRungChord G C k Z data iP matching ladder j
  have hjmem : j ∈ sourceLemma37BlockRungs k i := by
    simpa only [j] using (sourceLemma37_buffer_mem_block k hk i t).2

  have hjbounds :
      sourceLemma37BlockFirstIndex k i ≤ j ∧
        j ≤ sourceLemma37BlockLastIndex k i := by
    simpa only [sourceLemma37BlockRungs, Finset.mem_filter,
      Finset.mem_univ, true_and] using hjmem

  have hjlast : j ≤ sourceLemma37BlockLastIndex k i :=
    hjbounds.2
  have hjs : ladder.secondPosition j < s := by
    by_cases hj : j = sourceLemma37BlockLastIndex k i
    · simpa only [hj] using hafter
    · exact (ladder.second_arc_order j (sourceLemma37BlockLastIndex k i)
        (lt_of_le_of_ne hjlast hj)).trans hafter
  have hxOutRung : x ∉
      (sourceLemma34_orientedSide G C hC.isCycle rung false).path.support :=
    sourceLemma37_complement_after_second_not_mem_forwardSide
      G C k Z data iP matching ladder j rung rfl rfl x hxOutside s hsget hjs
  rcases hxEndpoint with hxfst | hxsnd
  · rcases hcrossFalse with hinside | hinside
    · exact False.elim (hxOutMiddle (by simpa [hxfst] using hinside.1.1))
    · refine ⟨false, Or.inr ⟨?_, by simpa [hxfst] using hxOutRung⟩⟩
      exact sourceLemma37_middle_forwardSide_strictInside_rightBuffer_forwardSide
        G C k hk Z data iP matching ladder i t central rung rfl rfl rfl rfl f.snd hinside.1.1
  · rcases hcrossFalse with hinside | hinside
    · refine ⟨false, Or.inl ⟨?_, by simpa [hxsnd] using hxOutRung⟩⟩
      exact sourceLemma37_middle_forwardSide_strictInside_rightBuffer_forwardSide
        G C k hk Z data iP matching ladder i t central rung rfl rfl rfl rfl f.fst hinside.1.1
    · exact False.elim (hxOutMiddle (by simpa [hxsnd] using hinside.1.1))

/-- Every left-buffer forward side is contained in the central forward side.
This is the inverse containment used by the two left-buffer interleavings. -/
private theorem sourceLemma37_leftBuffer_forwardSide_subset_middle
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching)
    (i : Fin (2 * k - 1)) (t : Fin k)
    (middleRung rungJ : SourceLemma34Chord G C)
    (hmiddleFst : middleRung.fst = ladder.firstVertex (sourceLemma37CentralRungIndex k hk i))
    (hmiddleSnd : middleRung.snd = ladder.secondVertex (sourceLemma37CentralRungIndex k hk i))
    (hrungJFst : rungJ.fst = ladder.firstVertex (sourceLemma37LeftBufferIndex k hk i t))
    (hrungJSnd : rungJ.snd = ladder.secondVertex (sourceLemma37LeftBufferIndex k hk i t))
    (y : V) :
    y ∈ (sourceLemma34_orientedSide G C hC.isCycle rungJ false).path.support →
      y ∈ (sourceLemma34_orientedSide G C hC.isCycle middleRung false).path.support := by
  let middle := sourceLemma37CentralRungIndex k hk i
  let j := sourceLemma37LeftBufferIndex k hk i t

  have hjmiddle_le : j ≤ middle := by
    apply Fin.mk_le_mk.mpr
    dsimp [j, middle, sourceLemma37LeftBufferIndex,
      sourceLemma37BlockFirstIndex, sourceLemma37CentralRungIndex]
    have ht : t.1 < k := t.2
    have hmul :
        (2 * i.1 + 1) * k = 2 * i.1 * k + k := by
      ring
    rw [hmul]
    omega

  by_cases hjm : j = middle

  · intro hy

    have hfstEq : rungJ.fst = middleRung.fst := by
      calc
        rungJ.fst = ladder.firstVertex j := by
          simpa only [j] using hrungJFst
        _ = ladder.firstVertex middle :=
          congrArg ladder.firstVertex hjm
        _ = middleRung.fst := by
          symm
          simpa only [middle] using hmiddleFst

    have hsndEq : rungJ.snd = middleRung.snd := by
      calc
        rungJ.snd = ladder.secondVertex j := by
          simpa only [j] using hrungJSnd
        _ = ladder.secondVertex middle :=
          congrArg ladder.secondVertex hjm
        _ = middleRung.snd := by
          symm
          simpa only [middle] using hmiddleSnd

    have hsupport :
        (sourceLemma34_orientedSide G C hC.isCycle rungJ false).path.support =
          (sourceLemma34_orientedSide G C hC.isCycle middleRung false).path.support := by
      calc
        (sourceLemma34_orientedSide G C hC.isCycle rungJ false).path.support =
            (sourceOrientedCycleSubpath G C
              (hC.mem_support rungJ.fst)
              (hC.mem_support rungJ.snd)).support := by
          exact sourceLemma37_normalizedRung_forwardSide_support
            G C hC rungJ rungJ.fst rungJ.snd rfl rfl

        _ =
            (sourceOrientedCycleSubpath G C
              (hC.mem_support middleRung.fst)
              (hC.mem_support middleRung.snd)).support := by
          exact sourceOrientedCycleSubpath_support_congr G C
            (hC.mem_support rungJ.fst)
            (hC.mem_support rungJ.snd)
            (hC.mem_support middleRung.fst)
            (hC.mem_support middleRung.snd)
            hfstEq hsndEq

        _ =
            (sourceLemma34_orientedSide G C hC.isCycle middleRung false).path.support := by
          symm
          exact sourceLemma37_normalizedRung_forwardSide_support
            G C hC middleRung middleRung.fst middleRung.snd rfl rfl

    rw [hsupport] at hy
    exact hy

  · have hjmiddle : j < middle :=
      lt_of_le_of_ne hjmiddle_le hjm

    have hfirst :
        ladder.firstPosition middle < ladder.firstPosition j :=
      ladder.first_arc_order j middle hjmiddle

    have hsecond :
        ladder.secondPosition j < ladder.secondPosition middle :=
      ladder.second_arc_order j middle hjmiddle

    intro hy

    by_cases hyCanonical :
        y ∈ sourceLemma36CanonicalPieceVertices G C hC k Z data iP

    · obtain ⟨p, -, hp⟩ :=
        sourceLemma36_canonicalPiece_position
          G C hC k Z data iP hyCanonical

      have hjp : ladder.firstPosition j ≤ p := by
        apply le_of_not_gt
        intro hpj
        exact
          (sourceLemma37_canonical_before_first_not_mem_forwardSide
            G C k Z data iP matching ladder j rungJ
            hrungJFst hrungJSnd y hyCanonical p hp hpj) hy

      exact sourceLemma37_canonical_after_first_mem_forwardSide
        G C k Z data iP matching ladder middle middleRung
        hmiddleFst hmiddleSnd y hyCanonical p hp
        (hfirst.le.trans hjp)

    · obtain ⟨s, hs⟩ :=
        sourceLemma36_complementOrderAt_position
          G C hC k Z data iP hyCanonical

      have hsj : s ≤ ladder.secondPosition j := by
        apply le_of_not_gt
        intro hjs
        exact
          (sourceLemma37_complement_after_second_not_mem_forwardSide
            G C k Z data iP matching ladder j rungJ
            hrungJFst hrungJSnd y hyCanonical s hs hjs) hy

      exact sourceLemma37_complement_before_second_mem_forwardSide
        G C k Z data iP matching ladder middle middleRung
        hmiddleFst hmiddleSnd y hyCanonical s hs
        (hsj.trans hsecond.le)

/-- Concrete Phase 3 interleaving: a canonical endpoint after `Quᵢ`'s block
forces every left-buffer residual rung to cross the central crossing chord. -/
private theorem sourceLemma37_Qu_after_leftBuffer_crosses
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching)
    (i : Fin (2 * k - 1)) (f : SourceLemma34Chord G C)
    (hcross : sourceLemma34Crosses G C hC.isCycle
      (sourceLemma37CentralRungChord G C k hk Z data iP matching ladder i) f)
    (x : V) (hxEndpoint : x = f.fst ∨ x = f.snd)
    (hxCanonical : x ∈ sourceLemma36CanonicalPieceVertices G C hC k Z data iP)
    (p : Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length)
    (hp : (sourceLemma36RotatedCycleOrder G C data.anchor).get p = x)
    (hafter : ladder.firstPosition (sourceLemma37BlockFirstIndex k i) < p) :
    ∀ t : Fin k, sourceLemma34Crosses G C hC.isCycle
      (sourceLemma37ResidualRungChord G C k Z data iP matching ladder
        (sourceLemma37LeftBufferIndex k hk i t)) f := by
  by_cases hk1 : k = 1
  · subst k
    intro t
    have ht : t = ⟨0, by omega⟩ := Fin.ext (by omega)
    subst t
    simpa [sourceLemma37LeftBufferIndex, sourceLemma37CentralRungIndex] using hcross
  · have hk2 : 2 ≤ k := by omega
    let middle := sourceLemma37CentralRungIndex k hk i
    let central :=
      sourceLemma37CentralRungChord G C k hk Z data iP matching ladder i
    have hfirstMiddle : sourceLemma37BlockFirstIndex k i < middle := by
      apply Fin.mk_lt_mk.mpr
      dsimp [middle, sourceLemma37BlockFirstIndex, sourceLemma37CentralRungIndex]
      have hbase : 2 * i.1 * k + 1 < (2 * i.1 + 1) * k := by
        nlinarith
      omega
    have hmiddleP : ladder.firstPosition middle < p :=
      (ladder.first_arc_order (sourceLemma37BlockFirstIndex k i) middle hfirstMiddle).trans hafter
    have hxMiddle := sourceLemma37_canonical_after_first_mem_forwardSide
      G C k Z data iP matching ladder middle central rfl rfl x hxCanonical p hp hmiddleP.le
    obtain ⟨dir, hAt⟩ := hcross
    have hfalse := sourceLemma34_crossingAt_any_bool G C hC.isCycle central f dir false hAt
    intro t
    let j := sourceLemma37LeftBufferIndex k hk i t
    let rung := sourceLemma37ResidualRungChord G C k Z data iP matching ladder j
    have hjmem : j ∈ sourceLemma37BlockRungs k i := by
      simpa only [j] using (sourceLemma37_buffer_mem_block k hk i t).1

    have hjbounds :
        sourceLemma37BlockFirstIndex k i ≤ j ∧
          j ≤ sourceLemma37BlockLastIndex k i := by
      simpa only [sourceLemma37BlockRungs, Finset.mem_filter,
        Finset.mem_univ, true_and] using hjmem

    have hfirstj : sourceLemma37BlockFirstIndex k i ≤ j :=
      hjbounds.1
    have hjp : ladder.firstPosition j < p := by
      by_cases hj : j = sourceLemma37BlockFirstIndex k i
      · simpa only [hj] using hafter
      · exact (ladder.first_arc_order (sourceLemma37BlockFirstIndex k i) j
          (lt_of_le_of_ne hfirstj (Ne.symm hj))).trans hafter
    have hxInside : sourceLemma34SideStrictInside G
        (sourceLemma34_orientedSide G C hC.isCycle rung false) x := by
      refine ⟨sourceLemma37_canonical_after_first_mem_forwardSide
        G C k Z data iP matching ladder j rung rfl rfl x hxCanonical p hp hjp.le, ?_, ?_⟩
      · intro h
        change x = ladder.firstVertex j at h

        have hjget :
            (sourceLemma36RotatedCycleOrder G C data.anchor).get
                (ladder.firstPosition j) = x := by
          rw [ladder.firstPosition_vertex]
          exact h.symm

        have hpj : p = ladder.firstPosition j :=
          List.nodup_iff_injective_get.mp
            (sourceLemma36_rotatedCycleOrder_nodup G C hC data.anchor)
            (hp.trans hjget.symm)

        exact (ne_of_gt hjp) hpj
      · intro h; apply sourceLemma37_secondVertex_not_mem_canonicalPiece G C k Z data iP matching ladder j
        simpa [h] using hxCanonical
    rcases hxEndpoint with hxfst | hxsnd
    · rcases hfalse with hin | hin
      · refine ⟨false, Or.inl ⟨by simpa [hxfst] using hxInside, ?_⟩⟩
        intro hm
        exact hin.2 (sourceLemma37_leftBuffer_forwardSide_subset_middle
          G C k hk Z data iP matching ladder i t central rung rfl rfl rfl rfl f.snd hm)
      · exact False.elim (hin.2 (by simpa [hxfst] using hxMiddle))
    · rcases hfalse with hin | hin
      · exact False.elim (hin.2 (by simpa [hxsnd] using hxMiddle))
      · refine ⟨false, Or.inr ⟨by simpa [hxsnd] using hxInside, ?_⟩⟩
        intro hm
        exact hin.2 (sourceLemma37_leftBuffer_forwardSide_subset_middle
          G C k hk Z data iP matching ladder i t central rung rfl rfl rfl rfl f.fst hm)

/-- Concrete Phase 4 interleaving: a complement endpoint before `Qvᵢ`'s
block forces every left-buffer residual rung to cross the central crossing
chord. -/
private theorem sourceLemma37_Qv_before_leftBuffer_crosses
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching)
    (i : Fin (2 * k - 1)) (f : SourceLemma34Chord G C)
    (hcross : sourceLemma34Crosses G C hC.isCycle
      (sourceLemma37CentralRungChord G C k hk Z data iP matching ladder i) f)
    (x : V) (hxEndpoint : x = f.fst ∨ x = f.snd)
    (hxOutside : x ∉ sourceLemma36CanonicalPieceVertices G C hC k Z data iP)
    (s : Fin (sourceLemma36ComplementOrderAt G C hC k Z data iP).length)
    (hs : (sourceLemma36ComplementOrderAt G C hC k Z data iP).get s = x)
    (hbefore : s < ladder.secondPosition (sourceLemma37BlockFirstIndex k i)) :
    ∀ t : Fin k, sourceLemma34Crosses G C hC.isCycle
