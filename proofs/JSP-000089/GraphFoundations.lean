  ⟨0, lt_of_lt_of_le Nat.zero_lt_one hk⟩

/-- The directed segment between two ordered first-rail vertices stays in the
canonical piece.  This is the concrete global-cycle separation that the old
two-coordinate record lacked: no second-rail vertex can occur between two
ordered first-rail vertices on the printed `u` side. -/
private theorem sourceLemma36Section2Ladder_first_rail_segment_canonical
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) {n : ℕ}
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching n)
    (i j : Fin n) (hij : i ≤ j) (x : V)
    (hx : x ∈ (sourceLemma36RotatedPositionSubpath G C hC data.anchor
      (ladder.firstPosition i) (ladder.firstPosition j)).support) :
    x ∈ sourceLemma36CanonicalPieceVertices G C hC k Z data iP := by
  apply sourceLemma36_positionSubpath_support_subset_canonicalPiece
    G C hC k Z data iP
    ((sourceLemma36_rotatedGet_mem_canonicalPiece_iff G C hC k Z data iP
      (ladder.firstPosition i)).mp (by
        rw [ladder.firstPosition_vertex]
        exact ladder.first_in_canonical i))
    ((sourceLemma36_rotatedGet_mem_canonicalPiece_iff G C hC k Z data iP
      (ladder.firstPosition j)).mp (by
        rw [ladder.firstPosition_vertex]
        exact ladder.first_in_canonical j))
    (by
      by_cases h : i = j
      · simpa [h]
      · exact (ladder.first_arc_order i j (lt_of_le_of_ne hij h)).le)
    hx

/-- Thus no second-rail endpoint lies on an ordered first-rail segment. -/
private theorem sourceLemma36Section2Ladder_second_not_mem_first_rail_segment
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
