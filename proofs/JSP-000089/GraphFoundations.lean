private theorem sourceLemma36_complementOrderAt_get_reanchor_of_last
    [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (i : Fin k)
    (hlast : ¬ i.1 + 1 < k)
