    [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (hno : ¬ sourceLemma36PieceHasChord G C hC k Z data iP)
    (hdegree : ∀ z ∈ sourceLemma36CaseBRootsAt G C hC k Z data iP, 5 ≤ G.degree z)
