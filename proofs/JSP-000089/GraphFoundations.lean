/-- Taking a transferred walk up to a retained vertex is the transfer of the
corresponding original prefix. -/
private theorem sourceLemma37_takeUntil_transfer [DecidableEq V]
    {H : SimpleGraph V} {u v x : V} (p : G.Walk u v)
    (hp : ∀ e, e ∈ p.edges → e ∈ H.edgeSet)
    (hx : x ∈ p.support) :
    (p.transfer H hp).takeUntil x
        (by simpa only [Walk.support_transfer] using hx)
      =
    (p.takeUntil x hx).transfer H
      (fun e he => hp e (p.edges_takeUntil_subset hx he)) := by
  induction p generalizing x H with
  | nil =>
      rw [Walk.mem_support_nil_iff] at hx
      subst x
      simp [Walk.takeUntil]
  | @cons u v w hadj p ih =>
      by_cases hstart : u = x
      · subst x
        simp [Walk.takeUntil]
      · simp [Walk.transfer, Walk.takeUntil, hstart]
        exact ih (fun edge hedge => hp edge (by simp [hedge]))
          (by simpa [Walk.support_cons, hstart, eq_comm] using hx)

