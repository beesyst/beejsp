/-- Vertex carrier of the exact Section-2 ladder: the base cycle plus all
selected rung paths. -/
private noncomputable def sourceLemma36Section2LadderCarrier
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) {n : ℕ}
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching n) : Finset V :=
  ladder.cycle.support.toFinset ∪ Finset.univ.biUnion fun i => (ladder.rung i).support.toFinset

/-- A genuine, unrooted Section-2 crossladder.  The final intersection field
is the source condition `V(H) ∩ V(Q) = {u,v}` and is deliberately not weakened
to an edge-crossing certificate. -/
private structure SourceLemma36Section2Crossladder [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching k) (hk : 1 ≤ k) where
  u : V
  v : V
  q : G.Walk u v
  q_isPath : q.IsPath
  u_on_first_end_arc : u ∈
    (sourceLemma36Section2FirstEndArc G C k Z data iP matching ladder hk).support
  v_on_second_end_arc : v ∈
    (sourceLemma36Section2SecondEndArc G C k Z data iP matching ladder hk).support
  u_ne_v : u ≠ v
  q_inter_ladder : q.support.toFinset ∩
    sourceLemma36Section2LadderCarrier G C k Z data iP matching ladder = {u, v}
  /-- The physical chord path and its actual boundary-edge provenance. -/
  q_length_one : q.length = 1
  q_off_cycle : s(u, v) ∉ C.edges
  /-- Retained from the producer crossing both extreme rungs. -/
  q_end_gap_partition :
    (sourceLemma34StrictInside G C
      (hC.mem_support (ladder.secondVertex (sourceLemma36Section2FirstIndex k hk)))
      (hC.mem_support (ladder.firstVertex (sourceLemma36Section2FirstIndex k hk))) u ∧ sourceLemma34StrictInside G C
      (hC.mem_support (ladder.firstVertex (sourceLemma36Section2LastIndex k hk)))
      (hC.mem_support (ladder.secondVertex (sourceLemma36Section2LastIndex k hk))) v) ∨
    (sourceLemma34StrictInside G C
      (hC.mem_support (ladder.secondVertex (sourceLemma36Section2FirstIndex k hk)))
      (hC.mem_support (ladder.firstVertex (sourceLemma36Section2FirstIndex k hk))) v ∧ sourceLemma34StrictInside G C
      (hC.mem_support (ladder.firstVertex (sourceLemma36Section2LastIndex k hk)))
      (hC.mem_support (ladder.secondVertex (sourceLemma36Section2LastIndex k hk))) u)

/-- A chord whose endpoints have been localized on the two exceptional arcs
is the required one-edge cross path.  Its support contains only those two
endpoints, so its intersection with the complete ladder carrier is exact. -/
private noncomputable def sourceLemma36Section2Crossladder_of_chord
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching k) (hk : 1 ≤ k)
    (f : SourceLemma34Chord G C)
    (hfst : f.fst ∈ (sourceLemma36Section2FirstEndArc G C k Z data iP matching ladder hk).support)
    (hsnd : f.snd ∈ (sourceLemma36Section2SecondEndArc G C k Z data iP matching ladder hk).support)
    (hgap : (sourceLemma34StrictInside G C
      (hC.mem_support (ladder.secondVertex (sourceLemma36Section2FirstIndex k hk)))
