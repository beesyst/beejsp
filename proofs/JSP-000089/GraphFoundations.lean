  let root : sourceLemma39CycleVertices G D := ⟨r, D.start_mem_support⟩
  let x : sourceLemma39CycleVertices G D := ⟨a, ha⟩
  let y : sourceLemma39CycleVertices G D := ⟨b, hb⟩
  let w : sourceLemma39CycleVertices G D := ⟨z, hz⟩
