  have memberR (i) : (net.rightVertex i).val ∈ I.support := by
    rw [hIs, List.mem_map]
    exact ⟨_, (hrget i) ▸ List.get_mem _ (rp i), rfl⟩
  have hIC : ∀ z, z ∈ I.support → z ∈ C.support := by
    intro z hz; rw [hIs, List.mem_map] at hz; obtain ⟨t, _, rfl⟩ := hz; exact t.property
  have hmemD : ∀ z, z ∈ I.support → z ∈ D.support := by
    intro z hz; exact (Walk.mem_support_append_iff _ _).mpr (Or.inl hz)
  have owner_ne (i : Fin (k^2 + 1)) : lo (sel i) ≠ ox ∧ lo (sel i) ≠ oy ∧
