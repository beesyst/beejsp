/-- The exact carrier intersection reduces a Q/rung collision to the edge uv. -/
theorem sourceLemma23_crossladder_q_edges_disjoint_rung_iff
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (L : SourceLemma39AmbientCrossladder G C k) (i : Fin k) :
    Disjoint L.q.edges.toFinset (L.rung i).edges.toFinset ↔
