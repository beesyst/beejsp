    (i j t : Fin n) (hij : i ≤ j) :
    ladder.secondVertex t ∉ (sourceLemma36RotatedPositionSubpath G C hC data.anchor
      (ladder.firstPosition i) (ladder.firstPosition j)).support := by
  intro hmem
  exact ladder.second_outside_canonical t
    (sourceLemma36Section2Ladder_first_rail_segment_canonical
      G C k Z data iP matching ladder i j hij (ladder.secondVertex t) hmem)

/-- The reversed second rail is an actual complementary cycle segment: from
`secondVertex j` to `secondVertex i` it stays outside the canonical piece. -/
private theorem sourceLemma36Section2Ladder_second_rail_segment_outside
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) {n : ℕ}
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching n)
    (i j : Fin n) (hij : i ≤ j) (x : V)
    (hx : x ∈ (sourceLemma36ComplementOrderAtSegment G C hC k Z data iP
      (ladder.secondPosition j) (ladder.secondPosition i)).support) :
    x ∉ sourceLemma36CanonicalPieceVertices G C hC k Z data iP := by
  apply sourceLemma36_complementOrderAt_segment_outside G C hC k Z data iP
    (ladder.secondPosition j) (ladder.secondPosition i) ?_ x hx
  by_cases h : i = j
  · simpa [h]
  · exact (ladder.second_arc_order i j (lt_of_le_of_ne hij h)).le

/-- Every intervening second-rail vertex occurs in the actual reversed
complementary segment prescribed by the printed Section-2 order. -/
private theorem sourceLemma36Section2Ladder_secondVertex_mem_second_rail_segment
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) {n : ℕ}
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching n)
    (i j t : Fin n) (hit : i ≤ t) (htj : t ≤ j) :
    ladder.secondVertex t ∈
      (sourceLemma36ComplementOrderAtSegment G C hC k Z data iP
        (ladder.secondPosition j) (ladder.secondPosition i)).support := by
  rw [← ladder.secondPosition_vertex t]
  apply sourceLemma36_complementOrderAt_segment_contains G C hC k Z data iP
    (ladder.secondPosition j) (ladder.secondPosition i) (ladder.secondPosition t)
  · by_cases h : t = j
    · simpa [h]
    · exact (ladder.second_arc_order t j (lt_of_le_of_ne htj h)).le
  · by_cases h : i = t
    · simpa [h]
    · exact (ladder.second_arc_order i t (lt_of_le_of_ne hit h)).le

/-- No first-rail endpoint occurs on a reversed second-rail segment. -/
private theorem sourceLemma36Section2Ladder_first_not_mem_second_rail_segment
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) {n : ℕ}
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching n)
    (i j t : Fin n) (hij : i ≤ j) :
    ladder.firstVertex t ∉
      (sourceLemma36ComplementOrderAtSegment G C hC k Z data iP
        (ladder.secondPosition j) (ladder.secondPosition i)).support := by
  intro hmem
  exact (sourceLemma36Section2Ladder_second_rail_segment_outside
    G C k Z data iP matching ladder i j hij (ladder.firstVertex t) hmem)
    (ladder.first_in_canonical t)

/-- The source Section-2 order is realized by two genuine, disjoint rail
segments of the base cycle: the forward first rail and the reverse second
rail.  Together with the strict coordinate orders in `ladder`, this is the
formal reading of `u₁,…,uₖ,vₖ,…,v₁` around the cycle. -/
private theorem sourceLemma36Section2Ladder_printed_order
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching k) :
    let last := sourceLemma36Section2LastIndex k hk
    (∀ t, ladder.firstVertex t ∈
      (sourceLemma36RotatedPositionSubpath G C hC data.anchor
        (ladder.firstPosition (sourceLemma36Section2FirstIndex k hk)) (ladder.firstPosition last)).support) ∧
    (∀ t, ladder.secondVertex t ∉
      (sourceLemma36RotatedPositionSubpath G C hC data.anchor
        (ladder.firstPosition (sourceLemma36Section2FirstIndex k hk)) (ladder.firstPosition last)).support) ∧
    (∀ t, ladder.secondVertex t ∈
      (sourceLemma36ComplementOrderAtSegment G C hC k Z data iP
        (ladder.secondPosition last) (ladder.secondPosition (sourceLemma36Section2FirstIndex k hk))).support) ∧
    (∀ t, ladder.firstVertex t ∉
      (sourceLemma36ComplementOrderAtSegment G C hC k Z data iP
        (ladder.secondPosition last) (ladder.secondPosition (sourceLemma36Section2FirstIndex k hk))).support) := by
  dsimp
  have hlast : ∀ t : Fin k, t ≤ sourceLemma36Section2LastIndex k hk := by
    intro t
    apply Fin.mk_le_mk.mpr
    dsimp [sourceLemma36Section2LastIndex]
    omega
  have hfirst : ∀ t : Fin k, sourceLemma36Section2FirstIndex k hk ≤ t := by
    intro t
    apply Fin.mk_le_mk.mpr
    exact Nat.zero_le _
  have hfirstlast : sourceLemma36Section2FirstIndex k hk ≤ sourceLemma36Section2LastIndex k hk :=
    hfirst _
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro t
    rw [← ladder.firstPosition_vertex t]
    apply sourceLemma36_position_mem_subpath G C hC data.anchor
      (ladder.firstPosition (sourceLemma36Section2FirstIndex k hk)) (ladder.firstPosition (sourceLemma36Section2LastIndex k hk))
      (ladder.firstPosition t)
    · by_cases h : t = sourceLemma36Section2FirstIndex k hk
      · simpa [h]
      · exact (ladder.first_arc_order _ _ (lt_of_le_of_ne (hfirst t) (Ne.symm h))).le
    · by_cases h : t = sourceLemma36Section2LastIndex k hk
      · simpa [h]
      · exact (ladder.first_arc_order t (sourceLemma36Section2LastIndex k hk)
          (lt_of_le_of_ne (hlast t) h)).le
  · intro t
    exact sourceLemma36Section2Ladder_second_not_mem_first_rail_segment G C k Z data iP
      matching ladder (sourceLemma36Section2FirstIndex k hk) (sourceLemma36Section2LastIndex k hk)
      t hfirstlast
  · intro t
    exact sourceLemma36Section2Ladder_secondVertex_mem_second_rail_segment
      G C k Z data iP matching ladder (sourceLemma36Section2FirstIndex k hk) (sourceLemma36Section2LastIndex k hk) t
      (hfirst t) (hlast t)
  · intro t
    exact sourceLemma36Section2Ladder_first_not_mem_second_rail_segment
      G C k Z data iP matching ladder (sourceLemma36Section2FirstIndex k hk) (sourceLemma36Section2LastIndex k hk) t
      hfirstlast

/-- The two exceptional boundary arcs in the printed Section-2 definition,
for a nonempty restricted ladder. -/
private noncomputable def sourceLemma36Section2FirstEndArc
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching k) (hk : 1 ≤ k) :
