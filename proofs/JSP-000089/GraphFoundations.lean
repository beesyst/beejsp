/-- Two contacts of the same outside component cannot be a physical cycle
edge. The contradiction uses an actual outside bridge and longest-cycle
maximality, rather than the length-alternative in the good-set certificate. -/
private theorem sourceLemma39_contacts_off_cycle [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hLongest : SourceLongestCycle G C)
    (A : (sourceLemma31OutsideGraph G C).ConnectedComponent) {x y : V}
    (hx : sourceLemma31ComponentAdjacent G C A x)
    (hy : sourceLemma31ComponentAdjacent G C A y) : s(x,y) ∉ C.edges := by
  intro he
  have hmap : C.edges = C.darts.map Dart.edge := rfl
  rw [hmap, List.mem_map] at he
  obtain ⟨d, hd, hde⟩ := he
  have hv := C.dart_fst_mem_support_of_mem_darts hd
  let R := C.rotate hv
  have hRnon := (hLongest.1.rotate hv).not_nil
  let e := R.firstDart hRnon
