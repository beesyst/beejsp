  fibre_adj_u : ∀ z ∈ fibre, (sourceLemma36OffCycleGraph G C).Adj z u
  fibre_adj_v : ∀ z ∈ fibre, (sourceLemma36OffCycleGraph G C).Adj z v

/-- In the small-matching branch, the winning common fibre is spanned by the
