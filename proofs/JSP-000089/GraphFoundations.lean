private theorem sourceLemma36_orderedZ_length [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V) (Z0 : Finset V)
    (hcard : Z0.card = k * sourceLemma36_partitionQuota k) :
