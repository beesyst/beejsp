      (ladder.firstVertex (sourceLemma36Section2FirstIndex k hk)) :=
  sourceOrientedCycleSubpath G C
    (by simpa only [ladder.cycle_def] using ladder.second_on_cycle _)
    (by simpa only [ladder.cycle_def] using ladder.first_on_cycle _)

private noncomputable def sourceLemma36Section2SecondEndArc
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
