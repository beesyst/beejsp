    let sel : Fin (k^2 + 1) → Fin (k^2 + 2) := fun i => ⟨i.val + 1, by omega⟩
    ∃ (I : G.Walk x.val y.val) (P : G.Walk x.val w.val) (R : G.Walk y.val w.val)
      (left : ∀ i : Fin (k^2 + 1), G.Walk (net.leftVertex (sel i)).val u.val)
      (right : ∀ i : Fin (k^2 + 1), G.Walk (net.rightVertex (sel i)).val v.val),
      let D := I.append (R.append P.reverse)
