/-- A fibre with at least two vertices has genuine extremal endpoints in the
canonical source order.  The positioned subpath between them contains the
entire fibre, not merely its two endpoints. -/
private theorem sourceLemma36_exists_extremalFiberSubpath
    [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (F : Finset V)
    (hFpiece : ∀ z ∈ F,
      z ∈ sourceLemma36CanonicalPieceVertices G C hC k Z data iP)
    (hFcard : 2 ≤ F.card) :
    ∃ x y : V,
      ∃ px py : Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length,
        px ∈ data.corePositions iP ∧ py ∈ data.corePositions iP ∧ px < py ∧
          (sourceLemma36RotatedCycleOrder G C data.anchor).get px = x ∧
          (sourceLemma36RotatedCycleOrder G C data.anchor).get py = y ∧
          x ∈ F ∧ y ∈ F ∧ x ≠ y ∧
          ∀ z ∈ F,
            z ∈ (sourceLemma36RotatedPositionSubpath G C hC data.anchor px py).support := by
  classical
  let position : {z // z ∈ F} →
      Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length := fun z =>
    (sourceLemma36_canonicalPiece_position G C hC k Z data iP
      (hFpiece z z.2)).choose
  have position_mem : ∀ z : {z // z ∈ F}, position z ∈ data.corePositions iP := by
    intro z
    exact (sourceLemma36_canonicalPiece_position G C hC k Z data iP
      (hFpiece z z.2)).choose_spec.1
  have position_get : ∀ z : {z // z ∈ F},
      (sourceLemma36RotatedCycleOrder G C data.anchor).get (position z) = z := by
    intro z
    exact (sourceLemma36_canonicalPiece_position G C hC k Z data iP
      (hFpiece z z.2)).choose_spec.2
  have position_injective : Set.InjOn position (↑F.attach : Set {z // z ∈ F}) := by
    intro a ha b hb hab
    apply Subtype.ext
    rw [← position_get a, hab, position_get b]
  let positions : Finset (Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length) :=
    F.attach.image position
  have hpositions_card : positions.card = F.card := by
    dsimp [positions]
    rw [Finset.card_image_of_injOn position_injective]
    simp
  have hpositions_nonempty : positions.Nonempty := by
    apply Finset.card_pos.mp
    rw [hpositions_card]
    omega
  let px := positions.min' hpositions_nonempty
  let py := positions.max' hpositions_nonempty
  have hpxmem : px ∈ positions := positions.min'_mem hpositions_nonempty
  have hpymem : py ∈ positions := positions.max'_mem hpositions_nonempty
  obtain ⟨x, hxattach, hxpos⟩ := Finset.mem_image.mp hpxmem
  obtain ⟨y, hyattach, hypos⟩ := Finset.mem_image.mp hpymem
  have hxF : x.1 ∈ F := x.2
  have hyF : y.1 ∈ F := y.2
  have hpxcore : px ∈ data.corePositions iP := by
    rw [← hxpos]
    exact position_mem x
  have hpycore : py ∈ data.corePositions iP := by
    rw [← hypos]
    exact position_mem y
  have hpxget : (sourceLemma36RotatedCycleOrder G C data.anchor).get px = x.1 := by
    rw [← hxpos]
    exact position_get x
  have hpyget : (sourceLemma36RotatedCycleOrder G C data.anchor).get py = y.1 := by
    rw [← hypos]
    exact position_get y
  have hpxpy : px < py := by
    apply lt_of_le_of_ne
    · exact positions.min'_le py hpymem
    · intro heq
      have hle : positions.card ≤ 1 := by
        apply Finset.card_le_one.mpr
        intro a ha b hb
        have haeq : a = px := by
          apply le_antisymm
          · simpa [heq] using positions.le_max' a ha
          · exact positions.min'_le a ha
        have hbeq : b = px := by
          apply le_antisymm
          · simpa [heq] using positions.le_max' b hb
          · exact positions.min'_le b hb
        exact haeq.trans hbeq.symm
      rw [hpositions_card] at hle
      omega
  have hxy : x.1 ≠ y.1 := by
    intro hxy
    apply ne_of_lt hpxpy
    apply List.nodup_iff_injective_get.mp
      (sourceLemma36_rotatedCycleOrder_nodup G C hC data.anchor)
    rw [hpxget, hpyget, hxy]
  refine ⟨x.1, y.1, px, py, hpxcore, hpycore, hpxpy, hpxget, hpyget,
    hxF, hyF, hxy, ?_⟩
  intro z hz
  let zF : {z // z ∈ F} := ⟨z, hz⟩
  have hzposition : position zF ∈ positions := by
    exact Finset.mem_image.mpr ⟨zF, Finset.mem_attach _ _, rfl⟩
  have hleft : px ≤ position zF := positions.min'_le _ hzposition
  have hright : position zF ≤ py := positions.le_max' _ hzposition
  change (zF : V) ∈ (sourceLemma36RotatedPositionSubpath G C hC data.anchor px py).support
  rw [← position_get zF]
  exact sourceLemma36_coreInterval_mem_positionSubpath G C hC data.anchor hpxpy.le hleft hright

/-- The small-matching winner together with the internally spanning `C′`
geometry needed for the next attachment-net step. -/
private structure SourceLemma36CommonFiberCPrimeGeometry [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (k : ℕ) (Z T : Finset V) (u w v x y : V) where
  triple : Finset V
