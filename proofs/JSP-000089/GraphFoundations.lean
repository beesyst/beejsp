        (sourceLemma35RetainedCycle G C hC)
        (sourceLemma35_retainedCycle_hamiltonian G C hC).isCycle
        (sourceLemma37CentralRungChord (sourceLemma35Graph G C hC)
          (sourceLemma35RetainedCycle G C hC) k hk Z data iP matching ladder i) (partner i)) ∧
      ((∃ i, sourceLemma37BlockCrossladder (sourceLemma35Graph G C hC)
