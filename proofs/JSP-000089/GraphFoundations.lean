private theorem sourceLemma39_residual_crossladder_rung_paths
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (shadow : SourceLemma39BranchIIShadowApplication G C k) (hk : 1 ≤ k)
    (Z : Finset (sourceLemma39CycleVertices G C))
    (data : SourceLemma36PartitionData shadow.graph shadow.cycle shadow.hamiltonian k Z)
    (iP : Fin k) (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt shadow.graph shadow.cycle shadow.hamiltonian k Z data iP))
    (ladder : SourceLemma36Section2Ladder shadow.graph shadow.cycle k Z data iP matching (4 * k^2))
    (sectionOwner : Fin (4 * k^2) → Fin (sourceLemma36_c k))
    (labelled : SourceLemma38LabelledCrossladder shadow.graph shadow.cycle
      (sourceLemma36_c k) k shadow.family hk Z data iP matching ladder sectionOwner)
    : ∃ paths : ∀ t : Fin k, G.Walk (ladder.firstVertex (labelled.select t)).val
        (ladder.secondVertex (labelled.select t)).val,
      (∀ t, (paths t).IsPath ∧
        internalVertices G (paths t) ⊆ sourceLemma39ComponentVertices G C
          (shadow.owner (shadow.selected (labelled.rungOwner t))) ∧
        Disjoint (internalVertices G (paths t)) {w | w ∈ C.support} ∧
        (paths t).length ≠ (sourceOrientedCycleSubpath G C
          (ladder.firstVertex (labelled.select t)).property
          (ladder.secondVertex (labelled.select t)).property).length) ∧
      (∀ i j, i ≠ j → Disjoint {z | z ∈ (paths i).support} {z | z ∈ (paths j).support}) := by
  classical
  have available (t : Fin k) := sourceLemma39_selected_pair_good_path G shadow
    (labelled.rungOwner t) (ladder.firstVertex (labelled.select t))
    (ladder.secondVertex (labelled.select t)) (labelled.rung_fst_owner t)
    (labelled.rung_snd_owner t)
    (sourceLemma36_adj_of_length_one shadow.graph (ladder.rung (labelled.select t))
      (ladder.rung_length_one (labelled.select t))).ne
  choose paths properties using available
  have hinternal : ∀ i j, i ≠ j → Disjoint (internalVertices G (paths i))
      (internalVertices G (paths j)) := by
    intro i j hij
    exact sourceLemma39_selected_replacements_internal_disjoint G shadow
      (fun h => hij (labelled.rungOwner_injective h)) (paths i) (paths j)
      (properties i).2.1 (properties j).2.1
  refine ⟨paths, properties, ?_⟩
  intro i j hij
  apply Set.disjoint_left.mpr
  intro z hzi hzj
  by_cases hzC : z ∈ C.support
  · let zC : sourceLemma39CycleVertices G C := ⟨z, hzC⟩
    have oldSupport (t : Fin k) (hzt : z ∈ (paths t).support) :
        zC ∈ (ladder.rung (labelled.select t)).support := by
      have hend : z = (ladder.firstVertex (labelled.select t)).val ∨
          z = (ladder.secondVertex (labelled.select t)).val := by
        by_contra h
        push_neg at h
        exact Set.disjoint_left.mp (properties t).2.2.1 ⟨hzt, h.1, h.2⟩ hzC
      rcases hend with hf | hs
      · have heq : zC = ladder.firstVertex (labelled.select t) := Subtype.ext hf
        rw [heq]
        exact (ladder.rung (labelled.select t)).start_mem_support
      · have heq : zC = ladder.secondVertex (labelled.select t) := Subtype.ext hs
        rw [heq]
        exact (ladder.rung (labelled.select t)).end_mem_support
    exact Set.disjoint_left.mp (ladder.rung_disjoint _ _
      (fun h => hij (labelled.select_strictMono.injective h)))
      (List.mem_toFinset.mpr (oldSupport i hzi)) (List.mem_toFinset.mpr (oldSupport j hzj))
  · have inside (t : Fin k) (hzt : z ∈ (paths t).support) : z ∈ internalVertices G (paths t) := by
      refine ⟨hzt, ?_, ?_⟩
      · exact fun h => hzC (h.symm ▸ (ladder.firstVertex (labelled.select t)).property)
      · exact fun h => hzC (h.symm ▸ (ladder.secondVertex (labelled.select t)).property)
    exact Set.disjoint_left.mp (hinternal i j hij) (inside i hzi) (inside j hzj)

