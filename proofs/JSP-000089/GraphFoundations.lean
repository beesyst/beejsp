/-- An off-cycle adjacency is precisely a graph edge whose physical edge is
not an edge of the Hamiltonian cycle. -/
private theorem sourceLemma36_offCycle_adj [Fintype V] [DecidableEq V]
    (C : G.Walk r r) {u v : V}
    (huv : (sourceLemma36OffCycleGraph G C).Adj u v) :
    G.Adj u v ∧ s(u, v) ∉ C.edges := by
  change (s(u, v) ∈ G.edgeSet ∧ s(u, v) ∉ C.edges) ∧ u ≠ v at huv
  exact ⟨G.mem_edgeSet.mp huv.1.1, huv.1.2⟩

/-- A one-edge walk contains its physical edge. -/
private theorem sourceLemma36_edge_mem_edges_of_length_one [DecidableEq V]
    {u v : V} (P : G.Walk u v) (hP : P.length = 1) : s(u, v) ∈ P.edges := by
  cases P with
  | nil => simp at hP
  | cons huv Q =>
    cases Q with
    | nil => simp
    | cons hvw R => simp [Walk.length_cons] at hP

/-- The proof-local Case-A specialization of Section 2's proper
`k`-truncation. Its attachment paths are explicitly one-edge chord paths;
the positional fields record cyclic endpoint order, and the final fields
record off-cycle, proper, and rootedness conditions. -/
private structure SourceLemma36ProperTruncation [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) where
  leftPosition : Fin k → Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length
  rightPosition : Fin k →
    Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length
  left_mem_core : ∀ i, leftPosition i ∈ data.corePositions i
  right_mem_core : ∀ i, rightPosition i ∈ data.corePositions i
  left_lt_right : ∀ i, leftPosition i < rightPosition i
  endpoints_distinct : ∀ i,
    (sourceLemma36RotatedCycleOrder G C data.anchor).get (leftPosition i) ≠
      (sourceLemma36RotatedCycleOrder G C data.anchor).get (rightPosition i)
  endpoint_order : ∀ {i j}, i < j → rightPosition i < leftPosition j
  attachment : ∀ i, G.Walk
    ((sourceLemma36RotatedCycleOrder G C data.anchor).get (leftPosition i))
    ((sourceLemma36RotatedCycleOrder G C data.anchor).get (rightPosition i))
  attachment_isPath : ∀ i, (attachment i).IsPath
  attachment_vertex_disjoint : ∀ {i j}, i ≠ j → ∀ v,
    v ∈ (attachment i).support → v ∈ (attachment j).support → False
  attachment_off_cycle : ∀ i, (sourceLemma36OffCycleGraph G C).Adj
    ((sourceLemma36RotatedCycleOrder G C data.anchor).get (leftPosition i))
    ((sourceLemma36RotatedCycleOrder G C data.anchor).get (rightPosition i))
