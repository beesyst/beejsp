/-- Erasing a minimal ear and restricting every surviving chord produces a
smaller family with the same physical-edge and noncrossing contracts. -/
private theorem sourceLemma34_reduced_family [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (D : Finset (SourceLemma34Chord G C)) (e0 : SourceLemma34Chord G C)
    (he0 : e0 ∈ D) (earDir : Bool)
    (hear : ∀ f ∈ D,
      ¬ sourceLemma34SideStrictInside G
          (sourceLemma34_orientedSide G C hC e0 earDir) f.fst ∧
        ¬ sourceLemma34SideStrictInside G
          (sourceLemma34_orientedSide G C hC e0 earDir) f.snd)
    (hinj : ∀ e ∈ D, ∀ f ∈ D, e.edge = f.edge → e = f)
    (hnoncross : ∀ e ∈ D, ∀ f ∈ D, e ≠ f → ¬ sourceLemma34Crosses G C hC e f) :
    ∃ D' : Finset (SourceLemma34Chord G
        (sourceLemma34_reducedCycle G C hC e0 earDir)),
      D'.card = D.card - 1 ∧
      (∀ e' ∈ D', ∀ f' ∈ D', e'.edge = f'.edge → e' = f') ∧
      (∀ e' ∈ D', ∀ f' ∈ D', e' ≠ f' →
        ¬ sourceLemma34Crosses G (sourceLemma34_reducedCycle G C hC e0 earDir)
          (sourceLemma34_reducedCycle_isCycle G C hC e0 earDir) e' f') := by
  classical
  let D0 := D.erase e0
  have hD0 : ∀ f ∈ D0, f ∈ D := by
    intro f hf
    exact (Finset.mem_erase.mp hf).2
  have hedge0 : ∀ f ∈ D0, f.edge ≠ e0.edge := by
    intro f hf hedge
    have hfe : f = e0 := hinj f (hD0 f hf) e0 he0 hedge
    exact (Finset.mem_erase.mp hf).1 hfe
  have hfst : ∀ f : {f // f ∈ D0},
      f.1.fst ∈ (sourceLemma34_reducedCycle G C hC e0 earDir).support := by
    intro f
    exact sourceLemma34_endpoint_survives_reduction G C hC e0 earDir f.1.fst f.1.fst_mem
      (hear f.1 (hD0 f.1 f.2)).1
  have hsnd : ∀ f : {f // f ∈ D0},
      f.1.snd ∈ (sourceLemma34_reducedCycle G C hC e0 earDir).support := by
    intro f
    exact sourceLemma34_endpoint_survives_reduction G C hC e0 earDir f.1.snd f.1.snd_mem
      (hear f.1 (hD0 f.1 f.2)).2
  let restrict : {f // f ∈ D0} →
      SourceLemma34Chord G (sourceLemma34_reducedCycle G C hC e0 earDir) := fun f =>
    sourceLemma34_restrictChord G C hC e0 earDir f.1 (hfst f) (hsnd f)
      (hedge0 f.1 f.2)
  have hrestrict_inj : Function.Injective restrict := by
    intro f g hfg
    apply Subtype.ext
    apply hinj f.1 (hD0 f.1 f.2) g.1 (hD0 g.1 g.2)
    have hedge := congrArg (fun x => x.edge) hfg
    simpa [restrict, sourceLemma34_restrictChord] using hedge
  let restrictEmbedding : {f // f ∈ D0} ↪
      SourceLemma34Chord G (sourceLemma34_reducedCycle G C hC e0 earDir) :=
    ⟨restrict, hrestrict_inj⟩
  let D' := D0.attach.map restrictEmbedding
  have hcard : D'.card = D.card - 1 := by
    dsimp [D']
    rw [Finset.card_map, Finset.card_attach, Finset.card_erase_of_mem he0]
  have hpreimage : ∀ f' ∈ D', ∃ f : {f // f ∈ D0},
      restrictEmbedding f = f' := by
    intro f' hf'
    change f' ∈ D0.attach.map restrictEmbedding at hf'
    rcases Finset.mem_map.1 hf' with ⟨f, _, hEq⟩
    exact ⟨f, hEq⟩
  refine ⟨D', hcard, ?_, ?_⟩
  · intro e' he' f' hf' hedge
    obtain ⟨e, he⟩ := hpreimage e' he'
    obtain ⟨f, hf⟩ := hpreimage f' hf'
    rw [← he, ← hf] at hedge ⊢
    apply congrArg restrictEmbedding
    apply Subtype.ext
    apply hinj e.1 (hD0 e.1 e.2) f.1 (hD0 f.1 f.2)
    simpa [restrictEmbedding, restrict, sourceLemma34_restrictChord] using hedge
  · intro e' he' f' hf' hne
    obtain ⟨e, he⟩ := hpreimage e' he'
    obtain ⟨f, hf⟩ := hpreimage f' hf'
    rw [← he, ← hf] at hne ⊢
    have hne0 : e.1 ≠ f.1 := by
      intro hEq
      exact hne (congrArg restrictEmbedding (Subtype.ext hEq))
    have horiginal := hnoncross e.1 (hD0 e.1 e.2) f.1 (hD0 f.1 f.2) hne0
    intro hcross
    apply horiginal
    simpa [restrictEmbedding, restrict] using
      (sourceLemma34_restricted_crossing_lifts G C hC e0 e.1 f.1 earDir
        (hfst e) (hsnd e) (hfst f) (hsnd f) (hedge0 e.1 e.2) (hedge0 f.1 f.2) hcross)
/-- Strong induction over ear reductions gives the noncrossing chord bound. -/
private theorem sourceLemma34_noncrossing_chord_bound_aux [Fintype V] [DecidableEq V]
    (g : ℕ) (hg3 : 3 ≤ g) (hgirth : g ≤ G.girth)
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (D : Finset (SourceLemma34Chord G C))
    (hinj : ∀ e ∈ D, ∀ f ∈ D, e.edge = f.edge → e = f)
    (hnoncross : ∀ e ∈ D, ∀ f ∈ D, e ≠ f → ¬ sourceLemma34Crosses G C hC e f) :
    D.card * (g - 2) + 1 ≤ C.length := by
  let P : ℕ → Prop := fun n => ∀ {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (D : Finset (SourceLemma34Chord G C)), D.card = n →
      (∀ e ∈ D, ∀ f ∈ D, e.edge = f.edge → e = f) →
      (∀ e ∈ D, ∀ f ∈ D, e ≠ f → ¬ sourceLemma34Crosses G C hC e f) →
      D.card * (g - 2) + 1 ≤ C.length
  have hP : ∀ n, P n := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro r C hC D hcard hinj hnoncross
      by_cases hD : D = ∅
      · subst D
        simp only [Finset.card_empty, zero_mul, zero_add]
        have hcycleLength := hC.three_le_length
        omega
      · have hDnonempty : D.Nonempty := Finset.nonempty_iff_ne_empty.mpr hD
        obtain ⟨e0, he0, earDir, hear⟩ :=
          sourceLemma34_exists_minimal_ear G C hC D hDnonempty hnoncross
        obtain ⟨D', hD'card, hinj', hnoncross'⟩ :=
          sourceLemma34_reduced_family G C hC D e0 he0 earDir hear hinj hnoncross
        let C' := sourceLemma34_reducedCycle G C hC e0 earDir
        have hC' : C'.IsCycle := sourceLemma34_reducedCycle_isCycle G C hC e0 earDir
        have hDcardPos : 0 < D.card := Finset.card_pos.mpr hDnonempty
        have hlt : D'.card < n := by
          rw [hD'card, hcard]
          omega
        have hIH := ih D'.card hlt C' hC' D' rfl hinj' hnoncross'
        let S0 := sourceLemma34_orientedSide G C hC e0 earDir
        have hspan : g - 2 ≤ S0.path.length - 1 := by
          dsimp [S0]
          exact sourceLemma34_side_span G C g hg3 hgirth e0
            (sourceLemma34_orientedSide G C hC e0 earDir)
        have hsideadd := sourceLemma34_oriented_sides_length_add G C hC e0 earDir
        have hsideadd' : S0.path.length +
            (sourceLemma34_orientedSide G C hC e0 (!earDir)).path.length = C.length := by
          simpa [S0] using hsideadd
        have hC'length := sourceLemma34_reducedCycle_length G C hC e0 earDir
        have hC'length' : C'.length =
            (sourceLemma34_orientedSide G C hC e0 (!earDir)).path.length + 1 := by
          simpa [C'] using hC'length
        have hlength : C.length = C'.length + (S0.path.length - 1) := by
          omega
        have hcardSucc : D.card = D'.card + 1 := by
          omega
        rw [hcardSucc, Nat.add_mul, one_mul]
        omega
  exact hP D.card C hC D rfl hinj hnoncross

/-- The strict form follows from the stronger addition-only induction invariant. -/
private theorem sourceLemma34_noncrossing_chord_bound [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsCycle)
    (g : ℕ) (hg3 : 3 ≤ g) (hgirth : g ≤ G.girth)
    (D : Finset (SourceLemma34Chord G C))
    (hinj : ∀ e ∈ D, ∀ f ∈ D, e.edge = f.edge → e = f)
    (hnoncross : ∀ e ∈ D, ∀ f ∈ D, e ≠ f → ¬ sourceLemma34Crosses G C hC e f) :
    D.card * (g - 2) < C.length := by
  have h := sourceLemma34_noncrossing_chord_bound_aux G g hg3 hgirth C hC D hinj hnoncross
  omega

/-- The girth-five instance consumed by source Lemma 3.5. -/
private theorem sourceLemma34_girth5_noncrossing_chord_bound [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (D : Finset (SourceLemma34Chord G C))
    (hinj : ∀ e ∈ D, ∀ f ∈ D, e.edge = f.edge → e = f)
    (hnoncross : ∀ e ∈ D, ∀ f ∈ D, e ≠ f → ¬ sourceLemma34Crosses G C hC e f) :
