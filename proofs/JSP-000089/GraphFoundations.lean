/-- The complete Branch-II conclusion. The direct net is represented by its
proved spectrum; the direct crossladder retains its constructed ambient cycle. -/
inductive SourceLemma39AmbientOrSpectrum [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) (k : ℕ) : Prop where
  | properTruncation : Nonempty (SourceLemma39AmbientProperTruncation G C k) →
      SourceLemma39AmbientOrSpectrum G C k
  | crossladder : Nonempty (SourceLemma39AmbientCrossladder G C k) →
      SourceLemma39AmbientOrSpectrum G C k
  | constructedCrossladder :
      (∃ (r' : V) (D : G.Walk r' r'), Nonempty (SourceLemma39AmbientCrossladder G D k)) →
      SourceLemma39AmbientOrSpectrum G C k
  | spectrum : (∃ A B : Finset ℕ, k ≤ A.card ∧ k ≤ B.card ∧
      (∀ a ∈ A, 0 < a) ∧ (∀ b ∈ B, 0 < b) ∧
      ∀ a ∈ A, ∀ b ∈ B, IsCycleLength G (a + b)) →
      SourceLemma39AmbientOrSpectrum G C k

/-- Consume all five constructors of the actual repaired shadow application,
using physical G-paths for the structural alternatives. -/
theorem sourceLemma39_branchII_ambient_or_spectrum_complete
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (hC : C.IsCycle) (shadow : SourceLemma39BranchIIShadowApplication G C k)
    (hk : 1 ≤ k) : SourceLemma39AmbientOrSpectrum G C k := by
  cases shadow.application with
  | directProperTruncation h =>
    obtain ⟨data, ⟨direct⟩⟩ := h
    exact .properTruncation (sourceLemma39_direct_truncation_ambient_complete G hC shadow data direct)
  | directKSquaredNet h =>
    obtain ⟨_, _, _, T, u, w, v, x, y, ⟨net⟩⟩ := h
    exact .spectrum (sourceLemma39_direct_net_cycle_spectrum_complete G shadow hk T u w v x y net)
  | directCrossladder h =>
    obtain ⟨data, iP, matching, ⟨direct⟩⟩ := h
    exact .constructedCrossladder
      (sourceLemma39_direct_crossladder_normalized_complete G shadow hk data iP matching direct)
  | residualLabelledCrossladder h =>
    obtain ⟨data, iP, matching, ladder, sectionOwner, ⟨labelled⟩⟩ := h
    exact .crossladder (sourceLemma39_residual_crossladder_ambient_complete
      G shadow hk _ data iP matching ladder sectionOwner labelled hC)
  | residualLabelledProperTruncation h =>
    obtain ⟨labelled⟩ := h
    exact .properTruncation (sourceLemma39_residual_truncation_ambient_complete G hC shadow labelled)

