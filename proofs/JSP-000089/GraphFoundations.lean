  have hlen : 3 ≤ D.length := hD.three_le_length
  refine ⟨{1}, {D.length - 1}, by simp, by simp, ?_, ?_, ?_⟩
  · intro a ha
    have heq : a = 1 := Finset.mem_singleton.mp ha
    omega
  · intro b hb
    have heq : b = D.length - 1 := Finset.mem_singleton.mp hb
    omega
  · intro a ha b hb
    have ha1 : a = 1 := Finset.mem_singleton.mp ha
    have hb1 : b = D.length - 1 := Finset.mem_singleton.mp hb
    exact ⟨x.val, D, hD, by omega⟩

/-- Two distinct attachments to the same off-cycle hub meet only at the hub. -/
theorem sourceLemma39_net_attachment_intersection
    {r a b h : V} (D : G.Walk r r) (A : G.Walk a h) (B : G.Walk b h)
    (ha : a ∈ D.support) (hb : b ∈ D.support) (hh : h ∉ D.support) (hab : a ≠ b)
    (hA : Disjoint (internalVertices G A) {z | z ∈ D.support})
    (hB : Disjoint (internalVertices G B) {z | z ∈ D.support})
    (hAB : Disjoint (internalVertices G A) (internalVertices G B)) :
    ∀ z, z ∈ A.support → z ∈ B.support → z = h := by
  intro z hzA hzB
  by_contra hzh
  by_cases hza : z = a
  · subst z
    exact Set.disjoint_left.mp hB ⟨hzB, hab, hzh⟩ ha
  by_cases hzb : z = b
  · subst z
    exact Set.disjoint_left.mp hA ⟨hzA, hza, hzh⟩ hb
  exact Set.disjoint_left.mp hAB ⟨hzA, hza, hzh⟩ ⟨hzB, hzb, hzh⟩

/-- Source Lemma 2.2, first route: rail prefix, interior attachment, reversed
terminal attachment. The route may contain its own rail vertices. -/
theorem sourceLemma39_net_route_prefix
    [DecidableEq V] {r a b c h : V}
    (D : G.Walk r r) (rail : G.Walk a b) (hc : c ∈ rail.support)
    (A : G.Walk c h) (B : G.Walk b h)
    (hrail : rail.IsPath) (hA : A.IsPath) (hB : B.IsPath)
    (hsub : ∀ z, z ∈ rail.support → z ∈ D.support)
    (hh : h ∉ D.support) (hca : c ≠ a) (hcb : c ≠ b)
    (houtA : Disjoint (internalVertices G A) {z | z ∈ D.support})
    (houtB : Disjoint (internalVertices G B) {z | z ∈ D.support})
    (hAB : Disjoint (internalVertices G A) (internalVertices G B)) :
    let route := (rail.takeUntil c hc).append (A.append B.reverse)
    route.IsPath ∧
    (∀ z, z ∈ route.support ↔
      z ∈ (rail.takeUntil c hc).support ∨ z ∈ A.support ∨ z ∈ B.support) ∧
    (∀ z, z ∈ route.support → z ∈ D.support → z ∈ rail.support) ∧
    route.length = (rail.takeUntil c hc).length + A.length + B.length ∧
    2 ≤ route.length := by
