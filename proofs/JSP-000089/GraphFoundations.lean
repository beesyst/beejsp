  exact S.edges_subset edge hedge

/-- A shortest oriented side in a noncrossing finite chord family is an ear:
no endpoint of another family chord lies in its strict interior. -/
private theorem sourceLemma34_minimal_oriented_side_is_ear [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (D : Finset (SourceLemma34Chord G C)) (e0 : SourceLemma34Chord G C)
    (he0 : e0 ∈ D) (dir0 : Bool)
    (hmin : ∀ e ∈ D, ∀ dir : Bool,
      (sourceLemma34_orientedSide G C hC e0 dir0).path.length ≤
        (sourceLemma34_orientedSide G C hC e dir).path.length)
    (hnoncross : ∀ e ∈ D, ∀ f ∈ D, e ≠ f → ¬ sourceLemma34Crosses G C hC e f) :
    ∀ f ∈ D,
      ¬ sourceLemma34SideStrictInside G
          (sourceLemma34_orientedSide G C hC e0 dir0) f.fst ∧
        ¬ sourceLemma34SideStrictInside G
          (sourceLemma34_orientedSide G C hC e0 dir0) f.snd := by
  let S0 := sourceLemma34_orientedSide G C hC e0 dir0
  have no_shorter : ∀ (f : SourceLemma34Chord G C), f ∈ D →
      ∀ T : SourceLemma34ChordSide G C f, T.path.length < S0.path.length → False := by
    intro f hf T hlt
    obtain ⟨dir, hdir⟩ := sourceLemma34_oriented_side_le_of_side G C hC f T
    exact (not_lt_of_ge (hmin f hf dir)) (lt_of_le_of_lt hdir hlt)
  intro f hf
  constructor
  · intro hfst
    by_cases hsnd : sourceLemma34SideStrictInside G S0 f.snd
    · rcases sourceLemma34_nested_chord_has_shorter_side G C hC e0 f S0 hfst hsnd with
        ⟨T, hT⟩ | ⟨T, hT⟩
      · exact no_shorter f hf T hT
      · let U := sourceLemma34_side_reverse G C f T
        have hU : U.path.length < S0.path.length := by
          change T.path.reverse.length < S0.path.length
          simpa using hT
        exact no_shorter f hf U hU
    · by_cases hmem : f.snd ∈ S0.path.support
      · have hboundary : f.snd = e0.fst ∨ f.snd = e0.snd := by
          by_cases hleft : f.snd = e0.fst
          · exact Or.inl hleft
          by_cases hright : f.snd = e0.snd
          · exact Or.inr hright
          exact (hsnd ⟨hmem, hleft, hright⟩).elim
        rcases sourceLemma34_boundary_inner_has_shorter_side G C e0 f S0 hfst hboundary with
          ⟨T, hT⟩ | ⟨T, hT⟩
        · exact no_shorter f hf T hT
        · let U := sourceLemma34_side_reverse G C f T
          have hU : U.path.length < S0.path.length := by
            change T.path.reverse.length < S0.path.length
            simpa using hT
          exact no_shorter f hf U hU
      · have hne : f ≠ e0 := by
          intro hEq
          subst f
          exact hfst.2.1 rfl
        apply hnoncross e0 he0 f hf hne.symm
        refine ⟨dir0, Or.inl ?_⟩
        simpa [S0] using And.intro hfst hmem
  · intro hsnd
    by_cases hfst : sourceLemma34SideStrictInside G S0 f.fst
    · rcases sourceLemma34_nested_chord_has_shorter_side G C hC e0 f S0 hfst hsnd with
        ⟨T, hT⟩ | ⟨T, hT⟩
      · exact no_shorter f hf T hT
      · let U := sourceLemma34_side_reverse G C f T
        have hU : U.path.length < S0.path.length := by
          change T.path.reverse.length < S0.path.length
          simpa using hT
        exact no_shorter f hf U hU
    · by_cases hmem : f.fst ∈ S0.path.support
      · have hboundary : (SourceLemma34Chord.symm G f).snd = e0.fst ∨
            (SourceLemma34Chord.symm G f).snd = e0.snd := by
          change f.fst = e0.fst ∨ f.fst = e0.snd
          by_cases hleft : f.fst = e0.fst
          · exact Or.inl hleft
          by_cases hright : f.fst = e0.snd
          · exact Or.inr hright
          exact (hfst ⟨hmem, hleft, hright⟩).elim
        rcases sourceLemma34_boundary_inner_has_shorter_side G C e0
          (SourceLemma34Chord.symm G f) S0 hsnd hboundary with ⟨T, hT⟩ | ⟨T, hT⟩
        · let U := sourceLemma34_side_reverse G C f T
          have hU : U.path.length < S0.path.length := by
            change T.path.reverse.length < S0.path.length
            simpa using hT
          exact no_shorter f hf U hU
        · let U := sourceLemma34_side_reverse G C f
            (sourceLemma34_side_reverse G C (SourceLemma34Chord.symm G f) T)
          have hU : U.path.length < S0.path.length := by
            change T.path.reverse.reverse.length < S0.path.length
            simpa using hT
          exact no_shorter f hf U hU
      · have hne : f ≠ e0 := by
          intro hEq
          subst f
          exact hsnd.2.2 rfl
        apply hnoncross e0 he0 f hf hne.symm
        refine ⟨dir0, Or.inr ?_⟩
        simpa [S0] using And.intro hsnd hmem

/-- A nonempty finite chord family has a shortest one of its two oriented sides. -/
private theorem sourceLemma34_exists_minimal_oriented_side [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (D : Finset (SourceLemma34Chord G C)) (hD : D.Nonempty) :
    ∃ e0 ∈ D, ∃ dir0 : Bool, ∀ e ∈ D, ∀ dir : Bool,
      (sourceLemma34_orientedSide G C hC e0 dir0).path.length ≤
        (sourceLemma34_orientedSide G C hC e dir).path.length := by
  classical
  let candidates := D.product (Finset.univ : Finset Bool)
  have hcandidates : candidates.Nonempty :=
    hD.product ⟨false, Finset.mem_univ _⟩
  obtain ⟨p, hp, hpmin⟩ := Finset.exists_min_image candidates
    (fun p => (sourceLemma34_orientedSide G C hC p.1 p.2).path.length) hcandidates
  rcases Finset.mem_product.mp hp with ⟨he0, _⟩
  refine ⟨p.1, he0, p.2, ?_⟩
  intro e he dir
  exact hpmin (e, dir) (Finset.mem_product.mpr ⟨he, Finset.mem_univ _⟩)

/-- Every nonempty pairwise noncrossing finite chord family has a minimal ear. -/
private theorem sourceLemma34_exists_minimal_ear [Fintype V] [DecidableEq V]
