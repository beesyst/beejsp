        rcases hend with hl | hr
        · have heq : vv = left t := Subtype.ext hl
          rw [heq]
          exact (direct.attachment t).start_mem_support
        · have heq : vv = right t := Subtype.ext hr
          rw [heq]
          exact (direct.attachment t).end_mem_support
