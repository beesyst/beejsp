  have hleft : ∀ i, order.get (leftPosition i) = (left i).val := fun i => getOrder _
  have hright : ∀ i, order.get (rightPosition i) = (right i).val := fun i => getOrder _
  have leftMem : ∀ i, order.get (leftPosition i) ∈ C.support := by
    intro i
