    have hnf : f.fst ≠ e.fst := by
      intro h; apply hcase.2; rw [h]; exact (sourceLemma34_orientedSide G C hC e dir).path.start_mem_support
    have hns : f.fst ≠ e.snd := by
      intro h; apply hcase.2; rw [h]; exact (sourceLemma34_orientedSide G C hC e dir).path.end_mem_support
    have hi : sourceLemma34SideStrictInside G (sourceLemma34_orientedSide G C hC e (!dir)) f.fst := ⟨hm, hnf, hns⟩
    have ho : f.snd ∉ (sourceLemma34_orientedSide G C hC e (!dir)).path.support := by
      intro hm'
      rcases sourceLemma34_orientedSide_support_intersection_dir G C hC e dir f.snd hcase.1.1 hm' with h | h
      · exact hcase.1.2.1 h
