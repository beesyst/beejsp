    {x y w a b : V} (P : G.Path x y) (hwx : G.Adj w x) (hwy : G.Adj w y)
        (hay : a ≠ y) (hby : b ≠ y) (haw : a ≠ w) (hbw : b ≠ w)
    (horder : (P : G.Walk x y).support.idxOf a < (P : G.Walk x y).support.idxOf b) :
