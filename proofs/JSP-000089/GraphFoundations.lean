    ⟨Finset.mem_powerset.mpr hQ.1, hQ⟩
  have hQcard : Q.card ∈ cards := Finset.mem_image.mpr ⟨Q, hQmatching, rfl⟩
  have hmax : Q.card ≤ m := cards.le_max' Q.card hQcard
  simpa [m] using hmax.trans_eq hPcard.symm

