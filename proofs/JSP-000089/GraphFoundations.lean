/-- Unequal natural path lengths give a positive increment and independent
short/long choices, without a global sign assumption. -/
theorem sourceLemma21_normalized_lengths (u v : ℕ) (hne : u ≠ v) :
    0 < max u v - min u v ∧
    ∀ long : Bool,
      (if (if long then decide (v < u) else decide (u < v)) then u else v) =
        min u v + (if long then max u v - min u v else 0) := by
  rcases lt_or_gt_of_ne hne with huv | hvu
  · have hvu : ¬ v < u := by omega
    simp only [Nat.max_eq_right huv.le, Nat.min_eq_left huv.le]
    refine ⟨by omega, ?_⟩
    intro long
    cases long with
    | false => simp [huv, hvu]
    | true => simp [huv, hvu]; omega
  · have huv : ¬ u < v := by omega
    simp only [Nat.max_eq_left hvu.le, Nat.min_eq_right hvu.le]
    refine ⟨by omega, ?_⟩
    intro long
    cases long with
    | false => simp [huv, hvu]
    | true => simp [huv, hvu]; omega

