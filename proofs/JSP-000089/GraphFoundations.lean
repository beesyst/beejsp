  Walk.cons hwy.symm (Walk.cons hwx P)

/-- Closing an internal source subpath through two distinct off-cycle edges is a real cycle. -/
private theorem sourceLemma36_cPrime_isCycle [Fintype V] [DecidableEq V]
    {r x y w : V} (C : G.Walk r r) (P : G.Path x y)
    (hPedges : ∀ e, e ∈ (P : G.Walk x y).edges → e ∈ C.edges)
    (hwP : w ∉ (P : G.Walk x y).support) (hxy : x ≠ y)
    (hwx : (sourceLemma36OffCycleGraph G C).Adj w x)
    (hwy : (sourceLemma36OffCycleGraph G C).Adj w y) :
    (sourceLemma36CPrime G P (sourceLemma36_offCycle_adj G C hwx).1
      (sourceLemma36_offCycle_adj G C hwy).1).IsCycle := by
  let awx : G.Adj w x := (sourceLemma36_offCycle_adj G C hwx).1
  let awy : G.Adj w y := (sourceLemma36_offCycle_adj G C hwy).1
  have hQpath : (Walk.cons awx (P : G.Walk x y)).IsPath := by
    rw [Walk.cons_isPath_iff]
    exact ⟨P.property, hwP⟩
  apply Path.cons_isCycle ⟨Walk.cons awx (P : G.Walk x y), hQpath⟩ awy.symm
  intro he
  change s(y, w) ∈ (Walk.cons awx (P : G.Walk x y)).edges at he
  simp only [Walk.edges_cons, List.mem_cons] at he
  rcases he with he | he
  · rw [Sym2.eq_iff] at he
    rcases he with ⟨hyw, _⟩ | ⟨hyx, _⟩
    · exact awy.ne hyw.symm
    · exact hxy hyx.symm
  · apply (sourceLemma36_offCycle_adj G C hwy).2
    rw [Sym2.eq_swap]
    exact hPedges _ he

/-- The added hub and both path endpoints occur on `C′`. -/
