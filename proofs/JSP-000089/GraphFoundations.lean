      (sourceLemma36_complementOrderAt_position_unique (p := pu) (q := pw)
        G C hC k Z data iP u hpu
        (hpw.trans h.symm))
  have hvw : v ≠ w := by
    intro h
    exact (ne_of_gt hpwv)
      (sourceLemma36_complementOrderAt_position_unique (p := pw) (q := pv)
        G C hC k Z data iP w hpw
        (hpv.trans h)).symm
  have huv : u ≠ v := by
    intro huv
    exact (ne_of_lt (hupw.trans hpwv))
