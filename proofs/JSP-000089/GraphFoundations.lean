/-- Replace the two artificial boundary spokes by distinct selected owners.
The retained inside path contains only original-cycle edges. -/
theorem sourceLemma39_direct_net_boundary_cycle
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (shadow : SourceLemma39BranchIIShadowApplication G C k)
    (T : Finset (sourceLemma39CycleVertices G C))
    (u w v x y : sourceLemma39CycleVertices G C)
    (net : SourceLemma36KSquaredNet shadow.graph shadow.cycle k
      (Finset.univ.image shadow.family.root) T u w v x y) :
    ∃ (ox oy : Fin (sourceLemma36_c k)) (I : G.Walk x.val y.val)
      (P : G.Walk x.val w.val) (R : G.Walk y.val w.val),
      let D := I.append (R.append P.reverse)
      shadow.family.root ox = x ∧ shadow.family.root oy = y ∧ ox ≠ oy ∧
      I.IsPath ∧ P.IsPath ∧ R.IsPath ∧
      I.support = net.blocks.common.geometry.x_y_path.val.support.map Subtype.val ∧
      internalVertices G P ⊆ sourceLemma39ComponentVertices G C (shadow.owner (shadow.selected ox)) ∧
      internalVertices G R ⊆ sourceLemma39ComponentVertices G C (shadow.owner (shadow.selected oy)) ∧
      Disjoint (internalVertices G P) {z | z ∈ C.support} ∧
      Disjoint (internalVertices G R) {z | z ∈ C.support} ∧
      (∀ z, z ∈ P.support → z ∈ R.support → z = w.val) ∧
      D.IsCycle ∧ u.val ∉ D.support ∧ v.val ∉ D.support := by
  classical
  let common := net.blocks.common
  let geom := common.geometry
  have hxoff : (sourceLemma36OffCycleGraph shadow.graph shadow.cycle).Adj x w := by
    change (s(x, w) ∈ shadow.graph.edgeSet ∧ s(x, w) ∉ shadow.cycle.edges) ∧ x ≠ w
    refine ⟨⟨shadow.graph.mem_edgeSet.mpr geom.hub_to_x.symm, ?_⟩, geom.hub_to_x.ne.symm⟩
    simpa only [Sym2.eq_swap] using geom.hub_to_x_off_cycle
  have hyoff : (sourceLemma36OffCycleGraph shadow.graph shadow.cycle).Adj y w := by
    change (s(y, w) ∈ shadow.graph.edgeSet ∧ s(y, w) ∉ shadow.cycle.edges) ∧ y ≠ w
    refine ⟨⟨shadow.graph.mem_edgeSet.mpr geom.hub_to_y.symm, ?_⟩, geom.hub_to_y.ne.symm⟩
    simpa only [Sym2.eq_swap] using geom.hub_to_y_off_cycle
  obtain ⟨ox, hox, hxx, hxw⟩ := sourceLemma39_rooted_pair_owner G shadow x w
    (common.fibre_subset_Z x common.x_mem_fibre) hxoff
  obtain ⟨oy, hoy, hyy, hyw⟩ := sourceLemma39_rooted_pair_owner G shadow y w
    (common.fibre_subset_Z y common.y_mem_fibre) hyoff
  have howners : ox ≠ oy := by
    intro h
    exact common.x_ne_y (hox.symm.trans ((congrArg shadow.family.root h).trans hoy))
  obtain ⟨P, hP, hPcomp, hPC, _⟩ := sourceLemma39_selected_pair_good_path G shadow ox x w hxx hxw geom.hub_to_x.ne.symm
  obtain ⟨R, hR, hRcomp, hRC, _⟩ := sourceLemma39_selected_pair_good_path G shadow oy y w hyy hyw geom.hub_to_y.ne.symm
  obtain ⟨I, hI, hIs, hIlen⟩ := sourceLemma39_transport_cycle_path G shadow geom.x_y_path.val
    geom.x_y_path.isPath geom.path_edges_subset_cycle
  have original_mem (z : sourceLemma39CycleVertices G C) (hz : z ∈ geom.x_y_path.val.support) : z ∈ geom.cPrime.support := by
    rw [geom.cPrime_def]
    change z ∈ (Walk.cons geom.hub_to_y.symm (Walk.cons geom.hub_to_x geom.x_y_path.val)).support
    simp only [Walk.support_cons, List.mem_cons]
    exact Or.inr (Or.inr hz)
  have hub_not_I (z : sourceLemma39CycleVertices G C) (hz : z ∉ geom.cPrime.support) : z.val ∉ I.support := by
    intro hm
    rw [hIs, List.mem_map] at hm
    obtain ⟨t, ht, heq⟩ := hm
    exact hz (Subtype.val_injective heq ▸ original_mem t ht)
  have hub_ne_w (z : sourceLemma39CycleVertices G C) (hz : z ∉ geom.cPrime.support) : z.val ≠ w.val := by
    intro heq
    exact hz (Subtype.val_injective heq ▸ geom.w_mem_cPrime)
  have hIC : ∀ z, z ∈ I.support → z ∈ C.support := by
    intro z hz; rw [hIs, List.mem_map] at hz; obtain ⟨t, _, rfl⟩ := hz; exact t.property
  have hPR : ∀ z, z ∈ P.support → z ∈ R.support → z = w.val := by
    intro z hzP hzR
    by_cases hzC : z ∈ C.support
    · have endP : z = x.val ∨ z = w.val := by
        by_contra he
        push_neg at he
        exact Set.disjoint_left.mp hPC ⟨hzP, he.1, he.2⟩ hzC
      have endR : z = y.val ∨ z = w.val := by
        by_contra he
        push_neg at he
        exact Set.disjoint_left.mp hRC ⟨hzR, he.1, he.2⟩ hzC
      rcases endP with hx | hw
      · rcases endR with hy | hw
        · exact (common.x_ne_y (Subtype.val_injective (hx.symm.trans hy))).elim
        · exact hw
      · exact hw
    · have hzPi : z ∈ internalVertices G P := ⟨hzP, fun h => hzC (h.symm ▸ x.property), fun h => hzC (h.symm ▸ w.property)⟩
      have hzRi : z ∈ internalVertices G R := ⟨hzR, fun h => hzC (h.symm ▸ y.property), fun h => hzC (h.symm ▸ w.property)⟩
      exact (Set.disjoint_left.mp (sourceLemma39_selected_replacements_internal_disjoint G shadow
        howners P R hPcomp hRcomp) hzPi hzRi).elim
  have hRP : (R.append P.reverse).IsPath := by
