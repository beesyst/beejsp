  have hsMiddle : s < ladder.secondPosition middle := by
    by_cases hEq : sourceLemma37BlockFirstIndex k i = middle
    · simpa only [hEq] using hbefore
    · exact hbefore.trans
        (ladder.second_arc_order
          (sourceLemma37BlockFirstIndex k i) middle
          (lt_of_le_of_ne hfirstMiddleLe hEq))
  have hxMiddle := sourceLemma37_complement_before_second_mem_forwardSide
    G C k Z data iP matching ladder middle central rfl rfl x hxOutside s hs hsMiddle.le
  obtain ⟨dir, hAt⟩ := hcross
  have hfalse := sourceLemma34_crossingAt_any_bool G C hC.isCycle central f dir false hAt
  intro t
  let j := sourceLemma37LeftBufferIndex k hk i t
  let rung := sourceLemma37ResidualRungChord G C k Z data iP matching ladder j
  have hjmem : j ∈ sourceLemma37BlockRungs k i := by
    simpa only [j] using (sourceLemma37_buffer_mem_block k hk i t).1

  have hjbounds :
      sourceLemma37BlockFirstIndex k i ≤ j ∧
        j ≤ sourceLemma37BlockLastIndex k i := by
    simpa only [sourceLemma37BlockRungs, Finset.mem_filter,
      Finset.mem_univ, true_and] using hjmem

  have hfirstj : sourceLemma37BlockFirstIndex k i ≤ j :=
    hjbounds.1
  have hsj : s < ladder.secondPosition j := by
    by_cases hj : j = sourceLemma37BlockFirstIndex k i
    · simpa only [hj] using hbefore
    · exact hbefore.trans (ladder.second_arc_order (sourceLemma37BlockFirstIndex k i) j
        (lt_of_le_of_ne hfirstj (Ne.symm hj)))
  have hxInside : sourceLemma34SideStrictInside G
      (sourceLemma34_orientedSide G C hC.isCycle rung false) x := by
    refine ⟨sourceLemma37_complement_before_second_mem_forwardSide
      G C k Z data iP matching ladder j rung rfl rfl x hxOutside s hs hsj.le, ?_, ?_⟩
    · intro h
      apply hxOutside
      simpa [h] using sourceLemma37_firstVertex_mem_canonicalPiece G C k Z data iP matching ladder j
    · intro h
      have hjget : (sourceLemma36ComplementOrderAt G C hC k Z data iP).get
          (ladder.secondPosition j) = x := by
        rw [ladder.secondPosition_vertex]
        exact (h.trans rfl).symm
      have hsj' : s = ladder.secondPosition j := List.nodup_iff_injective_get.mp
        (sourceLemma36_complementOrderAt_nodup G C hC k Z data iP) (hs.trans hjget.symm)
      exact (ne_of_gt hsj) hsj'.symm
  rcases hxEndpoint with hxfst | hxsnd
  · rcases hfalse with hin | hin
    · refine ⟨false, Or.inl ⟨by simpa [hxfst] using hxInside, ?_⟩⟩
      intro hm
      exact hin.2 (sourceLemma37_leftBuffer_forwardSide_subset_middle
        G C k hk Z data iP matching ladder i t central rung rfl rfl rfl rfl f.snd hm)
    · exact False.elim (hin.2 (by simpa [hxfst] using hxMiddle))
  · rcases hfalse with hin | hin
    · exact False.elim (hin.2 (by simpa [hxsnd] using hxMiddle))
    · refine ⟨false, Or.inr ⟨by simpa [hxsnd] using hxInside, ?_⟩⟩
      intro hm
      exact hin.2 (sourceLemma37_leftBuffer_forwardSide_subset_middle
        G C k hk Z data iP matching ladder i t central rung rfl rfl rfl rfl f.fst hm)

/-- The four concrete escape cases select an explicit buffer whose complete
`k`-family of residual rungs crosses the foreign chord. -/
private theorem sourceLemma37_outside_selects_crossed_buffer
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching)
    (i : Fin (2 * k - 1)) (f : SourceLemma34Chord G C)
    (hcross : sourceLemma34Crosses G C hC.isCycle
      (sourceLemma37CentralRungChord G C k hk Z data iP matching ladder i) f)
    (x : V) (hxEndpoint : x = f.fst ∨ x = f.snd)
    (hxOutside : x ∉ (sourceLemma37Qu G C k Z data iP matching ladder i).support ∧
      x ∉ (sourceLemma37Qv G C k Z data iP matching ladder i).support) :
    (∀ t : Fin k, sourceLemma34Crosses G C hC.isCycle
      (sourceLemma37ResidualRungChord G C k Z data iP matching ladder
        (sourceLemma37LeftBufferIndex k hk i t)) f) ∨
    (∀ t : Fin k, sourceLemma34Crosses G C hC.isCycle
      (sourceLemma37ResidualRungChord G C k Z data iP matching ladder
        (sourceLemma37RightBufferIndex k hk i t)) f) := by
  by_cases hxCanonical : x ∈ sourceLemma36CanonicalPieceVertices G C hC k Z data iP
  · obtain ⟨p, -, hp⟩ := sourceLemma36_canonicalPiece_position G C hC k Z data iP hxCanonical
    rcases sourceLemma37_not_mem_Qu_strict_position
      G C k hk Z data iP matching ladder i x p hp hxOutside.1 with hbefore | hafter
    · right
      exact sourceLemma37_Qu_before_rightBuffer_crosses
        G C k hk Z data iP matching ladder i f hcross x hxEndpoint hxCanonical p hp hbefore
    · left
