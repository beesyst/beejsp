    (k : ℕ) (Z : Finset V) (data : SourceLemma36PartitionData G C hC k Z)
    (hchord : ∀ i : Fin k, sourceLemma36PieceHasChord G C hC k Z data i) :
    SourceLemma36ProperTruncation G C hC k Z data := by
  classical
  change ∀ i : Fin k, ∃ z ∈ Z,
    z ∈ sourceLemma36CoreVertices G C hC k Z data i ∧
