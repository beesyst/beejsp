/-- The `k` rungs immediately before the central Lemma-3.8 rung. -/
private def sourceLemma38LeftBufferIndex (k : ℕ) (hk : 1 ≤ k) (i : Fin k)
    (t : Fin k) : Fin (4 * k^2) :=
  ⟨(4 * i.1 + 1) * k - 1 + t.1, by
    have hi : i.1 < k := i.2
    have ht : t.1 < k := t.2
    have hcoeff : 4 * i.1 + 2 < 4 * k := by omega
    have hproduct : (4 * i.1 + 2) * k < 4 * (k * k) :=
      by simpa [Nat.mul_assoc] using Nat.mul_lt_mul_of_pos_right hcoeff hk
    have hrewrite : (4 * i.1 + 1) * k - 1 + t.1 < (4 * i.1 + 2) * k := by
      have heq : (4 * i.1 + 2) * k = (4 * i.1 + 1) * k + k := by ring
      rw [heq]
      omega
    simp only [pow_two]
    exact hrewrite.trans hproduct⟩

/-- The `k` rungs immediately after the central Lemma-3.8 rung. -/
private def sourceLemma38RightBufferIndex (k : ℕ) (hk : 1 ≤ k) (i : Fin k)
    (t : Fin k) : Fin (4 * k^2) :=
  ⟨(4 * i.1 + 2) * k + t.1, by
    have hi : i.1 < k := i.2
    have ht : t.1 < k := t.2
    have hcoeff : 4 * i.1 + 3 < 4 * k := by omega
    have hproduct : (4 * i.1 + 3) * k < 4 * (k * k) :=
      by simpa [Nat.mul_assoc] using Nat.mul_lt_mul_of_pos_right hcoeff hk
    have hrewrite : (4 * i.1 + 2) * k + t.1 < (4 * i.1 + 3) * k := by
      have heq : (4 * i.1 + 3) * k = (4 * i.1 + 2) * k + k := by ring
      rw [heq]
      omega
    simp only [pow_two]
    exact hrewrite.trans hproduct⟩

/-- The two Lemma-3.8 buffers are in their own `4k` block and avoid the
central rung. -/
private theorem sourceLemma38_buffer_index_facts (k : ℕ) (hk : 1 ≤ k)
    (i : Fin k) (t : Fin k) :
    sourceLemma38BlockFirstIndex k hk i ≤ sourceLemma38LeftBufferIndex k hk i t ∧
      sourceLemma38LeftBufferIndex k hk i t ≤ sourceLemma38BlockLastIndex k hk i ∧
      sourceLemma38RightBufferIndex k hk i t ≤ sourceLemma38BlockLastIndex k hk i ∧
      sourceLemma38CentralRungIndex k hk i ≠ sourceLemma38LeftBufferIndex k hk i t ∧
      sourceLemma38CentralRungIndex k hk i ≠ sourceLemma38RightBufferIndex k hk i t := by
  have ht : t.1 < k := t.2
  constructor
  · apply Fin.mk_le_mk.mpr
    dsimp [sourceLemma38BlockFirstIndex, sourceLemma38LeftBufferIndex]
    have hrewrite : (4 * i.1 + 1) * k = 4 * i.1 * k + k := by ring
    rw [hrewrite]
    omega
  constructor
  · apply Fin.mk_le_mk.mpr
    dsimp [sourceLemma38LeftBufferIndex, sourceLemma38BlockLastIndex]
    have hi : i.1 < k := i.2
    have hleft : (4 * i.1 + 1) * k = 4 * i.1 * k + k := by ring
    have hlast : 4 * (i.1 + 1) * k = 4 * i.1 * k + 4 * k := by ring
    rw [hleft, hlast]
    omega
  constructor
  · apply Fin.mk_le_mk.mpr
    dsimp [sourceLemma38RightBufferIndex, sourceLemma38BlockLastIndex]
    have hi : i.1 < k := i.2
    have hright : (4 * i.1 + 2) * k = 4 * i.1 * k + 2 * k := by ring
    have hlast : 4 * (i.1 + 1) * k = 4 * i.1 * k + 4 * k := by ring
    rw [hright, hlast]
    omega
  constructor
  · intro h
    have hlt : sourceLemma38LeftBufferIndex k hk i t <
        sourceLemma38CentralRungIndex k hk i := by
      apply Fin.mk_lt_mk.mpr
      change (4 * i.1 + 1) * k - 1 + t.1 < (4 * i.1 + 2) * k - 1
      have hcentral : (4 * i.1 + 2) * k = (4 * i.1 + 1) * k + k := by ring
      rw [hcentral]
      have hpositive : 0 < (4 * i.1 + 1) * k := by nlinarith
      omega
    exact (ne_of_gt hlt) h
  · intro h
    have hlt : sourceLemma38CentralRungIndex k hk i <
        sourceLemma38RightBufferIndex k hk i t := by
      apply Fin.mk_lt_mk.mpr
      change (4 * i.1 + 2) * k - 1 < (4 * i.1 + 2) * k + t.1
      have hpositive : 0 < (4 * i.1 + 2) * k := by nlinarith
      omega
    exact (ne_of_lt hlt) h

private theorem sourceLemma38_leftBufferIndex_strictMono (k : ℕ) (hk : 1 ≤ k)
    (i : Fin k) : StrictMono (sourceLemma38LeftBufferIndex k hk i) := by
  intro s t hst
  apply Fin.mk_lt_mk.mpr
  dsimp [sourceLemma38LeftBufferIndex]
  omega

private theorem sourceLemma38_rightBufferIndex_strictMono (k : ℕ) (hk : 1 ≤ k)
    (i : Fin k) : StrictMono (sourceLemma38RightBufferIndex k hk i) := by
  intro s t hst
  apply Fin.mk_lt_mk.mpr
  dsimp [sourceLemma38RightBufferIndex]
  omega

