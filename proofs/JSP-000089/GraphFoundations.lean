private theorem sourceLemma39_splice_paths {a b c : V}
    (P : G.Walk a b) (Q : G.Walk b c) (hP : P.IsPath) (hQ : Q.IsPath)
    (hinter : ∀ z, z ∈ P.support → z ∈ Q.support → z = b) :
    (P.append Q).IsPath := by
  apply Walk.IsPath.mk'
  rw [Walk.support_append]
  apply List.Nodup.append hP.support_nodup hQ.support_nodup.tail
  rw [List.disjoint_left]
  intro z hzP hzQ
  have hzb := hinter z hzP (List.mem_of_mem_tail hzQ)
  subst z
  have hn := hQ.support_nodup
  rw [Q.support_eq_cons] at hn
  exact (List.nodup_cons.mp hn).1 hzQ

private theorem sourceLemma39_splice_cycle [DecidableEq V] {a b : V}
    (P : G.Walk a b) (Q : G.Walk b a) (hP : P.IsPath) (hQ : Q.IsPath)
    (hlen : 2 ≤ P.length)
    (hinter : ∀ z, z ∈ P.support → z ∈ Q.support → z = a ∨ z = b) :
    (P.append Q).IsCycle := by
  have hnon : ¬ P.Nil := by
    rw [Walk.nil_iff_length_eq]
    omega
  have hnotA : a ∉ P.tail.support := by
    rw [Walk.support_tail_of_not_nil P hnon]
    have hn := hP.support_nodup
    rw [P.support_eq_cons] at hn
    exact (List.nodup_cons.mp hn).1
  have hnotB : b ∉ Q.support.tail := by
    have hn := hQ.support_nodup
    rw [Q.support_eq_cons] at hn
    exact (List.nodup_cons.mp hn).1
  have htail : (P.tail.append Q).IsPath := by
    apply Walk.IsPath.mk'
    rw [Walk.support_append]
    apply List.Nodup.append hP.tail.support_nodup hQ.support_nodup.tail
    rw [List.disjoint_left]
    intro z hzP hzQ
    have hzP' : z ∈ P.support := by
      rw [Walk.support_tail_of_not_nil P hnon] at hzP
      exact List.mem_of_mem_tail hzP
    rcases hinter z hzP' (List.mem_of_mem_tail hzQ) with rfl | rfl
    · exact hnotA hzP
    · exact hnotB hzQ
  have hsnd_ne_b : P.snd ≠ b := by
    intro heq
    have ht := hP.tail
    have ht' : (P.tail.copy rfl heq.symm).IsPath := by
      rw [Walk.isPath_copy]
      exact ht
    have hn := (Walk.isPath_iff_eq_nil (P.tail.copy rfl heq.symm)).mp ht'
    have hz : P.tail.length = 0 := by
      simpa only [Walk.length_copy] using congrArg Walk.length hn
    have := P.length_tail_add_one hnon
    omega
  have hsnd_ne_a : P.snd ≠ a := by
    intro h
    exact hnotA (Eq.mp (congrArg (fun z => z ∈ P.tail.support) h) P.tail.start_mem_support)
  have hsnd_not_Q : P.snd ∉ Q.support := by
    intro hs
    have hm : P.snd ∈ P.support := by
      have ht := P.tail.start_mem_support
      rw [Walk.support_tail_of_not_nil P hnon] at ht
      exact List.mem_of_mem_tail ht
    rcases hinter _ hm hs with h | h
    · exact hsnd_ne_a h
    · exact hsnd_ne_b h
  have hfirst_not_tail : s(a, P.snd) ∉ P.tail.edges := by
    have ht := hP.isTrail
    rw [← P.cons_tail_eq hnon] at ht
    exact (Walk.cons_isTrail_iff _ _).mp ht |>.2
  have hfirst_not_Q : s(a, P.snd) ∉ Q.edges :=
    fun h => hsnd_not_Q (Q.snd_mem_support_of_mem_edges h)
  rw [← P.cons_tail_eq hnon, Walk.cons_append]
  apply (Walk.cons_isCycle_iff _ _).mpr
  refine ⟨htail, ?_⟩
  rw [Walk.edges_append, List.mem_append]
  exact fun h => h.elim hfirst_not_tail hfirst_not_Q

private theorem sourceLemma39_transport_cycle_path
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (shadow : SourceLemma39BranchIIShadowApplication G C k)
    {a b : sourceLemma39CycleVertices G C} (P : shadow.graph.Walk a b)
    (hP : P.IsPath) (hedges : ∀ e, e ∈ P.edges → e ∈ shadow.cycle.edges) :
    ∃ Q : G.Walk a.val b.val, Q.IsPath ∧ Q.support = P.support.map Subtype.val ∧
      Q.length = P.length := by
  let H := G.induce {v | v ∈ C.support}
  have hPH : ∀ e, e ∈ P.edges → e ∈ H.edgeSet := by
    intro e he
    apply (sourceLemma39InducedCycle G C).edges_subset_edgeSet
    rw [← shadow.cycle_edges]
    exact hedges e he
  let f : H →g G := ⟨Subtype.val, fun h => h⟩
  let Q := (P.transfer H hPH).map f
  refine ⟨Q, Walk.map_isPath_of_injective Subtype.val_injective (hP.transfer hPH), ?_, ?_⟩
  · simp only [Q, Walk.support_map, Walk.support_transfer]
    rfl
  · simp only [Q, Walk.length_map, Walk.length_transfer]


private theorem sourceLemma39_length_two_of_internal {a b z : V}
    (P : G.Walk a b) (hz : z ∈ P.support) (hza : z ≠ a) (hzb : z ≠ b) :
    2 ≤ P.length := by
  cases P with
  | nil => exact (hza (by simpa using hz)).elim
  | cons _ tail =>
    cases tail with
    | nil =>
      simp only [Walk.support_cons, Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at hz
      exact (hz.elim hza hzb).elim
    | cons _ _ => simp only [Walk.length_cons]; omega

private theorem sourceLemma39_boundary_splice_cycle [DecidableEq V]
    {r a b x y : V} (C : G.Walk r r)
    (I : G.Walk a b) (O : G.Walk x y)
    (P : G.Walk b x) (R : G.Walk a y)
    (hI : I.IsPath) (hO : O.IsPath) (hP : P.IsPath) (hR : R.IsPath)
    (hlen : 2 ≤ I.length)
    (hIC : ∀ z, z ∈ I.support → z ∈ C.support)
    (hOC : ∀ z, z ∈ O.support → z ∈ C.support)
    (hIO : Disjoint {z | z ∈ I.support} {z | z ∈ O.support})
    (hPC : Disjoint (internalVertices G P) {z | z ∈ C.support})
    (hRC : Disjoint (internalVertices G R) {z | z ∈ C.support})
    (hPR : Disjoint {z | z ∈ P.support} {z | z ∈ R.support}) :
    (I.append (P.append (O.append R.reverse))).IsCycle := by
  have pend (z : V) (hz : z ∈ P.support) (hzC : z ∈ C.support) : z = b ∨ z = x := by
    by_contra h
    push_neg at h
    exact Set.disjoint_left.mp hPC ⟨hz, h.1, h.2⟩ hzC
  have rend (z : V) (hz : z ∈ R.support) (hzC : z ∈ C.support) : z = a ∨ z = y := by
    by_contra h
    push_neg at h
    exact Set.disjoint_left.mp hRC ⟨hz, h.1, h.2⟩ hzC
  have hOR : (O.append R.reverse).IsPath := by
    apply sourceLemma39_splice_paths G O R.reverse hO hR.reverse
    intro z hzO hzR
    rw [Walk.support_reverse, List.mem_reverse] at hzR
    rcases rend z hzR (hOC z hzO) with rfl | heq
    · exact (Set.disjoint_left.mp hIO I.start_mem_support hzO).elim
    · exact heq
  have hS : (P.append (O.append R.reverse)).IsPath := by
    apply sourceLemma39_splice_paths G P (O.append R.reverse) hP hOR
    intro z hzP hz
    rw [Walk.mem_support_append_iff] at hz
    rcases hz with hzO | hzR
    · rcases pend z hzP (hOC z hzO) with rfl | heq
      · exact (Set.disjoint_left.mp hIO I.end_mem_support hzO).elim
      · exact heq
    · rw [Walk.support_reverse, List.mem_reverse] at hzR
      exact (Set.disjoint_left.mp hPR hzP hzR).elim
  apply sourceLemma39_splice_cycle G I (P.append (O.append R.reverse)) hI hS hlen
  intro z hzI hz
  rw [Walk.mem_support_append_iff, Walk.mem_support_append_iff] at hz
  rcases hz with hzP | hzO | hzR
  · rcases pend z hzP (hIC z hzI) with heq | rfl
    · exact Or.inr heq
    · exact (Set.disjoint_left.mp hIO hzI O.start_mem_support).elim
  · exact (Set.disjoint_left.mp hIO hzI hzO).elim
  · rw [Walk.support_reverse, List.mem_reverse] at hzR
    rcases rend z hzR (hIC z hzI) with heq | rfl
    · exact Or.inl heq
    · exact (Set.disjoint_left.mp hIO hzI O.end_mem_support).elim

