    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (shadow : SourceLemma39BranchIIShadowApplication G C k)
    (labelled : SourceLemma38LabelledProperTruncation shadow.graph shadow.cycle
      shadow.hamiltonian (sourceLemma36_c k) k shadow.family) :
    ∃ paths : ∀ t : Fin k,
        G.Walk (labelled.chord t).fst.val (labelled.chord t).snd.val,
      (∀ t, (paths t).IsPath ∧
        internalVertices G (paths t) ⊆ sourceLemma39ComponentVertices G C
          (shadow.owner (shadow.selected (labelled.owner t))) ∧
        Disjoint (internalVertices G (paths t)) {w | w ∈ C.support} ∧
        (paths t).length ≠ (sourceOrientedCycleSubpath G C
          (labelled.chord t).fst.property (labelled.chord t).snd.property).length) ∧
      (∀ t u, t ≠ u → Disjoint {z | z ∈ (paths t).support} {z | z ∈ (paths u).support}) := by
  exact sourceLemma39_residual_truncation_proper_paths_of_good_path G shadow
    (fun i => shadow.good_path (shadow.selected i)) labelled


/-- In a simple path, the edge between its endpoints occurs only for a one-edge path. -/
theorem sourceLemma21_path_endpoint_edge_length_one {a b : V} (P : G.Walk a b)
    (hP : P.IsPath) (he : s(a,b) ∈ P.edges) : P.length = 1 := by
  cases P with
  | nil => simp at he
  | @cons a x b h Q =>
    have hQ := (Walk.cons_isPath_iff h Q).mp hP
    simp only [Walk.edges_cons, List.mem_cons] at he
    rcases he with he | he
    · have hxb : x = b := by
        rcases Sym2.eq_iff.mp he with he | he
        · exact he.2.symm
        · exact (h.ne he.1).elim
      subst x
      have hnil := (Walk.isPath_iff_eq_nil Q).mp hQ.1
      subst Q
      rfl
    · exact False.elim (hQ.2 (Q.fst_mem_support_of_mem_edges he))

/-- A common edge has both endpoints on the boundary; interior exclusion then
forces it to be the edge between the path endpoints. -/
theorem sourceLemma21_common_edge_eq_endpoint_edge [DecidableEq V]
    {r a b : V} (C : G.Walk r r) (P : G.Walk a b)
    (hout : Disjoint (internalVertices G P) {v | v ∈ C.support})
    {e : Sym2 V} (heP : e ∈ P.edges) (heC : e ∈ C.edges) : e = s(a,b) := by
  induction e using Sym2.inductionOn with
  | hf x y =>
    have hxP := P.fst_mem_support_of_mem_edges heP
    have hyP := P.snd_mem_support_of_mem_edges heP
    have hxC := C.fst_mem_support_of_mem_edges heC
    have hyC := C.snd_mem_support_of_mem_edges heC
    have endpoints (z : V) (hzP : z ∈ P.support) (hzC : z ∈ C.support) : z = a ∨ z = b := by
      by_contra hn
      push_neg at hn
      exact Set.disjoint_left.mp hout ⟨hzP, hn.1, hn.2⟩ hzC
    have hxy := (P.adj_of_mem_edges heP).ne
    rcases endpoints x hxP hxC with rfl | rfl <;>
      rcases endpoints y hyP hyC with rfl | rfl
    · exact (hxy rfl).elim
    · rfl
    · exact Sym2.eq_swap
    · exact (hxy rfl).elim

/-- Interior exclusion plus a non-boundary endpoint edge implies full edge
exclusion, including genuine one-edge chords. -/
theorem sourceLemma21_path_edges_disjoint_cycle [DecidableEq V]
    {r a b : V} (C : G.Walk r r) (P : G.Walk a b)
    (hP : P.IsPath)
    (hout : Disjoint (internalVertices G P) {v | v ∈ C.support})
    (hoff : s(a,b) ∉ C.edges) : Disjoint P.edges.toFinset C.edges.toFinset := by
  apply Finset.disjoint_left.mpr
  intro e heP heC
  have hp := List.mem_toFinset.mp heP
  have hc := List.mem_toFinset.mp heC
  have heq := sourceLemma21_common_edge_eq_endpoint_edge G C P hout hp hc
  by_cases hlength : P.length = 1
  · exact hoff (heq ▸ hc)
  · have hend : s(a,b) ∈ P.edges := heq ▸ hp
    exact hlength (sourceLemma21_path_endpoint_edge_length_one G P hP hend)

/-- Original-cycle endpoint edges transport to the selected shadow cycle. -/
theorem sourceLemma39_original_edge_mem_shadow_cycle_iff
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (shadow : SourceLemma39BranchIIShadowApplication G C k)
    (a b : sourceLemma39CycleVertices G C) :
    s(a.val,b.val) ∈ C.edges ↔ s(a,b) ∈ shadow.cycle.edges := by
  have heq : C.edges = (sourceLemma39InducedCycle G C).edges.map (Sym2.map Subtype.val) := by
    have hmap := congrArg Walk.edges (sourceLemma39_inducedCycle_map G C)
    simpa only [Walk.edges_map] using hmap.symm
  rw [heq, shadow.cycle_edges, List.mem_map]
  constructor
  · rintro ⟨e, he, heq⟩
    have he' : e = s(a,b) := by
      exact Sym2.map.injective Subtype.val_injective heq
    exact he' ▸ he
  · intro he
    exact ⟨s(a,b), he, rfl⟩

/-- A genuine proper truncation in the original graph. Its common anchor and
ordered endpoints lie on the original directed cycle; its attachments are
simple, vertex-disjoint ambient paths with interiors outside that cycle and
no physical edge in common with it; genuine one-edge chords are allowed. -/
structure SourceLemma39AmbientProperTruncation [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) (k : ℕ) where
  isCycle : C.IsCycle
  anchor : V
  anchor_mem : anchor ∈ C.support
  leftPosition : Fin k → Fin (sourceLemma36RotatedCycleOrder G C anchor).length
  rightPosition : Fin k → Fin (sourceLemma36RotatedCycleOrder G C anchor).length
  left_lt_right : ∀ i, leftPosition i < rightPosition i
  endpoint_order : ∀ {i j}, i < j → rightPosition i < leftPosition j
  left_mem : ∀ i,
    (sourceLemma36RotatedCycleOrder G C anchor).get (leftPosition i) ∈ C.support
  right_mem : ∀ i,
    (sourceLemma36RotatedCycleOrder G C anchor).get (rightPosition i) ∈ C.support
  attachment : ∀ i, G.Walk
    ((sourceLemma36RotatedCycleOrder G C anchor).get (leftPosition i))
    ((sourceLemma36RotatedCycleOrder G C anchor).get (rightPosition i))
  attachment_isPath : ∀ i, (attachment i).IsPath
  attachment_vertex_disjoint : ∀ {i j}, i ≠ j → ∀ v,
    v ∈ (attachment i).support → v ∈ (attachment j).support → False
  attachment_internal_disjoint_cycle : ∀ i,
    Disjoint (internalVertices G (attachment i)) {v | v ∈ C.support}
  attachment_edges_disjoint_cycle : ∀ i,
    Disjoint (attachment i).edges.toFinset C.edges.toFinset
  proper : ∀ i, (attachment i).length ≠
    (sourceOrientedCycleSubpath G C (left_mem i) (right_mem i)).length

/-- Replacing displayed endpoints by equal vertices preserves the original
oriented cycle-subpath length, independently of membership proof choices. -/
private theorem sourceLemma39_oriented_length_eq_of_endpoints [DecidableEq V]
    {r a b a' b' : V} (C : G.Walk r r)
    (ha : a ∈ C.support) (hb : b ∈ C.support)
    (ha' : a' ∈ C.support) (hb' : b' ∈ C.support)
    (ea : a = a') (eb : b = b') :
    (sourceOrientedCycleSubpath G C ha hb).length =
      (sourceOrientedCycleSubpath G C ha' hb').length := by
  subst a'
  subst b'
  rfl

/-- The genuine residual labelled truncation lifts to the original graph,
using the same anchor, endpoint positions, and component-labelled endpoints.
Only the original cycle itself, rather than the ambient graph, is required
as a cycle; no Hamiltonian hypothesis on G is used. -/
theorem sourceLemma39_residual_truncation_ambient_complete
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (hC : C.IsCycle) (shadow : SourceLemma39BranchIIShadowApplication G C k)
    (labelled : SourceLemma38LabelledProperTruncation shadow.graph shadow.cycle
      shadow.hamiltonian (sourceLemma36_c k) k shadow.family) :
    Nonempty (SourceLemma39AmbientProperTruncation G C k) := by
  classical
  obtain ⟨paths, properties, hdisjoint⟩ :=
    sourceLemma39_residual_truncation_proper_paths_complete G shadow labelled
  let oldOrder := sourceLemma36RotatedCycleOrder shadow.graph shadow.cycle
    labelled.truncation.anchor
  let order := sourceLemma36RotatedCycleOrder G C labelled.truncation.anchor.val
  have horder : oldOrder.map Subtype.val = order :=
    shadow.cycle_order labelled.truncation.anchor
  have hlen : oldOrder.length = order.length := by
    rw [← horder, List.length_map]
  let leftPosition : Fin k → Fin order.length :=
    fun i => Fin.cast hlen (labelled.truncation.leftPosition i)
  let rightPosition : Fin k → Fin order.length :=
    fun i => Fin.cast hlen (labelled.truncation.rightPosition i)
  have getOrder (p : Fin oldOrder.length) :
      order.get (Fin.cast hlen p) = (oldOrder.get p).val := by
    simp only [List.get_eq_getElem]
    change order[p.val] = (oldOrder[p.val]).val
    simp only [← horder, List.getElem_map]
  have hleft : ∀ i, order.get (leftPosition i) = (labelled.chord i).fst.val := by
    intro i
    exact (getOrder _).trans (congrArg Subtype.val (labelled.chord_left_endpoint i))
  have hright : ∀ i, order.get (rightPosition i) = (labelled.chord i).snd.val := by
    intro i
    exact (getOrder _).trans (congrArg Subtype.val (labelled.chord_right_endpoint i))
  have leftMem : ∀ i, order.get (leftPosition i) ∈ C.support := by
    intro i
    rw [hleft]
    exact (labelled.chord i).fst.property
  have rightMem : ∀ i, order.get (rightPosition i) ∈ C.support := by
    intro i
    rw [hright]
    exact (labelled.chord i).snd.property
  have pathEdges (i : Fin k) : Disjoint (paths i).edges.toFinset C.edges.toFinset := by
    apply sourceLemma21_path_edges_disjoint_cycle G C (paths i)
      (properties i).1 (properties i).2.2.1
    intro he
    exact (labelled.chord i).not_cycle_edge
      ((sourceLemma39_original_edge_mem_shadow_cycle_iff G shadow
        (labelled.chord i).fst (labelled.chord i).snd).mp he)
  let attachment := fun i => (paths i).copy (hleft i).symm (hright i).symm
  refine ⟨{
    isCycle := hC
    anchor := labelled.truncation.anchor.val
    anchor_mem := labelled.truncation.anchor.property
    leftPosition := leftPosition
    rightPosition := rightPosition
    left_lt_right := ?_
    endpoint_order := ?_
    left_mem := leftMem
    right_mem := rightMem
    attachment := attachment
    attachment_isPath := ?_
    attachment_vertex_disjoint := ?_
    attachment_internal_disjoint_cycle := ?_
    attachment_edges_disjoint_cycle := fun i => by
      simpa only [attachment, Walk.edges_copy] using pathEdges i
    proper := ?_ }⟩
  · intro i
    exact labelled.truncation.left_lt_right i
  · intro i j hij
    exact labelled.truncation.endpoint_order hij
  · intro i
    simpa only [attachment, Walk.isPath_copy] using (properties i).1
  · intro i j hij v hvi hvj
    exact Set.disjoint_left.mp (hdisjoint i j hij)
      (by simpa only [attachment, Walk.support_copy] using hvi)
      (by simpa only [attachment, Walk.support_copy] using hvj)
  · intro i
    have hproperOutside := (properties i).2.2.1
    apply Set.disjoint_left.mpr
    intro v hv hvC
    apply Set.disjoint_left.mp hproperOutside ?_ hvC
    refine ⟨?_, ?_, ?_⟩
    · simpa only [attachment, Walk.support_copy] using hv.1
    · exact fun h => hv.2.1 (h.trans (hleft i).symm)
    · exact fun h => hv.2.2 (h.trans (hright i).symm)
  · intro i
    have hp := (properties i).2.2.2
    dsimp only [attachment]
    rw [Walk.length_copy]
    rw [sourceLemma39_oriented_length_eq_of_endpoints G C (leftMem i) (rightMem i)
      (labelled.chord i).fst.property (labelled.chord i).snd.property (hleft i) (hright i)]
    exact hp


/-- Direct truncation edges have unique selected K4 owners. Root independence
identifies the K4 containing each rooted off-cycle edge; vertex-disjointness
then makes the selected owner indices injective. -/
private theorem sourceLemma39_direct_truncation_owners
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (shadow : SourceLemma39BranchIIShadowApplication G C k)
    (data : SourceLemma36PartitionData shadow.graph shadow.cycle shadow.hamiltonian k
      (Finset.univ.image (SourceLemma38RootedK4Family.root shadow.family)))
    (direct : SourceLemma36ProperTruncation shadow.graph shadow.cycle shadow.hamiltonian k
      (Finset.univ.image (SourceLemma38RootedK4Family.root shadow.family)) data) :
    ∃ owner : Fin k → Fin (sourceLemma36_c k), Function.Injective owner ∧
      ∀ t, let l := (sourceLemma36RotatedCycleOrder shadow.graph shadow.cycle data.anchor).get (direct.leftPosition t);
        let v := (sourceLemma36RotatedCycleOrder shadow.graph shadow.cycle data.anchor).get (direct.rightPosition t);
        l ∈ shadow.family.vertices (owner t) ∧ v ∈ shadow.family.vertices (owner t) ∧
        (shadow.family.root (owner t) = l ∨ shadow.family.root (owner t) = v) ∧
        ∀ j, l ∈ shadow.family.vertices j → v ∈ shadow.family.vertices j → j = owner t := by
  classical
  let l := fun t => (sourceLemma36RotatedCycleOrder shadow.graph shadow.cycle data.anchor).get
    (direct.leftPosition t)
  let v := fun t => (sourceLemma36RotatedCycleOrder shadow.graph shadow.cycle data.anchor).get
    (direct.rightPosition t)
  have owned (t : Fin k) : ∃ j : Fin (sourceLemma36_c k),
      l t ∈ shadow.family.vertices j ∧ v t ∈ shadow.family.vertices j ∧
      (shadow.family.root j = l t ∨ shadow.family.root j = v t) := by
    rcases direct.rooted t with hl | hv
    · obtain ⟨j, hj⟩ := sourceLemma38_root_index_of_mem shadow.graph shadow.cycle
        (sourceLemma36_c k) shadow.family hl
      change shadow.family.root j = l t at hj
      have hedge : (sourceLemma36OffCycleGraph shadow.graph shadow.cycle).Adj
          (shadow.family.root j) (v t) := hj.symm ▸ direct.attachment_off_cycle t
      refine ⟨j, hj ▸ shadow.family.root_mem j,
        sourceLemma38_offCycleAdj_root_has_owner shadow.graph shadow.cycle
          (sourceLemma36_c k) shadow.family j hedge, Or.inl hj⟩
    · obtain ⟨j, hj⟩ := sourceLemma38_root_index_of_mem shadow.graph shadow.cycle
        (sourceLemma36_c k) shadow.family hv
      change shadow.family.root j = v t at hj
      have hedge : (sourceLemma36OffCycleGraph shadow.graph shadow.cycle).Adj
          (shadow.family.root j) (l t) := hj.symm ▸ (direct.attachment_off_cycle t).symm
      refine ⟨j, sourceLemma38_offCycleAdj_root_has_owner shadow.graph shadow.cycle
          (sourceLemma36_c k) shadow.family j hedge,
        hj ▸ shadow.family.root_mem j, Or.inr hj⟩
  choose owner hleft hright hroot using owned
  have rootSupport (t : Fin k) : shadow.family.root (owner t) ∈ (direct.attachment t).support := by
    rcases hroot t with hl | hv
    · rw [hl]; exact (direct.attachment t).start_mem_support
    · rw [hv]; exact (direct.attachment t).end_mem_support
  have hinj : Function.Injective owner := by
    intro i j hij
    exact Classical.byContradiction (fun hne => direct.attachment_vertex_disjoint hne
      (shadow.family.root (owner i)) (rootSupport i) (by simpa [hij] using rootSupport j))
  refine ⟨owner, hinj, ?_⟩
  intro t
  refine ⟨hleft t, hright t, hroot t, ?_⟩
  intro j hlj hvj
  have hrootj : shadow.family.root (owner t) ∈ shadow.family.vertices j := by
    rcases hroot t with hl | hv
    · exact hl.symm ▸ hlj
    · exact hv.symm ▸ hvj
  by_cases heq : shadow.family.root (owner t) = shadow.family.root j
  · exact (shadow.family.root_injective heq).symm
  have hadj := shadow.family.complete j hrootj (shadow.family.root_mem j) heq
  have hoff := shadow.family.off_cycle j hrootj (shadow.family.root_mem j) heq
  have hrootAdj : (sourceLemma36OffCycleGraph shadow.graph shadow.cycle).Adj
      (shadow.family.root (owner t)) (shadow.family.root j) := by
    exact ⟨⟨shadow.graph.mem_edgeSet.mpr hadj, hoff⟩, heq⟩
  have hmem (a : Fin (sourceLemma36_c k)) : shadow.family.root a ∈
      Finset.univ.image (SourceLemma38RootedK4Family.root shadow.family) :=
    Finset.mem_image.mpr ⟨a, Finset.mem_univ _, rfl⟩
  exact (shadow.family.roots_independent (hmem _) (hmem _) heq hrootAdj).elim

/-- The direct proper-truncation outcome lifts independently to actual
ambient paths. Its independent rooted K4 owners are recovered before applying
