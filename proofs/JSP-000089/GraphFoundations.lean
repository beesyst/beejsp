/-- The source net's actual C′ boundary, rotated to start at x, and its
physical one-edge attachments give the positive Section-2 spectrum. -/
private theorem sourceLemma25_net_cycle_spectrum
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ} {Z T : Finset V}
    {u w v x y : V} (hk : 1 ≤ k)
    (net : SourceLemma36KSquaredNet G C k Z T u w v x y) :
    ∃ A B : Finset ℕ, k ≤ A.card ∧ k ≤ B.card ∧
      (∀ a ∈ A, 0 < a) ∧ (∀ b ∈ B, 0 < b) ∧
      ∀ a ∈ A, ∀ b ∈ B, IsCycleLength G (a + b) := by
  classical
  let geometry := net.blocks.common.geometry
  let I := geometry.x_y_path.val
  let S : G.Walk y x := Walk.cons geometry.hub_to_y.symm
    (Walk.cons geometry.hub_to_x Walk.nil)
  let D := I.append S
  have firstDrop (P : G.Walk x y) (hx : x ∈ P.support) : P.dropUntil x hx = P := by
    cases P <;> simp [Walk.dropUntil]
  have hrot : geometry.cPrime.rotate geometry.x_mem_cPrime = D := by
    simp only [Walk.rotate, geometry.cPrime_def, sourceLemma36CPrime]
    simp [Walk.takeUntil, Walk.dropUntil,
      net.blocks.common.x_ne_y.symm, geometry.hub_to_x.ne, firstDrop, I, S, D]
  have hD : D.IsCycle := hrot ▸ geometry.cPrime_isCycle.rotate geometry.x_mem_cPrime
  have hubOut (z : V) (hz : z ∉ geometry.cPrime.support) : z ∉ D.support := by
    intro hm
    apply hz
    rw [← hrot] at hm
    rw [Walk.rotate, Walk.mem_support_append_iff] at hm
    exact hm.elim (fun h => geometry.cPrime.support_dropUntil_subset geometry.x_mem_cPrime h)
      (fun h => geometry.cPrime.support_takeUntil_subset geometry.x_mem_cPrime h)
  have hu : u ∉ D.support := hubOut u net.hub_u_not_mem_cycle
  have hv : v ∉ D.support := hubOut v net.hub_v_not_mem_cycle
  by_cases hk2 : 2 ≤ k
  · have hsize : k^2 - 1 + 2 = k^2 + 1 := by
      have hpow : 1 ≤ k^2 := by nlinarith
      omega
    obtain ⟨lp, rp, hlp, hrp, hlget, hrget, hlr, exclusions⟩ :=
      sourceLemma25_net_ordered_selection G net
    let sel : Fin (k^2 + 1) → Fin (k^2 + 2) := fun i => ⟨i.val + 1, by omega⟩
    let f : Fin (k^2 - 1 + 2) → Fin (k^2 + 1) := Fin.cast hsize
    let p := fun (i : Fin (k^2 - 1 + 2)) => net.leftVertex (sel (f i))
    let q := fun (i : Fin (k^2 - 1 + 2)) => net.rightVertex (sel (f i.rev))
    let left := fun (i : Fin (k^2 - 1 + 2)) => (net.leftPath (sel (f i))).reverse
    let right := fun (i : Fin (k^2 - 1 + 2)) => (net.rightPath (sel (f i.rev))).reverse
    have hI : I.IsPath := geometry.x_y_path.property
    have hp (i) : p i ∈ I.support := by
      dsimp only [p]
      rw [← hlget (sel (f i))]
      exact List.get_mem _ _
    have hq (i) : q i ∈ I.support := by
      dsimp only [q]
      rw [← hrget (sel (f i.rev))]
      exact List.get_mem _ _
    have idxp (i) : I.support.idxOf (p i) = (lp (sel (f i))).val := by
      dsimp only [p]
      rw [← hlget (sel (f i))]
      exact sourceLemma36_idxOf_get_eq_position _ hI.support_nodup _
    have idxq (i) : I.support.idxOf (q i) = (rp (sel (f i.rev))).val := by
      dsimp only [q]
      rw [← hrget (sel (f i.rev))]
      exact sourceLemma36_idxOf_get_eq_position _ hI.support_nodup _
    have hlorder : StrictMono (fun i => I.support.idxOf (p i)) := by
      intro i j hij
      change I.support.idxOf (p i) < I.support.idxOf (p j)
      rw [idxp, idxp]
      apply hlp
      change i.val + 1 < j.val + 1
      omega
    have hrorder : StrictMono (fun i => I.support.idxOf (q i)) := by
      intro i j hij
      change I.support.idxOf (q i) < I.support.idxOf (q j)
      rw [idxq, idxq]
      apply hrp
      change j.rev.val + 1 < i.rev.val + 1
      have := Fin.rev_lt_rev.mpr hij
      omega
    have hsep (i j) : I.support.idxOf (p i) < I.support.idxOf (q j) := by
      rw [idxp, idxq]
      exact hlr _ _
    have hstart : I.support.idxOf x < I.support.idxOf (p 0) := by
      have hxidx : I.support.idxOf x = 0 := by rw [I.support_eq_cons, List.idxOf_cons_self]
      have hne : I.support.idxOf (p 0) ≠ I.support.idxOf x := by
        intro he
        exact (exclusions (f 0)).1 ((List.idxOf_inj (hp 0) I.start_mem_support).mp he)
      omega
    have hend : I.support.idxOf (q (Fin.last (k^2 - 1 + 1))) < I.support.idxOf y := by
      have hyidx := sourceLemma36_idxOf_terminal I.support y hI.support_nodup
        (Walk.support_ne_nil I) I.getLast_support
      have hbound := List.idxOf_lt_length_iff.mpr (hq (Fin.last (k^2 - 1 + 1)))
      have hne : I.support.idxOf (q (Fin.last (k^2 - 1 + 1))) ≠ I.support.idxOf y := by
        intro he
        exact (exclusions (f (Fin.last (k^2 - 1 + 1)).rev)).2.2.2
          ((List.idxOf_inj (hq _) I.end_mem_support).mp he)
      omega
    have hlpath (i) : (left i).IsPath := (net.leftPath_isPath _).reverse
    have hrpath (i) : (right i).IsPath := (net.rightPath_isPath _).reverse
    have hlempty (i) : internalVertices G (left i) = ∅ := by
      apply sourceLemma36_internalVertices_empty_of_length_one
      simpa only [left, Walk.length_reverse] using net.leftPath_length (sel (f i))
    have hrempty (i) : internalVertices G (right i) = ∅ := by
      apply sourceLemma36_internalVertices_empty_of_length_one
      simpa only [right, Walk.length_reverse] using net.rightPath_length (sel (f i.rev))
    have hcross (i j) : Disjoint {z | z ∈ (left i).support} {z | z ∈ (right j).support} := by
      apply Set.disjoint_left.mpr
      intro z hzl hzr
      have endpoints (a b : V) (P : G.Walk a b) (he : internalVertices G P = ∅)
          (hz : z ∈ P.support) : z = a ∨ z = b := by
        by_cases hza : z = a
        · exact Or.inl hza
        by_cases hzb : z = b
        · exact Or.inr hzb
        have hm : z ∈ internalVertices G P := ⟨hz, hza, hzb⟩
        rw [he] at hm
        exact hm.elim
      rcases endpoints _ _ (left i) (hlempty i) hzl with hl | hl <;>
        rcases endpoints _ _ (right j) (hrempty j) hzr with hr | hr
      · exact net.left_ne_right _ _ (hl.symm.trans hr)
      · exact net.hub_v_ne_left _ (hr.symm.trans hl)
      · exact net.hub_u_ne_right _ (hl.symm.trans hr)
      · exact net.hub_u_ne_v (hl.symm.trans hr)
    exact sourceLemma39_net_ordered_ambient_spectrum G hk2 I S hI hD p q left right
      hp hq hlorder hrorder hsep hstart hend hu hv hlpath hrpath
      (fun i => by rw [hlempty]; exact Set.empty_disjoint _)
      (fun i => by rw [hrempty]; exact Set.empty_disjoint _)
      (fun i j _ => by rw [hlempty]; exact Set.empty_disjoint _)
      (fun i j _ => by rw [hrempty]; exact Set.empty_disjoint _)
      hcross
  · have hk1 : k = 1 := by omega
    have hlen : 3 ≤ D.length := hD.three_le_length
    refine ⟨{1}, {D.length - 1}, by simp [hk1], by simp [hk1], ?_, ?_, ?_⟩
    · intro a ha; have := Finset.mem_singleton.mp ha; omega
    · intro b hb; have := Finset.mem_singleton.mp hb; omega
    · intro a ha b hb
      have := Finset.mem_singleton.mp ha
      have := Finset.mem_singleton.mp hb
      exact ⟨x, D, hD, by omega⟩

