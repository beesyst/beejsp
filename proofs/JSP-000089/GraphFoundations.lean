    intro x y h
    rcases h with h | ⟨hne, i, hx, hy⟩
    · exact Or.inl (by simpa only [Sym2.eq_swap] using h)
    · exact Or.inr ⟨hne.symm, i, hy, hx⟩
  loopless := by
    intro x h
    rcases h with h | ⟨hne, _⟩
    · exact H.loopless x (D.adj_of_mem_edges h)
    · exact hne rfl

private theorem sourceLemma39_shadow_edges {W : Type*} (H : SimpleGraph W) {r : W}
