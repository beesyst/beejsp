  have hxdata := Classical.choose_spec hpair
  let y : V := Classical.choose hxdata.2
  have hydata := Classical.choose_spec hxdata.2
  have hx : x ∈ family.vertices owner := hxdata.1
  have hy : y ∈ family.vertices owner := hydata.1
  have hxy : x ≠ y := hydata.2.1
  have hside :
