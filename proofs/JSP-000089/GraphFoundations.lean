      (if choose i then (T.attachment i).length else (arc i).length) := by
    dsimp only [Q]; split_ifs <;> rfl
  have hQSum : (∑ i, (Q i).length) =
      ∑ i, (if choose i then (T.attachment i).length else (arc i).length) :=
    Finset.sum_congr rfl (fun i _ => hQLen i)
  rw [← hQSum]
  change (Walk.cons closing W).length + _ = C.length + ∑ i, (Q i).length
  rw [Walk.length_cons, hArcSum]
