private theorem sourceLemma39_sublist_positions [DecidableEq V]
    (L M : List V) (hM : M.Nodup) (hsub : L.Sublist M) :
    ∃ f : Fin L.length → Fin M.length, StrictMono f ∧ ∀ i, M.get (f i) = L.get i := by
  induction hsub with
  | slnil =>
    exact ⟨Fin.elim0, by intro i; exact Fin.elim0 i, by intro i; exact Fin.elim0 i⟩
  | @cons L M a hsub ih =>
    obtain ⟨f, hf, hget⟩ := ih (List.nodup_cons.mp hM).2
    refine ⟨fun i => (f i).succ, ?_, ?_⟩
    · intro i j hij; exact Fin.succ_lt_succ_iff.mpr (hf hij)
    · intro i; exact hget i
  | @cons₂ L M a hsub ih =>
    obtain ⟨f, hf, hget⟩ := ih (List.nodup_cons.mp hM).2
    refine ⟨Fin.cases ⟨0, by simp⟩ (fun i => (f i).succ), ?_, ?_⟩
    · intro i j hij
      cases i using Fin.cases with
      | zero =>
        cases j using Fin.cases with
        | zero => exact (lt_irrefl _ hij).elim
        | succ j => exact Nat.zero_lt_succ _
      | succ i =>
        cases j using Fin.cases with
        | zero => exact (Nat.not_lt_zero _ hij).elim
        | succ j => exact Fin.succ_lt_succ_iff.mpr (hf (Fin.succ_lt_succ_iff.mp hij))
    · intro i; cases i using Fin.cases with
      | zero => rfl
      | succ i => exact hget i

/-- Select genuine source attachments in their internal path order, omitting
one extreme entry per side so that neither selected family reaches x or y. -/
private theorem sourceLemma25_net_ordered_selection
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ} {Z T : Finset V}
    {u w v x y : V} (net : SourceLemma36KSquaredNet G C k Z T u w v x y) :
    let sel : Fin (k^2 + 1) → Fin (k^2 + 2) := fun i => ⟨i.val + 1, by omega⟩
    let L := net.blocks.common.geometry.x_y_path.val.support
    ∃ lp rp : Fin (k^2 + 2) → Fin L.length,
      StrictMono lp ∧ StrictAnti rp ∧
      (∀ i, L.get (lp i) = net.leftVertex i) ∧
      (∀ i, L.get (rp i) = net.rightVertex i) ∧
      (∀ i j, lp i < rp j) ∧
      (∀ i, net.leftVertex (sel i) ≠ x ∧ net.leftVertex (sel i) ≠ y ∧
        net.rightVertex (sel i) ≠ x ∧ net.rightVertex (sel i) ≠ y) := by
  classical
  dsimp only
  let blocks := net.blocks
  let L := blocks.common.geometry.x_y_path.val.support
  obtain ⟨pos, hpos, hget⟩ := sourceLemma39_sublist_positions
    (blocks.leftBlockList ++ blocks.rightBlockList) L
    blocks.common.geometry.x_y_path.isPath.support_nodup net.source_path_order
  let li (i : Fin (k^2 + 2)) : Fin (blocks.leftBlockList ++ blocks.rightBlockList).length :=
    ⟨i.val, by rw [List.length_append, blocks.leftBlockList_length, blocks.rightBlockList_length]; omega⟩
  let ri (i : Fin (k^2 + 2)) : Fin (blocks.leftBlockList ++ blocks.rightBlockList).length :=
    ⟨k^2 + 2 + i.rev.val, by rw [List.length_append, blocks.leftBlockList_length, blocks.rightBlockList_length]; have := i.rev.isLt; omega⟩
  let lp := fun i => pos (li i)
  let rp := fun i => pos (ri i)
  have hlget : ∀ i, L.get (lp i) = net.leftVertex i := by
    intro i
    rw [hget, net.leftVertex_def]
    simp only [li, List.get_eq_getElem]
    rw [List.getElem_append_left]
    rfl
  have hrget : ∀ i, L.get (rp i) = net.rightVertex i := by
    intro i
    rw [hget, net.rightVertex_def]
    simp only [ri, List.get_eq_getElem]
    rw [List.getElem_append_right]
    · simp only [blocks.leftBlockList_length, Nat.add_sub_cancel_left]
      rfl
    · rw [blocks.leftBlockList_length]; omega
  have hl : StrictMono lp := by
    intro i j hij
    apply hpos
    exact Nat.add_lt_add_right hij 0
  have hr : StrictAnti rp := by
    intro i j hij
    apply hpos
    change k^2 + 2 + j.rev.val < k^2 + 2 + i.rev.val
    exact Nat.add_lt_add_left (Fin.rev_lt_rev.mpr hij) _
  have hlr : ∀ i j, lp i < rp j := by
    intro i j
    apply hpos
    change i.val < k^2 + 2 + j.rev.val
    have := i.isLt
    omega
  have hinj := List.nodup_iff_injective_get.mp blocks.common.geometry.x_y_path.isPath.support_nodup
  have hxidx : L.idxOf x = 0 := by
    exact (congrArg (fun S => S.idxOf x) blocks.common.geometry.x_y_path.val.support_eq_cons).trans
      (List.idxOf_cons_self ..)
  have hyidx : L.idxOf y = L.length - 1 := sourceLemma36_idxOf_terminal L y
    blocks.common.geometry.x_y_path.isPath.support_nodup (Walk.support_ne_nil _)
    blocks.common.geometry.x_y_path.val.getLast_support
  have hidxL (i) : L.idxOf (net.leftVertex i) = (lp i).val := by
    rw [← hlget i]
    exact sourceLemma36_idxOf_get_eq_position _ blocks.common.geometry.x_y_path.isPath.support_nodup _
  have hidxR (i) : L.idxOf (net.rightVertex i) = (rp i).val := by
    rw [← hrget i]
    exact sourceLemma36_idxOf_get_eq_position _ blocks.common.geometry.x_y_path.isPath.support_nodup _
  refine ⟨lp, rp, hl, hr, hlget, hrget, hlr, ?_⟩
  intro i
  let j : Fin (k^2 + 2) := ⟨i.val + 1, by omega⟩
  have h0j : (0 : Fin (k^2 + 2)) < j := by change 0 < i.val + 1; omega
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro heq
    have hidx : (lp j).val = 0 := by rw [← hidxL j, heq, hxidx]
    have h := hl h0j
    change (lp 0).val < (lp j).val at h
    omega
  · intro heq
    have hidx : (lp j).val = L.length - 1 := by rw [← hidxL j, heq, hyidx]
    have h := hlr j 0
    have hb := (rp 0).isLt
    change (lp j).val < (rp 0).val at h
    omega
  · intro heq
    have hidx : (rp j).val = 0 := by rw [← hidxR j, heq, hxidx]
    have h := hlr 0 j
    change (lp 0).val < (rp j).val at h
    omega
  · intro heq
    have hidx : (rp j).val = L.length - 1 := by rw [← hidxR j, heq, hyidx]
    have h := hr h0j
    have hb := (rp 0).isLt
    change (rp j).val < (rp 0).val at h
    omega

