    | hf x y =>
      simp only [Finset.mem_filter, Finset.mk_mem_sym2_iff, Sym2.isDiag_iff_proj_eq, Finset.mem_image, Sym2.diag, Sym2.eq_iff]
      aesop
  have hcard : (Y.sym2.filter Sym2.IsDiag).card = Y.card := by
    rw [hdiag, Finset.card_image_of_injective _ Sym2.diag_injective]
  have hpart := Finset.filter_card_add_filter_neg_card_eq_card (s := Y.sym2) Sym2.IsDiag
  rw [hcard, Finset.card_sym2] at hpart
  have hchoose : (Y.card + 1).choose 2 ≤ Y.card + 6 := by
    have hcases : Y.card = 0 ∨ Y.card = 1 ∨ Y.card = 2 ∨ Y.card = 3 ∨ Y.card = 4 := by omega
    rcases hcases with h | h | h | h | h <;> norm_num [h, Nat.choose]
  omega

/-- The root graph records co-membership in any original K4, retaining the
