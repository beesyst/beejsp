  let leftPosition : Fin k → Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length :=
    fun i => if p i < q i then p i else q i
  let rightPosition : Fin k → Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length :=
    fun i => if p i < q i then q i else p i
