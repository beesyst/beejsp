/-!
Proof-local finite graph foundations for the first use of Menger's theorem in
Verstraëte, Section 3 (Lemma 3.3).  The source only needs the vertex version:
an `u`--`v` path avoids a separator precisely when none of its internal
vertices belongs to that separator.
-/

namespace JSP000089

open SimpleGraph

variable {V : Type*} (G : SimpleGraph V)

/-- Vertices of a walk other than its two prescribed endpoints. -/
def internalVertices {u v : V} (p : G.Walk u v) : Set V :=
  {w | w ∈ p.support ∧ w ≠ u ∧ w ≠ v}

/-- Two paths with common prescribed endpoints are internally vertex-disjoint. -/
def InternallyVertexDisjoint {u v : V} (p q : G.Walk u v) : Prop :=
  Disjoint (internalVertices G p) (internalVertices G q)

/-- A finite set separates two distinct vertices when every path between them
uses one of its vertices internally. -/
def VertexSeparator (u v : V) (S : Finset V) : Prop :=
  u ∉ S ∧ v ∉ S ∧
    ∀ p : G.Walk u v, ∃ w, w ∈ S ∧ w ∈ internalVertices G p

/-- Standard finite vertex connectivity: the graph has more than `k` vertices
and deleting fewer than `k` vertices leaves a connected induced graph. -/
def VertexConnectivityAtLeast [Fintype V] (k : ℕ) : Prop :=
  k < Fintype.card V ∧ ∀ S : Finset V, S.card < k →
    (G.induce {v : V | v ∉ S}).Connected

/-- Proof-local induced edge count for the k=4 Mader extremal witness. -/
private noncomputable def sourceMaderEdgeCount [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (W : Finset V) : ℕ :=
  Nat.card (G.induce (↑W : Set V)).edgeSet

private theorem sourceMader_card_edgeSet_eq_edgeFinset {U : Type*} [Fintype U]
    [DecidableEq U] (H : SimpleGraph U) [DecidableRel H.Adj] :
    Nat.card H.edgeSet = H.edgeFinset.card := by
  rw [Nat.card_eq_fintype_card, ← H.edgeFinset_card]

/-- The edge threshold whose minimum-cardinality witness yields the required
4-connected induced subgraph. -/
private def sourceMaderGood [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (W : Finset V) : Prop :=
  7 ≤ W.card ∧ 5 * (W.card - 3) + 1 ≤ sourceMaderEdgeCount G W

private theorem sourceMader_univ_good [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (hcard : 7 ≤ Fintype.card V)
    (havg : averageDegreeAtLeast G 10) : sourceMaderGood G Finset.univ := by
  classical
  have hfive : 5 * Fintype.card V ≤ G.edgeFinset.card := by
    have htwo : 2 * (5 * Fintype.card V) ≤ 2 * G.edgeFinset.card := by
      simpa [Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm] using havg.2
    omega
  have hthreshold : 5 * (Fintype.card V - 3) + 1 ≤ G.edgeFinset.card := by
    omega
  have hedge : sourceMaderEdgeCount G Finset.univ = G.edgeFinset.card := by
    calc
      sourceMaderEdgeCount G Finset.univ = Nat.card G.edgeSet := by
        rw [sourceMaderEdgeCount,
          show (↑(Finset.univ : Finset V) : Set V) = Set.univ by ext; simp]
        exact Nat.card_congr G.induceUnivIso.mapEdgeSet
      _ = G.edgeFinset.card := sourceMader_card_edgeSet_eq_edgeFinset G
  constructor
  · simpa using hcard
  · simpa [hedge] using hthreshold

private theorem sourceMader_exists_minimal_good [Fintype V] [DecidableEq V]
    (G : SimpleGraph V)
    (hgood : ∃ W : Finset V, sourceMaderGood G W) :
    ∃ W : Finset V, sourceMaderGood G W ∧
      ∀ U : Finset V, sourceMaderGood G U → W.card ≤ U.card := by
  classical
  let goods : Finset (Finset V) := Finset.univ.filter (sourceMaderGood G)
  obtain ⟨W0, hW0⟩ := hgood
  have hW0goods : W0 ∈ goods := by simp [goods, hW0]
  let cards : Finset ℕ := goods.image Finset.card
  have hcards : cards.Nonempty := ⟨W0.card, Finset.mem_image.mpr ⟨W0, hW0goods, rfl⟩⟩
  let c := cards.min' hcards
  have hc : c ∈ cards := cards.min'_mem hcards
  obtain ⟨W, hWgoods, hWcard⟩ := Finset.mem_image.mp hc
  refine ⟨W, ?_, ?_⟩
  · simpa [goods] using (Finset.mem_filter.mp hWgoods).2
  · intro U hU
    have hUgoods : U ∈ goods := by simp [goods, hU]
    have hUcard : U.card ∈ cards := Finset.mem_image.mpr ⟨U, hUgoods, rfl⟩
    have hmin : c ≤ U.card := cards.min'_le U.card hUcard
    simpa [c] using hWcard.symm ▸ hmin

private theorem sourceMader_edgeCount_le_choose [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (W : Finset V) :
    sourceMaderEdgeCount G W ≤ W.card.choose 2 := by
  classical
  letI : Fintype {v : V // v ∈ (↑W : Set V)} :=
    Subtype.fintype (Membership.mem (↑W : Set V))
  rw [sourceMaderEdgeCount,
    sourceMader_card_edgeSet_eq_edgeFinset (G.induce (↑W : Set V) : SimpleGraph _)]
  simpa using (G.induce (↑W : Set V)).card_edgeFinset_le_card_choose_two

private theorem sourceMader_erase_card [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (W : Finset V) (v : W) :
    (W.erase v.1).card = W.card - 1 := Finset.card_erase_of_mem v.2

private theorem sourceMader_card_edgeFinset_delete {X : Type*} [Fintype X]
    [DecidableEq X] (H : SimpleGraph X) [DecidableRel H.Adj] (v : X)
    [Fintype ↑(H.neighborSet v)] :
    H.edgeFinset.card = (H.induce {x : X | x ≠ v}).edgeFinset.card + H.degree v := by
  have hsurvive :
      (H.induce {x : X | x ≠ v}).edgeFinset.map
          (Function.Embedding.subtype {x : X | x ≠ v}).sym2Map =
        H.edgeFinset \ H.incidenceFinset v := by
    rw [H.map_edgeFinset_induce, H.incidenceFinset_eq_filter]
    ext e
    induction e using Sym2.inductionOn with
    | _ a b =>
      simp only [Finset.mem_inter, Finset.mem_sdiff, Finset.mem_filter,
        Finset.mk_mem_sym2_iff, Set.mem_toFinset, mem_edgeFinset, mem_edgeSet,
        mk'_mem_incidenceSet_iff]
      aesop
  have hinc : H.incidenceFinset v ⊆ H.edgeFinset := by
    simp [SimpleGraph.incidenceFinset, SimpleGraph.incidenceSet_subset]
  have hdegree : (H.incidenceFinset v).card = H.degree v :=
    H.card_incidenceFinset_eq_degree v
  have hcard := Finset.card_sdiff hinc
  have hle := Finset.card_le_card hinc
  rw [hdegree] at hcard hle
  have hsurvivecard := congrArg Finset.card hsurvive
  rw [Finset.card_map] at hsurvivecard
  omega

private def sourceMader_erase_induce_iso [DecidableEq V] (G : SimpleGraph V)
    (W : Finset V) (v : W) :
    ((G.induce (↑W : Set V)).induce {w | w ≠ v}) ≃g
      G.induce (↑(W.erase v.1) : Set V) where
  toEquiv :=
    { toFun := fun x => ⟨x.1.1, Finset.mem_erase.mpr
          ⟨by intro h; apply x.2; apply Subtype.ext; exact h, x.1.2⟩⟩
      invFun := fun x => ⟨⟨x.1, (Finset.mem_erase.mp x.2).2⟩, by
        intro h
        exact (Finset.mem_erase.mp x.2).1 (congrArg Subtype.val h)⟩
      left_inv := by intro x; apply Subtype.ext; apply Subtype.ext; rfl
      right_inv := by intro x; apply Subtype.ext; rfl }
  map_rel_iff' := by intro x y; rfl

private theorem sourceMader_edgeCount_erase_add_degree [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (W : Finset V) (v : W)
    [Fintype ↑((G.induce (↑W : Set V)).neighborSet v)] :
    sourceMaderEdgeCount G W = sourceMaderEdgeCount G (W.erase v.1) +
      (G.induce (↑W : Set V)).degree v := by
  classical
  have hdelete := sourceMader_card_edgeFinset_delete (G.induce (↑W : Set V)) v
  have hiso := (sourceMader_erase_induce_iso G W v).card_edgeFinset_eq
  simpa only [sourceMaderEdgeCount, sourceMader_card_edgeSet_eq_edgeFinset] using
    hdelete.trans (congrArg (fun n => n + (G.induce (↑W : Set V)).degree v) hiso)

private theorem sourceMader_card7_no_low_degree [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (W : Finset V)
    (hWgood : sourceMaderGood G W) (hcard7 : W.card = 7) (v : W)
    [Fintype ↑((G.induce (↑W : Set V)).neighborSet v)]
    (hv : (G.induce (↑W : Set V)).degree v ≤ 5) : False := by
  classical
  have hlower := hWgood.2
  rw [hcard7] at hlower
  norm_num at hlower
  have herase := sourceMader_erase_card G W v
  have hupper := sourceMader_edgeCount_le_choose G (W.erase v.1)
  rw [herase, hcard7] at hupper
  norm_num [Nat.choose] at hupper
  have hdelete := sourceMader_edgeCount_erase_add_degree G W v
  omega

private theorem sourceMader_card8_no_low_degree [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (W : Finset V)
    (hWgood : sourceMaderGood G W)
    (hWmin : ∀ U : Finset V, sourceMaderGood G U → W.card ≤ U.card)
    (hcard8 : 8 ≤ W.card) (v : W)
    [Fintype ↑((G.induce (↑W : Set V)).neighborSet v)]
    (hv : (G.induce (↑W : Set V)).degree v ≤ 5) : False := by
  classical
  have herase := sourceMader_erase_card G W v
  have hdelete := sourceMader_edgeCount_erase_add_degree G W v
  have hlower := hWgood.2
  have hW'good : sourceMaderGood G (W.erase v.1) := by
    constructor
    · rw [herase]
      omega
    · rw [herase]
      omega
  have hlt : (W.erase v.1).card < W.card := by
    rw [herase]
    omega
  exact (not_lt_of_ge (hWmin (W.erase v.1) hW'good)) hlt

private theorem sourceMader_minimal_good_minDegree_six [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (W : Finset V)
    (hWgood : sourceMaderGood G W)
    (hWmin : ∀ U : Finset V, sourceMaderGood G U → W.card ≤ U.card) :
    ∀ v : W, ∀ _ : Fintype ↑((G.induce (↑W : Set V)).neighborSet v),
      6 ≤ (G.induce (↑W : Set V)).degree v := by
  classical
  intro v inst
  letI := inst
  by_contra hdegree
  have hv : (G.induce (↑W : Set V)).degree v ≤ 5 := by omega
  have hcard7le := hWgood.1
  by_cases hcard7 : W.card = 7
  · exact sourceMader_card7_no_low_degree G W hWgood hcard7 v hv
  · have hcard8 : 8 ≤ W.card := by omega
    exact sourceMader_card8_no_low_degree G W hWgood hWmin hcard8 v hv
theorem reachable_after_delete_of_vertexConnectivity [Fintype V] {k : ℕ}
    (hconn : VertexConnectivityAtLeast G k) (S : Finset V) (hS : S.card < k)
    {u v : V} (hu : u ∉ S) (hv : v ∉ S) :
    (G.induce {w : V | w ∉ S}).Reachable ⟨u, hu⟩ ⟨v, hv⟩ := by
  exact (hconn.2 S hS).preconnected ⟨u, hu⟩ ⟨v, hv⟩

/-- A finite 2-connected graph has no vertex of degree below two.  This is the
exact lower-bound bridge used when applying source Lemma 3.2 to an endblock;
it does not assert degree three at the possible cut vertex. -/
theorem degree_two_of_vertexConnectivity [Fintype V] [DecidableEq V] [DecidableRel G.Adj]
    (hconn : VertexConnectivityAtLeast G 2) : ∀ v, 2 ≤ G.degree v := by
  intro v
  by_contra hdegree
  have hdegree_lt : G.degree v < 2 := Nat.lt_of_not_ge hdegree
  let S : Finset V := G.neighborFinset v
  have hS : S.card < 2 := by
    simpa only [S, G.card_neighborFinset_eq_degree] using hdegree_lt
  have hvS : v ∉ S := by
    simp [S, G.mem_neighborFinset]
  let T : Finset V := insert v S
  have hTcard : T.card < Fintype.card V := by
    have hT_eq : T.card = S.card + 1 := by
      dsimp [T]
      exact Finset.card_insert_of_not_mem hvS
    have hcard : 2 < Fintype.card V := hconn.1
    rw [hT_eq]
    omega
  obtain ⟨w, _, hwT⟩ := T.exists_mem_not_mem_of_card_lt_card (t := Finset.univ) hTcard
  have hwS : w ∉ S := by
    intro hwS
    exact hwT (Finset.mem_insert.mpr (Or.inr hwS))
  have hwv : v ≠ w := by
    intro hvw
    subst w
    exact hwT (Finset.mem_insert_self v S)
  obtain ⟨p⟩ := (hconn.2 S hS).preconnected ⟨v, hvS⟩ ⟨w, hwS⟩
  have hpnotnil : ¬ p.Nil := by
    apply Walk.not_nil_of_ne
    intro h
    exact hwv (congrArg Subtype.val h)
  have hadj : (G.induce {a : V | a ∉ S}).Adj ⟨v, hvS⟩ p.snd := p.adj_snd hpnotnil
  have hmem : p.snd.1 ∈ S := by
    apply (G.mem_neighborFinset v p.snd.1).mpr
    exact hadj
  exact p.snd.2 hmem

/-- Failure of finite 2-connectivity in a connected graph with more than
two vertices is witnessed by deleting one cut vertex.  This is the exact
cardinality form required by finite descent. -/
private theorem sourceLemma33_exists_cut_vertex_of_card [Fintype V] [DecidableEq V]
    [DecidableRel G.Adj] (hconn : G.Connected)
    (hcard : 2 < Fintype.card V)
    (hnotTwo : ¬ VertexConnectivityAtLeast G 2) :
    ∃ z, ¬ (G.induce {v : V | v ≠ z}).Connected := by
  have hfails : ¬ ∀ S : Finset V, S.card < 2 →
      (G.induce {v : V | v ∉ S}).Connected := by
    intro h
    exact hnotTwo ⟨hcard, h⟩
  push_neg at hfails
  obtain ⟨S, hS, hdisconnected⟩ := hfails
  have hSpos : 0 < S.card := by
    by_contra hnotpos
    have hSempty : S = ∅ := Finset.card_eq_zero.mp (Nat.eq_zero_of_not_pos hnotpos)
    subst S
    apply hdisconnected
    have hempty : {v : V | v ∉ (∅ : Finset V)} = Set.univ := by ext v; simp
    rw [hempty]
    exact G.induceUnivIso.connected_iff.mpr hconn
  have hScard : S.card = 1 := by omega
  obtain ⟨z, hSsingle⟩ := Finset.card_eq_one.mp hScard
  subst S
  refine ⟨z, ?_⟩
  have hsingle : {v : V | v ∉ ({z} : Finset V)} = {v : V | v ≠ z} := by
    ext v
    simp
  rwa [hsingle] at hdisconnected

/-- The degree-three specialization used for the initial source component. -/
private theorem sourceLemma33_exists_cut_vertex [Fintype V] [DecidableEq V]
    [DecidableRel G.Adj] (hconn : G.Connected)
    (hdegree : ∀ v, 3 ≤ G.degree v)
    (hnotTwo : ¬ VertexConnectivityAtLeast G 2) :
    ∃ z, ¬ (G.induce {v : V | v ≠ z}).Connected := by
  obtain ⟨v⟩ := hconn.nonempty
  have hcard : 2 < Fintype.card V := by
    have hlt := G.degree_lt_card_verts v
    have hthree := hdegree v
    omega
  exact sourceLemma33_exists_cut_vertex_of_card G hconn hcard hnotTwo

/-- Flatten the one nested subtype created when a working set is induced and
then its cut vertex is deleted.  This is deliberately proof-local. -/
private def sourceLemma33_flattenDeleteIso [DecidableEq V] (W : Finset V)
    (z : {v // v ∈ W}) :
    ((G.induce (↑W : Set V)).induce {w | w ≠ z}) ≃g
      G.induce {v : V | v ∈ W ∧ v ≠ z.1} where
  toEquiv :=
    { toFun := fun x => ⟨x.1.1, x.1.2, by
        intro h
        apply x.2
        apply Subtype.ext
        exact h⟩
      invFun := fun x => ⟨⟨x.1, x.2.1⟩, by
        intro h
        exact x.2.2 (congrArg Subtype.val h)⟩
      left_inv := by
        intro x
        apply Subtype.ext
        apply Subtype.ext
        rfl
      right_inv := by
        intro x
        apply Subtype.ext
        rfl }
  map_rel_iff' := by
    intro x y
    change G.Adj x.1.1 y.1.1 ↔ G.Adj x.1.1 y.1.1
    rfl

/-- Transport a cut witness from the nested induced graph to the original
working-set deletion graph. -/
private theorem sourceLemma33_original_delete_disconnected [DecidableEq V]
    (W : Finset V) (z : {v // v ∈ W})
    (h : ¬ ((G.induce (↑W : Set V)).induce {w | w ≠ z}).Connected) :
    ¬ (G.induce {v : V | v ∈ W ∧ v ≠ z.1}).Connected := by
  intro hconnected
  exact h ((sourceLemma33_flattenDeleteIso G W z).connected_iff.mpr hconnected)

/-- A connected component of the component after deleting `z`, represented as a
set of original vertices.  It is proof-local infrastructure for finite
descent, not a block-cut-tree API. -/
private def sourceLemma33DeletionComponent (K : Set V) (z : V)
    (c : (G.induce {v : V | v ∈ K ∧ v ≠ z}).ConnectedComponent) : Set V :=
  {v | ∃ hv : v ∈ K ∧ v ≠ z,
    (G.induce {w : V | w ∈ K ∧ w ≠ z}).connectedComponentMk ⟨v, hv⟩ = c}

/-- Away from the deleted cut vertex, a deletion component is closed under
adjacency inside the old component. -/
private theorem sourceLemma33_deletionComponent_closed
    {K : Set V} {z : V}
    (c : (G.induce {v : V | v ∈ K ∧ v ≠ z}).ConnectedComponent)
    {b a : V} (hb : b ∈ sourceLemma33DeletionComponent G K z c)
    (haK : a ∈ K) (haz : a ≠ z) (hba : G.Adj b a) :
    a ∈ sourceLemma33DeletionComponent G K z c := by
  rcases hb with ⟨hbK, hbc⟩
  refine ⟨⟨haK, haz⟩, ?_⟩
  let H : SimpleGraph {v : V | v ∈ K ∧ v ≠ z} :=
    G.induce {v : V | v ∈ K ∧ v ≠ z}
  have hbaH : H.Adj ⟨b, hbK⟩ ⟨a, haK, haz⟩ := hba
  exact (c.mem_supp_congr_adj hbaH).mp hbc

/-- Every deletion component has an original-vertex representative. -/
private theorem sourceLemma33_deletionComponent_nonempty
    {K : Set V} {z : V}
    (c : (G.induce {v : V | v ∈ K ∧ v ≠ z}).ConnectedComponent) :
    (sourceLemma33DeletionComponent G K z c).Nonempty := by
  obtain ⟨b, hb⟩ := c.exists_rep
  refine ⟨b.1, ⟨b.2, ?_⟩⟩
  exact hb

private theorem sourceLemma33_deletionComponent_subset
    {K : Set V} {z : V}
    (c : (G.induce {v : V | v ∈ K ∧ v ≠ z}).ConnectedComponent) :
    sourceLemma33DeletionComponent G K z c ⊆ K := by
  rintro b ⟨hb, _⟩
  exact hb.1

/-- Thus every old-component neighbour of a deletion-component vertex lies
either in that component or is the single deleted cut vertex. -/
private theorem sourceLemma33_deletionComponent_neighbour_subset
    {K : Set V} {z : V}
    (c : (G.induce {v : V | v ∈ K ∧ v ≠ z}).ConnectedComponent)
    {b a : V} (hb : b ∈ sourceLemma33DeletionComponent G K z c)
    (haK : a ∈ K) (hba : G.Adj b a) :
    a ∈ sourceLemma33DeletionComponent G K z c ∪ {z} := by
  by_cases haz : a = z
  · exact Or.inr haz
  · exact Or.inl (sourceLemma33_deletionComponent_closed G c hb haK haz hba)

/-- A supported walk from a non-cut block vertex to a component vertex outside
the block must meet the cut vertex.  This terminal lemma derives separation
directly from non-cut closure. -/
private theorem sourceLemma33_separates_of_noncut_closed [DecidableEq V]
    (B : Finset V) (K : Set V) (z b a : V)
    (hclosed : ∀ ⦃x y : V⦄, x ∈ B → x ≠ z → G.Adj x y → y ∈ K → y ∈ B)
    (hbB : b ∈ B)
    (haK : a ∈ K) (haB : a ∉ B)
    (p : G.Walk b a) (hpK : internalVertices G p ⊆ K) : z ∈ p.support := by
  by_contra hz
  obtain ⟨d, hd, hdB, hdnotB⟩ := p.exists_boundary_dart (↑B : Set V) hbB haB
  have hdfSupport : d.fst ∈ p.support := p.dart_fst_mem_support_of_mem_darts hd
  have hdsSupport : d.snd ∈ p.support := p.dart_snd_mem_support_of_mem_darts hd
  have hdfz : d.fst ≠ z := by
    intro h
    exact hz (h ▸ hdfSupport)
  have hdsK : d.snd ∈ K := by
    by_cases hdb : d.snd = b
    · rw [hdb] at hdnotB
      exact (hdnotB hbB).elim
    by_cases hda : d.snd = a
    · rw [hda]
      exact haK
    exact hpK ⟨hdsSupport, hdb, hda⟩
  exact hdnotB (hclosed hdB hdfz d.adj hdsK)

/-- The one-path finite Menger special case: for two distinct vertices, a
path exists exactly when the empty vertex set is not a separator.  The result
is deliberately local; the later four-path linkage is a separate milestone. -/
theorem finiteMenger_one {u v : V} :
    (∃ p : G.Walk u v, p.IsPath) ↔
      ¬ ∃ S : Finset V, S.card < 1 ∧ VertexSeparator G u v S := by
  classical
  constructor
  · rintro ⟨p, hp⟩ ⟨S, hcard, hsep⟩
    obtain ⟨w, hwS, _⟩ := hsep.2.2 p
    have hnonempty : S.Nonempty := ⟨w, hwS⟩
    have hpositive : 0 < S.card := Finset.card_pos.mpr hnonempty
    omega
  · intro h
    by_contra hpaths
    push_neg at hpaths
    apply h
    refine ⟨∅, by simp, ?_⟩
    refine ⟨by simp, by simp, ?_⟩
    intro p
    exact (hpaths p.toPath p.toPath.isPath).elim

/-- The full vertex support of a walk. -/
def walkVerts {u v : V} (p : G.Walk u v) : Set V :=
  {w | w ∈ p.support}

/-- Simplifying a walk to a path cannot introduce a vertex. -/
theorem walkVerts_toPath_subset [DecidableEq V] {u v : V} (p : G.Walk u v) :
    walkVerts G (p.toPath : G.Walk u v) ⊆ walkVerts G p := by
  intro w hw
  exact Walk.support_toPath_subset p hw

/-- The vertices of an appended walk are the union of the vertices of its pieces. -/
theorem walkVerts_append {u v w : V} (p : G.Walk u v) (q : G.Walk v w) :
    walkVerts G (p.append q) = walkVerts G p ∪ walkVerts G q := by
  ext x
  simp only [walkVerts, Set.mem_union, Set.mem_setOf_eq]
  exact Walk.mem_support_append_iff p q

/-- A set separates terminal sets when it meets every walk from the first set
to the second. -/
def ABSeparator (A B S : Finset V) : Prop :=
  ∀ ⦃a⦄, a ∈ A →
    ∀ ⦃b⦄, b ∈ B →
      ∀ p : G.Walk a b, ∃ v ∈ S, v ∈ p.support

/-- A finite family of fully vertex-disjoint simple paths from `A` to `B`. -/
structure ABLinkageData (A B : Finset V) (m : Nat) where
  src : Fin m → V
  dst : Fin m → V
  path : ∀ i, G.Path (src i) (dst i)
  src_mem : ∀ i, src i ∈ A
  dst_mem : ∀ i, dst i ∈ B
  src_injective : Function.Injective src
  dst_injective : Function.Injective dst
  disjoint_support : ∀ ⦃i j⦄, i ≠ j →
    Disjoint
      {v | v ∈ ((path i : G.Walk (src i) (dst i)).support)}
      {v | v ∈ ((path j : G.Walk (src j) (dst j)).support)}

/-- The required fixed order-four output. -/
def FourABLinkage (A B : Finset V) : Prop :=
  Nonempty (ABLinkageData G A B 4)

/-- Vertices of the proof-local vertex-split residual network. -/
inductive SplitVertex (V : Type*) where
  | source : SplitVertex V
  | sink : SplitVertex V
  | vin : V → SplitVertex V
  | vout : V → SplitVertex V
deriving DecidableEq

/-- A vertex occupied by one of the paths in a linkage. -/
def linkageUsedVertex {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (v : V) : Prop :=
  ∃ i, v ∈ ((L.path i : G.Walk (L.src i) (L.dst i)).support)

/-- Occupancy of source and sink capacity arcs. -/
def linkageUsedSource {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (v : V) : Prop :=
  ∃ i, L.src i = v

def linkageUsedSink {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (v : V) : Prop :=
  ∃ i, L.dst i = v

/-- An oriented graph transition occupied by a linkage path. -/
def linkageUsedDart {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (u v : V) : Prop :=
  ∃ i, ∃ d ∈ (L.path i : G.Walk (L.src i) (L.dst i)).darts,
    d.fst = u ∧ d.snd = v

/-- Decidability of occupied vertices. -/
instance linkage_usedVertex_decidable [DecidableEq V] {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (v : V) : Decidable (linkageUsedVertex G L v) := by
  unfold linkageUsedVertex
  infer_instance

/-- The directed residual relation of the vertex-split network. -/
def residualStep {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (x y : SplitVertex V) : Prop :=
  (∃ a, a ∈ A ∧ ¬ linkageUsedSource G L a ∧ x = .source ∧ y = .vin a) ∨
  (∃ a, linkageUsedSource G L a ∧ x = .vin a ∧ y = .source) ∨
  (∃ v, ¬ linkageUsedVertex G L v ∧ x = .vin v ∧ y = .vout v) ∨
  (∃ v, linkageUsedVertex G L v ∧ x = .vout v ∧ y = .vin v) ∨
  (∃ u v, G.Adj u v ∧ x = .vout u ∧ y = .vin v) ∨
  (∃ u v, linkageUsedDart G L u v ∧ x = .vin v ∧ y = .vout u) ∨
  (∃ b, b ∈ B ∧ ¬ linkageUsedSink G L b ∧ x = .vout b ∧ y = .sink) ∨
  (∃ b, linkageUsedSink G L b ∧ x = .sink ∧ y = .vout b)

/-- Case form for the residual relation. -/
theorem residualStep_cases {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (x y : SplitVertex V) :
    residualStep G L x y ↔
      (∃ a, a ∈ A ∧ ¬ linkageUsedSource G L a ∧ x = .source ∧ y = .vin a) ∨
      (∃ a, linkageUsedSource G L a ∧ x = .vin a ∧ y = .source) ∨
      (∃ v, ¬ linkageUsedVertex G L v ∧ x = .vin v ∧ y = .vout v) ∨
      (∃ v, linkageUsedVertex G L v ∧ x = .vout v ∧ y = .vin v) ∨
      (∃ u v, G.Adj u v ∧ x = .vout u ∧ y = .vin v) ∨
      (∃ u v, linkageUsedDart G L u v ∧ x = .vin v ∧ y = .vout u) ∨
      (∃ b, b ∈ B ∧ ¬ linkageUsedSink G L b ∧ x = .vout b ∧ y = .sink) ∨
      (∃ b, linkageUsedSink G L b ∧ x = .sink ∧ y = .vout b) := Iff.rfl

/-- Directed residual reachability from the artificial source. -/
def altReach {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) : Set (SplitVertex V) :=
  {x | Relation.ReflTransGen (residualStep G L) .source x}

/-- Residual reachability is closed under one residual step. -/
theorem altReach_closed {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {x y : SplitVertex V}
    (hx : x ∈ altReach G L) (hxy : residualStep G L x y) :
    y ∈ altReach G L :=
  hx.tail hxy

/-- Every residual reachability proof has a finite directed list trace.  This
is the raw trace subsequently shortened by the direct loop-erasure argument. -/
theorem residual_trace_to_chain {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {z : SplitVertex V}
    (h : Relation.ReflTransGen (residualStep G L) .source z) :
    ∃ q : List (SplitVertex V),
      q.head? = some .source ∧ q.getLast? = some z ∧
        q.Chain' (residualStep G L) := by
  obtain ⟨l, hl, hlast⟩ := List.exists_chain_of_relationReflTransGen h
  refine ⟨.source :: l, by simp, ?_, ?_⟩
  · rw [List.getLast?_eq_getLast (by simp)]
    exact congrArg some hlast
  · simpa [List.Chain'] using hl

private theorem getLast?_take_idxOf_succ {α : Type*} [DecidableEq α]
    {q : List α} {c : α} (hc : c ∈ q) :
    (q.take (q.idxOf c + 1)).getLast? = some c := by
  have hlt : q.idxOf c < q.length := List.idxOf_lt_length hc
  have hle : q.idxOf c + 1 ≤ q.length := Nat.succ_le_of_lt hlt
  rw [List.getLast?_eq_getElem?, List.length_take, min_eq_left hle,
    Nat.add_sub_cancel, List.getElem?_take, if_pos (Nat.lt_succ_self _),
    List.getElem?_idxOf hc]

/-- Loop-erasing a residual reachability trace directly yields a finite simple
directed chain. -/
theorem residual_trace_to_simple_trace [DecidableEq V] {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {z : SplitVertex V}
    (h : Relation.ReflTransGen (residualStep G L) .source z) :
    ∃ q : List (SplitVertex V), q.Nodup ∧
      q.head? = some .source ∧ q.getLast? = some z ∧
        q.Chain' (residualStep G L) := by
  induction h with
  | refl =>
      exact ⟨[.source], by simp, by simp, by simp, by simp⟩
  | @tail b c hbc hstep ih =>
      rcases ih with ⟨q, hnodup, hhead, hlast, hchain⟩
      by_cases hc : c ∈ q
      · refine ⟨q.take (q.idxOf c + 1),
          hnodup.sublist (List.take_sublist _ _), ?_,
          getLast?_take_idxOf_succ hc, hchain.take _⟩
        rw [List.head?_take, if_neg]
        · exact hhead
        · omega
      · refine ⟨q ++ [c], ?_, ?_, ?_, ?_⟩
        · exact hnodup.append (by simp) (by simpa using hc)
        · simp [hhead]
        · simp [hlast]
        · apply hchain.append (by simp)
          intro x hx y hy
          have hx' : x = b := by simpa [hlast] using hx.symm
          have hy' : y = c := by simpa using hy.symm
          subst x
          subst y
          exact hstep

/-- A residual augmentation witness is represented by a finite nodup directed
chain from the artificial source to the artificial sink. -/
theorem simple_residual_source_sink_trace [DecidableEq V] {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m)
    (h : .sink ∈ altReach G L) :
    ∃ q : List (SplitVertex V), q.Nodup ∧
      q.head? = some .source ∧ q.getLast? = some .sink ∧
        q.Chain' (residualStep G L) :=
  residual_trace_to_simple_trace G L h

/-- Forward arcs in the proof-local vertex-split network. -/
inductive SplitArc (V : Type*) where
  | sourceArc : V → SplitArc V
  | vertexArc : V → SplitArc V
  | graphArc : V → V → SplitArc V
  | sinkArc : V → SplitArc V
deriving DecidableEq

def splitArcTail : SplitArc V → SplitVertex V
  | .sourceArc _ => .source
  | .vertexArc v => .vin v
  | .graphArc u _ => .vout u
  | .sinkArc v => .vout v

def splitArcHead : SplitArc V → SplitVertex V
  | .sourceArc v => .vin v
  | .vertexArc v => .vout v
  | .graphArc _ v => .vin v
  | .sinkArc _ => .sink

/-- Membership in the finite forward-arc state encoded by a linkage. -/
def linkageSplitArc {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) : SplitArc V → Prop
  | .sourceArc a => linkageUsedSource G L a
  | .vertexArc v => linkageUsedVertex G L v
  | .graphArc u v => linkageUsedDart G L u v
  | .sinkArc b => linkageUsedSink G L b

/-- A residual step acts by adding an unused forward arc or removing a used
forward arc. -/
inductive ResidualAction (V : Type*) where
  | add : SplitArc V → ResidualAction V
  | remove : SplitArc V → ResidualAction V

def residualActionTail : ResidualAction V → SplitVertex V
  | .add e => splitArcTail e
  | .remove e => splitArcHead e

def residualActionHead : ResidualAction V → SplitVertex V
  | .add e => splitArcHead e
  | .remove e => splitArcTail e

/-- Forward graph arcs have unrestricted capacity; every other added arc is
unused, while a removed arc is selected by the current linkage. -/
def residualActionValid {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) : ResidualAction V → Prop
  | .add (.graphArc u v) => G.Adj u v
  | .add e => ¬ linkageSplitArc G L e
  | .remove e => linkageSplitArc G L e

/-- Every residual transition has its unique forward-arc interpretation. -/
theorem residualStep_to_action {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {x y : SplitVertex V}
    (h : residualStep G L x y) :
    ∃ action : ResidualAction V,
      residualActionTail action = x ∧ residualActionHead action = y ∧
        residualActionValid G L action := by
  rcases h with h | h | h | h | h | h | h | h
  · rcases h with ⟨a, ha, hused, rfl, rfl⟩
    exact ⟨.add (.sourceArc a), rfl, rfl, hused⟩
  · rcases h with ⟨a, hused, rfl, rfl⟩
    exact ⟨.remove (.sourceArc a), rfl, rfl, hused⟩
  · rcases h with ⟨v, hused, rfl, rfl⟩
    exact ⟨.add (.vertexArc v), rfl, rfl, hused⟩
  · rcases h with ⟨v, hused, rfl, rfl⟩
    exact ⟨.remove (.vertexArc v), rfl, rfl, hused⟩
  · rcases h with ⟨u, v, hadj, rfl, rfl⟩
    exact ⟨.add (.graphArc u v), rfl, rfl, hadj⟩
  · rcases h with ⟨u, v, hused, rfl, rfl⟩
    exact ⟨.remove (.graphArc u v), rfl, rfl, hused⟩
  · rcases h with ⟨b, hb, hused, rfl, rfl⟩
    exact ⟨.add (.sinkArc b), rfl, rfl, hused⟩
  · rcases h with ⟨b, hused, rfl, rfl⟩
    exact ⟨.remove (.sinkArc b), rfl, rfl, hused⟩

/-- A list of residual actions aligned with a list of split vertices.  The
`cons` constructor stores exactly the action between the first two vertices. -/
inductive OrderedResidualActions {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) : List (SplitVertex V) → Type _
  | nil : OrderedResidualActions L []
  | singleton (x : SplitVertex V) : OrderedResidualActions L [x]
  | cons {x y : SplitVertex V} {q : List (SplitVertex V)}
      (action : ResidualAction V)
      (hvalid : residualActionValid G L action)
      (htail : residualActionTail action = x)
      (hhead : residualActionHead action = y)
      (hstep : residualStep G L x y)
      (rest : OrderedResidualActions L (y :: q)) :
      OrderedResidualActions L (x :: y :: q)

def OrderedResidualActions.actions {A B : Finset V} {m : Nat}
    {L : ABLinkageData G A B m} {q : List (SplitVertex V)} :
    OrderedResidualActions G L q → List (ResidualAction V)
  | .nil => []
  | .singleton _ => []
  | .cons action _ _ _ _ rest => action :: rest.actions

theorem OrderedResidualActions.actions_length {A B : Finset V} {m : Nat}
    {L : ABLinkageData G A B m} {q : List (SplitVertex V)}
    (actions : OrderedResidualActions G L q) :
    (OrderedResidualActions.actions G actions).length = q.length - 1 := by
  induction actions with
  | nil => simp [OrderedResidualActions.actions]
  | singleton => simp [OrderedResidualActions.actions]
  | cons _ _ _ _ _ rest ih =>
      simp [OrderedResidualActions.actions, ih]

/-- The heads of the ordered actions are exactly the trace vertices after its
first vertex. -/
private theorem OrderedResidualActions.map_action_heads {A B : Finset V} {m : Nat}
    {L : ABLinkageData G A B m} {q : List (SplitVertex V)}
    (ordered : OrderedResidualActions G L q) :
    (OrderedResidualActions.actions G ordered).map residualActionHead = q.tail := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions]
  | singleton => simp [OrderedResidualActions.actions]
  | cons action hvalid htail hhead hstep rest ih =>
      simp [OrderedResidualActions.actions, hhead, ih]

/-- Distinct ordered residual actions have distinct split-vertex heads on a
simple trace. -/
private theorem ordered_action_heads_nodup {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (hnodup : q.Nodup) (ordered : OrderedResidualActions G L q) :
    ((OrderedResidualActions.actions G ordered).map residualActionHead).Nodup := by
  rw [OrderedResidualActions.map_action_heads]
  exact hnodup.tail

/-- The tails of ordered actions are exactly the trace vertices before its
final vertex. -/
private theorem OrderedResidualActions.map_action_tails {A B : Finset V} {m : Nat}
    {L : ABLinkageData G A B m} {q : List (SplitVertex V)}
    (ordered : OrderedResidualActions G L q) :
    (OrderedResidualActions.actions G ordered).map residualActionTail =
      q.take (q.length - 1) := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions]
  | singleton => simp [OrderedResidualActions.actions]
  | cons action hvalid htail hhead hstep rest ih =>
      simp [OrderedResidualActions.actions, htail, ih]

/-- Distinct ordered residual actions have distinct split-vertex tails on a
simple trace. -/
private theorem ordered_action_tails_nodup {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (hnodup : q.Nodup) (ordered : OrderedResidualActions G L q) :
    ((OrderedResidualActions.actions G ordered).map residualActionTail).Nodup := by
  rw [OrderedResidualActions.map_action_tails]
  exact hnodup.take

/-- An action whose tail is not the first vertex of an aligned trace has an
immediately preceding ordered action ending at that tail. -/
private theorem ordered_action_has_predecessor {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (ordered : OrderedResidualActions G L q) {root : SplitVertex V}
    (hroot : q.head? = some root) {action : ResidualAction V}
    (hmem : action ∈ OrderedResidualActions.actions G ordered)
    (hne : residualActionTail action ≠ root) :
    ∃ prev ∈ OrderedResidualActions.actions G ordered,
      residualActionHead prev = residualActionTail action := by
  induction ordered generalizing root action with
  | nil => simp [OrderedResidualActions.actions] at hmem
  | singleton => simp [OrderedResidualActions.actions] at hmem
  | @cons x y q current hvalid htail hhead hstep rest ih =>
      simp only [OrderedResidualActions.actions, List.mem_cons] at hmem
      rcases hmem with rfl | hmem
      · exfalso
        apply hne
        rw [htail]
        simpa using hroot
      · by_cases htailAction : residualActionTail action = y
        · exact ⟨current, List.mem_cons_self, hhead.trans htailAction.symm⟩
        · obtain ⟨prev, hprev, hprevHead⟩ :=
            ih (root := y) (action := action) (by simp) hmem htailAction
          exact ⟨prev, List.mem_cons_of_mem _ hprev, hprevHead⟩

/-- An action whose head is not the final vertex of an aligned trace has an
immediately following ordered action beginning at that head. -/
private theorem ordered_action_has_successor {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (ordered : OrderedResidualActions G L q) {last : SplitVertex V}
    (hlast : q.getLast? = some last) {action : ResidualAction V}
    (hmem : action ∈ OrderedResidualActions.actions G ordered)
    (hne : residualActionHead action ≠ last) :
    ∃ next ∈ OrderedResidualActions.actions G ordered,
      residualActionTail next = residualActionHead action := by
  induction ordered generalizing last action with
  | nil => simp [OrderedResidualActions.actions] at hmem
  | singleton => simp [OrderedResidualActions.actions] at hmem
  | @cons x y q current hvalid htail hhead hstep rest ih =>
      simp only [OrderedResidualActions.actions, List.mem_cons] at hmem
      rcases hmem with rfl | hmem
      · cases q with
        | nil =>
            cases rest with
            | singleton =>
                exfalso
                apply hne
                rw [hhead]
                simpa using hlast
        | cons z q =>
            cases rest with
            | cons next hvalid' htail' hhead' hstep' rest' =>
                exact ⟨next, List.mem_cons_of_mem _ List.mem_cons_self,
                  htail'.trans hhead.symm⟩
      · obtain ⟨next, hnext, hnextTail⟩ :=
          ih (last := last) (action := action) (by simpa using hlast) hmem hne
        exact ⟨next, List.mem_cons_of_mem _ hnext, hnextTail⟩

/-- A simple residual trace cannot both add a graph arc into `v` and remove
the split-capacity arc of `v`: those actions would have the same trace head. -/
private theorem simple_trace_no_add_graphArc_remove_head_vertexArc {A B : Finset V}
    {m : Nat} (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (hnodup : q.Nodup) (ordered : OrderedResidualActions G L q) {u v : V}
    (hadd : ResidualAction.add (.graphArc u v) ∈
      OrderedResidualActions.actions G ordered)
    (hremove : ResidualAction.remove (.vertexArc v) ∈
      OrderedResidualActions.actions G ordered) : False := by
  have heq : ResidualAction.add (.graphArc u v) =
      ResidualAction.remove (.vertexArc v) :=
    List.inj_on_of_nodup_map (ordered_action_heads_nodup G L hnodup ordered)
      hadd hremove (by simp [residualActionHead, splitArcHead, splitArcTail])
  cases heq

/-- A simple residual trace cannot both add a graph arc out of `u` and remove
the split-capacity arc of `u`: those actions have the same trace tail. -/
private theorem simple_trace_no_add_graphArc_remove_tail_vertexArc {A B : Finset V}
    {m : Nat} (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (hnodup : q.Nodup) (ordered : OrderedResidualActions G L q) {u v : V}
    (hadd : ResidualAction.add (.graphArc u v) ∈
      OrderedResidualActions.actions G ordered)
    (hremove : ResidualAction.remove (.vertexArc u) ∈
      OrderedResidualActions.actions G ordered) : False := by
  have heq : ResidualAction.add (.graphArc u v) =
      ResidualAction.remove (.vertexArc u) :=
    List.inj_on_of_nodup_map (ordered_action_tails_nodup G L hnodup ordered)
      hadd hremove (by simp [residualActionTail, splitArcTail, splitArcHead])
  cases heq

/-- Extract a valid, ordered residual action for every adjacent pair in a
finite residual chain. -/
theorem simple_trace_actions {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) :
    ∀ (q : List (SplitVertex V)), q.Chain' (residualStep G L) →
      Nonempty (OrderedResidualActions G L q)
  | [], _ => ⟨.nil⟩
  | [x], _ => ⟨.singleton x⟩
  | x :: y :: q, h => by
      obtain ⟨action, htail, hhead, hvalid⟩ := residualStep_to_action G L h.rel_head
      obtain ⟨rest⟩ := simple_trace_actions L (y :: q) h.tail
      exact ⟨.cons action hvalid htail hhead h.rel_head rest⟩

/-- A directed dart of a simple path cannot enter that path's source. -/
private theorem dart_snd_ne_source_of_isPath {u v : V} {p : G.Walk u v}
    (hp : p.IsPath) {d : G.Dart} (hd : d ∈ p.darts) : d.snd ≠ u := by
  have htail : d.snd ∈ p.support.tail := by
    rw [← p.map_snd_darts]
    exact List.mem_map_of_mem hd
  have hnodup := hp.support_nodup
  rw [p.support_eq_cons, List.nodup_cons] at hnodup
  intro h
  rw [h] at htail
  exact hnodup.1 htail

/-- Full support disjointness makes the linkage path containing a vertex
unique. -/
private theorem linkage_index_unique_of_used {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {i j : Fin m} {v : V}
    (hi : v ∈ ((L.path i : G.Walk (L.src i) (L.dst i)).support))
    (hj : v ∈ ((L.path j : G.Walk (L.src j) (L.dst j)).support)) : i = j := by
  by_contra hij
  exact Set.disjoint_left.mp (L.disjoint_support hij) hi hj

/-- Along a simple path, a dart destination determines its dart and hence its
predecessor. -/
private theorem dart_fst_eq_of_isPath_same_snd {u v : V} {p : G.Walk u v}
    (hp : p.IsPath) {d e : G.Dart} (hd : d ∈ p.darts) (he : e ∈ p.darts)
    (hsnd : d.snd = e.snd) : d.fst = e.fst := by
  have hnodup : (p.darts.map fun d : G.Dart => d.snd).Nodup := by
    rw [p.map_snd_darts]
    exact hp.support_nodup.tail
  have hde : d = e :=
    List.inj_on_of_nodup_map hnodup hd he hsnd
  rw [hde]

/-- Along a simple path, a dart source determines its dart and hence its
successor. -/
private theorem dart_snd_eq_of_isPath_same_fst {u v : V} {p : G.Walk u v}
    (hp : p.IsPath) {d e : G.Dart} (hd : d ∈ p.darts) (he : e ∈ p.darts)
    (hfst : d.fst = e.fst) : d.snd = e.snd := by
  have hnodup : (p.darts.map fun d : G.Dart => d.fst).Nodup := by
    rw [p.map_fst_darts]
    exact List.Nodup.sublist (List.dropLast_sublist _) hp.support_nodup
  have hde : d = e := List.inj_on_of_nodup_map hnodup hd he hfst
  rw [hde]

/-- A linkage-used vertex has only one selected directed predecessor. -/
private theorem linkageUsedDart_predecessor_unique {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {u u' v : V}
    (h₁ : linkageUsedDart G L u v) (h₂ : linkageUsedDart G L u' v) : u = u' := by
  rcases h₁ with ⟨i, d, hd, hdfst, hdsnd⟩
  rcases h₂ with ⟨j, e, he, hefst, hesnd⟩
  have hvi : v ∈ ((L.path i : G.Walk (L.src i) (L.dst i)).support) := by
    rw [← hdsnd]
    exact ((L.path i : G.Walk (L.src i) (L.dst i)).dart_snd_mem_support_of_mem_darts hd)
  have hvj : v ∈ ((L.path j : G.Walk (L.src j) (L.dst j)).support) := by
    rw [← hesnd]
    exact ((L.path j : G.Walk (L.src j) (L.dst j)).dart_snd_mem_support_of_mem_darts he)
  have hij : i = j := linkage_index_unique_of_used G L hvi hvj
  subst j
  have hfst : d.fst = e.fst := dart_fst_eq_of_isPath_same_snd G (L.path i).property hd he
    (hdsnd.trans hesnd.symm)
  exact hdfst.symm.trans (hfst.trans hefst)

/-- A linkage-used vertex has only one selected directed successor. -/
private theorem linkageUsedDart_successor_unique {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {u v v' : V}
    (h₁ : linkageUsedDart G L u v) (h₂ : linkageUsedDart G L u v') : v = v' := by
  rcases h₁ with ⟨i, d, hd, hdfst, hdsnd⟩
  rcases h₂ with ⟨j, e, he, hefst, hesnd⟩
  have hui : u ∈ ((L.path i : G.Walk (L.src i) (L.dst i)).support) := by
    rw [← hdfst]
    exact (L.path i : G.Walk (L.src i) (L.dst i)).dart_fst_mem_support_of_mem_darts hd
  have huj : u ∈ ((L.path j : G.Walk (L.src j) (L.dst j)).support) := by
    rw [← hefst]
    exact (L.path j : G.Walk (L.src j) (L.dst j)).dart_fst_mem_support_of_mem_darts he
  have hij : i = j := linkage_index_unique_of_used G L hui huj
  subst j
  have hsnd : d.snd = e.snd := dart_snd_eq_of_isPath_same_fst G (L.path i).property hd he
    (hdfst.trans hefst.symm)
  exact hdsnd.symm.trans (hsnd.trans hesnd)

/-- An occupied linkage vertex either is the selected source endpoint of its
path or receives a selected graph dart. -/
private theorem linkageUsedVertex_source_or_predecessor {A B : Finset V}
    {m : Nat} (L : ABLinkageData G A B m) {v : V}
    (hused : linkageUsedVertex G L v) :
    linkageUsedSource G L v ∨ ∃ u, linkageUsedDart G L u v := by
  rcases hused with ⟨i, hv⟩
  rw [← (L.path i : G.Walk (L.src i) (L.dst i)).cons_map_snd_darts] at hv
  simp only [List.mem_cons, List.mem_map] at hv
  rcases hv with hsrc | ⟨d, hd, hsnd⟩
  · exact Or.inl ⟨i, hsrc.symm⟩
  · exact Or.inr ⟨d.fst, i, d, hd, rfl, hsnd⟩

/-- An occupied linkage vertex either is the selected sink endpoint of its
path or emits a selected graph dart. -/
private theorem linkageUsedVertex_sink_or_successor {A B : Finset V}
    {m : Nat} (L : ABLinkageData G A B m) {v : V}
    (hused : linkageUsedVertex G L v) :
    linkageUsedSink G L v ∨ ∃ w, linkageUsedDart G L v w := by
  rcases hused with ⟨i, hv⟩
  rw [← (L.path i : G.Walk (L.src i) (L.dst i)).map_fst_darts_append] at hv
  simp only [List.mem_append, List.mem_map, List.mem_singleton] at hv
  rcases hv with ⟨d, hd, hfst⟩ | hdst
  · exact Or.inr ⟨d.snd, i, d, hd, hfst, rfl⟩
  · exact Or.inl ⟨i, hdst.symm⟩

/-- A selected dart cannot enter a vertex that is the selected source of a
linkage path. -/
private theorem linkageUsedDart_snd_not_usedSource {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {u v : V}
    (hdart : linkageUsedDart G L u v) (hsource : linkageUsedSource G L v) : False := by
  rcases hdart with ⟨i, d, hd, hfst, hsnd⟩
  rcases hsource with ⟨j, hsrc⟩
  have hvi : v ∈ ((L.path i : G.Walk (L.src i) (L.dst i)).support) := by
    rw [← hsnd]
    exact (L.path i : G.Walk (L.src i) (L.dst i)).dart_snd_mem_support_of_mem_darts hd
  have hvj : v ∈ ((L.path j : G.Walk (L.src j) (L.dst j)).support) := by
    rw [← hsrc]
    exact (L.path j : G.Walk (L.src j) (L.dst j)).start_mem_support
  have hij : i = j := linkage_index_unique_of_used G L hvi hvj
  subst j
  rw [← hsrc] at hsnd
  exact dart_snd_ne_source_of_isPath G (L.path i).property hd hsnd

/-- A selected dart cannot leave a vertex that is the selected sink of a
linkage path. -/
private theorem linkageUsedDart_fst_not_usedSink {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {u v : V}
    (hdart : linkageUsedDart G L u v) (hsink : linkageUsedSink G L u) : False := by
  rcases hdart with ⟨i, d, hd, hfst, hsnd⟩
  rcases hsink with ⟨j, hdst⟩
  have hui : u ∈ ((L.path i : G.Walk (L.src i) (L.dst i)).support) := by
    rw [← hfst]
    exact (L.path i : G.Walk (L.src i) (L.dst i)).dart_fst_mem_support_of_mem_darts hd
  have huj : u ∈ ((L.path j : G.Walk (L.src j) (L.dst j)).support) := by
    rw [← hdst]
    exact (L.path j : G.Walk (L.src j) (L.dst j)).end_mem_support
  have hij : i = j := linkage_index_unique_of_used G L hui huj
  subst j
  have hrev : d.symm ∈ (L.path i : G.Walk (L.src i) (L.dst i)).reverse.darts := by
    simpa using hd
  rw [← hdst] at hfst
  exact dart_snd_ne_source_of_isPath G (L.path i).property.reverse hrev hfst

/-- Once a residual trace enters the head of a selected dart, its only
possible next residual step is the reverse of that selected dart. -/
private theorem residual_successor_from_used_dart_head [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) {u v : V}
    (hused : linkageUsedDart G L u v) {z : SplitVertex V}
    (hstep : residualStep G L (.vin v) z) : z = .vout u := by
  rcases hstep with h | h | h | h | h | h | h | h
  · rcases h with ⟨a, ha, hunused, hx, hy⟩
    cases hx
  · rcases h with ⟨a, hsource, hx, hy⟩
    cases hx
    rcases hused with ⟨i, d, hd, hdfst, hdsnd⟩
    rcases hsource with ⟨j, hsrc⟩
    have hvi : v ∈ ((L.path i : G.Walk (L.src i) (L.dst i)).support) := by
      rw [← hdsnd]
      exact ((L.path i : G.Walk (L.src i) (L.dst i)).dart_snd_mem_support_of_mem_darts hd)
    have hvj : v ∈ ((L.path j : G.Walk (L.src j) (L.dst j)).support) := by
      rw [← hsrc]
      exact (L.path j : G.Walk (L.src j) (L.dst j)).start_mem_support
    have hij : i = j := linkage_index_unique_of_used G L hvi hvj
    subst j
    rw [← hsrc] at hdsnd
    exact (dart_snd_ne_source_of_isPath G (L.path i).property hd hdsnd).elim
  · rcases h with ⟨w, hunused, hx, hy⟩
    cases hx
    exfalso
    apply hunused
    rcases hused with ⟨i, d, hd, hdfst, hdsnd⟩
    refine ⟨i, ?_⟩
    rw [← hdsnd]
    exact (L.path i : G.Walk (L.src i) (L.dst i)).dart_snd_mem_support_of_mem_darts hd
  · rcases h with ⟨w, hw, hx, hy⟩
    cases hx
  · rcases h with ⟨w, w', hadj, hx, hy⟩
    cases hx
  · rcases h with ⟨w, w', hpred, hx, hy⟩
    cases hx
    rw [linkageUsedDart_predecessor_unique G L hused hpred]
    exact hy
  · rcases h with ⟨b, hb, hunused, hx, hy⟩
    cases hx
  · rcases h with ⟨b, hb, hx, hy⟩
    cases hx

/-- At an unused split vertex, the only possible outgoing residual step is
the forward split-capacity arc. -/
private theorem residual_successor_from_unused_vertex [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) {v : V}
    (hunused : ¬ linkageUsedVertex G L v) {z : SplitVertex V}
    (hstep : residualStep G L (.vin v) z) : z = .vout v := by
  rcases hstep with h | h | h | h | h | h | h | h
  · rcases h with ⟨a, ha, hsource, hx, hy⟩
    cases hx
  · rcases h with ⟨a, hsource, hx, hy⟩
    cases hx
    apply (hunused ?_).elim
    rcases hsource with ⟨i, hsrc⟩
    refine ⟨i, ?_⟩
    rw [← hsrc]
    exact (L.path i : G.Walk (L.src i) (L.dst i)).start_mem_support
  · rcases h with ⟨w, hw, hx, hy⟩
    cases hx
    simpa using hy
  · rcases h with ⟨w, hw, hx, hy⟩
    cases hx
  · rcases h with ⟨u, w, hadj, hx, hy⟩
    cases hx
  · rcases h with ⟨u, w, hused, hx, hy⟩
    cases hx
    exfalso
    apply hunused
    rcases hused with ⟨i, d, hd, hfst, hsnd⟩
    refine ⟨i, ?_⟩
    rw [← hsnd]
    exact (L.path i : G.Walk (L.src i) (L.dst i)).dart_snd_mem_support_of_mem_darts hd
  · rcases h with ⟨b, hb, hsink, hx, hy⟩
    cases hx
  · rcases h with ⟨b, hsink, hx, hy⟩
    cases hx

/-- A valid residual action from `.vin v` to `.vout v` at an unused vertex is
the forward split-capacity addition. -/
private theorem residualAction_eq_add_vertexArc_of_endpoints
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {action : ResidualAction V} {v : V}
    (hvalid : residualActionValid G L action)
    (htail : residualActionTail action = .vin v)
    (hhead : residualActionHead action = .vout v)
    (hunused : ¬ linkageUsedVertex G L v) :
    action = .add (.vertexArc v) := by
  cases action with
  | add e =>
      cases e with
      | sourceArc a => cases htail
      | vertexArc w =>
          have hw : w = v := SplitVertex.vin.inj (by
            simpa [residualActionTail, splitArcTail] using htail)
          subst w
          rfl
      | graphArc u w => cases htail
      | sinkArc b => cases htail
  | remove e =>
      cases e with
      | sourceArc a => cases hhead
      | vertexArc w => cases htail
      | graphArc u w =>
          have hw : w = v := SplitVertex.vin.inj (by
            simpa [residualActionTail, splitArcHead] using htail)
          subst w
          apply (hunused ?_).elim
          rcases hvalid with ⟨i, d, hd, hfst, hsnd⟩
          refine ⟨i, ?_⟩
          rw [← hsnd]
          exact (L.path i : G.Walk (L.src i) (L.dst i)).dart_snd_mem_support_of_mem_darts hd
      | sinkArc b => cases htail

/-- An added graph arc entering an originally unused vertex is followed by
the addition of that vertex's split-capacity arc. -/
private theorem add_graphArc_into_unused_forces_add_vertexArc [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u v : V}
    (hadd : ResidualAction.add (.graphArc u v) ∈
      OrderedResidualActions.actions G ordered)
    (hunused : ¬ linkageUsedVertex G L v) :
    ResidualAction.add (.vertexArc v) ∈ OrderedResidualActions.actions G ordered := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions] at hadd
  | singleton => simp [OrderedResidualActions.actions] at hadd
  | @cons x y q current hvalid htail hhead hstep rest ih =>
      simp only [OrderedResidualActions.actions, List.mem_cons] at hadd
      rcases hadd with hcurrent | hadd
      · subst current
        have hy : y = .vin v := by simpa [residualActionHead, splitArcHead] using hhead.symm
        cases q with
        | nil =>
            simp at hlast
            cases hlast.symm.trans hy
        | cons z q =>
            cases rest with
            | cons next hvalid' htail' hhead' hstep' rest' =>
                have hz : z = .vout v := residual_successor_from_unused_vertex G L hunused (by
                  rw [← hy]
                  exact hstep')
                have hnext : next = ResidualAction.add (.vertexArc v) :=
                  residualAction_eq_add_vertexArc_of_endpoints G L hvalid'
                    (by rw [htail', hy]) (by rw [hhead', hz]) hunused
                subst next
                simp [OrderedResidualActions.actions]
      · exact List.mem_cons_of_mem _ (ih (by simpa using hlast) hadd)
/-- The endpoints of a residual action from `.vin v` to `.vout u` determine
the reverse of the selected dart `u → v`. -/
private theorem residualAction_eq_remove_graphArc_of_endpoints
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {action : ResidualAction V} {u v : V}
    (htail : residualActionTail action = .vin v)
    (hhead : residualActionHead action = .vout u)
    (hused : linkageUsedDart G L u v) :
    action = .remove (.graphArc u v) := by
  cases action with
  | add e =>
      cases e with
      | sourceArc a => cases htail
      | vertexArc w =>
          have hwv : w = v := SplitVertex.vin.inj (by
            simpa [residualActionTail, splitArcTail] using htail)
          have hwu : w = u := SplitVertex.vout.inj (by
            simpa [residualActionHead, splitArcHead] using hhead)
          rcases hused with ⟨i, d, hd, hfst, hsnd⟩
          have hne : u ≠ v := by
            rw [← hfst, ← hsnd]
            exact d.fst_ne_snd
          exact (hne (hwu.symm.trans hwv)).elim
      | graphArc w w' => cases htail
      | sinkArc b => cases htail
  | remove e =>
      cases e with
      | sourceArc a => cases hhead
      | vertexArc w => cases htail
      | graphArc w w' =>
          have hw' : w' = v := SplitVertex.vin.inj (by
            simpa [residualActionTail, splitArcHead] using htail)
          have hw : w = u := SplitVertex.vout.inj (by
            simpa [residualActionHead, splitArcTail] using hhead)
          subst w
          subst w'
          rfl
      | sinkArc b => cases htail

/-- Removing the split-capacity arc of the head of a selected dart forces the
next residual action to remove that selected dart. -/
private theorem remove_vertexArc_forces_remove_predecessor_graphArc [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u v : V}
    (hused : linkageUsedDart G L u v)
    (hremove : ResidualAction.remove (.vertexArc v) ∈
      OrderedResidualActions.actions G ordered) :
    ResidualAction.remove (.graphArc u v) ∈
      OrderedResidualActions.actions G ordered := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions] at hremove
  | singleton => simp [OrderedResidualActions.actions] at hremove
  | @cons x y q current hvalid htail hhead hstep rest ih =>
      simp only [OrderedResidualActions.actions, List.mem_cons] at hremove
      rcases hremove with hcurrent | hremove
      · subst current
        have hy : y = .vin v := by simpa [residualActionHead, splitArcTail] using hhead.symm
        cases q with
        | nil =>
            simp at hlast
            cases hlast.symm.trans hy
        | cons z q =>
            cases rest with
            | cons next hvalid' htail' hhead' hstep' rest' =>
                have hz : z = .vout u := residual_successor_from_used_dart_head G L hused (by
                  rw [← hy]
                  exact hstep')
                have hnext : next = ResidualAction.remove (.graphArc u v) :=
                  residualAction_eq_remove_graphArc_of_endpoints G L
                    (by rw [htail', hy]) (by rw [hhead', hz]) hused
                subst next
                simp [OrderedResidualActions.actions]
      · exact List.mem_cons_of_mem _ (ih (by simpa using hlast) hremove)

/-- A forward graph action on a simple residual source-to-sink trace cannot
already be selected by the linkage. -/
private theorem simple_trace_add_graphArc_unused [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {u v : V}
    (hmem : ResidualAction.add (.graphArc u v) ∈
      OrderedResidualActions.actions G ordered) :
    ¬ linkageUsedDart G L u v := by
  induction ordered generalizing u v with
  | nil => simp [OrderedResidualActions.actions] at hmem
  | singleton => simp [OrderedResidualActions.actions] at hmem
  | @cons x y q action hvalid htail hhead hstep rest ih =>
      simp only [OrderedResidualActions.actions, List.mem_cons] at hmem
      rcases hmem with hcurrent | hmem
      · subst action
        have hx : x = .vout u := by simpa using htail.symm
        have hy : y = .vin v := by simpa using hhead.symm
        subst x
        subst y
        intro hused
        cases q with
        | nil =>
            cases rest with
            | singleton =>
                simp [residualActionHead] at hlast
                cases hlast
        | cons z q =>
            cases rest with
            | cons action' hvalid' htail' hhead' hstep' rest' =>
                have hz : z = .vout u :=
                  residual_successor_from_used_dart_head G L hused hstep'
                subst z
                rw [List.nodup_cons] at hnodup
                apply hnodup.1
                rw [hx, ← hz]
                exact List.mem_cons_of_mem _ List.mem_cons_self
      · apply ih
        · exact hnodup.tail
        · simpa using hlast
        · exact hchain.tail
        · exact hmem

/-- Every action retained in an ordered residual trace carries the validity
witness supplied by its originating residual step. -/
private theorem ordered_action_valid {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (ordered : OrderedResidualActions G L q) {action : ResidualAction V}
    (hmem : action ∈ OrderedResidualActions.actions G ordered) :
    residualActionValid G L action := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions] at hmem
  | singleton => simp [OrderedResidualActions.actions] at hmem
  | cons current hvalid htail hhead hstep rest ih =>
      simp only [OrderedResidualActions.actions, List.mem_cons] at hmem
      rcases hmem with rfl | hmem
      · exact hvalid
      · exact ih hmem

/-- Every retained ordered action carries its original residual transition. -/
private theorem ordered_action_step {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (ordered : OrderedResidualActions G L q) {action : ResidualAction V}
    (hmem : action ∈ OrderedResidualActions.actions G ordered) :
    residualStep G L (residualActionTail action) (residualActionHead action) := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions] at hmem
  | singleton => simp [OrderedResidualActions.actions] at hmem
  | cons current hvalid htail hhead hstep rest ih =>
      simp only [OrderedResidualActions.actions, List.mem_cons] at hmem
      rcases hmem with rfl | hmem
      · simpa [htail, hhead] using hstep
      · exact ih hmem

/-- The head of every selected action occurs in its aligned split-vertex
trace. -/
private theorem ordered_action_head_mem {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (ordered : OrderedResidualActions G L q) {action : ResidualAction V}
    (hmem : action ∈ OrderedResidualActions.actions G ordered) :
    residualActionHead action ∈ q := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions] at hmem
  | singleton => simp [OrderedResidualActions.actions] at hmem
  | cons current hvalid htail hhead hstep rest ih =>
      simp only [OrderedResidualActions.actions, List.mem_cons] at hmem
      rcases hmem with rfl | hmem
      · rw [hhead]
        exact List.mem_cons_of_mem _ List.mem_cons_self
      · exact List.mem_cons_of_mem _ (ih hmem)

/-- The tail of every selected action occurs in its aligned split-vertex
trace. -/
private theorem ordered_action_tail_mem {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (ordered : OrderedResidualActions G L q) {action : ResidualAction V}
    (hmem : action ∈ OrderedResidualActions.actions G ordered) :
    residualActionTail action ∈ q := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions] at hmem
  | singleton => simp [OrderedResidualActions.actions] at hmem
  | cons current hvalid htail hhead hstep rest ih =>
      simp only [OrderedResidualActions.actions, List.mem_cons] at hmem
      rcases hmem with rfl | hmem
      · rw [htail]
        exact List.mem_cons_self
      · exact List.mem_cons_of_mem _ (ih hmem)

/-- The head of an action lies after the first vertex of its aligned trace. -/
private theorem ordered_action_head_mem_tail {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (ordered : OrderedResidualActions G L q) {action : ResidualAction V}
    (hmem : action ∈ OrderedResidualActions.actions G ordered) :
    residualActionHead action ∈ q.tail := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions] at hmem
  | singleton => simp [OrderedResidualActions.actions] at hmem
  | cons current hvalid htail hhead hstep rest ih =>
      simp only [OrderedResidualActions.actions, List.mem_cons] at hmem
      rcases hmem with rfl | hmem
      · simp [hhead]
      · exact List.mem_cons_of_mem _ (ih hmem)

/-- A nodup split-vertex trace records no residual action twice. -/
private theorem ordered_actions_nodup {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (hnodup : q.Nodup) (ordered : OrderedResidualActions G L q) :
    (OrderedResidualActions.actions G ordered).Nodup := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions]
  | singleton => simp [OrderedResidualActions.actions]
  | @cons x y q current hvalid htail hhead hstep rest ih =>
      change (current :: OrderedResidualActions.actions G rest).Nodup
      rw [List.nodup_cons] at hnodup ⊢
      refine ⟨?_, ih hnodup.2⟩
      intro hmem
      apply hnodup.1
      rw [← htail]
      exact ordered_action_tail_mem G L rest hmem

/-- A nodup residual trace cannot traverse one split arc in both directions:
the second traversal would return to one of the two split vertices of the
first. -/
private theorem simple_trace_no_opposite_actions {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (hnodup : q.Nodup) (ordered : OrderedResidualActions G L q)
    (e : SplitArc V) :
    ¬ (ResidualAction.add e ∈ OrderedResidualActions.actions G ordered ∧
      ResidualAction.remove e ∈ OrderedResidualActions.actions G ordered) := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions]
  | singleton => simp [OrderedResidualActions.actions]
  | @cons x y q current hvalid htail hhead hstep rest ih =>
      intro hboth
      simp only [OrderedResidualActions.actions, List.mem_cons] at hboth
      rcases hboth with ⟨hadd | hadd, hremove | hremove⟩
      · subst current
        cases hremove
      · subst current
        rw [List.nodup_cons] at hnodup
        apply hnodup.1
        rw [← htail]
        simpa [residualActionHead] using
          (ordered_action_head_mem G L rest hremove)
      · subst current
        rw [List.nodup_cons] at hnodup
        apply hnodup.1
        rw [← htail]
        simpa [residualActionHead] using
          (ordered_action_head_mem G L rest hadd)
      · exact ih hnodup.tail ⟨hadd, hremove⟩

/-- A nodup trace rooted at the artificial source never removes a selected
source arc, because that would revisit its initial split vertex. -/
private theorem simple_trace_no_remove_source {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (hnodup : q.Nodup) (hhead : q.head? = some .source)
    (ordered : OrderedResidualActions G L q) (a : V) :
    ResidualAction.remove (.sourceArc a) ∉ OrderedResidualActions.actions G ordered := by
  cases q with
  | nil => simp at hhead
  | cons x q =>
      simp only [List.head?_cons, Option.some.injEq] at hhead
      subst x
      rw [List.nodup_cons] at hnodup
      intro hremove
      apply hnodup.1
      simpa [residualActionHead, splitArcHead] using
        (ordered_action_head_mem_tail G L ordered hremove)

/-- An added split arc of a simple source-to-sink residual trace was absent
from the original linkage. -/
private theorem ordered_action_add_unused [DecidableEq V] {A B : Finset V}
    {m : Nat} (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (hnodup : q.Nodup) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {e : SplitArc V}
    (hmem : ResidualAction.add e ∈ OrderedResidualActions.actions G ordered) :
    ¬ linkageSplitArc G L e := by
  cases e with
  | sourceArc a =>
      exact ordered_action_valid G L ordered hmem
  | vertexArc v =>
      exact ordered_action_valid G L ordered hmem
  | graphArc u v =>
      exact simple_trace_add_graphArc_unused G L hnodup hlast hchain ordered hmem
  | sinkArc b =>
      exact ordered_action_valid G L ordered hmem

/-- A removed split arc of a simple residual trace belongs to the original
linkage. -/
private theorem ordered_action_remove_selected {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (ordered : OrderedResidualActions G L q) {e : SplitArc V}
    (hmem : ResidualAction.remove e ∈ OrderedResidualActions.actions G ordered) :
    linkageSplitArc G L e :=
  ordered_action_valid G L ordered hmem

/-- Boolean selected state obtained by toggling exactly the residual actions
of one simple augmentation trace. -/
def toggledSplitArc {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (actions : List (ResidualAction V))
    (e : SplitArc V) : Prop :=
  (linkageSplitArc G L e ∧ ResidualAction.remove e ∉ actions) ∨
    (¬ linkageSplitArc G L e ∧ ResidualAction.add e ∈ actions)

/-- An added arc is selected after toggling. -/
private theorem toggled_add {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (actions : List (ResidualAction V))
    {e : SplitArc V} (hunused : ¬ linkageSplitArc G L e)
    (hadd : ResidualAction.add e ∈ actions) :
    toggledSplitArc G L actions e :=
  Or.inr ⟨hunused, hadd⟩

/-- A removed arc is absent after toggling. -/
private theorem not_toggled_remove {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (actions : List (ResidualAction V))
    {e : SplitArc V} (hselected : linkageSplitArc G L e)
    (hremove : ResidualAction.remove e ∈ actions) :
    ¬ toggledSplitArc G L actions e := by
  rintro (⟨_, hnot⟩ | ⟨hnot, _⟩)
  · exact hnot hremove
  · exact hnot hselected

/-- An untouched arc retains exactly its original selected state. -/
private theorem toggled_unchanged {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (actions : List (ResidualAction V))
    {e : SplitArc V} (hadd : ResidualAction.add e ∉ actions)
    (hremove : ResidualAction.remove e ∉ actions) :
    toggledSplitArc G L actions e ↔ linkageSplitArc G L e := by
  constructor
  · rintro (⟨hselected, _⟩ | ⟨hnot, hmem⟩)
    · exact hselected
    · exact (hadd hmem).elim
  · intro hselected
    exact Or.inl ⟨hselected, hremove⟩

/-- Every dart selected by the original linkage follows an edge of `G`. -/
private theorem linkageUsedDart_adj {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {u v : V}
    (hused : linkageUsedDart G L u v) : G.Adj u v := by
  rcases hused with ⟨i, d, hd, hfst, hsnd⟩
  rw [← hfst, ← hsnd]
  exact d.adj

/-- Either endpoint of a selected graph dart is occupied by the linkage. -/
private theorem linkageUsedDart_fst_usedVertex {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {u v : V}
    (hused : linkageUsedDart G L u v) : linkageUsedVertex G L u := by
  rcases hused with ⟨i, d, hd, hfst, hsnd⟩
  refine ⟨i, ?_⟩
  rw [← hfst]
  exact (L.path i : G.Walk (L.src i) (L.dst i)).dart_fst_mem_support_of_mem_darts hd

private theorem linkageUsedDart_snd_usedVertex {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {u v : V}
    (hused : linkageUsedDart G L u v) : linkageUsedVertex G L v := by
  rcases hused with ⟨i, d, hd, hfst, hsnd⟩
  refine ⟨i, ?_⟩
  rw [← hsnd]
  exact (L.path i : G.Walk (L.src i) (L.dst i)).dart_snd_mem_support_of_mem_darts hd

/-- Toggling preserves the graph-edge meaning of every selected graph arc. -/
private theorem toggled_graphArc_adj [DecidableEq V] {A B : Finset V}
    {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (ordered : OrderedResidualActions G L q)
    {u v : V}
    (htoggled : toggledSplitArc G L (OrderedResidualActions.actions G ordered)
      (.graphArc u v)) :
    G.Adj u v := by
  rcases htoggled with ⟨hused, _⟩ | ⟨_, hadd⟩
  · exact linkageUsedDart_adj G L hused
  · exact ordered_action_valid G L ordered hadd

/-- The forward transition relation represented by a Boolean selected split
state. -/
def toggledSplitStep {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (actions : List (ResidualAction V))
    (x y : SplitVertex V) : Prop :=
  ∃ e : SplitArc V, toggledSplitArc G L actions e ∧
    splitArcTail e = x ∧ splitArcHead e = y

/-- For an originally selected arc, toggling is exactly removal-membership
complementation. -/
private theorem toggled_selected_iff {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (actions : List (ResidualAction V))
    {e : SplitArc V} (hselected : linkageSplitArc G L e) :
    toggledSplitArc G L actions e ↔ ResidualAction.remove e ∉ actions := by
  constructor
  · rintro (⟨_, hremove⟩ | ⟨hnot, _⟩)
    · exact hremove
    · exact (hnot hselected).elim
  · intro hremove
    exact Or.inl ⟨hselected, hremove⟩

/-- For an originally absent arc, toggling is exactly add-membership. -/
private theorem toggled_unselected_iff {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (actions : List (ResidualAction V))
    {e : SplitArc V} (hunused : ¬ linkageSplitArc G L e) :
    toggledSplitArc G L actions e ↔ ResidualAction.add e ∈ actions := by
  constructor
  · rintro (⟨hselected, _⟩ | ⟨_, hadd⟩)
    · exact (hunused hselected).elim
    · exact hadd
  · intro hadd
    exact Or.inr ⟨hunused, hadd⟩

/-- Along a simple source-to-sink trace, the Boolean toggle agrees with the
residual action at every add arc. -/
private theorem ordered_toggled_add [DecidableEq V] {A B : Finset V}
    {m : Nat} (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (hnodup : q.Nodup) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {e : SplitArc V}
    (hadd : ResidualAction.add e ∈ OrderedResidualActions.actions G ordered) :
    toggledSplitArc G L (OrderedResidualActions.actions G ordered) e :=
  toggled_add G L _ (ordered_action_add_unused G L hnodup hlast hchain ordered hadd) hadd

/-- Along a simple source-to-sink trace, the Boolean toggle deletes every
residually removed arc. -/
private theorem ordered_not_toggled_remove {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (ordered : OrderedResidualActions G L q) {e : SplitArc V}
    (hremove : ResidualAction.remove e ∈ OrderedResidualActions.actions G ordered) :
    ¬ toggledSplitArc G L (OrderedResidualActions.actions G ordered) e :=
  not_toggled_remove G L _ (ordered_action_remove_selected G L ordered hremove) hremove

/-- The first transition of a simple residual source-to-sink trace adds one
previously unused source arc. -/
private theorem simple_trace_starts_with_unused_source [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) :
    ∃ a : V, a ∈ A ∧ ¬ linkageUsedSource G L a ∧
      ResidualAction.add (.sourceArc a) ∈ OrderedResidualActions.actions G ordered := by
  cases q with
  | nil => simp at hhead
  | cons x q =>
      cases q with
      | nil =>
          simp at hhead hlast
          cases hhead.symm.trans hlast
      | cons y q =>
          simp only [List.head?_cons, Option.some.injEq] at hhead
          subst x
          rcases hchain.rel_head with h | h | h | h | h | h | h | h
          · rcases h with ⟨a, ha, hunused, hx, hy⟩
            cases hx
            have hy' : y = .vin a := hy
            subst y
            cases ordered with
            | cons action hvalid htail hactionHead hstep rest =>
                cases action with
                | add e =>
                    cases e with
                    | sourceArc a' =>
                        simp only [residualActionHead, splitArcHead] at hactionHead
                        have haa : a' = a := SplitVertex.vin.inj hactionHead
                        subst a'
                        exact ⟨a, ha, hunused, by simp [OrderedResidualActions.actions]⟩
                    | vertexArc v => cases htail
                    | graphArc u v => cases htail
                    | sinkArc b => cases htail
                | remove e =>
                    cases e <;> cases htail
          · rcases h with ⟨a, hused, hx, hy⟩
            cases hx
          · rcases h with ⟨v, hunused, hx, hy⟩
            cases hx
          · rcases h with ⟨v, hused, hx, hy⟩
            cases hx
          · rcases h with ⟨u, v, hadj, hx, hy⟩
            cases hx
          · rcases h with ⟨u, v, hused, hx, hy⟩
            cases hx
          · rcases h with ⟨b, hb, hunused, hx, hy⟩
            cases hx
          · rcases h with ⟨b, hused, hx, hy⟩
            cases hx

/-- The final transition of a nontrivial residual trace ending at the
artificial sink adds an unused sink arc. -/
private theorem simple_trace_ends_with_unused_sink [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q)
    (hactions : ∃ action, action ∈ OrderedResidualActions.actions G ordered) :
    ∃ b : V, b ∈ B ∧ ¬ linkageUsedSink G L b ∧
      ResidualAction.add (.sinkArc b) ∈ OrderedResidualActions.actions G ordered := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions] at hactions
  | singleton => simp [OrderedResidualActions.actions] at hactions
  | @cons x y q current hvalid htail hhead hstep rest ih =>
      cases q with
      | nil =>
          simp at hlast
          have hcurrentHead : residualActionHead current = .sink := hhead.trans hlast
          have hstepSink := hstep
          rw [hlast] at hstepSink
          cases current with
          | add e =>
              cases e with
              | sourceArc a => cases hcurrentHead
              | vertexArc v => cases hcurrentHead
              | graphArc u v => cases hcurrentHead
              | sinkArc b' =>
                  rcases hstepSink with h | h | h | h | h | h | h | h
                  · rcases h with ⟨a, ha, hunused, hx, hy⟩
                    cases hy
                  · rcases h with ⟨a, hused, hx, hy⟩
                    cases hy
                  · rcases h with ⟨v, hunused, hx, hy⟩
                    cases hy
                  · rcases h with ⟨v, hused, hx, hy⟩
                    cases hy
                  · rcases h with ⟨u, v, hadj, hx, hy⟩
                    cases hy
                  · rcases h with ⟨u, v, hused, hx, hy⟩
                    cases hy
                  · rcases h with ⟨b, hb, hunused, hx, hy⟩
                    have hbb : b' = b :=
                      SplitVertex.vout.inj (htail.trans hx)
                    subst b'
                    exact ⟨b, hb, hunused, by simp [OrderedResidualActions.actions]⟩
                  · rcases h with ⟨b, hused, hx, hy⟩
                    cases hy
          | remove e =>
              cases e <;> cases hcurrentHead
      | cons z q =>
          cases rest with
          | cons next hvalid' htail' hhead' hstep' rest' =>
              obtain ⟨b, hb, hunused, hmem⟩ :=
                ih (by simpa using hlast) hchain.tail
                  ⟨next, by simp [OrderedResidualActions.actions]⟩
              exact ⟨b, hb, hunused, List.mem_cons_of_mem _ hmem⟩

/-- Toggling a simple source-to-sink trace selects one previously unused
source arc and one previously unused sink arc. -/
private theorem simple_trace_toggle_boundary [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) :
    (∃ a : V, a ∈ A ∧ ¬ linkageUsedSource G L a ∧
      toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sourceArc a)) ∧
    (∃ b : V, b ∈ B ∧ ¬ linkageUsedSink G L b ∧
      toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sinkArc b)) := by
  obtain ⟨a, ha, haunused, hadd⟩ :=
    simple_trace_starts_with_unused_source G L hhead hlast hchain ordered
  obtain ⟨b, hb, hbunused, hremove⟩ :=
    simple_trace_ends_with_unused_sink G L hlast hchain ordered ⟨_, hadd⟩
  exact ⟨⟨a, ha, haunused,
      ordered_toggled_add G L hnodup hlast hchain ordered hadd⟩,
    ⟨b, hb, hbunused,
      ordered_toggled_add G L hnodup hlast hchain ordered hremove⟩⟩

/-- The finite set of source vertices selected by a linkage. -/
noncomputable def linkageSourceVertices [Fintype V] {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) : Finset V := by
  classical
  exact Finset.univ.filter (linkageUsedSource G L)

/-- The finite set of source vertices selected after Boolean toggling. -/
noncomputable def toggledSourceVertices [Fintype V] {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (actions : List (ResidualAction V)) : Finset V := by
  classical
  exact Finset.univ.filter fun a => toggledSplitArc G L actions (.sourceArc a)

/-- On a nodup trace rooted at the artificial source, every added source arc
is the first action and hence its endpoint is unique. -/
private theorem source_add_unique {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (hnodup : q.Nodup) (hhead : q.head? = some .source)
    (ordered : OrderedResidualActions G L q) {a a' : V}
    (ha : ResidualAction.add (.sourceArc a) ∈ OrderedResidualActions.actions G ordered)
    (ha' : ResidualAction.add (.sourceArc a') ∈ OrderedResidualActions.actions G ordered) :
    a = a' := by
  cases q with
  | nil => simp at hhead
  | cons x q =>
      cases q with
      | nil =>
          cases ordered with
          | singleton => simp [OrderedResidualActions.actions] at ha
      | cons y q =>
          simp only [List.head?_cons, Option.some.injEq] at hhead
          subst x
          rw [List.nodup_cons] at hnodup
          cases ordered with
          | cons current hvalid htail hactionHead hstep rest =>
              have first {b : V}
                  (hb : ResidualAction.add (.sourceArc b) ∈
                    OrderedResidualActions.actions G
                      (OrderedResidualActions.cons current hvalid htail hactionHead hstep rest)) :
                  current = ResidualAction.add (.sourceArc b) := by
                simp only [OrderedResidualActions.actions, List.mem_cons] at hb
                rcases hb with hb | hb
                · exact hb.symm
                · exfalso
                  apply hnodup.1
                  simpa [residualActionTail, splitArcTail] using
                    (ordered_action_tail_mem G L rest hb)
              have hcurrent : ResidualAction.add (.sourceArc a) =
                  ResidualAction.add (.sourceArc a') :=
                (first ha).symm.trans (first ha')
              exact SplitArc.sourceArc.inj (ResidualAction.add.inj hcurrent)

/-- Boolean toggling extends the original selected source vertices by exactly
the unique unused source selected by the first residual action. -/
private theorem toggledSourceVertices_eq_insert [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {newSource : V}
    (hadd : ResidualAction.add (.sourceArc newSource) ∈
      OrderedResidualActions.actions G ordered) :
    toggledSourceVertices G L (OrderedResidualActions.actions G ordered) =
      insert newSource (linkageSourceVertices G L) := by
  classical
  ext a
  simp only [toggledSourceVertices, linkageSourceVertices, Finset.mem_filter,
    Finset.mem_univ, true_and, Finset.mem_insert]
  constructor
  · rintro (⟨hselected, _⟩ | ⟨_, hadd'⟩)
    · exact Or.inr hselected
    · exact Or.inl (source_add_unique G L hnodup hhead ordered hadd' hadd)
  · rintro (rfl | hselected)
    · exact ordered_toggled_add G L hnodup hlast hchain ordered hadd
    · exact Or.inl ⟨hselected,
        simple_trace_no_remove_source G L hnodup hhead ordered _⟩

/-- The original selected source vertices are exactly the finite image of the
injective linkage source map. -/
private theorem linkageSourceVertices_eq_image [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) :
    linkageSourceVertices G L = (Finset.univ : Finset (Fin m)).image L.src := by
  classical
  ext a
  simp [linkageSourceVertices, linkageUsedSource]

/-- A linkage of value `m` has exactly `m` selected source vertices. -/
private theorem card_linkageSourceVertices [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) :
    (linkageSourceVertices G L).card = m := by
  rw [linkageSourceVertices_eq_image G L]
  simpa using Finset.card_image_of_injective (Finset.univ : Finset (Fin m))
    L.src_injective

/-- The new source selected by the first residual action did not belong to
the original linkage. -/
private theorem newSource_not_mem_linkageSourceVertices [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {newSource : V}
    (hadd : ResidualAction.add (.sourceArc newSource) ∈
      OrderedResidualActions.actions G ordered) :
    newSource ∉ linkageSourceVertices G L := by
  intro hmem
  apply ordered_action_add_unused G L hnodup hlast hchain ordered hadd
  simpa [linkageSourceVertices] using hmem

/-- The Boolean source state has one more selected source vertex than the
original linkage. -/
private theorem card_toggledSourceVertices [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {newSource : V}
    (hadd : ResidualAction.add (.sourceArc newSource) ∈
      OrderedResidualActions.actions G ordered) :
    (toggledSourceVertices G L (OrderedResidualActions.actions G ordered)).card = m + 1 := by
  rw [toggledSourceVertices_eq_insert G L hnodup hhead hlast hchain ordered hadd,
    Finset.card_insert_of_not_mem
      (newSource_not_mem_linkageSourceVertices G L hnodup hlast hchain ordered hadd),
    card_linkageSourceVertices G L]

/-- The finite set of sink vertices selected by a linkage. -/
noncomputable def linkageSinkVertices [Fintype V] {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) : Finset V := by
  classical
  exact Finset.univ.filter (linkageUsedSink G L)

/-- The finite set of sink vertices selected after Boolean toggling. -/
noncomputable def toggledSinkVertices [Fintype V] {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (actions : List (ResidualAction V)) : Finset V := by
  classical
  exact Finset.univ.filter fun b => toggledSplitArc G L actions (.sinkArc b)

/-- The original selected sink vertices are exactly the finite image of the
injective linkage destination map. -/
private theorem linkageSinkVertices_eq_image [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) :
    linkageSinkVertices G L = (Finset.univ : Finset (Fin m)).image L.dst := by
  classical
  ext b
  simp [linkageSinkVertices, linkageUsedSink]

/-- A linkage of value `m` has exactly `m` selected sink vertices. -/
private theorem card_linkageSinkVertices [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) :
    (linkageSinkVertices G L).card = m := by
  rw [linkageSinkVertices_eq_image G L]
  simpa using Finset.card_image_of_injective (Finset.univ : Finset (Fin m))
    L.dst_injective

/-- A nodup trace ending at the artificial sink never removes a selected sink
arc, because that would depart from the final split vertex earlier in the
trace. -/
private theorem simple_trace_no_remove_sink {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (hnodup : q.Nodup) (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) (b : V) :
    ResidualAction.remove (.sinkArc b) ∉ OrderedResidualActions.actions G ordered := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions]
  | singleton => simp [OrderedResidualActions.actions]
  | @cons x y q current hvalid htail hhead hstep rest ih =>
      simp only [OrderedResidualActions.actions, List.mem_cons]
      intro hmem
      rcases hmem with hcurrent | hmem
      · subst current
        rw [List.nodup_cons] at hnodup
        apply hnodup.1
        have hlastSuffix : (y :: q).getLast? = some .sink := by
          simpa using hlast
        obtain ⟨pre, hpre⟩ := List.getLast?_eq_some_iff.mp hlastSuffix
        have hmemSink : (.sink : SplitVertex V) ∈ y :: q := by
          rw [hpre]
          simp
        rw [← htail]
        simpa [residualActionTail, splitArcHead] using hmemSink
      · exact ih hnodup.tail (by simpa using hlast) hmem

/-- No action of a nodup source-to-sink residual trace can depart from its
final artificial sink. -/
private theorem simple_trace_action_tail_ne_sink {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (hnodup : q.Nodup) (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {action : ResidualAction V}
    (hmem : action ∈ OrderedResidualActions.actions G ordered) :
    residualActionTail action ≠ .sink := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions] at hmem
  | singleton => simp [OrderedResidualActions.actions] at hmem
  | @cons x y q current hvalid htail hhead hstep rest ih =>
      simp only [OrderedResidualActions.actions, List.mem_cons] at hmem
      rcases hmem with rfl | hmem
      · rw [List.nodup_cons] at hnodup
        intro htailSink
        apply hnodup.1
        rw [← htail, htailSink]
        obtain ⟨pre, hpre⟩ := List.getLast?_eq_some_iff.mp (by simpa using hlast)
        rw [hpre]
        simp
      · exact ih hnodup.tail (by simpa using hlast) hmem

/-- A nodup trace ending at the artificial sink adds at most one sink arc. -/
private theorem sink_add_unique {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (hnodup : q.Nodup) (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {b b' : V}
    (hb : ResidualAction.add (.sinkArc b) ∈ OrderedResidualActions.actions G ordered)
    (hb' : ResidualAction.add (.sinkArc b') ∈ OrderedResidualActions.actions G ordered) :
    b = b' := by
  induction ordered with
  | nil => simp [OrderedResidualActions.actions] at hb
  | singleton => simp [OrderedResidualActions.actions] at hb
  | @cons x y q current hvalid htail hhead hstep rest ih =>
      simp only [OrderedResidualActions.actions, List.mem_cons] at hb hb'
      rcases hb with hcurrent | hb <;> rcases hb' with hcurrent' | hb'
      · have hEq : ResidualAction.add (.sinkArc b) = ResidualAction.add (.sinkArc b') :=
          hcurrent.trans hcurrent'.symm
        exact SplitArc.sinkArc.inj (ResidualAction.add.inj hEq)
      · subst current
        rw [List.nodup_cons] at hnodup
        have hy : y = .sink := by simpa [residualActionHead, splitArcHead] using hhead.symm
        subst y
        exfalso
        apply (List.nodup_cons.mp hnodup.2).1
        simpa [residualActionHead, splitArcHead] using
          (ordered_action_head_mem_tail G L rest hb')
      · subst current
        rw [List.nodup_cons] at hnodup
        have hy : y = .sink := by simpa [residualActionHead, splitArcHead] using hhead.symm
        subst y
        exfalso
        apply (List.nodup_cons.mp hnodup.2).1
        simpa [residualActionHead, splitArcHead] using
          (ordered_action_head_mem_tail G L rest hb)
      · exact ih hnodup.tail (by simpa using hlast) hb hb'

/-- Boolean toggling extends the original selected sink vertices by exactly
the unique unused sink selected by the final residual action. -/
private theorem toggledSinkVertices_eq_insert [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {newSink : V}
    (hadd : ResidualAction.add (.sinkArc newSink) ∈
      OrderedResidualActions.actions G ordered) :
    toggledSinkVertices G L (OrderedResidualActions.actions G ordered) =
      insert newSink (linkageSinkVertices G L) := by
  classical
  ext b
  simp only [toggledSinkVertices, linkageSinkVertices, Finset.mem_filter,
    Finset.mem_univ, true_and, Finset.mem_insert]
  constructor
  · rintro (⟨hselected, _⟩ | ⟨_, hadd'⟩)
    · exact Or.inr hselected
    · exact Or.inl (sink_add_unique G L hnodup hlast ordered hadd' hadd)
  · rintro (rfl | hselected)
    · exact ordered_toggled_add G L hnodup hlast hchain ordered hadd
    · exact Or.inl ⟨hselected,
        simple_trace_no_remove_sink G L hnodup hlast ordered _⟩

/-- The new sink selected by the final residual action did not belong to the
original linkage. -/
private theorem newSink_not_mem_linkageSinkVertices [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {newSink : V}
    (hadd : ResidualAction.add (.sinkArc newSink) ∈
      OrderedResidualActions.actions G ordered) :
    newSink ∉ linkageSinkVertices G L := by
  intro hmem
  apply ordered_action_add_unused G L hnodup hlast hchain ordered hadd
  simpa [linkageSinkVertices] using hmem

/-- The Boolean sink state has one more selected sink vertex than the
original linkage. -/
private theorem card_toggledSinkVertices [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {newSink : V}
    (hadd : ResidualAction.add (.sinkArc newSink) ∈
      OrderedResidualActions.actions G ordered) :
    (toggledSinkVertices G L (OrderedResidualActions.actions G ordered)).card = m + 1 := by
  rw [toggledSinkVertices_eq_insert G L hnodup hlast hchain ordered hadd,
    Finset.card_insert_of_not_mem
      (newSink_not_mem_linkageSinkVertices G L hnodup hlast hchain ordered hadd),
    card_linkageSinkVertices G L]

/-- A valid residual action ending at `.vout u` from a linkage-used dart is
the reverse of that dart, provided it does not depart from the final sink. -/
private theorem residualAction_eq_remove_graphArc_of_head_vout
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {action : ResidualAction V} {u v : V}
    (hvalid : residualActionValid G L action)
    (hhead : residualActionHead action = .vout u)
    (htail_ne_sink : residualActionTail action ≠ .sink)
    (hused : linkageUsedDart G L u v) :
    action = .remove (.graphArc u v) := by
  cases action with
  | add e =>
      cases e with
      | sourceArc a => cases hhead
      | vertexArc w =>
          have hw : w = u := SplitVertex.vout.inj (by
            simpa [residualActionHead, splitArcHead] using hhead)
          subst w
          exact (hvalid (linkageUsedDart_fst_usedVertex G L hused)).elim
      | graphArc w w' => cases hhead
      | sinkArc b => cases hhead
  | remove e =>
      cases e with
      | sourceArc a => cases hhead
      | vertexArc w => cases hhead
      | graphArc w w' =>
          have hw : w = u := SplitVertex.vout.inj (by
            simpa [residualActionHead, splitArcTail] using hhead)
          subst w
          have hv : v = w' := linkageUsedDart_successor_unique G L hused hvalid
          subst w'
          rfl
      | sinkArc b =>
          have hb : b = u := SplitVertex.vout.inj (by
            simpa [residualActionHead, splitArcHead, splitArcTail] using hhead)
          subst b
          exact (htail_ne_sink (by simp [residualActionTail, splitArcHead])).elim

/-- Removing the split-capacity arc of the tail of a selected dart forces the
previous residual action to remove that dart.  The source-rooted trace
invariant ensures this capacity-removal action has a predecessor. -/
private theorem remove_vertexArc_forces_remove_successor_graphArc [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u v : V}
    (hused : linkageUsedDart G L u v)
    (hremove : ResidualAction.remove (.vertexArc u) ∈
      OrderedResidualActions.actions G ordered) :
    ResidualAction.remove (.graphArc u v) ∈
      OrderedResidualActions.actions G ordered := by
  obtain ⟨prev, hprev, hprevHead⟩ :=
    ordered_action_has_predecessor G L ordered hhead hremove (by
      simp [residualActionTail, splitArcHead])
  have hvalid : residualActionValid G L prev :=
    ordered_action_valid G L ordered hprev
  have htail_ne_sink : residualActionTail prev ≠ .sink :=
    simple_trace_action_tail_ne_sink G L hnodup hlast ordered hprev
  have hvout : residualActionHead prev = .vout u := by
    simpa [residualActionTail, splitArcHead] using hprevHead
  have heq : prev = ResidualAction.remove (.graphArc u v) :=
    residualAction_eq_remove_graphArc_of_head_vout G L hvalid hvout htail_ne_sink hused
  simpa [heq] using hprev

/-- At an originally unused vertex, a valid residual action ending at
`.vout u` is its forward split-capacity action, provided it does not depart
from the artificial sink. -/
private theorem residualAction_eq_add_vertexArc_of_head_vout_of_unused
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {action : ResidualAction V} {u : V}
    (hvalid : residualActionValid G L action)
    (hhead : residualActionHead action = .vout u)
    (htail_ne_sink : residualActionTail action ≠ .sink)
    (hunused : ¬ linkageUsedVertex G L u) :
    action = .add (.vertexArc u) := by
  cases action with
  | add e =>
      cases e with
      | sourceArc a => cases hhead
      | vertexArc w =>
          have hw : w = u := SplitVertex.vout.inj (by
            simpa [residualActionHead, splitArcHead] using hhead)
          subst w
          rfl
      | graphArc w w' => cases hhead
      | sinkArc b => cases hhead
  | remove e =>
      cases e with
      | sourceArc a => cases hhead
      | vertexArc w => cases hhead
      | graphArc w w' =>
          have hw : w = u := SplitVertex.vout.inj (by
            simpa [residualActionHead, splitArcTail] using hhead)
          subst w
          exact (hunused (linkageUsedDart_fst_usedVertex G L hvalid)).elim
      | sinkArc b =>
          have hb : b = u := SplitVertex.vout.inj (by
            simpa [residualActionHead, splitArcHead, splitArcTail] using hhead)
          subst b
          exact (htail_ne_sink (by simp [residualActionTail, splitArcHead])).elim

/-- Adding a graph arc from an originally unused tail forces addition of its
split-capacity arc immediately before it in the source-rooted trace. -/
private theorem add_graphArc_from_unused_forces_add_vertexArc [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u v : V}
    (hadd : ResidualAction.add (.graphArc u v) ∈
      OrderedResidualActions.actions G ordered)
    (hunused : ¬ linkageUsedVertex G L u) :
    ResidualAction.add (.vertexArc u) ∈
      OrderedResidualActions.actions G ordered := by
  obtain ⟨prev, hprev, hprevHead⟩ :=
    ordered_action_has_predecessor G L ordered hhead hadd (by
      simp [residualActionTail, splitArcTail])
  have hvalid : residualActionValid G L prev :=
    ordered_action_valid G L ordered hprev
  have htail_ne_sink : residualActionTail prev ≠ .sink :=
    simple_trace_action_tail_ne_sink G L hnodup hlast ordered hprev
  have hvout : residualActionHead prev = .vout u := by
    simpa [residualActionTail, splitArcTail] using hprevHead
  have heq : prev = ResidualAction.add (.vertexArc u) :=
    residualAction_eq_add_vertexArc_of_head_vout_of_unused G L hvalid hvout htail_ne_sink hunused
  simpa [heq] using hprev

/-- A toggled selected graph arc entering `.vin v` is compatible with the
toggled split-capacity arc of `v`. -/
private theorem toggled_vertexArc_of_toggled_graphArc_incoming [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {u v : V}
    (htoggled : toggledSplitArc G L (OrderedResidualActions.actions G ordered)
      (.graphArc u v)) :
    toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.vertexArc v) := by
  rcases htoggled with ⟨hused, hnotRemoveGraph⟩ | ⟨hunusedGraph, haddGraph⟩
  · refine Or.inl ⟨linkageUsedDart_snd_usedVertex G L hused, ?_⟩
    intro hremoveVertex
    apply hnotRemoveGraph
    exact remove_vertexArc_forces_remove_predecessor_graphArc G L hlast ordered hused hremoveVertex
  · by_cases husedVertex : linkageUsedVertex G L v
    · refine Or.inl ⟨husedVertex, ?_⟩
      intro hremoveVertex
      exact simple_trace_no_add_graphArc_remove_head_vertexArc G L hnodup ordered
        haddGraph hremoveVertex
    · refine Or.inr ⟨?_, ?_⟩
      · exact ordered_action_add_unused G L hnodup hlast hchain ordered
          (add_graphArc_into_unused_forces_add_vertexArc G L hlast ordered haddGraph husedVertex)
      · exact add_graphArc_into_unused_forces_add_vertexArc G L hlast ordered haddGraph husedVertex

/-- A toggled selected graph arc leaving `.vout u` is compatible with the
toggled split-capacity arc of `u`. -/
private theorem toggled_vertexArc_of_toggled_graphArc_outgoing [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {u v : V}
    (htoggled : toggledSplitArc G L (OrderedResidualActions.actions G ordered)
      (.graphArc u v)) :
    toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.vertexArc u) := by
  rcases htoggled with ⟨hused, hnotRemoveGraph⟩ | ⟨hunusedGraph, haddGraph⟩
  · refine Or.inl ⟨linkageUsedDart_fst_usedVertex G L hused, ?_⟩
    intro hremoveVertex
    apply hnotRemoveGraph
    exact remove_vertexArc_forces_remove_successor_graphArc G L hnodup hhead hlast ordered
      hused hremoveVertex
  · by_cases husedVertex : linkageUsedVertex G L u
    · refine Or.inl ⟨husedVertex, ?_⟩
      intro hremoveVertex
      exact simple_trace_no_add_graphArc_remove_tail_vertexArc G L hnodup ordered
        haddGraph hremoveVertex
    · refine Or.inr ⟨?_, ?_⟩
      · exact ordered_action_add_unused G L hnodup hlast hchain ordered
          (add_graphArc_from_unused_forces_add_vertexArc G L hnodup hhead hlast ordered
            haddGraph husedVertex)
      · exact add_graphArc_from_unused_forces_add_vertexArc G L hnodup hhead hlast ordered
          haddGraph husedVertex

/-- Adding a graph arc into an occupied vertex cancels that vertex's former
selected incoming graph arc; an occupied source endpoint cannot be entered. -/
private theorem add_graphArc_into_used_forces_remove_old_incoming [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u v : V}
    (hadd : ResidualAction.add (.graphArc u v) ∈
      OrderedResidualActions.actions G ordered)
    (husedVertex : linkageUsedVertex G L v) :
    ∃ u₀, linkageUsedDart G L u₀ v ∧
      ResidualAction.remove (.graphArc u₀ v) ∈
        OrderedResidualActions.actions G ordered := by
  obtain ⟨next, hnext, hnextTail⟩ :=
    ordered_action_has_successor G L ordered hlast hadd (by
      simp [residualActionHead, splitArcHead])
  have htail : residualActionTail next = .vin v := by
    simpa [residualActionHead, splitArcHead] using hnextTail
  have hvalid : residualActionValid G L next :=
    ordered_action_valid G L ordered hnext
  rcases linkageUsedVertex_source_or_predecessor G L husedVertex with hsource | ⟨u₀, hdart⟩
  · cases next with
    | add e =>
        cases e with
        | sourceArc a => cases htail
        | vertexArc w =>
            have hw : w = v := SplitVertex.vin.inj (by
              simpa [residualActionTail, splitArcTail] using htail)
            subst w
            exact (hvalid husedVertex).elim
        | graphArc w w' => cases htail
        | sinkArc b => cases htail
    | remove e =>
        cases e with
        | sourceArc a =>
            have ha : a = v := SplitVertex.vin.inj (by
              simpa [residualActionTail, splitArcHead] using htail)
            subst a
            exact (simple_trace_no_remove_source G L hnodup hhead ordered v hnext).elim
        | vertexArc w => cases htail
        | graphArc w w' =>
            have hw' : w' = v := SplitVertex.vin.inj (by
              simpa [residualActionTail, splitArcHead] using htail)
            subst w'
            exact (linkageUsedDart_snd_not_usedSource G L hvalid hsource).elim
        | sinkArc b => cases htail
  · cases next with
    | add e =>
        cases e with
        | sourceArc a => cases htail
        | vertexArc w =>
            have hw : w = v := SplitVertex.vin.inj (by
              simpa [residualActionTail, splitArcTail] using htail)
            subst w
            exact (hvalid husedVertex).elim
        | graphArc w w' => cases htail
        | sinkArc b => cases htail
    | remove e =>
        cases e with
        | sourceArc a =>
            have ha : a = v := SplitVertex.vin.inj (by
              simpa [residualActionTail, splitArcHead] using htail)
            subst a
            exact (linkageUsedDart_snd_not_usedSource G L hdart hvalid).elim
        | vertexArc w => cases htail
        | graphArc w w' =>
            have hw' : w' = v := SplitVertex.vin.inj (by
              simpa [residualActionTail, splitArcHead] using htail)
            subst w'
            have hw : w = u₀ := linkageUsedDart_predecessor_unique G L hvalid hdart
            subst w
            exact ⟨u₀, hdart, hnext⟩
        | sinkArc b => cases htail

/-- Adding a graph arc from an occupied vertex cancels that vertex's former
selected outgoing graph arc; an occupied sink endpoint cannot emit one. -/
private theorem add_graphArc_from_used_forces_remove_old_outgoing [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u v : V}
    (hadd : ResidualAction.add (.graphArc u v) ∈
      OrderedResidualActions.actions G ordered)
    (husedVertex : linkageUsedVertex G L u) :
    ∃ v₀, linkageUsedDart G L u v₀ ∧
      ResidualAction.remove (.graphArc u v₀) ∈
        OrderedResidualActions.actions G ordered := by
  obtain ⟨prev, hprev, hprevHead⟩ :=
    ordered_action_has_predecessor G L ordered hhead hadd (by
      simp [residualActionTail, splitArcTail])
  have hhead' : residualActionHead prev = .vout u := by
    simpa [residualActionTail, splitArcTail] using hprevHead
  have hvalid : residualActionValid G L prev :=
    ordered_action_valid G L ordered hprev
  rcases linkageUsedVertex_sink_or_successor G L husedVertex with hsink | ⟨v₀, hdart⟩
  · cases prev with
    | add e =>
        cases e with
        | sourceArc a => cases hhead'
        | vertexArc w =>
            have hw : w = u := SplitVertex.vout.inj (by
              simpa [residualActionHead, splitArcHead] using hhead')
            subst w
            exact (hvalid husedVertex).elim
        | graphArc w w' => cases hhead'
        | sinkArc b => cases hhead'
    | remove e =>
        cases e with
        | sourceArc a => cases hhead'
        | vertexArc w => cases hhead'
        | graphArc w w' =>
            have hw : w = u := SplitVertex.vout.inj (by
              simpa [residualActionHead, splitArcTail] using hhead')
            subst w
            exact (linkageUsedDart_fst_not_usedSink G L hvalid hsink).elim
        | sinkArc b =>
            have hb : b = u := SplitVertex.vout.inj (by
              simpa [residualActionHead, splitArcHead, splitArcTail] using hhead')
            subst b
            exact (simple_trace_no_remove_sink G L hnodup hlast ordered u hprev).elim
  · cases prev with
    | add e =>
        cases e with
        | sourceArc a => cases hhead'
        | vertexArc w =>
            have hw : w = u := SplitVertex.vout.inj (by
              simpa [residualActionHead, splitArcHead] using hhead')
            subst w
            exact (hvalid husedVertex).elim
        | graphArc w w' => cases hhead'
        | sinkArc b => cases hhead'
    | remove e =>
        cases e with
        | sourceArc a => cases hhead'
        | vertexArc w => cases hhead'
        | graphArc w w' =>
            have hw : w = u := SplitVertex.vout.inj (by
              simpa [residualActionHead, splitArcTail] using hhead')
            subst w
            have hw' : w' = v₀ := linkageUsedDart_successor_unique G L hvalid hdart
            subst w'
            exact ⟨v₀, hdart, hprev⟩
        | sinkArc b =>
            have hb : b = u := SplitVertex.vout.inj (by
              simpa [residualActionHead, splitArcHead, splitArcTail] using hhead')
            subst b
            exact (linkageUsedDart_fst_not_usedSink G L hdart hvalid).elim

/-- An added graph transition into an occupied vertex excludes every former
selected incoming transition from the toggled state. -/
private theorem add_graphArc_into_used_excludes_old_incoming [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u u₀ v : V}
    (hadd : ResidualAction.add (.graphArc u v) ∈
      OrderedResidualActions.actions G ordered)
    (hold : linkageUsedDart G L u₀ v) :
    ¬ toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.graphArc u₀ v) := by
  obtain ⟨w, hnew, hremove⟩ :=
    add_graphArc_into_used_forces_remove_old_incoming G L hnodup hhead hlast ordered hadd
      (linkageUsedDart_snd_usedVertex G L hold)
  have hw : w = u₀ := linkageUsedDart_predecessor_unique G L hnew hold
  subst w
  exact ordered_not_toggled_remove G L ordered hremove

/-- An added graph transition from an occupied vertex excludes every former
selected outgoing transition from the toggled state. -/
private theorem add_graphArc_from_used_excludes_old_outgoing [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u v v₀ : V}
    (hadd : ResidualAction.add (.graphArc u v) ∈
      OrderedResidualActions.actions G ordered)
    (hold : linkageUsedDart G L u v₀) :
    ¬ toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.graphArc u v₀) := by
  obtain ⟨w, hnew, hremove⟩ :=
    add_graphArc_from_used_forces_remove_old_outgoing G L hnodup hhead hlast ordered hadd
      (linkageUsedDart_fst_usedVertex G L hold)
  have hw : w = v₀ := linkageUsedDart_successor_unique G L hnew hold
  subst w
  exact ordered_not_toggled_remove G L ordered hremove

/-- Two toggled graph transitions entering the same split-input have the
same tail vertex. -/
private theorem toggled_graphArc_incoming_unique [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u u' v : V}
    (h₁ : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.graphArc u v))
    (h₂ : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.graphArc u' v)) :
    u = u' := by
  rcases h₁ with ⟨hold₁, hnotRemove₁⟩ | ⟨hunused₁, hadd₁⟩
  · rcases h₂ with ⟨hold₂, hnotRemove₂⟩ | ⟨hunused₂, hadd₂⟩
    · exact linkageUsedDart_predecessor_unique G L hold₁ hold₂
    · exact (add_graphArc_into_used_excludes_old_incoming G L hnodup hhead hlast ordered
          hadd₂ hold₁ (Or.inl ⟨hold₁, hnotRemove₁⟩)).elim
  · rcases h₂ with ⟨hold₂, hnotRemove₂⟩ | ⟨hunused₂, hadd₂⟩
    · exact (add_graphArc_into_used_excludes_old_incoming G L hnodup hhead hlast ordered
          hadd₁ hold₂ (Or.inl ⟨hold₂, hnotRemove₂⟩)).elim
    · have heq : ResidualAction.add (.graphArc u v) = ResidualAction.add (.graphArc u' v) :=
          List.inj_on_of_nodup_map (ordered_action_heads_nodup G L hnodup ordered)
            hadd₁ hadd₂ (by simp [residualActionHead, splitArcHead])
      cases heq
      rfl

/-- Two toggled graph transitions leaving the same split-output have the
same head vertex. -/
private theorem toggled_graphArc_outgoing_unique [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u v v' : V}
    (h₁ : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.graphArc u v))
    (h₂ : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.graphArc u v')) :
    v = v' := by
  rcases h₁ with ⟨hold₁, hnotRemove₁⟩ | ⟨hunused₁, hadd₁⟩
  · rcases h₂ with ⟨hold₂, hnotRemove₂⟩ | ⟨hunused₂, hadd₂⟩
    · exact linkageUsedDart_successor_unique G L hold₁ hold₂
    · exact (add_graphArc_from_used_excludes_old_outgoing G L hnodup hhead hlast ordered
          hadd₂ hold₁ (Or.inl ⟨hold₁, hnotRemove₁⟩)).elim
  · rcases h₂ with ⟨hold₂, hnotRemove₂⟩ | ⟨hunused₂, hadd₂⟩
    · exact (add_graphArc_from_used_excludes_old_outgoing G L hnodup hhead hlast ordered
          hadd₁ hold₂ (Or.inl ⟨hold₂, hnotRemove₂⟩)).elim
    · have heq : ResidualAction.add (.graphArc u v) = ResidualAction.add (.graphArc u v') :=
          List.inj_on_of_nodup_map (ordered_action_tails_nodup G L hnodup ordered)
            hadd₁ hadd₂ (by simp [residualActionTail, splitArcTail])
      cases heq
      rfl

/-- Adding a source arc to a vertex that already has a selected incoming dart
forces removal of that dart on the following residual transition. -/
private theorem add_sourceArc_forces_remove_old_incoming [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u v : V}
    (hadd : ResidualAction.add (.sourceArc v) ∈
      OrderedResidualActions.actions G ordered)
    (hold : linkageUsedDart G L u v) :
    ResidualAction.remove (.graphArc u v) ∈
      OrderedResidualActions.actions G ordered := by
  obtain ⟨next, hnext, hnextTail⟩ :=
    ordered_action_has_successor G L ordered hlast hadd (by
      simp [residualActionHead, splitArcHead])
  have htail : residualActionTail next = .vin v := by
    simpa [residualActionHead, splitArcHead] using hnextTail
  have hvalid : residualActionValid G L next := ordered_action_valid G L ordered hnext
  cases next with
  | add e =>
      cases e with
      | sourceArc a => cases htail
      | vertexArc w =>
          have hw : w = v := SplitVertex.vin.inj (by
            simpa [residualActionTail, splitArcTail] using htail)
          subst w
          exact (hvalid (linkageUsedDart_snd_usedVertex G L hold)).elim
      | graphArc w w' => cases htail
      | sinkArc b => cases htail
  | remove e =>
      cases e with
      | sourceArc a =>
          have ha : a = v := SplitVertex.vin.inj (by
            simpa [residualActionTail, splitArcHead] using htail)
          subst a
          exact (linkageUsedDart_snd_not_usedSource G L hold hvalid).elim
      | vertexArc w => cases htail
      | graphArc w w' =>
          have hw' : w' = v := SplitVertex.vin.inj (by
            simpa [residualActionTail, splitArcHead] using htail)
          subst w'
          have hw : w = u := linkageUsedDart_predecessor_unique G L hvalid hold
          subst w
          exact hnext
      | sinkArc b => cases htail

/-- A source transition and a graph transition cannot both be toggled into
the same split-input. -/
private theorem toggled_sourceArc_not_toggled_graphArc_incoming [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u v : V}
    (hsource : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sourceArc v))
    (hgraph : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.graphArc u v)) :
    False := by
  rcases hsource with ⟨hsource, hnotRemoveSource⟩ | ⟨hunusedSource, haddSource⟩
  · rcases hgraph with ⟨hold, hnotRemoveGraph⟩ | ⟨hunusedGraph, haddGraph⟩
    · exact linkageUsedDart_snd_not_usedSource G L hold hsource
    · rcases hsource with ⟨i, hsrc⟩
      have hused : linkageUsedVertex G L v := by
        refine ⟨i, ?_⟩
        rw [← hsrc]
        exact (L.path i : G.Walk (L.src i) (L.dst i)).start_mem_support
      obtain ⟨w, hdart, _⟩ :=
        add_graphArc_into_used_forces_remove_old_incoming G L hnodup hhead hlast ordered
          haddGraph hused
      exact linkageUsedDart_snd_not_usedSource G L hdart ⟨i, hsrc⟩
  · rcases hgraph with ⟨hold, hnotRemoveGraph⟩ | ⟨hunusedGraph, haddGraph⟩
    · exact (ordered_not_toggled_remove G L ordered
          (add_sourceArc_forces_remove_old_incoming G L hlast ordered haddSource hold)
          (Or.inl ⟨hold, hnotRemoveGraph⟩)).elim
    · have heq : ResidualAction.add (.sourceArc v) = ResidualAction.add (.graphArc u v) :=
          List.inj_on_of_nodup_map (ordered_action_heads_nodup G L hnodup ordered)
            haddSource haddGraph (by simp [residualActionHead, splitArcHead])
      cases heq

/-- There is at most one toggled selected transition entering each split-input. -/
private theorem toggled_incoming_transition_unique [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {v : V} {e e' : SplitArc V}
    (he : splitArcHead e = .vin v) (he' : splitArcHead e' = .vin v)
    (htoggled : toggledSplitArc G L (OrderedResidualActions.actions G ordered) e)
    (htoggled' : toggledSplitArc G L (OrderedResidualActions.actions G ordered) e') : e = e' := by
  cases e with
  | sourceArc a =>
      have ha : a = v := SplitVertex.vin.inj (by simpa [splitArcHead] using he)
      subst a
      cases e' with
      | sourceArc b =>
          have hb : b = v := SplitVertex.vin.inj (by simpa [splitArcHead] using he')
          subst b
          rfl
      | vertexArc w => cases he'
      | graphArc u w =>
          have hw : w = v := SplitVertex.vin.inj (by simpa [splitArcHead] using he')
          subst w
          exact (toggled_sourceArc_not_toggled_graphArc_incoming G L hnodup hhead hlast ordered
            htoggled htoggled').elim
      | sinkArc b => cases he'
  | vertexArc w => cases he
  | graphArc u w =>
      have hw : w = v := SplitVertex.vin.inj (by simpa [splitArcHead] using he)
      subst w
      cases e' with
      | sourceArc b =>
          have hb : b = v := SplitVertex.vin.inj (by simpa [splitArcHead] using he')
          subst b
          exact (toggled_sourceArc_not_toggled_graphArc_incoming G L hnodup hhead hlast ordered
            htoggled' htoggled).elim
      | vertexArc w => cases he'
      | graphArc u' w' =>
          have hw' : w' = v := SplitVertex.vin.inj (by simpa [splitArcHead] using he')
          subst w'
          have hu : u = u' := toggled_graphArc_incoming_unique G L hnodup hhead hlast ordered
            htoggled htoggled'
          subst u'
          rfl
      | sinkArc b => cases he'
  | sinkArc b => cases he

/-- Adding a sink arc from a vertex that already has a selected outgoing dart
forces removal of that dart on the preceding residual transition. -/
private theorem add_sinkArc_forces_remove_old_outgoing [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hhead : q.head? = some .source)
    (ordered : OrderedResidualActions G L q) {u v : V}
    (hadd : ResidualAction.add (.sinkArc u) ∈ OrderedResidualActions.actions G ordered)
    (hold : linkageUsedDart G L u v) :
    ResidualAction.remove (.graphArc u v) ∈ OrderedResidualActions.actions G ordered := by
  obtain ⟨prev, hprev, hprevHead⟩ :=
    ordered_action_has_predecessor G L ordered hhead hadd (by
      simp [residualActionTail, splitArcTail])
  have hhead' : residualActionHead prev = .vout u := by
    simpa [residualActionTail, splitArcTail] using hprevHead
  have hvalid : residualActionValid G L prev := ordered_action_valid G L ordered hprev
  cases prev with
  | add e =>
      cases e with
      | sourceArc a => cases hhead'
      | vertexArc w =>
          have hw : w = u := SplitVertex.vout.inj (by
            simpa [residualActionHead, splitArcHead] using hhead')
          subst w
          exact (hvalid (linkageUsedDart_fst_usedVertex G L hold)).elim
      | graphArc w w' => cases hhead'
      | sinkArc b => cases hhead'
  | remove e =>
      cases e with
      | sourceArc a => cases hhead'
      | vertexArc w => cases hhead'
      | graphArc w w' =>
          have hw : w = u := SplitVertex.vout.inj (by
            simpa [residualActionHead, splitArcTail] using hhead')
          subst w
          have hw' : w' = v := linkageUsedDart_successor_unique G L hvalid hold
          subst w'
          exact hprev
      | sinkArc b =>
          have hb : b = u := SplitVertex.vout.inj (by
            simpa [residualActionHead, splitArcHead, splitArcTail] using hhead')
          subst b
          exact (linkageUsedDart_fst_not_usedSink G L hold hvalid).elim

/-- A graph transition and a sink transition cannot both be toggled from the
same split-output. -/
private theorem toggled_graphArc_not_toggled_sinkArc_outgoing [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u v : V}
    (hgraph : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.graphArc u v))
    (hsink : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sinkArc u)) :
    False := by
  rcases hgraph with ⟨hold, hnotRemoveGraph⟩ | ⟨hunusedGraph, haddGraph⟩
  · rcases hsink with ⟨hsink, hnotRemoveSink⟩ | ⟨hunusedSink, haddSink⟩
    · exact linkageUsedDart_fst_not_usedSink G L hold hsink
    · exact (ordered_not_toggled_remove G L ordered
          (add_sinkArc_forces_remove_old_outgoing G L hhead ordered haddSink hold)
          (Or.inl ⟨hold, hnotRemoveGraph⟩)).elim
  · rcases hsink with ⟨hsink, hnotRemoveSink⟩ | ⟨hunusedSink, haddSink⟩
    · rcases hsink with ⟨i, hdst⟩
      have hused : linkageUsedVertex G L u := by
        refine ⟨i, ?_⟩
        rw [← hdst]
        exact (L.path i : G.Walk (L.src i) (L.dst i)).end_mem_support
      obtain ⟨w, hdart, _⟩ :=
        add_graphArc_from_used_forces_remove_old_outgoing G L hnodup hhead hlast ordered
          haddGraph hused
      exact linkageUsedDart_fst_not_usedSink G L hdart ⟨i, hdst⟩
    · have heq : ResidualAction.add (.graphArc u v) = ResidualAction.add (.sinkArc u) :=
          List.inj_on_of_nodup_map (ordered_action_tails_nodup G L hnodup ordered)
            haddGraph haddSink (by simp [residualActionTail, splitArcTail])
      cases heq

/-- There is at most one toggled selected transition leaving each split-output. -/
private theorem toggled_outgoing_transition_unique [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {u : V} {e e' : SplitArc V}
    (he : splitArcTail e = .vout u) (he' : splitArcTail e' = .vout u)
    (htoggled : toggledSplitArc G L (OrderedResidualActions.actions G ordered) e)
    (htoggled' : toggledSplitArc G L (OrderedResidualActions.actions G ordered) e') : e = e' := by
  cases e with
  | sourceArc a => cases he
  | vertexArc w => cases he
  | graphArc w v =>
      have hw : w = u := SplitVertex.vout.inj (by simpa [splitArcTail] using he)
      subst w
      cases e' with
      | sourceArc a => cases he'
      | vertexArc w => cases he'
      | graphArc w' v' =>
          have hw' : w' = u := SplitVertex.vout.inj (by simpa [splitArcTail] using he')
          subst w'
          have hv : v = v' := toggled_graphArc_outgoing_unique G L hnodup hhead hlast ordered
            htoggled htoggled'
          subst v'
          rfl
      | sinkArc b =>
          have hb : b = u := SplitVertex.vout.inj (by simpa [splitArcTail] using he')
          subst b
          exact (toggled_graphArc_not_toggled_sinkArc_outgoing G L hnodup hhead hlast ordered
            htoggled htoggled').elim
  | sinkArc b =>
      have hb : b = u := SplitVertex.vout.inj (by simpa [splitArcTail] using he)
      subst b
      cases e' with
      | sourceArc a => cases he'
      | vertexArc w => cases he'
      | graphArc w v =>
          have hw : w = u := SplitVertex.vout.inj (by simpa [splitArcTail] using he')
          subst w
          exact (toggled_graphArc_not_toggled_sinkArc_outgoing G L hnodup hhead hlast ordered
            htoggled' htoggled).elim
      | sinkArc b' =>
          have hb' : b' = u := SplitVertex.vout.inj (by simpa [splitArcTail] using he')
          subst b'
          rfl

/-- The action immediately before a trace transition entering `.vin v`
supplies a toggled incoming transition unless the split-capacity arc of `v`
was removed. -/
private theorem predecessor_gives_toggled_incoming [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {v : V} {action : ResidualAction V}
    (haction : action ∈ OrderedResidualActions.actions G ordered)
    (htail : residualActionTail action = .vin v)
    (hnotRemove : ResidualAction.remove (.vertexArc v) ∉
      OrderedResidualActions.actions G ordered) :
    ∃ x, toggledSplitStep G L (OrderedResidualActions.actions G ordered) x (.vin v) := by
  obtain ⟨prev, hprev, hprevHead⟩ :=
    ordered_action_has_predecessor G L ordered hhead haction (by
      rw [htail]
      simp)
  have hprevHead' : residualActionHead prev = .vin v := hprevHead.trans htail
  cases prev with
  | add e =>
      cases e with
      | sourceArc a =>
          have ha : a = v := SplitVertex.vin.inj (by
            simpa [residualActionHead, splitArcHead, residualActionTail, splitArcTail]
              using hprevHead')
          subst a
          refine ⟨.source, .sourceArc v, ?_, rfl, rfl⟩
          exact ordered_toggled_add G L hnodup hlast hchain ordered hprev
      | vertexArc w => cases hprevHead'
      | graphArc u w =>
          have hw : w = v := SplitVertex.vin.inj (by
            simpa [residualActionHead, splitArcHead, residualActionTail, splitArcTail]
              using hprevHead')
          subst w
          refine ⟨.vout u, .graphArc u v, ?_, rfl, rfl⟩
          exact ordered_toggled_add G L hnodup hlast hchain ordered hprev
      | sinkArc b => cases hprevHead'
  | remove e =>
      cases e with
      | sourceArc a => cases hprevHead'
      | vertexArc w =>
          have hw : w = v := SplitVertex.vin.inj (by
            simpa [residualActionHead, splitArcTail, residualActionTail, splitArcTail]
              using hprevHead')
          subst w
          exact (hnotRemove hprev).elim
      | graphArc u w => cases hprevHead'
      | sinkArc b => cases hprevHead'

/-- Every selected split-capacity arc in the toggled state has a selected
incoming split transition. -/
private theorem toggled_vertexArc_has_toggled_incoming [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source)
    (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {v : V}
    (hvertex : toggledSplitArc G L (OrderedResidualActions.actions G ordered)
      (.vertexArc v)) :
    ∃ x, toggledSplitStep G L (OrderedResidualActions.actions G ordered) x (.vin v) := by
  rcases hvertex with ⟨hused, hnotRemove⟩ | ⟨hunused, haddVertex⟩
  · rcases linkageUsedVertex_source_or_predecessor G L hused with hsource | ⟨u, hdart⟩
    · refine ⟨.source, .sourceArc v, ?_, rfl, rfl⟩
      exact Or.inl ⟨hsource,
        simple_trace_no_remove_source G L hnodup hhead ordered v⟩
    · by_cases hremoveGraph : ResidualAction.remove (.graphArc u v) ∈
          OrderedResidualActions.actions G ordered
      · exact predecessor_gives_toggled_incoming G L hnodup hhead hlast hchain ordered
          hremoveGraph (by simp [residualActionTail, splitArcHead]) hnotRemove
      · refine ⟨.vout u, .graphArc u v, ?_, rfl, rfl⟩
        exact Or.inl ⟨hdart, hremoveGraph⟩
  · apply predecessor_gives_toggled_incoming G L hnodup hhead hlast hchain ordered
      haddVertex (by simp [residualActionTail, splitArcTail])
    intro hremove
    exact simple_trace_no_opposite_actions G L hnodup ordered (.vertexArc v)
      ⟨haddVertex, hremove⟩

/-- The action immediately after a trace transition leaving `.vout v`
supplies a toggled outgoing transition unless the split-capacity arc of `v`
was removed. -/
private theorem successor_gives_toggled_outgoing [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {v : V} {action : ResidualAction V}
    (haction : action ∈ OrderedResidualActions.actions G ordered)
    (hheadAction : residualActionHead action = .vout v)
    (hnotRemove : ResidualAction.remove (.vertexArc v) ∉
      OrderedResidualActions.actions G ordered) :
    ∃ y, toggledSplitStep G L (OrderedResidualActions.actions G ordered) (.vout v) y := by
  obtain ⟨next, hnext, hnextTail⟩ :=
    ordered_action_has_successor G L ordered hlast haction (by
      rw [hheadAction]
      simp)
  have hnextTail' : residualActionTail next = .vout v := hnextTail.trans hheadAction
  cases next with
  | add e =>
      cases e with
      | sourceArc a => cases hnextTail'
      | vertexArc w => cases hnextTail'
      | graphArc u w =>
          have hu : u = v := SplitVertex.vout.inj (by
            simpa [residualActionTail, splitArcTail] using hnextTail')
          subst u
          refine ⟨.vin w, .graphArc v w, ?_, rfl, rfl⟩
          exact ordered_toggled_add G L hnodup hlast hchain ordered hnext
      | sinkArc b =>
          have hb : b = v := SplitVertex.vout.inj (by
            simpa [residualActionTail, splitArcTail] using hnextTail')
          subst b
          refine ⟨.sink, .sinkArc v, ?_, rfl, rfl⟩
          exact ordered_toggled_add G L hnodup hlast hchain ordered hnext
  | remove e =>
      cases e with
      | sourceArc a => cases hnextTail'
      | vertexArc w =>
          have hw : w = v := SplitVertex.vout.inj (by
            simpa [residualActionTail, splitArcHead] using hnextTail')
          subst w
          exact (hnotRemove hnext).elim
      | graphArc u w => cases hnextTail'
      | sinkArc b => cases hnextTail'

/-- Every selected split-capacity arc in the toggled state has a selected
outgoing split transition. -/
private theorem toggled_vertexArc_has_toggled_outgoing [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {v : V}
    (hvertex : toggledSplitArc G L (OrderedResidualActions.actions G ordered)
      (.vertexArc v)) :
    ∃ y, toggledSplitStep G L (OrderedResidualActions.actions G ordered) (.vout v) y := by
  rcases hvertex with ⟨hused, hnotRemove⟩ | ⟨hunused, haddVertex⟩
  · rcases linkageUsedVertex_sink_or_successor G L hused with hsink | ⟨w, hdart⟩
    · refine ⟨.sink, .sinkArc v, ?_, rfl, rfl⟩
      exact Or.inl ⟨hsink,
        simple_trace_no_remove_sink G L hnodup hlast ordered v⟩
    · by_cases hremoveGraph : ResidualAction.remove (.graphArc v w) ∈
          OrderedResidualActions.actions G ordered
      · exact successor_gives_toggled_outgoing G L hnodup hlast hchain ordered
          hremoveGraph (by simp [residualActionHead, splitArcTail]) hnotRemove
      · refine ⟨.vin w, .graphArc v w, ?_, rfl, rfl⟩
        exact Or.inl ⟨hdart, hremoveGraph⟩
  · apply successor_gives_toggled_outgoing G L hnodup hlast hchain ordered
      haddVertex (by simp [residualActionHead, splitArcHead])
    intro hremove
    exact simple_trace_no_opposite_actions G L hnodup ordered (.vertexArc v)
      ⟨haddVertex, hremove⟩

/-- Every toggled split-capacity arc has exactly one toggled transition into
its split-input. -/
private theorem toggled_vertexArc_exactly_one_incoming [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {v : V}
    (hvertex : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.vertexArc v)) :
    ∃! e : SplitArc V, toggledSplitArc G L (OrderedResidualActions.actions G ordered) e ∧
      splitArcHead e = .vin v := by
  obtain ⟨x, e, htoggled, htail, hheadStep⟩ :=
    toggled_vertexArc_has_toggled_incoming G L hnodup hhead hlast hchain ordered hvertex
  refine ⟨e, ⟨htoggled, hheadStep⟩, ?_⟩
  intro e' he'
  exact toggled_incoming_transition_unique G L hnodup hhead hlast ordered he'.2 hheadStep
    he'.1 htoggled

/-- Every toggled split-capacity arc has exactly one toggled transition from
its split-output. -/
private theorem toggled_vertexArc_exactly_one_outgoing [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {v : V}
    (hvertex : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.vertexArc v)) :
    ∃! e : SplitArc V, toggledSplitArc G L (OrderedResidualActions.actions G ordered) e ∧
      splitArcTail e = .vout v := by
  obtain ⟨y, e, htoggled, htailStep, hheadStep⟩ :=
    toggled_vertexArc_has_toggled_outgoing G L hnodup hlast hchain ordered hvertex
  refine ⟨e, ⟨htoggled, htailStep⟩, ?_⟩
  intro e' he'
  exact toggled_outgoing_transition_unique G L hnodup hhead hlast ordered he'.2 htailStep
    he'.1 htoggled

/-- Every toggled source capacity arc is attached to an `A` terminal. -/
private theorem toggled_sourceArc_mem_left [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {a : V}
    (htoggled : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sourceArc a)) :
    a ∈ A := by
  rcases htoggled with ⟨hselected, _⟩ | ⟨_, hadd⟩
  · rcases hselected with ⟨i, hsrc⟩
    rw [← hsrc]
    exact L.src_mem i
  · obtain ⟨a', ha', hunused, hadd'⟩ :=
      simple_trace_starts_with_unused_source G L hhead hlast hchain ordered
    exact (source_add_unique G L hnodup hhead ordered hadd hadd').symm ▸ ha'

/-- Every toggled sink capacity arc is attached to a `B` terminal. -/
private theorem toggled_sinkArc_mem_right [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {b : V}
    (htoggled : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sinkArc b)) :
    b ∈ B := by
  rcases htoggled with ⟨hselected, _⟩ | ⟨_, hadd⟩
  · rcases hselected with ⟨i, hdst⟩
    rw [← hdst]
    exact L.dst_mem i
  · obtain ⟨b', hb', hunused, hadd'⟩ :=
      simple_trace_ends_with_unused_sink G L hlast hchain ordered ⟨_, hadd⟩
    exact (sink_add_unique G L hnodup hlast ordered hadd hadd').symm ▸ hb'

/-- The original-vertex transition relation selected after the residual
toggle. -/
def toggledGraphStep {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (actions : List (ResidualAction V))
    (u v : V) : Prop :=
  toggledSplitArc G L actions (.graphArc u v)

/-- Every selected original-vertex transition is an edge of the graph. -/
private theorem toggledGraphStep_adj [DecidableEq V] {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {q : List (SplitVertex V)}
    (ordered : OrderedResidualActions G L q) {u v : V}
    (hstep : toggledGraphStep G L (OrderedResidualActions.actions G ordered) u v) :
    G.Adj u v :=
  toggled_graphArc_adj G L ordered hstep

/-- An added source arc into an originally unused vertex is immediately
followed by addition of that vertex's split-capacity arc. -/
private theorem add_sourceArc_into_unused_forces_add_vertexArc [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {a : V}
    (hadd : ResidualAction.add (.sourceArc a) ∈ OrderedResidualActions.actions G ordered)
    (hunused : ¬ linkageUsedVertex G L a) :
    ResidualAction.add (.vertexArc a) ∈ OrderedResidualActions.actions G ordered := by
  obtain ⟨next, hnext, hnextTail⟩ :=
    ordered_action_has_successor G L ordered hlast hadd (by
      simp [residualActionHead, splitArcHead])
  have htail : residualActionTail next = .vin a := by
    simpa [residualActionHead, splitArcHead] using hnextTail
  have hstep := ordered_action_step G L ordered hnext
  have hhead : residualActionHead next = .vout a :=
    residual_successor_from_unused_vertex G L hunused (by simpa [htail] using hstep)
  have heq : next = ResidualAction.add (.vertexArc a) :=
    residualAction_eq_add_vertexArc_of_endpoints G L
      (ordered_action_valid G L ordered hnext) htail hhead hunused
  simpa [heq] using hnext

private theorem residualAction_eq_remove_sourceArc_of_tail_vin_of_usedSource
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {action : ResidualAction V} {a : V}
    (htail : residualActionTail action = .vin a)
    (hsource : linkageUsedSource G L a)
    (hvalid : residualActionValid G L action) :
    action = .remove (.sourceArc a) := by
  have hused : linkageUsedVertex G L a := by
    rcases hsource with ⟨i, hsrc⟩
    refine ⟨i, ?_⟩
    rw [← hsrc]
    exact (L.path i : G.Walk (L.src i) (L.dst i)).start_mem_support
  cases action with
  | add e =>
      cases e with
      | sourceArc b => cases htail
      | vertexArc v =>
          have hv : v = a := SplitVertex.vin.inj (by
            simpa [residualActionTail, splitArcTail] using htail)
          subst v
          exact (hvalid hused).elim
      | graphArc u v => cases htail
      | sinkArc b => cases htail
  | remove e =>
      cases e with
      | sourceArc b =>
          have hb : b = a := SplitVertex.vin.inj (by
            simpa [residualActionTail, splitArcHead] using htail)
          subst b
          rfl
      | vertexArc v => cases htail
      | graphArc u v =>
          have hv : v = a := SplitVertex.vin.inj (by
            simpa [residualActionTail, splitArcHead] using htail)
          subst v
          exact (linkageUsedDart_snd_not_usedSource G L hvalid hsource).elim
      | sinkArc b => cases htail

private theorem toggled_vertexArc_of_toggled_sourceArc [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L))
    (ordered : OrderedResidualActions G L q) {a : V}
    (hsource : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sourceArc a)) :
    toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.vertexArc a) := by
  rcases hsource with ⟨hs, hnot⟩ | ⟨_, hadd⟩
  · have hu : linkageUsedVertex G L a := by
      rcases hs with ⟨i, hsrc⟩
      refine ⟨i, ?_⟩
      rw [← hsrc]
      exact (L.path i : G.Walk (L.src i) (L.dst i)).start_mem_support
    refine Or.inl ⟨hu, ?_⟩
    intro hremove
    obtain ⟨next, hnext, htail⟩ := ordered_action_has_successor G L ordered hlast hremove (by simp [residualActionHead, splitArcTail])
    have hnTail : residualActionTail next = .vin a := by simpa [residualActionHead, splitArcTail] using htail
    have heq := residualAction_eq_remove_sourceArc_of_tail_vin_of_usedSource G L hnTail hs (ordered_action_valid G L ordered hnext)
    subst next
    exact simple_trace_no_remove_source G L hnodup hhead ordered a hnext
  · by_cases hu : linkageUsedVertex G L a
    · refine Or.inl ⟨hu, ?_⟩
      intro hremove
      have heq : ResidualAction.add (.sourceArc a) = ResidualAction.remove (.vertexArc a) :=
        List.inj_on_of_nodup_map (ordered_action_heads_nodup G L hnodup ordered)
          hadd hremove (by simp [residualActionHead, splitArcHead, splitArcTail])
      cases heq
    · exact ordered_toggled_add G L hnodup hlast hchain ordered
        (add_sourceArc_into_unused_forces_add_vertexArc G L hlast ordered hadd hu)

private theorem toggled_vertexArc_of_toggledGraphReach [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L)) (ordered : OrderedResidualActions G L q)
    {a v : V} (hsource : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sourceArc a))
    (hreach : Relation.ReflTransGen (toggledGraphStep G L (OrderedResidualActions.actions G ordered)) a v) :
    toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.vertexArc v) := by
  induction hreach with
  | refl => exact toggled_vertexArc_of_toggled_sourceArc G L hnodup hhead hlast hchain ordered hsource
  | @tail u v hreach hstep ih =>
      exact toggled_vertexArc_of_toggled_graphArc_incoming G L hnodup hlast hchain ordered hstep

private theorem toggled_vertexArc_sink_or_unique_graphStep [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L)) (ordered : OrderedResidualActions G L q)
    {v : V} (hvertex : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.vertexArc v)) :
    toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sinkArc v) ∨
      ∃! w : V, toggledGraphStep G L (OrderedResidualActions.actions G ordered) v w := by
  obtain ⟨e, he, huniq⟩ := toggled_vertexArc_exactly_one_outgoing G L hnodup hhead hlast hchain ordered hvertex
  cases e with
  | sourceArc a => cases he.2
  | vertexArc w => cases he.2
  | sinkArc b =>
      have hb : b = v := SplitVertex.vout.inj (by simpa [splitArcTail] using he.2)
      subst b
      exact Or.inl he.1
  | graphArc u w =>
      have hu : u = v := SplitVertex.vout.inj (by simpa [splitArcTail] using he.2)
      subst u
      refine Or.inr ⟨w, he.1, ?_⟩
      intro w' hw'
      exact (toggled_graphArc_outgoing_unique G L hnodup hhead hlast ordered
        (u := v) (v := w) (v' := w') he.1 hw').symm

private theorem toggled_sourceArc_reaches_toggled_sink [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L)) (ordered : OrderedResidualActions G L q)
    {a : V} (hsource : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sourceArc a)) :
    ∃ b : V, Relation.ReflTransGen (toggledGraphStep G L (OrderedResidualActions.actions G ordered)) a b ∧
      toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sinkArc b) := by
  classical
  by_contra hExists
  have hNoSink : ∀ v : V,
      Relation.ReflTransGen (toggledGraphStep G L (OrderedResidualActions.actions G ordered)) a v →
      ¬ toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sinkArc v) := by
    intro v hr hs
    exact hExists ⟨v, hr, hs⟩
  let R := {v : V // Relation.ReflTransGen (toggledGraphStep G L (OrderedResidualActions.actions G ordered)) a v}
  have hnext : ∀ x : R, ∃ w : V, toggledGraphStep G L (OrderedResidualActions.actions G ordered) x.1 w := by
    intro x
    rcases toggled_vertexArc_sink_or_unique_graphStep G L hnodup hhead hlast hchain ordered
      (toggled_vertexArc_of_toggledGraphReach G L hnodup hhead hlast hchain ordered hsource x.2) with hs | hg
    · exact (hNoSink x.1 x.2 hs).elim
    · rcases hg with ⟨w, hw, _⟩
      exact ⟨w, hw⟩
  choose next hnextStep using hnext
  let succ : R → R := fun x => ⟨next x, x.2.tail (hnextStep x)⟩
  have hsuccStep (x : R) : toggledGraphStep G L (OrderedResidualActions.actions G ordered) x.1 (succ x).1 := by
    simpa [succ] using hnextStep x
  have hsuccInj : Function.Injective succ := by
    intro x y hxy
    have ht : (succ x).1 = (succ y).1 := congrArg Subtype.val hxy
    have hx := hsuccStep x
    have hy := hsuccStep y
    rw [ht] at hx
    have hval : x.1 = y.1 := toggled_graphArc_incoming_unique G L hnodup hhead hlast ordered hx hy
    exact Subtype.ext hval
  have hsurj : Function.Surjective succ := Finite.injective_iff_surjective.mp hsuccInj
  let root : R := ⟨a, Relation.ReflTransGen.refl⟩
  obtain ⟨x, hxroot⟩ := hsurj root
  have hgraph : toggledGraphStep G L (OrderedResidualActions.actions G ordered) x.1 a := by
    have hx := hsuccStep x
    rw [hxroot] at hx
    simpa [root] using hx
  exact toggled_sourceArc_not_toggled_graphArc_incoming G L hnodup hhead hlast ordered hsource hgraph

private theorem toggledGraphReach_to_walk [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (ordered : OrderedResidualActions G L q)
    {a b : V}
    (hreach : Relation.ReflTransGen (toggledGraphStep G L (OrderedResidualActions.actions G ordered)) a b) :
    ∃ p : G.Walk a b, ∀ v ∈ p.support,
      Relation.ReflTransGen (toggledGraphStep G L (OrderedResidualActions.actions G ordered)) a v := by
  induction hreach with
  | refl =>
      refine ⟨.nil, ?_⟩
      intro v hv
      have hv' : v = a := by simpa using hv
      subst v
      exact Relation.ReflTransGen.refl
  | @tail u v hreach hstep ih =>
      obtain ⟨p, hp⟩ := ih
      refine ⟨p.concat (toggledGraphStep_adj G L ordered hstep), ?_⟩
      intro w hw
      have hw' : w ∈ p.support ∨ w = v := by
        simpa [SimpleGraph.Walk.support_concat] using hw
      rcases hw' with hw | rfl
      · exact hp w hw
      · exact hreach.tail hstep

private theorem toggledGraphReach_to_path [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (ordered : OrderedResidualActions G L q)
    {a b : V}
    (hreach : Relation.ReflTransGen (toggledGraphStep G L (OrderedResidualActions.actions G ordered)) a b) :
    ∃ p : G.Path a b, ∀ v ∈ (p : G.Walk a b).support,
      Relation.ReflTransGen (toggledGraphStep G L (OrderedResidualActions.actions G ordered)) a v := by
  obtain ⟨w, hw⟩ := toggledGraphReach_to_walk G L ordered hreach
  refine ⟨w.toPath, ?_⟩
  intro v hv
  exact hw v (Walk.support_toPath_subset w hv)

private theorem toggled_sourceArc_route [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L)) (ordered : OrderedResidualActions G L q)
    {a : V} (hsource : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sourceArc a)) :
    a ∈ A ∧ ∃ b : V, b ∈ B ∧
      toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sinkArc b) ∧
      ∃ p : G.Path a b, ∀ v ∈ (p : G.Walk a b).support,
        Relation.ReflTransGen (toggledGraphStep G L (OrderedResidualActions.actions G ordered)) a v := by
  refine ⟨toggled_sourceArc_mem_left G L hnodup hhead hlast hchain ordered hsource, ?_⟩
  obtain ⟨b, hreach, hsink⟩ := toggled_sourceArc_reaches_toggled_sink G L hnodup hhead hlast hchain ordered hsource
  obtain ⟨p, hp⟩ := toggledGraphReach_to_path G L ordered hreach
  exact ⟨b, toggled_sinkArc_mem_right G L hnodup hlast hchain ordered hsink, hsink, p, hp⟩

/-- Two selected source arcs cannot reach a common original vertex through
the toggled graph relation unless they have the same source.  This is the
confluence fact which makes the routes extracted from the toggled state
vertex-disjoint. -/
private theorem toggledGraphReach_same_source_of_meet [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {a₁ a₂ v : V}
    (hsource₁ : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sourceArc a₁))
    (hsource₂ : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sourceArc a₂))
    (hreach₁ : Relation.ReflTransGen
      (toggledGraphStep G L (OrderedResidualActions.actions G ordered)) a₁ v)
    (hreach₂ : Relation.ReflTransGen
      (toggledGraphStep G L (OrderedResidualActions.actions G ordered)) a₂ v) :
    a₁ = a₂ := by
  induction hreach₁ generalizing a₂ with
  | refl =>
      cases hreach₂ with
      | refl => rfl
      | @tail u w hreach hstep =>
          exact (toggled_sourceArc_not_toggled_graphArc_incoming G L hnodup hhead hlast
            ordered hsource₁ hstep).elim
  | @tail u w hreach₁ hstep₁ ih =>
      cases hreach₂ with
      | refl =>
          exact (toggled_sourceArc_not_toggled_graphArc_incoming G L hnodup hhead hlast
            ordered hsource₂ hstep₁).elim
      | @tail u' w' hreach₂ hstep₂ =>
          have hu : u = u' := toggled_graphArc_incoming_unique G L hnodup hhead hlast
            ordered hstep₁ hstep₂
          subst u'
          exact ih hsource₂ hreach₂

/-- Routes extracted from two distinct selected source arcs have disjoint
full vertex supports. -/
private theorem toggled_sourceArc_routes_disjoint [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (ordered : OrderedResidualActions G L q) {a₁ a₂ b₁ b₂ : V}
    (hsource₁ : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sourceArc a₁))
    (hsource₂ : toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sourceArc a₂))
    {p₁ : G.Path a₁ b₁} {p₂ : G.Path a₂ b₂}
    (hp₁ : ∀ v ∈ (p₁ : G.Walk a₁ b₁).support,
      Relation.ReflTransGen (toggledGraphStep G L (OrderedResidualActions.actions G ordered)) a₁ v)
    (hp₂ : ∀ v ∈ (p₂ : G.Walk a₂ b₂).support,
      Relation.ReflTransGen (toggledGraphStep G L (OrderedResidualActions.actions G ordered)) a₂ v)
    (hneq : a₁ ≠ a₂) :
    Disjoint {v | v ∈ (p₁ : G.Walk a₁ b₁).support}
      {v | v ∈ (p₂ : G.Walk a₂ b₂).support} := by
  rw [Set.disjoint_left]
  intro v hv₁ hv₂
  exact hneq (toggledGraphReach_same_source_of_meet G L hnodup hhead hlast ordered
    hsource₁ hsource₂ (hp₁ v hv₁) (hp₂ v hv₂))

private theorem toggled_routes_to_linkage [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {q : List (SplitVertex V)} (hnodup : q.Nodup)
    (hhead : q.head? = some .source) (hlast : q.getLast? = some .sink)
    (hchain : q.Chain' (residualStep G L)) (ordered : OrderedResidualActions G L q)
    {newSource : V} (hadd : ResidualAction.add (.sourceArc newSource) ∈
      OrderedResidualActions.actions G ordered) :
    Nonempty (ABLinkageData G A B (m + 1)) := by
  classical
  let sources := toggledSourceVertices G L (OrderedResidualActions.actions G ordered)
  have hcard : sources.card = m + 1 :=
    card_toggledSourceVertices G L hnodup hhead hlast hchain ordered hadd
  let e : Fin (m + 1) ≃ {a // a ∈ sources} :=
    (Finset.equivFinOfCardEq hcard).symm
  let src : Fin (m + 1) → V := fun i => (e i).1
  have hsrc_selected : ∀ i, toggledSplitArc G L (OrderedResidualActions.actions G ordered)
      (.sourceArc (src i)) := by
    intro i
    simpa only [sources, toggledSourceVertices, Finset.mem_filter, Finset.mem_univ, true_and, src] using (e i).2
  have hsrc_mem : ∀ i, src i ∈ A := fun i =>
    toggled_sourceArc_mem_left G L hnodup hhead hlast hchain ordered (hsrc_selected i)
  have hsrc_injective : Function.Injective src := by
    intro i j hij
    apply e.injective
    apply Subtype.ext
    exact hij
  have hroutes : ∀ i, ∃ b : V, b ∈ B ∧
      toggledSplitArc G L (OrderedResidualActions.actions G ordered) (.sinkArc b) ∧
      ∃ p : G.Path (src i) b, ∀ v ∈ (p : G.Walk (src i) b).support,
        Relation.ReflTransGen (toggledGraphStep G L (OrderedResidualActions.actions G ordered))
          (src i) v := by
    intro i
    exact (toggled_sourceArc_route G L hnodup hhead hlast hchain ordered (hsrc_selected i)).2
  choose dst hdst_mem hdst_selected path hpath using hroutes
  refine ⟨{
    src := src
    dst := dst
    path := path
    src_mem := hsrc_mem
    dst_mem := hdst_mem
    src_injective := hsrc_injective
    dst_injective := ?_
    disjoint_support := ?_ }⟩
  · intro i j hd
    apply hsrc_injective
    apply toggledGraphReach_same_source_of_meet G L hnodup hhead hlast ordered
      (hsrc_selected i) (hsrc_selected j)
    · exact hpath i (dst i) ((path i : G.Walk (src i) (dst i)).end_mem_support)
    · rw [hd]
      exact hpath j (dst j) ((path j : G.Walk (src j) (dst j)).end_mem_support)
  · intro i j hij
    apply toggled_sourceArc_routes_disjoint G L hnodup hhead hlast ordered
      (hsrc_selected i) (hsrc_selected j) (hpath i) (hpath j)
    intro heq
    exact hij (hsrc_injective heq)
theorem augment_of_reachable_sink [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    (hsink : (.sink : SplitVertex V) ∈ altReach G L) :
    Nonempty (ABLinkageData G A B (m + 1)) := by
  obtain ⟨q, hnodup, hhead, hlast, hchain⟩ :=
    simple_residual_source_sink_trace G L hsink
  obtain ⟨ordered⟩ := simple_trace_actions G L q hchain
  obtain ⟨newSource, _, _, hadd⟩ :=
    simple_trace_starts_with_unused_source G L hhead hlast hchain ordered
  exact toggled_routes_to_linkage G L hnodup hhead hlast hchain ordered hadd
/-- The canonical empty linkage starts the four successive augmentation
steps. -/
def emptyABLinkage (A B : Finset V) : ABLinkageData G A B 0 where
  src := Fin.elim0
  dst := Fin.elim0
  path := by
    intro i
    exact i.elim0
  src_mem := by
    intro i
    exact i.elim0
  dst_mem := by
    intro i
    exact i.elim0
  src_injective := by
    intro i
    exact Fin.elim0 i
  dst_injective := by
    intro i
    exact Fin.elim0 i
  disjoint_support := by
    intro i
    exact Fin.elim0 i

/-- Unit-capacity arcs of the split network.  Graph-adjacency arcs are not
included because they have unrestricted capacity. -/
inductive UnitArc (V : Type*) where
  | sourceArc : V → UnitArc V
  | vertexArc : V → UnitArc V
  | sinkArc : V → UnitArc V

def unitArcTail : UnitArc V → SplitVertex V
  | .sourceArc _ => .source
  | .vertexArc v => .vin v
  | .sinkArc v => .vout v

def unitArcHead : UnitArc V → SplitVertex V
  | .sourceArc v => .vin v
  | .vertexArc v => .vout v
  | .sinkArc _ => .sink

def unitArcVertex : UnitArc V → V
  | .sourceArc v => v
  | .vertexArc v => v
  | .sinkArc v => v

/-- The source and sink unit arcs exist only for the corresponding terminal
sets; every vertex has its own split capacity arc. -/
def unitArcAdmissible (A B : Finset V) : UnitArc V → Prop
  | .sourceArc v => v ∈ A
  | .vertexArc _ => True
  | .sinkArc v => v ∈ B

/-- A unit-capacity arc crossing the residual reachable cut. -/
def cutUnitArc {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) (e : UnitArc V) : Prop :=
  unitArcAdmissible A B e ∧
    unitArcTail e ∈ altReach G L ∧
    unitArcHead e ∉ altReach G L

/-- The vertex labels of all crossing unit-capacity arcs. -/
noncomputable def cutVertices [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) : Finset V := by
  classical
  exact Finset.univ.filter fun v =>
    ∃ e : UnitArc V, cutUnitArc G L e ∧ unitArcVertex e = v

theorem mem_cutVertices_iff [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) {v : V} :
    v ∈ cutVertices G L ↔
      ∃ e : UnitArc V, cutUnitArc G L e ∧ unitArcVertex e = v := by
  classical
  simp [cutVertices]

private theorem linkageUsedDart_of_mem_path_darts
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) (i : Fin m)
    {d : G.Dart} (hd : d ∈ (L.path i : G.Walk (L.src i) (L.dst i)).darts) :
    linkageUsedDart G L d.fst d.snd :=
  ⟨i, d, hd, rfl, rfl⟩
/-- Along a selected graph dart, residual reachability is equivalent at the
forward split-output and split-input. -/
private theorem linkageUsedDart_reach_iff {A B : Finset V} {m : Nat}
    (L : ABLinkageData G A B m) {u v : V} (hused : linkageUsedDart G L u v) :
    (.vout u : SplitVertex V) ∈ altReach G L ↔ .vin v ∈ altReach G L := by
  constructor
  · intro h
    exact altReach_closed G L h (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
      ⟨u, v, linkageUsedDart_adj G L hused, rfl, rfl⟩)))))
  · intro h
    exact altReach_closed G L h (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
      ⟨u, v, hused, rfl, rfl⟩))))))
private theorem cutUnitArc_selected [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) {e : UnitArc V}
    (hcut : cutUnitArc G L e) :
    match e with
    | .sourceArc a => linkageUsedSource G L a
    | .vertexArc v => linkageUsedVertex G L v
    | .sinkArc b => linkageUsedSink G L b := by
  rcases hcut with ⟨hadmissible, htail, hhead⟩
  cases e with
  | sourceArc a =>
      by_contra hused
      exact hhead (altReach_closed G L htail (Or.inl ⟨a, hadmissible, hused, rfl, rfl⟩))
  | vertexArc v =>
      by_contra hused
      exact hhead (altReach_closed G L htail (Or.inr (Or.inr (Or.inl ⟨v, hused, rfl, rfl⟩))) )
  | sinkArc b =>
      by_contra hused
      exact hhead (altReach_closed G L htail
        (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨b, hadmissible, hused, rfl, rfl⟩))))))))

private theorem selectedUnitArc_head_reach_implies_tail_reach
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) {e : UnitArc V}
    (hselected : match e with
      | .sourceArc a => linkageUsedSource G L a
      | .vertexArc v => linkageUsedVertex G L v
      | .sinkArc b => linkageUsedSink G L b)
    (hhead : unitArcHead e ∈ altReach G L) : unitArcTail e ∈ altReach G L := by
  cases e with
  | sourceArc a =>
      exact altReach_closed G L hhead (Or.inr (Or.inl ⟨a, hselected, rfl, rfl⟩))
  | vertexArc v =>
      exact altReach_closed G L hhead (Or.inr (Or.inr (Or.inr (Or.inl ⟨v, hselected, rfl, rfl⟩))))
  | sinkArc b =>
      exact altReach_closed G L hhead
        (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr ⟨b, hselected, rfl, rfl⟩)))))))
private theorem linkageUsedVertex_vout_not_reach_of_vin_not_reach
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) {v : V}
    (hused : linkageUsedVertex G L v) (hvin : (.vin v : SplitVertex V) ∉ altReach G L) :
    (.vout v : SplitVertex V) ∉ altReach G L := by
  intro hvout
  apply hvin
  exact selectedUnitArc_head_reach_implies_tail_reach G L (e := .vertexArc v) hused hvout
private theorem selectedWalkSuffix_dart_heads_not_reachable
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) (i : Fin m)
    {u z : V} (q : G.Walk u z)
    (hsub : ∀ d, d ∈ q.darts → d ∈ (L.path i : G.Walk (L.src i) (L.dst i)).darts)
    (hu : (.vout u : SplitVertex V) ∉ altReach G L) :
    ∀ d ∈ q.darts, (.vin d.snd : SplitVertex V) ∉ altReach G L := by
  induction q with
  | nil => simp
  | @cons u v z huv q ih =>
      let firstDart : G.Dart := ⟨(u, v), huv⟩
      have hfirstCurrent : firstDart ∈ (Walk.cons huv q).darts := by
        simp [firstDart, Walk.darts_cons]
      have hfirstOriginal : firstDart ∈ (L.path i : G.Walk (L.src i) (L.dst i)).darts :=
        hsub firstDart hfirstCurrent
      have hused : linkageUsedDart G L u v := by
        simpa [firstDart] using linkageUsedDart_of_mem_path_darts G L i hfirstOriginal
      have hvin : (.vin v : SplitVertex V) ∉ altReach G L := by
        intro hv
        exact hu ((linkageUsedDart_reach_iff G L hused).2 hv)
      have hvout : (.vout v : SplitVertex V) ∉ altReach G L :=
        linkageUsedVertex_vout_not_reach_of_vin_not_reach G L
          (linkageUsedDart_snd_usedVertex G L hused) hvin
      have hsubTail : ∀ e, e ∈ q.darts →
          e ∈ (L.path i : G.Walk (L.src i) (L.dst i)).darts := by
        intro e he
        apply hsub e
        simp [Walk.darts_cons, he]
      intro d hd
      simp only [Walk.darts_cons, List.mem_cons] at hd
      rcases hd with hd | hd
      · subst d
        simpa [firstDart] using hvin
      · exact ih hsubTail hvout d hd
private theorem cutUnitArc_head_not_later_on_selected_subwalk [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) (i : Fin m)
    {u v z : V} (huv : G.Adj u v) (q : G.Walk v z)
    (hsub : ∀ d, d ∈ (Walk.cons huv q).darts →
      d ∈ (L.path i : G.Walk (L.src i) (L.dst i)).darts)
    {e e' : UnitArc V}
    (he : cutUnitArc G L e) (he' : cutUnitArc G L e')
    (heu : unitArcVertex e = u)
    (he'Later : unitArcVertex e' ∈ q.support)
    (hne : unitArcVertex e' ≠ u) : False := by
  let firstDart : G.Dart := ⟨(u, v), huv⟩
  have hfirstCurrent : firstDart ∈ (Walk.cons huv q).darts := by
    simp [firstDart, Walk.darts_cons]
  have hfirstOriginal : firstDart ∈
      (L.path i : G.Walk (L.src i) (L.dst i)).darts :=
    hsub firstDart hfirstCurrent
  have hfirstUsed : linkageUsedDart G L u v := by
    simpa [firstDart] using linkageUsedDart_of_mem_path_darts G L i hfirstOriginal
  have hvout : (.vout u : SplitVertex V) ∉ altReach G L := by
    cases e with
    | sourceArc a =>
        simp only [unitArcVertex] at heu
        subst u
        exact linkageUsedVertex_vout_not_reach_of_vin_not_reach G L
          (linkageUsedDart_fst_usedVertex G L hfirstUsed) he.2.2
    | vertexArc a =>
        simp only [unitArcVertex] at heu
        subst u
        exact he.2.2
    | sinkArc a =>
        simp only [unitArcVertex] at heu
        subst u
        exact (linkageUsedDart_fst_not_usedSink G L hfirstUsed
          (cutUnitArc_selected G L he)).elim
  have htailMem : unitArcVertex e' ∈ (Walk.cons huv q).support.tail := by
    simpa [Walk.support_cons] using he'Later
  have hdartMem : unitArcVertex e' ∈ (Walk.cons huv q).darts.map (·.snd) := by
    rw [(Walk.cons huv q).map_snd_darts]
    exact htailMem
  rcases List.mem_map.mp hdartMem with ⟨d, hd, hdsnd⟩
  have hvin : (.vin (unitArcVertex e') : SplitVertex V) ∉ altReach G L := by
    simpa [hdsnd] using
      selectedWalkSuffix_dart_heads_not_reachable G L i (Walk.cons huv q) hsub hvout d hd
  have hdartUsed : linkageUsedDart G L d.fst d.snd :=
    linkageUsedDart_of_mem_path_darts G L i (hsub d hd)
  cases e' with
  | sourceArc a =>
      simp only [unitArcVertex] at hdsnd hvin
      subst a
      exact linkageUsedDart_snd_not_usedSource G L hdartUsed
        (cutUnitArc_selected G L he')
  | vertexArc a =>
      simp only [unitArcVertex, unitArcTail] at hvin he'
      exact hvin he'.2.1
  | sinkArc a =>
      simp only [unitArcVertex] at hdsnd hvin
      subst a
      exact (linkageUsedVertex_vout_not_reach_of_vin_not_reach G L
        (linkageUsedDart_snd_usedVertex G L hdartUsed) hvin) he'.2.1

private theorem cutUnitArc_same_selected_subwalk_vertex_eq [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) (i : Fin m)
    {u z : V} (q : G.Walk u z)
    (hsub : ∀ d, d ∈ q.darts →
      d ∈ (L.path i : G.Walk (L.src i) (L.dst i)).darts)
    {e e' : UnitArc V}
    (he : cutUnitArc G L e) (he' : cutUnitArc G L e')
    (hei : unitArcVertex e ∈ q.support)
    (he'i : unitArcVertex e' ∈ q.support) :
    unitArcVertex e = unitArcVertex e' := by
  induction q generalizing e e' with
  | @nil a =>
      simp only [Walk.support_nil, List.mem_singleton] at hei he'i
      exact hei.trans he'i.symm
  | @cons u v z huv q ih =>
      simp only [Walk.support_cons, List.mem_cons] at hei he'i
      rcases hei with hei | hei
      · rcases he'i with he'i | he'i
        · exact hei.trans he'i.symm
        · by_cases hEq : unitArcVertex e = unitArcVertex e'
          · exact hEq
          · exact (cutUnitArc_head_not_later_on_selected_subwalk G L i huv q hsub
              he he' hei he'i (by
                intro h
                apply hEq
                exact hei.trans h.symm)).elim
      · rcases he'i with he'i | he'i
        · by_cases hEq : unitArcVertex e = unitArcVertex e'
          · exact hEq
          · exact (cutUnitArc_head_not_later_on_selected_subwalk G L i huv q hsub
              he' he he'i hei (by
                intro h
                apply hEq
                exact h.trans he'i.symm)).elim
        · have hsubTail : ∀ d, d ∈ q.darts →
              d ∈ (L.path i : G.Walk (L.src i) (L.dst i)).darts := by
            intro d hd
            apply hsub d
            simp [Walk.darts_cons, hd]
          exact ih hsubTail he he' hei he'i

private theorem cutUnitArc_same_path_vertex_eq [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {e e' : UnitArc V} {i : Fin m}
    (he : cutUnitArc G L e) (he' : cutUnitArc G L e')
    (hei : unitArcVertex e ∈ ((L.path i : G.Walk (L.src i) (L.dst i)).support))
    (he'i : unitArcVertex e' ∈ ((L.path i : G.Walk (L.src i) (L.dst i)).support)) :
    unitArcVertex e = unitArcVertex e' := by
  exact cutUnitArc_same_selected_subwalk_vertex_eq G L i
    (L.path i : G.Walk (L.src i) (L.dst i)) (fun d hd => hd) he he' hei he'i
/-- A residual-cut capacity arc is occupied by one of the original linkage
paths.  Otherwise its forward residual transition would cross the cut. -/
private theorem cutUnitArc_assigned [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) {e : UnitArc V}
    (hcut : cutUnitArc G L e) :
    ∃ i, unitArcVertex e ∈ ((L.path i : G.Walk (L.src i) (L.dst i)).support) := by
  rcases hcut with ⟨hadmissible, htail, hhead⟩
  cases e with
  | sourceArc a =>
      by_cases hused : linkageUsedSource G L a
      · rcases hused with ⟨i, hi⟩
        refine ⟨i, ?_⟩
        rw [← hi]
        exact (L.path i : G.Walk (L.src i) (L.dst i)).start_mem_support
      · have hstep : residualStep G L .source (.vin a) := Or.inl ⟨a, hadmissible, hused, rfl, rfl⟩
        exact (hhead (altReach_closed G L htail hstep)).elim
  | vertexArc v =>
      by_cases hused : linkageUsedVertex G L v
      · exact hused
      · have hstep : residualStep G L (.vin v) (.vout v) := Or.inr (Or.inr (Or.inl ⟨v, hused, rfl, rfl⟩))
        exact (hhead (altReach_closed G L htail hstep)).elim
  | sinkArc b =>
      by_cases hused : linkageUsedSink G L b
      · rcases hused with ⟨i, hi⟩
        refine ⟨i, ?_⟩
        rw [← hi]
        exact (L.path i : G.Walk (L.src i) (L.dst i)).end_mem_support
      · have hstep : residualStep G L (.vout b) .sink :=
          Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨b, hadmissible, hused, rfl, rfl⟩))))))
        exact (hhead (altReach_closed G L htail hstep)).elim
private theorem cut_vertices_card_le_linkage [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) :
    (cutVertices G L).card ≤ m := by
  classical
  let chosenArc : {v // v ∈ cutVertices G L} → UnitArc V := fun x =>
    Classical.choose ((mem_cutVertices_iff G L).1 x.2)
  have hchosenArc : ∀ x : {v // v ∈ cutVertices G L},
      cutUnitArc G L (chosenArc x) ∧ unitArcVertex (chosenArc x) = x.1 := by
    intro x
    simpa only [chosenArc] using Classical.choose_spec ((mem_cutVertices_iff G L).1 x.2)
  let owner : {v // v ∈ cutVertices G L} → Fin m := fun x =>
    Classical.choose (cutUnitArc_assigned G L (hchosenArc x).1)
  have howner : ∀ x : {v // v ∈ cutVertices G L},
      unitArcVertex (chosenArc x) ∈
        ((L.path (owner x) : G.Walk (L.src (owner x)) (L.dst (owner x))).support) := by
    intro x
    simpa only [owner] using
      Classical.choose_spec (cutUnitArc_assigned G L (hchosenArc x).1)
  have hinjective : Function.Injective owner := by
    intro x y hxy
    apply Subtype.ext
    have hownerY := howner y
    rw [← hxy] at hownerY
    have hlabels : unitArcVertex (chosenArc x) = unitArcVertex (chosenArc y) :=
      cutUnitArc_same_path_vertex_eq G L (hchosenArc x).1 (hchosenArc y).1
        (howner x) hownerY
    exact (hchosenArc x).2.symm.trans (hlabels.trans (hchosenArc y).2)
  have hcard : Fintype.card {v // v ∈ cutVertices G L} ≤ Fintype.card (Fin m) :=
    Fintype.card_le_of_injective owner hinjective
  simpa using hcard
private theorem unitArc_head_reachable_of_tail_reachable_of_vertex_not_cut
    [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) {e : UnitArc V}
    (hadmissible : unitArcAdmissible A B e)
    (htail : unitArcTail e ∈ altReach G L)
    (hnotcut : unitArcVertex e ∉ cutVertices G L) :
    unitArcHead e ∈ altReach G L := by
  by_contra hhead
  apply hnotcut
  exact (mem_cutVertices_iff G L).2 ⟨e, ⟨hadmissible, htail, hhead⟩, rfl⟩

private theorem walk_vout_reachable_of_avoids_cut [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    {u z : V} (p : G.Walk u z)
    (hvin : (.vin u : SplitVertex V) ∈ altReach G L)
    (havoid : ∀ v, v ∈ p.support → v ∉ cutVertices G L) :
    (.vout z : SplitVertex V) ∈ altReach G L := by
  induction p with
  | @nil u =>
      simpa only [unitArcTail, unitArcHead] using
        (unitArc_head_reachable_of_tail_reachable_of_vertex_not_cut G L
          (e := .vertexArc u) trivial hvin
          (havoid u Walk.nil.start_mem_support))
  | @cons u v z huv q ih =>
      have huNotCut : u ∉ cutVertices G L := by
        apply havoid u
        simp [Walk.support_cons]
      have hvoutU : (.vout u : SplitVertex V) ∈ altReach G L :=
        unitArc_head_reachable_of_tail_reachable_of_vertex_not_cut G L
          (e := .vertexArc u) trivial hvin huNotCut
      have hvinV : (.vin v : SplitVertex V) ∈ altReach G L :=
        altReach_closed G L hvoutU
          (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨u, v, huv, rfl, rfl⟩)))))
      have havoidTail : ∀ x, x ∈ q.support → x ∉ cutVertices G L := by
        intro x hx
        apply havoid x
        simp [Walk.support_cons, hx]
      exact ih hvinV havoidTail
/-- If the residual sink is unreachable, the crossing unit-capacity vertices
form an `A`--`B` separator. -/
private theorem cut_vertices_is_ABSeparator [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    (hsink : (.sink : SplitVertex V) ∉ altReach G L) :
    ABSeparator G A B (cutVertices G L) := by
  intro a ha b hb p
  by_contra hno
  have havoid : ∀ v, v ∈ p.support → v ∉ cutVertices G L := by
    intro v hv hcut
    exact hno ⟨v, hcut, hv⟩
  have hsource : (.source : SplitVertex V) ∈ altReach G L :=
    Relation.ReflTransGen.refl
  have haNotCut : a ∉ cutVertices G L :=
    havoid a p.start_mem_support
  have hva : (.vin a : SplitVertex V) ∈ altReach G L :=
    unitArc_head_reachable_of_tail_reachable_of_vertex_not_cut G L
      (e := .sourceArc a) ha hsource haNotCut
  have hvb : (.vout b : SplitVertex V) ∈ altReach G L :=
    walk_vout_reachable_of_avoids_cut G L p hva havoid
  have hbNotCut : b ∉ cutVertices G L :=
    havoid b p.end_mem_support
  have hsinkReach : (.sink : SplitVertex V) ∈ altReach G L :=
    unitArc_head_reachable_of_tail_reachable_of_vertex_not_cut G L
      (e := .sinkArc b) hb hvb hbNotCut
  exact hsink hsinkReach

 theorem separator_of_sink_unreachable [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m)
    (hsink : (.sink : SplitVertex V) ∉ altReach G L) :
    ∃ S : Finset V, S.card ≤ m ∧ ABSeparator G A B S := by
  exact ⟨cutVertices G L, cut_vertices_card_le_linkage G L,
    cut_vertices_is_ABSeparator G L hsink⟩

/-- The zero-linkage augmentation step is already a complete Menger
alternative: either an `A`--`B` path starts a linkage, or the empty set meets
every such walk. -/
theorem augment_or_separator_zero [DecidableEq V] (A B : Finset V) :
    Nonempty (ABLinkageData G A B 1) ∨
      ∃ S : Finset V, S.card ≤ 0 ∧ ABSeparator G A B S := by
  classical
  by_cases hpath : ∃ a ∈ A, ∃ b ∈ B, ∃ p : G.Walk a b, True
  · rcases hpath with ⟨a, ha, b, hb, p, -⟩
    refine Or.inl ⟨{
      src := fun _ => a
      dst := fun _ => b
      path := fun _ => p.toPath
      src_mem := fun _ => ha
      dst_mem := fun _ => hb
      src_injective := ?_
      dst_injective := ?_
      disjoint_support := ?_ }⟩
    · intro i j _
      exact Subsingleton.elim _ _
    · intro i j _
      exact Subsingleton.elim _ _
    · intro i j hij
      exact (hij (Subsingleton.elim _ _)).elim
  · right
    refine ⟨∅, by simp, ?_⟩
    intro a ha b hb p
    exact (hpath ⟨a, ha, b, hb, p, trivial⟩).elim

/-- A finite linkage either augments by one path or yields a separator of at
most its current size. -/
theorem augment_or_separator [Fintype V] [DecidableEq V]
    {A B : Finset V} {m : Nat} (L : ABLinkageData G A B m) :
    Nonempty (ABLinkageData G A B (m + 1)) ∨
      ∃ S : Finset V, S.card ≤ m ∧ ABSeparator G A B S := by
  by_cases hsink : (.sink : SplitVertex V) ∈ altReach G L
  · exact Or.inl (augment_of_reachable_sink G L hsink)
  · exact Or.inr (separator_of_sink_unreachable G L hsink)

/-- Four successive augmentation steps yield four vertex-disjoint `A`--`B`
paths when no separator of size below four exists. -/
theorem finiteMenger_four_sets [Fintype V] [DecidableEq V]
    (A B : Finset V)
    (hA : 4 ≤ A.card)
    (hB : 4 ≤ B.card)
    (hAB : Disjoint A B)
    (hNoSmallSeparator :
      ∀ S : Finset V, S.card < 4 → ¬ ABSeparator G A B S) :
    FourABLinkage G A B := by
  rcases augment_or_separator G (emptyABLinkage G A B) with h0 | ⟨S, hS, hsep⟩
  · rcases h0 with ⟨L1⟩
    rcases augment_or_separator G L1 with h1 | ⟨S, hS, hsep⟩
    · rcases h1 with ⟨L2⟩
      rcases augment_or_separator G L2 with h2 | ⟨S, hS, hsep⟩
      · rcases h2 with ⟨L3⟩
        rcases augment_or_separator G L3 with h3 | ⟨S, hS, hsep⟩
        · exact h3
        · exact (hNoSmallSeparator S (by omega) hsep).elim
      · exact (hNoSmallSeparator S (by omega) hsep).elim
    · exact (hNoSmallSeparator S (by omega) hsep).elim
  · exact (hNoSmallSeparator S (by omega) hsep).elim

/-- The two-path finite Menger specialization needed by the minimum-degree-three
special case of source Lemma 3.2.  It deliberately reuses the existing
one-step augmentation engine rather than introducing a general `n`-path API. -/
private theorem finiteMenger_two_sets [Fintype V] [DecidableEq V]
    (A B : Finset V)
    (hNoSmallSeparator :
      ∀ S : Finset V, S.card < 2 → ¬ ABSeparator G A B S) :
    Nonempty (ABLinkageData G A B 2) := by
  rcases augment_or_separator G (emptyABLinkage G A B) with h0 | ⟨S, hS, hsep⟩
  · rcases h0 with ⟨L1⟩
    rcases augment_or_separator G L1 with h1 | ⟨S, hS, hsep⟩
    · exact h1
    · exact (hNoSmallSeparator S (by omega) hsep).elim
  · exact (hNoSmallSeparator S (by omega) hsep).elim

/-- A longest simple path starting at a fixed vertex, the finite extremal
choice used in the first stage of the source Lemma 3.2 argument. -/
private theorem exists_longestPathFrom [Fintype V] [DecidableEq V] (w : V) :
    ∃ (x : V) (P : G.Walk w x), P.IsPath ∧
      ∀ (y : V) (Q : G.Walk w y), Q.IsPath → Q.length ≤ P.length := by
  classical
  let lengths : Finset ℕ := (Finset.range (Fintype.card V)).filter fun n =>
    ∃ x, ∃ P : G.Walk w x, P.IsPath ∧ P.length = n
  have hnil : 0 ∈ lengths := by
    simp only [lengths, Finset.mem_filter, Finset.mem_range]
    exact ⟨Fintype.card_pos_iff.mpr ⟨w⟩, w, Walk.nil, by simp, by simp⟩
  let n : ℕ := lengths.max' ⟨0, hnil⟩
  have hn : n ∈ lengths := by
    exact lengths.max'_mem ⟨0, hnil⟩
  simp only [lengths, Finset.mem_filter, Finset.mem_range] at hn
  obtain ⟨x, P, hP, hP_length⟩ := hn.2
  refine ⟨x, P, hP, ?_⟩
  intro y Q hQ
  rw [hP_length]
  apply lengths.le_max'
  simp only [lengths, Finset.mem_filter]
  refine ⟨Finset.mem_range.mpr hQ.length_lt, ?_⟩
  exact ⟨y, Q, hQ, rfl⟩
/-- A neighbour of the terminal vertex of a longest path from `w` already lies
on that path; otherwise adjoining its incident edge makes a longer path. -/
private theorem longestPath_endpoint_neighbor_mem_support [Fintype V] [DecidableEq V]
    {w x y : V} {P : G.Walk w x} (hP : P.IsPath)
    (hmax : ∀ (x' : V) (Q : G.Walk w x'), Q.IsPath → Q.length ≤ P.length)
    (hxy : G.Adj x y) :
    y ∈ P.support := by
  by_contra hy
  have hlonger : (P.concat hxy).IsPath := by
    apply Walk.IsPath.mk'
    rw [Walk.support_concat]
    exact List.Nodup.concat hy hP.support_nodup
  have hle := hmax y (P.concat hxy) hlonger
  simp only [Walk.length_concat] at hle
  omega
/-- The global lexicographic extremal choice in source Lemma 3.2: among all
longest simple paths from `w`, select an endpoint-neighbour with least support
index.  This is the source's global, not path-local, tie-break. -/
private theorem exists_extremalLongestPathFrom [Fintype V] [DecidableEq V] [DecidableRel G.Adj]
    (hdegreeTwo : ∀ v, 2 ≤ G.degree v) (w : V) :
    ∃ x, ∃ y, ∃ P : G.Walk w x,
      P.IsPath ∧
      G.Adj x y ∧
      y ∈ P.support ∧
      (∀ x' (Q : G.Walk w x'), Q.IsPath → Q.length ≤ P.length) ∧
      (∀ x' y' (Q : G.Walk w x'),
        Q.IsPath →
        Q.length = P.length →
        G.Adj x' y' →
        y' ∈ Q.support →
        List.idxOf y P.support ≤ List.idxOf y' Q.support) := by
  classical
  obtain ⟨x₀, P₀, hP₀, hmax₀⟩ := exists_longestPathFrom G w
  obtain ⟨y₀, hx₀y₀⟩ := (G.degree_pos_iff_exists_adj x₀).mp
    (lt_of_lt_of_le (by decide) (hdegreeTwo x₀))
  have hy₀P₀ : y₀ ∈ P₀.support :=
    longestPath_endpoint_neighbor_mem_support G hP₀ hmax₀ hx₀y₀
  let ranks : Finset ℕ := (Finset.range (Fintype.card V)).filter fun r =>
    ∃ x, ∃ y, ∃ P : G.Walk w x,
      P.IsPath ∧ P.length = P₀.length ∧ G.Adj x y ∧ y ∈ P.support ∧
        List.idxOf y P.support = r
  have hranks : List.idxOf y₀ P₀.support ∈ ranks := by
    simp only [ranks, Finset.mem_filter]
    refine ⟨Finset.mem_range.mpr ?_, x₀, y₀, P₀, hP₀, rfl, hx₀y₀, hy₀P₀, rfl⟩
    calc
      List.idxOf y₀ P₀.support < P₀.support.length := List.idxOf_lt_length_iff.mpr hy₀P₀
      _ = P₀.length + 1 := Walk.length_support P₀
      _ ≤ Fintype.card V := Nat.succ_le_of_lt hP₀.length_lt
  let r : ℕ := ranks.min' ⟨_, hranks⟩
  have hr : r ∈ ranks := ranks.min'_mem ⟨_, hranks⟩
  simp only [ranks, Finset.mem_filter, Finset.mem_range] at hr
  obtain ⟨x, y, P, hP, hP_length, hxy, hyP, hy_rank⟩ := hr.2
  refine ⟨x, y, P, hP, hxy, hyP, ?_, ?_⟩
  · intro x' Q hQ
    have hle := hmax₀ x' Q hQ
    omega
  · intro x' y' Q hQ hQ_length hx'y' hy'Q
    rw [hy_rank]
    apply ranks.min'_le
    simp only [ranks, Finset.mem_filter]
    refine ⟨Finset.mem_range.mpr ?_, x', y', Q, hQ, ?_, hx'y', hy'Q, rfl⟩
    · calc
        List.idxOf y' Q.support < Q.support.length := List.idxOf_lt_length_iff.mpr hy'Q
        _ = Q.length + 1 := Walk.length_support Q
        _ ≤ Fintype.card V := Nat.succ_le_of_lt hQ.length_lt
    · omega
/-- The direct globality consequence needed by the source reroute: an equally
long endpoint-neighbour path cannot have a strictly smaller support index. -/
private theorem extremalLongestPath_not_closer [DecidableEq V]
    {w x y x' y' : V} {P : G.Walk w x} {Q : G.Walk w x'}
    (hminimal : ∀ x' y' (Q : G.Walk w x'),
      Q.IsPath →
      Q.length = P.length →
      G.Adj x' y' →
      y' ∈ Q.support →
      List.idxOf y P.support ≤ List.idxOf y' Q.support)
    (hQ : Q.IsPath)
    (hQ_length : Q.length = P.length)
    (hx'y' : G.Adj x' y')
    (hy'Q : y' ∈ Q.support)
    (hcloser : List.idxOf y' Q.support < List.idxOf y P.support) :
    False := by
  have hle := hminimal x' y' Q hQ hQ_length hx'y' hy'Q
  omega
/-- The `y`--`x` subpath `Q` used in the source Lemma 3.2 cycle construction. -/
private def sourceLemma32Suffix [DecidableEq V] {w x y : V} (P : G.Walk w x)
    (hy : y ∈ P.support) : G.Walk y x :=
  P.dropUntil y hy

/-- A simple path can revisit its start in a suffix only when that suffix starts there. -/
private theorem sourceLemma32_start_eq_of_mem_suffix [DecidableEq V]
    {w x y : V} {P : G.Walk w x} (hP : P.IsPath) (hy : y ∈ P.support)
    (hw : w ∈ (sourceLemma32Suffix G P hy).support) : w = y := by
  induction P generalizing y with
  | nil =>
      simp only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at hy
      exact hy.symm
  | @cons w a x hwa q ih =>
      have hq : q.IsPath := hP.of_cons
      simp only [Walk.support_cons, List.mem_cons] at hy
      by_cases hyw : y = w
      · exact hyw.symm
      · have hyq : y ∈ q.support := hy.resolve_left hyw
        have hwq : w ∈ (q.dropUntil y hyq).support := by
          simpa [sourceLemma32Suffix, Walk.dropUntil, dif_neg (Ne.symm hyw)] using hw
        have hwqSupport : w ∈ q.support := q.support_dropUntil_subset hyq hwq
        exact False.elim ((Walk.cons_isPath_iff hwa q).mp hP |>.2 hwqSupport)

private theorem sourceLemma32Suffix_isPath [DecidableEq V] {w x y : V} {P : G.Walk w x}
    (hP : P.IsPath) (hy : y ∈ P.support) :
    (sourceLemma32Suffix G P hy).IsPath := by
  simpa [sourceLemma32Suffix] using hP.dropUntil hy
/-- A vertex of a simple walk outside the suffix beginning at `y` occurs
strictly before `y`; this is the local order fact needed for Lemma 3.2. -/
private theorem sourceLemma32_idxOf_lt_of_not_suffix [DecidableEq V]
    {w x y v : V} {P : G.Walk w x}
    (hP : P.IsPath)
    (hy : y ∈ P.support)
    (hv : v ∈ P.support)
    (hvNotQ : v ∉ (sourceLemma32Suffix G P hy).support) :
    List.idxOf v P.support < List.idxOf y P.support := by
  induction P generalizing y v with
  | nil =>
      simp only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at hy hv
      subst_vars
      simp [sourceLemma32Suffix] at hvNotQ
  | @cons u u' x huv q ih =>
      have hq : q.IsPath := hP.of_cons
      simp only [Walk.support_cons, List.mem_cons] at hy hv
      by_cases hyu : y = u
      · subst y
        simp [sourceLemma32Suffix, Walk.dropUntil] at hvNotQ
        exact (hv.elim hvNotQ.1 hvNotQ.2).elim
      · have hyTail : y ∈ q.support := hy.resolve_left hyu
        by_cases hvu : v = u
        · subst v
          simp [List.idxOf_cons, Ne.symm hyu]
        · have hvTail : v ∈ q.support := hv.resolve_left hvu
          have hvNotQTail : v ∉ (sourceLemma32Suffix G q hyTail).support := by
            simpa only [sourceLemma32Suffix, Walk.dropUntil, dif_neg (Ne.symm hyu)] using hvNotQ
          have hlt := ih hq hyTail hvTail hvNotQTail
          change List.idxOf v (u :: q.support) < List.idxOf y (u :: q.support)
          simpa [List.idxOf_cons, Ne.symm hvu, Ne.symm hyu] using Nat.succ_lt_succ hlt
/-- Source-Lemma-3.2-local decomposition at an interior vertex of a walk.
The successor is exposed by directly case-splitting `dropUntil`. -/
private theorem sourceLemma32_splitAtSuccessor [DecidableEq V]
    {w x v : V} (P : G.Walk w x) (hv : v ∈ P.support) (hvx : v ≠ x) :
    ∃ vnext : V, ∃ hvnext : G.Adj v vnext, ∃ tail : G.Walk vnext x,
      P.dropUntil v hv = Walk.cons hvnext tail ∧
        (P.takeUntil v hv).append (Walk.cons hvnext tail) = P := by
  cases hdrop : P.dropUntil v hv with
  | nil =>
      have hzero : (P.dropUntil x hv).length = 0 := by
        rw [hdrop]
        rfl
      exact (hvx rfl).elim
  | cons hvnext tail =>
      refine ⟨_, hvnext, tail, rfl, ?_⟩
      simpa [hdrop] using P.take_spec hv

/-- The source-local suffix operation cannot introduce support vertices. -/
private theorem sourceLemma32Suffix_support_subset [DecidableEq V]
    {w x y : V} (P : G.Walk w x) (hy : y ∈ P.support) :
    ∀ z, z ∈ (sourceLemma32Suffix G P hy).support → z ∈ P.support := by
  intro z hz
  rw [← P.take_spec hy]
  exact Walk.subset_support_append_right _ _ hz
/-- On a simple walk, dropping first at `a` and then at a vertex in that suffix
is the same as dropping the original walk directly at that vertex. -/
private theorem sourceLemma32_dropUntil_compose_of_isPath [DecidableEq V]
    {w x a b : V} {P : G.Walk w x}
    (hP : P.IsPath) (ha : a ∈ P.support)
    (hb : b ∈ (P.dropUntil a ha).support) (hbP : b ∈ P.support) :
    (P.dropUntil a ha).dropUntil b hb = P.dropUntil b hbP := by
  induction P generalizing a b with
  | nil =>
      simp only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at ha hb hbP
      subst_vars
      rfl
  | @cons u u' x huv q ih =>
      have hq : q.IsPath := hP.of_cons
      have huq : u ∉ q.support := (Walk.cons_isPath_iff huv q).mp hP |>.2
      simp only [Walk.support_cons, List.mem_cons] at ha hbP
      by_cases hau : a = u
      · subst a
        simp [Walk.dropUntil]
      · have haq : a ∈ q.support := ha.resolve_left hau
        have hbqdrop : b ∈ (q.dropUntil a haq).support := by
          simpa only [Walk.dropUntil, dif_neg (Ne.symm hau)] using hb
        have hbq : b ∈ q.support :=
          sourceLemma32Suffix_support_subset G q haq b hbqdrop
        have hbu : b ≠ u := by
          intro hbu
          subst b
          exact huq hbq
        simpa only [Walk.dropUntil, dif_neg (Ne.symm hau), dif_neg (Ne.symm hbu)] using
          ih hq haq hbqdrop hbq
/-- If `v` lies before the `y`--`x` suffix, then the successor tail exposed by
splitting at `v` contains that entire suffix. -/
private theorem sourceLemma32_suffix_subset_successor_tail [DecidableEq V]
    {w x y v vnext : V} {P : G.Walk w x}
    (hy : y ∈ P.support) (hv : v ∈ P.support)
    (hvNotQ : v ∉ (sourceLemma32Suffix G P hy).support)
    {hvnext : G.Adj v vnext} {tail : G.Walk vnext x}
    (hdrop : P.dropUntil v hv = Walk.cons hvnext tail) :
    ∀ z, z ∈ (sourceLemma32Suffix G P hy).support → z ∈ tail.support := by
  induction P generalizing y v vnext with
  | nil =>
      simp only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at hy hv
      subst_vars
      simp [sourceLemma32Suffix] at hvNotQ
  | @cons u u' x huv q ih =>
      simp only [Walk.support_cons, List.mem_cons] at hy hv
      by_cases hvu : v = u
      · subst v
        have hyu : y ≠ u := by
          rintro rfl
          apply hvNotQ
          simpa [sourceLemma32Suffix, Walk.dropUntil] using hv
        have hyTail : y ∈ q.support := hy.resolve_left hyu
        have hdropCons : Walk.cons huv q = Walk.cons hvnext tail := by
          simpa only [Walk.dropUntil, dif_pos rfl] using hdrop
        cases hdropCons
        intro z hz
        have hzTail : z ∈ (sourceLemma32Suffix G q hyTail).support := by
          simpa only [sourceLemma32Suffix, Walk.dropUntil, dif_neg (Ne.symm hyu)] using hz
        exact sourceLemma32Suffix_support_subset G q hyTail z hzTail
      · have hvTail : v ∈ q.support := hv.resolve_left hvu
        have hyu : y ≠ u := by
          rintro rfl
          apply hvNotQ
          simpa [sourceLemma32Suffix, Walk.dropUntil] using hv
        have hyTail : y ∈ q.support := hy.resolve_left hyu
        have hvNotQTail : v ∉ (sourceLemma32Suffix G q hyTail).support := by
          simpa only [sourceLemma32Suffix, Walk.dropUntil, dif_neg (Ne.symm hyu)] using hvNotQ
        have hdropTail : q.dropUntil v hvTail = Walk.cons hvnext tail := by
          simpa only [Walk.dropUntil, dif_neg (Ne.symm hvu)] using hdrop
        intro z hz
        have hzTail : z ∈ (sourceLemma32Suffix G q hyTail).support := by
          simpa only [sourceLemma32Suffix, Walk.dropUntil, dif_neg (Ne.symm hyu)] using hz
        exact ih hyTail hvTail hvNotQTail hdropTail z hzTail

/-- A vertex outside the `y`--`x` suffix cannot be the endpoint `x`. -/
private theorem sourceLemma32_ne_endpoint_of_not_suffix [DecidableEq V]
    {w x y v : V} {P : G.Walk w x} (hy : y ∈ P.support)
    (hvNotQ : v ∉ (sourceLemma32Suffix G P hy).support) : v ≠ x := by
  intro hvx
  subst v
  apply hvNotQ
  exact (sourceLemma32Suffix G P hy).end_mem_support
/-- The concrete walk in the `P - Q` reroute on page 8 of the source.  The
path and length obligations are deliberately separated below from this exact
endpoint-correct construction. -/
private theorem sourceLemma32_reroute_PminusQ_walk [DecidableEq V]
    {w x y z zplus v : V} {P : G.Walk w x}
    (hy : y ∈ P.support)
    (hzQ : z ∈ (sourceLemma32Suffix G P hy).support)
    (hzx : z ≠ x) (hxz : G.Adj x z)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (_hdropZ : (sourceLemma32Suffix G P hy).dropUntil z hzQ = Walk.cons hz_zplus tailZ)
    (hv : v ∈ P.support)
    (hvNotQ : v ∉ (sourceLemma32Suffix G P hy).support)
    (hvzplus : G.Adj v zplus) :
    ∃ vnext : V, ∃ hv_vnext : G.Adj v vnext, ∃ tailV : G.Walk vnext x,
      ∃ hzTail : z ∈ tailV.support, ∃ middle : G.Walk vnext z,
        middle = tailV.takeUntil z hzTail ∧
          ∃ P' : G.Walk w vnext,
            P' = ((((P.takeUntil v hv).concat hvzplus).append tailZ).concat hxz).append middle.reverse := by
  rcases sourceLemma32_splitAtSuccessor G P hv
    (sourceLemma32_ne_endpoint_of_not_suffix G hy hvNotQ) with
    ⟨vnext, hv_vnext, tailV, hdropV, _⟩
  have hzTail : z ∈ tailV.support :=
    sourceLemma32_suffix_subset_successor_tail G hy hv hvNotQ hdropV z hzQ
  let middle : G.Walk vnext z := tailV.takeUntil z hzTail
  let P' : G.Walk w vnext :=
    ((((P.takeUntil v hv).concat hvzplus).append tailZ).concat hxz).append middle.reverse
  refine ⟨vnext, hv_vnext, tailV, hzTail, middle, rfl, P', rfl⟩

/-- The successor tail of `v` decomposes at the later vertex `z` into its
prefix to `z` followed by the suffix already obtained from the `y`--`x` tail. -/
private theorem sourceLemma32_successor_tail_decomposition [DecidableEq V]
    {w x y z v vnext zplus : V} {P : G.Walk w x}
    (hP : P.IsPath) (hy : y ∈ P.support)
    (hzQ : z ∈ (sourceLemma32Suffix G P hy).support)
    (hv : v ∈ P.support)
    (hvNotQ : v ∉ (sourceLemma32Suffix G P hy).support)
    {hv_vnext : G.Adj v vnext} {tailV : G.Walk vnext x}
    (hdropV : P.dropUntil v hv = Walk.cons hv_vnext tailV)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hdropZ :
      (sourceLemma32Suffix G P hy).dropUntil z hzQ = Walk.cons hz_zplus tailZ)
    (hzTail : z ∈ tailV.support) :
    (tailV.takeUntil z hzTail).append (Walk.cons hz_zplus tailZ) = tailV := by
  have hzP : z ∈ P.support :=
    sourceLemma32Suffix_support_subset G P hy z hzQ
  have hzDropV : z ∈ (P.dropUntil v hv).support := by
    rw [hdropV]
    simp only [Walk.support_cons, List.mem_cons]
    exact Or.inr hzTail
  have hdropVeqP :
      (P.dropUntil v hv).dropUntil z hzDropV = P.dropUntil z hzP :=
    sourceLemma32_dropUntil_compose_of_isPath G hP hv hzDropV hzP
  have hzv : z ≠ v := by
    intro hzv
    subst z
    exact hvNotQ hzQ
  have htailVP : tailV.dropUntil z hzTail = P.dropUntil z hzP := by
    simpa only [hdropV, Walk.dropUntil, dif_neg (Ne.symm hzv)] using hdropVeqP
  have hdropQeqP :
      (sourceLemma32Suffix G P hy).dropUntil z hzQ = P.dropUntil z hzP := by
    simpa only [sourceLemma32Suffix] using
      (sourceLemma32_dropUntil_compose_of_isPath G hP hy hzQ hzP)
  have hdropP : P.dropUntil z hzP = Walk.cons hz_zplus tailZ := by
    rw [← hdropQeqP]
    exact hdropZ
  have hdropTailV : tailV.dropUntil z hzTail = Walk.cons hz_zplus tailZ :=
    htailVP.trans hdropP
  calc
    (tailV.takeUntil z hzTail).append (Walk.cons hz_zplus tailZ) =
        (tailV.takeUntil z hzTail).append (tailV.dropUntil z hzTail) := by
          rw [hdropTailV]
    _ = tailV := tailV.take_spec hzTail
/-- The page-8 reroute has the same vertex support as the original path, up to
reordering the middle and final blocks. -/
private theorem sourceLemma32_reroute_PminusQ_isPath [DecidableEq V]
    {w x y z v vnext zplus : V} {P : G.Walk w x}
    (hP : P.IsPath) (hy : y ∈ P.support)
    (hzQ : z ∈ (sourceLemma32Suffix G P hy).support)
    (hv : v ∈ P.support)
    (hvNotQ : v ∉ (sourceLemma32Suffix G P hy).support)
    {hv_vnext : G.Adj v vnext} {tailV : G.Walk vnext x}
    (hdropV : P.dropUntil v hv = Walk.cons hv_vnext tailV)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hdropZ :
      (sourceLemma32Suffix G P hy).dropUntil z hzQ = Walk.cons hz_zplus tailZ)
    (hzTail : z ∈ tailV.support)
    (hvzplus : G.Adj v zplus) (hxz : G.Adj x z) :
    ((((P.takeUntil v hv).concat hvzplus).append tailZ).concat hxz).append
        (tailV.takeUntil z hzTail).reverse |>.IsPath := by
  let pre : G.Walk w v := P.takeUntil v hv
  let middle : G.Walk vnext z := tailV.takeUntil z hzTail
  have htail : middle.append (Walk.cons hz_zplus tailZ) = tailV := by
    exact sourceLemma32_successor_tail_decomposition G hP hy hzQ hv hvNotQ hdropV
      hdropZ hzTail
  have hPdecomp : pre.append (Walk.cons hv_vnext tailV) = P := by
    dsimp [pre]
    rw [← hdropV]
    exact P.take_spec hv
  have hP_support :
      P.support = pre.support ++ middle.support ++ tailZ.support := by
    rw [← hPdecomp, Walk.support_append]
    change pre.support ++ tailV.support =
      pre.support ++ middle.support ++ tailZ.support
    rw [← htail, Walk.support_append]
    simp only [Walk.support_cons, List.tail_cons, List.append_assoc]
  have hR_support :
      (((((P.takeUntil v hv).concat hvzplus).append tailZ).concat hxz).append
          middle.reverse).support =
        pre.support ++ tailZ.support ++ middle.support.reverse := by
    dsimp [pre]
    have hmiddle_reverse : middle.support.reverse = z :: middle.support.reverse.tail := by
      rw [← Walk.support_reverse]
      exact Walk.support_eq_cons middle.reverse
    have hmiddle_tail : [z] ++ middle.support.reverse.tail = middle.support.reverse := by
      change z :: middle.support.reverse.tail = middle.support.reverse
      exact hmiddle_reverse.symm
    rw [Walk.support_append, Walk.support_concat, Walk.support_append,
      Walk.support_concat, Walk.support_reverse]
    rw [Walk.support_eq_cons tailZ]
    simp only [List.tail_cons, List.concat_eq_append, List.append_assoc]
    rw [hmiddle_tail]
    rfl
  have hperm : List.Perm
      (pre.support ++ tailZ.support ++ middle.support.reverse)
      (pre.support ++ middle.support ++ tailZ.support) := by
    simpa only [List.append_assoc] using
      (List.Perm.append_left pre.support
        ((List.Perm.append_left tailZ.support (List.reverse_perm middle.support)).trans
          List.perm_append_comm))
  apply Walk.IsPath.mk'
  rw [hR_support]
  apply hperm.symm.nodup
  rw [← hP_support]
  exact hP.support_nodup
/-- The page-8 reroute preserves the length of the original walk. -/
private theorem sourceLemma32_reroute_PminusQ_length [DecidableEq V]
    {w x y z v vnext zplus : V} {P : G.Walk w x}
    (hP : P.IsPath) (hy : y ∈ P.support)
    (hzQ : z ∈ (sourceLemma32Suffix G P hy).support)
    (hv : v ∈ P.support)
    (hvNotQ : v ∉ (sourceLemma32Suffix G P hy).support)
    {hv_vnext : G.Adj v vnext} {tailV : G.Walk vnext x}
    (hdropV : P.dropUntil v hv = Walk.cons hv_vnext tailV)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hdropZ :
      (sourceLemma32Suffix G P hy).dropUntil z hzQ = Walk.cons hz_zplus tailZ)
    (hzTail : z ∈ tailV.support)
    (hvzplus : G.Adj v zplus) (hxz : G.Adj x z) :
    (((((P.takeUntil v hv).concat hvzplus).append tailZ).concat hxz).append
        (tailV.takeUntil z hzTail).reverse).length = P.length := by
  let pre : G.Walk w v := P.takeUntil v hv
  let middle : G.Walk vnext z := tailV.takeUntil z hzTail
  have htail : middle.append (Walk.cons hz_zplus tailZ) = tailV := by
    exact sourceLemma32_successor_tail_decomposition G hP hy hzQ hv hvNotQ hdropV
      hdropZ hzTail
  have hPdecomp : pre.append (Walk.cons hv_vnext tailV) = P := by
    dsimp [pre]
    rw [← hdropV]
    exact P.take_spec hv
  have hP_length :
      P.length = pre.length + 1 + middle.length + 1 + tailZ.length := by
    rw [← hPdecomp, Walk.length_append, Walk.length_cons, ← htail,
      Walk.length_append, Walk.length_cons]
    omega
  have hR_length :
      ((((pre.concat hvzplus).append tailZ).concat hxz).append middle.reverse).length =
        pre.length + 1 + tailZ.length + 1 + middle.length := by
    simp only [Walk.length_append, Walk.length_concat, Walk.length_reverse]
  change ((((pre.concat hvzplus).append tailZ).concat hxz).append middle.reverse).length =
    P.length
  rw [hR_length, hP_length]
  omega
/-- In the reroute, the first occurrence of `v` remains in the shared prefix. -/
private theorem sourceLemma32_reroute_PminusQ_idxOf_v [DecidableEq V]
    {w x z v vnext zplus : V} {P : G.Walk w x}
    (hv : v ∈ P.support)
    {hv_vnext : G.Adj v vnext} {tailV : G.Walk vnext x}
    (hdropV : P.dropUntil v hv = Walk.cons hv_vnext tailV)
    {tailZ : G.Walk zplus x}
    (hzTail : z ∈ tailV.support)
    (hvzplus : G.Adj v zplus) (hxz : G.Adj x z) :
    List.idxOf v
      (((((P.takeUntil v hv).concat hvzplus).append tailZ).concat hxz).append
        (tailV.takeUntil z hzTail).reverse).support =
      List.idxOf v P.support := by
  let pre : G.Walk w v := P.takeUntil v hv
  let middle : G.Walk vnext z := tailV.takeUntil z hzTail
  have hvPre : v ∈ pre.support := by
    dsimp [pre]
    exact (P.takeUntil v hv).end_mem_support
  have hPdecomp : pre.append (Walk.cons hv_vnext tailV) = P := by
    dsimp [pre]
    rw [← hdropV]
    exact P.take_spec hv
  have hP_prefix : P.support = pre.support ++ tailV.support := by
    rw [← hPdecomp, Walk.support_append]
    simp only [Walk.support_cons, List.tail_cons]
  have hR_prefix :
      (((((P.takeUntil v hv).concat hvzplus).append tailZ).concat hxz).append
        middle.reverse).support =
      pre.support ++ ([zplus] ++ tailZ.support.tail ++ [z] ++ middle.reverse.support.tail) := by
    dsimp [pre]
    rw [Walk.support_append, Walk.support_concat, Walk.support_append,
      Walk.support_concat, Walk.support_reverse]
    simp only [List.concat_eq_append, List.append_assoc]
    rfl
  have hidxP : List.idxOf v P.support = List.idxOf v pre.support := by
    rw [hP_prefix]
    exact List.idxOf_append_of_mem hvPre
  have hidxR :
      List.idxOf v
        (((((P.takeUntil v hv).concat hvzplus).append tailZ).concat hxz).append
          middle.reverse).support = List.idxOf v pre.support := by
    rw [hR_prefix]
    exact List.idxOf_append_of_mem hvPre
  exact hidxR.trans hidxP.symm
/-- The complete page-8 reroute through a neighbour of `z⁺` in `P - Q`. -/
private theorem sourceLemma32_reroute_PminusQ [DecidableEq V]
    {w x y z v zplus : V} {P : G.Walk w x}
    (hP : P.IsPath) (hy : y ∈ P.support)
    (hzQ : z ∈ (sourceLemma32Suffix G P hy).support)
    (hxz : G.Adj x z)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hdropZ :
      (sourceLemma32Suffix G P hy).dropUntil z hzQ = Walk.cons hz_zplus tailZ)
    (hv : v ∈ P.support)
    (hvNotQ : v ∉ (sourceLemma32Suffix G P hy).support)
    (hvzplus : G.Adj v zplus) :
    ∃ vnext : V, ∃ P' : G.Walk w vnext,
      P'.IsPath ∧
      P'.length = P.length ∧
      G.Adj vnext v ∧
      v ∈ P'.support ∧
      List.idxOf v P'.support < List.idxOf y P.support := by
  rcases sourceLemma32_splitAtSuccessor G P hv
    (sourceLemma32_ne_endpoint_of_not_suffix G hy hvNotQ) with
    ⟨vnext, hv_vnext, tailV, hdropV, _⟩
  have hzTail : z ∈ tailV.support :=
    sourceLemma32_suffix_subset_successor_tail G hy hv hvNotQ hdropV z hzQ
  let P' : G.Walk w vnext :=
    ((((P.takeUntil v hv).concat hvzplus).append tailZ).concat hxz).append
      (tailV.takeUntil z hzTail).reverse
  have hP' : P'.IsPath := by
    dsimp [P']
    exact sourceLemma32_reroute_PminusQ_isPath G hP hy hzQ hv hvNotQ hdropV
      hdropZ hzTail hvzplus hxz
  have hlength : P'.length = P.length := by
    dsimp [P']
    exact sourceLemma32_reroute_PminusQ_length G hP hy hzQ hv hvNotQ hdropV
      hdropZ hzTail hvzplus hxz
  have hvP' : v ∈ P'.support := by
    dsimp [P']
    rw [Walk.support_append]
    apply List.mem_append_left
    rw [Walk.support_concat, List.concat_eq_append]
    apply List.mem_append_left
    rw [Walk.support_append]
    apply List.mem_append_left
    rw [Walk.support_concat, List.concat_eq_append]
    apply List.mem_append_left
    exact (P.takeUntil v hv).end_mem_support
  have hidx : List.idxOf v P'.support = List.idxOf v P.support := by
    dsimp [P']
    exact sourceLemma32_reroute_PminusQ_idxOf_v G hv hdropV hzTail hvzplus hxz
  have hbefore : List.idxOf v P.support < List.idxOf y P.support :=
    sourceLemma32_idxOf_lt_of_not_suffix G hP hy hv hvNotQ
  refine ⟨vnext, P', hP', hlength, hv_vnext.symm, hvP', ?_⟩
  rw [hidx]
  exact hbefore
/-- The extremal page-8 path has no neighbour of `z⁺` in `P - Q`. -/
private theorem sourceLemma32_no_neighbour_in_PminusQ [DecidableEq V]
    {w x y z v zplus : V} {P : G.Walk w x}
    (hminimal : ∀ x' y' (Q : G.Walk w x'),
      Q.IsPath →
      Q.length = P.length →
      G.Adj x' y' →
      y' ∈ Q.support →
      List.idxOf y P.support ≤ List.idxOf y' Q.support)
    (hP : P.IsPath) (hy : y ∈ P.support)
    (hzQ : z ∈ (sourceLemma32Suffix G P hy).support)
    (hxz : G.Adj x z)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hdropZ :
      (sourceLemma32Suffix G P hy).dropUntil z hzQ = Walk.cons hz_zplus tailZ)
    (hv : v ∈ P.support)
    (hvNotQ : v ∉ (sourceLemma32Suffix G P hy).support)
    (hvzplus : G.Adj v zplus) : False := by
  rcases sourceLemma32_reroute_PminusQ G hP hy hzQ hxz hdropZ hv hvNotQ hvzplus with
    ⟨vnext, P', hP', hlength, hAdj, hvP', hcloser⟩
  exact extremalLongestPath_not_closer G hminimal hP' hlength hAdj hvP' hcloser
/-- An external neighbour of `z⁺` extends the source's chord reroute past a
longest path, which is impossible. -/
private theorem sourceLemma32_no_neighbour_outside_P [DecidableEq V]
    {w x y z zplus v : V} {P : G.Walk w x}
    (hP : P.IsPath)
    (hmax : ∀ x' (Q : G.Walk w x'), Q.IsPath → Q.length ≤ P.length)
    (hy : y ∈ P.support)
    (hzQ : z ∈ (sourceLemma32Suffix G P hy).support)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hdropZ :
      (sourceLemma32Suffix G P hy).dropUntil z hzQ = Walk.cons hz_zplus tailZ)
    (hxz : G.Adj x z)
    (hzplusv : G.Adj zplus v)
    (hvOutside : v ∉ P.support) : False := by
  have hzP : z ∈ P.support :=
    sourceLemma32Suffix_support_subset G P hy z hzQ
  have hdropQeqP :
      (sourceLemma32Suffix G P hy).dropUntil z hzQ = P.dropUntil z hzP := by
    simpa only [sourceLemma32Suffix] using
      (sourceLemma32_dropUntil_compose_of_isPath G hP hy hzQ hzP)
  have hdropP : P.dropUntil z hzP = Walk.cons hz_zplus tailZ := by
    rw [← hdropQeqP]
    exact hdropZ
  let preZ : G.Walk w z := P.takeUntil z hzP
  let R : G.Walk w zplus := (preZ.concat hxz.symm).append tailZ.reverse
  have hPdecomp : preZ.append (Walk.cons hz_zplus tailZ) = P := by
    dsimp [preZ]
    rw [← hdropP]
    exact P.take_spec hzP
  have hP_support : P.support = preZ.support ++ tailZ.support := by
    rw [← hPdecomp, Walk.support_append]
    simp only [Walk.support_cons, List.tail_cons]
  have hR_support : R.support = preZ.support ++ tailZ.support.reverse := by
    dsimp [R]
    have hreverse : tailZ.support.reverse = x :: tailZ.support.reverse.tail := by
      rw [← Walk.support_reverse]
      exact Walk.support_eq_cons tailZ.reverse
    have hreverse_tail : [x] ++ tailZ.support.reverse.tail = tailZ.support.reverse := by
      change x :: tailZ.support.reverse.tail = tailZ.support.reverse
      exact hreverse.symm
    rw [Walk.support_append, Walk.support_concat, Walk.support_reverse]
    simp only [List.concat_eq_append, List.append_assoc]
    rw [hreverse_tail]
  have hRperm : R.support.Perm P.support := by
    rw [hR_support, hP_support]
    exact List.Perm.append_left preZ.support (List.reverse_perm tailZ.support)
  have hRpath : R.IsPath :=
    Walk.IsPath.mk' (hRperm.symm.nodup hP.support_nodup)
  have hP_length : P.length = preZ.length + 1 + tailZ.length := by
    rw [← hPdecomp, Walk.length_append, Walk.length_cons]
    omega
  have hR_length : R.length = preZ.length + 1 + tailZ.length := by
    dsimp [R]
    simp only [Walk.length_append, Walk.length_concat, Walk.length_reverse]
  have hRlength : R.length = P.length := by
    rw [hR_length, hP_length]
  have hvR : v ∉ R.support := by
    intro hvR
    exact hvOutside (hRperm.mem_iff.mp hvR)
  have hRlong : (R.concat hzplusv).IsPath := by
    apply Walk.IsPath.mk'
    rw [Walk.support_concat]
    exact List.Nodup.concat hvR hRpath.support_nodup
  have hle := hmax v (R.concat hzplusv) hRlong
  rw [Walk.length_concat, hRlength] at hle
  omega
/-- Every neighbour of `z⁺` lies on the source suffix `Q`. -/
private theorem sourceLemma32_neighbour_of_zplus_mem_Q [DecidableEq V]
    {w x y z zplus : V} {P : G.Walk w x}
    (hP : P.IsPath)
    (hmax : ∀ x' (R : G.Walk w x'), R.IsPath → R.length ≤ P.length)
    (hminimal : ∀ x' y' (R : G.Walk w x'),
      R.IsPath →
      R.length = P.length →
      G.Adj x' y' →
      y' ∈ R.support →
      List.idxOf y P.support ≤ List.idxOf y' R.support)
    (hy : y ∈ P.support)
    (hzQ : z ∈ (sourceLemma32Suffix G P hy).support)
    (hxz : G.Adj x z)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hdropZ :
      (sourceLemma32Suffix G P hy).dropUntil z hzQ = Walk.cons hz_zplus tailZ) :
    ∀ v, G.Adj zplus v → v ∈ (sourceLemma32Suffix G P hy).support := by
  intro v hzplusv
  by_cases hvP : v ∈ P.support
  · by_cases hvQ : v ∈ (sourceLemma32Suffix G P hy).support
    · exact hvQ
    · exfalso
      exact sourceLemma32_no_neighbour_in_PminusQ G hminimal hP hy hzQ hxz hdropZ
        hvP hvQ hzplusv.symm
  · exfalso
    exact sourceLemma32_no_neighbour_outside_P G hP hmax hy hzQ hdropZ hxz hzplusv hvP
/-- Every neighbour of the extremal endpoint `x` lies on the suffix `Q`. -/
private theorem sourceLemma32_neighbour_of_x_mem_Q [Fintype V] [DecidableEq V]
    {w x y a : V} {P : G.Walk w x}
    (hP : P.IsPath)
    (hmax : ∀ x' (R : G.Walk w x'), R.IsPath → R.length ≤ P.length)
    (hminimal : ∀ x' y' (R : G.Walk w x'),
      R.IsPath →
      R.length = P.length →
      G.Adj x' y' →
      y' ∈ R.support →
      List.idxOf y P.support ≤ List.idxOf y' R.support)
    (hy : y ∈ P.support) (hxa : G.Adj x a) :
    a ∈ (sourceLemma32Suffix G P hy).support := by
  have haP : a ∈ P.support :=
    longestPath_endpoint_neighbor_mem_support G hP hmax hxa
  by_contra haNotQ
  have hbefore : List.idxOf a P.support < List.idxOf y P.support :=
    sourceLemma32_idxOf_lt_of_not_suffix G hP hy haP haNotQ
  have hminimal' := hminimal x a P hP rfl hxa haP
  omega

/-- A simple path has only one vertex whose actual successor is its endpoint. -/
private theorem sourceLemma32_predecessor_of_endpoint_unique [DecidableEq V]
    {s x a b aplus bplus : V} {Q : G.Walk s x}
    (hQ : Q.IsPath) (ha : a ∈ Q.support) (hb : b ∈ Q.support)
    {ha_aplus : G.Adj a aplus} {tailA : G.Walk aplus x}
    (hdropA : Q.dropUntil a ha = Walk.cons ha_aplus tailA)
    {hb_bplus : G.Adj b bplus} {tailB : G.Walk bplus x}
    (hdropB : Q.dropUntil b hb = Walk.cons hb_bplus tailB)
    (haplusx : aplus = x) (hbplusx : bplus = x) : a = b := by
  subst aplus
  subst bplus
  have htailApath : tailA.IsPath := by
    have hdropPath : (Q.dropUntil a ha).IsPath := hQ.dropUntil ha
    rw [hdropA] at hdropPath
    exact hdropPath.of_cons
  have htailBpath : tailB.IsPath := by
    have hdropPath : (Q.dropUntil b hb).IsPath := hQ.dropUntil hb
    rw [hdropB] at hdropPath
    exact hdropPath.of_cons
  have htailAnil : tailA = Walk.nil := (Walk.isPath_iff_eq_nil tailA).mp htailApath
  have htailBnil : tailB = Walk.nil := (Walk.isPath_iff_eq_nil tailB).mp htailBpath
  have hconcatA : (Q.takeUntil a ha).concat ha_aplus = Q := by
    simpa only [Walk.concat_eq_append, hdropA, htailAnil] using Q.take_spec ha
  have hconcatB : (Q.takeUntil b hb).concat hb_bplus = Q := by
    simpa only [Walk.concat_eq_append, hdropB, htailBnil] using Q.take_spec hb
  have hpenA : Q.penultimate = a := by
    rw [← hconcatA]
    exact Walk.penultimate_concat _ _
  have hpenB : Q.penultimate = b := by
    rw [← hconcatB]
    exact Walk.penultimate_concat _ _
  exact hpenA.symm.trans hpenB
/-- At a degree-at-least-three endpoint, a specified neighbour has two further
pairwise distinct neighbours.  This is the finite choice used for source `z`. -/
private theorem endpoint_two_other_neighbours [Fintype V] [DecidableEq V]
    [DecidableRel G.Adj] {x : V} (hx : 3 ≤ G.degree x)
    {y : V} (hxy : G.Adj x y) :
    ∃ z t, z ≠ y ∧ t ≠ y ∧ t ≠ z ∧ G.Adj x z ∧ G.Adj x t := by
  have hy : y ∈ G.neighborFinset x := (G.mem_neighborFinset x y).mpr hxy
  have hcard : 3 ≤ (G.neighborFinset x).card := by
    simpa only [G.card_neighborFinset_eq_degree] using hx
  obtain ⟨z, hz, hznot⟩ :=
    ({y} : Finset V).exists_mem_not_mem_of_card_lt_card (t := G.neighborFinset x)
      (by
        have hlt : 1 < (G.neighborFinset x).card := by omega
        simpa using hlt)
  have hzy : z ≠ y := by simpa using hznot
  obtain ⟨t, ht, htnot⟩ :=
    ({y, z} : Finset V).exists_mem_not_mem_of_card_lt_card (t := G.neighborFinset x)
      (by
        have hpair : ({y, z} : Finset V).card = 2 := by simp [Ne.symm hzy]
        omega : ({y, z} : Finset V).card < (G.neighborFinset x).card)
  refine ⟨z, t, hzy, ?_, ?_, (G.mem_neighborFinset x z).mp hz,
    (G.mem_neighborFinset x t).mp ht⟩
  · intro hty
    exact htnot (by simp [hty])
  · intro htz
    exact htnot (by simp [htz])

/-- Choose an endpoint neighbour whose actual suffix successor is not `x`, so
that the endpoint edge is available as the later source chord. -/
private theorem sourceLemma32_choose_x_chord_neighbour [Fintype V] [DecidableEq V]
    [DecidableRel G.Adj]
    {w x y : V} {P : G.Walk w x}
    (hx : 3 ≤ G.degree x)
    (hP : P.IsPath)
    (hmax : ∀ x' (R : G.Walk w x'), R.IsPath → R.length ≤ P.length)
    (hminimal : ∀ x' y' (R : G.Walk w x'),
      R.IsPath →
      R.length = P.length →
      G.Adj x' y' →
      y' ∈ R.support →
      List.idxOf y P.support ≤ List.idxOf y' R.support)
    (hy : y ∈ P.support) (hxy : G.Adj x y) :
    ∃ z, ∃ hzQ : z ∈ (sourceLemma32Suffix G P hy).support,
      z ≠ y ∧ G.Adj x z ∧
        ∃ zplus, ∃ hz_zplus : G.Adj z zplus, ∃ tailZ : G.Walk zplus x,
          zplus ≠ x ∧
          (sourceLemma32Suffix G P hy).dropUntil z hzQ = Walk.cons hz_zplus tailZ := by
  rcases endpoint_two_other_neighbours G hx hxy with
    ⟨a, b, hay, hby, hba, hxa, hxb⟩
  have haQ : a ∈ (sourceLemma32Suffix G P hy).support :=
    sourceLemma32_neighbour_of_x_mem_Q G hP hmax hminimal hy hxa
  have hbQ : b ∈ (sourceLemma32Suffix G P hy).support :=
    sourceLemma32_neighbour_of_x_mem_Q G hP hmax hminimal hy hxb
  have hQ : (sourceLemma32Suffix G P hy).IsPath :=
    sourceLemma32Suffix_isPath G hP hy
  have hax : a ≠ x := hxa.ne.symm
  have hbx : b ≠ x := hxb.ne.symm
  rcases sourceLemma32_splitAtSuccessor G (sourceLemma32Suffix G P hy) haQ hax with
    ⟨aplus, ha_aplus, tailA, hdropA, _⟩
  rcases sourceLemma32_splitAtSuccessor G (sourceLemma32Suffix G P hy) hbQ hbx with
    ⟨bplus, hb_bplus, tailB, hdropB, _⟩
  by_cases haplusx : aplus = x
  · have hbplusx : bplus ≠ x := by
      intro hbplusx
      have hab : a = b :=
        sourceLemma32_predecessor_of_endpoint_unique G hQ haQ hbQ hdropA hdropB
          haplusx hbplusx
      exact hba hab.symm
    exact ⟨b, hbQ, hby, hxb, bplus, hb_bplus, tailB, hbplusx, hdropB⟩
  · exact ⟨a, haQ, hay, hxa, aplus, ha_aplus, tailA, haplusx, hdropA⟩
/- Choose the second source-chord neighbour at `z⁺`, distinct from its two
actual neighbours on the suffix. -/
/-- The successor of an interior suffix vertex is not the suffix start. -/
private theorem sourceLemma32_successor_ne_start [DecidableEq V]
    {y x z zplus : V} {Q : G.Walk y x} (hQ : Q.IsPath)
    (hzQ : z ∈ Q.support) (hzy : z ≠ y)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hdropZ : Q.dropUntil z hzQ = Walk.cons hz_zplus tailZ) : zplus ≠ y := by
  intro hzplusy
  subst zplus
  have hyDrop : y ∈ (Q.dropUntil z hzQ).support := by
    rw [hdropZ]
    simp only [Walk.support_cons, List.mem_cons]
    exact Or.inr tailZ.start_mem_support
  have hyTail : y ∈ (Q.dropUntil z hzQ).support.tail := by
    rw [Walk.support_eq_cons] at hyDrop
    simp only [List.mem_cons] at hyDrop
    exact hyDrop.resolve_left hzy.symm
  have hsplitNodup :
      ((Q.takeUntil z hzQ).support ++ (Q.dropUntil z hzQ).support.tail).Nodup := by
    rw [← Walk.support_append, Q.take_spec hzQ]
    exact hQ.support_nodup
  have hdisjoint : (Q.takeUntil z hzQ).support.Disjoint
      (Q.dropUntil z hzQ).support.tail :=
    List.disjoint_of_nodup_append hsplitNodup
  exact (List.disjoint_left.mp hdisjoint (Q.takeUntil z hzQ).start_mem_support) hyTail

private theorem sourceLemma32_choose_zplus_chord_neighbour [Fintype V] [DecidableEq V]
    [DecidableRel G.Adj]
    {w x y z zplus : V} {P : G.Walk w x}
    (hzplusDegree : 3 ≤ G.degree zplus)
    (hP : P.IsPath)
    (hmax : ∀ x' (R : G.Walk w x'), R.IsPath → R.length ≤ P.length)
    (hminimal : ∀ x' y' (R : G.Walk w x'),
      R.IsPath →
      R.length = P.length →
      G.Adj x' y' →
      y' ∈ R.support →
      List.idxOf y P.support ≤ List.idxOf y' R.support)
    (hy : y ∈ P.support)
    (hzQ : z ∈ (sourceLemma32Suffix G P hy).support)
    (hzy : z ≠ y) (hxz : G.Adj x z)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hzplus_ne_x : zplus ≠ x)
    (hdropZ :
      (sourceLemma32Suffix G P hy).dropUntil z hzQ = Walk.cons hz_zplus tailZ) :
    ∃ hzplusQ : zplus ∈ (sourceLemma32Suffix G P hy).support,
      zplus ≠ y ∧
        ∃ znext, ∃ hzplus_znext : G.Adj zplus znext,
          ∃ tailNext : G.Walk znext x,
            (sourceLemma32Suffix G P hy).dropUntil zplus hzplusQ =
                Walk.cons hzplus_znext tailNext ∧
            ∃ t, t ∈ (sourceLemma32Suffix G P hy).support ∧
              G.Adj zplus t ∧ t ≠ z ∧ t ≠ znext := by
  let Q : G.Walk y x := sourceLemma32Suffix G P hy
  have hQ : Q.IsPath := sourceLemma32Suffix_isPath G hP hy
  have hzplusDrop : zplus ∈ (Q.dropUntil z hzQ).support := by
    rw [hdropZ]
    simp only [Walk.support_cons, List.mem_cons]
    exact Or.inr tailZ.start_mem_support
  have hzplusQ : zplus ∈ Q.support := Q.support_dropUntil_subset hzQ hzplusDrop
  have hsplitNodup :
      ((Q.takeUntil z hzQ).support ++ (Q.dropUntil z hzQ).support.tail).Nodup := by
    rw [← Walk.support_append, Q.take_spec hzQ]
    exact hQ.support_nodup
  have hzplus_ne_y : zplus ≠ y := by
    intro hzplusy
    subst zplus
    have hyDrop : y ∈ (Q.dropUntil z hzQ).support := by
      rw [hdropZ]
      simp only [Walk.support_cons, List.mem_cons]
      exact Or.inr tailZ.start_mem_support
    have hyTail : y ∈ (Q.dropUntil z hzQ).support.tail := by
      rw [Walk.support_eq_cons] at hyDrop
      simp only [List.mem_cons] at hyDrop
      exact hyDrop.resolve_left hzy.symm
    have hdisjoint : (Q.takeUntil z hzQ).support.Disjoint
        (Q.dropUntil z hzQ).support.tail :=
      List.disjoint_of_nodup_append hsplitNodup
    exact (List.disjoint_left.mp hdisjoint (Q.takeUntil z hzQ).start_mem_support) hyTail
  rcases sourceLemma32_splitAtSuccessor G Q hzplusQ hzplus_ne_x with
    ⟨znext, hzplus_znext, tailNext, hdropNext, _⟩
  rcases endpoint_two_other_neighbours G hzplusDegree hz_zplus.symm with
    ⟨a, b, haz, hbz, hba, hzplusa, hzplusb⟩
  by_cases haNext : a = znext
  · have hbNext : b ≠ znext := by
      intro hbNext
      exact hba (hbNext.trans haNext.symm)
    have hbQ : b ∈ Q.support :=
      sourceLemma32_neighbour_of_zplus_mem_Q G hP hmax hminimal hy hzQ hxz hdropZ b hzplusb
    exact ⟨hzplusQ, hzplus_ne_y, znext, hzplus_znext, tailNext, hdropNext,
      b, hbQ, hzplusb, hbz, hbNext⟩
  · have haQ : a ∈ Q.support :=
      sourceLemma32_neighbour_of_zplus_mem_Q G hP hmax hminimal hy hzQ hxz hdropZ a hzplusa
    exact ⟨hzplusQ, hzplus_ne_y, znext, hzplus_znext, tailNext, hdropNext,
      a, haQ, hzplusa, haz, haNext⟩

/-- The endpoint edge selected at `x` is not already an edge of the source
suffix: the actual successor of `z` is the distinct vertex `z⁺`. -/
private theorem sourceLemma32_endpoint_chord_edge_not_mem [DecidableEq V]
    {y x z zplus : V} {Q : G.Walk y x}
    (hQ : Q.IsPath)
    (hzQ : z ∈ Q.support)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hdropZ : Q.dropUntil z hzQ = Walk.cons hz_zplus tailZ)
    (hzplus_ne_x : zplus ≠ x) : s(x, z) ∉ Q.edges := by
  induction Q generalizing z zplus with
  | nil =>
      simp at hzQ
      simp
  | @cons y a x hya q ih =>
      have hq : q.IsPath := hQ.of_cons
      have hyq : y ∉ q.support := (Walk.cons_isPath_iff hya q).mp hQ |>.2
      simp only [Walk.support_cons, List.mem_cons] at hzQ
      by_cases hzy : z = y
      · subst z
        intro he
        simp only [Walk.edges_cons, List.mem_cons] at he
        rcases he with he | he
        · rw [Sym2.eq_iff] at he
          rcases he with ⟨hxy, hya'⟩ | ⟨hxa, hya'⟩
          · have hdrop : Walk.cons hya q = Walk.cons hz_zplus tailZ := by
              simpa [Walk.dropUntil] using hdropZ
            cases hdrop
            exact hzplus_ne_x (hya'.symm.trans hxy.symm)
          · have hdrop : Walk.cons hya q = Walk.cons hz_zplus tailZ := by
              simpa [Walk.dropUntil] using hdropZ
            cases hdrop
            exact hzplus_ne_x hxa.symm
        · exact hyq (q.snd_mem_support_of_mem_edges he)
      · have hzq : z ∈ q.support := hzQ.resolve_left hzy
        have hdropq : q.dropUntil z hzq = Walk.cons hz_zplus tailZ := by
          simpa only [Walk.dropUntil, dif_neg (Ne.symm hzy)] using hdropZ
        intro he
        simp only [Walk.edges_cons, List.mem_cons] at he
        rcases he with he | he
        · rw [Sym2.eq_iff] at he
          rcases he with ⟨hxy, _⟩ | ⟨_, hzy'⟩
          · subst x
            have hnil : Walk.cons hya q = Walk.nil :=
              (Walk.isPath_iff_eq_nil _).mp hQ
            simp at hnil
          · exact hzy hzy'
        · exact ih hq hzq hdropq hzplus_ne_x he

/-- The second selected edge at `z⁺` is not already an edge of the source
suffix: a simple path has only the displayed predecessor and successor edges
at that occurrence of `z⁺`. -/
private theorem sourceLemma32_internal_chord_edge_not_mem [DecidableEq V]
    {y x z zplus znext t : V} {Q : G.Walk y x}
    (hQ : Q.IsPath)
    (hzQ : z ∈ Q.support)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hdropZ : Q.dropUntil z hzQ = Walk.cons hz_zplus tailZ)
    (hzplusQ : zplus ∈ Q.support)
    {hzplus_znext : G.Adj zplus znext} {tailNext : G.Walk znext x}
    (hdropNext : Q.dropUntil zplus hzplusQ = Walk.cons hzplus_znext tailNext)
    (ht_ne_z : t ≠ z) (ht_ne_znext : t ≠ znext) : s(zplus, t) ∉ Q.edges := by
  have hzplusDrop : zplus ∈ (Q.dropUntil z hzQ).support := by
    rw [hdropZ]
    simp only [Walk.support_cons, List.mem_cons]
    exact Or.inr tailZ.start_mem_support
  have hdropCompose :=
    sourceLemma32_dropUntil_compose_of_isPath G hQ hzQ hzplusDrop hzplusQ
  have hzplus_ne_z : zplus ≠ z := hz_zplus.ne.symm
  have htailZ_drop : tailZ.dropUntil zplus tailZ.start_mem_support = tailZ := by
    cases tailZ <;> simp [Walk.dropUntil]
  have htailZ : tailZ = Walk.cons hzplus_znext tailNext := by
    simpa only [hdropZ, Walk.dropUntil, dif_neg (Ne.symm hzplus_ne_z),
      htailZ_drop] using hdropCompose.trans hdropNext
  have htailZ_path : tailZ.IsPath := by
    have hdropPath : (Q.dropUntil z hzQ).IsPath := hQ.dropUntil hzQ
    rw [hdropZ] at hdropPath
    exact hdropPath.of_cons
  have hzplus_not_tailNext : zplus ∉ tailNext.support := by
    rw [htailZ] at htailZ_path
    exact (Walk.cons_isPath_iff hzplus_znext tailNext).mp htailZ_path |>.2
  let pre : G.Walk y z := Q.takeUntil z hzQ
  have hdecomp : pre.append (Walk.cons hz_zplus tailZ) = Q := by
    dsimp [pre]
    rw [← hdropZ]
    exact Q.take_spec hzQ
  have hsupport : Q.support = pre.support ++ tailZ.support := by
    rw [← hdecomp, Walk.support_append]
    simp only [Walk.support_cons, List.tail_cons]
  have hnodup : (pre.support ++ tailZ.support).Nodup := by
    rw [← hsupport]
    exact hQ.support_nodup
  have hzplus_not_pre : zplus ∉ pre.support := by
    intro hzplusPre
    have hdisjoint : pre.support.Disjoint tailZ.support :=
      List.disjoint_of_nodup_append hnodup
    exact (List.disjoint_left.mp hdisjoint hzplusPre) tailZ.start_mem_support
  intro he
  rw [← hdecomp, Walk.edges_append] at he
  simp only [Walk.edges_cons, List.mem_append, List.mem_cons] at he
  rcases he with he | he | he
  · exact hzplus_not_pre (pre.fst_mem_support_of_mem_edges he)
  · rw [Sym2.eq_iff] at he
    rcases he with ⟨hzplusz, _⟩ | ⟨_, htz⟩
    · exact hz_zplus.ne hzplusz.symm
    · exact ht_ne_z htz
  · rw [htailZ, Walk.edges_cons, List.mem_cons] at he
    rcases he with he | he
    · rw [Sym2.eq_iff] at he
      rcases he with ⟨_, htznext⟩ | ⟨hzplusnext, _⟩
      · exact ht_ne_znext htznext
      · exact hzplus_znext.ne hzplusnext
    · exact hzplus_not_tailNext (tailNext.fst_mem_support_of_mem_edges he)

/-- The closing edge `x`--`y` is not traversed by the source suffix.  The
selected interior vertex `z` has an actual successor, so the simple path is
not the one-edge `y`--`x` walk. -/
private theorem sourceLemma32_closing_edge_not_mem [DecidableEq V]
    {y x z zplus : V} {Q : G.Walk y x}
    (hQ : Q.IsPath) (hxy : G.Adj x y)
    (hzQ : z ∈ Q.support) (hzy : z ≠ y)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hdropZ : Q.dropUntil z hzQ = Walk.cons hz_zplus tailZ) :
    s(x, y) ∉ Q.edges := by
  have hzx : z ≠ x := by
    intro hzx
    subst z
    have hdropPath : (Q.dropUntil x hzQ).IsPath := hQ.dropUntil hzQ
    have hnil : Q.dropUntil x hzQ = Walk.nil :=
      (Walk.isPath_iff_eq_nil _).mp hdropPath
    rw [hnil] at hdropZ
    simp at hdropZ
  induction Q with
  | nil =>
      simp at hzQ
      simp
  | @cons y a x hya q =>
      have hq : q.IsPath := hQ.of_cons
      have hyq : y ∉ q.support := (Walk.cons_isPath_iff hya q).mp hQ |>.2
      intro he
      simp only [Walk.edges_cons, List.mem_cons] at he
      rcases he with he | he
      · rw [Sym2.eq_iff] at he
        rcases he with ⟨hxy', _⟩ | ⟨hxa, _⟩
        · exact hxy.ne hxy'
        · subst x
          have hqnil : q = Walk.nil := (Walk.isPath_iff_eq_nil q).mp hq
          subst q
          simp only [Walk.support_cons, Walk.support_nil, List.mem_cons,
            List.not_mem_nil, or_false] at hzQ
          exact hzQ.elim hzy hzx
      · exact hyq (q.snd_mem_support_of_mem_edges he)

/-- The exact chorded cycle selected in the first half of source Lemma 3.2.
The two displayed graph edges are recorded as non-edges of the cycle walk,
not merely as non-edges of its open suffix. -/
private structure SourceLemma32ChordedCycleData (G : SimpleGraph V) where
  root : V
  C : G.Walk root root
  isCycle : C.IsCycle
  z : V
  zplus : V
  x : V
  t : V
  z_mem : z ∈ C.support
  zplus_mem : zplus ∈ C.support
  adjacent : G.Adj z zplus
  adjacent_cycle_edge : s(z, zplus) ∈ C.edges
  x_mem : x ∈ C.support
  xChordAdj : G.Adj z x
  xChord_not_cycle_edge : s(z, x) ∉ C.edges
  t_mem : t ∈ C.support
  zplusChordAdj : G.Adj zplus t
  zplusChord_not_cycle_edge : s(zplus, t) ∉ C.edges

/-- The source suffix `Q`, closed by `x`--`y`, is a cycle on which the
selected edges `z`--`x` and `z⁺`--`t` are both genuine chords. -/
private def sourceLemma32_chorded_cycle_data [DecidableEq V]
    {y x z zplus znext t : V} {Q : G.Walk y x}
    (hQ : Q.IsPath) (hxy : G.Adj x y)
    (hzQ : z ∈ Q.support) (hzy : z ≠ y) (hxz : G.Adj x z)
    {hz_zplus : G.Adj z zplus} {tailZ : G.Walk zplus x}
    (hzplus_ne_x : zplus ≠ x)
    (hdropZ : Q.dropUntil z hzQ = Walk.cons hz_zplus tailZ)
    (hzplusQ : zplus ∈ Q.support) (hzplus_ne_y : zplus ≠ y)
    {hzplus_znext : G.Adj zplus znext} {tailNext : G.Walk znext x}
    (hdropNext : Q.dropUntil zplus hzplusQ = Walk.cons hzplus_znext tailNext)
    (htQ : t ∈ Q.support) (hzplus_t : G.Adj zplus t)
    (ht_ne_z : t ≠ z) (ht_ne_znext : t ≠ znext) :
    SourceLemma32ChordedCycleData G := by
  let C : G.Walk y y := Q.concat hxy
  have hclosingQ : s(x, y) ∉ Q.edges :=
    sourceLemma32_closing_edge_not_mem G hQ hxy hzQ hzy hdropZ
  have hclosingReverse : s(y, x) ∉ Q.reverse.edges := by
    intro he
    rw [Walk.edges_reverse, List.mem_reverse] at he
    apply hclosingQ
    simpa only [Sym2.eq_swap] using he
  have hCycle : C.IsCycle := by
    dsimp [C]
    rw [← Walk.isCycle_reverse, Walk.reverse_concat]
    exact Path.cons_isCycle ⟨Q.reverse, hQ.reverse⟩ hxy.symm hclosingReverse
  have hxC : x ∈ C.support := by
    dsimp [C]
    rw [Walk.support_concat]
    simp [Q.end_mem_support]
  have hzC : z ∈ C.support := by
    dsimp [C]
    rw [Walk.support_concat]
    simp [hzQ]
  have hzplusC : zplus ∈ C.support := by
    dsimp [C]
    rw [Walk.support_concat]
    simp [hzplusQ]
  have htC : t ∈ C.support := by
    dsimp [C]
    rw [Walk.support_concat]
    simp [htQ]
  have hZZQ : s(z, zplus) ∈ Q.edges := by
    rw [← Q.take_spec hzQ, Walk.edges_append, hdropZ, Walk.edges_cons]
    exact List.mem_append_right _ (by simp)
  have hZZC : s(z, zplus) ∈ C.edges := by
    dsimp [C]
    rw [Walk.edges_concat]
    simpa using Or.inl hZZQ
  have hXZnotQ : s(x, z) ∉ Q.edges :=
    sourceLemma32_endpoint_chord_edge_not_mem G hQ hzQ hdropZ hzplus_ne_x
  have hXZnotClosing : s(x, z) ≠ s(x, y) := by
    intro h
    rw [Sym2.eq_iff] at h
    rcases h with ⟨_, hzy'⟩ | ⟨hxy', _⟩
    · exact hzy hzy'
    · exact hxy.ne hxy'
  have hXZnotC : s(x, z) ∉ C.edges := by
    intro he
    dsimp [C] at he
    have he' : s(x, z) ∈ Q.edges ∨ s(x, z) = s(x, y) := by
      rw [Walk.edges_concat] at he
      simpa using he
    exact he'.elim hXZnotQ hXZnotClosing
  have hZTnotQ : s(zplus, t) ∉ Q.edges :=
    sourceLemma32_internal_chord_edge_not_mem G hQ hzQ hdropZ hzplusQ hdropNext
      ht_ne_z ht_ne_znext
  have hZTnotClosing : s(zplus, t) ≠ s(x, y) := by
    intro h
    rw [Sym2.eq_iff] at h
    rcases h with ⟨hzplusx, _⟩ | ⟨hzplusy, _⟩
    · exact hzplus_ne_x hzplusx
    · exact hzplus_ne_y hzplusy
  have hZTnotC : s(zplus, t) ∉ C.edges := by
    intro he
    dsimp [C] at he
    have he' : s(zplus, t) ∈ Q.edges ∨ s(zplus, t) = s(x, y) := by
      rw [Walk.edges_concat] at he
      simpa using he
    exact he'.elim hZTnotQ hZTnotClosing
  exact {
    root := y
    C := C
    isCycle := hCycle
    z := z
    zplus := zplus
    x := x
    t := t
    z_mem := hzC
    zplus_mem := hzplusC
    adjacent := hz_zplus
    adjacent_cycle_edge := hZZC
    x_mem := hxC
    xChordAdj := hxz.symm
    xChord_not_cycle_edge := by simpa only [Sym2.eq_swap] using hXZnotC
    t_mem := htC
    zplusChordAdj := hzplus_t
    zplusChord_not_cycle_edge := hZTnotC }

private theorem induced_reachable_has_walk_avoiding [DecidableEq V]
    {S : Finset V} {a b : V} (ha : a ∉ S) (hb : b ∉ S)
    (hreach : (G.induce {w : V | w ∉ S}).Reachable ⟨a, ha⟩ ⟨b, hb⟩) :
    ∃ p : G.Walk a b, ∀ v, v ∈ p.support → v ∉ S := by
  rcases hreach with ⟨q⟩
  let inclusion : G.induce {w : V | w ∉ S} →g G := {
    toFun := Subtype.val
    map_rel' := by
      intro x y hxy
      exact hxy }
  let p : G.Walk a b := by
    simpa [inclusion] using q.map inclusion
  refine ⟨p, ?_⟩
  intro v hv
  have hvMap : v ∈ q.support.map inclusion := by
    simpa [p, inclusion] using hv
  rcases List.mem_map.mp hvMap with ⟨w, hw, hwv⟩
  subst v
  exact w.2

/-- The first Menger use in source Lemma 3.2: arbitrary distinct vertices
have two raw vertex-disjoint attachments to the constructed chorded cycle.
The later first-hit normalization is intentionally not part of this result. -/
private theorem sourceLemma32_two_attachments_to_chorded_cycle [Fintype V] [DecidableEq V]
    (hconn : VertexConnectivityAtLeast G 2)
    (D : SourceLemma32ChordedCycleData G)
    {u v : V} (huv : u ≠ v) :
    Nonempty (ABLinkageData G {u, v} D.C.support.toFinset 2) := by
  have hAcard : ({u, v} : Finset V).card = 2 := by
    simp [huv]
  have hBcard : 2 ≤ D.C.support.toFinset.card := by
    have hpair : ({D.z, D.zplus} : Finset V).card = 2 := by
      simp [D.adjacent.ne]
    rw [← hpair]
    apply Finset.card_le_card
    intro w hw
    simp only [Finset.mem_insert, Finset.mem_singleton] at hw
    rcases hw with rfl | rfl
    · exact List.mem_toFinset.mpr D.z_mem
    · exact List.mem_toFinset.mpr D.zplus_mem
  apply finiteMenger_two_sets G {u, v} D.C.support.toFinset
  intro S hS hsep
  obtain ⟨a, haA, haS⟩ :=
    S.exists_mem_not_mem_of_card_lt_card (by omega : S.card < ({u, v} : Finset V).card)
  obtain ⟨b, hbB, hbS⟩ :=
    S.exists_mem_not_mem_of_card_lt_card (by omega : S.card < D.C.support.toFinset.card)
  obtain ⟨p, hpavoid⟩ := induced_reachable_has_walk_avoiding G haS hbS
    (reachable_after_delete_of_vertexConnectivity G hconn S hS haS hbS)
  obtain ⟨w, hwS, hwp⟩ := hsep haA hbB p
  exact hpavoid w hwp hwS

/-- The two raw Menger paths, oriented explicitly from the prescribed
vertices `u` and `v`.  They are not yet trimmed to first cycle contact. -/
private structure SourceLemma32RawAttachmentData
    (G : SimpleGraph V) (D : SourceLemma32ChordedCycleData G) (u v : V) where
  r : V
  s : V
  Ru : G.Walk u r
  Rv : G.Walk v s
  Ru_path : Ru.IsPath
  Rv_path : Rv.IsPath
  r_mem_cycle : r ∈ D.C.support
  s_mem_cycle : s ∈ D.C.support
  r_ne_s : r ≠ s
  disjoint_support :
    Disjoint {w | w ∈ Ru.support} {w | w ∈ Rv.support}

/-- Normalize the two `Fin 2` Menger paths by directly inspecting indices
`0` and `1`; the second orientation merely swaps the two paths. -/
private theorem sourceLemma32_normalize_two_attachments [Fintype V] [DecidableEq V]
    (D : SourceLemma32ChordedCycleData G)
    {u v : V} (_huv : u ≠ v)
    (L : ABLinkageData G {u, v} D.C.support.toFinset 2) :
    Nonempty (SourceLemma32RawAttachmentData G D u v) := by
  have hsrc0 : L.src 0 = u ∨ L.src 0 = v := by
    simpa using L.src_mem 0
  have hsrc1 : L.src 1 = u ∨ L.src 1 = v := by
    simpa using L.src_mem 1
  rcases hsrc0 with h0u | h0v
  · rcases hsrc1 with h1u | h1v
    · exact (Fin.zero_ne_one (L.src_injective (h0u.trans h1u.symm))).elim
    · exact ⟨{
        r := L.dst 0
        s := L.dst 1
        Ru := (L.path 0 : G.Walk (L.src 0) (L.dst 0)).copy h0u rfl
        Rv := (L.path 1 : G.Walk (L.src 1) (L.dst 1)).copy h1v rfl
        Ru_path := (Walk.isPath_copy _ h0u rfl).mpr (L.path 0).property
        Rv_path := (Walk.isPath_copy _ h1v rfl).mpr (L.path 1).property
        r_mem_cycle := List.mem_toFinset.mp (L.dst_mem 0)
        s_mem_cycle := List.mem_toFinset.mp (L.dst_mem 1)
        r_ne_s := by
          intro h
          exact Fin.zero_ne_one (L.dst_injective h)
        disjoint_support := by simpa using L.disjoint_support Fin.zero_ne_one }⟩
  · rcases hsrc1 with h1u | h1v
    · exact ⟨{
        r := L.dst 1
        s := L.dst 0
        Ru := (L.path 1 : G.Walk (L.src 1) (L.dst 1)).copy h1u rfl
        Rv := (L.path 0 : G.Walk (L.src 0) (L.dst 0)).copy h0v rfl
        Ru_path := (Walk.isPath_copy _ h1u rfl).mpr (L.path 1).property
        Rv_path := (Walk.isPath_copy _ h0v rfl).mpr (L.path 0).property
        r_mem_cycle := List.mem_toFinset.mp (L.dst_mem 1)
        s_mem_cycle := List.mem_toFinset.mp (L.dst_mem 0)
        r_ne_s := by
          intro h
          exact Fin.zero_ne_one (L.dst_injective h).symm
        disjoint_support := by simpa using (L.disjoint_support Fin.zero_ne_one).symm }⟩
    · exact (Fin.zero_ne_one (L.src_injective (h0v.trans h1v.symm))).elim

/-- Trim a simple attachment at its first vertex on the constructed chorded
cycle.  The returned path is a prefix of the original path. -/
private theorem sourceLemma32_first_cycle_hit [DecidableEq V]
    (D : SourceLemma32ChordedCycleData G)
    {a b : V} (P : G.Walk a b) (hP : P.IsPath) (hbC : b ∈ D.C.support) :
    ∃ c : V, ∃ R : G.Walk a c,
      R.IsPath ∧ c ∈ D.C.support ∧
        (∀ w, w ∈ R.support → w ≠ c → w ∉ D.C.support) ∧
        (∀ w, w ∈ R.support → w ∈ P.support) := by
  induction P with
  | @nil a =>
      refine ⟨a, Walk.nil, Walk.IsPath.nil, hbC, ?_, ?_⟩
      · intro w hw hne
        simp only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at hw
        subst w
        exact (hne rfl).elim
      · intro w hw
        exact hw
  | @cons a a' b haa' q ih =>
      have hq : q.IsPath := hP.of_cons
      by_cases haC : a ∈ D.C.support
      · refine ⟨a, Walk.nil, Walk.IsPath.nil, haC, ?_, ?_⟩
        · intro w hw hne
          simp only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at hw
          subst w
          exact (hne rfl).elim
        · intro w hw
          simp only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at hw
          subst w
          exact (Walk.cons haa' q).start_mem_support
      · rcases ih hq hbC with ⟨c, R, hR, hcC, hfirst, hsub⟩
        refine ⟨c, Walk.cons haa' R, ?_, hcC, ?_, ?_⟩
        · apply (Walk.cons_isPath_iff haa' R).mpr
          refine ⟨hR, ?_⟩
          intro haR
          have haq : a ∉ q.support := (Walk.cons_isPath_iff haa' q).mp hP |>.2
          exact haq (hsub a haR)
        · intro w hw hwne
          simp only [Walk.support_cons, List.mem_cons] at hw
          rcases hw with rfl | hw
          · exact haC
          · exact hfirst w hw hwne
        · intro w hw
          simp only [Walk.support_cons, List.mem_cons] at hw ⊢
          rcases hw with rfl | hw
          · exact Or.inl rfl
          · exact Or.inr (hsub w hw)

/-- First-cycle-contact versions of the two raw Menger attachments. -/
private structure SourceLemma32FirstHitAttachmentData
    (G : SimpleGraph V) (D : SourceLemma32ChordedCycleData G) (u v : V) where
  r : V
  s : V
  Ru : G.Walk u r
  Rv : G.Walk v s
  Ru_path : Ru.IsPath
  Rv_path : Rv.IsPath
  r_mem_cycle : r ∈ D.C.support
  s_mem_cycle : s ∈ D.C.support
  Ru_first_hit : ∀ w, w ∈ Ru.support → w ≠ r → w ∉ D.C.support
  Rv_first_hit : ∀ w, w ∈ Rv.support → w ≠ s → w ∉ D.C.support
  r_ne_s : r ≠ s
  disjoint_support :
    Disjoint {w | w ∈ Ru.support} {w | w ∈ Rv.support}

/-- Trim both raw attachments at their first cycle contacts while preserving
their full support disjointness. -/
private theorem sourceLemma32_first_hit_attachments [DecidableEq V]
    (D : SourceLemma32ChordedCycleData G)
    {u v : V} (A : SourceLemma32RawAttachmentData G D u v) :
    Nonempty (SourceLemma32FirstHitAttachmentData G D u v) := by
  rcases sourceLemma32_first_cycle_hit G D A.Ru A.Ru_path A.r_mem_cycle with
    ⟨r, Ru, hRu, hrC, hRuFirst, hRuSub⟩
  rcases sourceLemma32_first_cycle_hit G D A.Rv A.Rv_path A.s_mem_cycle with
    ⟨s, Rv, hRv, hsC, hRvFirst, hRvSub⟩
  have hdisjoint : Disjoint {w | w ∈ Ru.support} {w | w ∈ Rv.support} := by
    rw [Set.disjoint_left]
    intro w hwRu hwRv
    exact (Set.disjoint_left.mp A.disjoint_support) (hRuSub w hwRu) (hRvSub w hwRv)
  have hrs : r ≠ s := by
    intro hrs
    have hrRu : r ∈ Ru.support := Ru.end_mem_support
    have hrRv : r ∈ Rv.support := by
      rw [hrs]
      exact Rv.end_mem_support
    exact (Set.disjoint_left.mp hdisjoint hrRu) hrRv
  refine ⟨{
    r := r
    s := s
    Ru := Ru
    Rv := Rv
    Ru_path := hRu
    Rv_path := hRv
    r_mem_cycle := hrC
    s_mem_cycle := hsC
    Ru_first_hit := hRuFirst
    Rv_first_hit := hRvFirst
    r_ne_s := hrs
    disjoint_support := hdisjoint }⟩

/-- The two complementary directed arcs between distinct vertices of the
chorded cycle used in source Lemma 3.2.  This package records only the cycle
decomposition itself; it deliberately makes no use of either chord or of the
Menger attachments. -/
private structure SourceLemma32CycleArcData
    (G : SimpleGraph V) (D : SourceLemma32ChordedCycleData G) (r s : V) where
  A : G.Walk r s
  B : G.Walk r s
  A_path : A.IsPath
  B_path : B.IsPath
  A_support_subset : ∀ w, w ∈ A.support → w ∈ D.C.support
  B_support_subset : ∀ w, w ∈ B.support → w ∈ D.C.support
  A_edges_subset : ∀ e, e ∈ A.edges → e ∈ D.C.edges
  B_edges_subset : ∀ e, e ∈ B.edges → e ∈ D.C.edges
  support_cover : ∀ w, w ∈ D.C.support → w ∈ A.support ∨ w ∈ B.support
  edge_cover : ∀ e, e ∈ D.C.edges → e ∈ A.edges ∨ e ∈ B.edges
  support_intersection : ∀ w, w ∈ A.support → w ∈ B.support → w = r ∨ w = s

/-- Rotate the chorded cycle to `r`, split it at `s`, and reverse the second
piece.  The resulting paths are the two complementary simple `r`--`s` arcs.
The support and edge coverage statements are retained explicitly for the
subsequent source-Lemma-3.2 rerouting argument. -/
private def sourceLemma32_cycle_arcs [DecidableEq V]
    (D : SourceLemma32ChordedCycleData G) {r s : V}
    (hr : r ∈ D.C.support) (hs : s ∈ D.C.support) (hrs : r ≠ s) :
    SourceLemma32CycleArcData G D r s := by
  let Cr : G.Walk r r := D.C.rotate hr
  have hCrCycle : Cr.IsCycle := by
    dsimp [Cr]
    exact D.isCycle.rotate hr
  have hCr_subset : ∀ w, w ∈ Cr.support → w ∈ D.C.support := by
    intro w hw
    dsimp [Cr, Walk.rotate] at hw
    rw [Walk.mem_support_append_iff] at hw
    rcases hw with hw | hw
    · exact D.C.support_dropUntil_subset hr hw
    · exact D.C.support_takeUntil_subset hr hw
  have hC_subset : ∀ w, w ∈ D.C.support → w ∈ Cr.support := by
    intro w hw
    rw [← D.C.take_spec hr, Walk.mem_support_append_iff] at hw
    dsimp [Cr, Walk.rotate]
    rw [Walk.mem_support_append_iff]
    exact hw.symm
  have hsCr : s ∈ Cr.support := hC_subset s hs
  let A : G.Walk r s := Cr.takeUntil s hsCr
  let tail : G.Walk s r := Cr.dropUntil s hsCr
  let B : G.Walk r s := tail.reverse
  have hdecomp : A.append tail = Cr := by
    dsimp [A, tail]
    exact Cr.take_spec hsCr
  have hApath : A.IsPath := by
    dsimp [A]
    exact hCrCycle.isPath_takeUntil hsCr
  have htailPath : tail.IsPath := by
    refine Walk.IsCycle.isPath_of_append_right (p := A) (q := tail)
      (Walk.not_nil_of_ne hrs) ?_
    rw [hdecomp]
    exact hCrCycle
  have hBpath : B.IsPath := by
    dsimp [B]
    exact htailPath.reverse
  have hAsubset : ∀ w, w ∈ A.support → w ∈ D.C.support := by
    intro w hw
    apply hCr_subset w
    rw [← hdecomp, Walk.mem_support_append_iff]
    exact Or.inl hw
  have hBsubset : ∀ w, w ∈ B.support → w ∈ D.C.support := by
    intro w hw
    apply hCr_subset w
    have hwtail : w ∈ tail.support := by
      dsimp [B] at hw
      rw [Walk.support_reverse, List.mem_reverse] at hw
      exact hw
    rw [← hdecomp, Walk.mem_support_append_iff]
    exact Or.inr hwtail
  have hEdgePerm : Cr.edges.Perm D.C.edges := by
    dsimp [Cr]
    exact (D.C.rotate_edges hr).perm
  have hAedges : ∀ e, e ∈ A.edges → e ∈ D.C.edges := by
    intro e he
    apply hEdgePerm.mem_iff.mp
    rw [← hdecomp, Walk.edges_append, List.mem_append]
    exact Or.inl he
  have hBedges : ∀ e, e ∈ B.edges → e ∈ D.C.edges := by
    intro e he
    apply hEdgePerm.mem_iff.mp
    have hetail : e ∈ tail.edges := by
      dsimp [B] at he
      rw [Walk.edges_reverse, List.mem_reverse] at he
      exact he
    rw [← hdecomp, Walk.edges_append, List.mem_append]
    exact Or.inr hetail
  have hsupportCover : ∀ w, w ∈ D.C.support → w ∈ A.support ∨ w ∈ B.support := by
    intro w hw
    have hwCr : w ∈ Cr.support := hC_subset w hw
    rw [← hdecomp, Walk.mem_support_append_iff] at hwCr
    rcases hwCr with hwA | hwtail
    · exact Or.inl hwA
    · right
      dsimp [B]
      rw [Walk.support_reverse, List.mem_reverse]
      exact hwtail
  have hedgeCover : ∀ e, e ∈ D.C.edges → e ∈ A.edges ∨ e ∈ B.edges := by
    intro e he
    have heCr : e ∈ Cr.edges := hEdgePerm.mem_iff.mpr he
    rw [← hdecomp, Walk.edges_append, List.mem_append] at heCr
    rcases heCr with heA | hetail
    · exact Or.inl heA
    · right
      dsimp [B]
      rw [Walk.edges_reverse, List.mem_reverse]
      exact hetail
  have hsplitNodup : (A.support.tail ++ tail.support.tail).Nodup := by
    rw [← Walk.tail_support_append, hdecomp]
    exact hCrCycle.support_nodup
  have hsplitDisjoint : A.support.tail.Disjoint tail.support.tail :=
    List.disjoint_of_nodup_append hsplitNodup
  have hintersection : ∀ w, w ∈ A.support → w ∈ B.support → w = r ∨ w = s := by
    intro w hwA hwB
    by_cases hwr : w = r
    · exact Or.inl hwr
    by_cases hws : w = s
    · exact Or.inr hws
    have hwAtail : w ∈ A.support.tail :=
      ((A.mem_support_iff).mp hwA).resolve_left hwr
    have hwBtail : w ∈ tail.support := by
      dsimp [B] at hwB
      rw [Walk.support_reverse, List.mem_reverse] at hwB
      exact hwB
    have hwtailtail : w ∈ tail.support.tail :=
      ((tail.mem_support_iff).mp hwBtail).resolve_left hws
    exact (List.disjoint_left.mp hsplitDisjoint hwAtail hwtailtail).elim
  exact {
    A := A
    B := B
    A_path := hApath
    B_path := hBpath
    A_support_subset := hAsubset
    B_support_subset := hBsubset
    A_edges_subset := hAedges
    B_edges_subset := hBedges
    support_cover := hsupportCover
    edge_cover := hedgeCover
    support_intersection := hintersection }

/-- A walk of length one contains its unique endpoint edge. -/
private theorem sourceLemma32_endpoint_edge_of_length_one
    {a b : V} (P : G.Walk a b) (hP : P.length = 1) : s(a, b) ∈ P.edges := by
  cases P with
  | nil => simp at hP
  | cons h Q =>
      cases Q with
      | nil => simp
      | cons h' Q' => simp at hP

/-- Replacing a non-edge subpath of a simple path by a graph edge gives a
strictly shorter simple path.  The proof is deliberately local to the two
source-Lemma-3.2 chord shortcuts. -/
private theorem sourceLemma32_shortcut_of_decomposition [DecidableEq V]
    {r s a b : V} (P : G.Walk r s) (hP : P.IsPath)
    (L : G.Walk r a) (M : G.Walk a b) (T : G.Walk b s)
    (hdecomp : L.append (M.append T) = P)
    (hab : G.Adj a b) (hnot : s(a, b) ∉ P.edges) :
    ∃ P' : G.Walk r s, P'.IsPath ∧ P'.length < P.length ∧
      ∀ w, w ∈ P'.support → w ∈ P.support := by
  let P' : G.Walk r s := L.append ((Walk.cons hab Walk.nil).append T)
  have hM_edges : ∀ e, e ∈ M.edges → e ∈ P.edges := by
    intro e he
    rw [← hdecomp]
    simp only [Walk.edges_append, List.mem_append]
    exact Or.inr (Or.inl he)
  have hM_long : 1 < M.length := by
    have hne : a ≠ b := hab.ne
    have hpositive : 0 < M.length := by
      rw [← Walk.not_nil_iff_lt_length]
      exact Walk.not_nil_of_ne hne
    by_contra h
    have hlength : M.length = 1 := by omega
    exact hnot (hM_edges _ (sourceLemma32_endpoint_edge_of_length_one G M hlength))
  have hbMtail : b ∈ M.support.tail :=
    ((M.mem_support_iff).mp M.end_mem_support).resolve_left hab.ne.symm
  have hsupport_sublist : List.Sublist P'.support P.support := by
    have hsingle : List.Sublist [b] M.support.tail := List.singleton_sublist.mpr hbMtail
    have hright : List.Sublist ([b] ++ T.support.tail) (M.support.tail ++ T.support.tail) :=
      hsingle.append_right _
    have hall : List.Sublist (L.support ++ ([b] ++ T.support.tail))
        (L.support ++ (M.support.tail ++ T.support.tail)) := hright.append_left _
    rw [← hdecomp, Walk.support_append, Walk.support_append]
    simpa [P', Walk.support_append, Walk.support_cons, List.append_assoc] using hall
  have hP'path : P'.IsPath := Walk.IsPath.mk' (hP.support_nodup.sublist hsupport_sublist)
  refine ⟨P', hP'path, ?_, ?_⟩
  · dsimp [P']
    simp only [Walk.length_append, Walk.length_cons, Walk.length_nil]
    rw [← hdecomp, Walk.length_append, Walk.length_append]
    omega
  · intro w hw
    exact hsupport_sublist.mem hw

/-- A non-cycle edge between two vertices of a selected cycle arc shortcuts
that arc.  The order cases are represented by the two `takeUntil`/`dropUntil`
decompositions, not by an assumed orientation of an unordered edge. -/
private theorem sourceLemma32_chord_shortcuts_path [DecidableEq V]
    {r s a b : V} (P : G.Walk r s) (hP : P.IsPath)
    (ha : a ∈ P.support) (hb : b ∈ P.support)
    (hab : G.Adj a b) (hnot : s(a, b) ∉ P.edges) :
    ∃ P' : G.Walk r s, P'.IsPath ∧ P'.length < P.length ∧
      ∀ w, w ∈ P'.support → w ∈ P.support := by
  let L : G.Walk r a := P.takeUntil a ha
  let U : G.Walk a s := P.dropUntil a ha
  have hb_split : b ∈ L.support ∨ b ∈ U.support := by
    have hb' := hb
    rw [← P.take_spec ha, Walk.mem_support_append_iff] at hb'
    change b ∈ (P.takeUntil a ha).support ∨ b ∈ (P.dropUntil a ha).support
    exact hb'
  rcases hb_split with hbL | hbU
  · let L' : G.Walk r b := L.takeUntil b hbL
    let M : G.Walk b a := L.dropUntil b hbL
    let T : G.Walk a s := U
    have hdecomp : L'.append (M.append T) = P := by
      calc
        L'.append (M.append T) = (L'.append M).append T := Walk.append_assoc _ _ _
        _ = L.append T := by rw [L.take_spec hbL]
        _ = P := P.take_spec ha
    exact sourceLemma32_shortcut_of_decomposition G P hP L' M T hdecomp hab.symm
      (by simpa only [Sym2.eq_swap] using hnot)
  · let M : G.Walk a b := U.takeUntil b hbU
    let T : G.Walk b s := U.dropUntil b hbU
    have hdecomp : L.append (M.append T) = P := by
      calc
        L.append (M.append T) = L.append U := by rw [U.take_spec hbU]
        _ = P := P.take_spec ha
    exact sourceLemma32_shortcut_of_decomposition G P hP L M T hdecomp hab hnot

/-- Splitting a simple path strictly after its original start leaves that
start out of the remaining suffix. -/
private theorem sourceLemma32_dropUntil_not_start [DecidableEq V]
    {r s x : V} {P : G.Walk r s} (hP : P.IsPath)
    (hx : x ∈ P.support) (hxr : x ≠ r) :
    r ∉ (P.dropUntil x hx).support := by
  intro hrDrop
  have hsplitNodup :
      ((P.takeUntil x hx).support ++ (P.dropUntil x hx).support.tail).Nodup := by
    rw [← Walk.support_append, P.take_spec hx]
    exact hP.support_nodup
  have hrTail : r ∈ (P.dropUntil x hx).support.tail :=
    ((P.dropUntil x hx).mem_support_iff).mp hrDrop |>.resolve_left hxr.symm
  have hdisjoint : (P.takeUntil x hx).support.Disjoint
      (P.dropUntil x hx).support.tail :=
    List.disjoint_of_nodup_append hsplitNodup
  exact (List.disjoint_left.mp hdisjoint (P.takeUntil x hx).start_mem_support) hrTail

/-- Splitting a simple path strictly before its original end leaves that end
out of the retained prefix. -/
private theorem sourceLemma32_takeUntil_not_end [DecidableEq V]
    {r s x : V} {P : G.Walk r s} (hP : P.IsPath)
    (hx : x ∈ P.support) (hxs : x ≠ s) :
    s ∉ (P.takeUntil x hx).support := by
  intro hsTake
  have hsplitNodup :
      ((P.takeUntil x hx).support ++ (P.dropUntil x hx).support.tail).Nodup := by
    rw [← Walk.support_append, P.take_spec hx]
    exact hP.support_nodup
  have hsTail : s ∈ (P.dropUntil x hx).support.tail :=
    ((P.dropUntil x hx).mem_support_iff).mp (P.dropUntil x hx).end_mem_support |>.resolve_left hxs.symm
  have hdisjoint : (P.takeUntil x hx).support.Disjoint
      (P.dropUntil x hx).support.tail :=
    List.disjoint_of_nodup_append hsplitNodup
  exact (List.disjoint_left.mp hdisjoint hsTake) hsTail

/-- The segment between two internal vertices of a simple path can be chosen
to avoid both original endpoints.  The degenerate `x = t` case is retained
as the zero-length walk needed by the later opposite-arc detour. -/
private theorem sourceLemma32_internal_subpath_avoids_endpoints [DecidableEq V]
    {r s x t : V} (S : G.Walk r s) (hS : S.IsPath)
    (hx : x ∈ S.support) (ht : t ∈ S.support)
    (hxr : x ≠ r) (hxs : x ≠ s) (htr : t ≠ r) (hts : t ≠ s) :
    ∃ U : G.Walk x t, U.IsPath ∧
      (∀ w, w ∈ U.support → w ∈ S.support) ∧
      r ∉ U.support ∧ s ∉ U.support := by
  by_cases hxt : x = t
  · subst t
    refine ⟨Walk.nil, Walk.IsPath.nil, ?_, ?_, ?_⟩
    · intro w hw
      simp only [Walk.support_nil, List.mem_singleton] at hw
      subst w
      exact hx
    · intro hr
      simp only [Walk.support_nil, List.mem_singleton] at hr
      exact hxr hr.symm
    · intro hs
      simp only [Walk.support_nil, List.mem_singleton] at hs
      exact hxs hs.symm
  · let L : G.Walk r x := S.takeUntil x hx
    let T : G.Walk x s := S.dropUntil x hx
    have htSplit : t ∈ L.support ∨ t ∈ T.support := by
      have ht' := ht
      rw [← S.take_spec hx, Walk.mem_support_append_iff] at ht'
      change t ∈ (S.takeUntil x hx).support ∨ t ∈ (S.dropUntil x hx).support
      exact ht'
    rcases htSplit with htL | htT
    · let V : G.Walk t x := L.dropUntil t htL
      let U : G.Walk x t := V.reverse
      have hL : L.IsPath := by
        dsimp [L]
        exact hS.takeUntil hx
      have hV : V.IsPath := by
        dsimp [V]
        exact hL.dropUntil htL
      have hU : U.IsPath := by
        dsimp [U]
        exact hV.reverse
      have hrV : r ∉ V.support := by
        dsimp [V]
        exact sourceLemma32_dropUntil_not_start G hL htL htr
      have hsL : s ∉ L.support := by
        dsimp [L]
        exact sourceLemma32_takeUntil_not_end G hS hx hxs
      refine ⟨U, hU, ?_, ?_, ?_⟩
      · intro w hw
        dsimp [U] at hw
        rw [Walk.support_reverse, List.mem_reverse] at hw
        exact S.support_takeUntil_subset hx (L.support_dropUntil_subset htL hw)
      · intro hr
        dsimp [U] at hr
        rw [Walk.support_reverse, List.mem_reverse] at hr
        exact hrV hr
      · intro hs
        dsimp [U] at hs
        rw [Walk.support_reverse, List.mem_reverse] at hs
        exact hsL (L.support_dropUntil_subset htL hs)
    · let U : G.Walk x t := T.takeUntil t htT
      have hT : T.IsPath := by
        dsimp [T]
        exact hS.dropUntil hx
      have hU : U.IsPath := by
        dsimp [U]
        exact hT.takeUntil htT
      have hrT : r ∉ T.support := by
        dsimp [T]
        exact sourceLemma32_dropUntil_not_start G hS hx hxr
      have hsU : s ∉ U.support := by
        dsimp [U]
        exact sourceLemma32_takeUntil_not_end G hT htT hts
      refine ⟨U, hU, ?_, ?_, hsU⟩
      · intro w hw
        exact S.support_dropUntil_subset hx (T.support_takeUntil_subset htT hw)
      · intro hr
        exact hrT (T.support_takeUntil_subset htT hr)

/-- An unordered edge occurring in a walk has one of its two directed
decompositions at that occurrence.  This proof-local form is sufficient for
the two orientations of the source Lemma 3.2 opposite-arc detour. -/
private theorem sourceLemma32_edge_decomposition [DecidableEq V]
    {r s a b : V} (P : G.Walk r s) (hab : G.Adj a b)
    (he : s(a, b) ∈ P.edges) :
    (∃ L : G.Walk r a, ∃ T : G.Walk b s,
      L.append (Walk.cons hab T) = P) ∨
    (∃ L : G.Walk r b, ∃ T : G.Walk a s,
      L.append (Walk.cons hab.symm T) = P) := by
  induction P with
  | nil => simp at he
  | @cons u v w huv Q ih =>
      rw [Walk.edges_cons, List.mem_cons] at he
      rcases he with he | he
      · rw [Sym2.eq_iff] at he
        rcases he with ⟨hau, hbv⟩ | ⟨hav, hbu⟩
        · subst a
          subst b
          left
          exact ⟨Walk.nil, Q, by simp⟩
        · subst a
          subst b
          right
          exact ⟨Walk.nil, Q, by simp⟩
      · rcases ih he with hforward | hreverse
        · rcases hforward with ⟨L, T, hL⟩
          left
          refine ⟨Walk.cons huv L, T, ?_⟩
          simpa [Walk.cons_append] using congrArg (Walk.cons huv) hL
        · rcases hreverse with ⟨L, T, hL⟩
          right
          refine ⟨Walk.cons huv L, T, ?_⟩
          simpa [Walk.cons_append] using congrArg (Walk.cons huv) hL

/-- Replace one displayed edge of a simple path by a two-edge detour through
a path whose full support is disjoint from the original path. -/
private theorem sourceLemma32_detour_of_decomposition [DecidableEq V]
    {r s a b x t u v : V} (R : G.Walk r s) (hR : R.IsPath)
    (U : G.Walk x t) (hU : U.IsPath)
    (hRU : Disjoint {w | w ∈ R.support} {w | w ∈ U.support})
    (C : G.Walk u v) (hRcycle : ∀ w, w ∈ R.support → w ∈ C.support)
    (hUcycle : ∀ w, w ∈ U.support → w ∈ C.support)
    (L : G.Walk r a) (T : G.Walk b s)
    (hab : G.Adj a b) (hdecomp : L.append (Walk.cons hab T) = R)
    (hax : G.Adj a x) (htb : G.Adj t b) :
    ∃ R' : G.Walk r s, R'.IsPath ∧ R.length < R'.length ∧
      ∀ w, w ∈ R'.support → w ∈ C.support := by
  let M : G.Walk a b := (Walk.cons hax U).concat htb
  let R' : G.Walk r s := L.append (M.append T)
  have hRsupport : R.support = L.support ++ (b :: T.support.tail) := by
    calc
      R.support = (L.append (Walk.cons hab T)).support := by rw [hdecomp]
      _ = L.support ++ T.support := by
        rw [Walk.support_append, Walk.support_cons, List.tail_cons]
      _ = L.support ++ (b :: T.support.tail) := by
        rw [Walk.support_eq_cons T, List.tail_cons]
  have hRsplit : (L.support ++ (b :: T.support.tail)).Nodup := by
    rw [← hRsupport]
    exact hR.support_nodup
  obtain ⟨hLnodup, hBTnodup, hLBdisjoint⟩ := List.nodup_append.mp hRsplit
  have hUdisjoint : U.support.Disjoint (L.support ++ (b :: T.support.tail)) := by
    rw [List.disjoint_left]
    intro w hwU hwR'
    apply Set.disjoint_left.mp hRU
    · rw [hRsupport]
      exact hwR'
    · exact hwU
  have hLUdisjoint : L.support.Disjoint U.support := by
    rw [List.disjoint_left]
    intro w hwL hwU
    exact List.disjoint_left.mp hUdisjoint hwU (List.mem_append_left _ hwL)
  have hUBdisjoint : U.support.Disjoint (b :: T.support.tail) := by
    rw [List.disjoint_left]
    intro w hwU hwB
    exact List.disjoint_left.mp hUdisjoint hwU (List.mem_append_right _ hwB)
  have hnewNodup : (L.support ++ (U.support ++ (b :: T.support.tail))).Nodup := by
    apply List.Nodup.append
    · exact hLnodup
    · exact List.Nodup.append hU.support_nodup hBTnodup hUBdisjoint
    · rw [List.disjoint_left]
      intro w hwLU hwB
      rcases List.mem_append.mp hwB with hwU | hwB
      · exact List.disjoint_left.mp hLUdisjoint hwLU hwU
      · exact List.disjoint_left.mp hLBdisjoint hwLU hwB
  have hR'support : R'.support = L.support ++ (U.support ++ (b :: T.support.tail)) := by
    dsimp [R', M]
    simp only [Walk.support_append, Walk.support_concat, Walk.support_cons, List.tail_cons]
    rw [List.concat_eq_append]
    simp only [List.singleton_append, List.append_assoc]
  have hR' : R'.IsPath := by
    apply Walk.IsPath.mk'
    rw [hR'support]
    exact hnewNodup
  refine ⟨R', hR', ?_, ?_⟩
  · have hRlength : R.length = L.length + (1 + T.length) := by
      rw [← hdecomp, Walk.length_append, Walk.length_cons]
      omega
    have hR'length : R'.length = L.length + (2 + U.length + T.length) := by
      dsimp [R', M]
      simp only [Walk.length_append, Walk.length_concat, Walk.length_cons, Walk.length_nil]
      omega
    rw [hRlength, hR'length]
    omega
  · intro w hw
    rw [hR'support] at hw
    rcases List.mem_append.mp hw with hwL | hwUT
    · exact hRcycle w (by
        rw [hRsupport]
        exact List.mem_append_left _ hwL)
    rcases List.mem_append.mp hwUT with hwU | hwBT
    · exact hUcycle w hwU
    exact hRcycle w (by
      rw [hRsupport]
      exact List.mem_append_right _ hwBT)

/-- Source Lemma 3.2, Case 3: when both chord endpoints lie on the
complementary arc, replacing the displayed cycle edge by the two chord edges
and the internal complementary subpath gives a longer simple route. -/
private theorem sourceLemma32_opposite_arc_detour [DecidableEq V]
    (D : SourceLemma32ChordedCycleData G) {r s : V}
    (R S : G.Walk r s) (hR : R.IsPath) (hS : S.IsPath)
    (hRS : ∀ w, w ∈ R.support → w ∈ S.support → w = r ∨ w = s)
    (hRcycle : ∀ w, w ∈ R.support → w ∈ D.C.support)
    (hScycle : ∀ w, w ∈ S.support → w ∈ D.C.support)
    (hedge : s(D.z, D.zplus) ∈ R.edges)
    (hxR : D.x ∉ R.support) (htR : D.t ∉ R.support)
    (hxS : D.x ∈ S.support) (htS : D.t ∈ S.support) :
    ∃ R' : G.Walk r s, R'.IsPath ∧ R.length < R'.length ∧
      ∀ w, w ∈ R'.support → w ∈ D.C.support := by
  have hxr : D.x ≠ r := by
    intro h
    apply hxR
    simpa [h] using R.start_mem_support
  have hxs : D.x ≠ s := by
    intro h
    apply hxR
    simpa [h] using R.end_mem_support
  have htr : D.t ≠ r := by
    intro h
    apply htR
    simpa [h] using R.start_mem_support
  have hts : D.t ≠ s := by
    intro h
    apply htR
    simpa [h] using R.end_mem_support
  obtain ⟨U, hU, hUS, hrU, hsU⟩ :=
    sourceLemma32_internal_subpath_avoids_endpoints G S hS hxS htS hxr hxs htr hts
  have hRU : Disjoint {w | w ∈ R.support} {w | w ∈ U.support} := by
    rw [Set.disjoint_left]
    intro w hwR hwU
    rcases hRS w hwR (hUS w hwU) with hwr | hws
    · subst w
      exact hrU hwU
    · subst w
      exact hsU hwU
  have hUcycle : ∀ w, w ∈ U.support → w ∈ D.C.support := by
    intro w hw
    exact hScycle w (hUS w hw)
  rcases sourceLemma32_edge_decomposition G R D.adjacent hedge with hforward | hreverse
  · rcases hforward with ⟨L, T, hdecomp⟩
    exact sourceLemma32_detour_of_decomposition G R hR U hU hRU D.C hRcycle hUcycle
      L T D.adjacent hdecomp D.xChordAdj D.zplusChordAdj.symm
  · rcases hreverse with ⟨L, T, hdecomp⟩
    have hRUreverse : Disjoint {w | w ∈ R.support} {w | w ∈ U.reverse.support} := by
      rw [Set.disjoint_left]
      intro w hwR hwU
      change w ∈ R.support at hwR
      change w ∈ U.reverse.support at hwU
      rw [Walk.support_reverse, List.mem_reverse] at hwU
      exact Set.disjoint_left.mp hRU hwR hwU
    have hUreversecycle : ∀ w, w ∈ U.reverse.support → w ∈ D.C.support := by
      intro w hw
      rw [Walk.support_reverse, List.mem_reverse] at hw
      exact hUcycle w hw
    exact sourceLemma32_detour_of_decomposition G R hR U.reverse hU.reverse hRUreverse
      D.C hRcycle hUreversecycle L T D.adjacent.symm hdecomp D.zplusChordAdj D.xChordAdj.symm

/-- The three source-Lemma-3.2 cases yield two simple routes of different
lengths between the two cycle-attachment vertices. -/
private structure SourceLemma32DifferentCycleRouteData
    (G : SimpleGraph V) (D : SourceLemma32ChordedCycleData G) (r s : V) where
  R : G.Walk r s
  R' : G.Walk r s
  R_path : R.IsPath
  R'_path : R'.IsPath
  R_support_cycle : ∀ w, w ∈ R.support → w ∈ D.C.support
  R'_support_cycle : ∀ w, w ∈ R'.support → w ∈ D.C.support
  length_ne : R.length ≠ R'.length

private noncomputable def sourceLemma32_different_cycle_routes [DecidableEq V]
    (D : SourceLemma32ChordedCycleData G) {r s : V}
    (E : SourceLemma32CycleArcData G D r s) :
    SourceLemma32DifferentCycleRouteData G D r s := by
  classical
  apply Classical.choice
  have hroute : ∀ (R S : G.Walk r s), R.IsPath → S.IsPath →
      (∀ w, w ∈ R.support → w ∈ S.support → w = r ∨ w = s) →
      (∀ w, w ∈ D.C.support → w ∈ R.support ∨ w ∈ S.support) →
      (∀ w, w ∈ R.support → w ∈ D.C.support) →
      (∀ w, w ∈ S.support → w ∈ D.C.support) →
      (∀ e, e ∈ R.edges → e ∈ D.C.edges) → s(D.z, D.zplus) ∈ R.edges →
      Nonempty (SourceLemma32DifferentCycleRouteData G D r s) := by
    intro R S hR hS hRS hcover hRcycle hScycle hRedges hedge
    have hzR : D.z ∈ R.support := R.fst_mem_support_of_mem_edges hedge
    have hzplusR : D.zplus ∈ R.support := R.snd_mem_support_of_mem_edges hedge
    by_cases hxR : D.x ∈ R.support
    · obtain ⟨R', hR', hlt, hR'subset⟩ := sourceLemma32_chord_shortcuts_path G R hR hzR hxR
        D.xChordAdj (fun he => D.xChord_not_cycle_edge (hRedges _ he))
      exact ⟨⟨R, R', hR, hR', hRcycle, fun w hw => hRcycle w (hR'subset w hw),
        hlt.ne.symm⟩⟩
    by_cases htR : D.t ∈ R.support
    · obtain ⟨R', hR', hlt, hR'subset⟩ := sourceLemma32_chord_shortcuts_path G R hR hzplusR htR
        D.zplusChordAdj (fun he => D.zplusChord_not_cycle_edge (hRedges _ he))
      exact ⟨⟨R, R', hR, hR', hRcycle, fun w hw => hRcycle w (hR'subset w hw),
        hlt.ne.symm⟩⟩
    have hxS : D.x ∈ S.support := (hcover D.x D.x_mem).resolve_left hxR
    have htS : D.t ∈ S.support := (hcover D.t D.t_mem).resolve_left htR
    obtain ⟨R', hR', hlt, hR'cycle⟩ := sourceLemma32_opposite_arc_detour G D R S hR hS hRS
      hRcycle hScycle hedge hxR htR hxS htS
    exact ⟨⟨R, R', hR, hR', hRcycle, hR'cycle, hlt.ne⟩⟩
  rcases E.edge_cover _ D.adjacent_cycle_edge with hA | hB
  · exact hroute E.A E.B E.A_path E.B_path E.support_intersection E.support_cover
      E.A_support_subset E.B_support_subset E.A_edges_subset hA
  · have hBA : ∀ w, w ∈ E.B.support → w ∈ E.A.support → w = r ∨ w = s := by
      intro w hwB hwA
      exact E.support_intersection w hwA hwB
    have hcoverBA : ∀ w, w ∈ D.C.support → w ∈ E.B.support ∨ w ∈ E.A.support := by
      intro w hw
      exact (E.support_cover w hw).symm
    exact hroute E.B E.A E.B_path E.A_path hBA hcoverBA E.B_support_subset
      E.A_support_subset E.B_edges_subset hB

/-- Attaching a simple cycle route to the two first-hit Menger attachments
preserves pathness.  This local form permits either attachment to have length
zero. -/
private theorem sourceLemma32_attach_cycle_route_isPath [DecidableEq V]
    (D : SourceLemma32ChordedCycleData G) {u v : V}
    (F : SourceLemma32FirstHitAttachmentData G D u v)
    (R : G.Walk F.r F.s) (hR : R.IsPath)
    (hRcycle : ∀ w, w ∈ R.support → w ∈ D.C.support) :
    (F.Ru.append (R.append F.Rv.reverse)).IsPath := by
  have hsupport : (F.Ru.append (R.append F.Rv.reverse)).support =
      F.Ru.support ++ (R.support.tail ++ F.Rv.reverse.support.tail) := by
    rw [Walk.support_append, Walk.tail_support_append]
  have hRuRtail : F.Ru.support.Disjoint R.support.tail := by
    rw [List.disjoint_left]
    intro w hwRu hwRtail
    have hwR : w ∈ R.support := (R.mem_support_iff).mpr (Or.inr hwRtail)
    have hwC : w ∈ D.C.support := hRcycle w hwR
    by_cases hwr : w = F.r
    · subst w
      have hnodup := hR.support_nodup
      rw [R.support_eq_cons] at hnodup
      exact (List.nodup_cons.mp hnodup).1 hwRtail
    · exact (F.Ru_first_hit w hwRu hwr) hwC
  have hRtailRvrev : R.support.tail.Disjoint F.Rv.reverse.support.tail := by
    rw [List.disjoint_left]
    intro w hwRtail hwRvrevTail
    have hwR : w ∈ R.support := (R.mem_support_iff).mpr (Or.inr hwRtail)
    have hwC : w ∈ D.C.support := hRcycle w hwR
    have hwRvrev : w ∈ F.Rv.reverse.support :=
      (F.Rv.reverse.mem_support_iff).mpr (Or.inr hwRvrevTail)
    rw [Walk.support_reverse, List.mem_reverse] at hwRvrev
    by_cases hws : w = F.s
    · subst w
      have hnodup := F.Rv_path.reverse.support_nodup
      rw [F.Rv.reverse.support_eq_cons] at hnodup
      exact (List.nodup_cons.mp hnodup).1 hwRvrevTail
    · exact (F.Rv_first_hit w hwRvrev hws) hwC
  have hRuRvrev : F.Ru.support.Disjoint F.Rv.reverse.support.tail := by
    rw [List.disjoint_left]
    intro w hwRu hwRvrevTail
    have hwRvrev : w ∈ F.Rv.reverse.support :=
      (F.Rv.reverse.mem_support_iff).mpr (Or.inr hwRvrevTail)
    rw [Walk.support_reverse, List.mem_reverse] at hwRvrev
    exact (Set.disjoint_left.mp F.disjoint_support) hwRu hwRvrev
  have hRtailNodup : R.support.tail.Nodup := hR.support_nodup.tail
  have hRvrevTailNodup : F.Rv.reverse.support.tail.Nodup :=
    F.Rv_path.reverse.support_nodup.tail
  have hRtailRvrevNodup : (R.support.tail ++ F.Rv.reverse.support.tail).Nodup :=
    List.Nodup.append hRtailNodup hRvrevTailNodup hRtailRvrev
  have hRuRest : F.Ru.support.Disjoint
      (R.support.tail ++ F.Rv.reverse.support.tail) := by
    rw [List.disjoint_left]
    intro w hwRu hwRest
    rcases List.mem_append.mp hwRest with hwRtail | hwRvrevTail
    · exact List.disjoint_left.mp hRuRtail hwRu hwRtail
    · exact List.disjoint_left.mp hRuRvrev hwRu hwRvrevTail
  have hnodup : (F.Ru.support ++
      (R.support.tail ++ F.Rv.reverse.support.tail)).Nodup :=
    List.Nodup.append F.Ru_path.support_nodup hRtailRvrevNodup hRuRest
  apply Walk.IsPath.mk'
  rw [hsupport]
  exact hnodup
noncomputable local instance sourceLemma32_decidableAdj : DecidableRel G.Adj := Classical.decRel _

/-- Source Lemma 3.2: in a 2-connected finite graph whose only possible
vertex below degree three is `exceptional`, distinct vertices are joined by
simple paths of different lengths. -/
theorem sourceLemma32_atMostOneDegreeTwo [Fintype V] [DecidableEq V]
    (h2conn : VertexConnectivityAtLeast G 2) (exceptional : V)
    (hdegreeTwo : ∀ a, 2 ≤ G.degree a)
    (hdegreeThree : ∀ a, a ≠ exceptional → 3 ≤ G.degree a)
    (u v : V) (huv : u ≠ v) :
    ∃ P Q : G.Walk u v, P.IsPath ∧ Q.IsPath ∧ P.length ≠ Q.length := by
  classical
  obtain ⟨x, y, W, hW, hxy, hyW, hmax, hminimal⟩ :=
    exists_extremalLongestPathFrom G hdegreeTwo exceptional
  have hx_ne_exceptional : x ≠ exceptional := by
    intro hxe
    subst x
    rw [Walk.isPath_iff_eq_nil] at hW
    subst W
    obtain ⟨a, hea⟩ := (G.degree_pos_iff_exists_adj exceptional).mp
      (lt_of_lt_of_le (by decide) (hdegreeTwo exceptional))
    let T : G.Walk exceptional a := Walk.cons hea Walk.nil
    have hT : T.IsPath := by
      dsimp [T]
      exact (Walk.cons_isPath_iff hea Walk.nil).mpr ⟨Walk.IsPath.nil, by simpa using hea.ne⟩
    have hcontr : 1 ≤ 0 := by
      simpa [T] using hmax a T hT
    omega
  have hxDegree : 3 ≤ G.degree x := hdegreeThree x hx_ne_exceptional
  let S : G.Walk y x := sourceLemma32Suffix G W hyW
  have hS : S.IsPath := sourceLemma32Suffix_isPath G hW hyW
  obtain ⟨z, hzS, hzy, hxz, zplus, hz_zplus, tailZ, hzplus_ne_x, hdropZ⟩ :=
    sourceLemma32_choose_x_chord_neighbour G hxDegree hW hmax hminimal hyW hxy
  have hzplusS : zplus ∈ (sourceLemma32Suffix G W hyW).support := by
    have hzplusDrop : zplus ∈ ((sourceLemma32Suffix G W hyW).dropUntil z hzS).support := by
      rw [hdropZ]
      simp only [Walk.support_cons, List.mem_cons]
      exact Or.inr tailZ.start_mem_support
    exact (sourceLemma32Suffix G W hyW).support_dropUntil_subset hzS hzplusDrop
  have hzplus_ne_exceptional : zplus ≠ exceptional := by
    intro hzplusE
    have hzplus_ne_y := sourceLemma32_successor_ne_start G hS hzS hzy hdropZ
    have hstart : exceptional = y :=
      sourceLemma32_start_eq_of_mem_suffix G hW hyW (by simpa [hzplusE] using hzplusS)
    exact hzplus_ne_y (hzplusE.trans hstart)
  have hzplusDegree : 3 ≤ G.degree zplus :=
    hdegreeThree zplus hzplus_ne_exceptional
  obtain ⟨hzplusS, hzplus_ne_y, znext, hzplus_znext, tailNext, hdropNext,
    t, htS, hzplus_t, ht_ne_z, ht_ne_znext⟩ :=
    sourceLemma32_choose_zplus_chord_neighbour G hzplusDegree hW hmax hminimal hyW hzS hzy hxz
      hzplus_ne_x hdropZ
  let D : SourceLemma32ChordedCycleData G := sourceLemma32_chorded_cycle_data G hS hxy
    hzS hzy hxz hzplus_ne_x hdropZ hzplusS hzplus_ne_y hdropNext htS hzplus_t ht_ne_z ht_ne_znext
  rcases sourceLemma32_two_attachments_to_chorded_cycle G h2conn D huv with ⟨L⟩
  rcases sourceLemma32_normalize_two_attachments G D huv L with ⟨A⟩
  rcases sourceLemma32_first_hit_attachments G D A with ⟨F⟩
  let E : SourceLemma32CycleArcData G D F.r F.s :=
    sourceLemma32_cycle_arcs G D F.r_mem_cycle F.s_mem_cycle F.r_ne_s
  let routes : SourceLemma32DifferentCycleRouteData G D F.r F.s :=
    sourceLemma32_different_cycle_routes G D E
  let P : G.Walk u v := F.Ru.append (routes.R.append F.Rv.reverse)
  let Q : G.Walk u v := F.Ru.append (routes.R'.append F.Rv.reverse)
  refine ⟨P, Q, ?_, ?_, ?_⟩
  · dsimp [P]
    exact sourceLemma32_attach_cycle_route_isPath G D F routes.R routes.R_path
      routes.R_support_cycle
  · dsimp [Q]
    exact sourceLemma32_attach_cycle_route_isPath G D F routes.R' routes.R'_path
      routes.R'_support_cycle
  · have hP : P.length = F.Ru.length + routes.R.length + F.Rv.length := by
      dsimp [P]
      rw [Walk.length_append, Walk.length_append, Walk.length_reverse]
      omega
    have hQ : Q.length = F.Ru.length + routes.R'.length + F.Rv.length := by
      dsimp [Q]
      rw [Walk.length_append, Walk.length_append, Walk.length_reverse]
      omega
    intro hPQ
    apply routes.length_ne
    omega
/-- The all-degree-three form of source Lemma 3.2, retained as a specialization. -/
theorem sourceLemma32_minDegreeThree [Fintype V] [DecidableEq V]
    (h2conn : VertexConnectivityAtLeast G 2)
    (hmin : ∀ a, 3 ≤ G.degree a)
    (u v : V) (huv : u ≠ v) :
    ∃ P Q : G.Walk u v, P.IsPath ∧ Q.IsPath ∧ P.length ≠ Q.length := by
  apply sourceLemma32_atMostOneDegreeTwo G h2conn u
  · intro a
    exact le_trans (by decide) (hmin a)
  · intro a _
    exact hmin a
  · exact huv

/-- A 4-connected finite graph has the exact four-path linkage supplied by
`finiteMenger_four_sets` for disjoint terminal sets of size at least four. -/
theorem fourABLinkage_of_vertexConnectivity [Fintype V] [DecidableEq V]
    (hconn : VertexConnectivityAtLeast G 4) (A B : Finset V)
    (hA : 4 ≤ A.card) (hB : 4 ≤ B.card) (hAB : Disjoint A B) :
    FourABLinkage G A B := by
  apply finiteMenger_four_sets G A B hA hB hAB
  intro S hS hsep
  obtain ⟨a, haA, haS⟩ := S.exists_mem_not_mem_of_card_lt_card (by omega : S.card < A.card)
  obtain ⟨b, hbB, hbS⟩ := S.exists_mem_not_mem_of_card_lt_card (by omega : S.card < B.card)
  obtain ⟨p, hpavoid⟩ := induced_reachable_has_walk_avoiding G haS hbS
    (reachable_after_delete_of_vertexConnectivity G hconn S hS haS hbS)
  obtain ⟨v, hvS, hvp⟩ := hsep haA hbB p
  exact hpavoid v hvp hvS

/-- The graph neighbourhood `Γ_G(K)` of a vertex set, used in source Section 3. -/
def sourceGraphNeighbourhood (K : Set V) : Set V :=
  {v | ∃ k, k ∈ K ∧ G.Adj v k}
/-- The proof-local content of a component of the graph outside a cycle. -/
private structure SourceLemma33ComponentData
    (G : SimpleGraph V) {r : V} (C : G.Walk r r) (K : Set V) : Prop where
  nonempty : K.Nonempty
  disjoint_cycle : ∀ v, v ∈ K → v ∉ C.support
  connected : (G.induce K).Connected
  closed_outside_cycle : ∀ {a b : V}, a ∈ K → G.Adj a b → b ∉ C.support → b ∈ K

/-- The proof-local endblock facts used by source Lemma 3.3.  This is not a
generic block-cut API: it records exactly the degrees and separation consumed
by the later attachment argument. -/
private structure SourceLemma33EndblockData [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (K : Set V) where
  B : Finset V
  nonempty : B.Nonempty
  subset_component : (↑B : Set V) ⊆ K
  cut : Option V
  cut_mem : ∀ z, cut = some z → z ∈ B
  two_connected : VertexConnectivityAtLeast (G.induce (↑B : Set V)) 2
  noncut_closed : ∀ ⦃b a : V⦄, b ∈ B → cut ≠ some b → G.Adj b a → a ∈ K → a ∈ B
  noncut_degree : ∀ b : {b // b ∈ B}, cut ≠ some b.1 →
    3 ≤ (G.induce (↑B : Set V)).degree b
  cut_degree : ∀ z : {z // z ∈ B}, cut = some z.1 →
    2 ≤ (G.induce (↑B : Set V)).degree z
  separates : ∀ ⦃z b a : V⦄, cut = some z → b ∈ B → b ≠ z →
    a ∈ K → a ∉ B → ∀ p : G.Walk b a,
      internalVertices G p ⊆ K → z ∈ p.support

/-- The original-vertex state carried by the proof-local finite descent.  The
working set stays a `Finset V`; induced subgraphs are used only for local
connectivity and degree statements. -/
private structure SourceLemma33DescentState [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (K : Set V) where
  W : Finset V
  subset_component : (↑W : Set V) ⊆ K
  boundary : Option V
  boundary_mem : ∀ z, boundary = some z → z ∈ W
  connected : (G.induce (↑W : Set V)).Connected
  nonboundary_nonempty : ∃ b, b ∈ W ∧ boundary ≠ some b
  nonboundary_closed : ∀ ⦃b a : V⦄, b ∈ W → boundary ≠ some b →
    G.Adj b a → a ∈ K → a ∈ W
  nonboundary_degree : ∀ b : {b // b ∈ W}, boundary ≠ some b.1 →
    3 ≤ (G.induce (↑W : Set V)).degree b

/-- The initial source component is a descent state with no boundary vertex. -/
private def sourceLemma33_initial_descent_state [Fintype V] [DecidableEq V]
    (K : Finset V)
    (hconnected : (G.induce (↑K : Set V)).Connected)
    (hdegree : ∀ b : {b // b ∈ K}, 3 ≤ (G.induce (↑K : Set V)).degree b) :
    SourceLemma33DescentState G (↑K : Set V) := by
  refine
    { W := K
      subset_component := by intro b hb; exact hb
      boundary := none
      boundary_mem := by intro z hz; simp at hz
      connected := hconnected
      nonboundary_nonempty := by
        obtain ⟨b⟩ := hconnected.nonempty
        exact ⟨b.1, b.2, by simp⟩
      nonboundary_closed := ?_
      nonboundary_degree := ?_ }
  · intro b a _ _ _ ha
    exact ha
  · intro b _
    exact hdegree b

/-- Every descent state has more than two vertices, obtained from one
non-boundary vertex of induced degree at least three. -/
private theorem sourceLemma33_descentState_card_gt_two [Fintype V] [DecidableEq V]
    (S : SourceLemma33DescentState G K) : 2 < S.W.card := by
  letI : DecidableRel (G.induce (↑S.W : Set V)).Adj := Classical.decRel _
  obtain ⟨b, hbW, hbnonboundary⟩ := S.nonboundary_nonempty
  let bW : {b // b ∈ S.W} := ⟨b, hbW⟩
  have hdegree := S.nonboundary_degree bW hbnonboundary
  have hlt := (G.induce (↑S.W : Set V)).degree_lt_card_verts bW
  have hthree : 3 < Fintype.card {b // b ∈ S.W} := lt_of_le_of_lt hdegree hlt
  simpa only [Fintype.card_coe] using (show 2 < Fintype.card {b // b ∈ S.W} by omega)

/-- Every deletion component of a current descent state is adjacent to the
deleted cut vertex. -/
private theorem sourceLemma33_connected_set_adj_cut [Fintype V] [DecidableEq V]
    (W : Finset V) (hconnected : (G.induce (↑W : Set V)).Connected)
    (z : {v // v ∈ W})
    (c : (G.induce {v : V | v ∈ W ∧ v ≠ z.1}).ConnectedComponent) :
    ∃ b, b ∈ sourceLemma33DeletionComponent G (↑W : Set V) z.1 c ∧ G.Adj z.1 b := by
  let L := sourceLemma33DeletionComponent G (↑W : Set V) z.1 c
  obtain ⟨b₀, hb₀⟩ := sourceLemma33_deletionComponent_nonempty G c
  have hb₀W : b₀ ∈ W := sourceLemma33_deletionComponent_subset G c hb₀
  have hznotL : z.1 ∉ L := by
    rintro ⟨hzW, _⟩
    exact hzW.2 rfl
  obtain ⟨q⟩ := hconnected.preconnected ⟨b₀, hb₀W⟩ z
  let inclusion : G.induce (↑W : Set V) →g G := {
    toFun := Subtype.val
    map_rel' := by intro a b hab; exact hab }
  let p : G.Walk b₀ z.1 := by simpa [inclusion] using q.map inclusion
  have hpW : ∀ x, x ∈ p.support → x ∈ W := by
    intro x hx
    have hxmap : x ∈ q.support.map inclusion := by simpa [p, inclusion] using hx
    rcases List.mem_map.mp hxmap with ⟨y, hy, hyx⟩
    subst x
    exact y.2
  obtain ⟨d, hd, hdL, hdnotL⟩ := p.exists_boundary_dart L hb₀ hznotL
  have hdsW : d.snd ∈ W := hpW d.snd (p.dart_snd_mem_support_of_mem_darts hd)
  have hds := sourceLemma33_deletionComponent_neighbour_subset G c hdL hdsW d.adj
  have hdsz : d.snd = z.1 := by
    rcases hds with hdsL | hdsz
    · exact (hdnotL hdsL).elim
    · exact hdsz
  refine ⟨d.fst, hdL, ?_⟩
  simpa [hdsz] using d.adj.symm

private theorem sourceLemma33_deletionComponent_adj_cut [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K)
    (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent) :
    ∃ b, b ∈ sourceLemma33DeletionComponent G (↑S.W : Set V) z.1 c ∧ G.Adj z.1 b := by
  exact sourceLemma33_connected_set_adj_cut G S.W S.connected z c

/-- The original-vertex representation of a deletion component is connected. -/
private theorem sourceLemma33_deletionComponent_connected
    {K : Set V} {z : V}
    (c : (G.induce {v : V | v ∈ K ∧ v ≠ z}).ConnectedComponent) :
    (G.induce (sourceLemma33DeletionComponent G K z c)).Connected := by
  let H : SimpleGraph {v : V | v ∈ K ∧ v ≠ z} :=
    G.induce {v : V | v ∈ K ∧ v ≠ z}
  let L := sourceLemma33DeletionComponent G K z c
  change (G.induce L).Connected
  let f : (H.induce c.supp) →g G.induce L := {
    toFun := fun x => ⟨x.1.1, ⟨x.1.2, (c.mem_supp_iff x.1).mp x.2⟩⟩
    map_rel' := by
      intro x y hxy
      exact hxy }
  apply (c.connected_induce_supp).map f
  intro b
  rcases b.2 with ⟨hb, hbc⟩
  refine ⟨⟨⟨b.1, hb⟩, (c.mem_supp_iff _).mpr hbc⟩, ?_⟩
  rfl

private def sourceLemma33DeletionComponentWithCut [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K)
    (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent) : Set V :=
  sourceLemma33DeletionComponent G (↑S.W : Set V) z.1 c ∪ {z.1}

noncomputable local instance sourceLemma33_deletionComponentWithCut_decidable
    [Fintype V] [DecidableEq V] {K : Set V}
    (S : SourceLemma33DescentState G K)
    (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent) :
    DecidablePred (sourceLemma33DeletionComponentWithCut G S z c) :=
  Classical.decPred _

noncomputable local instance sourceLemma33_deletionComponentWithCut_fintype
    [Fintype V] [DecidableEq V] {K : Set V}
    (S : SourceLemma33DescentState G K)
    (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent) :
    Fintype (sourceLemma33DeletionComponentWithCut G S z c) := Fintype.ofFinite _

/-- Adjoining the deleted cut vertex to any deletion component leaves a
connected induced graph. -/
private theorem sourceLemma33_connected_set_with_cut
    [Fintype V] [DecidableEq V] (W : Finset V) (hconnected : (G.induce (↑W : Set V)).Connected)
    (z : {v // v ∈ W})
    (c : (G.induce {v : V | v ∈ W ∧ v ≠ z.1}).ConnectedComponent) :
    (G.induce
      (sourceLemma33DeletionComponent G (↑W : Set V) z.1 c ∪ {z.1})).Connected := by
  let L := sourceLemma33DeletionComponent G (↑W : Set V) z.1 c
  have hL : (G.induce L).Connected := sourceLemma33_deletionComponent_connected G c
  obtain ⟨b, hbL, hzb⟩ := sourceLemma33_connected_set_adj_cut G W hconnected z c
  change (G.induce (L ∪ {z.1})).Connected
  let inclusion : G.induce L →g G.induce (L ∪ {z.1}) := {
    toFun := fun x => ⟨x.1, Or.inl x.2⟩
    map_rel' := by
      intro x y hxy
      exact hxy }
  rw [SimpleGraph.connected_iff_exists_forall_reachable]
  refine ⟨⟨b, Or.inl hbL⟩, ?_⟩
  rintro ⟨y, hy⟩
  rcases hy with hyL | hyz
  · obtain ⟨p⟩ := hL.preconnected ⟨b, hbL⟩ ⟨y, hyL⟩
    exact ⟨p.map inclusion⟩
  · subst y
    have hbz : (G.induce (L ∪ {z.1})).Adj
        ⟨b, Or.inl hbL⟩ ⟨z.1, Or.inr rfl⟩ := hzb.symm
    exact ⟨Walk.cons hbz Walk.nil⟩

private theorem sourceLemma33_deletionComponent_with_cut_connected
    [Fintype V] [DecidableEq V] {K : Set V}
    (S : SourceLemma33DescentState G K)
    (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent) :
    (G.induce
      (sourceLemma33DeletionComponentWithCut G S z c)).Connected := by
  exact sourceLemma33_connected_set_with_cut G S.W S.connected z c

set_option maxHeartbeats 1000000

/-- A deletion-component vertex has the same induced degree before and after
adjoining the deleted cut vertex. -/
private theorem sourceLemma33_deletionComponent_with_cut_degree_eq
    [Fintype V] [DecidableEq V] {K : Set V}
    (S : SourceLemma33DescentState G K)
    (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent)
    (b : V)
    (hb : b ∈ sourceLemma33DeletionComponent G (↑S.W : Set V) z.1 c) :
    (G.induce
      (sourceLemma33DeletionComponentWithCut G S z c)).degree
        ⟨b, Or.inl hb⟩ =
      (G.induce (↑S.W : Set V)).degree
        ⟨b, sourceLemma33_deletionComponent_subset G c hb⟩ := by
  classical
  rw [← (G.induce (sourceLemma33DeletionComponentWithCut G S z c)).card_neighborSet_eq_degree,
    ← (G.induce (↑S.W : Set V)).card_neighborSet_eq_degree]
  let e :
      (G.induce (sourceLemma33DeletionComponentWithCut G S z c)).neighborSet ⟨b, Or.inl hb⟩ ≃
        (G.induce (↑S.W : Set V)).neighborSet
          ⟨b, sourceLemma33_deletionComponent_subset G c hb⟩ := {
    toFun := fun a =>
      ⟨⟨a.1.1, by
          rcases a.1.2 with haL | haZ
          · exact sourceLemma33_deletionComponent_subset G c haL
          · have haZeq : a.1.1 = z.1 := by simpa using haZ
            simpa [haZeq] using z.2⟩, a.2⟩
    invFun := fun a =>
      ⟨⟨a.1.1,
          sourceLemma33_deletionComponent_neighbour_subset G c hb a.1.2 a.2⟩, a.2⟩
    left_inv := by
      intro a
      apply Subtype.ext
      apply Subtype.ext
      rfl
    right_inv := by
      intro a
      apply Subtype.ext
      apply Subtype.ext
      rfl }
  exact Fintype.card_congr e

set_option maxHeartbeats 200000

/-- The old non-boundary degree lower bound transports to a deletion component
vertex after adjoining the cut vertex. -/
private theorem sourceLemma33_deletionComponent_with_cut_degree_three
    [Fintype V] [DecidableEq V] {K : Set V}
    (S : SourceLemma33DescentState G K)
    (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent)
    (b : V)
    (hb : b ∈ sourceLemma33DeletionComponent G (↑S.W : Set V) z.1 c)
    (hbBoundary : S.boundary ≠ some b) :
    3 ≤ (G.induce
      (sourceLemma33DeletionComponentWithCut G S z c)).degree
        ⟨b, Or.inl hb⟩ := by
  classical
  rw [sourceLemma33_deletionComponent_with_cut_degree_eq G S z c b hb]
  exact S.nonboundary_degree
    ⟨b, sourceLemma33_deletionComponent_subset G c hb⟩ hbBoundary

private theorem sourceLemma33_exists_unreachable_of_not_connected
    {U : Type*} (H : SimpleGraph U) (p : U) (hDisconnected : ¬ H.Connected) :
    ∃ q, ¬ H.Reachable p q := by
  by_contra h
  push_neg at h
  exact hDisconnected ((SimpleGraph.connected_iff_exists_forall_reachable H).mpr ⟨p, h⟩)

private theorem sourceLemma33_choose_descent_component [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K) (z : {v // v ∈ S.W})
    (hDisconnected : ¬ (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).Connected) :
    ∃ c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent,
      (∀ b, b ∈ sourceLemma33DeletionComponent G (↑S.W : Set V) z.1 c →
        S.boundary ≠ some b) ∧
      ∃ q, q ∈ S.W ∧ q ≠ z.1 ∧
        q ∉ sourceLemma33DeletionComponent G (↑S.W : Set V) z.1 c := by
  classical
  let D := G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}
  have hcard : 2 < S.W.card := sourceLemma33_descentState_card_gt_two G S
  have hsingle : ({z.1} : Finset V).card < S.W.card := by simp; omega
  obtain ⟨a, haW, haZ⟩ :=
    ({z.1} : Finset V).exists_mem_not_mem_of_card_lt_card hsingle
  have haNe : a ≠ z.1 := by simpa using haZ
  let aD : {v : V | v ∈ S.W ∧ v ≠ z.1} := ⟨a, haW, haNe⟩
  have hDDisconnected : ¬ D.Connected := by simpa [D] using hDisconnected
  cases hboundary : S.boundary with
  | none =>
      obtain ⟨q, hq⟩ := sourceLemma33_exists_unreachable_of_not_connected D aD hDDisconnected
      let c := D.connectedComponentMk aD
      refine ⟨c, ?_, q.1, q.2.1, q.2.2, ?_⟩
      · intro b hb; simp [hboundary]
      · rintro ⟨hqD, hqComponent⟩
        apply hq
        apply SimpleGraph.ConnectedComponent.exact
        exact hqComponent.symm
  | some p =>
      by_cases hpz : p = z.1
      · obtain ⟨q, hq⟩ := sourceLemma33_exists_unreachable_of_not_connected D aD hDDisconnected
        let c := D.connectedComponentMk aD
        refine ⟨c, ?_, q.1, q.2.1, q.2.2, ?_⟩
        · intro b hb hboundary'
          have hpb : p = b := Option.some.inj hboundary'
          exact hb.1.2 (hpb.symm.trans hpz)
        · rintro ⟨hqD, hqComponent⟩
          apply hq
          apply SimpleGraph.ConnectedComponent.exact
          exact hqComponent.symm
      · have hpW : p ∈ S.W := S.boundary_mem p hboundary
        let pD : {v : V | v ∈ S.W ∧ v ≠ z.1} := ⟨p, hpW, hpz⟩
        obtain ⟨q, hq⟩ := sourceLemma33_exists_unreachable_of_not_connected D pD hDDisconnected
        let c := D.connectedComponentMk q
        refine ⟨c, ?_, p, hpW, hpz, ?_⟩
        · intro b hb hboundary'
          have hbp : b = p := Option.some.inj hboundary'.symm
          subst b
          apply hq
          apply SimpleGraph.ConnectedComponent.exact
          change D.connectedComponentMk pD = D.connectedComponentMk q
          exact hb.2
        · rintro ⟨hpD, hpComponent⟩
          apply hq
          apply SimpleGraph.ConnectedComponent.exact
          change D.connectedComponentMk pD = D.connectedComponentMk q
          exact hpComponent

private noncomputable def sourceLemma33_descentFinset [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K) (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent) : Finset V := by
  classical
  exact S.W.filter fun v =>
    v ∈ sourceLemma33DeletionComponent G (↑S.W : Set V) z.1 c ∨ v = z.1

private theorem mem_sourceLemma33_descentFinset [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K) (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent) (v : V) :
    v ∈ sourceLemma33_descentFinset G S z c ↔
      v ∈ sourceLemma33DeletionComponent G (↑S.W : Set V) z.1 c ∪ {z.1} := by
  classical
  simp only [sourceLemma33_descentFinset, Finset.mem_filter, Set.mem_union,
    Set.mem_singleton_iff]
  constructor
  · rintro ⟨_, hvL | hvz⟩
    · exact Or.inl hvL
    · exact Or.inr hvz
  · rintro (hvL | hvz)
    · exact ⟨sourceLemma33_deletionComponent_subset G c hvL, Or.inl hvL⟩
    · subst v
      exact ⟨z.2, Or.inr rfl⟩

/-- The Finset coercion is definitionally usable as the existing Set-based
component-with-cut interface. -/
private theorem coe_sourceLemma33_descentFinset [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K) (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent) :
    (↑(sourceLemma33_descentFinset G S z c) : Set V) =
      sourceLemma33DeletionComponent G (↑S.W : Set V) z.1 c ∪ {z.1} := by
  ext v
  exact mem_sourceLemma33_descentFinset G S z c v

private theorem sourceLemma33_descentFinset_subset [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K) (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent) :
    sourceLemma33_descentFinset G S z c ⊆ S.W := by
  classical
  intro v hv
  simpa [sourceLemma33_descentFinset] using (Finset.mem_filter.mp hv).1

private theorem sourceLemma33_descentFinset_connected [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K) (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent) :
    (G.induce (↑(sourceLemma33_descentFinset G S z c) : Set V)).Connected := by
  rw [coe_sourceLemma33_descentFinset G S z c]
  exact sourceLemma33_deletionComponent_with_cut_connected G S z c

private theorem sourceLemma33_descentFinset_degree_three [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K) (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent)
    (b : V) (hb : b ∈ sourceLemma33DeletionComponent G (↑S.W : Set V) z.1 c)
    (hbBoundary : S.boundary ≠ some b) :
    3 ≤ (G.induce (↑(sourceLemma33_descentFinset G S z c) : Set V)).degree
      ⟨b, (mem_sourceLemma33_descentFinset G S z c b).mpr (Or.inl hb)⟩ := by
  classical
  rw [← (G.induce (↑(sourceLemma33_descentFinset G S z c) : Set V)).card_neighborSet_eq_degree]
  let e :
      (G.induce (↑(sourceLemma33_descentFinset G S z c) : Set V)).neighborSet
        ⟨b, (mem_sourceLemma33_descentFinset G S z c b).mpr (Or.inl hb)⟩ ≃
      (G.induce (↑S.W : Set V)).neighborSet
        ⟨b, sourceLemma33_deletionComponent_subset G c hb⟩ := {
    toFun := fun a =>
      ⟨⟨a.1.1, sourceLemma33_descentFinset_subset G S z c a.1.2⟩, a.2⟩
    invFun := fun a =>
      ⟨⟨a.1.1,
          (mem_sourceLemma33_descentFinset G S z c a.1.1).mpr
            (sourceLemma33_deletionComponent_neighbour_subset G c hb a.1.2 a.2)⟩, a.2⟩
    left_inv := by
      intro a
      apply Subtype.ext
      apply Subtype.ext
      rfl
    right_inv := by
      intro a
      apply Subtype.ext
      apply Subtype.ext
      rfl }
  rw [Fintype.card_congr e]
  simpa only [← (G.induce (↑S.W : Set V)).card_neighborSet_eq_degree] using
    S.nonboundary_degree ⟨b, sourceLemma33_deletionComponent_subset G c hb⟩ hbBoundary

private theorem sourceLemma33_descentFinset_ssubset [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K) (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent)
    {q : V} (hqW : q ∈ S.W) (hqz : q ≠ z.1)
    (hqL : q ∉ sourceLemma33DeletionComponent G (↑S.W : Set V) z.1 c) :
    sourceLemma33_descentFinset G S z c ⊂ S.W := by
  refine (Finset.ssubset_iff_of_subset (sourceLemma33_descentFinset_subset G S z c)).mpr ?_
  refine ⟨q, hqW, ?_⟩
  intro hqNew
  rcases (mem_sourceLemma33_descentFinset G S z c q).mp hqNew with hqL' | hqz'
  · exact hqL hqL'
  · exact hqz hqz'

private theorem sourceLemma33_descentFinset_card_lt [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K) (z : {v // v ∈ S.W})
    (c : (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).ConnectedComponent)
    {q : V} (hqW : q ∈ S.W) (hqz : q ≠ z.1)
    (hqL : q ∉ sourceLemma33DeletionComponent G (↑S.W : Set V) z.1 c) :
    (sourceLemma33_descentFinset G S z c).card < S.W.card :=
  Finset.card_lt_card (sourceLemma33_descentFinset_ssubset G S z c hqW hqz hqL)

/-- One non-2-connected descent state yields a strictly smaller descent state.
The component-selection result preserves the old-boundary condition required by
closure and degree transport. -/
private theorem sourceLemma33_descent_step [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K)
    (hnotTwo : ¬ VertexConnectivityAtLeast (G.induce (↑S.W : Set V)) 2) :
    ∃ S' : SourceLemma33DescentState G K, S'.W.card < S.W.card := by
  classical
  let H : SimpleGraph {v : V | v ∈ S.W} := G.induce (↑S.W : Set V)
  letI : DecidableRel H.Adj := Classical.decRel _
  have hcard : 2 < Fintype.card {v : V | v ∈ S.W} := by
    simpa using sourceLemma33_descentState_card_gt_two G S
  obtain ⟨z, hzDisconnected⟩ :=
    sourceLemma33_exists_cut_vertex_of_card H S.connected hcard hnotTwo
  have hOriginalDisconnected :
      ¬ (G.induce {v : V | v ∈ S.W ∧ v ≠ z.1}).Connected :=
    sourceLemma33_original_delete_disconnected G S.W z hzDisconnected
  obtain ⟨c, hBoundary, q, hqW, hqz, hqOutside⟩ :=
    sourceLemma33_choose_descent_component G S z hOriginalDisconnected
  let W' := sourceLemma33_descentFinset G S z c
  let S' : SourceLemma33DescentState G K :=
    { W := W'
      subset_component := by
        intro b hb
        exact S.subset_component (sourceLemma33_descentFinset_subset G S z c hb)
      boundary := some z.1
      boundary_mem := by
        intro y hy
        have hyz : y = z.1 := Option.some.inj hy.symm
        subst y
        exact (mem_sourceLemma33_descentFinset G S z c z.1).mpr (Or.inr rfl)
      connected := sourceLemma33_descentFinset_connected G S z c
      nonboundary_nonempty := by
        obtain ⟨b, hbL⟩ := sourceLemma33_deletionComponent_nonempty G c
        refine ⟨b, (mem_sourceLemma33_descentFinset G S z c b).mpr (Or.inl hbL), ?_⟩
        intro hzb
        have hzb' : z.1 = b := Option.some.inj hzb
        exact hbL.1.2 hzb'.symm
      nonboundary_closed := by
        intro b a hbW hbBoundary hba haK
        rcases (mem_sourceLemma33_descentFinset G S z c b).mp hbW with hbL | hbz
        · have hOldBoundary : S.boundary ≠ some b := hBoundary b hbL
          have haW : a ∈ S.W := S.nonboundary_closed
            (sourceLemma33_deletionComponent_subset G c hbL) hOldBoundary hba haK
          exact (mem_sourceLemma33_descentFinset G S z c a).mpr
            (sourceLemma33_deletionComponent_neighbour_subset G c hbL haW hba)
        · exfalso
          apply hbBoundary
          have hzb' : b = z.1 := Set.mem_singleton_iff.mp hbz
          subst b
          rfl
      nonboundary_degree := by
        intro b hbBoundary
        rcases (mem_sourceLemma33_descentFinset G S z c b.1).mp b.2 with hbL | hbz
        · have hOldBoundary : S.boundary ≠ some b.1 := hBoundary b.1 hbL
          simpa using sourceLemma33_descentFinset_degree_three G S z c b.1 hbL hOldBoundary
        · exfalso
          apply hbBoundary
          have hzb' : b.1 = z.1 := Set.mem_singleton_iff.mp hbz
          exact congrArg some hzb'.symm }
  refine ⟨S', ?_⟩
  exact sourceLemma33_descentFinset_card_lt G S z c hqW hqz hqOutside

/-- A 2-connected terminal descent state is precisely the source endblock.
The supported-walk separation field is derived here from closure, rather than
being transported through recursive calls. -/
private def sourceLemma33_endblock_of_terminal_state [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K)
    (h2conn : VertexConnectivityAtLeast (G.induce (↑S.W : Set V)) 2) :
    SourceLemma33EndblockData G K := by
  letI : DecidableRel (G.induce (↑S.W : Set V)).Adj := Classical.decRel _
  refine
    { B := S.W
      nonempty := by
        obtain ⟨w⟩ := S.connected.nonempty
        exact ⟨w.1, w.2⟩
      subset_component := S.subset_component
      cut := S.boundary
      cut_mem := S.boundary_mem
      two_connected := h2conn
      noncut_closed := S.nonboundary_closed
      noncut_degree := S.nonboundary_degree
      cut_degree := ?_
      separates := ?_ }
  · intro z hz
    exact degree_two_of_vertexConnectivity (G.induce (↑S.W : Set V)) h2conn
      ⟨z, S.boundary_mem z hz⟩
  · intro z b a hz hb hba haK haB p hpK
    apply sourceLemma33_separates_of_noncut_closed G S.W K z b a
      (fun x y hx hxnz hxy hyK => by
        apply S.nonboundary_closed hx
        intro hboundary
        have hzx : z = x := Option.some.inj (hz.symm.trans hboundary)
        exact hxnz hzx.symm
        exact hxy
        exact hyK) hb haK haB p hpK

/-- When a finite component is already 2-connected, it is the source endblock
and has no exceptional cut vertex. -/
private def sourceLemma33_endblock_of_component_two_connected [Fintype V] [DecidableEq V]
    (K : Finset V) (hKnonempty : K.Nonempty)
    (h2conn : VertexConnectivityAtLeast (G.induce (↑K : Set V)) 2)
    (hdegree : ∀ b : {b // b ∈ K}, 3 ≤ (G.induce (↑K : Set V)).degree b) :
    SourceLemma33EndblockData G (↑K : Set V) := by
  refine
    { B := K
      nonempty := hKnonempty
      subset_component := by intro b hb; exact hb
      cut := none
      cut_mem := by intro z hz; simp at hz
      two_connected := h2conn
      noncut_closed := ?_
      noncut_degree := ?_
      cut_degree := ?_
      separates := ?_ }
  · intro b a hb _ _ ha
    exact ha
  · intro b _
    exact hdegree b
  · intro z hz
    simp at hz
  · intro z b a hz _ _ _ _ _ _
    simp at hz

/-- Finite descent on the current working-set cardinality produces a terminal
source endblock. The induction predicate is generalized over every descent
state at the fixed cardinality. -/
private noncomputable def sourceLemma33_endblock_of_descent_state [Fintype V] [DecidableEq V]
    {K : Set V} (S : SourceLemma33DescentState G K) :
    SourceLemma33EndblockData G K := by
  let P : ℕ → Type _ := fun n =>
    ∀ T : SourceLemma33DescentState G K, T.W.card = n →
      SourceLemma33EndblockData G K
  have hP : P S.W.card := Nat.strongRecOn' S.W.card (fun n ih => by
    intro T hcard
    by_cases h2conn : VertexConnectivityAtLeast (G.induce (↑T.W : Set V)) 2
    · exact sourceLemma33_endblock_of_terminal_state G T h2conn
    · let T' := Classical.choose (sourceLemma33_descent_step G T h2conn)
      have hlt : T'.W.card < T.W.card :=
        Classical.choose_spec (sourceLemma33_descent_step G T h2conn)
      exact ih T'.W.card (by omega) T' rfl)
  exact hP S rfl

/-- Apply finite descent to the original finite connected component with its
source degree-three hypothesis. -/
private noncomputable def sourceLemma33_endblock_of_component [Fintype V] [DecidableEq V]
    (K : Finset V) (hconnected : (G.induce (↑K : Set V)).Connected)
    (hdegree : ∀ b : {b // b ∈ K}, 3 ≤ (G.induce (↑K : Set V)).degree b) :
    SourceLemma33EndblockData G (↑K : Set V) := by
  let S0 := sourceLemma33_initial_descent_state G K hconnected hdegree
  exact sourceLemma33_endblock_of_descent_state G S0

/-- A source-Lemma-3.3 endblock has at least four vertices: a non-cut
vertex has induced degree at least three. -/
private theorem sourceLemma33_endblock_card_four [Fintype V] [DecidableEq V]
    {K : Set V} (D : SourceLemma33EndblockData G K) : 4 ≤ D.B.card := by
  classical
  let H := G.induce (↑D.B : Set V)
  letI : DecidableRel H.Adj := Classical.decRel _
  have hcard : 2 < D.B.card := by
    simpa using D.two_connected.1
  cases hcut : D.cut with
  | none =>
      obtain ⟨b, hb⟩ := D.nonempty
      let bH : {v : V // v ∈ D.B} := ⟨b, hb⟩
      have hdegree : 3 ≤ H.degree bH := by
        exact D.noncut_degree bH (by simp [hcut])
      have hlt := H.degree_lt_card_verts bH
      have hthree : 3 < D.B.card := by simpa [H] using lt_of_le_of_lt hdegree hlt
      omega
  | some z =>
      have hsingle : ({z} : Finset V).card < D.B.card := by
        simp
        omega
      obtain ⟨b, hb, hbz⟩ :=
        ({z} : Finset V).exists_mem_not_mem_of_card_lt_card hsingle
      have hne : b ≠ z := by simpa using hbz
      let bH : {v : V // v ∈ D.B} := ⟨b, hb⟩
      have hnoncut : D.cut ≠ some b := by
        intro h
        have : z = b := Option.some.inj (hcut.symm.trans h)
        exact hne this.symm
      have hdegree : 3 ≤ H.degree bH := D.noncut_degree bH hnoncut
      have hlt := H.degree_lt_card_verts bH
      have hthree : 3 < D.B.card := by simpa [H] using lt_of_le_of_lt hdegree hlt
      omega

/-- The support of a cycle contains exactly its cycle vertices; a girth-five
cycle therefore has at least five vertices. -/
private theorem sourceLemma33_cycle_card_five [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsCycle) (hgirth : 5 ≤ G.girth) : 5 ≤ C.support.toFinset.card := by
  classical
  have hegirth : G.egirth ≤ (C.length : ℕ∞) := by
    rw [SimpleGraph.egirth]
    exact iInf_le_of_le r (iInf_le_of_le C (iInf_le_of_le hC le_rfl))
  have hgirthLength : G.girth ≤ C.length := by
    exact ENat.toNat_le_toNat hegirth (by simp)
  have hlength : 5 ≤ C.length := hgirth.trans hgirthLength
  have htail : r ∈ C.support.tail := C.end_mem_tail_support hC.not_nil
  have hsupport : C.support.toFinset = C.support.tail.toFinset := by
    rw [C.support_eq_cons]
    simp [htail]
  have hcard : C.support.toFinset.card = C.length := by
    calc
      C.support.toFinset.card = C.support.tail.toFinset.card := congrArg Finset.card hsupport
      _ = C.support.tail.length := List.toFinset_card_of_nodup hC.support_nodup
      _ = C.length := by simp [SimpleGraph.Walk.length_support]
  omega

/-- Removing one vertex from a girth-five cycle leaves at least four cycle
vertices. -/
private theorem sourceLemma33_cycle_erase_card_four [DecidableEq V] {r u : V}
    (C : G.Walk r r) (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (huC : u ∈ C.support) : 4 ≤ (C.support.toFinset.erase u).card := by
  have hfive := sourceLemma33_cycle_card_five G C hC hgirth
  have hu : u ∈ C.support.toFinset := List.mem_toFinset.mpr huC
  rw [Finset.card_erase_of_mem hu]
  omega

/-- A girth-five cycle therefore provides at least four Menger terminals. -/
private theorem sourceLemma33_cycle_card_four [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsCycle) (hgirth : 5 ≤ G.girth) : 4 ≤ C.support.toFinset.card := by
  exact le_trans (by omega) (sourceLemma33_cycle_card_five G C hC hgirth)

/-- The endblock lies in the component outside the cycle, so its vertices are
disjoint from the cycle terminals. -/
private theorem sourceLemma33_endblock_cycle_disjoint [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K) :
    Disjoint D.B C.support.toFinset := by
  rw [Finset.disjoint_left]
  intro b hbB hbC
  exact hK.disjoint_cycle b (D.subset_component hbB) (List.mem_toFinset.mp hbC)

/-- The first source-Lemma-3.3 Menger application: the constructed endblock
and the actual cycle are disjoint terminal sets of size at least four. -/
private theorem sourceLemma33_endblock_four_linkage [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (h4conn : VertexConnectivityAtLeast G 4) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K) :
    FourABLinkage G D.B C.support.toFinset := by
  exact fourABLinkage_of_vertexConnectivity G h4conn D.B C.support.toFinset
    (sourceLemma33_endblock_card_four G D)
    (sourceLemma33_cycle_card_four G C hC hgirth)
    (sourceLemma33_endblock_cycle_disjoint G C hK D)

/-- Trim a simple path at its first contact with an arbitrary cycle. -/
private theorem sourceLemma33_first_cycle_hit [DecidableEq V]
    {r a b : V} (C : G.Walk r r) (P : G.Walk a b) (hP : P.IsPath)
    (hbC : b ∈ C.support) :
    ∃ c : V, ∃ R : G.Walk a c,
      R.IsPath ∧ c ∈ C.support ∧
      (∀ w, w ∈ R.support → w ≠ c → w ∉ C.support) ∧
      (∀ w, w ∈ R.support → w ∈ P.support) := by
  induction P with
  | @nil a =>
      refine ⟨a, Walk.nil, Walk.IsPath.nil, hbC, ?_, ?_⟩
      · intro w hw hne
        simp only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at hw
        subst w
        exact (hne rfl).elim
      · intro w hw
        exact hw
  | @cons a a' b haa' q ih =>
      have hq : q.IsPath := hP.of_cons
      by_cases haC : a ∈ C.support
      · refine ⟨a, Walk.nil, Walk.IsPath.nil, haC, ?_, ?_⟩
        · intro w hw hne
          simp only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at hw
          subst w
          exact (hne rfl).elim
        · intro w hw
          simp only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at hw
          subst w
          exact (Walk.cons haa' q).start_mem_support
      · rcases ih hq hbC with ⟨c, R, hR, hcC, hfirst, hsub⟩
        refine ⟨c, Walk.cons haa' R, ?_, hcC, ?_, ?_⟩
        · apply (Walk.cons_isPath_iff haa' R).mpr
          refine ⟨hR, ?_⟩
          intro haR
          have haq : a ∉ q.support := (Walk.cons_isPath_iff haa' q).mp hP |>.2
          exact haq (hsub a haR)
        · intro w hw hwne
          simp only [Walk.support_cons, List.mem_cons] at hw
          rcases hw with rfl | hw
          · exact haC
          · exact hfirst w hw hwne
        · intro w hw
          simp only [Walk.support_cons, List.mem_cons] at hw ⊢
          rcases hw with rfl | hw
          · exact Or.inl rfl
          · exact Or.inr (hsub w hw)

/-- Before the first cycle contact, a simple path starting in the source
component remains in that component. -/
private theorem sourceLemma33_first_hit_vertices_component [DecidableEq V]
    {r a c : V} {C : G.Walk r r} {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (haK : a ∈ K)
    (R : G.Walk a c) (hR : R.IsPath)
    (hFirst : ∀ w, w ∈ R.support → w ≠ c → w ∉ C.support) :
    ∀ w, w ∈ R.support → w ≠ c → w ∈ K := by
  induction R with
  | nil =>
      intro w hw hne
      simp only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at hw
      subst w
      exact (hne rfl).elim
  | @cons a a' c haa' q ih =>
      have hq : q.IsPath := hR.of_cons
      have hFirstTail : ∀ w, w ∈ q.support → w ≠ c → w ∉ C.support := by
        intro w hw hwc
        exact hFirst w (by simp [hw]) hwc
      intro w hw hwc
      simp only [Walk.support_cons, List.mem_cons] at hw
      rcases hw with rfl | hw
      · exact haK
      by_cases ha'c : a' = c
      · subst a'
        have hqnil : q = Walk.nil := (Walk.isPath_iff_eq_nil _).mp hq
        subst q
        simp only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at hw
        subst w
        exact (hwc rfl).elim
      · have ha'C : a' ∉ C.support := hFirstTail a' q.start_mem_support ha'c
        have ha'K : a' ∈ K := hK.closed_outside_cycle haK haa' ha'C
        exact ih ha'K hq hFirstTail w hw hwc

/-- The internal vertices of a first-hit path are in the original component. -/
private theorem sourceLemma33_first_hit_internal_component [DecidableEq V]
    {r a c : V} {C : G.Walk r r} {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (haK : a ∈ K)
    (R : G.Walk a c) (hR : R.IsPath)
    (hFirst : ∀ w, w ∈ R.support → w ≠ c → w ∉ C.support) :
    internalVertices G R ⊆ K := by
  intro w hw
  exact sourceLemma33_first_hit_vertices_component G hK haK R hR hFirst w hw.1 hw.2.2

/-- Four raw Menger paths normalized at their first contacts with the cycle. -/
private structure SourceLemma33FirstHitLinkageData [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) {r : V} (C : G.Walk r r) (K : Set V)
    (D : SourceLemma33EndblockData G K) where
  src : Fin 4 → V
  dst : Fin 4 → V
  path : ∀ i, G.Path (src i) (dst i)
  src_mem : ∀ i, src i ∈ D.B
  dst_mem : ∀ i, dst i ∈ C.support
  src_injective : Function.Injective src
  dst_injective : Function.Injective dst
  disjoint_support : ∀ ⦃i j⦄, i ≠ j →
    Disjoint {v | v ∈ ((path i : G.Walk (src i) (dst i)).support)}
      {v | v ∈ ((path j : G.Walk (src j) (dst j)).support)}
  first_hit : ∀ i w, w ∈ ((path i : G.Walk (src i) (dst i)).support) →
    w ≠ dst i → w ∉ C.support
  internal_component : ∀ i,
    internalVertices G (path i : G.Walk (src i) (dst i)) ⊆ K

/-- Normalize every raw order-four Menger path at its first cycle contact. -/
private theorem sourceLemma33_first_hit_linkage [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (L : ABLinkageData G D.B C.support.toFinset 4) :
    Nonempty (SourceLemma33FirstHitLinkageData G C K D) := by
  classical
  choose dst raw hraw hdC hfirst hsub using fun i =>
    sourceLemma33_first_cycle_hit G C (L.path i : G.Walk (L.src i) (L.dst i))
      (L.path i).property (List.mem_toFinset.mp (L.dst_mem i))
  let path : ∀ i, G.Path (L.src i) (dst i) := fun i => ⟨raw i, hraw i⟩
  have hdisjoint : ∀ ⦃i j⦄, i ≠ j →
      Disjoint {v | v ∈ ((path i : G.Walk (L.src i) (dst i)).support)}
        {v | v ∈ ((path j : G.Walk (L.src j) (dst j)).support)} := by
    intro i j hij
    rw [Set.disjoint_left]
    intro v hvi hvj
    exact (Set.disjoint_left.mp (L.disjoint_support hij))
      (hsub i v (by simpa [path] using hvi))
      (hsub j v (by simpa [path] using hvj))
  have hdst_injective : Function.Injective dst := by
    intro i j hij
    by_contra hne
    have hleft : dst i ∈ ((path i : G.Walk (L.src i) (dst i)).support) :=
      Walk.end_mem_support (path i : G.Walk (L.src i) (dst i))
    have hright : dst i ∈ ((path j : G.Walk (L.src j) (dst j)).support) := by
      rw [hij]
      exact Walk.end_mem_support (path j : G.Walk (L.src j) (dst j))
    exact (Set.disjoint_left.mp (hdisjoint hne)) hleft hright
  have hinternal : ∀ i,
      internalVertices G (path i : G.Walk (L.src i) (dst i)) ⊆ K := by
    intro i
    apply sourceLemma33_first_hit_internal_component G hK
      (D.subset_component (L.src_mem i)) (path i : G.Walk (L.src i) (dst i)) (path i).property
    intro w hw hwc
    exact hfirst i w (by simpa [path] using hw) hwc
  refine ⟨{
    src := L.src
    dst := dst
    path := path
    src_mem := L.src_mem
    dst_mem := hdC
    src_injective := L.src_injective
    dst_injective := hdst_injective
    disjoint_support := hdisjoint
    first_hit := by
      intro i w hw hwc
      exact hfirst i w (by simpa [path] using hw) hwc
    internal_component := hinternal }⟩

/-- Normalize four attachments obtained from the actual source-Lemma-3.3
Menger application. -/
private theorem sourceLemma33_normalized_four_attachments [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (h4conn : VertexConnectivityAtLeast G 4) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K) :
    Nonempty (SourceLemma33FirstHitLinkageData G C K D) := by
  obtain ⟨L⟩ := sourceLemma33_endblock_four_linkage G C hC hgirth h4conn hK D
  exact sourceLemma33_first_hit_linkage G C hK D L

/-- The exact source Lemma 3.2 applied to the locally selected endblock.  The
optional cut vertex is the only vertex for which only the source lower bound
of two is used. -/
private theorem sourceLemma32_of_sourceLemma33Endblock [Fintype V] [DecidableEq V]
    {K : Set V} (D : SourceLemma33EndblockData G K)
    (u v : {a // a ∈ D.B}) (huv : u ≠ v) :
    ∃ P Q : (G.induce (↑D.B : Set V)).Walk u v,
      P.IsPath ∧ Q.IsPath ∧ P.length ≠ Q.length := by
  letI : DecidableRel (G.induce (↑D.B : Set V)).Adj := Classical.decRel _
  obtain ⟨b₀, hb₀⟩ := D.nonempty
  have hdegreeTwo : ∀ a : {a // a ∈ D.B},
      2 ≤ (G.induce (↑D.B : Set V)).degree a :=
    degree_two_of_vertexConnectivity (G.induce (↑D.B : Set V)) D.two_connected
  cases hcut : D.cut with
  | none =>
      apply sourceLemma32_atMostOneDegreeTwo (G.induce (↑D.B : Set V))
        D.two_connected ⟨b₀, hb₀⟩ hdegreeTwo
      · intro a _
        exact D.noncut_degree a (by simp [hcut])
      · exact huv
  | some z =>
      let zB : {a // a ∈ D.B} := ⟨z, D.cut_mem z hcut⟩
      apply sourceLemma32_atMostOneDegreeTwo (G.induce (↑D.B : Set V))
        D.two_connected zB hdegreeTwo
      · intro a ha
        apply D.noncut_degree a
        intro hza
        have hza' : some z = some a.1 := by
          simpa [hcut] using hza
        have hza'' : z = a.1 := Option.some.inj hza'
        apply ha
        apply Subtype.ext
        change a.1 = z
        exact hza''.symm
      · exact huv

/-- The finite set of cycle vertices adjacent to `z`. -/
noncomputable def sourceLemma33CycleNeighbours [Fintype V]
    {r : V} (C : G.Walk r r) (z : V) : Finset V := by
  classical
  exact C.support.toFinset.filter fun x => G.Adj z x

private theorem mem_sourceLemma33CycleNeighbours [Fintype V]
    {r : V} (C : G.Walk r r) (z x : V) :
    x ∈ sourceLemma33CycleNeighbours G C z ↔ x ∈ C.support ∧ G.Adj z x := by
  classical
  simp [sourceLemma33CycleNeighbours]

noncomputable local instance sourceLemma33_set_membership_decidable
    (K : Set V) : DecidablePred (fun v : V => v ∈ K) := Classical.decPred _

noncomputable local instance sourceLemma33_graph_adjacency_decidable :
    DecidableRel G.Adj := Classical.decRel _

/-- Every ambient neighbour of a source component vertex is either on the
cycle or remains in the component. -/
private theorem sourceLemma33_neighbor_partition [Fintype V] [DecidableEq V]
    {r z : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (hzK : z ∈ K) :
    G.neighborFinset z =
      sourceLemma33CycleNeighbours G C z ∪
        (G.neighborFinset z).filter (fun y => y ∈ K) := by
  classical
  ext y
  constructor
  · intro hy
    have hzy : G.Adj z y := (G.mem_neighborFinset z y).mp hy
    by_cases hyC : y ∈ C.support
    · exact Finset.mem_union_left _
        ((mem_sourceLemma33CycleNeighbours G C z y).mpr ⟨hyC, hzy⟩)
    · exact Finset.mem_union_right _
        (Finset.mem_filter.mpr ⟨hy, hK.closed_outside_cycle hzK hzy hyC⟩)
  · intro hy
    rcases Finset.mem_union.mp hy with hy | hy
    · exact (G.mem_neighborFinset z y).mpr
        ((mem_sourceLemma33CycleNeighbours G C z y).mp hy).2
    · exact (Finset.mem_filter.mp hy).1

/-- The two parts of the source-component neighbour partition are disjoint. -/
private theorem sourceLemma33_neighbor_partition_disjoint [Fintype V] [DecidableEq V]
    {r z : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) :
    Disjoint (sourceLemma33CycleNeighbours G C z)
      ((G.neighborFinset z).filter (fun y => y ∈ K)) := by
  classical
  rw [Finset.disjoint_left]
  intro y hyC hyK
  exact hK.disjoint_cycle y (Finset.mem_filter.mp hyK).2
    ((mem_sourceLemma33CycleNeighbours G C z y).mp hyC).1

/-- The ambient degree of a component vertex is its cycle degree plus its
degree in the induced component. -/
private theorem sourceLemma33_neighbor_card [Fintype V] [DecidableEq V]
    {r z : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (hzK : z ∈ K) :
    G.degree z =
      (sourceLemma33CycleNeighbours G C z).card + (G.induce K).degree ⟨z, hzK⟩ := by
  classical
  let N := G.neighborFinset z
  let cycleN := sourceLemma33CycleNeighbours G C z
  let componentN := N.filter (fun y => y ∈ K)
  have hpartition : N = cycleN ∪ componentN := by
    simpa [N, cycleN, componentN] using sourceLemma33_neighbor_partition G C hK hzK
  have hdisjoint : Disjoint cycleN componentN := by
    simpa [N, cycleN, componentN] using
      sourceLemma33_neighbor_partition_disjoint G C hK
  have hcomponent_eq : componentN = N ∩ K.toFinset := by
    ext y
    simp [N, componentN]
  have hcomponent_card : componentN.card = (G.induce K).degree ⟨z, hzK⟩ := by
    rw [hcomponent_eq]
    have hmap := congrArg Finset.card (G.map_neighborFinset_induce (s := K) ⟨z, hzK⟩)
    simpa only [N, Finset.card_map] using hmap.symm
  calc
    G.degree z = N.card := by rfl
    _ = (cycleN ∪ componentN).card := by rw [hpartition]
    _ = cycleN.card + componentN.card := Finset.card_union_of_disjoint hdisjoint
    _ = (sourceLemma33CycleNeighbours G C z).card + (G.induce K).degree ⟨z, hzK⟩ := by
      simp [cycleN, hcomponent_card]

/-- The source minimum-degree and low-cycle-neighbour hypotheses give the
degree-three input for finite endblock descent. -/
private theorem sourceLemma33_component_degree_three [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K)
    (hminimumDegree : ∀ v : V, 6 ≤ G.degree v)
    (hsmall : ∀ z, z ∈ K → (sourceLemma33CycleNeighbours G C z).card ≤ 3) :
    ∀ z : {z // z ∈ K}, 3 ≤ (G.induce K).degree z := by
  intro z
  have hdegree : G.degree z.1 =
      (sourceLemma33CycleNeighbours G C z.1).card + (G.induce K).degree z := by
    simpa using sourceLemma33_neighbor_card G C hK z.2
  have hminimum := hminimumDegree z.1
  have hcycle := hsmall z.1 z.2
  omega

private theorem sourceLemma33_degree_eq_nat_card {W : Type*} [Finite W]
    (H : SimpleGraph W) (w : W) [Fintype (H.neighborSet w)] :
    H.degree w = Nat.card (H.neighborSet w) := by
  calc
    H.degree w = Fintype.card (H.neighborSet w) := (H.card_neighborSet_eq_degree w).symm
    _ = Nat.card (H.neighborSet w) := Nat.card_eq_fintype_card.symm

/-- The exact source-context bridge into the already-proved finite endblock
descent. -/
private noncomputable def sourceLemma33_endblock_of_source_context
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K)
    (hminimumDegree : ∀ v : V, 6 ≤ G.degree v)
    (hsmall : ∀ z, z ∈ K → (sourceLemma33CycleNeighbours G C z).card ≤ 3) :
    SourceLemma33EndblockData G K := by
  classical
  let KF : Finset V := Finset.univ.filter (fun v => v ∈ K)
  have hKF : (↑KF : Set V) = K := by
    ext v
    simp [KF]
  have hconnected := hK.connected
  rw [← hKF] at hconnected
  have hdegreeSet := sourceLemma33_component_degree_three G C hK hminimumDegree hsmall
  rw [← hKF] at hdegreeSet
  have hdegreeNat : ∀ z : {z // z ∈ KF},
      3 ≤ Nat.card ((G.induce (↑KF : Set V)).neighborSet z) := by
    intro z
    have hz := hdegreeSet z
    rwa [sourceLemma33_degree_eq_nat_card] at hz
  have hdegree : ∀ z : {z // z ∈ KF},
      3 ≤ (G.induce (↑KF : Set V)).degree z := by
    intro z
    rw [sourceLemma33_degree_eq_nat_card]
    exact hdegreeNat z
  have D := sourceLemma33_endblock_of_component G KF hconnected hdegree
  rw [hKF] at D
  exact D

/-- With no cut vertex, the source endblock is the whole connected component. -/
private theorem sourceLemma33_endblock_eq_component_of_no_cut [Fintype V] [DecidableEq V]
    {K : Set V} (hKconnected : (G.induce K).Connected)
    (D : SourceLemma33EndblockData G K) (hcut : D.cut = none) :
    (↑D.B : Set V) = K := by
  apply Set.Subset.antisymm D.subset_component
  intro a haK
  obtain ⟨b, hbB⟩ := D.nonempty
  have hstep : ∀ {x y : {v : V // v ∈ K}},
      (G.induce K).Adj x y → x.1 ∈ D.B → y.1 ∈ D.B := by
    intro x y hxy hxB
    exact D.noncut_closed hxB (by simp [hcut]) hxy y.2
  have hwalk : ∀ {x y : {v : V // v ∈ K}},
      ∀ p : (G.induce K).Walk x y, x.1 ∈ D.B → y.1 ∈ D.B := by
    intro x y p
    induction p with
    | nil => intro hxB; exact hxB
    | cons hxy p ih =>
        intro hxB
        exact ih (hstep hxy hxB)
  obtain ⟨p⟩ := hKconnected.preconnected ⟨b, D.subset_component hbB⟩ ⟨a, haK⟩
  exact hwalk p hbB

private structure SourceLemma33EndblockAnchorData [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (K : Set V) (D : SourceLemma33EndblockData G K) (u' : V) where
  anchor : V
  anchor_mem : anchor ∈ D.B
  cut_or_root : D.cut = some anchor ∨ (D.cut = none ∧ anchor = u')

/-- The source anchor is the cut vertex when it exists, and otherwise the
prescribed component endpoint of the boundary edge. -/
private noncomputable def sourceLemma33_endblock_anchor [Fintype V] [DecidableEq V]
    {K : Set V} (hKconnected : (G.induce K).Connected)
    (D : SourceLemma33EndblockData G K) {u' : V} (hu'K : u' ∈ K) :
    SourceLemma33EndblockAnchorData G K D u' := by
  classical
  cases hcut : D.cut with
  | none =>
      refine { anchor := u', anchor_mem := ?_, cut_or_root := Or.inr ⟨hcut, rfl⟩ }
      have hu'B : u' ∈ (↑D.B : Set V) := by
        rw [sourceLemma33_endblock_eq_component_of_no_cut G hKconnected D hcut]
        exact hu'K
      exact hu'B
  | some z =>
      exact { anchor := z, anchor_mem := D.cut_mem z hcut, cut_or_root := Or.inl hcut }

private theorem sourceLemma33_nonanchor_not_cut [Fintype V] [DecidableEq V]
    {K : Set V} {D : SourceLemma33EndblockData G K} {u' b : V}
    (A : SourceLemma33EndblockAnchorData G K D u')
    (hbB : b ∈ D.B) (hbAnchor : b ≠ A.anchor) : D.cut ≠ some b := by
  rcases A.cut_or_root with hcut | ⟨hcut, _⟩
  · intro hbcut
    apply hbAnchor
    exact (Option.some.inj (hcut.symm.trans hbcut)).symm
  · simp [hcut]

/-- Any neighbour outside the endblock of a non-anchor block vertex lies on
the source cycle. -/
private theorem sourceLemma33_endblock_external_neighbour_on_cycle
    [Fintype V] [DecidableEq V] {r u' : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (A : SourceLemma33EndblockAnchorData G K D u') {b a : V}
    (hbB : b ∈ D.B) (hbAnchor : b ≠ A.anchor) (hba : G.Adj b a)
    (haOutside : a ∉ D.B) : a ∈ C.support := by
  by_contra haC
  have haK : a ∈ K := hK.closed_outside_cycle (D.subset_component hbB) hba haC
  have hnotcut : D.cut ≠ some b := sourceLemma33_nonanchor_not_cut G A hbB hbAnchor
  exact haOutside (D.noncut_closed hbB hnotcut hba haK)

private theorem sourceLemma33_cycle_vertex_not_component
    {r u : V} {C : G.Walk r r} {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (huC : u ∈ C.support) :
    u ∉ K := by
  intro huK
  exact hK.disjoint_cycle u huK huC

private theorem sourceLemma33_component_vertex_not_cycle
    {r z : V} {C : G.Walk r r} {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (hzK : z ∈ K) :
    z ∉ C.support :=
  hK.disjoint_cycle z hzK

/-- A cycle boundary vertex can be joined to any component vertex by a simple
path whose internal vertices stay in that component. -/
private theorem sourceLemma33_path_to_component_vertex [DecidableEq V]
    {r u z : V} {C : G.Walk r r} {K : Set V}
    (hK : SourceLemma33ComponentData G C K)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support)
    (hzK : z ∈ K) :
    ∃ P : G.Walk u z, P.IsPath ∧ internalVertices G P ⊆ K := by
  rcases huBoundary with ⟨k, hkK, huk⟩
  rcases hK.connected.preconnected ⟨k, hkK⟩ ⟨z, hzK⟩ with ⟨q⟩
  let inclusion : G.induce K →g G := {
    toFun := Subtype.val
    map_rel' := by
      intro a b hab
      exact hab }
  let W : G.Walk k z := by
    simpa [inclusion] using q.map inclusion
  let Q : G.Walk k z := W.toPath
  have hQpath : Q.IsPath := by
    dsimp [Q]
    exact W.toPath.isPath
  have hQK : ∀ w, w ∈ Q.support → w ∈ K := by
    intro w hwQ
    have hwW : w ∈ W.support := Walk.support_toPath_subset W (by simpa [Q] using hwQ)
    have hwMap : w ∈ q.support.map inclusion := by
      simpa [W, inclusion] using hwW
    rcases List.mem_map.mp hwMap with ⟨a, ha, haw⟩
    subst w
    exact a.2
  have huNotQ : u ∉ Q.support := by
    intro huQ
    exact sourceLemma33_cycle_vertex_not_component G hK huC (hQK u huQ)
  let P : G.Walk u z := Walk.cons huk Q
  have hPpath : P.IsPath := by
    dsimp [P]
    exact (Walk.cons_isPath_iff huk Q).mpr ⟨hQpath, huNotQ⟩
  refine ⟨P, hPpath, ?_⟩
  intro w hw
  change w ∈ P.support ∧ w ≠ u ∧ w ≠ z at hw
  dsimp [P] at hw
  simp only [List.mem_cons] at hw
  rcases hw.1 with hwu | hwQ
  · exact (hw.2.1 hwu).elim
  · exact hQK w hwQ

private theorem sourceLemma33_path_internal_not_cycle
    {r u z : V} {C : G.Walk r r} {K : Set V} {P : G.Walk u z}
    (hK : SourceLemma33ComponentData G C K)
    (hPK : internalVertices G P ⊆ K) :
    ∀ w, w ∈ internalVertices G P → w ∉ C.support := by
  intro w hw
  exact hK.disjoint_cycle w (hPK hw)


/-- The oriented subpath from `a` to `b` on a cycle represented by its directed
walk `C`: rotate `C` to start at `a`, then stop at the first occurrence of `b`. -/
noncomputable def sourceOrientedCycleSubpath [DecidableEq V]
    {r a b : V} (C : G.Walk r r) (ha : a ∈ C.support) (hb : b ∈ C.support) :
    G.Walk a b :=
  (C.rotate ha).takeUntil b (by
    have hsplitWalk : (C.takeUntil a ha).append (C.dropUntil a ha) = C :=
      C.take_spec ha
    have hsplit : b ∈ (C.takeUntil a ha).support ∨ b ∈ (C.dropUntil a ha).support := by
      rw [← Walk.mem_support_append_iff]
      simpa [hsplitWalk] using hb
    rw [Walk.rotate, Walk.mem_support_append_iff]
    rcases hsplit with htake | hdrop
    · exact Or.inr htake
    · exact Or.inl hdrop)

private theorem sourceLemma33_oriented_subpath_isPath
    [DecidableEq V] {r a b : V} (C : G.Walk r r) (hC : C.IsCycle)
    (ha : a ∈ C.support) (hb : b ∈ C.support) :
    (sourceOrientedCycleSubpath G C ha hb).IsPath := by
  have hbRotate : b ∈ (C.rotate ha).support := by
    rw [← C.take_spec ha, Walk.mem_support_append_iff] at hb
    dsimp [Walk.rotate]
    rw [Walk.mem_support_append_iff]
    exact hb.symm
  change ((C.rotate ha).takeUntil b _).IsPath
  exact (hC.rotate ha).isPath_takeUntil hbRotate

private theorem sourceLemma33_oriented_subpath_support_subset
    [DecidableEq V] {r a b : V} (C : G.Walk r r)
    (ha : a ∈ C.support) (hb : b ∈ C.support) :
    ∀ w, w ∈ (sourceOrientedCycleSubpath G C ha hb).support → w ∈ C.support := by
  intro w hw
  have hbRotate : b ∈ (C.rotate ha).support := by
    rw [← C.take_spec ha, Walk.mem_support_append_iff] at hb
    dsimp [Walk.rotate]
    rw [Walk.mem_support_append_iff]
    exact hb.symm
  dsimp [sourceOrientedCycleSubpath] at hw
  have hwRotate : w ∈ (C.rotate ha).support :=
    (C.rotate ha).support_takeUntil_subset hbRotate hw
  dsimp [Walk.rotate] at hwRotate
  rw [Walk.mem_support_append_iff] at hwRotate
  rcases hwRotate with hwDrop | hwTake
  · exact C.support_dropUntil_subset ha hwDrop
  · exact C.support_takeUntil_subset ha hwTake

private theorem sourceLemma33_cycle_subpath_length_ne_two [DecidableEq V]
    {r a b z : V} (C : G.Walk r r) (hC : C.IsCycle)
    (hgirth : 5 ≤ G.girth) (hzC : z ∉ C.support)
    (ha : a ∈ C.support) (hb : b ∈ C.support) (hab : a ≠ b)
    (hza : G.Adj z a) (hzb : G.Adj z b) :
    (sourceOrientedCycleSubpath G C ha hb).length ≠ 2 := by
  intro hlength
  let Q : G.Walk a b := sourceOrientedCycleSubpath G C ha hb
  have hQpath : Q.IsPath := sourceLemma33_oriented_subpath_isPath G C hC ha hb
  have hQsub : ∀ w, w ∈ Q.support → w ∈ C.support :=
    sourceLemma33_oriented_subpath_support_subset G C ha hb
  have hzQ : z ∉ Q.support := by
    intro hzQ
    exact hzC (hQsub z hzQ)
  have hQzpath : (Q.concat hzb.symm).IsPath := by
    apply Walk.IsPath.mk'
    rw [Walk.support_concat]
    simpa using List.Nodup.concat hzQ hQpath.support_nodup
  let qz : G.Path a z := ⟨Q.concat hzb.symm, hQzpath⟩
  have hclosing : s(z, a) ∉ (qz : G.Walk a z).edges := by
    intro he
    change s(z, a) ∈ (Q.concat hzb.symm).edges at he
    rw [Walk.edges_concat, List.concat_eq_append] at he
    simp only [List.mem_append, List.mem_singleton] at he
    rcases he with heQ | heLast
    · exact hzQ (Q.fst_mem_support_of_mem_edges heQ)
    · rw [Sym2.eq_iff] at heLast
      rcases heLast with ⟨hzb', _⟩ | ⟨_, hab'⟩
      · subst b
        exact hzC hb
      · exact hab hab'
  have hfourCycle : (Walk.cons hza (qz : G.Walk a z)).IsCycle :=
    Path.cons_isCycle qz hza hclosing
  have hfourLength : (Walk.cons hza (qz : G.Walk a z)).length = 4 := by
    change (Q.concat hzb.symm).length + 1 = 4
    have hQlength : Q.length = 2 := by simpa [Q] using hlength
    simp [Walk.length_concat, hQlength]
  have hegirth : G.egirth ≤ (Walk.cons hza (qz : G.Walk a z)).length :=
    (SimpleGraph.le_egirth.mp le_rfl) _ _ hfourCycle
  have hgirth_le : G.girth ≤ (Walk.cons hza (qz : G.Walk a z)).length := by
    rw [SimpleGraph.girth]
    exact ENat.toNat_le_of_le_coe hegirth
  omega

private theorem sourceLemma33_two_edge_path [DecidableEq V]
    {r a b z : V} {C : G.Walk r r} {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (hzK : z ∈ K)
    (ha : a ∈ C.support) (hb : b ∈ C.support) (hab : a ≠ b)
    (hza : G.Adj z a) (hzb : G.Adj z b) :
    ∃ P : G.Walk a b, P.IsPath ∧ internalVertices G P ⊆ K ∧ P.length = 2 := by
  let P : G.Walk a b := Walk.cons hza.symm (Walk.cons hzb Walk.nil)
  have hz_ne_a : z ≠ a := by
    intro h
    subst z
    exact hK.disjoint_cycle a hzK ha
  have hz_ne_b : z ≠ b := by
    intro h
    subst z
    exact hK.disjoint_cycle b hzK hb
  have hPpath : P.IsPath := by
    dsimp [P]
    apply (Walk.cons_isPath_iff hza.symm _).mpr
    refine ⟨(Walk.cons_isPath_iff hzb Walk.nil).mpr ⟨Walk.IsPath.nil, ?_⟩, ?_⟩
    · simpa using hzb.ne
    · simp only [Walk.support_cons, Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false]
      rintro (haz | hab')
      · exact hz_ne_a haz.symm
      · exact hab hab'
  refine ⟨P, hPpath, ?_, ?_⟩
  · intro w hw
    change w ∈ P.support ∧ w ≠ a ∧ w ≠ b at hw
    dsimp [P] at hw
    simp only [Walk.support_cons, Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] at hw
    rcases hw.1 with hwa | hwz | hwb
    · exact (hw.2.1 hwa).elim
    · simpa [hwz] using hzK
    · exact (hw.2.2 hwb).elim
  · rfl

/-- Appending the final edge from a component vertex makes that vertex the
only possible new internal vertex. -/
private theorem sourceLemma33_path_via_component_vertex_internal
    {u z y : V} {K : Set V} (P : G.Walk u z)
    (hPK : internalVertices G P ⊆ K) (hzK : z ∈ K) (hzy : G.Adj z y) :
    internalVertices G (P.concat hzy) ⊆ K := by
  intro w hw
  change w ∈ (P.concat hzy).support ∧ w ≠ u ∧ w ≠ y at hw
  rw [Walk.support_concat, List.concat_eq_append, List.mem_append,
    List.mem_singleton] at hw
  rcases hw.1 with hwP | hwy
  · by_cases hwz : w = z
    · simpa [hwz] using hzK
    · exact hPK ⟨hwP, hw.2.1, hwz⟩
  · exact (hw.2.2 hwy).elim

/-- Along a fixed oriented cycle start, the length of the first-hit subpath
uniquely determines its endpoint. -/
private theorem sourceLemma33_oriented_subpath_length_injective [DecidableEq V]
    {r u y₁ y₂ : V} (C : G.Walk r r) (huC : u ∈ C.support)
    (hy₁C : y₁ ∈ C.support) (hy₂C : y₂ ∈ C.support)
    (hEq :
      (sourceOrientedCycleSubpath G C huC hy₁C).length =
        (sourceOrientedCycleSubpath G C huC hy₂C).length) :
    y₁ = y₂ := by
  let R := C.rotate huC
  let P₁ := sourceOrientedCycleSubpath G C huC hy₁C
  let P₂ := sourceOrientedCycleSubpath G C huC hy₂C
  have hget₁ : P₁.getVert P₁.length = R.getVert P₁.length := by
    dsimp [P₁, R, sourceOrientedCycleSubpath]
    apply (C.rotate huC).getVert_takeUntil
    rfl
  have hget₂ : P₂.getVert P₂.length = R.getVert P₂.length := by
    dsimp [P₂, R, sourceOrientedCycleSubpath]
    apply (C.rotate huC).getVert_takeUntil
    rfl
  calc
    y₁ = P₁.getVert P₁.length := (Walk.getVert_length P₁).symm
    _ = R.getVert P₁.length := hget₁
    _ = R.getVert P₂.length := by simpa [P₁, P₂] using congrArg R.getVert hEq
    _ = P₂.getVert P₂.length := hget₂.symm
    _ = y₂ := Walk.getVert_length P₂

/-- Every first cycle contact is a genuine neighbourhood vertex of the
outside component. -/
private theorem sourceLemma33_first_hit_dst_mem_neighbourhood [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (A : SourceLemma33FirstHitLinkageData G C K D) (i : Fin 4) :
    A.dst i ∈ sourceGraphNeighbourhood G K := by
  let p : G.Walk (A.src i) (A.dst i) := A.path i
  have hsrcK : A.src i ∈ K := D.subset_component (A.src_mem i)
  have hsrc_ne_dst : A.src i ≠ A.dst i := by
    intro h
    apply hK.disjoint_cycle (A.src i) hsrcK
    simpa [h] using A.dst_mem i
  have hpnonempty : ¬ p.Nil := Walk.not_nil_of_ne hsrc_ne_dst
  have hadj : G.Adj p.penultimate (A.dst i) := p.adj_penultimate hpnonempty
  have hpen_ne : p.penultimate ≠ A.dst i := hadj.ne
  have hpen_support : p.penultimate ∈ p.support := p.getVert_mem_support _
  have hpenK : p.penultimate ∈ K :=
    sourceLemma33_first_hit_vertices_component G hK hsrcK p (A.path i).property
      (A.first_hit i) p.penultimate hpen_support hpen_ne
  exact ⟨p.penultimate, hpenK, hadj.symm⟩

/-- The inclusion of an induced endblock into the ambient graph, used only to
map Lemma 3.2 routes back to the original graph. -/
private def sourceLemma33_endblock_inclusion [Fintype V] [DecidableEq V]
    {K : Set V} (D : SourceLemma33EndblockData G K) :
    G.induce (↑D.B : Set V) →g G where
  toFun := Subtype.val
  map_rel' := by
    intro a b hab
    exact hab

/-- Internal vertices of two first-hit attachments joined through an induced
endblock route remain in the original outside component. -/
private theorem sourceLemma33_composed_attachment_internal_component
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (A : SourceLemma33FirstHitLinkageData G C K D) (i j : Fin 4)
    (M : (G.induce (↑D.B : Set V)).Walk
      ⟨A.src i, A.src_mem i⟩ ⟨A.src j, A.src_mem j⟩) :
    internalVertices G ((A.path i : G.Walk (A.src i) (A.dst i)).reverse.append
      ((M.map (sourceLemma33_endblock_inclusion G D)).append
        (A.path j : G.Walk (A.src j) (A.dst j)))) ⊆ K := by
  intro w hw
  change w ∈ ((A.path i : G.Walk (A.src i) (A.dst i)).reverse.append
      ((M.map (sourceLemma33_endblock_inclusion G D)).append
        (A.path j : G.Walk (A.src j) (A.dst j)))).support ∧
    w ≠ A.dst i ∧ w ≠ A.dst j at hw
  rw [Walk.mem_support_append_iff] at hw
  rcases hw.1 with hwrev | hwrest
  · rw [Walk.support_reverse, List.mem_reverse] at hwrev
    exact sourceLemma33_first_hit_vertices_component G hK
      (D.subset_component (A.src_mem i)) (A.path i : G.Walk (A.src i) (A.dst i))
      (A.path i).property (A.first_hit i) w hwrev hw.2.1
  · rw [Walk.mem_support_append_iff] at hwrest
    rcases hwrest with hwM | hwj
    · rw [Walk.support_map] at hwM
      rcases List.mem_map.mp hwM with ⟨v, hv, hvw⟩
      subst w
      exact D.subset_component v.2
    · exact sourceLemma33_first_hit_vertices_component G hK
        (D.subset_component (A.src_mem j)) (A.path j : G.Walk (A.src j) (A.dst j))
        (A.path j).property (A.first_hit j) w hwj hw.2.2

/-- The two distinct endblock sources of normalized attachments can be joined
by unequal-length Lemma 3.2 routes, one of which avoids the oriented cycle
subpath length. -/
private theorem sourceLemma33_pairwise_good_route [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (A : SourceLemma33FirstHitLinkageData G C K D) (i j : Fin 4) (hij : i ≠ j) :
    ∃ P : G.Walk (A.dst i) (A.dst j),
      internalVertices G P ⊆ K ∧
      P.length ≠ (sourceOrientedCycleSubpath G C (A.dst_mem i) (A.dst_mem j)).length := by
  classical
  let ui : {a // a ∈ D.B} := ⟨A.src i, A.src_mem i⟩
  let uj : {a // a ∈ D.B} := ⟨A.src j, A.src_mem j⟩
  have huiuj : ui ≠ uj := by
    intro h
    apply hij
    apply A.src_injective
    exact congrArg Subtype.val h
  obtain ⟨P, Q, hPpath, hQpath, hPQ⟩ :=
    sourceLemma32_of_sourceLemma33Endblock G D ui uj huiuj
  let route : (G.induce (↑D.B : Set V)).Walk ui uj → G.Walk (A.dst i) (A.dst j) :=
    fun M => (A.path i : G.Walk (A.src i) (A.dst i)).reverse.append
      ((M.map (sourceLemma33_endblock_inclusion G D)).append
        (A.path j : G.Walk (A.src j) (A.dst j)))
  let RP := route P
  let RQ := route Q
  have hroute_internal : ∀ M : (G.induce (↑D.B : Set V)).Walk ui uj,
      internalVertices G (route M) ⊆ K := by
    intro M
    dsimp [route, ui, uj]
    exact sourceLemma33_composed_attachment_internal_component G C hK D A i j M
  have hroute_length : ∀ M : (G.induce (↑D.B : Set V)).Walk ui uj,
      (route M).length = (A.path i : G.Walk (A.src i) (A.dst i)).length + M.length +
        (A.path j : G.Walk (A.src j) (A.dst j)).length := by
    intro M
    dsimp [route]
    simp only [Walk.length_append, Walk.length_reverse, Walk.length_map]
    omega
  have hRPlength := hroute_length P
  have hRQlength := hroute_length Q
  have hRdiff : RP.length ≠ RQ.length := by
    intro h
    apply hPQ
    dsimp [RP, RQ] at h
    omega
  let T := sourceOrientedCycleSubpath G C (A.dst_mem i) (A.dst_mem j)
  by_cases hRP : RP.length = T.length
  · refine ⟨RQ, hroute_internal Q, ?_⟩
    intro hRQ
    apply hRdiff
    calc
      RP.length = T.length := hRP
      _ = RQ.length := by simpa [T] using hRQ.symm
  · refine ⟨RP, hroute_internal P, ?_⟩
    simpa [T] using hRP

/-- A prescribed cycle vertex can be routed to a distinct normalized
attachment through an endblock path.  Lemma 3.2 provides two unequal choices,
so one avoids the oriented cycle-subpath length. -/
private theorem sourceLemma33_prescribed_to_attachment_good_route
    [Fintype V] [DecidableEq V] {r u : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (A : SourceLemma33FirstHitLinkageData G C K D) (anchor : V)
    (hanchorB : anchor ∈ D.B) (P : G.Walk u anchor)
    (hPK : internalVertices G P ⊆ K) (huC : u ∈ C.support)
    (i : Fin 4) (hsrc : A.src i ≠ anchor) :
    ∃ Q : G.Walk u (A.dst i),
      internalVertices G Q ⊆ K ∧
      Q.length ≠
        (sourceOrientedCycleSubpath G C huC (A.dst_mem i)).length := by
  classical
  let aB : {a // a ∈ D.B} := ⟨anchor, hanchorB⟩
  let sB : {a // a ∈ D.B} := ⟨A.src i, A.src_mem i⟩
  have haBsB : aB ≠ sB := by
    intro h
    exact hsrc (congrArg Subtype.val h).symm
  obtain ⟨M₁, M₂, hM₁path, hM₂path, hMneq⟩ :=
    sourceLemma32_of_sourceLemma33Endblock G D aB sB haBsB
  let route : (G.induce (↑D.B : Set V)).Walk aB sB → G.Walk u (A.dst i) :=
    fun M => P.append ((M.map (sourceLemma33_endblock_inclusion G D)).append
      (A.path i : G.Walk (A.src i) (A.dst i)))
  have hroute_internal : ∀ M : (G.induce (↑D.B : Set V)).Walk aB sB,
      internalVertices G (route M) ⊆ K := by
    intro M w hw
    change w ∈ (P.append ((M.map (sourceLemma33_endblock_inclusion G D)).append
      (A.path i : G.Walk (A.src i) (A.dst i)))).support ∧
      w ≠ u ∧ w ≠ A.dst i at hw
    rw [Walk.mem_support_append_iff] at hw
    rcases hw.1 with hwP | hwrest
    · by_cases hwa : w = anchor
      · simpa [hwa] using D.subset_component hanchorB
      · exact hPK ⟨hwP, hw.2.1, hwa⟩
    · rw [Walk.mem_support_append_iff] at hwrest
      rcases hwrest with hwM | hwA
      · rw [Walk.support_map] at hwM
        rcases List.mem_map.mp hwM with ⟨v, hv, hvw⟩
        subst w
        exact D.subset_component v.2
      · exact sourceLemma33_first_hit_vertices_component G hK
          (D.subset_component (A.src_mem i)) (A.path i : G.Walk (A.src i) (A.dst i))
          (A.path i).property (A.first_hit i) w hwA hw.2.2
  have hroute_length : ∀ M : (G.induce (↑D.B : Set V)).Walk aB sB,
      (route M).length = P.length + M.length +
        (A.path i : G.Walk (A.src i) (A.dst i)).length := by
    intro M
    dsimp [route]
    simp only [Walk.length_append, Walk.length_map]
    omega
  have hlength_ne : (route M₁).length ≠ (route M₂).length := by
    intro h
    apply hMneq
    have h₁ := hroute_length M₁
    have h₂ := hroute_length M₂
    omega
  let T := sourceOrientedCycleSubpath G C huC (A.dst_mem i)
  by_cases hM₁ : (route M₁).length = T.length
  · refine ⟨route M₂, hroute_internal M₂, ?_⟩
    intro hM₂
    apply hlength_ne
    calc
      (route M₁).length = T.length := hM₁
      _ = (route M₂).length := by simpa [T] using hM₂.symm
  · refine ⟨route M₁, hroute_internal M₁, ?_⟩
    simpa [T] using hM₁

/-- The source's notion of a good four-set for a component `K` outside an
oriented cycle `C`. For each unordered endpoint pair, an attachment path
internally in `K` has length different from at least one oriented `C`-subpath. -/
def sourceLemma33Good [DecidableEq V] {r : V} (C : G.Walk r r) (K : Set V)
    (X : Finset V) : Prop :=
  X.card = 4 ∧
    ∃ hmem : ∀ a, a ∈ X → a ∈ sourceGraphNeighbourhood G K ∧ a ∈ C.support,
      ∀ a, ∀ ha : a ∈ X, ∀ b, ∀ hb : b ∈ X, a ≠ b →
        ∃ P : G.Walk a b,
          internalVertices G P ⊆ K ∧
            (P.length ≠ (sourceOrientedCycleSubpath G C
              (hmem a ha).2 (hmem b hb).2).length ∨
              P.length ≠ (sourceOrientedCycleSubpath G C
                (hmem b hb).2 (hmem a ha).2).length)

/-- The four normalized cycle contacts form a source-Lemma-3.3 good set.
Their pairwise routes are supplied by the selected endblock. -/
private theorem sourceLemma33_good_of_first_hit_linkage [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (A : SourceLemma33FirstHitLinkageData G C K D) :
    sourceLemma33Good G C K ((Finset.univ : Finset (Fin 4)).image A.dst) := by
  classical
  let X : Finset V := (Finset.univ : Finset (Fin 4)).image A.dst
  change sourceLemma33Good G C K X
  have hXcard : X.card = 4 := by
    dsimp [X]
    simpa using Finset.card_image_of_injective (Finset.univ : Finset (Fin 4))
      A.dst_injective
  have hdecode : ∀ a, a ∈ X → ∃ i : Fin 4, A.dst i = a := by
    intro a ha
    rcases Finset.mem_image.mp ha with ⟨i, -, hia⟩
    exact ⟨i, hia⟩
  have hmem : ∀ a, a ∈ X →
      a ∈ sourceGraphNeighbourhood G K ∧ a ∈ C.support := by
    intro a ha
    obtain ⟨i, hia⟩ := hdecode a ha
    subst a
    exact ⟨sourceLemma33_first_hit_dst_mem_neighbourhood G C hK D A i, A.dst_mem i⟩
  refine ⟨hXcard, hmem, ?_⟩
  intro a ha b hb hab
  obtain ⟨i, hia⟩ := hdecode a ha
  obtain ⟨j, hjb⟩ := hdecode b hb
  have hij : i ≠ j := by
    intro hij
    apply hab
    calc
      a = A.dst i := hia.symm
      _ = A.dst j := by rw [hij]
      _ = b := hjb
  obtain ⟨P, hPK, hPneq⟩ :=
    sourceLemma33_pairwise_good_route G C hK D A i j hij
  subst a
  subst b
  refine ⟨P, hPK, ?_⟩
  exact Or.inl (by simpa using hPneq)

/-- The real endblock and Menger construction yield the endblock good-four
branch of source Lemma 3.3. -/
private theorem sourceLemma33_good_of_endblock [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (h4conn : VertexConnectivityAtLeast G 4) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K) :
    ∃ X : Finset V, sourceLemma33Good G C K X := by
  obtain ⟨A⟩ := sourceLemma33_normalized_four_attachments G C hC hgirth h4conn hK D
  exact ⟨(Finset.univ : Finset (Fin 4)).image A.dst,
    sourceLemma33_good_of_first_hit_linkage G C hK D A⟩

/-- The low-neighbour endblock branch can insert the prescribed cycle vertex
without prescribing a Menger pairing: retain three attachment sources away from
the endblock anchor and use Lemma 3.2 for each new route. -/
private theorem sourceLemma33_good_of_endblock_containing [Fintype V] [DecidableEq V]
    {r u : V} (C : G.Walk r r) (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (h4conn : VertexConnectivityAtLeast G 4) {K : Set V}
    (hK : SourceLemma33ComponentData G C K)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support)
    (D : SourceLemma33EndblockData G K) :
    ∃ X : Finset V, X.card = 4 ∧ u ∈ X ∧ sourceLemma33Good G C K X := by
  classical
  obtain ⟨A⟩ := sourceLemma33_normalized_four_attachments G C hC hgirth h4conn hK D
  by_cases huDst : ∃ i : Fin 4, A.dst i = u
  · obtain ⟨i, hi⟩ := huDst
    let X : Finset V := (Finset.univ : Finset (Fin 4)).image A.dst
    have hgood : sourceLemma33Good G C K X := by
      simpa [X] using sourceLemma33_good_of_first_hit_linkage G C hK D A
    refine ⟨X, hgood.1, ?_, hgood⟩
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, by simpa [X] using hi⟩
  · have huNotDst : ∀ i : Fin 4, A.dst i ≠ u := by
      intro i hi
      exact huDst ⟨i, hi⟩
    obtain ⟨root, hrootK, huroot⟩ := huBoundary
    let Z := sourceLemma33_endblock_anchor G hK.connected D hrootK
    obtain ⟨P, hPpath, hPK⟩ := sourceLemma33_path_to_component_vertex G hK
      ⟨root, hrootK, huroot⟩ huC (D.subset_component Z.anchor_mem)
    let I : Finset (Fin 4) :=
      if h : ∃ i : Fin 4, A.src i = Z.anchor then
        (Finset.univ : Finset (Fin 4)).erase (Classical.choose h)
      else (Finset.univ : Finset (Fin 4)).erase 0
    have hIcard : I.card = 3 := by
      dsimp [I]
      split_ifs <;> simp
    have hIsrc : ∀ i, i ∈ I → A.src i ≠ Z.anchor := by
      intro i hi hisrc
      dsimp [I] at hi
      split_ifs at hi with h
      · have hchoose : A.src (Classical.choose h) = Z.anchor := Classical.choose_spec h
        have hne : i ≠ Classical.choose h := Finset.mem_erase.mp hi |>.1
        apply hne
        apply A.src_injective
        exact hisrc.trans hchoose.symm
      · exact h ⟨i, hisrc⟩
    let T : Finset V := I.image A.dst
    let X : Finset V := insert u T
    have hTcard : T.card = 3 := by
      dsimp [T]
      simpa [hIcard] using Finset.card_image_of_injective I A.dst_injective
    have huT : u ∉ T := by
      intro huT
      rcases Finset.mem_image.mp huT with ⟨i, hiI, hidst⟩
      exact huNotDst i hidst
    have hXcard : X.card = 4 := by
      dsimp [X]
      rw [Finset.card_insert_of_not_mem huT, hTcard]
    have huX : u ∈ X := by simp [X]
    have hmem : ∀ a, a ∈ X →
        a ∈ sourceGraphNeighbourhood G K ∧ a ∈ C.support := by
      intro a ha
      simp only [X, Finset.mem_insert] at ha
      rcases ha with rfl | ha
      · exact ⟨⟨root, hrootK, huroot⟩, huC⟩
      · rcases Finset.mem_image.mp ha with ⟨i, hiI, hidst⟩
        subst a
        exact ⟨sourceLemma33_first_hit_dst_mem_neighbourhood G C hK D A i,
          A.dst_mem i⟩
    refine ⟨X, hXcard, huX, hXcard, hmem, ?_⟩
    intro a ha b hb hab
    simp only [X, Finset.mem_insert] at ha hb
    rcases ha with rfl | ha
    · rcases hb with hbu | hb
      · exact (hab hbu.symm).elim
      · rcases Finset.mem_image.mp hb with ⟨i, hiI, hidst⟩
        subst b
        obtain ⟨Q, hQK, hQneq⟩ :=
          sourceLemma33_prescribed_to_attachment_good_route G C hK D A Z.anchor
            Z.anchor_mem P hPK huC i (hIsrc i hiI)
        exact ⟨Q, hQK, Or.inl hQneq⟩
    · rcases hb with hbu | hb
      · subst b
        rcases Finset.mem_image.mp ha with ⟨i, hiI, hidst⟩
        subst a
        obtain ⟨Q, hQK, hQneq⟩ :=
          sourceLemma33_prescribed_to_attachment_good_route G C hK D A Z.anchor
            Z.anchor_mem P hPK huC i (hIsrc i hiI)
        have hQreverse : internalVertices G Q.reverse ⊆ K := by
          intro w hw
          change w ∈ Q.reverse.support ∧ w ≠ A.dst i ∧ w ≠ u at hw
          rw [Walk.support_reverse, List.mem_reverse] at hw
          exact hQK ⟨hw.1, hw.2.2, hw.2.1⟩
        refine ⟨Q.reverse, hQreverse, Or.inr ?_⟩
        simpa [Walk.length_reverse] using hQneq
      · rcases Finset.mem_image.mp ha with ⟨i, hiI, hidst⟩
        rcases Finset.mem_image.mp hb with ⟨j, hjI, hjdst⟩
        have hij : i ≠ j := by
          intro hij
          apply hab
          calc
            a = A.dst i := hidst.symm
            _ = A.dst j := by rw [hij]
            _ = b := hjdst
        obtain ⟨Q, hQK, hQneq⟩ :=
          sourceLemma33_pairwise_good_route G C hK D A i j hij
        subst a
        subst b
        exact ⟨Q, hQK, Or.inl hQneq⟩

private theorem sourceLemma33_good_of_four_cycle_neighbours [Fintype V]
    [DecidableEq V] {r z : V} (C : G.Walk r r) (K : Set V)
    (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (hK : SourceLemma33ComponentData G C K) (hzK : z ∈ K)
    (X : Finset V) (hXcard : X.card = 4)
    (hX : ∀ a, a ∈ X → a ∈ sourceLemma33CycleNeighbours G C z) :
    sourceLemma33Good G C K X := by
  classical
  refine ⟨hXcard, ?_⟩
  let hmem : ∀ a, a ∈ X → a ∈ sourceGraphNeighbourhood G K ∧ a ∈ C.support := by
    intro a ha
    rcases (mem_sourceLemma33CycleNeighbours G C z a).mp (hX a ha) with ⟨haC, hza⟩
    exact ⟨⟨z, hzK, hza.symm⟩, haC⟩
  refine ⟨hmem, ?_⟩
  intro a ha b hb hab
  rcases hmem a ha with ⟨_, haC⟩
  rcases hmem b hb with ⟨_, hbC⟩
  rcases (mem_sourceLemma33CycleNeighbours G C z a).mp (hX a ha) with ⟨_, hza⟩
  rcases (mem_sourceLemma33CycleNeighbours G C z b).mp (hX b hb) with ⟨_, hzb⟩
  obtain ⟨P, _, hPK, hPlength⟩ :=
    sourceLemma33_two_edge_path G hK hzK haC hbC hab hza hzb
  refine ⟨P, hPK, Or.inl ?_⟩
  simpa [hPlength] using
    (sourceLemma33_cycle_subpath_length_ne_two G C hC hgirth
      (hK.disjoint_cycle z hzK) haC hbC hab hza hzb).symm

/-- The source-faithful good-four property: every ordered endpoint pair has a
simple replacement path whose length differs from the forward cycle arc. -/
def sourceLemma33GoodPath [DecidableEq V] {r : V} (C : G.Walk r r) (K : Set V)
    (X : Finset V) : Prop :=
  X.card = 4 ∧
    ∃ hmem : ∀ a, a ∈ X → a ∈ sourceGraphNeighbourhood G K ∧ a ∈ C.support,
      ∀ a, ∀ ha : a ∈ X, ∀ b, ∀ hb : b ∈ X, a ≠ b →
        ∃ P : G.Walk a b,
          P.IsPath ∧ internalVertices G P ⊆ K ∧
            P.length ≠ (sourceOrientedCycleSubpath G C
              (hmem a ha).2 (hmem b hb).2).length

/-- Four cycle neighbours of one outside vertex give genuine simple-path
witnesses for the prescribed orientation, by the girth-five hypothesis. -/
private theorem sourceLemma33_good_of_four_cycle_neighbours_path [Fintype V]
    [DecidableEq V] {r z : V} (C : G.Walk r r) (K : Set V)
    (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (hK : SourceLemma33ComponentData G C K) (hzK : z ∈ K)
    (X : Finset V) (hXcard : X.card = 4)
    (hX : ∀ a, a ∈ X → a ∈ sourceLemma33CycleNeighbours G C z) :
    sourceLemma33GoodPath G C K X := by
  classical
  let hmem : ∀ a, a ∈ X → a ∈ sourceGraphNeighbourhood G K ∧ a ∈ C.support := by
    intro a ha
    rcases (mem_sourceLemma33CycleNeighbours G C z a).mp (hX a ha) with ⟨haC, hza⟩
    exact ⟨⟨z, hzK, hza.symm⟩, haC⟩
  refine ⟨hXcard, hmem, ?_⟩
  intro a ha b hb hab
  rcases (mem_sourceLemma33CycleNeighbours G C z a).mp (hX a ha) with ⟨haC, hza⟩
  rcases (mem_sourceLemma33CycleNeighbours G C z b).mp (hX b hb) with ⟨hbC, hzb⟩
  obtain ⟨P, hPpath, hPK, hPlength⟩ :=
    sourceLemma33_two_edge_path G hK hzK haC hbC hab hza hzb
  refine ⟨P, hPpath, hPK, ?_⟩
  simpa [hPlength] using
    (sourceLemma33_cycle_subpath_length_ne_two G C hC hgirth
      (hK.disjoint_cycle z hzK) (hmem a ha).2 (hmem b hb).2 hab hza hzb).symm

private theorem sourceLemma33_select_good_four_containing [Fintype V]
    [DecidableEq V] {r u z : V} (C : G.Walk r r) (K : Set V)
    (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (hK : SourceLemma33ComponentData G C K) (hzK : z ∈ K)
    (hfour : 4 ≤ (sourceLemma33CycleNeighbours G C z).card)
    (hu : u ∈ sourceLemma33CycleNeighbours G C z) :
    ∃ X : Finset V, X.card = 4 ∧ u ∈ X ∧
      X ⊆ sourceLemma33CycleNeighbours G C z ∧ sourceLemma33Good G C K X := by
  classical
  let S := sourceLemma33CycleNeighbours G C z
  have hfourS : 4 ≤ S.card := by simpa [S] using hfour
  have huS : u ∈ S := by simpa [S] using hu
  have hthree : 3 ≤ (S.erase u).card := by
    rw [Finset.card_erase_of_mem huS]
    omega
  obtain ⟨T, hTS, hTcard⟩ := (S.erase u).exists_subset_card_eq hthree
  have huT : u ∉ T := by
    intro huT
    exact (Finset.not_mem_erase u S) (hTS huT)
  let X := insert u T
  have hXcard : X.card = 4 := by
    dsimp [X]
    rw [Finset.card_insert_of_not_mem huT, hTcard]
  have huX : u ∈ X := by simp [X]
  have hXS : X ⊆ S := by
    intro a ha
    simp only [X, Finset.mem_insert] at ha
    rcases ha with rfl | ha
    · exact huS
    · exact Finset.erase_subset u S (hTS ha)
  refine ⟨X, hXcard, huX, ?_, ?_⟩
  · simpa [S] using hXS
  · apply sourceLemma33_good_of_four_cycle_neighbours G C K hC hgirth hK hzK X hXcard
    intro a ha
    simpa [S] using hXS ha
/-- The source high-neighbour case: a prescribed cycle boundary vertex lies
in a good four-set. -/
private theorem sourceLemma33_good_of_high_cycle_degree [Fintype V] [DecidableEq V]
    {r u z : V} (C : G.Walk r r) (K : Set V) (hC : C.IsCycle)
    (hgirth : 5 ≤ G.girth) (hK : SourceLemma33ComponentData G C K)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support)
    (hzK : z ∈ K) (hfour : 4 ≤ (sourceLemma33CycleNeighbours G C z).card) :
    ∃ X : Finset V, X.card = 4 ∧ u ∈ X ∧ sourceLemma33Good G C K X := by
  classical
  let S := sourceLemma33CycleNeighbours G C z
  have hfourS : 4 ≤ S.card := by simpa [S] using hfour
  by_cases huS : u ∈ S
  · obtain ⟨X, hXcard, huX, hXS, hgood⟩ :=
      sourceLemma33_select_good_four_containing G C K hC hgirth hK hzK hfour (by simpa [S] using huS)
    exact ⟨X, hXcard, huX, hgood⟩
  · obtain ⟨P, hPpath, hPK⟩ :=
      sourceLemma33_path_to_component_vertex G hK huBoundary huC hzK
    have huz : u ≠ z := by
      intro huz
      subst u
      exact hK.disjoint_cycle z hzK huC
    let bad : V → Prop := fun y =>
      ∃ hyS : y ∈ S,
        (sourceOrientedCycleSubpath G C huC
          ((mem_sourceLemma33CycleNeighbours G C z y).mp (by simpa [S] using hyS)).1).length =
          P.length + 1
    obtain ⟨T, hTS, hTcard, hTsafe⟩ :
        ∃ T : Finset V, T ⊆ S ∧ T.card = 3 ∧ ∀ y, y ∈ T → ¬ bad y := by
      by_cases hbad : ∃ y, bad y
      · obtain ⟨ybad, hybad⟩ := hbad
        rcases hybad with ⟨hybadS, hybadEq⟩
        have hthree : 3 ≤ (S.erase ybad).card := by
          rw [Finset.card_erase_of_mem hybadS]
          omega
        obtain ⟨T, hTerase, hTcard⟩ := (S.erase ybad).exists_subset_card_eq hthree
        have hunique : ∀ y, y ∈ S → bad y → y = ybad := by
          intro y hyS hy
          rcases hy with ⟨hyS', hyEq⟩
          apply sourceLemma33_oriented_subpath_length_injective G C huC
            ((mem_sourceLemma33CycleNeighbours G C z y).mp (by simpa [S] using hyS')).1
            ((mem_sourceLemma33CycleNeighbours G C z ybad).mp (by simpa [S] using hybadS)).1
          simpa using hyEq.trans hybadEq.symm
        refine ⟨T, ?_, hTcard, ?_⟩
        · intro y hyT
          exact Finset.mem_of_mem_erase (hTerase hyT)
        · intro y hyT hy
          exact (Finset.ne_of_mem_erase (hTerase hyT))
            (hunique y (Finset.mem_of_mem_erase (hTerase hyT)) hy)
      · obtain ⟨T, hTS, hTcard⟩ := S.exists_subset_card_eq (by omega : 3 ≤ S.card)
        exact ⟨T, hTS, hTcard, fun y hyT hy => hbad ⟨y, hy⟩⟩
    have huT : u ∉ T := by
      intro huT
      exact huS (hTS huT)
    let X := insert u T
    have hXcard : X.card = 4 := by
      dsimp [X]
      rw [Finset.card_insert_of_not_mem huT, hTcard]
    have huX : u ∈ X := by simp [X]
    have hmem : ∀ a, a ∈ X →
        a ∈ sourceGraphNeighbourhood G K ∧ a ∈ C.support := by
      intro a ha
      simp only [X, Finset.mem_insert] at ha
      rcases ha with rfl | ha
      · exact ⟨huBoundary, huC⟩
      · rcases (mem_sourceLemma33CycleNeighbours G C z a).mp (by simpa [S] using hTS ha) with
          ⟨haC, hza⟩
        exact ⟨⟨z, hzK, hza.symm⟩, haC⟩
    refine ⟨X, hXcard, huX, ?_⟩
    refine ⟨hXcard, hmem, ?_⟩
    intro a ha b hb hab
    simp only [X, Finset.mem_insert] at ha hb
    rcases ha with rfl | ha
    · rcases hb with hub | hb
      · exact (hab hub.symm).elim
      · rcases (mem_sourceLemma33CycleNeighbours G C z b).mp (by simpa [S] using hTS hb) with
          ⟨hbC, hzb⟩
        refine ⟨P.concat hzb,
          sourceLemma33_path_via_component_vertex_internal G P hPK hzK hzb, Or.inl ?_⟩
        intro hEq
        apply hTsafe b hb
        refine ⟨by simpa [S] using hTS hb, ?_⟩
        simpa [Walk.length_concat] using hEq.symm
    · rcases hb with hub | hb
      · subst b
        rcases (mem_sourceLemma33CycleNeighbours G C z a).mp (by simpa [S] using hTS ha) with
            ⟨haC, hza⟩
        have hforward : internalVertices G (P.concat hza) ⊆ K :=
          sourceLemma33_path_via_component_vertex_internal G P hPK hzK hza
        have hreverse : internalVertices G (P.concat hza).reverse ⊆ K := by
          intro w hw
          change w ∈ (P.concat hza).reverse.support ∧ w ≠ a ∧ w ≠ u at hw
          rw [Walk.support_reverse, List.mem_reverse] at hw
          exact hforward ⟨hw.1, hw.2.2, hw.2.1⟩
        refine ⟨(P.concat hza).reverse, hreverse, Or.inr ?_⟩
        intro hEq
        apply hTsafe a ha
        refine ⟨by simpa [S] using hTS ha, ?_⟩
        simpa [Walk.length_reverse, Walk.length_concat] using hEq.symm
      · rcases (mem_sourceLemma33CycleNeighbours G C z a).mp (by simpa [S] using hTS ha) with
          ⟨haC, hza⟩
        rcases (mem_sourceLemma33CycleNeighbours G C z b).mp (by simpa [S] using hTS hb) with
          ⟨hbC, hzb⟩
        obtain ⟨Q, hQpath, hQK, hQlength⟩ :=
          sourceLemma33_two_edge_path G hK hzK haC hbC hab hza hzb
        refine ⟨Q, hQK, Or.inl ?_⟩
        simpa [hQlength] using
          (sourceLemma33_cycle_subpath_length_ne_two G C hC hgirth
            (hK.disjoint_cycle z hzK) haC hbC hab hza hzb).symm

/-- Root-specific simple replacement paths for the designated attachment in
the Lemma 3.9 application; no reverse-direction or non-root pair is asserted. -/
def sourceLemma33RootGoodPath [DecidableEq V] {r : V} (C : G.Walk r r)
    (K : Set V) (u : V) (X : Finset V) : Prop :=
  X.card = 4 ∧ ∃ huX : u ∈ X,
    ∃ hmem : ∀ a, a ∈ X → a ∈ sourceGraphNeighbourhood G K ∧ a ∈ C.support,
      ∀ v, ∀ hv : v ∈ X, v ≠ u →
        ∃ P : G.Walk u v,
          P.IsPath ∧ internalVertices G P ⊆ K ∧
            P.length ≠ (sourceOrientedCycleSubpath G C
              (hmem u huX).2 (hmem v hv).2).length

/-- The last edge to a distinct cycle contact preserves simplicity: its
endpoint occurs neither internally in the component path nor at its ends. -/
private theorem sourceLemma33_concat_to_cycle_isPath [DecidableEq V]
    {r u z y : V} {C : G.Walk r r} {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (P : G.Walk u z)
    (hP : P.IsPath) (hPK : internalVertices G P ⊆ K) (hzK : z ∈ K)
    (hyC : y ∈ C.support) (hyu : y ≠ u) (hzy : G.Adj z y) :
    (P.concat hzy).IsPath := by
  have hyNot : y ∉ P.support := by
    intro hyP
    by_cases hyz : y = z
    · exact hK.disjoint_cycle y (hyz.symm ▸ hzK) hyC
    · exact hK.disjoint_cycle y (hPK ⟨hyP, hyu, hyz⟩) hyC
  apply (Walk.isPath_reverse_iff (P.concat hzy)).mp
  rw [Walk.reverse_concat]
  exact (Walk.cons_isPath_iff hzy.symm P.reverse).mpr
    ⟨hP.reverse, by simpa [Walk.support_reverse] using hyNot⟩

/-- The high-cycle-neighbour branch supplies simple paths from the prescribed
root to three contacts, avoiding the forward root-to-contact cycle lengths. -/
private theorem sourceLemma33_high_cycle_degree_rooted_paths [Fintype V] [DecidableEq V]
    {r u z : V} (C : G.Walk r r) (K : Set V) (hC : C.IsCycle)
    (hgirth : 5 ≤ G.girth) (hK : SourceLemma33ComponentData G C K)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support)
    (hzK : z ∈ K) (hfour : 4 ≤ (sourceLemma33CycleNeighbours G C z).card) :
    ∃ X : Finset V, sourceLemma33RootGoodPath G C K u X := by
  classical
  let S := sourceLemma33CycleNeighbours G C z
  have hfourS : 4 ≤ S.card := by simpa [S] using hfour
  by_cases huS : u ∈ S
  · obtain ⟨X, hXcard, huX, hXS, _⟩ :=
      sourceLemma33_select_good_four_containing G C K hC hgirth hK hzK hfour
        (by simpa [S] using huS)
    obtain ⟨_, hmem, hpaths⟩ :=
      sourceLemma33_good_of_four_cycle_neighbours_path G C K hC hgirth hK hzK X hXcard hXS
    refine ⟨X, hXcard, huX, hmem, ?_⟩
    intro v hv hvu
    exact hpaths u huX v hv hvu.symm
  · obtain ⟨P, hPpath, hPK⟩ :=
      sourceLemma33_path_to_component_vertex G hK huBoundary huC hzK
    let bad : V → Prop := fun y =>
      ∃ hyS : y ∈ S,
        (sourceOrientedCycleSubpath G C huC
          ((mem_sourceLemma33CycleNeighbours G C z y).mp (by simpa [S] using hyS)).1).length =
          P.length + 1
    obtain ⟨T, hTS, hTcard, hTsafe⟩ :
        ∃ T : Finset V, T ⊆ S ∧ T.card = 3 ∧ ∀ y, y ∈ T → ¬ bad y := by
      by_cases hbad : ∃ y, bad y
      · obtain ⟨ybad, hybad⟩ := hbad
        rcases hybad with ⟨hybadS, hybadEq⟩
        have hthree : 3 ≤ (S.erase ybad).card := by
          rw [Finset.card_erase_of_mem hybadS]
          omega
        obtain ⟨T, hTerase, hTcard⟩ := (S.erase ybad).exists_subset_card_eq hthree
        have hunique : ∀ y, y ∈ S → bad y → y = ybad := by
          intro y hyS hy
          rcases hy with ⟨hyS', hyEq⟩
          apply sourceLemma33_oriented_subpath_length_injective G C huC
            ((mem_sourceLemma33CycleNeighbours G C z y).mp (by simpa [S] using hyS')).1
            ((mem_sourceLemma33CycleNeighbours G C z ybad).mp (by simpa [S] using hybadS)).1
          simpa using hyEq.trans hybadEq.symm
        refine ⟨T, ?_, hTcard, ?_⟩
        · intro y hyT
          exact Finset.mem_of_mem_erase (hTerase hyT)
        · intro y hyT hy
          exact (Finset.ne_of_mem_erase (hTerase hyT))
            (hunique y (Finset.mem_of_mem_erase (hTerase hyT)) hy)
      · obtain ⟨T, hTS, hTcard⟩ := S.exists_subset_card_eq (by omega : 3 ≤ S.card)
        exact ⟨T, hTS, hTcard, fun y hyT hy => hbad ⟨y, hy⟩⟩
    have huT : u ∉ T := by
      intro huT
      exact huS (hTS huT)
    let X := insert u T
    have hXcard : X.card = 4 := by
      dsimp [X]
      rw [Finset.card_insert_of_not_mem huT, hTcard]
    have huX : u ∈ X := by simp [X]
    have hmem : ∀ a, a ∈ X →
        a ∈ sourceGraphNeighbourhood G K ∧ a ∈ C.support := by
      intro a ha
      simp only [X, Finset.mem_insert] at ha
      rcases ha with rfl | ha
      · exact ⟨huBoundary, huC⟩
      · rcases (mem_sourceLemma33CycleNeighbours G C z a).mp (by simpa [S] using hTS ha) with
          ⟨haC, hza⟩
        exact ⟨⟨z, hzK, hza.symm⟩, haC⟩
    refine ⟨X, hXcard, huX, hmem, ?_⟩
    intro y hy hyu
    have hyT : y ∈ T := (Finset.mem_insert.mp hy).resolve_left hyu
    obtain ⟨hyC, hzy⟩ := (mem_sourceLemma33CycleNeighbours G C z y).mp
      (by simpa [S] using hTS hyT)
    refine ⟨P.concat hzy,
      sourceLemma33_concat_to_cycle_isPath G hK P hPpath hPK hzK hyC hyu hzy,
      sourceLemma33_path_via_component_vertex_internal G P hPK hzK hzy, ?_⟩
    intro hEq
    apply hTsafe y hyT
    refine ⟨by simpa [S] using hTS hyT, ?_⟩
    simpa [Walk.length_concat] using hEq.symm

/-- Stop a simple path at its first vertex in the endblock. -/
private theorem sourceLemma33_first_finset_hit [Fintype V] [DecidableEq V]
    (B : Finset V) {a b : V}
    (P : G.Walk a b) (hP : P.IsPath) (hbB : b ∈ B) :
    ∃ c, ∃ Q : G.Walk a c, Q.IsPath ∧ c ∈ B ∧
      (∀ w, w ∈ Q.support → w ≠ c → w ∉ B) ∧
      (∀ w, w ∈ Q.support → w ∈ P.support) := by
  classical
  induction P with
  | @nil a =>
      refine ⟨a, Walk.nil, Walk.IsPath.nil, hbB, ?_, ?_⟩
      · intro w hw hne
        have hwa : w = a := by simpa using hw
        exact (hne hwa).elim
      · intro w hw
        exact hw
  | @cons a a' b haa' p ih =>
      by_cases haB : a ∈ B
      · refine ⟨a, Walk.nil, Walk.IsPath.nil, haB, ?_, ?_⟩
        · intro w hw hne
          have hwa : w = a := by simpa using hw
          exact (hne hwa).elim
        · intro w hw
          have hwa : w = a := by simpa using hw
          subst w
          exact Walk.start_mem_support _
      · obtain ⟨c, Q, hQ, hcB, hfirst, hsub⟩ := ih hP.of_cons hbB
        refine ⟨c, Walk.cons haa' Q, ?_, hcB, ?_, ?_⟩
        · exact (Walk.cons_isPath_iff haa' Q).mpr
            ⟨hQ, fun haQ => ((Walk.cons_isPath_iff haa' p).mp hP).2 (hsub a haQ)⟩
        · intro w hw hwc
          rcases List.mem_cons.mp hw with rfl | hw
          · exact haB
          · exact hfirst w hw hwc
        · intro w hw
          rcases List.mem_cons.mp hw with rfl | hw
          · exact Walk.start_mem_support _
          · exact List.mem_cons_of_mem a (hsub w hw)

private theorem sourceLemma33_first_block_hit [Fintype V] [DecidableEq V]
    {K : Set V} (D : SourceLemma33EndblockData G K) {a b : V}
    (P : G.Walk a b) (hP : P.IsPath) (hbB : b ∈ D.B) :
    ∃ c, ∃ Q : G.Walk a c, Q.IsPath ∧ c ∈ D.B ∧
      (∀ w, w ∈ Q.support → w ≠ c → w ∉ D.B) ∧
      (∀ w, w ∈ Q.support → w ∈ P.support) := by
  exact sourceLemma33_first_finset_hit G D.B P hP hbB

/-- Simple pieces meeting only at their joining vertex concatenate simply. -/
private theorem sourceLemma33_append_paths [DecidableEq V] {a b c : V}
    (P : G.Walk a b) (Q : G.Walk b c) (hP : P.IsPath) (hQ : Q.IsPath)
    (hinter : ∀ w, w ∈ P.support → w ∈ Q.support → w = b) :
    (P.append Q).IsPath := by
  apply Walk.IsPath.mk'
  rw [Walk.support_append]
  apply List.nodup_append.mpr
  refine ⟨hP.support_nodup, hQ.support_nodup.tail, ?_⟩
  rw [List.disjoint_left]
  intro w hwP hwQ
  have hwQ' : w ∈ Q.support := List.mem_of_mem_tail hwQ
  have hwb := hinter w hwP hwQ'
  subst w
  cases Q with
  | nil => simpa using hwQ
  | cons h q =>
      exact ((Walk.cons_isPath_iff h q).mp hQ).2 (by simpa using hwQ)

/-- Normalize an attachment at its last block visit, preserving its cycle
endpoint and keeping every subsequent vertex outside the block. -/
private theorem sourceLemma33_attachment_tail [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (A : SourceLemma33FirstHitLinkageData G C K D) (i : Fin 4) :
    ∃ b, ∃ Q : G.Walk b (A.dst i), b ∈ D.B ∧ Q.IsPath ∧
      (∀ w, w ∈ Q.support → w ≠ b → w ∉ D.B) ∧
      (∀ w, w ∈ Q.support → w ≠ A.dst i → w ∈ K) ∧
      (∀ w, w ∈ Q.support → w ∈ (A.path i : G.Walk (A.src i) (A.dst i)).support) := by
  obtain ⟨b, R, hR, hbB, hfirst, hsub⟩ := sourceLemma33_first_block_hit G D
    (A.path i : G.Walk (A.src i) (A.dst i)).reverse (A.path i).property.reverse (A.src_mem i)
  have hsubset : ∀ w, w ∈ R.reverse.support →
      w ∈ (A.path i : G.Walk (A.src i) (A.dst i)).support := by
    intro w hw
    have hwR : w ∈ R.support := by simpa using hw
    have hwOriginal := hsub w hwR
    simpa using hwOriginal
  have hfirstC : ∀ w, w ∈ R.reverse.support → w ≠ A.dst i → w ∉ C.support := by
    intro w hw hwd
    exact A.first_hit i w (hsubset w hw) hwd
  refine ⟨b, R.reverse, hbB, hR.reverse, ?_, ?_, hsubset⟩
  · intro w hw hwb
    exact hfirst w (by simpa using hw) hwb
  · intro w hw hwd
    exact sourceLemma33_first_hit_vertices_component G hK (D.subset_component hbB)
      R.reverse hR.reverse hfirstC w hw hwd

/-- A normalized tail leaving a non-cut block vertex goes directly to C. -/
private theorem sourceLemma33_noncut_tail_length [Fintype V] [DecidableEq V]
    {K : Set V} (D : SourceLemma33EndblockData G K) {b v : V}
    (Q : G.Walk b v) (hQ : Q.IsPath) (hbB : b ∈ D.B) (hcut : D.cut ≠ some b)
    (hbv : b ≠ v)
    (havoid : ∀ w, w ∈ Q.support → w ≠ b → w ∉ D.B)
    (hK : ∀ w, w ∈ Q.support → w ≠ v → w ∈ K) :
    Q.length = 1 := by
  cases Q with
  | nil => exact (hbv rfl).elim
  | @cons b b' v hbb' q =>
      have hb'Q : b' ∈ (Walk.cons hbb' q).support := by simp
      by_cases hb'v : b' = v
      · subst b'
        have hqnil : q = Walk.nil := (Walk.isPath_iff_eq_nil q).mp hQ.of_cons
        subst q
        rfl
      · have hb'B := D.noncut_closed hbB hcut hbb' (hK b' hb'Q hb'v)
        exact (havoid b' hb'Q hbb'.ne.symm hb'B).elim

/-- Two simple block routes avoid any one prescribed length. -/
private theorem sourceLemma33_route_through_block_avoids_length [Fintype V] [DecidableEq V]
    {r u a b v : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (P : G.Walk u a) (Q : G.Walk b v) (hP : P.IsPath) (hQ : Q.IsPath)
    (haB : a ∈ D.B) (hbB : b ∈ D.B) (hab : a ≠ b)
    (hPavoid : ∀ w, w ∈ P.support → w ≠ a → w ∉ D.B)
    (hQavoid : ∀ w, w ∈ Q.support → w ≠ b → w ∉ D.B)
    (hPK : ∀ w, w ∈ P.support → w ≠ u → w ∈ K)
    (hQK : ∀ w, w ∈ Q.support → w ≠ v → w ∈ K)
    (hPQ : ∀ w, w ∈ P.support → w ∈ Q.support → False)
    (L : ℕ) :
    ∃ R : G.Walk u v, R.IsPath ∧ internalVertices G R ⊆ K ∧
      R.length ≠ L := by
  let aa : {x // x ∈ D.B} := ⟨a, haB⟩
  let bb : {x // x ∈ D.B} := ⟨b, hbB⟩
  have haabb : aa ≠ bb := fun h => hab (congrArg Subtype.val h)
  obtain ⟨M, N, hM, hN, hMN⟩ := sourceLemma32_of_sourceLemma33Endblock G D aa bb haabb
  let route := fun T : (G.induce (↑D.B : Set V)).Walk aa bb =>
    (P.append (T.map (sourceLemma33_endblock_inclusion G D))).append Q
  have hmiddle : ∀ (T : (G.induce (↑D.B : Set V)).Walk aa bb) w,
      w ∈ (T.map (sourceLemma33_endblock_inclusion G D)).support → w ∈ D.B := by
    intro T w hw
    rw [Walk.support_map] at hw
    obtain ⟨x, _, h⟩ := List.mem_map.mp hw
    subst w
    exact x.property
  have hpath : ∀ (T : (G.induce (↑D.B : Set V)).Walk aa bb), T.IsPath →
      (route T).IsPath := by
    intro T hT
    have hmap : (T.map (sourceLemma33_endblock_inclusion G D)).IsPath :=
      Walk.map_isPath_of_injective Subtype.val_injective hT
    have hleft := sourceLemma33_append_paths G P
      (T.map (sourceLemma33_endblock_inclusion G D)) hP hmap (by
        intro w hwP hwT
        by_contra hwa
        exact hPavoid w hwP hwa (hmiddle T w hwT))
    apply sourceLemma33_append_paths G _ Q hleft hQ
    intro w hwLeft hwQ
    rcases (Walk.mem_support_append_iff _ _).mp hwLeft with hwP | hwT
    · exact (hPQ w hwP hwQ).elim
    · by_contra hwb
      exact hQavoid w hwQ hwb (hmiddle T w hwT)
  have hinside : ∀ T : (G.induce (↑D.B : Set V)).Walk aa bb,
      internalVertices G (route T) ⊆ K := by
    intro T w hw
    rcases (Walk.mem_support_append_iff _ _).mp hw.1 with hwLeft | hwQ
    · rcases (Walk.mem_support_append_iff _ _).mp hwLeft with hwP | hwT
      · exact hPK w hwP hw.2.1
      · exact D.subset_component (hmiddle T w hwT)
    · exact hQK w hwQ hw.2.2
  have hlen : ∀ T : (G.induce (↑D.B : Set V)).Walk aa bb,
      (route T).length = P.length + T.length + Q.length := by
    intro T
    simp [route]
  have hdiff : (route M).length ≠ (route N).length := by
    intro h
    apply hMN
    have hMlen := hlen M
    have hNlen := hlen N
    omega
  by_cases hbad : (route M).length = L
  · refine ⟨route N, hpath N hN, hinside N, ?_⟩
    intro h
    exact hdiff (hbad.trans h.symm)
  · exact ⟨route M, hpath M hM, hinside M, hbad⟩

/-- Two different simple block routes give a simple rooted replacement of
length different from the prescribed forward cycle arc. -/
private theorem sourceLemma33_rooted_route_through_block [Fintype V] [DecidableEq V]
    {r u a b v : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (P : G.Walk u a) (Q : G.Walk b v) (hP : P.IsPath) (hQ : Q.IsPath)
    (haB : a ∈ D.B) (hbB : b ∈ D.B) (hab : a ≠ b)
    (hPavoid : ∀ w, w ∈ P.support → w ≠ a → w ∉ D.B)
    (hQavoid : ∀ w, w ∈ Q.support → w ≠ b → w ∉ D.B)
    (hPK : ∀ w, w ∈ P.support → w ≠ u → w ∈ K)
    (hQK : ∀ w, w ∈ Q.support → w ≠ v → w ∈ K)
    (hPQ : ∀ w, w ∈ P.support → w ∈ Q.support → False)
    (huC : u ∈ C.support) (hvC : v ∈ C.support) :
    ∃ R : G.Walk u v, R.IsPath ∧ internalVertices G R ⊆ K ∧
      R.length ≠ (sourceOrientedCycleSubpath G C huC hvC).length := by
  exact sourceLemma33_route_through_block_avoids_length G C hK D P Q hP hQ
    haB hbB hab hPavoid hQavoid hPK hQK hPQ
    (sourceOrientedCycleSubpath G C huC hvC).length

/-- Package three distinct cycle contacts and their actual rooted paths. -/
private theorem sourceLemma33_root_good_of_contacts [Fintype V] [DecidableEq V]
    {r u : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (A : SourceLemma33FirstHitLinkageData G C K D)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support)
    (I : Finset (Fin 4)) (hI : I.card = 3) (hne : ∀ i ∈ I, A.dst i ≠ u)
    (hpaths : ∀ i ∈ I, ∃ P : G.Walk u (A.dst i), P.IsPath ∧
      internalVertices G P ⊆ K ∧ P.length ≠
        (sourceOrientedCycleSubpath G C huC (A.dst_mem i)).length) :
    ∃ X : Finset V, sourceLemma33RootGoodPath G C K u X := by
  classical
  let T := I.image A.dst
  have hTcard : T.card = 3 := by
    simpa [T, hI] using Finset.card_image_of_injective I A.dst_injective
  have huT : u ∉ T := by
    intro h
    obtain ⟨i, hi, heq⟩ := Finset.mem_image.mp h
    exact hne i hi heq
  let X := insert u T
  have hXcard : X.card = 4 := by simp [X, Finset.card_insert_of_not_mem huT, hTcard]
  have huX : u ∈ X := by simp [X]
  have hmem : ∀ a, a ∈ X → a ∈ sourceGraphNeighbourhood G K ∧ a ∈ C.support := by
    intro a ha
    rcases Finset.mem_insert.mp ha with rfl | ha
    · exact ⟨huBoundary, huC⟩
    · obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp ha
      exact ⟨sourceLemma33_first_hit_dst_mem_neighbourhood G C hK D A i, A.dst_mem i⟩
  refine ⟨X, hXcard, huX, hmem, ?_⟩
  intro v hv hvu
  obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp ((Finset.mem_insert.mp hv).resolve_left hvu)
  simpa using hpaths i hi

/-- The source-faithful path certificate supplies the legacy good-set
certificate on exactly the same four-set, without adding backtracking. -/
theorem sourceLemma33_good_path_forget [DecidableEq V] {r : V}
    (C : G.Walk r r) {K : Set V} {X : Finset V}
    (hgood : sourceLemma33GoodPath G C K X) : sourceLemma33Good G C K X := by
  obtain ⟨hcard, hmem, hpaths⟩ := hgood
  refine ⟨hcard, hmem, ?_⟩
  intro a ha b hb hab
  obtain ⟨P, _, hPK, hlength⟩ := hpaths a ha b hb hab
  exact ⟨P, hPK, Or.inl hlength⟩

/-- The same full good four-set retains its designated-root path interface. -/
theorem sourceLemma33_good_path_root [DecidableEq V] {r u : V}
    (C : G.Walk r r) {K : Set V} {X : Finset V}
    (huX : u ∈ X) (hgood : sourceLemma33GoodPath G C K X) :
    sourceLemma33RootGoodPath G C K u X := by
  obtain ⟨hcard, hmem, hpaths⟩ := hgood
  refine ⟨hcard, huX, hmem, ?_⟩
  intro v hv hvu
  exact hpaths u huX v hv hvu.symm

/-- Package all ordered contact pairs, retaining the prescribed root.
Root routes may be chosen separately for the two cycle orientations. -/
private theorem sourceLemma33_good_path_of_contacts [Fintype V] [DecidableEq V]
    {r u : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (A : SourceLemma33FirstHitLinkageData G C K D)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support)
    (I : Finset (Fin 4)) (hI : I.card = 3) (hne : ∀ i ∈ I, A.dst i ≠ u)
    (hcontacts : ∀ i ∈ I, ∀ j ∈ I, i ≠ j →
      ∃ P : G.Walk (A.dst i) (A.dst j), P.IsPath ∧ internalVertices G P ⊆ K ∧
        P.length ≠ (sourceOrientedCycleSubpath G C (A.dst_mem i) (A.dst_mem j)).length)
    (hroot : ∀ i ∈ I, ∀ L : ℕ,
      (L = (sourceOrientedCycleSubpath G C huC (A.dst_mem i)).length ∨
        L = (sourceOrientedCycleSubpath G C (A.dst_mem i) huC).length) →
      ∃ P : G.Walk u (A.dst i), P.IsPath ∧ internalVertices G P ⊆ K ∧ P.length ≠ L) :
    ∃ X : Finset V, u ∈ X ∧ sourceLemma33GoodPath G C K X := by
  classical
  let T := I.image A.dst
  have hTcard : T.card = 3 := by
    simpa [T, hI] using Finset.card_image_of_injective I A.dst_injective
  have huT : u ∉ T := by
    intro h
    obtain ⟨i, hi, heq⟩ := Finset.mem_image.mp h
    exact hne i hi heq
  let X := insert u T
  have hXcard : X.card = 4 := by simp [X, Finset.card_insert_of_not_mem huT, hTcard]
  have huX : u ∈ X := by simp [X]
  have hmem : ∀ a, a ∈ X → a ∈ sourceGraphNeighbourhood G K ∧ a ∈ C.support := by
    intro a ha
    rcases Finset.mem_insert.mp ha with rfl | ha
    · exact ⟨huBoundary, huC⟩
    · obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp ha
      exact ⟨sourceLemma33_first_hit_dst_mem_neighbourhood G C hK D A i, A.dst_mem i⟩
  refine ⟨X, huX, hXcard, hmem, ?_⟩
  intro a ha b hb hab
  rcases Finset.mem_insert.mp ha with rfl | ha
  · obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp
      ((Finset.mem_insert.mp hb).resolve_left hab.symm)
    simpa using hroot j hj _ (Or.inl rfl)
  · obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp ha
    rcases Finset.mem_insert.mp hb with rfl | hb
    · obtain ⟨P, hP, hPK, hlength⟩ := hroot i hi _ (Or.inr rfl)
      refine ⟨P.reverse, hP.reverse, ?_, ?_⟩
      · intro w hw
        have hwP : w ∈ P.support := by simpa using hw.1
        exact hPK ⟨hwP, hw.2.2, hw.2.1⟩
      · simpa using hlength
    · obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hb
      simpa using hcontacts i hi j hj (fun h => hab (congrArg A.dst h))

/-- The endblock branch supplies the full good-four-set path property,
including reverse root routes and every ordered non-root contact pair. -/
private theorem sourceLemma33_endblock_good_paths [Fintype V] [DecidableEq V]
    {r u : V} (C : G.Walk r r) (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (h4conn : VertexConnectivityAtLeast G 4) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support) :
    ∃ X : Finset V, u ∈ X ∧ sourceLemma33GoodPath G C K X := by
  classical
  obtain ⟨A⟩ := sourceLemma33_normalized_four_attachments G C hC hgirth h4conn hK D
  choose exit tail hexit htail havoid htailK hsub using
    fun i => sourceLemma33_attachment_tail G C hK D A i
  have hexit_inj : Function.Injective exit := by
    intro i j hij
    by_contra hne
    have hi : exit i ∈ (A.path i : G.Walk (A.src i) (A.dst i)).support :=
      hsub i _ (tail i).start_mem_support
    have hj : exit i ∈ (A.path j : G.Walk (A.src j) (A.dst j)).support := by
      rw [hij]
      exact hsub j _ (tail j).start_mem_support
    exact (Set.disjoint_left.mp (A.disjoint_support hne)) hi hj
  have hexit_ne_dst i : exit i ≠ A.dst i := by
    intro h
    exact hK.disjoint_cycle (exit i) (D.subset_component (hexit i))
      (h.symm ▸ A.dst_mem i)
  have contactPaths (i j : Fin 4) (hij : i ≠ j) :
      ∃ R : G.Walk (A.dst i) (A.dst j), R.IsPath ∧ internalVertices G R ⊆ K ∧
        R.length ≠ (sourceOrientedCycleSubpath G C (A.dst_mem i) (A.dst_mem j)).length := by
    apply sourceLemma33_rooted_route_through_block G C hK D
      (tail i).reverse (tail j) (htail i).reverse (htail j)
      (hexit i) (hexit j) (fun h => hij (hexit_inj h))
    · intro w hw hwe
      exact havoid i w (by simpa using hw) hwe
    · exact havoid j
    · intro w hw hwd
      exact htailK i w (by simpa using hw) hwd
    · exact htailK j
    · intro w hwI hwJ
      exact Set.disjoint_left.mp (A.disjoint_support hij)
        (hsub i w (by simpa using hwI)) (hsub j w hwJ)
  by_cases hnear : ∃ a, a ∈ D.B ∧ D.cut ≠ some a ∧ G.Adj u a
  · obtain ⟨a, haB, haNoncut, hua⟩ := hnear
    have haK := D.subset_component haB
    have hpaths : ∀ i, A.dst i ≠ u → ∀ L : ℕ,
        (L = (sourceOrientedCycleSubpath G C huC (A.dst_mem i)).length ∨
          L = (sourceOrientedCycleSubpath G C (A.dst_mem i) huC).length) →
        ∃ R : G.Walk u (A.dst i), R.IsPath ∧ internalVertices G R ⊆ K ∧ R.length ≠ L := by
      intro i hvu L hL
      by_cases hai : a = exit i
      · have hcut : D.cut ≠ some (exit i) := hai ▸ haNoncut
        have hlen := sourceLemma33_noncut_tail_length G D (tail i) (htail i)
          (hexit i) hcut (hexit_ne_dst i) (havoid i) (htailK i)
        have hav : G.Adj a (A.dst i) := hai.symm ▸ Walk.adj_of_length_eq_one hlen
        obtain ⟨R, hR, hRK, hRlen⟩ := sourceLemma33_two_edge_path G hK haK
          huC (A.dst_mem i) hvu.symm hua.symm hav
        refine ⟨R, hR, hRK, ?_⟩
        have hnotTwo : L ≠ 2 := by
          rcases hL with rfl | rfl
          · exact sourceLemma33_cycle_subpath_length_ne_two G C hC hgirth
              (hK.disjoint_cycle a haK) huC (A.dst_mem i) hvu.symm hua.symm hav
          · exact sourceLemma33_cycle_subpath_length_ne_two G C hC hgirth
              (hK.disjoint_cycle a haK) (A.dst_mem i) huC hvu hav hua.symm
        simpa [hRlen] using hnotTwo.symm
      · let P : G.Walk u a := Walk.cons hua Walk.nil
        have hP : P.IsPath := by simp [P, hua.ne]
        have huNotB : u ∉ D.B := fun h => hK.disjoint_cycle u (D.subset_component h) huC
        have hPavoid : ∀ w, w ∈ P.support → w ≠ a → w ∉ D.B := by
          intro w hw hwa
          have hwu : w = u := by simpa [P, hwa] using hw
          simpa [hwu] using huNotB
        have hPK : ∀ w, w ∈ P.support → w ≠ u → w ∈ K := by
          intro w hw hwu
          have hwa : w = a := by simpa [P, hwu] using hw
          simpa [hwa] using haK
        have hPQ : ∀ w, w ∈ P.support → w ∈ (tail i).support → False := by
          intro w hwP hwQ
          have hw : w = u ∨ w = a := by simpa [P] using hwP
          rcases hw with hwu | hwa
          · subst w
            exact hK.disjoint_cycle u (htailK i u hwQ hvu.symm) huC
          · subst w
            exact havoid i a hwQ hai haB
        exact sourceLemma33_route_through_block_avoids_length G C hK D P (tail i) hP (htail i)
          haB (hexit i) hai hPavoid (havoid i) hPK (htailK i) hPQ L
    let I : Finset (Fin 4) := if h : ∃ i, A.dst i = u then
      Finset.univ.erase (Classical.choose h) else Finset.univ.erase 0
    have hI : I.card = 3 := by dsimp [I]; split_ifs <;> simp
    have hne : ∀ i ∈ I, A.dst i ≠ u := by
      intro i hi heq
      dsimp [I] at hi
      split_ifs at hi with h
      · exact (Finset.ne_of_mem_erase hi) (A.dst_injective
          (heq.trans (Classical.choose_spec h).symm))
      · exact h ⟨i, heq⟩
    exact sourceLemma33_good_path_of_contacts G C hK D A huBoundary huC I hI hne
      (fun i _ j _ hij => contactPaths i j hij) (fun i hi => hpaths i (hne i hi))
  · obtain ⟨u', hu'K, huu'⟩ := huBoundary
    let Z := sourceLemma33_endblock_anchor G hK.connected D hu'K
    obtain ⟨P₀, hP₀, hP₀K⟩ := sourceLemma33_path_to_component_vertex G hK
      ⟨u', hu'K, huu'⟩ huC (D.subset_component Z.anchor_mem)
    obtain ⟨a, P, hP, haB, hPavoid, hPsub⟩ := sourceLemma33_first_block_hit G D
      P₀ hP₀ Z.anchor_mem
    have hPK : ∀ w, w ∈ P.support → w ≠ u → w ∈ K := by
      intro w hw hwu
      by_cases hwZ : w = Z.anchor
      · exact hwZ.symm ▸ D.subset_component Z.anchor_mem
      · exact hP₀K ⟨hPsub w hw, hwu, hwZ⟩
    have hua : u ≠ a := fun h => hK.disjoint_cycle a (D.subset_component haB) (h ▸ huC)
    have hcut : D.cut = some a := by
      apply Classical.byContradiction
      intro hcut_ne
      have hadj := P.adj_penultimate (Walk.not_nil_of_ne hua)
      have hsP := P.getVert_mem_support (P.length - 1)
      have hsB : P.penultimate ∉ D.B := hPavoid _ hsP hadj.ne
      by_cases hsu : P.penultimate = u
      · exact hnear ⟨a, haB, hcut_ne, hsu ▸ hadj⟩
      · exact hsB (D.noncut_closed haB hcut_ne hadj.symm (hPK _ hsP hsu))
    let I : Finset (Fin 4) := if h : ∃ i, exit i = a then
      Finset.univ.erase (Classical.choose h) else Finset.univ.erase 0
    have hI : I.card = 3 := by dsimp [I]; split_ifs <;> simp
    have hexit_ne : ∀ i ∈ I, exit i ≠ a := by
      intro i hi heq
      dsimp [I] at hi
      split_ifs at hi with h
      · exact (Finset.ne_of_mem_erase hi) (hexit_inj
          (heq.trans (Classical.choose_spec h).symm))
      · exact h ⟨i, heq⟩
    have hnoncut i (hi : i ∈ I) : D.cut ≠ some (exit i) := by
      rw [hcut]
      intro h
      exact hexit_ne i hi (Option.some.inj h).symm
    have hadj i (hi : i ∈ I) : G.Adj (exit i) (A.dst i) :=
      Walk.adj_of_length_eq_one (sourceLemma33_noncut_tail_length G D (tail i) (htail i)
        (hexit i) (hnoncut i hi) (hexit_ne_dst i) (havoid i) (htailK i))
    have hne i (hi : i ∈ I) : A.dst i ≠ u := by
      intro h
      exact hnear ⟨exit i, hexit i, hnoncut i hi, h ▸ (hadj i hi).symm⟩
    apply sourceLemma33_good_path_of_contacts G C hK D A
      ⟨u', hu'K, huu'⟩ huC I hI hne (fun i _ j _ hij => contactPaths i j hij)
    intro i hi L hL
    let Q : G.Walk (exit i) (A.dst i) := Walk.cons (hadj i hi) Walk.nil
    have hQ : Q.IsPath := by simp [Q, (hadj i hi).ne]
    have hQavoid : ∀ w, w ∈ Q.support → w ≠ exit i → w ∉ D.B := by
      intro w hw hwb
      have hwv : w = A.dst i := by simpa [Q, hwb] using hw
      subst w
      exact fun h => hK.disjoint_cycle _ (D.subset_component h) (A.dst_mem i)
    have hQK : ∀ w, w ∈ Q.support → w ≠ A.dst i → w ∈ K := by
      intro w hw hwv
      have hwb : w = exit i := by simpa [Q, hwv] using hw
      exact hwb.symm ▸ D.subset_component (hexit i)
    have hPQ : ∀ w, w ∈ P.support → w ∈ Q.support → False := by
      intro w hwP hwQ
      have hw : w = exit i ∨ w = A.dst i := by simpa [Q] using hwQ
      rcases hw with rfl | rfl
      · exact hPavoid _ hwP (hexit_ne i hi) (hexit i)
      · exact hK.disjoint_cycle _ (hPK _ hwP (hne i hi)) (A.dst_mem i)
    exact sourceLemma33_route_through_block_avoids_length G C hK D P Q hP hQ
      haB (hexit i) (hexit_ne i hi).symm hPavoid hQavoid hPK hQK hPQ L

/-- Endblock construction of three genuine root-to-cycle replacement paths.
A direct non-cut root entry can use all normalized exits. Otherwise the root
prefix enters at the cut and the other three exits are direct cycle edges. -/
private theorem sourceLemma33_endblock_rooted_paths [Fintype V] [DecidableEq V]
    {r u : V} (C : G.Walk r r) (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (h4conn : VertexConnectivityAtLeast G 4) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (D : SourceLemma33EndblockData G K)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support) :
    ∃ X : Finset V, sourceLemma33RootGoodPath G C K u X := by
  obtain ⟨X, huX, hgood⟩ := sourceLemma33_endblock_good_paths
    G C hC hgirth h4conn hK D huBoundary huC
  exact ⟨X, sourceLemma33_good_path_root G C huX hgood⟩

/-- A high-contact component vertex with two unequal simple routes from the
prescribed contact supplies the full ordered-pair good-four-set property.
The chosen route can avoid either orientation's length independently. -/
theorem sourceLemma33_high_cycle_degree_two_routes_good_path
    [Fintype V] [DecidableEq V] {r u z : V} (C : G.Walk r r) (K : Set V)
    (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (hK : SourceLemma33ComponentData G C K)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support)
    (hzK : z ∈ K) (hfour : 4 ≤ (sourceLemma33CycleNeighbours G C z).card)
    (P Q : G.Walk u z) (hP : P.IsPath) (hQ : Q.IsPath)
    (hPK : internalVertices G P ⊆ K) (hQK : internalVertices G Q ⊆ K)
    (hneq : P.length ≠ Q.length) :
    ∃ X : Finset V, u ∈ X ∧ sourceLemma33GoodPath G C K X := by
  classical
  let S := sourceLemma33CycleNeighbours G C z
  by_cases huS : u ∈ S
  · obtain ⟨X, hXcard, huX, hXS, _⟩ := sourceLemma33_select_good_four_containing
      G C K hC hgirth hK hzK hfour huS
    exact ⟨X, huX, sourceLemma33_good_of_four_cycle_neighbours_path
      G C K hC hgirth hK hzK X hXcard hXS⟩
  · obtain ⟨T, hTS, hTcard⟩ := S.exists_subset_card_eq (by simpa [S] using
      (le_trans (by decide : 3 ≤ 4) hfour))
    have huT : u ∉ T := fun h => huS (hTS h)
    let X := insert u T
    have hXcard : X.card = 4 := by simp [X, Finset.card_insert_of_not_mem huT, hTcard]
    have huX : u ∈ X := by simp [X]
    have hmem : ∀ a, a ∈ X → a ∈ sourceGraphNeighbourhood G K ∧ a ∈ C.support := by
      intro a ha
      rcases Finset.mem_insert.mp ha with rfl | ha
      · exact ⟨huBoundary, huC⟩
      · obtain ⟨haC, hza⟩ := (mem_sourceLemma33CycleNeighbours G C z a).mp (hTS ha)
        exact ⟨⟨z, hzK, hza.symm⟩, haC⟩
    have rootRoute (v : V) (hv : v ∈ T) (L : ℕ) :
        ∃ R : G.Walk u v, R.IsPath ∧ internalVertices G R ⊆ K ∧ R.length ≠ L := by
      obtain ⟨hvC, hzv⟩ := (mem_sourceLemma33CycleNeighbours G C z v).mp (hTS hv)
      have hvu : v ≠ u := fun h => huT (h ▸ hv)
      have hPpath := sourceLemma33_concat_to_cycle_isPath G hK P hP hPK hzK hvC hvu hzv
      have hQpath := sourceLemma33_concat_to_cycle_isPath G hK Q hQ hQK hzK hvC hvu hzv
      have hPinside := sourceLemma33_path_via_component_vertex_internal G P hPK hzK hzv
      have hQinside := sourceLemma33_path_via_component_vertex_internal G Q hQK hzK hzv
      by_cases hbad : (P.concat hzv).length = L
      · refine ⟨Q.concat hzv, hQpath, hQinside, ?_⟩
        intro h
        apply hneq
        have hPsum : (P.concat hzv).length = P.length + 1 := Walk.length_concat _ _
        have hQsum : (Q.concat hzv).length = Q.length + 1 := Walk.length_concat _ _
        omega
      · exact ⟨P.concat hzv, hPpath, hPinside, hbad⟩
    refine ⟨X, huX, hXcard, hmem, ?_⟩
    intro a ha b hb hab
    rcases Finset.mem_insert.mp ha with rfl | haT
    · have hbT := (Finset.mem_insert.mp hb).resolve_left hab.symm
      simpa using rootRoute b hbT (sourceOrientedCycleSubpath G C huC (hmem b hb).2).length
    · rcases Finset.mem_insert.mp hb with rfl | hb
      · obtain ⟨R, hR, hRK, hlength⟩ := rootRoute a haT
          (sourceOrientedCycleSubpath G C (hmem a (Finset.mem_insert_of_mem haT)).2 huC).length
        refine ⟨R.reverse, hR.reverse, ?_, ?_⟩
        · intro w hw
          have hwR : w ∈ R.support := by simpa using hw.1
          exact hRK ⟨hwR, hw.2.2, hw.2.1⟩
        · simpa using hlength
      · obtain ⟨haC, hza⟩ := (mem_sourceLemma33CycleNeighbours G C z a).mp (hTS haT)
        obtain ⟨hbC, hzb⟩ := (mem_sourceLemma33CycleNeighbours G C z b).mp (hTS hb)
        obtain ⟨R, hR, hRK, hlength⟩ := sourceLemma33_two_edge_path G hK hzK haC hbC hab hza hzb
        refine ⟨R, hR, hRK, ?_⟩
        simpa [hlength] using (sourceLemma33_cycle_subpath_length_ne_two G C hC hgirth
          (hK.disjoint_cycle z hzK) haC hbC hab hza hzb).symm

/-- Under the original source hypotheses, the low-cycle-neighbour branch
already has the full, source-faithful good-four-set path conclusion. -/
theorem sourceLemma33_complete_good_path_low_cycle_degree
    [Fintype V] [DecidableEq V] {r u : V} (C : G.Walk r r)
    (hC : C.IsCycle) (hgirth : 5 ≤ G.girth) (h4conn : VertexConnectivityAtLeast G 4)
    {K : Set V} (hK : SourceLemma33ComponentData G C K)
    (hdegree : ∀ v : V, 6 ≤ G.degree v)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support)
    (hsmall : ∀ z, z ∈ K → (sourceLemma33CycleNeighbours G C z).card ≤ 3) :
    ∃ X : Finset V, u ∈ X ∧ sourceLemma33GoodPath G C K X := by
  let D := sourceLemma33_endblock_of_source_context G C hK hdegree hsmall
  exact sourceLemma33_endblock_good_paths G C hC hgirth h4conn hK D huBoundary huC

/-- Root-specific simple replacements under the original source Lemma 3.3
hypotheses, for use on root-incident shadow K4 edges in Lemma 3.9. -/
private theorem sourceLemma33_rooted_paths_complete [Fintype V] [DecidableEq V]
    {r u : V} (C : G.Walk r r) (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (h4conn : VertexConnectivityAtLeast G 4) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (hdegree : ∀ v : V, 6 ≤ G.degree v)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support) :
    ∃ X : Finset V, sourceLemma33RootGoodPath G C K u X := by
  classical
  by_cases hlarge : ∃ z, z ∈ K ∧ 4 ≤ (sourceLemma33CycleNeighbours G C z).card
  · obtain ⟨z, hzK, hfour⟩ := hlarge
    exact sourceLemma33_high_cycle_degree_rooted_paths G C K hC hgirth hK huBoundary huC hzK hfour
  · have hsmall : ∀ z, z ∈ K → (sourceLemma33CycleNeighbours G C z).card ≤ 3 := by
      intro z hzK
      by_contra hnot
      exact hlarge ⟨z, hzK, by omega⟩
    let D := sourceLemma33_endblock_of_source_context G C hK hdegree hsmall
    exact sourceLemma33_endblock_rooted_paths G C hC hgirth h4conn hK D huBoundary huC

/-- Retain the old walk-valued good-set interface on the very same four-set.
This deliberately forgets path simplicity only in the legacy certificate. -/
private theorem sourceLemma33_root_good_forget [Fintype V] [DecidableEq V]
    {r u : V} (C : G.Walk r r) {K : Set V}
    (hK : SourceLemma33ComponentData G C K) (X : Finset V)
    (hgood : sourceLemma33RootGoodPath G C K u X) :
    sourceLemma33Good G C K X := by
  classical
  obtain ⟨hcard, huX, hmem, _⟩ := hgood
  refine ⟨hcard, hmem, ?_⟩
  intro a ha b hb hab
  obtain ⟨z, hzK, hbz⟩ := (hmem b hb).1
  obtain ⟨P, hP, hPK⟩ := sourceLemma33_path_to_component_vertex G hK
    (hmem a ha).1 (hmem a ha).2 hzK
  cases P with
  | nil => exact (hK.disjoint_cycle a hzK (hmem a ha).2).elim
  | @cons a x z hax R =>
      let Q : G.Walk a b := (Walk.cons hax R).concat hbz.symm
      have hQK : internalVertices G Q ⊆ K :=
        sourceLemma33_path_via_component_vertex_internal G _ hPK hzK hbz.symm
      have hxK : x ∈ K := by
        by_cases hxz : x = z
        · exact hxz.symm ▸ hzK
        · exact hPK ⟨by simp, hax.ne.symm, hxz⟩
      by_cases hneq : Q.length ≠
          (sourceOrientedCycleSubpath G C (hmem a ha).2 (hmem b hb).2).length
      · exact ⟨Q, hQK, Or.inl hneq⟩
      · let Q' : G.Walk a b := Walk.cons hax (Walk.cons hax.symm Q)
        refine ⟨Q', ?_, Or.inl ?_⟩
        · intro w hw
          have hwSupport : w = a ∨ w = x ∨ w ∈ Q.support := by
            simpa [Q'] using hw.1
          rcases hwSupport with hwa | hwx | hwQ
          · exact (hw.2.1 hwa).elim
          · exact hwx.symm ▸ hxK
          · exact hQK ⟨hwQ, hw.2.1, hw.2.2⟩
        · have hlen : Q'.length = Q.length + 2 := by simp [Q']
          push_neg at hneq
          omega

/-- Source Lemma 3.3: every prescribed cycle boundary vertex belongs to a
good four-set.  A high cycle-neighbour degree supplies the set directly; the
complementary low-neighbour case uses finite endblock descent and ordinary
four-way Menger attachments. -/
private theorem sourceLemma33_complete [Fintype V] [DecidableEq V]
    {r u : V} (C : G.Walk r r) (hC : C.IsCycle) (hgirth : 5 ≤ G.girth)
    (h4conn : VertexConnectivityAtLeast G 4) {K : Set V}
    (hK : SourceLemma33ComponentData G C K)
    (hminimumDegree : ∀ v : V, 6 ≤ G.degree v)
    (huBoundary : u ∈ sourceGraphNeighbourhood G K) (huC : u ∈ C.support) :
    ∃ X : Finset V, X.card = 4 ∧ u ∈ X ∧ sourceLemma33Good G C K X := by
  classical
  by_cases hlarge : ∃ z, z ∈ K ∧ 4 ≤ (sourceLemma33CycleNeighbours G C z).card
  · obtain ⟨z, hzK, hfour⟩ := hlarge
    exact sourceLemma33_good_of_high_cycle_degree G C K hC hgirth hK
      huBoundary huC hzK hfour
  · have hsmall : ∀ z, z ∈ K → (sourceLemma33CycleNeighbours G C z).card ≤ 3 := by
      intro z hzK
      by_contra hnot
      apply hlarge
      refine ⟨z, hzK, ?_⟩
      omega
    let D := sourceLemma33_endblock_of_source_context G C hK hminimumDegree hsmall
    exact sourceLemma33_good_of_endblock_containing G C hC hgirth h4conn hK
      huBoundary huC D

/-- A genuine chord of a source cycle: an ambient graph edge whose endpoints
are on the cycle but which is not one of its cycle edges.  This intentionally
does not introduce any planar or embedding data. -/
private structure SourceLemma34Chord [DecidableEq V] {r : V}
    (C : G.Walk r r) where
  fst : V
  snd : V
  fst_mem : fst ∈ C.support
  snd_mem : snd ∈ C.support
  adj : G.Adj fst snd
  not_cycle_edge : s(fst, snd) ∉ C.edges

/-- The undirected edge represented by a genuine chord. -/
private def SourceLemma34Chord.edge [DecidableEq V] {r : V}
    {C : G.Walk r r} (e : SourceLemma34Chord G C) : Sym2 V :=
  s(e.fst, e.snd)

/-- The directed cycle subpath contains only edges of the original cycle. -/
private theorem sourceLemma34_oriented_subpath_edges_subset [DecidableEq V]
    {r a b : V} (C : G.Walk r r)
    (ha : a ∈ C.support) (hb : b ∈ C.support) :
    ∀ e, e ∈ (sourceOrientedCycleSubpath G C ha hb).edges → e ∈ C.edges := by
  intro e he
  have hbRotate : b ∈ (C.rotate ha).support := by
    rw [← C.take_spec ha, Walk.mem_support_append_iff] at hb
    dsimp [Walk.rotate]
    rw [Walk.mem_support_append_iff]
    exact hb.symm
  have htake :
      (sourceOrientedCycleSubpath G C ha hb).append
          ((C.rotate ha).dropUntil b hbRotate) = C.rotate ha := by
    dsimp [sourceOrientedCycleSubpath]
    exact (C.rotate ha).take_spec hbRotate
  have heRotate : e ∈ (C.rotate ha).edges := by
    rw [← htake, Walk.edges_append, List.mem_append]
    exact Or.inl he
  exact (C.rotate_edges ha).mem_iff.mp heRotate

/-- Reverse a genuine chord without changing its underlying undirected edge. -/
private def SourceLemma34Chord.symm [DecidableEq V] {r : V}
    {C : G.Walk r r} (e : SourceLemma34Chord G C) : SourceLemma34Chord G C where
  fst := e.snd
  snd := e.fst
  fst_mem := e.snd_mem
  snd_mem := e.fst_mem
  adj := e.adj.symm
  not_cycle_edge := by
    intro h
    apply e.not_cycle_edge
    simpa only [Sym2.eq_swap] using h


/-- A chosen directed side of a chord.  Its only graph-theoretic content is
that it is a simple path through cycle edges; no embedding is represented. -/
private structure SourceLemma34ChordSide [DecidableEq V] {r : V}
    (C : G.Walk r r) (e : SourceLemma34Chord G C) where
  path : G.Walk e.fst e.snd
  isPath : path.IsPath
  edges_subset : ∀ edge, edge ∈ path.edges → edge ∈ C.edges

/-- The existing directed cycle subpath supplies the canonical chord side. -/
private noncomputable def sourceLemma34_canonical_side [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (e : SourceLemma34Chord G C) : SourceLemma34ChordSide G C e where
  path := sourceOrientedCycleSubpath G C e.fst_mem e.snd_mem
  isPath := sourceLemma33_oriented_subpath_isPath G C hC e.fst_mem e.snd_mem
  edges_subset := sourceLemma34_oriented_subpath_edges_subset G C e.fst_mem e.snd_mem


/-- The second chord endpoint remains on the cycle after rotating its boundary
walk to the first endpoint. -/
private theorem sourceLemma34_snd_mem_rotate [DecidableEq V]
    {r : V} (C : G.Walk r r) (e : SourceLemma34Chord G C) :
    e.snd ∈ (C.rotate e.fst_mem).support := by
  have hsplit : (C.takeUntil e.fst e.fst_mem).append
      (C.dropUntil e.fst e.fst_mem) = C :=
    C.take_spec e.fst_mem
  have hsndSplit : e.snd ∈ (C.takeUntil e.fst e.fst_mem).support ∨
      e.snd ∈ (C.dropUntil e.fst e.fst_mem).support := by
    rw [← Walk.mem_support_append_iff, hsplit]
    exact e.snd_mem
  dsimp [Walk.rotate]
  rw [Walk.mem_support_append_iff]
  exact hsndSplit.symm

/-- The forward chord side is the first segment of the cycle rotated to the
first endpoint. -/
private noncomputable def sourceLemma34_forwardSide [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (e : SourceLemma34Chord G C) : SourceLemma34ChordSide G C e := by
  let R : G.Walk e.fst e.fst := C.rotate e.fst_mem
  have hsndR : e.snd ∈ R.support := sourceLemma34_snd_mem_rotate G C e
  let Q : G.Walk e.fst e.snd := R.takeUntil e.snd hsndR
  have hQpath : Q.IsPath := by
    dsimp [Q]
    exact (hC.rotate e.fst_mem).isPath_takeUntil hsndR
  have hQedges : ∀ edge, edge ∈ Q.edges → edge ∈ C.edges := by
    intro edge hedge
    have hedgeR : edge ∈ R.edges := by
      apply R.edges_takeUntil_subset hsndR
      exact hedge
    dsimp [R] at hedgeR
    exact (C.rotate_edges e.fst_mem).mem_iff.mp hedgeR
  exact ⟨Q, hQpath, hQedges⟩

/-- The backward chord side is the reverse of the complementary cycle segment
from the same rotation. -/
private noncomputable def sourceLemma34_backwardSide [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (e : SourceLemma34Chord G C) : SourceLemma34ChordSide G C e := by
  let R : G.Walk e.fst e.fst := C.rotate e.fst_mem
  have hsndR : e.snd ∈ R.support := sourceLemma34_snd_mem_rotate G C e
  let Q : G.Walk e.fst e.snd := R.takeUntil e.snd hsndR
  let P : G.Walk e.snd e.fst := R.dropUntil e.snd hsndR
  have hsplit : Q.append P = R := by
    dsimp [Q, P]
    exact R.take_spec hsndR
  have hPpath : P.IsPath := by
    refine Walk.IsCycle.isPath_of_append_right (p := Q) (q := P)
      (Walk.not_nil_of_ne e.adj.ne) ?_
    rw [hsplit]
    dsimp [R]
    exact hC.rotate e.fst_mem
  have hPedges : ∀ edge, edge ∈ P.edges → edge ∈ C.edges := by
    intro edge hedge
    have hedgeR : edge ∈ R.edges := by
      apply R.edges_dropUntil_subset hsndR
      exact hedge
    dsimp [R] at hedgeR
    exact (C.rotate_edges e.fst_mem).mem_iff.mp hedgeR
  refine ⟨P.reverse, hPpath.reverse, ?_⟩
  intro edge hedge
  rw [Walk.edges_reverse, List.mem_reverse] at hedge
  exact hPedges edge hedge

/-- The two complementary directed sides of a chord, both oriented from its
first endpoint to its second. -/
private noncomputable def sourceLemma34_orientedSide [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (e : SourceLemma34Chord G C) (dir : Bool) : SourceLemma34ChordSide G C e :=
  if dir then sourceLemma34_backwardSide G C hC e
  else sourceLemma34_forwardSide G C hC e

/-- The forward side retains the existing directed canonical cycle subpath. -/
private theorem sourceLemma34_forwardSide_eq_canonical [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (e : SourceLemma34Chord G C) :
    (sourceLemma34_forwardSide G C hC e).path =
      (sourceLemma34_canonical_side G C hC e).path := by
  rfl

/-- The two oriented sides of a chord meet only at the chord endpoints. -/
private theorem sourceLemma34_orientedSide_support_intersection [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (e : SourceLemma34Chord G C) (x : V)
    (hx0 : x ∈ (sourceLemma34_orientedSide G C hC e false).path.support)
    (hx1 : x ∈ (sourceLemma34_orientedSide G C hC e true).path.support) :
    x = e.fst ∨ x = e.snd := by
  let R : G.Walk e.fst e.fst := C.rotate e.fst_mem
  have hsndR : e.snd ∈ R.support := sourceLemma34_snd_mem_rotate G C e
  let Q : G.Walk e.fst e.snd := R.takeUntil e.snd hsndR
  let P : G.Walk e.snd e.fst := R.dropUntil e.snd hsndR
  let B : G.Walk e.fst e.snd := P.reverse
  have hsplit : Q.append P = R := by
    dsimp [Q, P]
    exact R.take_spec hsndR
  have hQeq : Q = (sourceLemma34_orientedSide G C hC e false).path := by
    rfl
  have hBeq : B = (sourceLemma34_orientedSide G C hC e true).path := by
    rfl
  rw [← hQeq] at hx0
  rw [← hBeq] at hx1
  by_cases hfst : x = e.fst
  · exact Or.inl hfst
  by_cases hsnd : x = e.snd
  · exact Or.inr hsnd
  have hsplitNodup : (Q.support.tail ++ P.support.tail).Nodup := by
    rw [← Walk.tail_support_append, hsplit]
    dsimp [R]
    exact (hC.rotate e.fst_mem).support_nodup
  have hsplitDisjoint : Q.support.tail.Disjoint P.support.tail :=
    List.disjoint_of_nodup_append hsplitNodup
  have hxQtail : x ∈ Q.support.tail :=
    ((Q.mem_support_iff).mp hx0).resolve_left hfst
  have hxP : x ∈ P.support := by
    dsimp [B] at hx1
    rw [Walk.support_reverse, List.mem_reverse] at hx1
    exact hx1
  have hxPtail : x ∈ P.support.tail :=
    ((P.mem_support_iff).mp hxP).resolve_left hsnd
  exact (List.disjoint_left.mp hsplitDisjoint hxQtail hxPtail).elim

/-- The complementary arcs from one cycle rotation leave the chord endpoint
through its two distinct cycle neighbours. -/
private theorem sourceLemma34_orientedSide_snd_ne [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (e : SourceLemma34Chord G C) :
    (sourceLemma34_orientedSide G C hC e false).path.snd ≠
      (sourceLemma34_orientedSide G C hC e true).path.snd := by
  let R : G.Walk e.fst e.fst := C.rotate e.fst_mem
  have hsndR : e.snd ∈ R.support := sourceLemma34_snd_mem_rotate G C e
  let Q : G.Walk e.fst e.snd := R.takeUntil e.snd hsndR
  let P : G.Walk e.snd e.fst := R.dropUntil e.snd hsndR
  let B : G.Walk e.fst e.snd := P.reverse
  have hQeq : Q = (sourceLemma34_orientedSide G C hC e false).path := by
    rfl
  have hBeq : B = (sourceLemma34_orientedSide G C hC e true).path := by
    rfl
  intro hEq
  have hQnonempty : ¬ Q.Nil := Walk.not_nil_of_ne e.adj.ne
  have hQnotfst : Q.snd ≠ e.fst := (Q.adj_snd hQnonempty).ne.symm
  have hEq' : Q.snd = B.snd :=
    (congrArg Walk.snd hQeq).trans (hEq.trans (congrArg Walk.snd hBeq).symm)
  have hmemQ : Q.snd ∈ Q.support := Q.getVert_mem_support 1
  have hmemB : Q.snd ∈ B.support := by
    rw [hEq']
    exact B.getVert_mem_support 1
  rcases sourceLemma34_orientedSide_support_intersection G C hC e Q.snd
    (by simpa [hQeq] using hmemQ) (by simpa [hBeq] using hmemB) with hfst | hsnd
  · exact hQnotfst hfst
  · have hBsnd : B.snd = e.snd := hEq'.symm.trans hsnd
    obtain ⟨x, hfx, T, hBcons⟩ := Walk.exists_eq_cons_of_ne e.adj.ne B
    have hx : x = e.snd := by
      rw [hBcons] at hBsnd
      simpa using hBsnd
    subst x
    have hedgeB : s(e.fst, e.snd) ∈ B.edges := by
      rw [hBcons]
      simp
    have hedgeSide : s(e.fst, e.snd) ∈
        (sourceLemma34_orientedSide G C hC e true).path.edges := by
      rw [← hBeq]
      exact hedgeB
    exact e.not_cycle_edge
      ((sourceLemma34_orientedSide G C hC e true).edges_subset _ hedgeSide)

/-- A certified chord side lies in the spanning graph of the ambient cycle,
with its simplicity, length, and first successor preserved. -/
private theorem sourceLemma34_transfer_to_cycle [DecidableEq V]
    {r : V} (C : G.Walk r r) (e : SourceLemma34Chord G C)
    (S : SourceLemma34ChordSide G C e) :
    let H : SimpleGraph V := C.toSubgraph.spanningCoe
    ∃ P : H.Walk e.fst e.snd,
      P.IsPath ∧ P.length = S.path.length ∧ P.snd = S.path.snd := by
  dsimp
  let H : SimpleGraph V := C.toSubgraph.spanningCoe
  have hEdges : ∀ edge, edge ∈ S.path.edges → edge ∈ H.edgeSet := by
    intro edge hedge
    change edge ∈ C.toSubgraph.edgeSet
    exact C.mem_edges_toSubgraph.mpr (S.edges_subset edge hedge)
  refine ⟨S.path.transfer H hEdges, S.isPath.transfer hEdges,
    S.path.length_transfer hEdges, ?_⟩
  have snd_transfer : ∀ {a b : V} (p : G.Walk a b)
      (hp : ∀ edge, edge ∈ p.edges → edge ∈ H.edgeSet),
      (p.transfer H hp).snd = p.snd := by
    intro a b p hp
    cases p with
    | nil => rfl
    | cons h p => simp [Walk.transfer]
  exact snd_transfer S.path hEdges

/-- In a degree-two graph, simple paths with equal endpoints and the same
first successor agree.  This is deliberately local to the cycle-side proof. -/
private theorem sourceLemma34_isCycles_path_eq_of_same_snd [Finite V]
    {H : SimpleGraph V} (hH : H.IsCycles) {a b : V} (P Q : H.Walk a b)
    (hP : P.IsPath) (hQ : Q.IsPath) (hab : a ≠ b)
    (hsnd : P.snd = Q.snd) : P = Q := by
  induction P with
  | nil => exact (hab rfl).elim
  | @cons a x b hPX P ih =>
    obtain ⟨y, hQY, Q, hQeq⟩ := Walk.exists_eq_cons_of_ne hab Q
    rw [hQeq] at hQ hsnd ⊢
    simp only [Walk.snd_cons] at hsnd
    subst y
    rw [Walk.cons_isPath_iff] at hP hQ
    by_cases hxb : x = b
    · subst x
      have hPnil : P = Walk.nil := Walk.isPath_iff_eq_nil P |>.mp hP.1
      have hQnil : Q = Walk.nil := Walk.isPath_iff_eq_nil Q |>.mp hQ.1
      subst P
      subst Q
      rfl
    · have hPnonempty : ¬ P.Nil := Walk.not_nil_of_ne hxb
      have hQnonempty : ¬ Q.Nil := Walk.not_nil_of_ne hxb
      have hPback : a ≠ P.snd := by
        intro hback
        apply hP.2
        exact hback ▸ P.getVert_mem_support 1
      have hQback : a ≠ Q.snd := by
        intro hback
        apply hQ.2
        exact hback ▸ Q.getVert_mem_support 1
      obtain ⟨z, hz, huniq⟩ := hH.existsUnique_ne_adj hPX.symm
      have hPsnd : P.snd = z := huniq _ ⟨hPback, P.adj_snd hPnonempty⟩
      have hQsnd : Q.snd = z := huniq _ ⟨hQback, Q.adj_snd hQnonempty⟩
      have htail : P = Q := ih Q hP.1 hQ.1 hxb (hPsnd.trans hQsnd.symm)
      subst Q
      rfl

/-- Every certified chord side has the length of one of the two complementary
cycle sides obtained from the common rotation at its first endpoint. -/
private theorem sourceLemma34_side_length_eq_one_oriented [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (e : SourceLemma34Chord G C) (S : SourceLemma34ChordSide G C e) :
    S.path.length = (sourceLemma34_orientedSide G C hC e false).path.length ∨
      S.path.length = (sourceLemma34_orientedSide G C hC e true).path.length := by
  let H : SimpleGraph V := C.toSubgraph.spanningCoe
  have hH : H.IsCycles := by
    dsimp [H]
    exact hC.isCycles_spanningCoe_toSubgraph
  let F := sourceLemma34_orientedSide G C hC e false
  let B := sourceLemma34_orientedSide G C hC e true
  obtain ⟨P, hPpath, hPlength, hPsnd⟩ := sourceLemma34_transfer_to_cycle G C e S
  obtain ⟨PF, hPFpath, hPFlength, hPFsnd⟩ := sourceLemma34_transfer_to_cycle G C e F
  obtain ⟨PB, hPBpath, hPBlength, hPBsnd⟩ := sourceLemma34_transfer_to_cycle G C e B
  have hPnonempty : ¬ P.Nil := Walk.not_nil_of_ne e.adj.ne
  have hPFnonempty : ¬ PF.Nil := Walk.not_nil_of_ne e.adj.ne
  have hPBnonempty : ¬ PB.Nil := Walk.not_nil_of_ne e.adj.ne
  have hFBsnd : PF.snd ≠ PB.snd := by
    intro h
    exact (sourceLemma34_orientedSide_snd_ne G C hC e)
      (hPFsnd.symm.trans (h.trans hPBsnd))
  obtain ⟨other, _, hotherUnique⟩ :=
    hH.existsUnique_ne_adj (PF.adj_snd hPFnonempty)
  have hPBother : PB.snd = other :=
    hotherUnique _ ⟨hFBsnd, PB.adj_snd hPBnonempty⟩
  have hfirst : P.snd = PF.snd ∨ P.snd = PB.snd := by
    by_cases hPF : P.snd = PF.snd
    · exact Or.inl hPF
    · right
      have hPother : P.snd = other :=
        hotherUnique _ ⟨Ne.symm hPF, P.adj_snd hPnonempty⟩
      exact hPother.trans hPBother.symm
  rcases hfirst with hfirst | hfirst
  · left
    have hpaths : P = PF := sourceLemma34_isCycles_path_eq_of_same_snd
      hH P PF hPpath hPFpath e.adj.ne hfirst
    calc
      S.path.length = P.length := hPlength.symm
      _ = PF.length := congrArg Walk.length hpaths
      _ = F.path.length := hPFlength
      _ = (sourceLemma34_orientedSide G C hC e false).path.length := rfl
  · right
    have hpaths : P = PB := sourceLemma34_isCycles_path_eq_of_same_snd
      hH P PB hPpath hPBpath e.adj.ne hfirst
    calc
      S.path.length = P.length := hPlength.symm
      _ = PB.length := congrArg Walk.length hpaths
      _ = B.path.length := hPBlength
      _ = (sourceLemma34_orientedSide G C hC e true).path.length := rfl
/-- Every certified chord side is exactly one of the two oriented cycle sides.
The equality is obtained in the degree-two cycle subgraph and transferred back
to the ambient graph. -/
private theorem sourceLemma34_side_path_eq_one_oriented [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (e : SourceLemma34Chord G C) (S : SourceLemma34ChordSide G C e) :
    S.path = (sourceLemma34_orientedSide G C hC e false).path ∨
      S.path = (sourceLemma34_orientedSide G C hC e true).path := by
  let H : SimpleGraph V := C.toSubgraph.spanningCoe
  have hH : H.IsCycles := by
    dsimp [H]
    exact hC.isCycles_spanningCoe_toSubgraph
  have hHG : H ≤ G := by
    dsimp [H]
    exact C.toSubgraph.spanningCoe_le
  let F := sourceLemma34_orientedSide G C hC e false
  let B := sourceLemma34_orientedSide G C hC e true
  have hS : ∀ edge, edge ∈ S.path.edges → edge ∈ H.edgeSet := by
    intro edge hedge
    change edge ∈ C.toSubgraph.edgeSet
    exact C.mem_edges_toSubgraph.mpr (S.edges_subset edge hedge)
  have hF : ∀ edge, edge ∈ F.path.edges → edge ∈ H.edgeSet := by
    intro edge hedge
    change edge ∈ C.toSubgraph.edgeSet
    exact C.mem_edges_toSubgraph.mpr (F.edges_subset edge hedge)
  have hB : ∀ edge, edge ∈ B.path.edges → edge ∈ H.edgeSet := by
    intro edge hedge
    change edge ∈ C.toSubgraph.edgeSet
    exact C.mem_edges_toSubgraph.mpr (B.edges_subset edge hedge)
  let P : H.Walk e.fst e.snd := S.path.transfer H hS
  let PF : H.Walk e.fst e.snd := F.path.transfer H hF
  let PB : H.Walk e.fst e.snd := B.path.transfer H hB
  have transfer_snd : ∀ {a b : V} (p : G.Walk a b)
      (hp : ∀ edge, edge ∈ p.edges → edge ∈ H.edgeSet),
      (p.transfer H hp).snd = p.snd := by
    intro a b p hp
    cases p with
    | nil => rfl
    | cons h p => simp [Walk.transfer]
  have hPpath : P.IsPath := by
    dsimp [P]
    exact S.isPath.transfer hS
  have hPFpath : PF.IsPath := by
    dsimp [PF]
    exact F.isPath.transfer hF
  have hPBpath : PB.IsPath := by
    dsimp [PB]
    exact B.isPath.transfer hB
  have hPsnd : P.snd = S.path.snd := by
    dsimp [P]
    exact transfer_snd S.path hS
  have hPFsnd : PF.snd = F.path.snd := by
    dsimp [PF]
    exact transfer_snd F.path hF
  have hPBsnd : PB.snd = B.path.snd := by
    dsimp [PB]
    exact transfer_snd B.path hB
  have hPnonempty : ¬ P.Nil := Walk.not_nil_of_ne e.adj.ne
  have hPFnonempty : ¬ PF.Nil := Walk.not_nil_of_ne e.adj.ne
  have hPBnonempty : ¬ PB.Nil := Walk.not_nil_of_ne e.adj.ne
  have hFBsnd : PF.snd ≠ PB.snd := by
    intro h
    exact (sourceLemma34_orientedSide_snd_ne G C hC e)
      (hPFsnd.symm.trans (h.trans hPBsnd))
  obtain ⟨other, _, hotherUnique⟩ :=
    hH.existsUnique_ne_adj (PF.adj_snd hPFnonempty)
  have hPBother : PB.snd = other :=
    hotherUnique _ ⟨hFBsnd, PB.adj_snd hPBnonempty⟩
  have hfirst : P.snd = PF.snd ∨ P.snd = PB.snd := by
    by_cases hPF : P.snd = PF.snd
    · exact Or.inl hPF
    · right
      have hPother : P.snd = other :=
        hotherUnique _ ⟨Ne.symm hPF, P.adj_snd hPnonempty⟩
      exact hPother.trans hPBother.symm
  have transfer_back : ∀ {a b : V} (p : G.Walk a b)
      (hp : ∀ edge, edge ∈ p.edges → edge ∈ H.edgeSet),
      (p.transfer H hp).mapLe hHG = p := by
    intro a b p hp
    let q : H.Walk a b := p.transfer H hp
    have hq : ∀ edge, edge ∈ q.edges → edge ∈ G.edgeSet := by
      intro edge hedge
      dsimp [q] at hedge
      rw [Walk.edges_transfer] at hedge
      exact p.edges_subset_edgeSet hedge
    calc
      (p.transfer H hp).mapLe hHG = q.mapLe hHG := by rfl
      _ = q.transfer G hq := (q.transfer_eq_map_ofLE hq hHG).symm
      _ = p := by
        dsimp [q]
        rw [Walk.transfer_transfer]
        exact p.transfer_self
  rcases hfirst with hfirst | hfirst
  · left
    have hpaths : P = PF := sourceLemma34_isCycles_path_eq_of_same_snd
      hH P PF hPpath hPFpath e.adj.ne hfirst
    calc
      S.path = P.mapLe hHG := by
        dsimp [P]
        exact (transfer_back S.path hS).symm
      _ = PF.mapLe hHG := congrArg (fun p => p.mapLe hHG) hpaths
      _ = F.path := by
        dsimp [PF, F]
        exact transfer_back
          (sourceLemma34_orientedSide G C hC e false).path hF
      _ = (sourceLemma34_orientedSide G C hC e false).path := rfl
  · right
    have hpaths : P = PB := sourceLemma34_isCycles_path_eq_of_same_snd
      hH P PB hPpath hPBpath e.adj.ne hfirst
    calc
      S.path = P.mapLe hHG := by
        dsimp [P]
        exact (transfer_back S.path hS).symm
      _ = PB.mapLe hHG := congrArg (fun p => p.mapLe hHG) hpaths
      _ = B.path := by
        dsimp [PB, B]
        exact transfer_back
          (sourceLemma34_orientedSide G C hC e true).path hB
      _ = (sourceLemma34_orientedSide G C hC e true).path := rfl


/-- One of the two oriented cycle sides is no longer than any certified side. -/
private theorem sourceLemma34_oriented_side_le_of_side [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (e : SourceLemma34Chord G C) (S : SourceLemma34ChordSide G C e) :
    ∃ dir : Bool,
      (sourceLemma34_orientedSide G C hC e dir).path.length ≤ S.path.length := by
  rcases sourceLemma34_side_length_eq_one_oriented G C hC e S with h | h
  · exact ⟨false, h.symm.le⟩
  · exact ⟨true, h.symm.le⟩

/-- Any certified chord side, closed by its chord, is a simple cycle. -/
private theorem sourceLemma34_side_isCycle [DecidableEq V]
    {r : V} (C : G.Walk r r) (e : SourceLemma34Chord G C)
    (S : SourceLemma34ChordSide G C e) :
    (Walk.cons e.adj.symm (⟨S.path, S.isPath⟩ : G.Path e.fst e.snd)).IsCycle := by
  apply Path.cons_isCycle
  intro hEdge
  apply e.not_cycle_edge
  rw [Sym2.eq_swap]
  exact S.edges_subset _ hEdge
/-- Girth lower-bounds every explicitly certified chord side. -/
private theorem sourceLemma34_side_span [DecidableEq V]
    {r : V} (C : G.Walk r r) (g : ℕ) (hg3 : 3 ≤ g) (hgirth : g ≤ G.girth)
    (e : SourceLemma34Chord G C) (S : SourceLemma34ChordSide G C e) :
    g - 2 ≤ S.path.length - 1 := by
  let Z : G.Walk e.snd e.snd :=
    Walk.cons e.adj.symm (⟨S.path, S.isPath⟩ : G.Path e.fst e.snd)
  have hZcycle : Z.IsCycle := by
    dsimp [Z]
    exact sourceLemma34_side_isCycle G C e S
  have hegirth : G.egirth ≤ Z.length :=
    (SimpleGraph.le_egirth.mp le_rfl) _ _ hZcycle
  have hgirth_le : G.girth ≤ Z.length := by
    rw [SimpleGraph.girth]
    exact ENat.toNat_le_of_le_coe hegirth
  have hlength : Z.length = S.path.length + 1 := by
    dsimp [Z]
  omega

/-- Strict interior of a chosen side, expressed solely by that side path. -/
private def sourceLemma34SideStrictInside [DecidableEq V] {r : V}
    {C : G.Walk r r} {e : SourceLemma34Chord G C}
    (S : SourceLemma34ChordSide G C e) (x : V) : Prop :=
  x ∈ S.path.support ∧ x ≠ e.fst ∧ x ≠ e.snd

/-- Two chords cross when precisely one endpoint of one lies in a canonical
side of the other.  Shared boundary endpoints are deliberately excluded. -/
private def sourceLemma34Crosses [DecidableEq V] {r : V}
    (C : G.Walk r r) (hC : C.IsCycle)
    (e f : SourceLemma34Chord G C) : Prop :=
  ∃ dir : Bool,
    let S := sourceLemma34_orientedSide G C hC e dir
    (sourceLemma34SideStrictInside G S f.fst ∧ f.snd ∉ S.path.support) ∨
      (sourceLemma34SideStrictInside G S f.snd ∧ f.fst ∉ S.path.support)


/-- If the first endpoint of an inner chord occurs before its second endpoint
on a certified side, the intervening suffix is itself a shorter certified
side of that inner chord. -/
private theorem sourceLemma34_side_of_before [DecidableEq V]
    {r : V} (C : G.Walk r r) (e f : SourceLemma34Chord G C)
    (S : SourceLemma34ChordSide G C e)
    (hfst : sourceLemma34SideStrictInside G S f.fst)
    (hsnd : sourceLemma34SideStrictInside G S f.snd)
    (hbefore :
      (S.path.takeUntil f.fst hfst.1).length <
        (S.path.takeUntil f.snd hsnd.1).length) :
    ∃ T : SourceLemma34ChordSide G C f, T.path.length < S.path.length := by
  let Q : G.Walk e.fst f.snd := S.path.takeUntil f.snd hsnd.1
  let pc : ℕ := (S.path.takeUntil f.fst hfst.1).length
  have hpc : S.path.getVert pc = f.fst := by
    change S.path.getVert (S.path.takeUntil f.fst hfst.1).length = f.fst
    calc
      S.path.getVert (S.path.takeUntil f.fst hfst.1).length =
          (S.path.takeUntil f.fst hfst.1).getVert
            (S.path.takeUntil f.fst hfst.1).length :=
        (S.path.getVert_takeUntil hfst.1 le_rfl).symm
      _ = f.fst := Walk.getVert_length _
  have hfQ : f.fst ∈ Q.support := by
    have hget : Q.getVert pc = f.fst := by
      dsimp [Q]
      calc
        (S.path.takeUntil f.snd hsnd.1).getVert pc =
            S.path.getVert pc :=
          S.path.getVert_takeUntil hsnd.1 (by simpa [pc] using hbefore.le)
        _ = f.fst := hpc
    rw [← hget]
    exact Q.getVert_mem_support pc
  let R : G.Walk f.fst f.snd := Q.dropUntil f.fst hfQ
  have hQpath : Q.IsPath := by
    dsimp [Q]
    exact S.isPath.takeUntil hsnd.1
  have hRpath : R.IsPath := by
    dsimp [R]
    exact hQpath.dropUntil hfQ
  have hRedges : ∀ edge, edge ∈ R.edges → edge ∈ C.edges := by
    intro edge hedge
    apply S.edges_subset edge
    apply S.path.edges_takeUntil_subset hsnd.1
    exact Q.edges_dropUntil_subset hfQ hedge
  have hQlt : Q.length < S.path.length := by
    dsimp [Q]
    exact S.path.length_takeUntil_lt hsnd.1 (by simpa using hsnd.2.2)
  have hRle : R.length ≤ Q.length := by
    dsimp [R]
    exact Q.length_dropUntil_le hfQ
  refine ⟨⟨R, hRpath, hRedges⟩, ?_⟩
  exact lt_of_le_of_lt hRle hQlt

/-- A chord with one endpoint in the strict interior of a side and its other
endpoint on that side's boundary has a strictly shorter certified side. -/
private theorem sourceLemma34_boundary_inner_has_shorter_side [DecidableEq V]
    {r : V} (C : G.Walk r r) (e f : SourceLemma34Chord G C)
    (S : SourceLemma34ChordSide G C e)
    (hfst : sourceLemma34SideStrictInside G S f.fst)
    (hsnd : f.snd = e.fst ∨ f.snd = e.snd) :
    (∃ T : SourceLemma34ChordSide G C f, T.path.length < S.path.length) ∨
      (∃ T : SourceLemma34ChordSide G C f.symm, T.path.length < S.path.length) := by
  rcases hsnd with hsnd | hsnd
  · right
    let P : G.Walk e.fst f.fst := S.path.takeUntil f.fst hfst.1
    have hPpath : P.IsPath := by
      dsimp [P]
      exact S.isPath.takeUntil hfst.1
    have hPedges : ∀ edge, edge ∈ P.edges → edge ∈ C.edges := by
      intro edge hedge
      apply S.edges_subset edge
      exact S.path.edges_takeUntil_subset hfst.1 hedge
    have hPlt : P.length < S.path.length := by
      dsimp [P]
      exact S.path.length_takeUntil_lt hfst.1 hfst.2.2
    let Q : G.Walk (f.symm).fst (f.symm).snd :=
      P.copy hsnd.symm rfl
    refine ⟨⟨Q, ?_, ?_⟩, ?_⟩
    · simpa [Q] using hPpath
    · intro edge hedge
      apply hPedges edge
      simpa [Q] using hedge
    · simpa [Q] using hPlt
  · left
    let P : G.Walk e.fst f.fst := S.path.takeUntil f.fst hfst.1
    let Q : G.Walk f.fst e.snd := S.path.dropUntil f.fst hfst.1
    have hQpath : Q.IsPath := by
      dsimp [Q]
      exact S.isPath.dropUntil hfst.1
    have hQedges : ∀ edge, edge ∈ Q.edges → edge ∈ C.edges := by
      intro edge hedge
      apply S.edges_subset edge
      exact S.path.edges_dropUntil_subset hfst.1 hedge
    have hPpos : 0 < P.length := by
      apply Nat.pos_of_ne_zero
      intro hzero
      have hend : P.getVert P.length = f.fst := by
        dsimp [P]
        exact Walk.getVert_length _
      rw [hzero, Walk.getVert_zero] at hend
      exact hfst.2.1 hend.symm
    have hsum : P.length + Q.length = S.path.length := by
      change (S.path.takeUntil f.fst hfst.1).length +
          (S.path.dropUntil f.fst hfst.1).length = S.path.length
      have := congrArg Walk.length (S.path.take_spec hfst.1)
      simpa only [Walk.length_append] using this
    have hQlt : Q.length < S.path.length := by omega
    let R : G.Walk f.fst f.snd := Q.copy rfl hsnd.symm
    refine ⟨⟨R, ?_, ?_⟩, ?_⟩
    · simpa [R] using hQpath
    · intro edge hedge
      apply hQedges edge
      simpa [R] using hedge
    · simpa [R] using hQlt

/-- Two distinct inner endpoints are linearly ordered by their prefix lengths;
in either order their chord has a certified side strictly shorter than the
parent side. -/
private theorem sourceLemma34_nested_chord_has_shorter_side [DecidableEq V]
    {r : V} (C : G.Walk r r) (_hC : C.IsCycle)
    (e f : SourceLemma34Chord G C) (S : SourceLemma34ChordSide G C e)
    (hfst : sourceLemma34SideStrictInside G S f.fst)
    (hsnd : sourceLemma34SideStrictInside G S f.snd) :
    (∃ T : SourceLemma34ChordSide G C f, T.path.length < S.path.length) ∨
      (∃ T : SourceLemma34ChordSide G C f.symm, T.path.length < S.path.length) := by
  rcases lt_trichotomy (S.path.takeUntil f.fst hfst.1).length
    (S.path.takeUntil f.snd hsnd.1).length with hlt | heq | hgt
  · exact Or.inl (sourceLemma34_side_of_before G C e f S hfst hsnd hlt)
  · have hsame : f.fst = f.snd := by
      have hleft : S.path.getVert (S.path.takeUntil f.fst hfst.1).length = f.fst := by
        calc
          S.path.getVert (S.path.takeUntil f.fst hfst.1).length =
              (S.path.takeUntil f.fst hfst.1).getVert
                (S.path.takeUntil f.fst hfst.1).length :=
            (S.path.getVert_takeUntil hfst.1 le_rfl).symm
          _ = f.fst := Walk.getVert_length _
      have hright : S.path.getVert (S.path.takeUntil f.snd hsnd.1).length = f.snd := by
        calc
          S.path.getVert (S.path.takeUntil f.snd hsnd.1).length =
              (S.path.takeUntil f.snd hsnd.1).getVert
                (S.path.takeUntil f.snd hsnd.1).length :=
            (S.path.getVert_takeUntil hsnd.1 le_rfl).symm
          _ = f.snd := Walk.getVert_length _
      exact hleft.symm.trans ((congrArg S.path.getVert heq).trans hright)
    exact (f.adj.ne hsame).elim
  · have hfst' : sourceLemma34SideStrictInside G S (f.symm).fst := by
      exact hsnd
    have hsnd' : sourceLemma34SideStrictInside G S (f.symm).snd := by
      exact hfst
    exact Or.inr (sourceLemma34_side_of_before G C e f.symm S hfst' hsnd' hgt)


/-- Each directed side of a genuine chord, closed by that chord, is a cycle. -/
private theorem sourceLemma34_chord_arc_isCycle [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (e : SourceLemma34Chord G C) :
    (Walk.cons e.adj.symm
      (⟨sourceOrientedCycleSubpath G C e.fst_mem e.snd_mem,
        sourceLemma33_oriented_subpath_isPath G C hC e.fst_mem e.snd_mem⟩ :
          G.Path e.fst e.snd)).IsCycle := by
  exact sourceLemma34_side_isCycle G C e (sourceLemma34_canonical_side G C hC e)

/-- Girth gives the exact integer span lower bound for either directed side
of a genuine chord. -/
private theorem sourceLemma34_chord_arc_span [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (g : ℕ) (hg3 : 3 ≤ g) (hgirth : g ≤ G.girth)
    (e : SourceLemma34Chord G C) :
    g - 2 ≤ (sourceOrientedCycleSubpath G C e.fst_mem e.snd_mem).length - 1 := by
  simpa [sourceLemma34_canonical_side] using
    (sourceLemma34_side_span G C g hg3 hgirth e
      (sourceLemma34_canonical_side G C hC e))

/-- A vertex is strictly inside the directed a--b cycle arc when it is
on that arc but is neither endpoint. -/
private def sourceLemma34StrictInside [DecidableEq V] {r a b : V}
    (C : G.Walk r r) (ha : a ∈ C.support) (hb : b ∈ C.support) (x : V) : Prop :=
  x ∈ (sourceOrientedCycleSubpath G C ha hb).support ∧ x ≠ a ∧ x ≠ b

/-- The local linear coordinate of a vertex on an arc: its prefix length from
the fixed arc start. -/
private noncomputable def sourceLemma34Position [DecidableEq V] {r a x : V}
    (C : G.Walk r r) (ha : a ∈ C.support) (hx : x ∈ C.support) : ℕ :=
  (sourceOrientedCycleSubpath G C ha hx).length

/-- Taking a prefix of the a--b arc is exactly the directed a--x cycle
subpath. This is the proof-local positional bridge and uses nested takeUntil. -/
private theorem sourceLemma34_oriented_subpath_takeUntil [DecidableEq V]
    {r a b x : V} (C : G.Walk r r)
    (ha : a ∈ C.support) (hb : b ∈ C.support) (hx : x ∈ C.support)
    (hxQ : x ∈ (sourceOrientedCycleSubpath G C ha hb).support) :
    (sourceOrientedCycleSubpath G C ha hb).takeUntil x hxQ =
      sourceOrientedCycleSubpath G C ha hx := by
  let R : G.Walk a a := C.rotate ha
  have hbR : b ∈ R.support := by
    dsimp [R]
    rw [← C.take_spec ha, Walk.mem_support_append_iff] at hb
    dsimp [Walk.rotate]
    rw [Walk.mem_support_append_iff]
    exact hb.symm
  have hxR : x ∈ R.support := by
    dsimp [R]
    rw [← C.take_spec ha, Walk.mem_support_append_iff] at hx
    dsimp [Walk.rotate]
    rw [Walk.mem_support_append_iff]
    exact hx.symm
  have hQ : sourceOrientedCycleSubpath G C ha hb = R.takeUntil b hbR := by
    dsimp [sourceOrientedCycleSubpath, R]
  have hX : sourceOrientedCycleSubpath G C ha hx = R.takeUntil x hxR := by
    dsimp [sourceOrientedCycleSubpath, R]
  change (R.takeUntil b hbR).takeUntil x _ = R.takeUntil x hxR
  exact R.takeUntil_takeUntil hbR (by simpa [hQ] using hxQ)

/-- Position is bounded by the containing arc length. -/
private theorem sourceLemma34_position_le [DecidableEq V]
    {r a b x : V} (C : G.Walk r r)
    (ha : a ∈ C.support) (hb : b ∈ C.support) (hx : x ∈ C.support)
    (hxQ : x ∈ (sourceOrientedCycleSubpath G C ha hb).support) :
    sourceLemma34Position G C ha hx ≤
      (sourceOrientedCycleSubpath G C ha hb).length := by
  change (sourceOrientedCycleSubpath G C ha hx).length ≤ _
  rw [← sourceLemma34_oriented_subpath_takeUntil G C ha hb hx hxQ]
  exact (sourceOrientedCycleSubpath G C ha hb).length_takeUntil_le hxQ

/-- A nonterminal vertex of an arc has strictly smaller position. -/
