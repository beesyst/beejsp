/-- `takeUntil` visits exactly the prefix ending at its first target occurrence. -/
private theorem sourceLemma36_support_takeUntil_eq_take_indexOf [DecidableEq V]
    {u v : V} (P : G.Walk u v) (x : V) (hx : x ∈ P.support) :
    (P.takeUntil x hx).support = P.support.take (P.support.idxOf x + 1) := by
  induction P with
  | nil =>
    simp only [Walk.support_nil, List.mem_singleton] at hx
    subst x
    simp [Walk.takeUntil]
  | @cons u v w h P ih =>
    simp only [Walk.support_cons, List.mem_cons] at hx
    by_cases hux : u = x
    · subst x
      simp [Walk.takeUntil]
    · have hxP : x ∈ P.support := hx.resolve_left (fun h => hux h.symm)
      rw [Walk.takeUntil_cons hxP hux h, Walk.support_cons, ih hxP]
      simp [List.idxOf_cons_ne _ hux]

/-- `dropUntil` is the matching suffix beginning at the first target occurrence. -/
private theorem sourceLemma36_support_dropUntil_eq_drop_indexOf [DecidableEq V]
    {u v : V} (P : G.Walk u v) (x : V) (hx : x ∈ P.support) :
    (P.dropUntil x hx).support = P.support.drop (P.support.idxOf x) := by
  induction P with
  | nil =>
    simp only [Walk.support_nil, List.mem_singleton] at hx
    subst x
    simp [Walk.dropUntil]
  | @cons u v w h P ih =>
    simp only [Walk.support_cons, List.mem_cons] at hx
    by_cases hux : u = x
    · subst x
      simp [Walk.dropUntil]
    · have hxP : x ∈ P.support := hx.resolve_left (fun h => hux h.symm)
      rw [Walk.dropUntil]
      simp only [dif_neg hux]
      rw [ih hxP, Walk.support_cons]
      simp [List.idxOf_cons_ne _ hux]

/-- The endpoint at `idxOf` is included when a list prefix is extended by one. -/
private theorem sourceLemma36_take_idxOf_succ [DecidableEq V]
    (L : List V) (x : V) (hx : x ∈ L) :
    L.take (L.idxOf x + 1) = L.take (L.idxOf x) ++ [x] := by
  induction L with
  | nil => simp at hx
  | cons a L ih =>
    by_cases hax : a = x
    · subst x
      simp
    · have hx' : x = a ∨ x ∈ L := by simpa using hx
      have hxL : x ∈ L := hx'.resolve_left (fun h => hax h.symm)
      rw [List.idxOf_cons_ne L hax]
      simp only [Nat.succ_eq_add_one, Nat.add_assoc, List.take_succ_cons]
      rw [ih hxL]
      simp [List.take_succ_cons]

/-- Rotating a closed walk at a noninitial vertex is the corresponding rotation
of its tail support, with that vertex repeated once as the terminal endpoint. -/
private theorem sourceLemma36_noninitial_rotate_support [DecidableEq V]
    (S : List V) (r a : V) (har : r ≠ a) (ha : a ∈ S) :
    (r :: S).drop ((r :: S).idxOf a) ++
        ((r :: S).take ((r :: S).idxOf a + 1)).tail =
      S.rotate (S.idxOf a) ++ [a] := by
  have hidx : (r :: S).idxOf a = S.idxOf a + 1 :=
    List.idxOf_cons_ne S har
  rw [hidx]
  simp only [List.drop_succ_cons, List.take_succ_cons, List.tail_cons]
  rw [List.rotate_eq_drop_append_take (l := S) (n := S.idxOf a) (List.idxOf_lt_length_iff.mpr ha).le]
  rw [sourceLemma36_take_idxOf_succ S a ha]
  simp only [List.append_assoc]

/-- In a nodup tail support, the terminal return vertex occurs at its last
position. -/
private theorem sourceLemma36_idxOf_terminal [DecidableEq V]
    (S : List V) (r : V) (hS : S.Nodup) (hSnonempty : S ≠ [])
    (hlast : S.getLast hSnonempty = r) :
    S.idxOf r = S.length - 1 := by
  have hr : r ∈ S := by
    rw [← hlast]
    exact S.getLast_mem hSnonempty
  let i : Fin S.length := ⟨S.idxOf r, List.idxOf_lt_length_iff.mpr hr⟩
  let j : Fin S.length := ⟨S.length - 1, Nat.sub_lt (List.length_pos_of_ne_nil hSnonempty) Nat.succ_pos'⟩
  have hi : S.get i = r := List.idxOf_get i.2
  have hj : S.get j = r := by
    rw [List.get_length_sub_one j.2, hlast]
  have hij : i = j := (List.nodup_iff_injective_get.mp hS) (hi.trans hj.symm)
  exact Fin.mk.inj_iff.mp hij

/-- Rotating at the original walk start has the same tail-order description. -/
private theorem sourceLemma36_initial_rotate_support [DecidableEq V]
    (S : List V) (r : V) (hS : S.Nodup) (hSnonempty : S ≠ [])
    (hlast : S.getLast hSnonempty = r) :
    (r :: S).drop ((r :: S).idxOf r) ++
        ((r :: S).take ((r :: S).idxOf r + 1)).tail =
      S.rotate (S.idxOf r) ++ [r] := by
  have hidx := sourceLemma36_idxOf_terminal S r hS hSnonempty hlast
  have hsplit : S = S.dropLast ++ [r] := by
    simpa [hlast] using (List.dropLast_append_getLast hSnonempty).symm
  rw [List.idxOf_cons_self]
  simp only [List.drop_zero, List.take_one, List.tail_cons, List.nil_append]
  rw [hidx, List.rotate_eq_drop_append_take (Nat.sub_le _ _), hsplit]
  simp [List.dropLast_eq_take, List.append_assoc]

/-- The anchor-cut vertex order is exactly the support of the cycle walk
rotated to that anchor, with its closing anchor occurrence retained at the end. -/
private theorem sourceLemma36_rotate_support_eq_order_append_anchor [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V)
    (ha : a ∈ C.support) :
    (C.rotate ha).support = sourceLemma36RotatedCycleOrder G C a ++ [a] := by
  have hCnonempty : ¬ C.Nil := hC.isCycle.not_nil
  have hsupport : C.support = r :: C.tail.support := by
    exact (Walk.cons_support_tail C hCnonempty).symm
  have hSnonempty : C.tail.support ≠ [] := Walk.support_ne_nil _
  have hSnodup : C.tail.support.Nodup := by
    apply List.nodup_iff_count_le_one.mpr
    intro v
    exact le_of_eq (hC.isHamiltonian_tail v)
  have hlast : C.tail.support.getLast hSnonempty = r :=
    C.tail.getLast_support
  unfold sourceLemma36RotatedCycleOrder
  rw [Walk.rotate, Walk.support_append,
    sourceLemma36_support_dropUntil_eq_drop_indexOf,
    sourceLemma36_support_takeUntil_eq_take_indexOf, hsupport]
  by_cases har : a = r
  · subst a
    exact sourceLemma36_initial_rotate_support C.tail.support r hSnodup hSnonempty hlast
  · exact sourceLemma36_noninitial_rotate_support C.tail.support r a (fun h => har h.symm)
      (hC.isHamiltonian_tail.mem_support a)

/-- In a nodup list, `idxOf` recovers the original finite position. -/
private theorem sourceLemma36_idxOf_get_eq_position [DecidableEq V]
    (L : List V) (hL : L.Nodup) (p : Fin L.length) :
    L.idxOf (L.get p) = p.1 := by
  let q : Fin L.length := ⟨L.idxOf (L.get p),
    List.idxOf_lt_length_iff.mpr (L.get_mem p)⟩
  have hq : L.get q = L.get p := List.idxOf_get q.2
  exact Fin.mk.inj_iff.mp ((List.nodup_iff_injective_get.mp hL) hq)

/-- Taking the rotated cycle walk until a positioned vertex is precisely the
anchor-cut order prefix ending at that position. -/
private theorem sourceLemma36_rotated_takeUntil_position_support_eq_prefix
    [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V)
    (ha : a ∈ C.support)
    (p : Fin (sourceLemma36RotatedCycleOrder G C a).length) :
    let b := (sourceLemma36RotatedCycleOrder G C a).get p
    let hb : b ∈ (C.rotate ha).support := by
      rw [sourceLemma36_rotate_support_eq_order_append_anchor G C hC a ha]
      exact List.mem_append_left _ ((sourceLemma36RotatedCycleOrder G C a).get_mem p)
    ((C.rotate ha).takeUntil b hb).support =
      (sourceLemma36RotatedCycleOrder G C a).take (p.1 + 1) := by
  dsimp
  let L := sourceLemma36RotatedCycleOrder G C a
  change ((C.rotate ha).takeUntil (L.get p) _).support = L.take (p.1 + 1)
  have hL : L.Nodup := sourceLemma36_rotatedCycleOrder_nodup G C hC a
  have hbL : L.get p ∈ L := L.get_mem p
  have hp : p.1 + 1 ≤ L.length := by
    simpa [L] using Nat.succ_le_iff.mpr p.2
  have hrot := sourceLemma36_rotate_support_eq_order_append_anchor G C hC a ha
  rw [sourceLemma36_support_takeUntil_eq_take_indexOf, hrot,
    List.idxOf_append_of_mem hbL, sourceLemma36_idxOf_get_eq_position L hL p]
  simp [L, List.take_append, hp]

/-- Re-anchoring the cycle order at a displayed position is list rotation by
that position.  This is the bridge from positional intervals to the existing
oriented-subpath construction. -/
private theorem sourceLemma36_rotatedCycleOrder_reanchor [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V)
    (p : Fin (sourceLemma36RotatedCycleOrder G C a).length) :
    sourceLemma36RotatedCycleOrder G C
        ((sourceLemma36RotatedCycleOrder G C a).get p) =
      (sourceLemma36RotatedCycleOrder G C a).rotate p.1 := by
  let S := C.tail.support
  let n := S.idxOf a
  let L := S.rotate n
  have hL : sourceLemma36RotatedCycleOrder G C a = L := rfl
  have hLlen : (sourceLemma36RotatedCycleOrder G C a).length = L.length :=
    congrArg List.length hL
  have hSlen : (sourceLemma36RotatedCycleOrder G C a).length = S.length := by
    simpa [L] using hLlen
  have hSnodup : S.Nodup := by
    apply List.nodup_iff_count_le_one.mpr
    intro v
    exact le_of_eq (hC.isHamiltonian_tail v)
  let p' : Fin L.length := Fin.cast hLlen p
  let q : Fin S.length := ⟨(p.1 + n) % S.length,
    Nat.mod_lt _ (by
      have : S ≠ [] := Walk.support_ne_nil _
      exact List.length_pos_of_ne_nil this)⟩
  have hx : S.get q = L.get p' := by
    symm
    simpa [p', L, n, hSlen] using List.get_rotate S n p'
  have hidx : S.idxOf (L.get p') = q.1 := by
    rw [← hx]
    exact sourceLemma36_idxOf_get_eq_position S hSnodup q
  change S.rotate (S.idxOf (L.get p')) = L.rotate p.1
  rw [hidx]
  change S.rotate ((p.1 + n) % S.length) = (S.rotate n).rotate p.1
  rw [List.rotate_mod S (p.1 + n), List.rotate_rotate]
  simp [Nat.add_comm]

/-- The positioned oriented subpath has exactly the closed positional interval
in the anchor-cut order. -/
private theorem sourceLemma36_rotatedPositionSubpath_support_eq_interval
    [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V)
    (i j : Fin (sourceLemma36RotatedCycleOrder G C a).length) (hij : i.1 ≤ j.1) :
    (sourceLemma36RotatedPositionSubpath G C hC a i j).support =
      ((sourceLemma36RotatedCycleOrder G C a).drop i.1).take (j.1 - i.1 + 1) := by
  let L := sourceLemma36RotatedCycleOrder G C a
  let x := L.get i
  let y := L.get j
  have hi : i.1 < L.length := by simpa [L] using i.2
  have hj : j.1 < L.length := by simpa [L] using j.2
  have hLnodup : L.Nodup := sourceLemma36_rotatedCycleOrder_nodup G C hC a
  have hxi : x ∈ C.support := by
    dsimp [x, L]
    exact sourceLemma36_rotatedPosition_mem_cycle G C hC a i
  have hrot : (C.rotate hxi).support = L.rotate i.1 ++ [x] := by
    rw [sourceLemma36_rotate_support_eq_order_append_anchor G C hC x hxi]
    simpa [x, L] using congrArg (fun T => T ++
      [(sourceLemma36RotatedCycleOrder G C a).get i])
      (sourceLemma36_rotatedCycleOrder_reanchor G C hC a i)
  let q : Fin (L.rotate i.1).length := ⟨j.1 - i.1, by
    change j.1 - i.1 < (L.rotate i.1).length
    rw [List.length_rotate]
    omega⟩
  have hyq : (L.rotate i.1).get q = y := by
    rw [List.get_rotate]
    apply congrArg L.get
    apply Fin.ext
    dsimp [q]
    rw [Nat.mod_eq_of_lt]
    · omega
    · omega
  have hyLrot : y ∈ L.rotate i.1 := by
    rw [← hyq]
    exact List.get_mem _ q
  have hidx : (L.rotate i.1).idxOf y = j.1 - i.1 := by
    rw [← hyq]
    exact sourceLemma36_idxOf_get_eq_position _ (by simpa using hLnodup) q
  change ((C.rotate hxi).takeUntil y _).support = (L.drop i.1).take (j.1 - i.1 + 1)
  rw [sourceLemma36_support_takeUntil_eq_take_indexOf, hrot,
    List.idxOf_append_of_mem hyLrot, hidx]
  have hbound : j.1 - i.1 + 1 ≤ (L.drop i.1).length := by
    rw [List.length_drop]
    omega
  rw [List.rotate_eq_drop_append_take hi.le, List.append_assoc]
  exact List.take_append_of_le_length hbound

/-- Every position in the closed interval occurs on its actual oriented
subpath. -/
private theorem sourceLemma36_position_mem_subpath [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V)
    (i j p : Fin (sourceLemma36RotatedCycleOrder G C a).length)
    (hip : i.1 ≤ p.1) (hpj : p.1 ≤ j.1) :
    (sourceLemma36RotatedCycleOrder G C a).get p ∈
      (sourceLemma36RotatedPositionSubpath G C hC a i j).support := by
  let L := sourceLemma36RotatedCycleOrder G C a
  have hi : i.1 < L.length := by simpa [L] using i.2
  have hj : j.1 < L.length := by simpa [L] using j.2
  have hp : p.1 < L.length := by simpa [L] using p.2
  have hij : i.1 ≤ j.1 := hip.trans hpj
  rw [sourceLemma36_rotatedPositionSubpath_support_eq_interval G C hC a i j hij]
  have hbound : j.1 - i.1 + 1 ≤ (L.drop i.1).length := by
    rw [List.length_drop]
    omega
  let q : Fin ((L.drop i.1).take (j.1 - i.1 + 1)).length :=
    ⟨p.1 - i.1, by
      rw [List.length_take_of_le hbound]
      omega⟩
  apply (List.mem_iff_get).mpr
  refine ⟨q, ?_⟩
  dsimp [q]
  rw [List.getElem_take, List.getElem_drop]
  congr 1
  omega


/-- Support membership on a positioned subpath is exactly membership at one
position of its closed interval. -/
private theorem sourceLemma36_mem_positionSubpath_iff [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V)
    (i j : Fin (sourceLemma36RotatedCycleOrder G C a).length) (hij : i.1 ≤ j.1)
    (v : V) :
    v ∈ (sourceLemma36RotatedPositionSubpath G C hC a i j).support ↔
      ∃ p : Fin (sourceLemma36RotatedCycleOrder G C a).length,
        i.1 ≤ p.1 ∧ p.1 ≤ j.1 ∧
          (sourceLemma36RotatedCycleOrder G C a).get p = v := by
  let L := sourceLemma36RotatedCycleOrder G C a
  have hi : i.1 < L.length := by simpa [L] using i.2
  have hj : j.1 < L.length := by simpa [L] using j.2
  have hbound : j.1 - i.1 + 1 ≤ (L.drop i.1).length := by
    rw [List.length_drop]
    omega
  constructor
  · intro hv
    rw [sourceLemma36_rotatedPositionSubpath_support_eq_interval G C hC a i j hij] at hv
    change v ∈ (L.drop i.1).take (j.1 - i.1 + 1) at hv
    rcases (List.mem_iff_get.mp hv) with ⟨q, hq⟩
    have hqbound : q.1 < j.1 - i.1 + 1 := by
      simpa [List.length_take_of_le hbound] using q.2
    let p : Fin L.length := ⟨i.1 + q.1, by
      rw [List.length_drop] at hbound
      omega⟩
    have hpv : L.get p = v := by
      rw [← hq]
      simp only [List.get_eq_getElem]
      rw [List.getElem_take, List.getElem_drop]
    refine ⟨Fin.cast (by simp [L]) p, ?_, ?_, ?_⟩
    · dsimp [p]
      omega
    · dsimp [p]
      omega
    · simpa [L] using hpv
  · rintro ⟨p, hip, hpj, hpv⟩
    rw [← hpv]
    exact sourceLemma36_position_mem_subpath G C hC a i j p hip hpj

/-- Strict positional order is the strict index order in the actual support
list of the corresponding oriented subpath. -/
private theorem sourceLemma36_positionSubpath_order [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V)
    (i j p q : Fin (sourceLemma36RotatedCycleOrder G C a).length)
    (hip : i.1 ≤ p.1) (hpq : p.1 < q.1) (hqj : q.1 ≤ j.1) :
    (sourceLemma36RotatedPositionSubpath G C hC a i j).support.idxOf
        ((sourceLemma36RotatedCycleOrder G C a).get p) <
      (sourceLemma36RotatedPositionSubpath G C hC a i j).support.idxOf
        ((sourceLemma36RotatedCycleOrder G C a).get q) := by
  let L := sourceLemma36RotatedCycleOrder G C a
  let I := (L.drop i.1).take (j.1 - i.1 + 1)
  have hij : i.1 ≤ j.1 := hip.trans (Nat.le_of_lt (hpq.trans_le hqj))
  have hbound : j.1 - i.1 + 1 ≤ (L.drop i.1).length := by
    rw [List.length_drop]
    have hj : j.1 < L.length := by simpa [L] using j.2
    omega
  have hLnodup : L.Nodup := sourceLemma36_rotatedCycleOrder_nodup G C hC a
  have hInodup : I.Nodup := by
    apply List.Sublist.nodup
    exact (List.take_sublist _ _).trans (List.drop_sublist _ _)
    exact hLnodup
  let pp : Fin I.length := ⟨p.1 - i.1, by
    rw [show I.length = j.1 - i.1 + 1 by
      dsimp [I]
      exact List.length_take_of_le hbound]
    omega⟩
  let qq : Fin I.length := ⟨q.1 - i.1, by
    rw [show I.length = j.1 - i.1 + 1 by
      dsimp [I]
      exact List.length_take_of_le hbound]
    omega⟩
  have hpp : I.get pp = L.get p := by
    dsimp [I, pp]
    rw [List.getElem_take, List.getElem_drop]
    congr 1
    omega
  have hqq : I.get qq = L.get q := by
    dsimp [I, qq]
    rw [List.getElem_take, List.getElem_drop]
    congr 1
    omega
  have hidxp : I.idxOf (L.get p) = p.1 - i.1 := by
    rw [← hpp]
    exact sourceLemma36_idxOf_get_eq_position I hInodup pp
  have hidxq : I.idxOf (L.get q) = q.1 - i.1 := by
    rw [← hqq]
    exact sourceLemma36_idxOf_get_eq_position I hInodup qq
  rw [sourceLemma36_rotatedPositionSubpath_support_eq_interval G C hC a i j hij]
  change I.idxOf (L.get p) < I.idxOf (L.get q)
  rw [hidxp, hidxq]
  omega

/-- The roots in their order around the Hamiltonian cycle after cutting at the
chosen anchor. -/
private noncomputable def sourceLemma36OrderedZ [DecidableEq V]
