    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsHamiltonianCycle) (k : ℕ) (hk : 1 ≤ k) (Y : Finset V)
    (hY : 4 * C.length ≤ 9 * Y.card) (hdegree : ∀ y ∈ Y, 6 ≤ G.degree y)
    (hcycle_large : 9 * sourceLemma36_c k ≤ C.length) (hgirth : 5 ≤ G.girth) :
