/-- The factorial identity gives the integer-scaled cubic choose estimate. -/
private theorem sourceTheorem3_choose_three_scaled (n : ℕ) :
    6 * Nat.choose n 3 ≤ n^3 := by
  have h := Nat.descFactorial_le_pow n 3
  rw [Nat.descFactorial_eq_factorial_mul_choose] at h
  simpa only [show Nat.factorial 3 = 6 by decide] using h

/-- A sharp estimate for the unchanged source constant in the successor range. -/
theorem sourceTheorem3_c_sharp_bound (k : ℕ) (hk : 16 ≤ k) :
    sourceLemma36_c k ≤ 40 * k^12 := by
  let n := 4 * k^2 * (k+2)
  have hp : 8 * (k+2) ≤ 9 * k := by omega
  have hq : 8 * (k^2+2) ≤ 9 * k^2 := by nlinarith
  have hn : 2*n ≤ 9*k^3 := by
    dsimp [n]
    nlinarith [Nat.mul_le_mul_left (k^2) hp]
  have hcube : 8*n^3 ≤ 729*k^9 := by
    calc
      8*n^3 = (2*n)^3 := by ring
      _ ≤ (9*k^3)^3 := Nat.pow_le_pow_left hn 3
      _ = 729*k^9 := by ring
  have h6 := sourceTheorem3_choose_three_scaled n
  have h48 : 48 * Nat.choose n 3 ≤ 729*k^9 := by omega
  have h4 : k^4 ≤ k^12 := Nat.pow_le_pow_right (by omega) (by decide)
  have hfirstScaled : 8 * (4*k^3*(k+2)) ≤ 36*k^4 := by
    calc
      8 * (4*k^3*(k+2)) = (4*k^3) * (8*(k+2)) := by ring
      _ ≤ (4*k^3) * (9*k) := Nat.mul_le_mul_left _ hp
      _ = 36*k^4 := by ring
  have hfirst : 4*k^3*(k+2) ≤ 5*k^12 := by nlinarith
  have hprod := Nat.mul_le_mul hq h48
  have hsecondScaled : 192 * (2*k*(k^2+2)*Nat.choose n 3) ≤ 6561*k^12 := by
    calc
      192 * (2*k*(k^2+2)*Nat.choose n 3) = k * ((8*(k^2+2)) * (48*Nat.choose n 3)) := by ring
      _ ≤ k * ((9*k^2) * (729*k^9)) := Nat.mul_le_mul_left k hprod
      _ = 6561*k^12 := by ring
  have hsecond : 2*k*(k^2+2)*Nat.choose n 3 ≤ 35*k^12 := by nlinarith
  change 4*k^3*(k+2) + 2*k*(k^2+2)*Nat.choose n 3 ≤ 40*k^12
  omega

/-- The actual successor threshold is bounded with the original constant and exponent. -/
theorem sourceTheorem3_successor_threshold (t : ℕ) (ht : 1 ≤ t) :
    2^6 * 3^4 * (sourceLemma36_c (8*t+8))^2 ≤ 2^120 * t^24 := by
  have h16 : 16 ≤ 8*t+8 := by omega
  have harg : 8*t+8 ≤ 16*t := by omega
  have hc := (sourceTheorem3_c_sharp_bound (8*t+8) h16).trans
    (Nat.mul_le_mul_left 40 (Nat.pow_le_pow_left harg 12))
  calc
    2^6 * 3^4 * (sourceLemma36_c (8*t+8))^2 ≤
        2^6 * 3^4 * (40*(16*t)^12)^2 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hc 2)
    _ = (2^6 * 3^4 * 40^2) * 16^24 * t^24 := by ring
    _ ≤ 2^24 * 16^24 * t^24 := by gcongr; norm_num
    _ = 2^120 * t^24 := by norm_num

/-- The second threshold already lies below the source's fixed large-girth bound. -/
theorem sourceTheorem3_second_threshold :
    2^6 * 3^4 * (sourceLemma36_c 16)^2 ≤ 2^120 := by
  simpa using sourceTheorem3_successor_threshold 1 le_rfl

/-- The source-selected positive parameter is at least two by its strict successor bound. -/
theorem sourceTheorem3_selected_parameter_ge_two {L t : ℕ}
    (ht : 1 ≤ t) (hL : 2^120 ≤ L)
    (hupper : L < 2^6 * 3^4 * (sourceLemma36_c (8*t+8))^2) : 2 ≤ t := by
  by_contra hnot
  have ht1 : t = 1 := by omega
  subst t
  have hsecond := sourceTheorem3_second_threshold
  norm_num only at hupper
  omega

/-- Verstraëte's complete Theorem 3, with exact positive set sizes and physical cycles in G. -/
theorem sourceTheorem3_complete [Fintype V]
    (havg : averageDegreeAtLeast G 10) (hgirth : 2^120 ≤ G.girth) :
    ∃ k : ℕ, 2 ≤ k ∧ ∃ A B : Finset ℕ,
      A.card = k ∧ B.card = k ∧
      (∀ a ∈ A, 0 < a) ∧ (∀ b ∈ B, 0 < b) ∧
      ∀ a ∈ A, ∀ b ∈ B, IsCycleLength G (a+b) ∧ a+b ≤ 2^120*k^24 := by
  classical
  obtain ⟨W, r, C, t, hconn, hdegree, hLongest, _hcompare, hHgirth, ht, hk, hlarge, hupper⟩ :=
    sourceTheorem3_lemma39_inputs G havg hgirth
  let H := G.induce (↑W : Set V)
  have hcycle : H.girth ≤ C.length := by
    have he : H.egirth ≤ C.length := (SimpleGraph.le_egirth.mp le_rfl) _ _ hLongest.1
    exact ENat.toNat_le_of_le_coe he
  have ht2 : 2 ≤ t := sourceTheorem3_selected_parameter_ge_two ht (hHgirth.trans hcycle) hupper
  have hbound : C.length ≤ 2^120*t^24 :=
    hupper.le.trans (sourceTheorem3_successor_threshold t ht)
  have hfive : 5 ≤ H.girth := (by norm_num : 5 ≤ 2^120).trans hHgirth
  obtain ⟨A, B, hA, hB, hapos, hbpos, hcycles, hlength⟩ :=
    sourceLemma39_bounded_spectrum_complete H C hLongest (8*t) hk hconn hfive
      (fun v => hdegree v inferInstance) hlarge
  have hdiv : (8*t)/8 = t := by omega
  obtain ⟨A', hAsub, hAcard⟩ := Finset.exists_subset_card_eq (hdiv ▸ hA)
  obtain ⟨B', hBsub, hBcard⟩ := Finset.exists_subset_card_eq (hdiv ▸ hB)
  refine ⟨t, ht2, A', B', hAcard, hBcard, fun a ha => hapos a (hAsub ha),
    fun b hb => hbpos b (hBsub hb), ?_⟩
  intro a ha b hb
  exact ⟨sourceLemma24_map_cycle_length H (Embedding.induce (↑W : Set V)).toHom
      Subtype.val_injective (hcycles a (hAsub ha) b (hBsub hb)),
    (hlength a (hAsub ha) b (hBsub hb)).trans hbound⟩

