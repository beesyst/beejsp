  have h4 : k^4 ≤ k^12 := Nat.pow_le_pow_right hk (by decide)
  calc
    sourceLemma36_c k ≤ 4 * k^3 * (3 * k) + 2 * k * (3 * k^2) * (12 * k^3)^3 := by
      unfold sourceLemma36_c
      gcongr
    _ = 12 * k^4 + 10368 * k^12 := by ring
    _ ≤ 10380 * k^12 := by nlinarith

/-- The requested enabling threshold; it is not an upper bound on a longest cycle. -/
theorem sourceTheorem3_numerical_threshold (t : ℕ) (ht : 1 ≤ t) :
    2^6 * 3^4 * (sourceLemma36_c (8*t))^2 ≤ 2^120 * t^24 := by
  have hc := sourceTheorem3_c_bound (8*t) (by omega)
  have hs := Nat.pow_le_pow_left hc 2
  calc
    2^6 * 3^4 * (sourceLemma36_c (8*t))^2 ≤
        2^6 * 3^4 * (10380 * (8*t)^12)^2 := Nat.mul_le_mul_left _ hs
    _ = (2^6 * 3^4 * (10380 * 8^12)^2) * t^24 := by ring
    _ ≤ 2^120 * t^24 := by gcongr; norm_num

/-- Average degree ten supplies the cardinality premise of Proposition 3.10. -/
theorem sourceTheorem3_card_lower_bound [Fintype V] [DecidableEq V]
    (havg : averageDegreeAtLeast G 10) : 7 ≤ Fintype.card V := by
  classical
  obtain ⟨hpos, havg⟩ := havg
  by_contra hnot
  have hN : Fintype.card V ≤ 6 := by omega
  have hsum : ∑ v : V, G.degree v ≤ 5 * Fintype.card V := by
    calc
      ∑ v : V, G.degree v ≤ ∑ _v : V, 5 := Finset.sum_le_sum fun v _ => by
        have h := G.degree_lt_card_verts v
        omega
      _ = 5 * Fintype.card V := by simp [Nat.mul_comm]
  rw [G.sum_degrees_eq_twice_card_edges] at hsum
  nlinarith

/-- The actual induced Mader witness, with its original embedding into G. -/
theorem sourceTheorem3_mader_extraction [Fintype V] [DecidableEq V]
    (havg : averageDegreeAtLeast G 10) :
    ∃ W : Finset V, VertexConnectivityAtLeast (G.induce (↑W : Set V)) 4 ∧
      ∀ v : {w // w ∈ W}, ∀ _ : Fintype ↑((G.induce (↑W : Set V)).neighborSet v),
        6 ≤ (G.induce (↑W : Set V)).degree v := by
  exact sourceProposition310_k4 G (sourceTheorem3_card_lower_bound G havg) havg

/-- Certified connectivity and degree exclude the acyclic case. -/
private theorem sourceTheorem3_not_acyclic [Fintype V] [DecidableEq V]
    (hconn : VertexConnectivityAtLeast G 4) (hdegree : ∀ v, 6 ≤ G.degree v) :
    ¬ G.IsAcyclic := by
  classical
  have he := hconn.2 ∅ (by simp)
  have hempty : {v : V | v ∉ (∅ : Finset V)} = Set.univ := by ext v; simp
  rw [hempty] at he
  have hconnected : G.Connected := G.induceUnivIso.connected_iff.mp he
  intro hac
  have htree : G.IsTree := ⟨hconnected, hac⟩
  have hcard := htree.card_edgeFinset
  have hsum : 6 * Fintype.card V ≤ ∑ v : V, G.degree v := by
    calc
      6 * Fintype.card V = ∑ _v : V, 6 := by simp [Nat.mul_comm]
      _ ≤ ∑ v : V, G.degree v := Finset.sum_le_sum fun v _ => hdegree v
  rw [G.sum_degrees_eq_twice_card_edges] at hsum
  have hpos := hconn.1
  omega

/-- A genuine simple cycle of maximal length, selected from finite cycle lengths. -/
theorem sourceTheorem3_longest_cycle [Fintype V] [DecidableEq V]
    (hconn : VertexConnectivityAtLeast G 4) (hdegree : ∀ v, 6 ≤ G.degree v) :
    ∃ (r : V) (C : G.Walk r r), SourceLongestCycle G C := by
  classical
  obtain ⟨r, D, hD, _⟩ := SimpleGraph.exists_girth_eq_length.mpr
    (sourceTheorem3_not_acyclic G hconn hdegree)
  have mem (n : ℕ) (hn : IsCycleLength G n) : n ∈ cycleLengths G := by
    obtain ⟨v, P, hP, hlen⟩ := hn
    simp only [cycleLengths, Finset.mem_filter, Finset.mem_range]
    exact ⟨by have := isCycleLength_le_card hP; omega, ⟨v, P, hP, hlen⟩⟩
  have hne : (cycleLengths G).Nonempty := ⟨D.length, mem _ ⟨r, D, hD, rfl⟩⟩
  have hm := Finset.max'_mem (cycleLengths G) hne
  have hmcycle : IsCycleLength G ((cycleLengths G).max' hne) :=
    (Finset.mem_filter.mp hm).2
  obtain ⟨v, C, hC, hlen⟩ := hmcycle
  refine ⟨v, C, hC, ?_⟩
  intro w P hP
  have hle := Finset.le_max' (cycleLengths G) P.length (mem _ ⟨w, P, hP, rfl⟩)
  omega

/-- A cyclic induced graph has girth at least that of its ambient graph. -/
theorem sourceTheorem3_induced_girth [DecidableEq V] (W : Finset V)
    (hcyclic : ¬ (G.induce (↑W : Set V)).IsAcyclic) :
    G.girth ≤ (G.induce (↑W : Set V)).girth := by
  obtain ⟨r, C, hC, heq⟩ := SimpleGraph.exists_girth_eq_length.mpr hcyclic
  have hmap := hC.map (f := (Embedding.induce (↑W : Set V)).toHom) Subtype.val_injective
  have he : G.egirth ≤ (C.map (Embedding.induce (↑W : Set V)).toHom).length :=
    (SimpleGraph.le_egirth.mp le_rfl) _ _ hmap
  have hlen : G.girth ≤ C.length := by
    simpa only [Walk.length_map] using ENat.toNat_le_of_le_coe he
  omega

/-- The source threshold grows at least as fast as its positive parameter. -/
private theorem sourceTheorem3_parameter_le_threshold (t : ℕ) (ht : 1 ≤ t) :
    t ≤ 2^6 * 3^4 * (sourceLemma36_c (8*t))^2 := by
  let k := 8*t
  have hk : 1 ≤ k := by dsimp [k]; omega
  have hk3 : k ≤ k^3 := Nat.le_self_pow (by decide) k
  have hc : k ≤ sourceLemma36_c k := by
    have hmul := Nat.mul_le_mul_left (4 * k^3) (by omega : 1 ≤ k + 2)
    unfold sourceLemma36_c
    nlinarith
  have hsq : sourceLemma36_c k ≤ (sourceLemma36_c k)^2 := Nat.le_self_pow (by decide) (sourceLemma36_c k)
  have hscale : (sourceLemma36_c k)^2 ≤ 2^6 * 3^4 * (sourceLemma36_c k)^2 := by
    omega
  exact (by dsimp [k]; omega : t ≤ k).trans (hc.trans (hsq.trans hscale))

/-- Choose the source parameter from the actual length, not from an assumed length cap. -/
theorem sourceTheorem3_parameter_selection (L : ℕ)
    (hbase : 2^6 * 3^4 * (sourceLemma36_c 8)^2 ≤ L) :
    ∃ t : ℕ, 1 ≤ t ∧ 1 ≤ 8*t ∧
      2^6 * 3^4 * (sourceLemma36_c (8*t))^2 ≤ L ∧
      L < 2^6 * 3^4 * (sourceLemma36_c (8*t + 8))^2 := by
  classical
  let P := fun t : ℕ => 1 ≤ t ∧ 2^6 * 3^4 * (sourceLemma36_c (8*t))^2 ≤ L
  have hseed : P 1 := ⟨le_rfl, by simpa using hbase⟩
  have h1 : 1 ≤ 2^6 * 3^4 * (sourceLemma36_c 8)^2 := by
    simpa using sourceTheorem3_parameter_le_threshold 1 le_rfl
  have hL : 1 ≤ L := h1.trans hbase
  let t := Nat.findGreatest P L
  have ht : P t := Nat.findGreatest_spec hL hseed
  refine ⟨t, ht.1, by omega, ht.2, ?_⟩
  by_contra hnot
  have hnext : 2^6 * 3^4 * (sourceLemma36_c (8*(t+1)))^2 ≤ L := by
    have heq : 8*(t+1) = 8*t+8 := by omega
    rw [heq]
    omega
  have hbound : t+1 ≤ L :=
    (sourceTheorem3_parameter_le_threshold (t+1) (by omega)).trans hnext
  exact (Nat.findGreatest_is_greatest (P := P) (by omega : t < t+1) hbound) ⟨by omega, hnext⟩

/-- The source's fixed large-girth hypothesis supplies actual induced graph,
longest cycle and selected parameter witnesses for Lemma 3.9. -/
theorem sourceTheorem3_lemma39_inputs [Fintype V] [DecidableEq V]
    (havg : averageDegreeAtLeast G 10) (hgirth : 2^120 ≤ G.girth) :
    ∃ (W : Finset V) (r : {w // w ∈ W})
      (C : (G.induce (↑W : Set V)).Walk r r) (t : ℕ),
      VertexConnectivityAtLeast (G.induce (↑W : Set V)) 4 ∧
      (∀ v : {w // w ∈ W}, ∀ _ : Fintype ↑((G.induce (↑W : Set V)).neighborSet v),
        6 ≤ (G.induce (↑W : Set V)).degree v) ∧
      SourceLongestCycle (G.induce (↑W : Set V)) C ∧
      G.girth ≤ (G.induce (↑W : Set V)).girth ∧
      2^120 ≤ (G.induce (↑W : Set V)).girth ∧
      1 ≤ t ∧ 1 ≤ 8*t ∧
      2^6 * 3^4 * (sourceLemma36_c (8*t))^2 ≤ C.length ∧
      C.length < 2^6 * 3^4 * (sourceLemma36_c (8*t+8))^2 := by
  classical
  obtain ⟨W, hconn, hdegree⟩ := sourceTheorem3_mader_extraction G havg
  let H := G.induce (↑W : Set V)
  have hdeg : ∀ v, 6 ≤ H.degree v := fun v => hdegree v inferInstance
  obtain ⟨r, C, hLongest⟩ := sourceTheorem3_longest_cycle H hconn hdeg
  have hcyclic : ¬ H.IsAcyclic := fun hac => hac C hLongest.1
  have hcompare := sourceTheorem3_induced_girth G W hcyclic
  have hHgirth : 2^120 ≤ H.girth := hgirth.trans hcompare
  have hcycle : H.girth ≤ C.length := by
    have he : H.egirth ≤ C.length := (SimpleGraph.le_egirth.mp le_rfl) _ _ hLongest.1
    exact ENat.toNat_le_of_le_coe he
  have hnum : 2^6 * 3^4 * (sourceLemma36_c 8)^2 ≤ 2^120 := by
    simpa using sourceTheorem3_numerical_threshold 1 le_rfl
  have hbase : 2^6 * 3^4 * (sourceLemma36_c 8)^2 ≤ C.length :=
    hnum.trans (hHgirth.trans hcycle)
  obtain ⟨t, ht, hk, hlower, hupper⟩ := sourceTheorem3_parameter_selection C.length hbase
  exact ⟨W, r, C, t, hconn, hdegree, hLongest, hcompare, hHgirth, ht, hk, hlower, hupper⟩

