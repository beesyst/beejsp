      cross_fst_root := rfl
      cross_fst_owner := hcrossEndpoints.1
      cross_snd_owner := hcrossEndpoints.2
      rungOwner_ne_crossOwner := ?_
      crossing_crosses_selected := by intro t; exact hright t
    }⟩

    · simpa [select, hselect, sourceLemma38RightBufferSection2Ladder] using
        sourceLemma38_rightBuffer_crossladder
          G C k hk Z data iP matching ladder i f hright

    · simpa [select, hselect, sourceLemma38RightBufferSection2Ladder] using
        sourceLemma38_rightBuffer_crossladder_endpoints
          G C k hk Z data iP matching ladder i f hright

    · intro t
      rfl

    · intro a b hab
      have hsel : select a = select b := by
        apply hsectionOwner
        simpa [rungOwner] using hab
      exact hselect.injective hsel

    · intro t
      simpa [rungOwner] using hfirstOwner (select t)

    · intro t
      simpa [rungOwner] using hsecondOwner (select t)

    · intro t howner
      have hidx :
          select t = sourceLemma38CentralRungIndex k hk i := by
        apply hsectionOwner
        simpa [rungOwner, sourceLemma38CentralOwner] using howner
      have hne :=
