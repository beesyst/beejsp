private theorem sourceLemma36_exists_increasingChain_card_of_le_rank (xs : List ℕ)
    (i : Fin xs.length) {r : ℕ} (hr : r ≤ sourceLemma36IncreasingRank xs i) :
    ∃ I : Finset (Fin xs.length), I.card = r ∧ SourceLemma36IncreasingIndexChain xs I := by
  classical
  obtain ⟨I, hI, hIcard⟩ := sourceLemma36_increasingRank_witness xs i
  obtain ⟨J, hJI, hJcard⟩ := Finset.exists_subset_card_eq (s := I) (n := r) (by
    simpa only [hIcard] using hr)
  refine ⟨J, hJcard, ?_⟩
  exact sourceLemma36_increasingIndexChain_subset xs
    (by simpa [sourceLemma36IncreasingChainsEndingAt] using (Finset.mem_filter.mp hI).2.2.2) hJI

private theorem sourceLemma36_exists_decreasingChain_card_of_le_rank (xs : List ℕ)
    (i : Fin xs.length) {s : ℕ} (hs : s ≤ sourceLemma36DecreasingRank xs i) :
    ∃ I : Finset (Fin xs.length), I.card = s ∧ SourceLemma36DecreasingIndexChain xs I := by
  classical
  obtain ⟨I, hI, hIcard⟩ := sourceLemma36_decreasingRank_witness xs i
  obtain ⟨J, hJI, hJcard⟩ := Finset.exists_subset_card_eq (s := I) (n := s) (by
    simpa only [hIcard] using hs)
  refine ⟨J, hJcard, ?_⟩
  exact sourceLemma36_decreasingIndexChain_subset xs
    (by simpa [sourceLemma36DecreasingChainsEndingAt] using (Finset.mem_filter.mp hI).2.2.2) hJI

/-- The finite Erdős--Szekeres alternative needed by the large-matching case.
It is intentionally phrased in terms of finite sets of source positions, so
that later graph arguments retain their original ordering data. -/
private theorem sourceLemma36_erdosSzekeres_distinct (xs : List ℕ)
    (hxs : xs.Nodup) (r s : ℕ) (hr : 2 ≤ r) (hs : 2 ≤ s)
    (hlen : (r - 1) * (s - 1) < xs.length) :
    (∃ I : Finset (Fin xs.length), I.card = r ∧ SourceLemma36IncreasingIndexChain xs I) ∨
      ∃ I : Finset (Fin xs.length), I.card = s ∧ SourceLemma36DecreasingIndexChain xs I := by
  classical
  by_cases hinc : ∃ I : Finset (Fin xs.length),
      I.card = r ∧ SourceLemma36IncreasingIndexChain xs I
  · exact Or.inl hinc
  by_cases hdec : ∃ I : Finset (Fin xs.length),
      I.card = s ∧ SourceLemma36DecreasingIndexChain xs I
  · exact Or.inr hdec
  have hnoinc : ∀ I : Finset (Fin xs.length), I.card = r →
      ¬ SourceLemma36IncreasingIndexChain xs I := by
    intro I hcard hchain
    exact hinc ⟨I, hcard, hchain⟩
  have hnodec : ∀ I : Finset (Fin xs.length), I.card = s →
      ¬ SourceLemma36DecreasingIndexChain xs I := by
    intro I hcard hchain
    exact hdec ⟨I, hcard, hchain⟩
  have hincBound : ∀ i : Fin xs.length, sourceLemma36IncreasingRank xs i < r := by
    intro i
    by_contra h
    obtain ⟨I, hIcard, hIchain⟩ :=
      sourceLemma36_exists_increasingChain_card_of_le_rank xs i (Nat.le_of_not_gt h)
    exact hnoinc I hIcard hIchain
  have hdecBound : ∀ i : Fin xs.length, sourceLemma36DecreasingRank xs i < s := by
    intro i
    by_contra h
    obtain ⟨I, hIcard, hIchain⟩ :=
      sourceLemma36_exists_decreasingChain_card_of_le_rank xs i (Nat.le_of_not_gt h)
    exact hnodec I hIcard hIchain
  let rankPair : Fin xs.length → Fin (r - 1) × Fin (s - 1) := fun i =>
    (⟨sourceLemma36IncreasingRank xs i - 1, by
        have hpos := sourceLemma36_increasingRank_pos xs i
        have hbound := hincBound i
        omega⟩,
      ⟨sourceLemma36DecreasingRank xs i - 1, by
        have hpos := sourceLemma36_decreasingRank_pos xs i
        have hbound := hdecBound i
        omega⟩)
  have hinj : Function.Injective rankPair := by
    intro i j hij
    by_contra hne
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · have hvalues : xs.get i < xs.get j ∨ xs.get j < xs.get i := by
        exact lt_or_gt_of_ne (fun h =>
          hne (List.nodup_iff_injective_get.mp hxs h))
      rcases hvalues with hvalues | hvalues
      · have hgrow := sourceLemma36_increasingRank_lt_of_lt xs hlt hvalues
        have heq := congrArg Prod.fst hij
        have hposi := sourceLemma36_increasingRank_pos xs i
        have hposj := sourceLemma36_increasingRank_pos xs j
        exact (ne_of_lt hgrow) (by
          dsimp [rankPair] at heq
          have hsub : sourceLemma36IncreasingRank xs i - 1 =
              sourceLemma36IncreasingRank xs j - 1 := by
            simpa only [Fin.val_mk] using congrArg Fin.val heq
          omega)
      · have hgrow := sourceLemma36_decreasingRank_lt_of_lt xs hlt hvalues
        have heq := congrArg Prod.snd hij
        have hposi := sourceLemma36_decreasingRank_pos xs i
        have hposj := sourceLemma36_decreasingRank_pos xs j
        exact (ne_of_lt hgrow) (by
          dsimp [rankPair] at heq
          have hsub : sourceLemma36DecreasingRank xs i - 1 =
              sourceLemma36DecreasingRank xs j - 1 := by
            simpa only [Fin.val_mk] using congrArg Fin.val heq
          omega)
    · have hvalues : xs.get j < xs.get i ∨ xs.get i < xs.get j := by
        exact lt_or_gt_of_ne (fun h =>
          hne (List.nodup_iff_injective_get.mp hxs h.symm))
      rcases hvalues with hvalues | hvalues
      · have hgrow := sourceLemma36_increasingRank_lt_of_lt xs hgt hvalues
        have heq := congrArg Prod.fst hij
        have hposi := sourceLemma36_increasingRank_pos xs j
        exact (ne_of_lt hgrow) (by
          dsimp [rankPair] at heq
          have hsub : sourceLemma36IncreasingRank xs j - 1 =
              sourceLemma36IncreasingRank xs i - 1 := by
            simpa only [Fin.val_mk] using (congrArg Fin.val heq).symm
          omega)
      · have hgrow := sourceLemma36_decreasingRank_lt_of_lt xs hgt hvalues
        have heq := congrArg Prod.snd hij
        have hposi := sourceLemma36_decreasingRank_pos xs j
        exact (ne_of_lt hgrow) (by
          dsimp [rankPair] at heq
          have hsub : sourceLemma36DecreasingRank xs j - 1 =
              sourceLemma36DecreasingRank xs i - 1 := by
            simpa only [Fin.val_mk] using (congrArg Fin.val heq).symm
          omega)
  have hcard := Fintype.card_le_of_injective rankPair hinj
  have hbound : xs.length ≤ (r - 1) * (s - 1) := by
    simpa [Fintype.card_prod] using hcard
  exact (not_le_of_gt hlen hbound).elim

private theorem sourceLemma36_caseB_large_matching_indices
    [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (hlarge : sourceLemma36MatchingThreshold k ≤ matching.P.card) :
    ∃ ordering : SourceLemma36LargeMatchingOrdering G C k Z data iP matching,
      (∃ I : Finset (Fin ordering.secondPositionSequence.length),
        I.card = 4 * k^2 ∧
          SourceLemma36IncreasingIndexChain ordering.secondPositionSequence I) ∨
        ∃ I : Finset (Fin ordering.secondPositionSequence.length),
          I.card = k + 2 ∧
            SourceLemma36DecreasingIndexChain ordering.secondPositionSequence I := by
  obtain ⟨ordering⟩ :=
    sourceLemma36_caseB_large_matching_ordering G C hC k Z data iP matching hlarge
  have hk : 0 < k := by
    have hiP := iP.isLt
    omega
  have hA : 0 < 4 * k^2 := by positivity
  have hAminus : 4 * k^2 - 1 < 4 * k^2 := Nat.sub_lt hA (by omega)
  have hfirst : (4 * k^2 - 1) * (k + 1) < 4 * k^2 * (k + 1) :=
    (Nat.mul_lt_mul_right (by omega)).mpr hAminus
  have hsecond : 4 * k^2 * (k + 1) < 4 * k^2 * (k + 2) :=
    (Nat.mul_lt_mul_left hA).mpr (by omega)
  have hthreshold : ((4 * k^2) - 1) * ((k + 2) - 1) <
      ordering.secondPositionSequence.length := by
    rw [ordering.secondPositionSequence_length]
    rw [show (k + 2) - 1 = k + 1 by omega]
    exact (hfirst.trans hsecond).trans_le hlarge
  have hr : 2 ≤ 4 * k^2 := by nlinarith
  have hs : 2 ≤ k + 2 := by omega
  exact ⟨ordering, sourceLemma36_erdosSzekeres_distinct ordering.secondPositionSequence
    ordering.secondPositionSequence_nodup (4 * k^2) (k + 2) hr hs hthreshold⟩

private noncomputable def sourceLemma36_sortedSourceIndices {n : ℕ}
    (I : Finset (Fin n)) : List (Fin n) := by
  classical
  letI : DecidableRel (· ≤ · : Fin n → Fin n → Prop) := fun _ _ => inferInstance
  letI : IsTrans (Fin n) (· ≤ ·) := ⟨fun _ _ _ => le_trans⟩
  letI : IsAntisymm (Fin n) (· ≤ ·) := ⟨fun _ _ => Fin.le_antisymm⟩
  letI : IsTotal (Fin n) (· ≤ ·) := ⟨fun _ _ => le_total _ _⟩
  exact Finset.sort (· ≤ ·) I

private theorem sourceLemma36_sortedSourceIndices_nodup {n : ℕ}
    (I : Finset (Fin n)) : (sourceLemma36_sortedSourceIndices I).Nodup := by
  classical
  exact Finset.sort_nodup (· ≤ ·) I

private theorem sourceLemma36_sortedSourceIndices_toFinset {n : ℕ}
    (I : Finset (Fin n)) : (sourceLemma36_sortedSourceIndices I).toFinset = I := by
  classical
  exact Finset.sort_toFinset (· ≤ ·) I

private theorem sourceLemma36_sortedSourceIndices_length {n : ℕ}
    (I : Finset (Fin n)) : (sourceLemma36_sortedSourceIndices I).length = I.card := by
  classical
  rw [sourceLemma36_sortedSourceIndices, Finset.length_sort]

private theorem sourceLemma36_sortedSourceIndices_strictMono {n : ℕ}
    (I : Finset (Fin n)) : StrictMono (sourceLemma36_sortedSourceIndices I).get := by
  classical
  intro a b hab
  have hle := (Finset.sort_sorted (· ≤ ·) I).rel_get_of_lt hab
  have hne : (sourceLemma36_sortedSourceIndices I).get a ≠
      (sourceLemma36_sortedSourceIndices I).get b := by
    intro heq
    exact (ne_of_lt hab)
      (List.nodup_iff_injective_get.mp (sourceLemma36_sortedSourceIndices_nodup I) heq)
  exact lt_of_le_of_ne hle hne

/-- Graph-ready data for the decreasing second-position alternative.  Keeping
the ordering object retains both endpoint lookup identities for the later
crossladder construction. -/
private structure SourceLemma36LargeDecreasingSelection [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) where
  ordering : SourceLemma36LargeMatchingOrdering G C k Z data iP matching
  index : Fin (k + 2) → Fin ordering.orderedMatching.length
  edge : Fin (k + 2) → {e // e ∈ matching.P}
  edge_def : ∀ i, edge i = ordering.orderedMatching.get (index i)
  index_strictMono : StrictMono index
  edge_injective : Function.Injective edge
  first_descending : ∀ i j, i < j →
    ordering.firstPosition (edge j) < ordering.firstPosition (edge i)
  second_descending : ∀ i j, i < j →
    ordering.secondPosition (edge j) < ordering.secondPosition (edge i)

/-- Graph-ready data for the increasing second-position alternative. -/
private structure SourceLemma36LargeIncreasingSelection [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) where
  ordering : SourceLemma36LargeMatchingOrdering G C k Z data iP matching
  index : Fin (4 * k^2) → Fin ordering.orderedMatching.length
  edge : Fin (4 * k^2) → {e // e ∈ matching.P}
  edge_def : ∀ i, edge i = ordering.orderedMatching.get (index i)
  index_strictMono : StrictMono index
  edge_injective : Function.Injective edge
  first_descending : ∀ i j, i < j →
    ordering.firstPosition (edge j) < ordering.firstPosition (edge i)
  second_increasing : ∀ i j, i < j →
    ordering.secondPosition (edge i) < ordering.secondPosition (edge j)

/-- Transport the finite Erdős--Szekeres alternatives on the ordered matching
to graph-ready edge selections.  The decreasing alternative is exposed first,
matching the orientation used by the later source Lemma 3.6 construction. -/
private theorem sourceLemma36_caseB_large_matching_monotone
    [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (hlarge : sourceLemma36MatchingThreshold k ≤ matching.P.card) :
    Nonempty (SourceLemma36LargeDecreasingSelection G C k Z data iP matching) ∨
      Nonempty (SourceLemma36LargeIncreasingSelection G C k Z data iP matching) := by
  classical
  obtain ⟨ordering, hindices⟩ :=
    sourceLemma36_caseB_large_matching_indices G C hC k Z data iP matching hlarge
  have hseqOrderedLength : ordering.secondPositionSequence.length =
      ordering.orderedMatching.length := by
    rw [ordering.secondPositionSequence_def, List.length_map]
  rcases hindices with ⟨I, hIcard, hIncreasing⟩ | ⟨I, hIcard, hDecreasing⟩
  · right
    let selected := sourceLemma36_sortedSourceIndices I
    have hselectedLength : selected.length = 4 * k^2 := by
      rw [show selected = sourceLemma36_sortedSourceIndices I by rfl,
        sourceLemma36_sortedSourceIndices_length]
      exact hIcard
    let rawIndex : Fin (4 * k^2) → Fin ordering.secondPositionSequence.length := fun i =>
      selected.get (Fin.cast hselectedLength.symm i)
    have hrawStrict : StrictMono rawIndex := by
      intro i j hij
      dsimp [rawIndex]
      apply sourceLemma36_sortedSourceIndices_strictMono I
      simpa only [Fin.coe_cast] using hij
    let incIndex : Fin (4 * k^2) → Fin ordering.orderedMatching.length := fun i =>
      Fin.cast hseqOrderedLength (rawIndex i)
    have hincIndexStrict : StrictMono incIndex := by
      intro i j hij
      change (rawIndex i).val < (rawIndex j).val
      exact hrawStrict hij
    let incEdge : Fin (4 * k^2) → {e // e ∈ matching.P} := fun i =>
      ordering.orderedMatching.get (incIndex i)
    have hrawMem : ∀ i, rawIndex i ∈ I := by
      intro i
      rw [← sourceLemma36_sortedSourceIndices_toFinset I, List.mem_toFinset]
      exact List.get_mem _ _
    have hsequenceValue : ∀ i,
        ordering.secondPositionSequence.get (rawIndex i) =
          (ordering.secondPosition (incEdge i)).1 := by
      intro i
      simp only [ordering.secondPositionSequence_def, List.get_eq_getElem,
        List.getElem_map]
      rfl
    have hincEdgeInjective : Function.Injective incEdge := by
      intro i j hij
      apply hincIndexStrict.injective
      apply (List.nodup_iff_injective_get.mp ordering.orderedMatching_nodup)
      simpa only [incEdge] using hij
    exact ⟨{
      ordering := ordering
      index := incIndex
      edge := incEdge
      edge_def := by intro i; rfl
      index_strictMono := hincIndexStrict
      edge_injective := hincEdgeInjective
      first_descending := by
        intro i j hij
        exact ordering.firstPosition_descending _ _ (hincIndexStrict hij)
      second_increasing := by
        intro i j hij
        have hvalue := hIncreasing (hrawMem i) (hrawMem j) (hrawStrict hij)
        rw [hsequenceValue i, hsequenceValue j] at hvalue
        exact Fin.mk_lt_mk.mpr hvalue }⟩
  · left
    let selected := sourceLemma36_sortedSourceIndices I
    have hselectedLength : selected.length = k + 2 := by
      rw [show selected = sourceLemma36_sortedSourceIndices I by rfl,
        sourceLemma36_sortedSourceIndices_length]
      exact hIcard
    let rawIndex : Fin (k + 2) → Fin ordering.secondPositionSequence.length := fun i =>
      selected.get (Fin.cast hselectedLength.symm i)
    have hrawStrict : StrictMono rawIndex := by
      intro i j hij
      dsimp [rawIndex]
      apply sourceLemma36_sortedSourceIndices_strictMono I
      simpa only [Fin.coe_cast] using hij
    let decIndex : Fin (k + 2) → Fin ordering.orderedMatching.length := fun i =>
      Fin.cast hseqOrderedLength (rawIndex i)
    have hdecIndexStrict : StrictMono decIndex := by
      intro i j hij
      change (rawIndex i).val < (rawIndex j).val
      exact hrawStrict hij
    let decEdge : Fin (k + 2) → {e // e ∈ matching.P} := fun i =>
      ordering.orderedMatching.get (decIndex i)
    have hrawMem : ∀ i, rawIndex i ∈ I := by
      intro i
      rw [← sourceLemma36_sortedSourceIndices_toFinset I, List.mem_toFinset]
      exact List.get_mem _ _
    have hsequenceValue : ∀ i,
        ordering.secondPositionSequence.get (rawIndex i) =
          (ordering.secondPosition (decEdge i)).1 := by
      intro i
      simp only [ordering.secondPositionSequence_def, List.get_eq_getElem,
        List.getElem_map]
      rfl
    have hdecEdgeInjective : Function.Injective decEdge := by
      intro i j hij
      apply hdecIndexStrict.injective
      apply (List.nodup_iff_injective_get.mp ordering.orderedMatching_nodup)
      simpa only [decEdge] using hij
    exact ⟨{
      ordering := ordering
      index := decIndex
      edge := decEdge
      edge_def := by intro i; rfl
      index_strictMono := hdecIndexStrict
      edge_injective := hdecEdgeInjective
      first_descending := by
        intro i j hij
        exact ordering.firstPosition_descending _ _ (hdecIndexStrict hij)
      second_descending := by
        intro i j hij
        have hvalue := hDecreasing (hrawMem i) (hrawMem j) (hrawStrict hij)
        rw [hsequenceValue i, hsequenceValue j] at hvalue
        exact Fin.mk_lt_mk.mpr hvalue }⟩

/-- The source certificate for the decreasing alternative in Lemma 3.6.

Section 2 defines a `k`-crossladder from a `k`-ladder and one additional
path.  In the decreasing alternative of Lemma 3.6, the `k + 2` selected
matching edges are numbered `u₁v₁, …, uₖ₊₂vₖ₊₂`: the two outer edges are
the boundary edges used to form the source cycle `C′`, and the middle `k`
edges are the ladder paths.  This proof-local certificate retains precisely
that data before the later construction of `C′`; in particular it does not
discard the endpoint order or replace the matching edges by abstract chords.
-/
private structure SourceLemma36KCrossladderCertificate [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) where
  selection : SourceLemma36LargeDecreasingSelection G C k Z data iP matching
  firstVertex : Fin (k + 2) → V
  secondVertex : Fin (k + 2) → V
  firstVertex_def : ∀ i, firstVertex i = (selection.edge i).1.1
  secondVertex_def : ∀ i, secondVertex i = (selection.edge i).1.2
  edge : ∀ i, G.Adj (firstVertex i) (secondVertex i)
  edge_off_cycle : ∀ i, s(firstVertex i, secondVertex i) ∉ C.edges
  rooted_in_Z : ∀ i, firstVertex i ∈ Z
  firstPosition : Fin (k + 2) →
    Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length
  secondPosition : Fin (k + 2) →
    Fin (sourceLemma36ComplementOrderAt G C hC k Z data iP).length
  firstPosition_vertex : ∀ i,
    (sourceLemma36RotatedCycleOrder G C data.anchor).get (firstPosition i) = firstVertex i
  secondPosition_vertex : ∀ i,
    (sourceLemma36ComplementOrderAt G C hC k Z data iP).get (secondPosition i) = secondVertex i
  first_descending : ∀ i j, i < j → firstPosition j < firstPosition i
  second_descending : ∀ i j, i < j → secondPosition j < secondPosition i
  endpoint_disjoint : ∀ {i j}, i ≠ j →
    firstVertex i ≠ firstVertex j ∧ firstVertex i ≠ secondVertex j ∧
      secondVertex i ≠ firstVertex j ∧ secondVertex i ≠ secondVertex j
  endpoint_ne : ∀ i, firstVertex i ≠ secondVertex i
  /-- The middle edges, indexed as `u₂v₂, …, uₖ₊₁vₖ₊₁` in the source. -/
  rung : Fin k → {e // e ∈ matching.P}
  rung_def : ∀ i, rung i = selection.edge ⟨i.1 + 1, by omega⟩
  /-- The two boundary matching edges `u₁v₁` and `uₖ₊₂vₖ₊₂`. -/
  first_boundary : {e // e ∈ matching.P}
  last_boundary : {e // e ∈ matching.P}
  first_boundary_def : first_boundary = selection.edge 0
  last_boundary_def : last_boundary = selection.edge (Fin.last (k + 1))

/-- Assemble the exact decreasing Lemma 3.6 edge certificate used by the
source `k`-crossladder construction.  The later cycle construction consumes
the retained two boundary edges and the `k` middle rungs directly. -/
private theorem sourceLemma36_large_decreasing_yields_crossladder_certificate
    [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (selection : SourceLemma36LargeDecreasingSelection G C k Z data iP matching) :
    Nonempty (SourceLemma36KCrossladderCertificate G C k Z data iP matching) := by
  let firstVertex : Fin (k + 2) → V := fun i => (selection.edge i).1.1
  let secondVertex : Fin (k + 2) → V := fun i => (selection.edge i).1.2
  have hcandidate : ∀ i, (selection.edge i).1 ∈
      sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP := by
    intro i
    exact matching.matching.1 (selection.edge i).2
  have hroot : ∀ i, firstVertex i ∈ Z := by
    intro i
    exact (sourceLemma36_mem_caseB_rootsAt_iff G C hC k Z data iP _).mp
      (sourceLemma36_caseB_matchingAt_first_endpoint_mem_rootsAt
        G C hC k Z data iP matching (selection.edge i).2) |>.1
  have hedge : ∀ i, G.Adj (firstVertex i) (secondVertex i) := by
    intro i
    exact (sourceLemma36_offCycle_adj G C
      ((sourceLemma36_mem_caseB_candidateAt_iff G C hC k Z data iP _).mp
        (hcandidate i)).2.1).1
  have hoff : ∀ i, s(firstVertex i, secondVertex i) ∉ C.edges := by
    intro i
    exact (sourceLemma36_offCycle_adj G C
      ((sourceLemma36_mem_caseB_candidateAt_iff G C hC k Z data iP _).mp
        (hcandidate i)).2.1).2
  have hdisjoint : ∀ {i j}, i ≠ j →
      firstVertex i ≠ firstVertex j ∧ firstVertex i ≠ secondVertex j ∧
        secondVertex i ≠ firstVertex j ∧ secondVertex i ≠ secondVertex j := by
    intro i j hij
    have hedges : selection.edge i ≠ selection.edge j := by
      exact fun h => hij (selection.edge_injective h)
    have hraw : (selection.edge i).1 ≠ (selection.edge j).1 := by
      exact fun h => hedges (Subtype.ext h)
    simpa only [firstVertex, secondVertex] using
      matching.matching.2 (selection.edge i).1 (selection.edge i).2
        (selection.edge j).1 (selection.edge j).2 hraw
  refine ⟨{
    selection := selection
    firstVertex := firstVertex
    secondVertex := secondVertex
    firstVertex_def := by intro i; rfl
    secondVertex_def := by intro i; rfl
    edge := hedge
    edge_off_cycle := hoff
    rooted_in_Z := hroot
    firstPosition := selection.ordering.firstPosition ∘ selection.edge
    secondPosition := selection.ordering.secondPosition ∘ selection.edge
    firstPosition_vertex := by
      intro i
      simpa only [Function.comp_apply, firstVertex] using
        selection.ordering.firstPosition_get (selection.edge i)
    secondPosition_vertex := by
      intro i
      simpa only [Function.comp_apply, secondVertex] using
        selection.ordering.secondPosition_get (selection.edge i)
    first_descending := by
      intro i j hij
      exact selection.first_descending i j hij
    second_descending := by
      intro i j hij
      exact selection.second_descending i j hij
    endpoint_disjoint := hdisjoint
    endpoint_ne := by
      intro i
      exact (hedge i).ne
    rung := fun i => selection.edge ⟨i.1 + 1, by omega⟩
    rung_def := by intro i; rfl
    first_boundary := selection.edge 0
    last_boundary := selection.edge (Fin.last (k + 1))
    first_boundary_def := rfl
    last_boundary_def := rfl }⟩

/-- Source-name audit for the decreasing alternative of Lemma 3.6.

In the paper the matching is written `vᵢuᵢ`, with `vᵢ` on the chordless
piece `P` and `uᵢ` on `C - P`.  Thus the Lean certificate deliberately uses
`firstVertex i` for the paper's `vᵢ`, and `secondVertex i` for the paper's
`uᵢ`.  This fact is recorded separately from the boundary-cycle construction:
the two displayed orders live in different linearizations of the *same*
Hamiltonian cycle and must not be silently interchanged when recovering the
Section-2 ladder order. -/
private theorem sourceLemma36_kCrossladder_paper_endpoint_mapping
    [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (certificate : SourceLemma36KCrossladderCertificate G C k Z data iP matching) :
    (∀ i, certificate.firstVertex i ∈ Z ∧
      certificate.firstVertex i ∈ sourceLemma36CanonicalPieceVertices G C hC k Z data iP) ∧
    (∀ i, certificate.secondVertex i ∈
      sourceLemma36ComplementOrderAt G C hC k Z data iP) ∧
    (∀ i j, i < j → certificate.firstPosition j < certificate.firstPosition i) ∧
    (∀ i j, i < j → certificate.secondPosition j < certificate.secondPosition i) := by
  refine ⟨?_, ?_, certificate.first_descending, certificate.second_descending⟩
  · intro i
    constructor
    · exact certificate.rooted_in_Z i
    · rw [certificate.firstVertex_def]
      exact (sourceLemma36_mem_caseB_rootsAt_iff G C hC k Z data iP _).mp
        ((sourceLemma36_mem_caseB_candidateAt_iff G C hC k Z data iP _).mp
          (matching.matching.1 (certificate.selection.edge i).2)).1 |>.2
  · intro i
    rw [← certificate.secondPosition_vertex i]
    exact List.get_mem _ _

