      _ = i.val := by
        rw [sourceLemma39_idxOf_map Subtype.val Subtype.val_injective, hs,
                List.idxOf_append_of_mem (hi ▸ L.get_mem i), ← hi]
        exact sourceLemma36_idxOf_get_eq_position L (sourceLemma36_rotatedCycleOrder_nodup H E hE root) i
  have hpa := idx x p hp
  have hqb := idx y q hq
