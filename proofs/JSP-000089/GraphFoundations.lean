        rw [hfst, hsnd]
    · rcases sourceLemma34_orientedSide_support_intersection G C hC f v
        hfalseSnd htrueSnd with hsnd | hsnd
      · apply hEdge
        change s(u, v) = s(f.fst, f.snd)
        rw [hfst, hsnd]
        simp only [Sym2.eq_swap]
      · exact huv.ne (hfst.trans hsnd.symm)
  · exact ⟨false, hfalse⟩

