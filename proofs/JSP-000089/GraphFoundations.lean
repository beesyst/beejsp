  rcases hxEndpoint with hxfst | hxsnd
  · rcases hcrossFalse with hinside | hinside
    · exact False.elim (hxOutMiddle (by simpa [hxfst] using hinside.1.1))
    · refine ⟨false, Or.inr ⟨?_, by simpa [hxfst] using hxOutRung⟩⟩
