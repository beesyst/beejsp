    rw [Walk.mem_support_append_iff, Walk.mem_support_append_iff] at hzD
    rcases hzD with hzI | hzR | hzP
    · exact Set.disjoint_left.mp hAC hzA (hIC z hzI)
    · have hzC : z ∉ C.support := fun h => Set.disjoint_left.mp hAC hzA h
      have hzRi : z ∈ internalVertices G R := ⟨hzR, fun h => hzC (h.symm ▸ y.property), fun h => hzC (h.symm ▸ w.property)⟩
      exact Set.disjoint_left.mp (sourceLemma39_selected_replacements_internal_disjoint G shadow hoy' A R hcomp hRcomp) hzA hzRi
    · rw [Walk.support_reverse, List.mem_reverse] at hzP
      have hzC : z ∉ C.support := fun h => Set.disjoint_left.mp hAC hzA h
      have hzPi : z ∈ internalVertices G P := ⟨hzP, fun h => hzC (h.symm ▸ x.property), fun h => hzC (h.symm ▸ w.property)⟩
      exact Set.disjoint_left.mp (sourceLemma39_selected_replacements_internal_disjoint G shadow hox' A P hcomp hPcomp) hzA hzPi
