    (certificate : SourceLemma36KCrossladderCertificate G C k Z data iP matching)
    (i : Fin k) :
    (sourceLemma36KCrossladderRungPath G C k Z data iP matching certificate i).IsPath := by
  rw [sourceLemma36KCrossladderRungPath, Walk.cons_isPath_iff]
  constructor
  · exact Walk.IsPath.nil
  · simpa only [Walk.support_nil, List.mem_singleton] using
      (certificate.endpoint_ne ⟨i.1 + 1, by omega⟩)

