  · apply (sourceLemma34_crosses_iff_exists_at G C hC f g).2
    refine ⟨false, ?_⟩
    dsimp [sourceLemma34CrossesAt] at hcrossAvoid ⊢
    rcases hcrossAvoid with hA | hA
    · left
      refine ⟨⟨by rw [← hpath, hS]; exact hA.1.1,
        by simpa [f', g', sourceLemma34_restrictChord] using hA.1.2.1,
        by simpa [f', g', sourceLemma34_restrictChord] using hA.1.2.2⟩, ?_⟩
      intro hm; apply hA.2; rw [← hpath, hS] at hm; exact hm
    · right
      refine ⟨⟨by rw [← hpath, hS]; exact hA.1.1,
        by simpa [f', g', sourceLemma34_restrictChord] using hA.1.2.1,
        by simpa [f', g', sourceLemma34_restrictChord] using hA.1.2.2⟩, ?_⟩
      intro hm; apply hA.2; rw [← hpath, hS] at hm; exact hm
  · apply (sourceLemma34_crosses_iff_exists_at G C hC f g).2
