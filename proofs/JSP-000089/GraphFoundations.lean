/-- Two separated paths with disjoint physical edges close to a simple cycle,
including the case where either path has just one edge. -/
theorem sourceLemma23_splice_cycle_of_edge_disjoint [DecidableEq V] {a b : V}
    (P : G.Walk a b) (Q : G.Walk b a) (hP : P.IsPath) (hQ : Q.IsPath)
    (hne : a ≠ b) (hedges : Disjoint P.edges.toFinset Q.edges.toFinset)
    (hinter : ∀ z, z ∈ P.support → z ∈ Q.support → z = a ∨ z = b) :
    (P.append Q).IsCycle := by
  have hnon : ¬ P.Nil := Walk.not_nil_of_ne hne
  have hnotA : a ∉ P.tail.support := by
    rw [Walk.support_tail_of_not_nil P hnon]
    have hn := hP.support_nodup
    rw [P.support_eq_cons] at hn
    exact (List.nodup_cons.mp hn).1
  have hnotB : b ∉ Q.support.tail := by
    have hn := hQ.support_nodup
    rw [Q.support_eq_cons] at hn
    exact (List.nodup_cons.mp hn).1
  have htail : (P.tail.append Q).IsPath := by
    apply Walk.IsPath.mk'
    rw [Walk.support_append]
    apply List.Nodup.append hP.tail.support_nodup hQ.support_nodup.tail
    rw [List.disjoint_left]
    intro z hzP hzQ
    have hzP' : z ∈ P.support := by
      rw [Walk.support_tail_of_not_nil P hnon] at hzP
      exact List.mem_of_mem_tail hzP
    rcases hinter z hzP' (List.mem_of_mem_tail hzQ) with rfl | rfl
    · exact hnotA hzP
    · exact hnotB hzQ
  have hfirst : s(a,P.snd) ∈ P.edges := by
    have he := congrArg Walk.edges (P.cons_tail_eq hnon)
    rw [Walk.edges_cons] at he
    rw [← he]
    exact List.mem_cons_self
  have hfirst_not_tail : s(a,P.snd) ∉ P.tail.edges := by
    have ht := hP.isTrail
    rw [← P.cons_tail_eq hnon] at ht
    exact (Walk.cons_isTrail_iff _ _).mp ht |>.2
  have hfirst_not_Q : s(a,P.snd) ∉ Q.edges := fun he =>
    Finset.disjoint_left.mp hedges (List.mem_toFinset.mpr hfirst) (List.mem_toFinset.mpr he)
  rw [← P.cons_tail_eq hnon, Walk.cons_append]
  apply (Walk.cons_isCycle_iff _ _).mpr
  refine ⟨htail, ?_⟩
  rw [Walk.edges_append, List.mem_append]
  exact fun h => h.elim hfirst_not_tail hfirst_not_Q

/-- The corrected edge contract supplies both physical baseline cycles of
Lemma 2.3. Rail localization is a separate requirement for the later switches. -/
theorem sourceLemma23_crossladder_baseline_cycles
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (L : SourceLemma39AmbientCrossladder G C k) :
    ((sourceOrientedCycleSubpath G C L.u_on_cycle L.v_on_cycle).append L.q.reverse).IsCycle ∧
    ((sourceOrientedCycleSubpath G C L.v_on_cycle L.u_on_cycle).append L.q).IsCycle := by
  have build {a b : V} (ha : a ∈ C.support) (hb : b ∈ C.support)
      (P : G.Walk b a) (hP : P.IsPath) (hne : a ≠ b)
      (hout : Disjoint (internalVertices G P) {z | z ∈ C.support})
      (hedges : Disjoint P.edges.toFinset C.edges.toFinset) :
      ((sourceOrientedCycleSubpath G C ha hb).append P).IsCycle := by
    apply sourceLemma23_splice_cycle_of_edge_disjoint G _ P
      (sourceLemma33_oriented_subpath_isPath G C L.isCycle ha hb) hP hne
    · apply Finset.disjoint_left.mpr
      intro e heArc heP
      exact Finset.disjoint_left.mp hedges heP (List.mem_toFinset.mpr
        (sourceLemma34_oriented_subpath_edges_subset G C ha hb e (List.mem_toFinset.mp heArc)))
    · intro z hzArc hzP
      have hzC := sourceLemma33_oriented_subpath_support_subset G C ha hb z hzArc
      by_contra hn
      push_neg at hn
      exact Set.disjoint_left.mp hout ⟨hzP, hn.2, hn.1⟩ hzC
  constructor
  · apply build L.u_on_cycle L.v_on_cycle L.q.reverse L.q_isPath.reverse L.u_ne_v
    · apply Set.disjoint_left.mpr
      intro z hz hzC
      rcases hz with ⟨hz, hnv, hnu⟩
      exact Set.disjoint_left.mp L.q_internal_disjoint_cycle
        ⟨by simpa only [Walk.support_reverse, List.mem_reverse] using hz, hnu, hnv⟩ hzC
    · simpa only [Walk.edges_reverse, List.toFinset_reverse] using L.q_edges_disjoint_cycle
  · exact build L.v_on_cycle L.u_on_cycle L.q L.q_isPath L.u_ne_v.symm
      L.q_internal_disjoint_cycle L.q_edges_disjoint_cycle

/-- Pairwise rung support separation already excludes every shared rung edge. -/
theorem sourceLemma23_crossladder_rung_edges_disjoint
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (L : SourceLemma39AmbientCrossladder G C k) {i j : Fin k} (hij : i ≠ j) :
