        y ∈ (sourceLemma38Qu G C k hk Z data iP matching ladder i).support) ∨
      (x ∈ (sourceLemma38Qv G C k hk Z data iP matching ladder i).support ∧
        y ∈ (sourceLemma38Qv G C k hk Z data iP matching ladder i).support) := hydata.2.2
