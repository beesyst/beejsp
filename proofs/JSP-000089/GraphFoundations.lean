  have hbD := hsub b rail.end_mem_support
  have hcD := hsub c hc
  have hmeet := sourceLemma39_net_attachment_intersection G D A B hcD hbD hh hcb
    houtA houtB hAB
  have htail : (A.append B.reverse).IsPath := by
    apply sourceLemma39_splice_paths G A B.reverse hA hB.reverse
    intro z hzA hzB
    rw [Walk.support_reverse, List.mem_reverse] at hzB
    exact hmeet z hzA hzB
  have hpath : ((rail.takeUntil c hc).append (A.append B.reverse)).IsPath := by
    apply sourceLemma39_splice_paths G _ _ (hrail.takeUntil hc) htail
    intro z hzR hz
    have hzD := hsub z (rail.support_takeUntil_subset hc hzR)
    rw [Walk.mem_support_append_iff, Walk.support_reverse, List.mem_reverse] at hz
    rcases hz with hzA | hzB
    · by_contra hzc
      have hzh : z ≠ h := fun he => hh (he ▸ hzD)
      exact Set.disjoint_left.mp houtA ⟨hzA, hzc, hzh⟩ hzD
    · have hzb : z = b := by
        by_contra hzb
        have hzh : z ≠ h := fun he => hh (he ▸ hzD)
        exact Set.disjoint_left.mp houtB ⟨hzB, hzb, hzh⟩ hzD
      subst z
      exact (sourceLemma32_takeUntil_not_end G hrail hc hcb hzR).elim
  refine ⟨hpath, ?_, ?_, ?_, ?_⟩
  · intro z
    simp only [Walk.mem_support_append_iff, Walk.support_reverse, List.mem_reverse]
  · intro z hz hzD
    rw [Walk.mem_support_append_iff, Walk.mem_support_append_iff,
      Walk.support_reverse, List.mem_reverse] at hz
    rcases hz with hzR | hzA | hzB
    · exact rail.support_takeUntil_subset hc hzR
    · by_cases he : z = c
      · exact he ▸ hc
      · have hzh : z ≠ h := fun he => hh (he ▸ hzD)
        exact (Set.disjoint_left.mp houtA ⟨hzA, he, hzh⟩ hzD).elim
    · by_cases he : z = b
      · exact he ▸ rail.end_mem_support
      · have hzh : z ≠ h := fun he => hh (he ▸ hzD)
        exact (Set.disjoint_left.mp houtB ⟨hzB, he, hzh⟩ hzD).elim
  · simp only [Walk.length_append, Walk.length_reverse, Nat.add_assoc]
  · apply sourceLemma39_length_two_of_internal G _ (z := h)
    · rw [Walk.mem_support_append_iff, Walk.mem_support_append_iff]
      exact Or.inr (Or.inl A.end_mem_support)
    · exact fun he => hh (he ▸ hsub a rail.start_mem_support)
    · exact fun he => hh (he ▸ hbD)

/-- Source Lemma 2.2, second route: first attachment, reversed interior
attachment, rail suffix. All lengths and carrier intersections are explicit. -/
theorem sourceLemma39_net_route_suffix
    [DecidableEq V] {r a b c h : V}
    (D : G.Walk r r) (rail : G.Walk a b) (hc : c ∈ rail.support)
    (A : G.Walk a h) (B : G.Walk c h)
    (hrail : rail.IsPath) (hA : A.IsPath) (hB : B.IsPath)
