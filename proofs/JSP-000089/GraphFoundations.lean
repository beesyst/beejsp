/-- Two disjoint groups of positive increments yield positive translated
prefix-sum sets; the empty-group case produces valid singleton sets. -/
theorem sourceLemma21_subsetSums_spectrum [Fintype V] [DecidableEq V]
    {k m base : ℕ} (delta : Fin k → ℕ) (hgroups : 2 * m ≤ k)
    (hbase : 2 ≤ base) (hpos : ∀ i, 0 < delta i)
    (hcycles : ∀ I : Finset (Fin k), IsCycleLength G (base + ∑ i ∈ I, delta i)) :
    ∃ A B : Finset ℕ, m + 1 ≤ A.card ∧ m + 1 ≤ B.card ∧
      (∀ a ∈ A, 0 < a) ∧ (∀ b ∈ B, 0 < b) ∧
      ∀ a ∈ A, ∀ b ∈ B, IsCycleLength G (a + b) := by
  classical
  let L := fun t : Fin (m + 1) => (Finset.univ : Finset (Fin k)).filter fun i => i.val < t.val
  let R := fun t : Fin (m + 1) => (Finset.univ : Finset (Fin k)).filter fun i =>
    m ≤ i.val ∧ i.val < m + t.val
  let f := fun t : Fin (m + 1) => 1 + ∑ i ∈ L t, delta i
  let g := fun t : Fin (m + 1) => (base - 1) + ∑ i ∈ R t, delta i
  have hf : StrictMono f := by
    intro s t hst
    have hv : s.val < t.val := hst
    have hs : s.val < m := by have := t.isLt; omega
    let i : Fin k := ⟨s.val, by omega⟩
    have hsub : L s ⊆ L t := by
      intro j hj
      simp only [L, Finset.mem_filter, Finset.mem_univ, true_and] at hj ⊢
      omega
    have hit : i ∈ L t := by simp only [L, Finset.mem_filter, Finset.mem_univ, true_and]; exact hv
    have his : i ∉ L s := by simp [L, i]
    have hlt := Finset.sum_lt_sum_of_subset hsub hit his (hpos i) (fun j _ _ => Nat.zero_le (delta j))
    dsimp only [f]
    omega
  have hg : StrictMono g := by
    intro s t hst
    have hv : s.val < t.val := hst
    have hs : s.val < m := by have := t.isLt; omega
    let i : Fin k := ⟨m + s.val, by omega⟩
    have hsub : R s ⊆ R t := by
      intro j hj
      simp only [R, Finset.mem_filter, Finset.mem_univ, true_and] at hj ⊢
      omega
    have hit : i ∈ R t := by
      simp only [R, Finset.mem_filter, Finset.mem_univ, true_and]
      change m ≤ m + s.val ∧ m + s.val < m + t.val
      omega
    have his : i ∉ R s := by simp [R, i]
    have hlt := Finset.sum_lt_sum_of_subset hsub hit his (hpos i) (fun j _ _ => Nat.zero_le (delta j))
    dsimp only [g]
    omega
  let A := Finset.univ.image f
  let B := Finset.univ.image g
  have hA : A.card = m + 1 := by
    dsimp only [A]
    rw [Finset.card_image_of_injective _ hf.injective, Finset.card_univ, Fintype.card_fin]
  have hB : B.card = m + 1 := by
    dsimp only [B]
    rw [Finset.card_image_of_injective _ hg.injective, Finset.card_univ, Fintype.card_fin]
  refine ⟨A, B, hA.ge, hB.ge, ?_, ?_, ?_⟩
  · intro a ha
    obtain ⟨t, _, rfl⟩ := Finset.mem_image.mp ha
    dsimp [f]
    omega
  · intro b hb
    obtain ⟨t, _, rfl⟩ := Finset.mem_image.mp hb
    dsimp [g]
    omega
  · intro a ha b hb
    obtain ⟨s, _, rfl⟩ := Finset.mem_image.mp ha
    obtain ⟨t, _, rfl⟩ := Finset.mem_image.mp hb
    have hdis : Disjoint (L s) (R t) := by
      apply Finset.disjoint_left.mpr
      intro i hiL hiR
      simp only [L, R, Finset.mem_filter, Finset.mem_univ, true_and] at hiL hiR
      have := s.isLt
      omega
    have hcycle := hcycles (L s ∪ R t)
    rw [Finset.sum_union hdis] at hcycle
    have heq : f s + g t = base + ((∑ i ∈ L s, delta i) + ∑ i ∈ R t, delta i) := by
      dsimp [f, g]
      omega
    exact heq ▸ hcycle

