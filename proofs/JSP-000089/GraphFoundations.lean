/-- A four-vertex component whose vertices lie in either of two sets contains
an edge with both ends on one side.  This is the precise finite
pigeonhole step used by the repaired all-inside branch; it makes no
root-incidence assertion. -/
private theorem sourceLemma38_k4_same_side_pair [DecidableEq V]
    (K : Finset V) (hKcard : K.card = 4) (A B : Set V)
    (hcover : ∀ x, x ∈ K → x ∈ A ∨ x ∈ B) :
    ∃ x ∈ K, ∃ y ∈ K, x ≠ y ∧
      ((x ∈ A ∧ y ∈ A) ∨ (x ∈ B ∧ y ∈ B)) := by
  classical
  let side : V → Bool := fun x => decide (x ∈ A)
  obtain ⟨x, hxK, y, hyK, hxy, hside⟩ :=
    Finset.exists_ne_map_eq_of_card_lt_of_maps_to (s := K)
      (t := (Finset.univ : Finset Bool)) (by simpa [hKcard]) (fun z hz => Finset.mem_univ _)
  refine ⟨x, hxK, y, hyK, hxy, ?_⟩
  by_cases hxA : x ∈ A
  · left
    refine ⟨hxA, ?_⟩
    have : side x = true := by simp [side, hxA]
    have hside' : side x = side y := hside
    have : side y = true := by rw [← hside']; exact this
    simpa [side] using this
  · right
    refine ⟨(hcover x hxK).resolve_left hxA, ?_⟩
    have hxFalse : side x = false := by simp [side, hxA]
    have hside' : side x = side y := hside
    have hyFalse : side y = false := by rw [← hside']; exact hxFalse
    have hyA : y ∉ A := by simpa [side] using hyFalse
    exact (hcover y hyK).resolve_left hyA

