/-- The `i`th consecutive group of roots, represented before forgetting the
linear cycle order. -/
private def sourceLemma36RootBlockList (orderedZ : List V) (q i : ℕ) : List V :=
  (orderedZ.drop (i * q)).take q

private noncomputable def sourceLemma36RootBlock [DecidableEq V]
    (orderedZ : List V) (q i : ℕ) : Finset V :=
