/-- The two complementary oriented sides partition the original cycle length. -/
private theorem sourceLemma34_oriented_sides_length_add [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (e : SourceLemma34Chord G C) (dir : Bool) :
    (sourceLemma34_orientedSide G C hC e dir).path.length +
      (sourceLemma34_orientedSide G C hC e (!dir)).path.length = C.length := by
  let R : G.Walk e.fst e.fst := C.rotate e.fst_mem
  have hsndR : e.snd ∈ R.support := sourceLemma34_snd_mem_rotate G C e
  let Q : G.Walk e.fst e.snd := R.takeUntil e.snd hsndR
  let P : G.Walk e.snd e.fst := R.dropUntil e.snd hsndR
  have hsplit : Q.append P = R := by
    dsimp [Q, P]
    exact R.take_spec hsndR
  have hRlength : R.length = C.length := by
    rw [← R.length_edges, ← C.length_edges]
    exact (C.rotate_edges e.fst_mem).perm.length_eq
  cases dir
  · change Q.length + P.reverse.length = C.length
    rw [Walk.length_reverse, ← Walk.length_append, hsplit, hRlength]
  · change P.reverse.length + Q.length = C.length
    rw [Walk.length_reverse, Nat.add_comm, ← Walk.length_append, hsplit, hRlength]

