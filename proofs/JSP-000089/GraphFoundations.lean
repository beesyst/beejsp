/-- The three unrooted conclusions available from a residual Lemma 3.6
ladder.  The truncation and mesh alternatives intentionally impose no root or
`Z`-incidence condition. -/
private inductive SourceLemma37ResidualUnrootedResult [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (hk : 1 ≤ k)
    (Z : Finset V) (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching) : Prop where
  | block : (∃ i, sourceLemma37BlockCrossladder G C k hk Z data iP matching ladder i) →
      SourceLemma37ResidualUnrootedResult C hC k hk Z data iP matching ladder
  | truncation : Nonempty (SourceLemma37UnrootedProperTruncation G C hC k) →
      SourceLemma37ResidualUnrootedResult C hC k hk Z data iP matching ladder
