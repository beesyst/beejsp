/-! Physical adjacent-rung switching for source Lemma 2.3. -/

/-- The first-side detour follows rung i, the opposite rail backwards, and
rung j backwards. It is a physical walk in the original graph. -/
noncomputable def sourceLemma23_first_detour
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (L : SourceLemma39AmbientCrossladder G C k) (i j : Fin k) :
    G.Walk (L.firstVertex i) (L.firstVertex j) :=
  (L.rung i).append ((sourceOrientedCycleSubpath G C
    (L.second_on_cycle j) (L.second_on_cycle i)).reverse.append (L.rung j).reverse)

/-- The second-side detour follows rung j backwards, the first rail
backwards, and rung i. Its direction matches the directed second rail. -/
noncomputable def sourceLemma23_second_detour
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (L : SourceLemma39AmbientCrossladder G C k) (i j : Fin k) :
    G.Walk (L.secondVertex j) (L.secondVertex i) :=
  (L.rung j).reverse.append ((sourceOrientedCycleSubpath G C
    (L.first_on_cycle i) (L.first_on_cycle j)).reverse.append (L.rung i))

/-- Rung endpoints on the two rails are distinct, even for a one-edge rung. -/
theorem sourceLemma23_crossladder_endpoint_ne
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (L : SourceLemma39AmbientCrossladder G C k) (i j : Fin k) :
    L.firstVertex i ≠ L.secondVertex j := by
