/-- The direct net has a genuine ambient reduced net with exactly k² + 1
attachments per family. No same-owner boundary linkage is assumed. -/
theorem sourceLemma39_direct_net_reduced_ambient
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (shadow : SourceLemma39BranchIIShadowApplication G C k) (hk : 1 ≤ k)
    (T : Finset (sourceLemma39CycleVertices G C))
