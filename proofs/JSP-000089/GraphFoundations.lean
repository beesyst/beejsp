/-- Consecutive segments of a duplicate-free list retain their source order. -/
private theorem sourceLemma36_take_drop_idxOf_lt {V : Type*} [DecidableEq V]
    (L : List V) (hL : L.Nodup) (s : ℕ) {a b : V}
    (ha : a ∈ L.take s) (hb : b ∈ (L.drop s).take s) :
    L.idxOf a < L.idxOf b := by
  obtain ⟨i, hi, hia⟩ := List.mem_iff_getElem.mp ha
  obtain ⟨j, hj, hjb⟩ := List.mem_iff_getElem.mp hb
  have hilength : i < L.length := by
    rw [List.length_take] at hi
    exact lt_of_lt_of_le hi (Nat.min_le_right _ _)
  have his : i < s := by
    rw [List.length_take] at hi
    exact lt_of_lt_of_le hi (Nat.min_le_left _ _)
  have hjdrop : j < (L.drop s).length := by
    rw [List.length_take] at hj
    exact lt_of_lt_of_le hj (Nat.min_le_right _ _)
  have hsjlength : s + j < L.length := by
    rw [List.length_drop] at hjdrop
    omega
  have hiaL : L[i] = a := by
    rw [← hia]
    exact List.getElem_take.symm
  have hjbL : L[s + j] = b := by
    rw [← hjb]
    rw [List.getElem_take]
    exact List.getElem_drop.symm
  rw [← hiaL, ← hjbL, List.idxOf_getElem hL i hilength,
    List.idxOf_getElem hL (s + j) hsjlength]
  omega

/-- The ordered attachment blocks extracted from the winning common fibre in
the small-matching branch.  Their list order is the actual internal `x`--`y`
path order, not an auxiliary arbitrary order. -/
private structure SourceLemma36AttachmentBlocks [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (k : ℕ) (Z T : Finset V) (u w v x y : V) where
  common : SourceLemma36CommonFiberCPrimeGeometry G C k Z T u w v x y
  orderedFibre : List V
  orderedFibre_def : orderedFibre =
    common.geometry.x_y_path.val.support.filter (fun z => z ∈ common.fibre)
  orderedFibre_nodup : orderedFibre.Nodup
  orderedFibre_sublist_path : orderedFibre.Sublist common.geometry.x_y_path.val.support
  orderedFibre_toFinset : orderedFibre.toFinset = common.fibre
  orderedFibre_length : orderedFibre.length = common.fibre.card
  leftBlockList : List V
  leftBlockList_def : leftBlockList = orderedFibre.take (k^2 + 2)
  rightBlockList : List V
  rightBlockList_def : rightBlockList =
    (orderedFibre.drop (k^2 + 2)).take (k^2 + 2)
  leftBlockList_nodup : leftBlockList.Nodup
  rightBlockList_nodup : rightBlockList.Nodup
  leftBlockList_length : leftBlockList.length = k^2 + 2
  rightBlockList_length : rightBlockList.length = k^2 + 2
  leftBlock : Finset V
  leftBlock_def : leftBlock = leftBlockList.toFinset
  rightBlock : Finset V
  rightBlock_def : rightBlock = rightBlockList.toFinset
  leftBlock_card : leftBlock.card = k^2 + 2
  rightBlock_card : rightBlock.card = k^2 + 2
  leftBlock_subset_fibre : leftBlock ⊆ common.fibre
  rightBlock_subset_fibre : rightBlock ⊆ common.fibre
  blocks_disjoint : Disjoint leftBlock rightBlock
  left_before_right : ∀ a ∈ leftBlock, ∀ b ∈ rightBlock,
    orderedFibre.idxOf a < orderedFibre.idxOf b
  left_mem_Z : ∀ a ∈ leftBlock, a ∈ Z
  left_mem_cPrime : ∀ a ∈ leftBlock, a ∈ common.geometry.cPrime.support
  left_adj_u : ∀ a ∈ leftBlock, (sourceLemma36OffCycleGraph G C).Adj a u
  right_mem_Z : ∀ b ∈ rightBlock, b ∈ Z
  right_mem_cPrime : ∀ b ∈ rightBlock, b ∈ common.geometry.cPrime.support
  right_adj_v : ∀ b ∈ rightBlock, (sourceLemma36OffCycleGraph G C).Adj b v

/-- The small-matching common fibre contains two disjoint consecutive blocks
of exactly `k^2 + 2` vertices in the actual internal path order. -/
private theorem sourceLemma36_exists_ordered_attachmentBlocks
    [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (hno : ¬ sourceLemma36PieceHasChord G C hC k Z data iP)
    (hdegree : ∀ z ∈ sourceLemma36CaseBRootsAt G C hC k Z data iP, 5 ≤ G.degree z)
    (hsmall : matching.P.card < sourceLemma36MatchingThreshold k) :
    ∃ T u w v x y,
      Nonempty (SourceLemma36AttachmentBlocks G C k Z T u w v x y) := by
  obtain ⟨T, u, w, v, x, y, commonNonempty⟩ :=
    sourceLemma36_exists_commonFiber_cPrimeGeometry G C hC k Z data iP matching
      hno hdegree hsmall
  rcases commonNonempty with ⟨common⟩
  let orderedFibre : List V :=
    common.geometry.x_y_path.val.support.filter (fun z => z ∈ common.fibre)
  have horderedNodup : orderedFibre.Nodup := by
    exact common.geometry.x_y_path.isPath.support_nodup.filter _
  have horderedSublist : orderedFibre.Sublist common.geometry.x_y_path.val.support := by
    exact List.filter_sublist
  have horderedMem : ∀ z ∈ orderedFibre, z ∈ common.fibre := by
    intro z hz
    have hzFilter := (List.mem_filter.mp hz).2
    simpa using hzFilter
  have hfibreMem : ∀ z ∈ common.fibre, z ∈ orderedFibre := by
    intro z hz
    apply List.mem_filter.mpr
    refine ⟨common.fibre_mem_path z hz, ?_⟩
    simpa using hz
  have horderedToFinset : orderedFibre.toFinset = common.fibre := by
    ext z
    rw [List.mem_toFinset]
    constructor
    · exact horderedMem z
    · exact hfibreMem z
  have horderedLength : orderedFibre.length = common.fibre.card := by
    rw [← List.toFinset_card_of_nodup horderedNodup, horderedToFinset]
  let s := k^2 + 2
  have htwoS : 2 * s ≤ orderedFibre.length := by
    rw [horderedLength]
    simpa [s] using common.fibre_card
  have hsLength : s ≤ orderedFibre.length := by omega
  have hsDropLength : s ≤ (orderedFibre.drop s).length := by
    rw [List.length_drop]
    omega
  let leftBlockList := orderedFibre.take s
  let rightBlockList := (orderedFibre.drop s).take s
  have hleftNodup : leftBlockList.Nodup := by
    exact (List.take_sublist _ _).nodup horderedNodup
  have hrightNodup : rightBlockList.Nodup := by
    exact (List.take_sublist _ _).nodup ((List.drop_sublist _ _).nodup horderedNodup)
  have hleftLength : leftBlockList.length = s := by
    simp only [leftBlockList, List.length_take, Nat.min_eq_left hsLength]
  have hrightLength : rightBlockList.length = s := by
    simp only [rightBlockList, List.length_take, Nat.min_eq_left hsDropLength]
  let leftBlock := leftBlockList.toFinset
  let rightBlock := rightBlockList.toFinset
  have hleftSubset : leftBlock ⊆ common.fibre := by
    intro z hz
    simp only [leftBlock, List.mem_toFinset] at hz
    exact horderedMem z (List.take_subset _ _ hz)
  have hrightSubset : rightBlock ⊆ common.fibre := by
    intro z hz
    simp only [rightBlock, List.mem_toFinset] at hz
    exact horderedMem z ((List.drop_subset _ _) (List.take_subset _ _ hz))
  have hblocksDisjoint : Disjoint leftBlock rightBlock := by
    rw [Finset.disjoint_left]
    intro z hzLeft hzRight
    simp only [leftBlock, List.mem_toFinset] at hzLeft
    simp only [rightBlock, List.mem_toFinset] at hzRight
    exact (List.disjoint_take_drop horderedNodup (Nat.le_refl s) hzLeft)
      (List.take_subset _ _ hzRight)
  refine ⟨T, u, w, v, x, y, ⟨?_⟩⟩
  refine {
    common := common
    orderedFibre := orderedFibre
    orderedFibre_def := rfl
    orderedFibre_nodup := horderedNodup
    orderedFibre_sublist_path := horderedSublist
    orderedFibre_toFinset := horderedToFinset
    orderedFibre_length := horderedLength
    leftBlockList := leftBlockList
    leftBlockList_def := rfl
    rightBlockList := rightBlockList
    rightBlockList_def := rfl
    leftBlockList_nodup := hleftNodup
    rightBlockList_nodup := hrightNodup
    leftBlockList_length := by simpa [s] using hleftLength
    rightBlockList_length := by simpa [s] using hrightLength
    leftBlock := leftBlock
    leftBlock_def := rfl
    rightBlock := rightBlock
    rightBlock_def := rfl
    leftBlock_card := by
      simp only [leftBlock, List.toFinset_card_of_nodup hleftNodup, hleftLength]
      rfl
    rightBlock_card := by
      simp only [rightBlock, List.toFinset_card_of_nodup hrightNodup, hrightLength]
      rfl
    leftBlock_subset_fibre := hleftSubset
    rightBlock_subset_fibre := hrightSubset
    blocks_disjoint := hblocksDisjoint
    left_before_right := by
      intro a ha b hb
      simp only [leftBlock, List.mem_toFinset] at ha
      simp only [rightBlock, List.mem_toFinset] at hb
      exact sourceLemma36_take_drop_idxOf_lt orderedFibre horderedNodup s ha hb
    left_mem_Z := fun a ha => common.fibre_subset_Z a (hleftSubset ha)
    left_mem_cPrime := fun a ha => common.fibre_mem_cPrime a (hleftSubset ha)
    left_adj_u := fun a ha => common.fibre_adj_u a (hleftSubset ha)
    right_mem_Z := fun b hb => common.fibre_subset_Z b (hrightSubset hb)
    right_mem_cPrime := fun b hb => common.fibre_mem_cPrime b (hrightSubset hb)
    right_adj_v := fun b hb => common.fibre_adj_v b (hrightSubset hb) }

/-- The exact small-matching `k^2`-net data used by source Lemma 3.6.  The
right family is indexed in reverse while its stored block remains in actual
internal-path order, matching the source's cyclic attachment notation. -/
private structure SourceLemma36KSquaredNet [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (k : ℕ) (Z T : Finset V) (u w v x y : V) where
  blocks : SourceLemma36AttachmentBlocks G C k Z T u w v x y
  leftVertex : Fin (k^2 + 2) → V
  rightVertex : Fin (k^2 + 2) → V
  leftVertex_def : ∀ i,
    leftVertex i = blocks.leftBlockList.get (Fin.cast blocks.leftBlockList_length.symm i)
  rightVertex_def : ∀ i,
    rightVertex i = blocks.rightBlockList.get (Fin.cast blocks.rightBlockList_length.symm i.rev)
  leftVertex_mem_block : ∀ i, leftVertex i ∈ blocks.leftBlock
  rightVertex_mem_block : ∀ i, rightVertex i ∈ blocks.rightBlock
  leftVertex_injective : Function.Injective leftVertex
  rightVertex_injective : Function.Injective rightVertex
  left_ne_right : ∀ i j, leftVertex i ≠ rightVertex j
  source_path_order :
    (blocks.leftBlockList ++ blocks.rightBlockList).Sublist
      blocks.common.geometry.x_y_path.val.support
  hub_u_ne_v : u ≠ v
  hub_u_not_mem_cycle : u ∉ blocks.common.geometry.cPrime.support
  hub_v_not_mem_cycle : v ∉ blocks.common.geometry.cPrime.support
  left_mem_Z : ∀ i, leftVertex i ∈ Z
  right_mem_Z : ∀ i, rightVertex i ∈ Z
  left_mem_cycle : ∀ i, leftVertex i ∈ blocks.common.geometry.cPrime.support
  right_mem_cycle : ∀ i, rightVertex i ∈ blocks.common.geometry.cPrime.support
  hub_u_ne_left : ∀ i, u ≠ leftVertex i
  hub_u_ne_right : ∀ i, u ≠ rightVertex i
  hub_v_ne_left : ∀ i, v ≠ leftVertex i
  hub_v_ne_right : ∀ i, v ≠ rightVertex i
  leftPath : ∀ i, G.Walk u (leftVertex i)
  rightPath : ∀ i, G.Walk v (rightVertex i)
  leftPath_isPath : ∀ i, (leftPath i).IsPath
  rightPath_isPath : ∀ i, (rightPath i).IsPath
  leftPath_length : ∀ i, (leftPath i).length = 1
  rightPath_length : ∀ i, (rightPath i).length = 1
  leftPath_internal_empty : ∀ i, internalVertices G (leftPath i) = ∅
  rightPath_internal_empty : ∀ i, internalVertices G (rightPath i) = ∅
  left_internal_disjoint_cycle : ∀ i,
    Disjoint (internalVertices G (leftPath i))
      (↑blocks.common.geometry.cPrime.support.toFinset : Set V)
  right_internal_disjoint_cycle : ∀ i,
    Disjoint (internalVertices G (rightPath i))
      (↑blocks.common.geometry.cPrime.support.toFinset : Set V)
  left_paths_internally_disjoint : ∀ i j,
    Disjoint (internalVertices G (leftPath i)) (internalVertices G (leftPath j))
  right_paths_internally_disjoint : ∀ i j,
    Disjoint (internalVertices G (rightPath i)) (internalVertices G (rightPath j))
  cross_paths_internally_disjoint : ∀ i j,
    Disjoint (internalVertices G (leftPath i)) (internalVertices G (rightPath j))

/-- Case B's small-matching alternative supplies the source-faithful `k^2`
net: the two attachment families are consecutive in the internal segment of
`C′`, while the right family receives the reversed source indexing. -/
private theorem sourceLemma36_caseB_small_matching_yields_net
    [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (hno : ¬ sourceLemma36PieceHasChord G C hC k Z data iP)
    (hdegree : ∀ z ∈ sourceLemma36CaseBRootsAt G C hC k Z data iP, 5 ≤ G.degree z)
    (hsmall : matching.P.card < sourceLemma36MatchingThreshold k) :
    ∃ T u w v x y, Nonempty (SourceLemma36KSquaredNet G C k Z T u w v x y) := by
  obtain ⟨T, u, w, v, x, y, blocksNonempty⟩ :=
    sourceLemma36_exists_ordered_attachmentBlocks G C hC k Z data iP matching
      hno hdegree hsmall
  rcases blocksNonempty with ⟨blocks⟩
  let leftVertex : Fin (k^2 + 2) → V := fun i =>
    blocks.leftBlockList.get (Fin.cast blocks.leftBlockList_length.symm i)
  let rightVertex : Fin (k^2 + 2) → V := fun i =>
    blocks.rightBlockList.get (Fin.cast blocks.rightBlockList_length.symm i.rev)
  have hleftMem : ∀ i, leftVertex i ∈ blocks.leftBlock := by
    intro i
    rw [blocks.leftBlock_def, List.mem_toFinset]
    exact List.get_mem _ _
  have hrightMem : ∀ i, rightVertex i ∈ blocks.rightBlock := by
    intro i
    rw [blocks.rightBlock_def, List.mem_toFinset]
    exact List.get_mem _ _
  have hleftInjective : Function.Injective leftVertex := by
    intro i j hij
    apply Fin.cast_injective blocks.leftBlockList_length.symm
    apply List.nodup_iff_injective_get.mp blocks.leftBlockList_nodup
    simpa only [leftVertex] using hij
  have hrightInjective : Function.Injective rightVertex := by
    intro i j hij
    apply Fin.rev_injective
    apply Fin.cast_injective blocks.rightBlockList_length.symm
    apply List.nodup_iff_injective_get.mp blocks.rightBlockList_nodup
    simpa only [rightVertex] using hij
  have hleftNeRight : ∀ i j, leftVertex i ≠ rightVertex j := by
    intro i j heq
    exact (Finset.disjoint_left.mp blocks.blocks_disjoint (hleftMem i))
      (heq ▸ hrightMem j)
  have hsourceOrder :
      (blocks.leftBlockList ++ blocks.rightBlockList).Sublist
        blocks.common.geometry.x_y_path.val.support := by
    rw [blocks.leftBlockList_def, blocks.rightBlockList_def]
    have hsub := List.Sublist.append (List.Sublist.refl (blocks.orderedFibre.take (k^2 + 2)))
      (List.take_sublist (k^2 + 2) (blocks.orderedFibre.drop (k^2 + 2)))
    have hsub' :
        (blocks.orderedFibre.take (k^2 + 2) ++
          (blocks.orderedFibre.drop (k^2 + 2)).take (k^2 + 2)).Sublist
          blocks.orderedFibre := by
      simpa only [List.take_append_drop] using hsub
    exact hsub'.trans blocks.orderedFibre_sublist_path
  have hleftGadj : ∀ i, G.Adj u (leftVertex i) := by
    intro i
    exact (sourceLemma36_offCycle_adj G C (blocks.left_adj_u _ (hleftMem i))).1.symm
  have hrightGadj : ∀ i, G.Adj v (rightVertex i) := by
    intro i
    exact (sourceLemma36_offCycle_adj G C (blocks.right_adj_v _ (hrightMem i))).1.symm
  let leftPath : ∀ i, G.Walk u (leftVertex i) := fun i => Walk.cons (hleftGadj i) .nil
  let rightPath : ∀ i, G.Walk v (rightVertex i) := fun i => Walk.cons (hrightGadj i) .nil
  have hleftPath : ∀ i, (leftPath i).IsPath := by
    intro i
    simp only [leftPath, Walk.cons_isPath_iff]
    constructor
    · exact Walk.IsPath.nil
    · simpa using (hleftGadj i).ne
  have hrightPath : ∀ i, (rightPath i).IsPath := by
    intro i
    simp only [rightPath, Walk.cons_isPath_iff]
    constructor
    · exact Walk.IsPath.nil
    · simpa using (hrightGadj i).ne
  have hleftInternal : ∀ i, internalVertices G (leftPath i) = ∅ := by
    intro i
    ext z
    simp [internalVertices, leftPath]
    intro hz hzu
    exact hz.resolve_left hzu
  have hrightInternal : ∀ i, internalVertices G (rightPath i) = ∅ := by
    intro i
    ext z
    simp [internalVertices, rightPath]
    intro hz hzv
    exact hz.resolve_left hzv
  refine ⟨T, u, w, v, x, y, ⟨?_⟩⟩
  refine {
    blocks := blocks
    leftVertex := leftVertex
    rightVertex := rightVertex
    leftVertex_def := fun _ => rfl
    rightVertex_def := fun _ => rfl
    leftVertex_mem_block := hleftMem
    rightVertex_mem_block := hrightMem
    leftVertex_injective := hleftInjective
    rightVertex_injective := hrightInjective
    left_ne_right := hleftNeRight
    source_path_order := hsourceOrder
    hub_u_ne_v := blocks.common.u_ne_v
    hub_u_not_mem_cycle := blocks.common.geometry.u_not_mem_cPrime
    hub_v_not_mem_cycle := blocks.common.geometry.v_not_mem_cPrime
    left_mem_Z := fun i => blocks.left_mem_Z _ (hleftMem i)
    right_mem_Z := fun i => blocks.right_mem_Z _ (hrightMem i)
    left_mem_cycle := fun i => blocks.left_mem_cPrime _ (hleftMem i)
    right_mem_cycle := fun i => blocks.right_mem_cPrime _ (hrightMem i)
    hub_u_ne_left := by
      intro i h
      apply blocks.common.geometry.u_not_mem_cPrime
      simpa only [← h] using blocks.left_mem_cPrime _ (hleftMem i)
    hub_u_ne_right := by
      intro i h
      apply blocks.common.geometry.u_not_mem_cPrime
      simpa only [← h] using blocks.right_mem_cPrime _ (hrightMem i)
    hub_v_ne_left := by
      intro i h
      apply blocks.common.geometry.v_not_mem_cPrime
      simpa only [← h] using blocks.left_mem_cPrime _ (hleftMem i)
    hub_v_ne_right := by
      intro i h
      apply blocks.common.geometry.v_not_mem_cPrime
      simpa only [← h] using blocks.right_mem_cPrime _ (hrightMem i)
    leftPath := leftPath
    rightPath := rightPath
    leftPath_isPath := hleftPath
    rightPath_isPath := hrightPath
    leftPath_length := by intro i; simp [leftPath]
    rightPath_length := by intro i; simp [rightPath]
    leftPath_internal_empty := hleftInternal
    rightPath_internal_empty := hrightInternal
    left_internal_disjoint_cycle := by
      intro i
      rw [hleftInternal i]
      exact Set.empty_disjoint _
    right_internal_disjoint_cycle := by
      intro i
      rw [hrightInternal i]
      exact Set.empty_disjoint _
    left_paths_internally_disjoint := by
      intro i j
      rw [hleftInternal i]
      exact Set.empty_disjoint _
    right_paths_internally_disjoint := by
      intro i j
      rw [hrightInternal i]
      exact Set.empty_disjoint _
    cross_paths_internally_disjoint := by
      intro i j
      rw [hleftInternal i]
      exact Set.empty_disjoint _ }

/-- The exact ordered carrier and distinct second-position sequence for the
large-matching alternative of source Lemma 3.6. -/
private structure SourceLemma36LargeMatchingOrdering [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) where
  firstPosition : {e // e ∈ matching.P} →
    Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length
  firstPosition_get : ∀ e,
    (sourceLemma36RotatedCycleOrder G C data.anchor).get (firstPosition e) = e.1.1
  firstPosition_injective : Function.Injective firstPosition
  orderedMatching : List {e // e ∈ matching.P}
  orderedMatching_nodup : orderedMatching.Nodup
  orderedMatching_toFinset : orderedMatching.toFinset = matching.P.attach
  orderedMatching_length : orderedMatching.length = matching.P.card
  firstPosition_descending : ∀ i j : Fin orderedMatching.length, i < j →
    firstPosition (orderedMatching.get j) < firstPosition (orderedMatching.get i)
  secondPosition : {e // e ∈ matching.P} →
    Fin (sourceLemma36ComplementOrderAt G C hC k Z data iP).length
  secondPosition_get : ∀ e,
    (sourceLemma36ComplementOrderAt G C hC k Z data iP).get (secondPosition e) = e.1.2
  secondPosition_injective : Function.Injective secondPosition
  secondPositionSequence : List ℕ
  secondPositionSequence_def : secondPositionSequence =
    orderedMatching.map fun e => (secondPosition e).1
  secondPositionSequence_length : secondPositionSequence.length = matching.P.card
  secondPositionSequence_nodup : secondPositionSequence.Nodup

/-- Under the large-matching hypothesis, order every matching edge by its
first endpoint in the distinguished piece and retain the duplicate-free
second-endpoint rank sequence for the next finite Erdős--Szekeres step. -/
private theorem sourceLemma36_caseB_large_matching_ordering
    [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (hlarge : sourceLemma36MatchingThreshold k ≤ matching.P.card) :
    Nonempty (SourceLemma36LargeMatchingOrdering G C k Z data iP matching) := by
  let firstPosition : {e // e ∈ matching.P} →
      Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length := fun e =>
    (sourceLemma36_canonicalPiece_position G C hC k Z data iP
      ((sourceLemma36_mem_caseB_rootsAt_iff G C hC k Z data iP e.1.1).mp
        (sourceLemma36_caseB_matchingAt_first_endpoint_mem_rootsAt
          G C hC k Z data iP matching e.2)).2).choose
  have hfirstGet : ∀ e,
      (sourceLemma36RotatedCycleOrder G C data.anchor).get (firstPosition e) = e.1.1 := by
    intro e
    exact (sourceLemma36_canonicalPiece_position G C hC k Z data iP
      ((sourceLemma36_mem_caseB_rootsAt_iff G C hC k Z data iP e.1.1).mp
        (sourceLemma36_caseB_matchingAt_first_endpoint_mem_rootsAt
          G C hC k Z data iP matching e.2)).2).choose_spec.2
  have hfirstInj : Function.Injective firstPosition := by
    intro e f hef
    apply Subtype.ext
    have hfst : e.1.1 = f.1.1 := by rw [← hfirstGet e, hef, hfirstGet f]
    by_cases heq : e.1 = f.1
    · exact heq
    · exact (matching.matching.2 e.1 e.2 f.1 f.2 heq).1 hfst |>.elim
  let firstOrder : {e // e ∈ matching.P} → {e // e ∈ matching.P} → Prop :=
    fun e f => firstPosition f ≤ firstPosition e
  letI : DecidableRel firstOrder := fun e f => inferInstance
  letI : IsTrans _ firstOrder := ⟨by
    intro a b c hab hbc
    exact hbc.trans hab⟩
  letI : IsAntisymm _ firstOrder := ⟨by
    intro a b hab hba
    exact hfirstInj (Fin.le_antisymm hba hab)⟩
  letI : IsTotal _ firstOrder := ⟨by
    intro a b
    exact le_total _ _⟩
  let orderedMatching := Finset.sort firstOrder matching.P.attach
  have horderedNodup : orderedMatching.Nodup := Finset.sort_nodup firstOrder matching.P.attach
  have horderedToFinset : orderedMatching.toFinset = matching.P.attach :=
    Finset.sort_toFinset firstOrder matching.P.attach
  have horderedLength : orderedMatching.length = matching.P.card := by
    simp only [orderedMatching, Finset.length_sort, Finset.card_attach]
  have hdescending : ∀ i j : Fin orderedMatching.length, i < j →
      firstPosition (orderedMatching.get j) < firstPosition (orderedMatching.get i) := by
    intro i j hij
    have hle := (Finset.sort_sorted firstOrder matching.P.attach).rel_get_of_lt hij
    have hne : firstPosition (orderedMatching.get j) ≠ firstPosition (orderedMatching.get i) := by
      intro heq
      apply (ne_of_lt hij)
      apply List.nodup_iff_injective_get.mp horderedNodup
      exact hfirstInj heq.symm
    exact lt_of_le_of_ne hle hne
  let secondPosition : {e // e ∈ matching.P} →
      Fin (sourceLemma36ComplementOrderAt G C hC k Z data iP).length := fun e =>
    (sourceLemma36_complementOrderAt_position G C hC k Z data iP
      ((sourceLemma36_mem_complementOrderAt_iff G C hC k Z data iP e.1.2).mp
        (sourceLemma36_caseB_matchingAt_second_mem_complementOrder
          G C hC k Z data iP matching e.2))).choose
  have hsecondGet : ∀ e,
      (sourceLemma36ComplementOrderAt G C hC k Z data iP).get (secondPosition e) = e.1.2 := by
    intro e
    exact (sourceLemma36_complementOrderAt_position G C hC k Z data iP
      ((sourceLemma36_mem_complementOrderAt_iff G C hC k Z data iP e.1.2).mp
        (sourceLemma36_caseB_matchingAt_second_mem_complementOrder
          G C hC k Z data iP matching e.2))).choose_spec
  have hsecondInj : Function.Injective secondPosition := by
    intro e f hef
    apply Subtype.ext
    apply sourceLemma36_matchingAt_second_injOn G C hC k Z data iP matching e.2 f.2
    rw [← hsecondGet e, hef, hsecondGet f]
  let secondPositionSequence := orderedMatching.map fun e => (secondPosition e).1
  have hsequenceLength : secondPositionSequence.length = matching.P.card := by
    simp only [secondPositionSequence, List.length_map, horderedLength]
  have hsequenceNodup : secondPositionSequence.Nodup := by
    apply List.Nodup.map_on _ horderedNodup
    intro a ha b hb hab
    apply hsecondInj
    apply Fin.ext
    exact hab
  exact ⟨{
    firstPosition := firstPosition
    firstPosition_get := hfirstGet
    firstPosition_injective := hfirstInj
    orderedMatching := orderedMatching
    orderedMatching_nodup := horderedNodup
    orderedMatching_toFinset := horderedToFinset
    orderedMatching_length := horderedLength
    firstPosition_descending := hdescending
    secondPosition := secondPosition
    secondPosition_get := hsecondGet
    secondPosition_injective := hsecondInj
    secondPositionSequence := secondPositionSequence
    secondPositionSequence_def := rfl
    secondPositionSequence_length := hsequenceLength
    secondPositionSequence_nodup := hsequenceNodup }⟩

/-- A finite set of source positions whose values increase with the source
order.  This is deliberately a proof-local representation of a subsequence:
the carrier itself consists of positions in `xs`. -/
private def SourceLemma36IncreasingIndexChain (xs : List ℕ)
    (I : Finset (Fin xs.length)) : Prop :=
  ∀ ⦃i j⦄, i ∈ I → j ∈ I → i < j → xs.get i < xs.get j

/-- The decreasing counterpart of `SourceLemma36IncreasingIndexChain`. -/
private def SourceLemma36DecreasingIndexChain (xs : List ℕ)
    (I : Finset (Fin xs.length)) : Prop :=
  ∀ ⦃i j⦄, i ∈ I → j ∈ I → i < j → xs.get j < xs.get i

private theorem sourceLemma36_increasingIndexChain_subset (xs : List ℕ)
    {I J : Finset (Fin xs.length)} (hI : SourceLemma36IncreasingIndexChain xs I)
    (hJI : J ⊆ I) : SourceLemma36IncreasingIndexChain xs J := by
  intro i j hi hj hij
  exact hI (hJI hi) (hJI hj) hij

private theorem sourceLemma36_decreasingIndexChain_subset (xs : List ℕ)
    {I J : Finset (Fin xs.length)} (hI : SourceLemma36DecreasingIndexChain xs I)
    (hJI : J ⊆ I) : SourceLemma36DecreasingIndexChain xs J := by
  intro i j hi hj hij
  exact hI (hJI hi) (hJI hj) hij

private noncomputable def sourceLemma36IncreasingChainsEndingAt (xs : List ℕ)
    (i : Fin xs.length) : Finset (Finset (Fin xs.length)) := by
  classical
  exact Finset.univ.filter fun I =>
    i ∈ I ∧ (∀ j ∈ I, j ≤ i) ∧ SourceLemma36IncreasingIndexChain xs I

private noncomputable def sourceLemma36DecreasingChainsEndingAt (xs : List ℕ)
    (i : Fin xs.length) : Finset (Finset (Fin xs.length)) := by
  classical
  exact Finset.univ.filter fun I =>
    i ∈ I ∧ (∀ j ∈ I, j ≤ i) ∧ SourceLemma36DecreasingIndexChain xs I

private theorem sourceLemma36_singleton_mem_increasingChainsEndingAt (xs : List ℕ)
    (i : Fin xs.length) : {i} ∈ sourceLemma36IncreasingChainsEndingAt xs i := by
  classical
  simp [sourceLemma36IncreasingChainsEndingAt, SourceLemma36IncreasingIndexChain]

private theorem sourceLemma36_singleton_mem_decreasingChainsEndingAt (xs : List ℕ)
    (i : Fin xs.length) : {i} ∈ sourceLemma36DecreasingChainsEndingAt xs i := by
  classical
  simp [sourceLemma36DecreasingChainsEndingAt, SourceLemma36DecreasingIndexChain]

private noncomputable def sourceLemma36IncreasingRank (xs : List ℕ)
    (i : Fin xs.length) : ℕ := by
  classical
  let families := sourceLemma36IncreasingChainsEndingAt xs i
  let cards := families.image Finset.card
  have hcards : cards.Nonempty := by
    refine ⟨1, Finset.mem_image.mpr ⟨{i}, ?_, Finset.card_singleton _⟩⟩
    exact sourceLemma36_singleton_mem_increasingChainsEndingAt xs i
  exact cards.max' hcards

private noncomputable def sourceLemma36DecreasingRank (xs : List ℕ)
    (i : Fin xs.length) : ℕ := by
  classical
  let families := sourceLemma36DecreasingChainsEndingAt xs i
  let cards := families.image Finset.card
  have hcards : cards.Nonempty := by
    refine ⟨1, Finset.mem_image.mpr ⟨{i}, ?_, Finset.card_singleton _⟩⟩
    exact sourceLemma36_singleton_mem_decreasingChainsEndingAt xs i
  exact cards.max' hcards

private theorem sourceLemma36_increasingRank_pos (xs : List ℕ)
    (i : Fin xs.length) : 1 ≤ sourceLemma36IncreasingRank xs i := by
  classical
  let families := sourceLemma36IncreasingChainsEndingAt xs i
  let cards := families.image Finset.card
  have hcards : cards.Nonempty := by
    refine ⟨1, Finset.mem_image.mpr ⟨{i}, ?_, Finset.card_singleton _⟩⟩
    exact sourceLemma36_singleton_mem_increasingChainsEndingAt xs i
  have hmem : 1 ∈ cards :=
    Finset.mem_image.mpr ⟨{i}, sourceLemma36_singleton_mem_increasingChainsEndingAt xs i,
      Finset.card_singleton _⟩
  exact Finset.le_max' cards 1 hmem

private theorem sourceLemma36_decreasingRank_pos (xs : List ℕ)
    (i : Fin xs.length) : 1 ≤ sourceLemma36DecreasingRank xs i := by
  classical
  let families := sourceLemma36DecreasingChainsEndingAt xs i
  let cards := families.image Finset.card
  have hcards : cards.Nonempty := by
    refine ⟨1, Finset.mem_image.mpr ⟨{i}, ?_, Finset.card_singleton _⟩⟩
    exact sourceLemma36_singleton_mem_decreasingChainsEndingAt xs i
  have hmem : 1 ∈ cards :=
    Finset.mem_image.mpr ⟨{i}, sourceLemma36_singleton_mem_decreasingChainsEndingAt xs i,
      Finset.card_singleton _⟩
  exact Finset.le_max' cards 1 hmem

private theorem sourceLemma36_increasingRank_witness (xs : List ℕ)
    (i : Fin xs.length) : ∃ I,
      I ∈ sourceLemma36IncreasingChainsEndingAt xs i ∧
        I.card = sourceLemma36IncreasingRank xs i := by
  classical
  let families := sourceLemma36IncreasingChainsEndingAt xs i
  let cards := families.image Finset.card
  have hcards : cards.Nonempty := by
    refine ⟨1, Finset.mem_image.mpr ⟨{i}, ?_, Finset.card_singleton _⟩⟩
    exact sourceLemma36_singleton_mem_increasingChainsEndingAt xs i
  have hmax : cards.max' hcards ∈ cards := Finset.max'_mem cards hcards
  obtain ⟨I, hI, hcard⟩ := Finset.mem_image.mp hmax
  exact ⟨I, hI, hcard⟩

private theorem sourceLemma36_decreasingRank_witness (xs : List ℕ)
    (i : Fin xs.length) : ∃ I,
      I ∈ sourceLemma36DecreasingChainsEndingAt xs i ∧
        I.card = sourceLemma36DecreasingRank xs i := by
  classical
  let families := sourceLemma36DecreasingChainsEndingAt xs i
  let cards := families.image Finset.card
  have hcards : cards.Nonempty := by
    refine ⟨1, Finset.mem_image.mpr ⟨{i}, ?_, Finset.card_singleton _⟩⟩
    exact sourceLemma36_singleton_mem_decreasingChainsEndingAt xs i
  have hmax : cards.max' hcards ∈ cards := Finset.max'_mem cards hcards
  obtain ⟨I, hI, hcard⟩ := Finset.mem_image.mp hmax
  exact ⟨I, hI, hcard⟩

private theorem sourceLemma36_increasingRank_lt_of_lt (xs : List ℕ)
    {i j : Fin xs.length} (hij : i < j) (hval : xs.get i < xs.get j) :
    sourceLemma36IncreasingRank xs i < sourceLemma36IncreasingRank xs j := by
  classical
  obtain ⟨I, hI, hIcard⟩ := sourceLemma36_increasingRank_witness xs i
  have hI' : i ∈ I ∧ (∀ t ∈ I, t ≤ i) ∧ SourceLemma36IncreasingIndexChain xs I := by
    simpa [sourceLemma36IncreasingChainsEndingAt] using
      (Finset.mem_filter.mp hI).2
  have hjnotI : j ∉ I := by
    intro hjI
    exact (not_le_of_gt hij) (hI'.2.1 j hjI)
  have hchain : SourceLemma36IncreasingIndexChain xs (insert j I) := by
    intro a b ha hb hab
    rcases Finset.mem_insert.mp hb with rfl | hbI
    · have haI : a ∈ I := by
        rcases Finset.mem_insert.mp ha with rfl | haI
        · exact (lt_irrefl _ hab).elim
        · exact haI
      have hai : a ≤ i := hI'.2.1 a haI
      rcases hai.eq_or_lt with rfl | hai
      · exact hval
      · exact (hI'.2.2 haI hI'.1 hai).trans hval
    · have haI : a ∈ I := by
        rcases Finset.mem_insert.mp ha with rfl | haI
        · exact (not_le_of_gt hij) (hab.le.trans (hI'.2.1 b hbI)) |>.elim
        · exact haI
      exact hI'.2.2 haI hbI hab
  have hinsert : insert j I ∈ sourceLemma36IncreasingChainsEndingAt xs j := by
    apply Finset.mem_filter.mpr
    refine ⟨Finset.mem_univ _, Finset.mem_insert_self _ _, ?_, hchain⟩
    intro t ht
    rcases Finset.mem_insert.mp ht with rfl | ht
    · exact le_rfl
    · exact (hI'.2.1 t ht).trans hij.le
  let families := sourceLemma36IncreasingChainsEndingAt xs j
  let cards := families.image Finset.card
  have hcards : cards.Nonempty := by
    refine ⟨1, Finset.mem_image.mpr ⟨{j}, ?_, Finset.card_singleton _⟩⟩
    exact sourceLemma36_singleton_mem_increasingChainsEndingAt xs j
  have hmem : (insert j I).card ∈ cards := Finset.mem_image.mpr ⟨insert j I, hinsert, rfl⟩
  have hle : (insert j I).card ≤ sourceLemma36IncreasingRank xs j := by
    exact Finset.le_max' cards _ hmem
  rw [Finset.card_insert_of_not_mem hjnotI, hIcard] at hle
  omega

private theorem sourceLemma36_decreasingRank_lt_of_lt (xs : List ℕ)
    {i j : Fin xs.length} (hij : i < j) (hval : xs.get j < xs.get i) :
    sourceLemma36DecreasingRank xs i < sourceLemma36DecreasingRank xs j := by
  classical
  obtain ⟨I, hI, hIcard⟩ := sourceLemma36_decreasingRank_witness xs i
  have hI' : i ∈ I ∧ (∀ t ∈ I, t ≤ i) ∧ SourceLemma36DecreasingIndexChain xs I := by
    simpa [sourceLemma36DecreasingChainsEndingAt] using
      (Finset.mem_filter.mp hI).2
  have hjnotI : j ∉ I := by
    intro hjI
    exact (not_le_of_gt hij) (hI'.2.1 j hjI)
  have hchain : SourceLemma36DecreasingIndexChain xs (insert j I) := by
    intro a b ha hb hab
    rcases Finset.mem_insert.mp hb with rfl | hbI
    · have haI : a ∈ I := by
        rcases Finset.mem_insert.mp ha with rfl | haI
        · exact (lt_irrefl _ hab).elim
        · exact haI
      have hai : a ≤ i := hI'.2.1 a haI
      rcases hai.eq_or_lt with rfl | hai
      · exact hval
      · exact hval.trans (hI'.2.2 haI hI'.1 hai)
    · have haI : a ∈ I := by
        rcases Finset.mem_insert.mp ha with rfl | haI
        · exact (not_le_of_gt hij) (hab.le.trans (hI'.2.1 b hbI)) |>.elim
        · exact haI
      exact hI'.2.2 haI hbI hab
  have hinsert : insert j I ∈ sourceLemma36DecreasingChainsEndingAt xs j := by
    apply Finset.mem_filter.mpr
    refine ⟨Finset.mem_univ _, Finset.mem_insert_self _ _, ?_, hchain⟩
    intro t ht
    rcases Finset.mem_insert.mp ht with rfl | ht
    · exact le_rfl
    · exact (hI'.2.1 t ht).trans hij.le
  let families := sourceLemma36DecreasingChainsEndingAt xs j
  let cards := families.image Finset.card
  have hcards : cards.Nonempty := by
    refine ⟨1, Finset.mem_image.mpr ⟨{j}, ?_, Finset.card_singleton _⟩⟩
