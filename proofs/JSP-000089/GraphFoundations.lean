  have horder : oldOrder.map Subtype.val = order := shadow.cycle_order data.anchor
  have hlen : oldOrder.length = order.length := by rw [← horder, List.length_map]
  let leftPosition : Fin k → Fin order.length := fun i => Fin.cast hlen (direct.leftPosition i)
  let rightPosition : Fin k → Fin order.length := fun i => Fin.cast hlen (direct.rightPosition i)
  have getOrder (p : Fin oldOrder.length) : order.get (Fin.cast hlen p) = (oldOrder.get p).val := by
    simp only [List.get_eq_getElem]
    change order[p.val] = (oldOrder[p.val]).val
