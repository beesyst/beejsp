/-- Assemble all six genuine Branch-I certificates without changing their payloads. -/
theorem sourceLemma39_branchI_spectrum_complete
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ} {hk : 1 ≤ k}
