    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (certificate : SourceLemma36KCrossladderCertificate G C k Z data iP matching)
    (i : Fin k) : G.Walk
      (certificate.firstVertex ⟨i.1 + 1, by omega⟩)
      (certificate.secondVertex ⟨i.1 + 1, by omega⟩) :=
  Walk.cons (certificate.edge ⟨i.1 + 1, by omega⟩) .nil

/-- Every retained middle matching edge is a genuine path, with no internal
vertices, so it is suitable as a Section-2 ladder rung. -/
private theorem sourceLemma36_kCrossladder_rungPath_isPath [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
