    have hpidx := sourceLemma36_idxOf_terminal P.support b hP.support_nodup
      (Walk.support_ne_nil P) P.getLast_support
    have hqidx : Q.support.idxOf b = 0 := by rw [Q.support_eq_cons, List.idxOf_cons_self]
    rw [Walk.support_append, List.idxOf_append_of_mem P.end_mem_support, hqidx]
    have := P.length_support
