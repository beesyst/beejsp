      (Finset.univ.image shadow.family.root) T u w v x y) :
    ∃ A B : Finset ℕ, 1 ≤ A.card ∧ 1 ≤ B.card ∧
      (∀ a ∈ A, 0 < a) ∧ (∀ b ∈ B, 0 < b) ∧
      ∀ a ∈ A, ∀ b ∈ B, IsCycleLength G (a + b) := by
  classical
  obtain ⟨ox, oy, I, P, R, _, _, _, _, _, _, _, _, _, _, _, _, hD, _, _⟩ :=
    sourceLemma39_direct_net_boundary_cycle G shadow T u w v x y net
