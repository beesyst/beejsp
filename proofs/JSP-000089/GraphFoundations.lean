/-- Source Lemma 2.1: all k proper attachment choices independently yield
actual simple cycles, with strictly positive normalized increments. -/
theorem sourceLemma21_ambient_proper_truncation_subsetSums
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (T : SourceLemma39AmbientProperTruncation G C k) :
    ∃ (base : ℕ) (delta : Fin k → ℕ),
      0 < base ∧ (∀ i, 0 < delta i) ∧
      ∀ I : Finset (Fin k), IsCycleLength G (base + ∑ i ∈ I, delta i) := by
  classical
  obtain ⟨arc, harc, cycles⟩ := sourceLemma21_ambient_cycle_family G T
  let low := fun i => min (T.attachment i).length (arc i).length
  let delta := fun i => max (T.attachment i).length (arc i).length - low i
  have neq (i : Fin k) : (T.attachment i).length ≠ (arc i).length := by
    rw [(harc i).2.1]
    exact T.proper i
  have hpos (i : Fin k) : 0 < delta i :=
    (sourceLemma21_normalized_lengths _ _ (neq i)).1
  let select := fun (I : Finset (Fin k)) (i : Fin k) =>
    if i ∈ I then decide ((arc i).length < (T.attachment i).length)
    else decide ((T.attachment i).length < (arc i).length)
  have hlocal (I : Finset (Fin k)) (i : Fin k) :
      (if select I i then (T.attachment i).length else (arc i).length) =
        low i + (if i ∈ I then delta i else 0) := by
    have hh := (sourceLemma21_normalized_lengths _ _ (neq i)).2 (decide (i ∈ I))
    by_cases hi : i ∈ I <;> simpa [select, hi, low, delta] using hh
  have hsum (I : Finset (Fin k)) :
      (∑ i, if select I i then (T.attachment i).length else (arc i).length) =
        (∑ i, low i) + ∑ i ∈ I, delta i := by
    simp_rw [hlocal, Finset.sum_add_distrib]
    simp
  obtain ⟨v, D, hD, hlen⟩ := cycles (select ∅)
  rw [hsum] at hlen
  simp only [Finset.sum_empty, Nat.add_zero] at hlen
  refine ⟨D.length, delta, lt_of_lt_of_le (by decide : 0 < 3) hD.three_le_length, hpos, ?_⟩
  intro I
  obtain ⟨w, E, hE, hElen⟩ := cycles (select I)
  rw [hsum] at hElen
  refine ⟨w, E, hE, ?_⟩
  omega

