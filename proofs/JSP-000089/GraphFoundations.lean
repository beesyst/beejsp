    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt (sourceLemma35Graph G C hC)
        (sourceLemma35RetainedCycle G C hC)
        (sourceLemma35_retainedCycle_hamiltonian G C hC) k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder (sourceLemma35Graph G C hC)
      (sourceLemma35RetainedCycle G C hC) k Z data iP matching) :
    ∃ partner : Fin (2 * k - 1) → SourceLemma34Chord
        (sourceLemma35Graph G C hC) (sourceLemma35RetainedCycle G C hC),
