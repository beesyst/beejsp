      (∀ i, (net.leftVertex (sel i)).val ∈ D.support ∧ (net.rightVertex (sel i)).val ∈ D.support) ∧
      (∀ i, (left i).IsPath ∧ (right i).IsPath ∧
        Disjoint (internalVertices G (left i)) {z | z ∈ D.support} ∧
        Disjoint (internalVertices G (right i)) {z | z ∈ D.support}) ∧
      (∀ i j, i ≠ j → Disjoint (internalVertices G (left i)) (internalVertices G (left j))) ∧
