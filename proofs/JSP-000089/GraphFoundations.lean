  let S := C.support.toFinset
  let Z := sourceLemma31ZeroOutsideVertices G C
  let P := S \ Z
  let succ := sourceLemma31CycleSuccTotal G C
  have hS : S.card = C.length := by
    have htail : r ∈ C.support.tail := C.end_mem_tail_support hLongest.1.not_nil
    have hs : C.support.toFinset = C.support.tail.toFinset := by
      rw [C.support_eq_cons]
      simp [htail]
    dsimp [S]
    rw [hs, List.toFinset_card_of_nodup hLongest.1.support_nodup]
    simp [Walk.length_support]
  have hZS : Z ⊆ S := Finset.filter_subset _ _
  have hpartition : P.card + Z.card = S.card :=
    Finset.card_sdiff_add_card_eq_card hZS
  have hPmem (v : V) (hv : v ∈ P) : v ∈ C.support :=
    List.mem_toFinset.mp (Finset.mem_sdiff.mp hv).1
  have hex (v : V) (hv : v ∈ P) :
      ∃ A, sourceLemma31ComponentAdjacent G C A v := by
    have hnot := (Finset.mem_sdiff.mp hv).2
    have hn : ¬ (∀ x, x ∉ C.support → ¬ G.Adj v x) := by
      intro h
      exact hnot (Finset.mem_filter.mpr ⟨(Finset.mem_sdiff.mp hv).1, h⟩)
    push_neg at hn
    obtain ⟨x, hx, hvx⟩ := hn
    let xo : {x : V // x ∈ sourceLemma31OutsideVertices G C} := ⟨x, hx⟩
    exact ⟨(sourceLemma31OutsideGraph G C).connectedComponentMk xo,
      xo, SimpleGraph.ConnectedComponent.connectedComponentMk_mem, hvx.symm⟩
  have hPpos : 0 < P.card := by
    change 9 * Z.card < 4 * C.length at hZ
    omega
  obtain ⟨v₀, hv₀⟩ := Finset.card_pos.mp hPpos
  obtain ⟨A₀, _⟩ := hex v₀ hv₀
  have hchoose : ∀ v : V, ∃ A,
      v ∈ P → sourceLemma31ComponentAdjacent G C A v := by
    intro v
    by_cases hv : v ∈ P
    · obtain ⟨A, hA⟩ := hex v hv
      exact ⟨A, fun _ => hA⟩
    · exact ⟨A₀, fun h => (hv h).elim⟩
  choose f hf using hchoose
  let A := P.image f
  let T := P.filter fun v => succ v ∈ P
  let B := S.filter fun v => succ v ∈ Z
  have hsuccmem (v : V) (hv : v ∈ S) : succ v ∈ S := by
    have hvC := List.mem_toFinset.mp hv
    simpa [S, succ, sourceLemma31CycleSuccTotal_eq G C v hvC] using
      sourceLemma31CycleSucc_mem G C hLongest.1 v hvC
  have hsuccinj : Set.InjOn succ S := by
    intro u hu v hv huv
    have huC := List.mem_toFinset.mp hu
    have hvC := List.mem_toFinset.mp hv
    apply sourceLemma31CycleSucc_injective G C hLongest.1 u v huC hvC
    simpa [succ, sourceLemma31CycleSuccTotal_eq G C u huC,
      sourceLemma31CycleSuccTotal_eq G C v hvC] using huv
  have hB : B.card ≤ Z.card := by
    apply Finset.card_le_card_of_injOn succ
    · intro v hv
      exact (Finset.mem_filter.mp hv).2
    · exact hsuccinj.mono (Finset.filter_subset _ _)
  have hcover : S ⊆ T ∪ (Z ∪ B) := by
    intro v hv
    by_cases hvZ : v ∈ Z
    · exact Finset.mem_union_right _ (Finset.mem_union_left _ hvZ)
    · by_cases hsZ : succ v ∈ Z
      · exact Finset.mem_union_right _
          (Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨hv, hsZ⟩))
      · exact Finset.mem_union_left _ (Finset.mem_filter.mpr
          ⟨Finset.mem_sdiff.mpr ⟨hv, hvZ⟩,
            Finset.mem_sdiff.mpr ⟨hsuccmem v hv, hsZ⟩⟩)
  have hTcount : S.card ≤ T.card + 2 * Z.card := by
    have h₁ := Finset.card_le_card hcover
    have h₂ := Finset.card_union_le T (Z ∪ B)
    have h₃ := Finset.card_union_le Z B
    omega
  let label := fun v => (f v, f (succ v))
  have htransition (v : V) (hv : v ∈ T) :
      v ∈ sourceLemma31TransitionVertices G C (f v) (f (succ v)) := by
    obtain ⟨hvP, hsP⟩ := Finset.mem_filter.mp hv
    apply (sourceLemma31_mem_transitionVertices G C _ _ v).mpr
    refine ⟨hPmem v hvP, hf v hvP, ?_⟩
    simpa [succ, sourceLemma31CycleSuccTotal_eq G C v (hPmem v hvP)] using
