  obtain ⟨lo, ro, left, right, hloinj, hroinj, hlro, hl, hr, hldis, hrdis, hcross⟩ :=
    sourceLemma39_direct_net_attachment_paths G shadow T u w v x y net
  let D := I.append (R.append P.reverse)
  have memberL (i) : (net.leftVertex i).val ∈ I.support := by
    rw [hIs, List.mem_map]
