structure FourAttachmentPaths (u v w x u' v' w' x' : V) where
  pu : G.Walk u u'
  pv : G.Walk v v'
  pw : G.Walk w w'
  px : G.Walk x x'
  pu_path : pu.IsPath
  pv_path : pv.IsPath
  pw_path : pw.IsPath
  px_path : px.IsPath
  pu_pv : Disjoint (internalVertices G pu) (internalVertices G pv)
  pu_pw : Disjoint (internalVertices G pu) (internalVertices G pw)
  pu_px : Disjoint (internalVertices G pu) (internalVertices G px)
  pv_pw : Disjoint (internalVertices G pv) (internalVertices G pw)
  pv_px : Disjoint (internalVertices G pv) (internalVertices G px)
  pw_px : Disjoint (internalVertices G pw) (internalVertices G px)

/-- Source Lemma 3.3 needs exactly four simple attachment paths.  This bridge
records the output shape consumed by its later endblock argument. -/
theorem sourceLemma33_fourAttachment_bridge {u v w x u' v' w' x' : V}
    (h : FourAttachmentPaths G u v w x u' v' w' x') :
    ∃ pu : G.Walk u u', ∃ pv : G.Walk v v', ∃ pw : G.Walk w w', ∃ px : G.Walk x x',
      pu.IsPath ∧ pv.IsPath ∧ pw.IsPath ∧ px.IsPath ∧
        Disjoint (internalVertices G pu) (internalVertices G pv) ∧
        Disjoint (internalVertices G pu) (internalVertices G pw) ∧
        Disjoint (internalVertices G pu) (internalVertices G px) ∧
        Disjoint (internalVertices G pv) (internalVertices G pw) ∧
        Disjoint (internalVertices G pv) (internalVertices G px) ∧
        Disjoint (internalVertices G pw) (internalVertices G px) := by
  exact ⟨h.pu, h.pv, h.pw, h.px, h.pu_path, h.pv_path, h.pw_path, h.px_path,
    h.pu_pv, h.pu_pw, h.pu_px, h.pv_pw, h.pv_px, h.pw_px⟩

/-- Reversing a side of the reverse chord produces a side of the original chord. -/
private noncomputable def sourceLemma34_side_reverse [DecidableEq V]
    {r : V} (C : G.Walk r r) (e : SourceLemma34Chord G C)
    (S : SourceLemma34ChordSide G C (SourceLemma34Chord.symm G e)) :
