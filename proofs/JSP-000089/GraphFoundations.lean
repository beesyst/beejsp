/-- In the increasing first-rail coordinate, a vertex outside the closed
`Qu` interval is strictly before it or strictly after it. -/
private theorem sourceLemma38_not_mem_Qu_strict_position
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2))
    (i : Fin k) (x : V)
    (p : Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length)
    (hp : (sourceLemma36RotatedCycleOrder G C data.anchor).get p = x)
    (hx : x ∉ (sourceLemma38Qu G C k hk Z data iP matching ladder i).support) :
    p < ladder.firstPosition (sourceLemma38BlockFirstIndex k hk i) ∨
      ladder.firstPosition (sourceLemma38BlockLastIndex k hk i) < p := by
