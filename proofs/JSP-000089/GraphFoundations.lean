/-- Different middle matching edges give vertex-disjoint concrete rung paths.
This is the disjoint-rung clause of the source ladder definition. -/
private theorem sourceLemma36_kCrossladder_rungPath_vertex_disjoint
    [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (certificate : SourceLemma36KCrossladderCertificate G C k Z data iP matching)
    {i j : Fin k} (hij : i ≠ j) (v : V)
    (hvi : v ∈ (sourceLemma36KCrossladderRungPath G C k Z data iP matching certificate i).support)
    (hvj : v ∈ (sourceLemma36KCrossladderRungPath G C k Z data iP matching certificate j).support) :
    False := by
  rw [sourceLemma36KCrossladderRungPath] at hvi hvj
  simp only [Walk.support_cons, Walk.support_nil, List.mem_cons, List.not_mem_nil,
    or_false] at hvi hvj
  have hmiddle : (⟨i.1 + 1, by omega⟩ : Fin (k + 2)) ≠
      ⟨j.1 + 1, by omega⟩ := by
    intro h
    apply hij
    apply Fin.ext
    exact Nat.succ.inj (congrArg Fin.val h)
  have hdisjoint := certificate.endpoint_disjoint hmiddle
  rcases hvi with hvi | hvi <;> rcases hvj with hvj | hvj
  · exact hdisjoint.1 (hvi.symm.trans hvj)
  · exact hdisjoint.2.1 (hvi.symm.trans hvj)
  · exact hdisjoint.2.2.1 (hvi.symm.trans hvj)
  · exact hdisjoint.2.2.2 (hvi.symm.trans hvj)

/-- The exact source boundary-cycle expression.  Given the two oriented
