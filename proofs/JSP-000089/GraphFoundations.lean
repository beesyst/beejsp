      ⟨hne.symm, i, hmem i, (Finset.mem_erase.mp hy).2⟩
    exact (F.mem_incidenceFinset (root i) _).mpr (by
      simp only [SimpleGraph.mk'_mem_incidenceSet_iff]
      exact ⟨hadj, Or.inl trivial⟩)
  have hdis : Disjoint Q R := by
    apply Finset.disjoint_left.mpr
    intro e heQ heR
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp heR
    have heC : s(root i,y) ∈ C.edges := (Finset.mem_filter.mp heQ).2
    have heD : s(root i,y) ∈ D.edges := by
      simpa [C, sourceLemma39ShadowCycle, Walk.edges_transfer] using heC
    exact hoff i (hmem i) (Finset.mem_erase.mp hy).2
      (Finset.mem_erase.mp hy).1.symm heD
  have hsub : Q ∪ R ⊆ F.incidenceFinset (root i) :=
    Finset.union_subset (Finset.filter_subset _ _) hRsub
  have hb := Finset.card_le_card hsub
  rw [Finset.card_union_of_disjoint hdis, hQ, hR, F.card_incidenceFinset_eq_degree] at hb
  exact hb

