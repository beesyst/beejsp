adapting it to the directed chord record required by Lemma 3.4. -/
private noncomputable def sourceLemma35Endpoints (e : Sym2 V) : V × V :=
  (Quot.exists_rep e).choose

private theorem sourceLemma35Endpoints_spec (e : Sym2 V) :
    s((sourceLemma35Endpoints e).1, (sourceLemma35Endpoints e).2) = e :=
  (Quot.exists_rep e).choose_spec

/-- A physical non-cycle edge has one local directed chord representative. -/
private noncomputable def sourceLemma35ChordOfEdge [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (e : Sym2 V)
    (he : e ∈ sourceLemma35ChordEdges G C) : SourceLemma34Chord G C where
  fst := (sourceLemma35Endpoints e).1
  snd := (sourceLemma35Endpoints e).2
  fst_mem := by
    rw [← sourceLemma35Endpoints_spec e]
    exact hC.mem_support _
  snd_mem := by
    rw [← sourceLemma35Endpoints_spec e]
    exact hC.mem_support _
  adj := by
    apply G.mem_edgeSet.mp
    rw [sourceLemma35Endpoints_spec e]
    exact (SimpleGraph.mem_edgeFinset (G := G)).mp (Finset.mem_filter.mp he).1
  not_cycle_edge := by
    intro hmem
    apply (Finset.mem_filter.mp he).2
    rwa [sourceLemma35Endpoints_spec e] at hmem

private theorem sourceLemma35ChordOfEdge_edge [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (e : Sym2 V)
    (he : e ∈ sourceLemma35ChordEdges G C) :
    (sourceLemma35ChordOfEdge G C hC e he).edge = e := by
  exact sourceLemma35Endpoints_spec e
/-- Physical crossing of chord edges.  The disjunction makes the local chosen
orientations irrelevant while retaining the source's symmetric relation. -/
private def sourceLemma35PhysicalCrosses [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (e f : Sym2 V) : Prop :=
  ∃ he : e ∈ sourceLemma35ChordEdges G C, ∃ hf : f ∈ sourceLemma35ChordEdges G C,
    sourceLemma34Crosses G C hC.isCycle
      (sourceLemma35ChordOfEdge G C hC e he)
      (sourceLemma35ChordOfEdge G C hC f hf) ∨
    sourceLemma34Crosses G C hC.isCycle
      (sourceLemma35ChordOfEdge G C hC f hf)
      (sourceLemma35ChordOfEdge G C hC e he)

private theorem sourceLemma35PhysicalCrosses_symm [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (e f : Sym2 V) :
    sourceLemma35PhysicalCrosses G C hC e f →
      sourceLemma35PhysicalCrosses G C hC f e := by
  rintro ⟨he, hf, hcross | hcross⟩
  · exact ⟨hf, he, Or.inr hcross⟩
  · exact ⟨hf, he, Or.inl hcross⟩

/-- Blue and red are a physical-edge partition, so reverse presentations of a
single graph edge cannot inflate any count. -/
private noncomputable def sourceLemma35BlueEdges [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) : Finset (Sym2 V) := by
  classical
  exact (sourceLemma35ChordEdges G C).filter fun e =>
    ∃ f : Sym2 V, sourceLemma35PhysicalCrosses G C hC e f

private noncomputable def sourceLemma35RedEdges [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) : Finset (Sym2 V) :=
  sourceLemma35ChordEdges G C \ sourceLemma35BlueEdges G C hC

private theorem sourceLemma35_blue_subset_chords [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) :
    sourceLemma35BlueEdges G C hC ⊆ sourceLemma35ChordEdges G C := by
  classical
  intro e he
  exact (Finset.mem_filter.mp he).1

private theorem sourceLemma35_red_subset_chords [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) :
    sourceLemma35RedEdges G C hC ⊆ sourceLemma35ChordEdges G C := by
  intro e he
  exact (Finset.mem_sdiff.mp he).1

private theorem sourceLemma35_blue_partner_blue [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) {e f : Sym2 V}
    (hcross : sourceLemma35PhysicalCrosses G C hC e f) :
    e ∈ sourceLemma35BlueEdges G C hC ∧ f ∈ sourceLemma35BlueEdges G C hC := by
  classical
  rcases hcross with ⟨he, hf, hcross⟩
  constructor
  · exact Finset.mem_filter.mpr ⟨he, ⟨f, ⟨he, hf, hcross⟩⟩⟩
  · exact Finset.mem_filter.mpr ⟨hf, ⟨e,
      sourceLemma35PhysicalCrosses_symm G C hC e f ⟨he, hf, hcross⟩⟩⟩
/-- Red physical chords form a noncrossing, physically injective family, so
Lemma 3.4 bounds them without reintroducing directed double-counting. -/
private theorem sourceLemma35_red_bound [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (hgirth : 5 ≤ G.girth) :
    3 * (sourceLemma35RedEdges G C hC).card < C.length := by
  classical
  let red := sourceLemma35RedEdges G C hC
  have hredChord : ∀ e ∈ red, e ∈ sourceLemma35ChordEdges G C := by
    intro e he
    exact sourceLemma35_red_subset_chords G C hC he
  let chordOfRed : {e // e ∈ red} → SourceLemma34Chord G C := fun e =>
    sourceLemma35ChordOfEdge G C hC e.1 (hredChord e.1 e.2)
  have hchordOfRed_inj : Function.Injective chordOfRed := by
    intro e f hEq
    apply Subtype.ext
    have hedge := congrArg (fun x => x.edge) hEq
    calc
      e.1 = (chordOfRed e).edge :=
        (sourceLemma35ChordOfEdge_edge G C hC e.1 (hredChord e.1 e.2)).symm
      _ = (chordOfRed f).edge := hedge
      _ = f.1 := sourceLemma35ChordOfEdge_edge G C hC f.1 (hredChord f.1 f.2)
  let chordEmbedding : {e // e ∈ red} ↪ SourceLemma34Chord G C :=
    ⟨chordOfRed, hchordOfRed_inj⟩
  let D := red.attach.map chordEmbedding
  have hDcard : D.card = red.card := by
    dsimp [D]
    rw [Finset.card_map, Finset.card_attach]
  have hpreimage : ∀ d ∈ D, ∃ e : {e // e ∈ red}, chordEmbedding e = d := by
    intro d hd
    change d ∈ red.attach.map chordEmbedding at hd
    rcases Finset.mem_map.1 hd with ⟨e, _, hEq⟩
    exact ⟨e, hEq⟩
  have hinjD : ∀ e ∈ D, ∀ f ∈ D, e.edge = f.edge → e = f := by
    intro e he f hf hedge
    obtain ⟨e0, he0⟩ := hpreimage e he
    obtain ⟨f0, hf0⟩ := hpreimage f hf
    rw [← he0, ← hf0] at hedge ⊢
    apply congrArg chordEmbedding
    apply Subtype.ext
    calc
      e0.1 = (chordOfRed e0).edge :=
        (sourceLemma35ChordOfEdge_edge G C hC e0.1 (hredChord e0.1 e0.2)).symm
      _ = (chordOfRed f0).edge := by
        simpa [chordEmbedding, chordOfRed] using hedge
      _ = f0.1 := sourceLemma35ChordOfEdge_edge G C hC f0.1 (hredChord f0.1 f0.2)
  have hnoncrossD : ∀ e ∈ D, ∀ f ∈ D, e ≠ f →
      ¬ sourceLemma34Crosses G C hC.isCycle e f := by
    intro e he f hf hne hcross
    obtain ⟨e0, he0⟩ := hpreimage e he
    obtain ⟨f0, hf0⟩ := hpreimage f hf
    rw [← he0, ← hf0] at hne hcross
    have hphysical : sourceLemma35PhysicalCrosses G C hC e0.1 f0.1 := by
      refine ⟨hredChord e0.1 e0.2, hredChord f0.1 f0.2, Or.inl ?_⟩
      simpa [chordEmbedding, chordOfRed] using hcross
    have hblue : e0.1 ∈ sourceLemma35BlueEdges G C hC :=
      Finset.mem_filter.mpr ⟨hredChord e0.1 e0.2, ⟨f0.1, hphysical⟩⟩
    exact (Finset.mem_sdiff.mp e0.2).2 hblue
  have hbound := sourceLemma34_girth5_noncrossing_chord_bound
    G C hC.isCycle hgirth D hinjD hnoncrossD
  rw [hDcard] at hbound
  exact hbound
/-- At every vertex of a Hamiltonian cycle, exactly two incident graph edges
belong to that cycle. -/
private theorem sourceLemma35_cycle_incident_card [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (v : V) :
    ({e ∈ G.incidenceFinset v | e ∈ C.edges}).card = 2 := by
  classical
  let H := C.toSubgraph.spanningCoe
  letI : Fintype H.edgeSet := Fintype.ofFinite _
  letI : Fintype (H.neighborSet v) := Fintype.ofFinite _
  have hHedge : ∀ e : Sym2 V, e ∈ H.edgeSet ↔ e ∈ C.edges := by
    intro e
    change e ∈ C.toSubgraph.edgeSet ↔ e ∈ C.edges
    exact C.mem_edges_toSubgraph
  have hHle : H ≤ G := by
    dsimp [H]
    exact C.toSubgraph.spanningCoe_le
  have hHedgeFin : ∀ e : Sym2 V, e ∈ H.edgeFinset ↔ e ∈ C.edges := by
    intro e
    rw [SimpleGraph.mem_edgeFinset]
    exact hHedge e
  have hInc : {e ∈ G.incidenceFinset v | e ∈ C.edges} = H.incidenceFinset v := by
    rw [G.incidenceFinset_eq_filter, H.incidenceFinset_eq_filter]
    ext e
    simp only [Finset.mem_filter]
    constructor
    · rintro ⟨⟨heG, hv⟩, heC⟩
      exact ⟨hHedgeFin e |>.2 heC, hv⟩
    · rintro ⟨heH, hv⟩
      exact ⟨⟨SimpleGraph.edgeFinset_mono hHle heH, hv⟩, hHedgeFin e |>.1 heH⟩
  rw [hInc, H.card_incidenceFinset_eq_degree]
  rw [← H.card_neighborSet_eq_degree, ← Set.toFinset_card]
  have hneighbor : H.neighborSet v = C.toSubgraph.neighborSet v := by
    rfl
  rw [← Set.ncard_eq_toFinset_card']
  rw [hneighbor]
  exact hC.isCycle.ncard_neighborSet_toSubgraph_eq_two (hC.mem_support v)
/-- Physical blue and red chord incidences at a vertex. -/
private noncomputable def sourceLemma35BlueIncident [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (v : V) : Finset (Sym2 V) := by
  classical
  exact (G.incidenceFinset v).filter fun e => e ∈ sourceLemma35BlueEdges G C hC

private noncomputable def sourceLemma35RedIncident [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (v : V) : Finset (Sym2 V) := by
  classical
  exact (G.incidenceFinset v).filter fun e => e ∈ sourceLemma35RedEdges G C hC

/-- A degree-six vertex has at least four chord incidences, partitioned into
blue and red physical edges. -/
private theorem sourceLemma35_four_chord_incidences [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (v : V)
    (hdegree : 6 ≤ G.degree v) :
    4 ≤ (sourceLemma35BlueIncident G C hC v).card +
      (sourceLemma35RedIncident G C hC v).card := by
  classical
  let I := G.incidenceFinset v
  let Q := I.filter fun e => e ∉ C.edges
  let B := sourceLemma35BlueIncident G C hC v
  let R := sourceLemma35RedIncident G C hC v
  have hcycle : (I.filter fun e => e ∈ C.edges).card = 2 := by
    dsimp [I]
    exact sourceLemma35_cycle_incident_card G C hC v
  have hIpartition : (I.filter fun e => e ∈ C.edges).card + Q.card = I.card := by
    simpa [Q] using
      (Finset.filter_card_add_filter_neg_card_eq_card (s := I) fun e => e ∈ C.edges)
  have hB : B = Q.filter fun e => e ∈ sourceLemma35BlueEdges G C hC := by
    ext e
    simp only [B, sourceLemma35BlueIncident, I, Q, Finset.mem_filter]
    constructor
    · rintro ⟨heI, heB⟩
      refine ⟨⟨heI, ?_⟩, heB⟩
      exact (Finset.mem_filter.mp
        (sourceLemma35_blue_subset_chords G C hC heB)).2
    · rintro ⟨⟨heI, _⟩, heB⟩
      exact ⟨heI, heB⟩
  have hR : R = Q.filter fun e => e ∉ sourceLemma35BlueEdges G C hC := by
    ext e
    simp only [R, sourceLemma35RedIncident, I, Q, Finset.mem_filter,
      sourceLemma35RedEdges]
    constructor
    · rintro ⟨heI, heRed⟩
      refine ⟨⟨heI, (Finset.mem_filter.mp (Finset.mem_sdiff.mp heRed).1).2⟩,
        (Finset.mem_sdiff.mp heRed).2⟩
    · rintro ⟨⟨heI, hnotC⟩, hnotB⟩
      have hedge : e ∈ G.edgeFinset := by
        apply (SimpleGraph.mem_edgeFinset (G := G)).mpr
        exact G.incidenceSet_subset v ((G.mem_incidenceFinset v e).mp heI)
      exact ⟨heI, Finset.mem_sdiff.mpr
        ⟨Finset.mem_filter.mpr ⟨hedge, hnotC⟩, hnotB⟩⟩
  have hQpartition : (Q.filter fun e => e ∈ sourceLemma35BlueEdges G C hC).card +
      (Q.filter fun e => e ∉ sourceLemma35BlueEdges G C hC).card = Q.card := by
    exact Finset.filter_card_add_filter_neg_card_eq_card (s := Q)
      (fun e => e ∈ sourceLemma35BlueEdges G C hC)
  have hdegree' : I.card = G.degree v := by
    dsimp [I]
    exact G.card_incidenceFinset_eq_degree v
  change 4 ≤ B.card + R.card
  rw [hB, hR]
  omega
/-- The source proof's local degree consequence. -/
private theorem sourceLemma35_two_red_incidences_of_blue_le_two [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (v : V)
    (hdegree : 6 ≤ G.degree v)
    (hblue : (sourceLemma35BlueIncident G C hC v).card ≤ 2) :
    2 ≤ (sourceLemma35RedIncident G C hC v).card := by
  have hfour := sourceLemma35_four_chord_incidences G C hC v hdegree
  omega
/-- The vertices retained by the source proof: those with at least three blue
physical chord incidences. -/
private noncomputable def sourceLemma35X [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (Y : Finset V) : Finset V := by
  classical
  exact Y.filter fun v => 3 ≤ (sourceLemma35BlueIncident G C hC v).card

private theorem sourceLemma35_X_subset [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (Y : Finset V) :
    sourceLemma35X G C hC Y ⊆ Y := by
  classical
  intro v hv
  exact (Finset.mem_filter.mp hv).1

/-- If the selected set is smaller than the source threshold, its complement
inside `Y` already has the required one-third lower bound. -/
private theorem sourceLemma35_bad_card_lower [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (Y : Finset V)
    (hY : 4 * C.length ≤ 9 * Y.card)
    (hsmall : ¬ C.length ≤ 9 * (sourceLemma35X G C hC Y).card) :
    C.length ≤ 3 * (Y \ sourceLemma35X G C hC Y).card := by
  let X := sourceLemma35X G C hC Y
  have hXsubset : X ⊆ Y := by
    dsimp [X]
    exact sourceLemma35_X_subset G C hC Y
  have hcard : (Y \ X).card + X.card = Y.card :=
    Finset.card_sdiff_add_card_eq_card hXsubset
  have hXlt : 9 * X.card < C.length := Nat.lt_of_not_ge hsmall
  change C.length ≤ 3 * (Y \ X).card
  omega
/-- Every bad source vertex has two incident red physical chords. -/
private theorem sourceLemma35_bad_two_red_incidences [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (Y : Finset V)
    (hdegree : ∀ y ∈ Y, 6 ≤ G.degree y) {y : V}
    (hy : y ∈ Y \ sourceLemma35X G C hC Y) :
    2 ≤ (sourceLemma35RedIncident G C hC y).card := by
  classical
  have hyY : y ∈ Y := (Finset.mem_sdiff.mp hy).1
  have hynotX : y ∉ sourceLemma35X G C hC Y := (Finset.mem_sdiff.mp hy).2
  have hblue : (sourceLemma35BlueIncident G C hC y).card ≤ 2 := by
    by_contra hnot
    apply hynotX
    have hthree : 3 ≤ (sourceLemma35BlueIncident G C hC y).card := by omega
    exact Finset.mem_filter.mpr ⟨hyY, hthree⟩
  exact sourceLemma35_two_red_incidences_of_blue_le_two G C hC y (hdegree y hyY) hblue
/-- The finite bad-vertex/red-edge incidence object used for the source's
explicit double count. -/
private noncomputable def sourceLemma35RedIncidencePairs [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (Bad : Finset V) := by
  classical
  exact Bad.sigma fun y => sourceLemma35RedIncident G C hC y

private theorem sourceLemma35_redIncidencePairs_lower [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (Y : Finset V)
    (hdegree : ∀ y ∈ Y, 6 ≤ G.degree y) :
    2 * (Y \ sourceLemma35X G C hC Y).card ≤
      (sourceLemma35RedIncidencePairs G C hC
        (Y \ sourceLemma35X G C hC Y)).card := by
  classical
  let Bad := Y \ sourceLemma35X G C hC Y
  have htwo : ∀ y ∈ Bad, 2 ≤ (sourceLemma35RedIncident G C hC y).card := by
    intro y hy
    dsimp [Bad] at hy
    exact sourceLemma35_bad_two_red_incidences G C hC Y hdegree hy
  rw [sourceLemma35RedIncidencePairs, Finset.card_sigma]
  have hsum := Finset.sum_le_sum fun y hy => htwo y hy
  rw [show 2 * Bad.card = ∑ _y ∈ Bad, 2 by simp [two_mul, Nat.mul_comm]]
  exact hsum
/-- The graph consisting precisely of the red physical chords. -/
private noncomputable def sourceLemma35RedGraph [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) : SimpleGraph V :=
  SimpleGraph.fromEdgeSet (↑(sourceLemma35RedEdges G C hC) : Set (Sym2 V))

private theorem sourceLemma35_redGraph_edgeFinset [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) :
    (sourceLemma35RedGraph G C hC).edgeFinset = sourceLemma35RedEdges G C hC := by
  classical
  let red := sourceLemma35RedEdges G C hC
  let R := sourceLemma35RedGraph G C hC
  ext e
  change e ∈ R.edgeFinset ↔ e ∈ red
  rw [SimpleGraph.mem_edgeFinset]
  constructor
  · intro he
    change e ∈ (SimpleGraph.fromEdgeSet
      (↑(sourceLemma35RedEdges G C hC) : Set (Sym2 V))).edgeSet at he
    rw [SimpleGraph.edgeSet_fromEdgeSet] at he
    exact he.1
  · intro he
    change e ∈ (SimpleGraph.fromEdgeSet
      (↑(sourceLemma35RedEdges G C hC) : Set (Sym2 V))).edgeSet
    rw [SimpleGraph.edgeSet_fromEdgeSet]
    refine ⟨he, ?_⟩
    have hchord := sourceLemma35_red_subset_chords G C hC he
    exact G.not_isDiag_of_mem_edgeFinset (Finset.mem_filter.mp hchord).1

/-- Red incidences in `G` are exactly incidences in the red-only graph. -/
private theorem sourceLemma35_redIncident_eq_redGraph [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (v : V) :
    sourceLemma35RedIncident G C hC v =
      (sourceLemma35RedGraph G C hC).incidenceFinset v := by
  classical
  let R := sourceLemma35RedGraph G C hC
  have hRed : R.edgeFinset = sourceLemma35RedEdges G C hC := by
    dsimp [R]
    exact sourceLemma35_redGraph_edgeFinset G C hC
  rw [sourceLemma35RedIncident, G.incidenceFinset_eq_filter,
    R.incidenceFinset_eq_filter]
  ext e
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨⟨heG, hv⟩, heRed⟩
    exact ⟨by rwa [hRed], hv⟩
  · rintro ⟨heR, hv⟩
    have heRed : e ∈ sourceLemma35RedEdges G C hC := by rwa [hRed] at heR
    have hchord := sourceLemma35_red_subset_chords G C hC heRed
    have heG : e ∈ G.edgeFinset := (Finset.mem_filter.mp hchord).1
    exact ⟨⟨heG, hv⟩, heRed⟩

/-- Handshaking in the red-only graph supplies the upper half of the explicit
bad-vertex/red-edge incidence double count. -/
private theorem sourceLemma35_redIncidencePairs_upper [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (Bad : Finset V) :
    (sourceLemma35RedIncidencePairs G C hC Bad).card ≤
      2 * (sourceLemma35RedEdges G C hC).card := by
  classical
  let R := sourceLemma35RedGraph G C hC
  have hinc : ∀ v : V,
      (sourceLemma35RedIncident G C hC v).card = R.degree v := by
    intro v
    rw [sourceLemma35_redIncident_eq_redGraph]
    exact R.card_incidenceFinset_eq_degree v
  have hsum : (∑ v ∈ Bad, R.degree v) ≤ ∑ v, R.degree v :=
    Finset.sum_le_univ_sum_of_nonneg fun _ => Nat.zero_le _
  rw [sourceLemma35RedIncidencePairs, Finset.card_sigma]
  calc
    (∑ y ∈ Bad, (sourceLemma35RedIncident G C hC y).card) =
        ∑ y ∈ Bad, R.degree y := by
      apply Finset.sum_congr rfl
      intro y hy
      exact hinc y
    _ ≤ ∑ y, R.degree y := hsum
    _ = 2 * R.edgeFinset.card := R.sum_degrees_eq_twice_card_edges
    _ = 2 * (sourceLemma35RedEdges G C hC).card := by
      rw [show R.edgeFinset = sourceLemma35RedEdges G C hC by
        dsimp [R]
        exact sourceLemma35_redGraph_edgeFinset G C hC]

/-- The red incidence double count closes the source's cardinality
contradiction, so the selected blue-rich set has the required size. -/
private theorem sourceLemma35_X_large [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (hgirth : 5 ≤ G.girth)
    (Y : Finset V) (hY : 4 * C.length ≤ 9 * Y.card)
    (hdegree : ∀ y ∈ Y, 6 ≤ G.degree y) :
    C.length ≤ 9 * (sourceLemma35X G C hC Y).card := by
  by_contra hsmall
  let Bad := Y \ sourceLemma35X G C hC Y
  let red := sourceLemma35RedEdges G C hC
  have hbadLower := sourceLemma35_bad_card_lower G C hC Y hY hsmall
  have hpairsLower := sourceLemma35_redIncidencePairs_lower G C hC Y hdegree
  have hpairsUpper := sourceLemma35_redIncidencePairs_upper G C hC Bad
  have hbadRed : Bad.card ≤ red.card := by
    dsimp [Bad, red] at hpairsLower hpairsUpper ⊢
    omega
  have hredBound := sourceLemma35_red_bound G C hC hgirth
  dsimp [Bad, red] at hbadLower hbadRed hredBound
  omega

/-- The blue-chord graph and the source subgraph comprising the Hamiltonian
cycle together with every blue chord. -/
private noncomputable def sourceLemma35BlueGraph [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) : SimpleGraph V :=
  SimpleGraph.fromEdgeSet (↑(sourceLemma35BlueEdges G C hC) : Set (Sym2 V))

private noncomputable def sourceLemma35Graph [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) : SimpleGraph V :=
  C.toSubgraph.spanningCoe ⊔ sourceLemma35BlueGraph G C hC

private theorem sourceLemma35_blueGraph_le [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) :
    sourceLemma35BlueGraph G C hC ≤ G := by
  intro u v huv
  change (SimpleGraph.fromEdgeSet
    (↑(sourceLemma35BlueEdges G C hC) : Set (Sym2 V))).Adj u v at huv
  rw [SimpleGraph.fromEdgeSet_adj] at huv
  have hchord := sourceLemma35_blue_subset_chords G C hC huv.1
  apply (SimpleGraph.mem_edgeSet (G := G)).mp
  exact (SimpleGraph.mem_edgeFinset (G := G)).mp
    (Finset.mem_filter.mp hchord).1

private theorem sourceLemma35_graph_le [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) :
    sourceLemma35Graph G C hC ≤ G := by
  dsimp [sourceLemma35Graph]
  exact sup_le C.toSubgraph.spanningCoe_le (sourceLemma35_blueGraph_le G C hC)

private theorem sourceLemma35_cycle_le_graph [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) :
    C.toSubgraph.spanningCoe ≤ sourceLemma35Graph G C hC := by
  dsimp [sourceLemma35Graph]
  exact le_sup_left

private theorem sourceLemma35_cycle_edges_retained [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) {e : Sym2 V}
    (he : e ∈ C.edges) : e ∈ (sourceLemma35Graph G C hC).edgeSet := by
    induction e using Sym2.ind with
    | h u v =>
      exact (SimpleGraph.mem_edgeSet (G := sourceLemma35Graph G C hC)).mpr
        (sourceLemma35_cycle_le_graph G C hC (C.mem_edges_toSubgraph.mpr he))

/-- The original Hamiltonian walk, transferred through the retained cycle
edges.  The vertex sequence is unchanged; only its ambient graph changes. -/
private noncomputable def sourceLemma35RetainedCycle [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) :
    (sourceLemma35Graph G C hC).Walk r r :=
  C.transfer (sourceLemma35Graph G C hC) fun e he =>
    sourceLemma35_cycle_edges_retained G C hC he

private theorem sourceLemma35_retainedCycle_hamiltonian [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) :
    (sourceLemma35RetainedCycle G C hC).IsHamiltonianCycle := by
  unfold sourceLemma35RetainedCycle
  have hcycle : (C.transfer (sourceLemma35Graph G C hC)
      (fun e he => sourceLemma35_cycle_edges_retained G C hC he)).IsCycle :=
    hC.isCycle.transfer (fun e he => sourceLemma35_cycle_edges_retained G C hC he)
  refine ⟨hcycle, ?_⟩
  intro v
  rw [Walk.support_tail _ hcycle.not_nil, Walk.support_transfer,
    ← Walk.support_tail C hC.isCycle.not_nil]
  exact hC.isHamiltonian_tail v

/-- A non-cycle physical edge retained by the source subgraph is a blue chord. -/
private theorem sourceLemma35_graph_noncycle_edge_blue [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) {e : Sym2 V}
    (he : e ∈ (sourceLemma35Graph G C hC).edgeSet) (hnot : e ∉ C.edges) :
    e ∈ sourceLemma35BlueEdges G C hC := by
  induction e using Sym2.ind with
  | h u v =>
    change (C.toSubgraph.spanningCoe ⊔ sourceLemma35BlueGraph G C hC).Adj u v at he
    rcases he with hcycle | hblue
    · apply (hnot (C.mem_edges_toSubgraph.mp hcycle)).elim
    · change (SimpleGraph.fromEdgeSet
        (↑(sourceLemma35BlueEdges G C hC) : Set (Sym2 V))).Adj u v at hblue
      exact (SimpleGraph.fromEdgeSet_adj
        (↑(sourceLemma35BlueEdges G C hC) : Set (Sym2 V))).mp hblue |>.1

private theorem sourceLemma35_blueGraph_edgeFinset [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) :
    (sourceLemma35BlueGraph G C hC).edgeFinset = sourceLemma35BlueEdges G C hC := by
  classical
  let blue := sourceLemma35BlueEdges G C hC
  let B := sourceLemma35BlueGraph G C hC
  ext e
  change e ∈ B.edgeFinset ↔ e ∈ blue
  rw [SimpleGraph.mem_edgeFinset]
  constructor
  · intro he
    change e ∈ (SimpleGraph.fromEdgeSet
      (↑(sourceLemma35BlueEdges G C hC) : Set (Sym2 V))).edgeSet at he
    rw [SimpleGraph.edgeSet_fromEdgeSet] at he
    exact he.1
  · intro he
    change e ∈ (SimpleGraph.fromEdgeSet
      (↑(sourceLemma35BlueEdges G C hC) : Set (Sym2 V))).edgeSet
    rw [SimpleGraph.edgeSet_fromEdgeSet]
    refine ⟨he, ?_⟩
    have hchord := sourceLemma35_blue_subset_chords G C hC he
    exact G.not_isDiag_of_mem_edgeFinset (Finset.mem_filter.mp hchord).1

private theorem sourceLemma35_blueIncident_eq_blueGraph [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (v : V) :
    sourceLemma35BlueIncident G C hC v =
      (sourceLemma35BlueGraph G C hC).incidenceFinset v := by
  classical
  let B := sourceLemma35BlueGraph G C hC
  have hBlue : B.edgeFinset = sourceLemma35BlueEdges G C hC := by
    dsimp [B]
    exact sourceLemma35_blueGraph_edgeFinset G C hC
  rw [sourceLemma35BlueIncident, G.incidenceFinset_eq_filter,
    B.incidenceFinset_eq_filter]
  ext e
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨⟨heG, hv⟩, heBlue⟩
    exact ⟨by rwa [hBlue], hv⟩
  · rintro ⟨heB, hv⟩
    have heBlue : e ∈ sourceLemma35BlueEdges G C hC := by rwa [hBlue] at heB
    have hchord := sourceLemma35_blue_subset_chords G C hC heBlue
    have heG : e ∈ G.edgeFinset := (Finset.mem_filter.mp hchord).1
    exact ⟨⟨heG, hv⟩, heBlue⟩

/-- Every selected vertex has degree at least five in the cycle-plus-blue
source subgraph. -/
private theorem sourceLemma35_graph_degree_of_mem_X [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (Y : Finset V)
    {x : V} (hx : x ∈ sourceLemma35X G C hC Y) :
    5 ≤ (sourceLemma35Graph G C hC).degree x := by
  classical
  let H := sourceLemma35Graph G C hC
  let B := sourceLemma35BlueGraph G C hC
  let cycleInc := {e ∈ G.incidenceFinset x | e ∈ C.edges}
  let blueInc := sourceLemma35BlueIncident G C hC x
  have hcycleCard : cycleInc.card = 2 := by
    dsimp [cycleInc]
    exact sourceLemma35_cycle_incident_card G C hC x
  have hblueCard : 3 ≤ blueInc.card := (Finset.mem_filter.mp hx).2
  have hdisjoint : Disjoint cycleInc blueInc := by
    apply Finset.disjoint_left.mpr
    intro e heCycle heBlue
    have heC : e ∈ C.edges := (Finset.mem_filter.mp heCycle).2
    have heB : e ∈ sourceLemma35BlueEdges G C hC :=
      (Finset.mem_filter.mp heBlue).2
    exact (Finset.mem_filter.mp (sourceLemma35_blue_subset_chords G C hC heB)).2 heC
  have hcycleSubset : cycleInc ⊆ H.incidenceFinset x := by
    intro e he
    have heInc : e ∈ G.incidenceFinset x := (Finset.mem_filter.mp he).1
    have heCycle : e ∈ C.edges := (Finset.mem_filter.mp he).2
    have heGparts : e ∈ G.edgeFinset ∧ x ∈ e := by
      rw [G.incidenceFinset_eq_filter] at heInc
      simpa only [Finset.mem_filter] using heInc
    have heCycleSet : e ∈ C.toSubgraph.spanningCoe.edgeSet := by
      change e ∈ C.toSubgraph.edgeSet
      exact C.mem_edges_toSubgraph.mpr heCycle
    have heCycleFin : e ∈ C.toSubgraph.spanningCoe.edgeFinset :=
      (SimpleGraph.mem_edgeFinset (G := C.toSubgraph.spanningCoe)).mpr heCycleSet
    have heHFin : e ∈ H.edgeFinset :=
      SimpleGraph.edgeFinset_mono (sourceLemma35_cycle_le_graph G C hC) heCycleFin
    rw [H.incidenceFinset_eq_filter]
    exact Finset.mem_filter.mpr ⟨heHFin, heGparts.2⟩
  have hblueSubset : blueInc ⊆ H.incidenceFinset x := by
    intro e he
    have heInc : e ∈ G.incidenceFinset x := (Finset.mem_filter.mp he).1
    have heBlue : e ∈ sourceLemma35BlueEdges G C hC := (Finset.mem_filter.mp he).2
    have heGparts : e ∈ G.edgeFinset ∧ x ∈ e := by
      rw [G.incidenceFinset_eq_filter] at heInc
      simpa only [Finset.mem_filter] using heInc
    have heBFin : e ∈ B.edgeFinset := by
      dsimp [B]
      rw [sourceLemma35_blueGraph_edgeFinset]
      exact heBlue
    have hB_le_H : B ≤ H := by
      dsimp [B, H, sourceLemma35Graph]
      exact le_sup_right
    have heHFin : e ∈ H.edgeFinset := SimpleGraph.edgeFinset_mono hB_le_H heBFin
    rw [H.incidenceFinset_eq_filter]
    exact Finset.mem_filter.mpr ⟨heHFin, heGparts.2⟩
  have hunionSubset : cycleInc ∪ blueInc ⊆ H.incidenceFinset x :=
    Finset.union_subset hcycleSubset hblueSubset
  have hHcard : (H.incidenceFinset x).card = H.degree x :=
    H.card_incidenceFinset_eq_degree x
  change 5 ≤ H.degree x
  rw [← hHcard]
  calc
    5 ≤ cycleInc.card + blueInc.card := by omega
    _ = (cycleInc ∪ blueInc).card := (Finset.card_union_of_disjoint hdisjoint).symm
    _ ≤ (H.incidenceFinset x).card := Finset.card_le_card hunionSubset

/-- Every non-cycle edge retained by the source subgraph has a physical
crossing partner retained there as well. -/
private theorem sourceLemma35_graph_every_chord_crossed [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) {e : Sym2 V}
    (he : e ∈ (sourceLemma35Graph G C hC).edgeSet) (hnot : e ∉ C.edges) :
    ∃ f : Sym2 V, f ∈ (sourceLemma35Graph G C hC).edgeSet ∧
      sourceLemma35PhysicalCrosses G C hC e f := by
  classical
  obtain heBlue := sourceLemma35_graph_noncycle_edge_blue G C hC he hnot
  obtain ⟨f, hcross⟩ := (Finset.mem_filter.mp heBlue).2
  have hfBlue : f ∈ sourceLemma35BlueEdges G C hC :=
    (sourceLemma35_blue_partner_blue G C hC hcross).2
  let B := sourceLemma35BlueGraph G C hC
  let H := sourceLemma35Graph G C hC
  have hfBFin : f ∈ B.edgeFinset := by
    dsimp [B]
    rw [sourceLemma35_blueGraph_edgeFinset]
    exact hfBlue
  have hB_le_H : B ≤ H := by
    dsimp [B, H, sourceLemma35Graph]
    exact le_sup_right
  exact ⟨f,
    (SimpleGraph.mem_edgeFinset (G := H)).mp
      (SimpleGraph.edgeFinset_mono hB_le_H hfBFin), hcross⟩

/-- Source Lemma 3.5 data, with `sourceLemma35Graph` fixed to the exact source
construction: the Hamiltonian cycle plus all blue physical chords. -/
private structure SourceLemma35Data [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (Y : Finset V) where
  X : Finset V
  H_le : sourceLemma35Graph G C hC ≤ G
  cycle_le : C.toSubgraph.spanningCoe ≤ sourceLemma35Graph G C hC
  X_subset : X ⊆ Y
  X_large : C.length ≤ 9 * X.card
  X_degree : ∀ x ∈ X, 5 ≤ (sourceLemma35Graph G C hC).degree x
  every_chord_crossed : ∀ e : Sym2 V,
    e ∈ (sourceLemma35Graph G C hC).edgeSet → e ∉ C.edges →
      ∃ f : Sym2 V, f ∈ (sourceLemma35Graph G C hC).edgeSet ∧
        sourceLemma35PhysicalCrosses G C hC e f

/-- Complete formal counterpart of source Lemma 3.5. -/
private noncomputable def sourceLemma35_complete [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (hgirth : 5 ≤ G.girth)
    (Y : Finset V) (hY : 4 * C.length ≤ 9 * Y.card)
    (hdegree : ∀ y ∈ Y, 6 ≤ G.degree y) : SourceLemma35Data G C hC Y := by
  refine ⟨sourceLemma35X G C hC Y,
    sourceLemma35_graph_le G C hC,
    sourceLemma35_cycle_le_graph G C hC,
    sourceLemma35_X_subset G C hC Y,
    sourceLemma35_X_large G C hC hgirth Y hY hdegree, ?_, ?_⟩
  · intro x hx
    exact sourceLemma35_graph_degree_of_mem_X G C hC Y hx
  · intro e he hnot
    exact sourceLemma35_graph_every_chord_crossed G C hC he hnot

/-- The graph obtained by deleting precisely the physical edges of `C`. -/
private noncomputable def sourceLemma36OffCycleGraph [Fintype V] [DecidableEq V]
    (C : G.Walk r r) : SimpleGraph V :=
  SimpleGraph.fromEdgeSet {e | e ∈ G.edgeSet ∧ e ∉ C.edges}

/-- A source root of degree at least five has at least three non-cycle
neighbours: precisely two incident edges belong to the Hamiltonian cycle. -/
private theorem sourceLemma36_offCycle_degree_three [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (v : V)
    (hdegree : 5 ≤ G.degree v) :
    3 ≤ (sourceLemma36OffCycleGraph G C).degree v := by
  classical
  let H := sourceLemma36OffCycleGraph G C
  let I := G.incidenceFinset v
  let Q := I.filter fun e => e ∉ C.edges
  have hcycle : (I.filter fun e => e ∈ C.edges).card = 2 := by
    dsimp [I]
    exact sourceLemma35_cycle_incident_card G C hC v
  have hpartition : (I.filter fun e => e ∈ C.edges).card + Q.card = I.card := by
    simpa [Q] using
      (Finset.filter_card_add_filter_neg_card_eq_card (s := I) fun e => e ∈ C.edges)
  have hIcard : I.card = G.degree v := by
    dsimp [I]
    exact G.card_incidenceFinset_eq_degree v
  have hHinc : H.incidenceFinset v = Q := by
    rw [H.incidenceFinset_eq_filter]
    change {e ∈ H.edgeFinset | v ∈ e} =
      {e ∈ G.incidenceFinset v | e ∉ C.edges}
    rw [G.incidenceFinset_eq_filter]
    ext e
    simp only [Finset.mem_filter]
    change ((e ∈ H.edgeFinset ∧ v ∈ e) ↔
      ((e ∈ G.edgeFinset ∧ v ∈ e) ∧ e ∉ C.edges))
    have hedge : e ∈ H.edgeFinset ↔ e ∈ G.edgeFinset ∧ e ∉ C.edges := by
      rw [SimpleGraph.mem_edgeFinset, SimpleGraph.mem_edgeFinset]
      dsimp [H, sourceLemma36OffCycleGraph]
      rw [SimpleGraph.edgeSet_fromEdgeSet]
      simp only [Set.mem_diff, Set.mem_setOf_eq]
      constructor
      · exact fun h => h.1
      · intro h
        exact ⟨h, G.not_isDiag_of_mem_edgeSet h.1⟩
    constructor
    · rintro ⟨he, hv⟩
      exact ⟨⟨(hedge.mp he).1, hv⟩, (hedge.mp he).2⟩
    · rintro ⟨⟨he, hv⟩, hnot⟩
      exact ⟨hedge.mpr ⟨he, hnot⟩, hv⟩
  have hHcard : (H.incidenceFinset v).card = H.degree v :=
    H.card_incidenceFinset_eq_degree v
  change 3 ≤ H.degree v
  rw [← hHcard, hHinc]
  omega

/-- A source-relevant internal chord of a piece: it is a non-cycle edge with a
root endpoint in `Z`, not merely an arbitrary chord lying in that piece. -/
private def sourceLemma36HasZIncidentInternalChord [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (Z : Finset V) (P : Set V) : Prop :=
  ∃ z ∈ Z, z ∈ P ∧ ∃ w ∈ P, (sourceLemma36OffCycleGraph G C).Adj z w

/-- Case B of the repaired Lemma 3.6 split: if a piece has no internal
`Z`-incident off-cycle edge, every off-cycle neighbour of one of its `Z`
vertices lies outside the piece. -/
private theorem sourceLemma36_offCycle_neighbour_leaves_piece [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (Z : Finset V) (P : Set V)
    (hno : ¬ sourceLemma36HasZIncidentInternalChord G C Z P)
    {z w : V} (hzZ : z ∈ Z) (hzP : z ∈ P)
    (hzw : (sourceLemma36OffCycleGraph G C).Adj z w) :
    w ∉ P := by
  intro hwP
  apply hno
  exact ⟨z, hzZ, hzP, w, hwP, hzw⟩

/-- The exact source constant in Lemma 3.6.  The printed proof states
`2(k+2)^2` common neighbours after an estimate that yields
`> 2(k^2+2)`; the latter is sufficient for the two disjoint groups of
`k^2+2` vertices used by the net construction. -/
private def sourceLemma36_c (k : ℕ) : ℕ :=
  4 * k^3 * (k + 2) +
    2 * k * (k^2 + 2) * Nat.choose (4 * k^2 * (k + 2)) 3

/-- The large-matching cutoff in the printed Case-B argument of Lemma 3.6. -/
private def sourceLemma36MatchingThreshold (k : ℕ) : ℕ :=
  4 * k^2 * (k + 2)

/-- The residual-root budget required by the small-matching pigeonhole
argument on printed page 10. -/
private def sourceLemma36SmallMatchingBudget (k : ℕ) : ℕ :=
  2 * (k^2 + 2) * Nat.choose (sourceLemma36MatchingThreshold k) 3

/-- The printed proof states `2*(k+2)^2` after the pigeonhole step, but its
preceding count yields `2*(k^2+2)`.  The latter is sufficient: it splits into
two disjoint groups of `k^2+2` attachments for the net construction. -/
private theorem sourceLemma36_exists_two_disjoint_attachment_groups
    [DecidableEq V] (S : Finset V) (n : ℕ) (hS : 2 * n ≤ S.card) :
    ∃ A B : Finset V, A ⊆ S ∧ B ⊆ S ∧ Disjoint A B ∧
      A.card = n ∧ B.card = n := by
  obtain ⟨A, hAS, hAcard⟩ := Finset.exists_subset_card_eq
    (show n ≤ S.card by omega)
  have hBsize : n ≤ (S \ A).card := by
    have hcard := Finset.card_sdiff_add_card_inter S A
    have hinter : (S ∩ A).card = A.card := by
      rw [Finset.inter_eq_right.mpr hAS]
    omega
  obtain ⟨B, hBSA, hBcard⟩ := Finset.exists_subset_card_eq hBsize
  refine ⟨A, B, hAS, ?_, ?_, hAcard, hBcard⟩
  · exact hBSA.trans Finset.sdiff_subset
  · exact disjoint_sdiff_self_right.mono_right hBSA

/-- The integer quota used for the source's `|Z| / k` partition estimate. -/
private def sourceLemma36_partitionQuota (k : ℕ) : ℕ :=
  4 * k^2 * (k + 2) +
    2 * (k^2 + 2) * Nat.choose (4 * k^2 * (k + 2)) 3

/-- The partition quota is exactly the source's large-matching cutoff plus
the small-matching common-neighbour budget. -/
private theorem sourceLemma36_partitionQuota_eq_matchingThreshold_add_budget (k : ℕ) :
    sourceLemma36_partitionQuota k =
      sourceLemma36MatchingThreshold k + sourceLemma36SmallMatchingBudget k := rfl

private theorem sourceLemma36_c_eq_partitionQuota_mul (k : ℕ) :
    sourceLemma36_c k = k * sourceLemma36_partitionQuota k := by
  simp only [sourceLemma36_c, sourceLemma36_partitionQuota]
  ring

/-- The exact source cardinality hypothesis makes the integer quotient quota
at least the value used in the later matching count; no divisibility of `Z` is
assumed. -/
private theorem sourceLemma36_partitionQuota_le_div [Fintype V]
    (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (hZlarge : sourceLemma36_c k ≤ Z.card) :
    sourceLemma36_partitionQuota k ≤ Z.card / k := by
  rw [sourceLemma36_c_eq_partitionQuota_mul] at hZlarge
  exact (Nat.le_div_iff_mul_le hk).mpr (by simpa [Nat.mul_comm] using hZlarge)

/-- Select exactly the `k * q` roots used by the Lemma 3.6 partition,
without imposing any divisibility condition on the original root set. -/
private theorem sourceLemma36_exists_exact_root_subset [Fintype V]
    (k : ℕ) (Z : Finset V)
    (hZlarge : sourceLemma36_c k ≤ Z.card) :
    ∃ Z0 : Finset V, Z0 ⊆ Z ∧
      Z0.card = k * sourceLemma36_partitionQuota k := by
  have hsize : k * sourceLemma36_partitionQuota k ≤ Z.card := by
    rw [← sourceLemma36_c_eq_partitionQuota_mul]
    exact hZlarge
  exact Finset.exists_subset_card_eq hsize

private theorem sourceLemma36_partitionQuota_pos
    (k : ℕ) (hk : 1 ≤ k) :
    0 < sourceLemma36_partitionQuota k := by
  unfold sourceLemma36_partitionQuota
  have hkpos : 0 < k := by omega
  have hfirst : 0 < 4 * k^2 * (k + 2) := by
    exact Nat.mul_pos (Nat.mul_pos (by omega) (pow_pos hkpos _)) (by omega)
  exact lt_of_lt_of_le hfirst (Nat.le_add_right _ _)

private theorem sourceLemma36_exact_root_subset_nonempty [Fintype V]
    (k : ℕ) (hk : 1 ≤ k) (Z0 : Finset V)
    (hcard : Z0.card = k * sourceLemma36_partitionQuota k) :
    Z0.Nonempty := by
  apply Finset.card_pos.mp
  rw [hcard]
  exact Nat.mul_pos (by omega) (sourceLemma36_partitionQuota_pos k hk)

private theorem sourceLemma36_exists_exact_root_subset_with_anchor [Fintype V]
    (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (hZlarge : sourceLemma36_c k ≤ Z.card) :
    ∃ Z0 : Finset V, ∃ a : V, Z0 ⊆ Z ∧
      Z0.card = k * sourceLemma36_partitionQuota k ∧ a ∈ Z0 := by
  obtain ⟨Z0, hsubset, hcard⟩ := sourceLemma36_exists_exact_root_subset k Z hZlarge
  obtain ⟨a, ha⟩ := sourceLemma36_exact_root_subset_nonempty k hk Z0 hcard
  exact ⟨Z0, a, hsubset, hcard, ha⟩

/-- The Hamiltonian cycle, cut immediately before the chosen root.  Its tail
visits every vertex exactly once, so this is a canonical linear presentation
of the otherwise cyclic order. -/
private noncomputable def sourceLemma36RotatedCycleOrder [DecidableEq V]
    (C : G.Walk r r) (a : V) : List V :=
  C.tail.support.rotate (C.tail.support.idxOf a)

private theorem sourceLemma36_rotatedCycleOrder_nodup [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V) :
    (sourceLemma36RotatedCycleOrder G C a).Nodup := by
  apply List.nodup_rotate.mpr
  exact List.nodup_iff_count_le_one.mpr fun v =>
    le_of_eq (hC.isHamiltonian_tail v)

private theorem sourceLemma36_rotatedCycleOrder_toFinset [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V) :
    (sourceLemma36RotatedCycleOrder G C a).toFinset = Finset.univ := by
  apply Finset.ext
  intro v
  simp only [sourceLemma36RotatedCycleOrder, List.mem_toFinset, List.mem_rotate,
    Finset.mem_univ, iff_true]
  exact hC.isHamiltonian_tail.mem_support v

private theorem sourceLemma36_rotatedCycleOrder_starts_at [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V) :
    (sourceLemma36RotatedCycleOrder G C a).head? = some a := by
  have ha : a ∈ C.tail.support := hC.isHamiltonian_tail.mem_support a
  have hidx : C.tail.support.idxOf a < C.tail.support.length :=
    List.idxOf_lt_length_iff.mpr ha
  calc
    (sourceLemma36RotatedCycleOrder G C a).head? =
        C.tail.support[C.tail.support.idxOf a]? := by
      exact List.head?_rotate hidx
    _ = some a := List.getElem?_idxOf ha

/-- A vertex presented at any position of the anchor-cut order is a genuine
vertex of the Hamiltonian cycle.  Keeping this witness explicit is essential
when that position is used as an endpoint of `sourceOrientedCycleSubpath`. -/
private theorem sourceLemma36_rotatedPosition_mem_cycle [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V)
    (p : Fin (sourceLemma36RotatedCycleOrder G C a).length) :
