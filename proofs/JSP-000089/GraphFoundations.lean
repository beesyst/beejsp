    intro z hzI hz
    rw [Walk.mem_support_append_iff] at hz
    have hzC := hIC z hzI
    have hwNot : w.val ∉ I.support := by
      intro hw
      rw [hIs, List.mem_map] at hw
      obtain ⟨t, ht, heq⟩ := hw
