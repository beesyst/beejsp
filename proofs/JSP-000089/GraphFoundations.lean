    (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder :
      SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2))
    (i : Fin k) (x : V) :
    x ∈ (sourceLemma38Qv
      G C k hk Z data iP matching ladder i).support ↔
      ∃ s : Fin (sourceLemma36ComplementOrderAt
          G C hC k Z data iP).length,
        ladder.secondPosition
            (sourceLemma38BlockLastIndex k hk i) ≤ s ∧
        s ≤ ladder.secondPosition
            (sourceLemma38BlockFirstIndex k hk i) ∧
        (sourceLemma36ComplementOrderAt
          G C hC k Z data iP).get s = x := by
  have hindex :
      sourceLemma38BlockFirstIndex k hk i <
        sourceLemma38BlockLastIndex k hk i :=
    lt_of_le_of_lt
      (sourceLemma38_block_indices k hk i).1
      (sourceLemma38_block_indices k hk i).2.1

  have hsecond :
      ladder.secondPosition (sourceLemma38BlockLastIndex k hk i) ≤
        ladder.secondPosition (sourceLemma38BlockFirstIndex k hk i) :=
    (ladder.second_arc_order
      (sourceLemma38BlockFirstIndex k hk i)
      (sourceLemma38BlockLastIndex k hk i)
      hindex).le

  rw [sourceLemma38Qv, sourceLemma36_walkReendpoint_support]

  exact sourceLemma36_mem_complementOrderAtSegment_iff
    G C hC k Z data iP
    (ladder.secondPosition (sourceLemma38BlockLastIndex k hk i))
    (ladder.secondPosition (sourceLemma38BlockFirstIndex k hk i))
    hsecond x

/-- Every second endpoint in the exact `4k` block lies on `Qvᵢ`. -/
private theorem sourceLemma38_secondVertex_mem_Qv_of_block [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k)
    (Z : Finset V) (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2))
    (i : Fin k) (j : Fin (4 * k^2))
    (hfirst : sourceLemma38BlockFirstIndex k hk i ≤ j)
    (hlast : j ≤ sourceLemma38BlockLastIndex k hk i) :
    ladder.secondVertex j ∈ (sourceLemma38Qv G C k hk Z data iP matching ladder i).support := by
  rw [sourceLemma38Qv, sourceLemma36_walkReendpoint_support]
  rw [← ladder.secondPosition_vertex j]
  apply sourceLemma36_complementOrderAt_segment_contains G C hC k Z data iP
  · by_cases h : j = sourceLemma38BlockLastIndex k hk i
    · simpa [h]
    · exact (ladder.second_arc_order _ _ (lt_of_le_of_ne hlast h)).le
  · by_cases h : j = sourceLemma38BlockFirstIndex k hk i
    · simpa [h]
    · exact (ladder.second_arc_order _ _ (lt_of_le_of_ne hfirst (Ne.symm h))).le

/-- Each rung of a Section-2 ladder is itself an actual chord of its base
cycle, not merely a path with a declared length. -/
private noncomputable def sourceLemma36Section2LadderRungChord
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) {n : ℕ}
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching n) (i : Fin n) :
    SourceLemma34Chord G C where
  fst := ladder.firstVertex i
  snd := ladder.secondVertex i
  fst_mem := by simpa only [ladder.cycle_def] using ladder.first_on_cycle i
  snd_mem := by simpa only [ladder.cycle_def] using ladder.second_on_cycle i
  adj := sourceLemma36_adj_of_length_one G (ladder.rung i) (ladder.rung_length_one i)
  not_cycle_edge := by
    simpa only [ladder.cycle_def] using ladder.rung_off_cycle i

/-- The Section-2 owner label of the printed central rung in a Lemma 3.8
block. -/
private def sourceLemma38CentralOwner (k : ℕ) (hk : 1 ≤ k) {n : ℕ}
    (sectionOwner : Fin (4 * k^2) → Fin n) (i : Fin k) : Fin n :=
  sectionOwner (sourceLemma38CentralRungIndex k hk i)

private theorem sourceLemma38_centralIndex_strictMono (k : ℕ) (hk : 1 ≤ k) :
    StrictMono (sourceLemma38CentralRungIndex k hk) := by
  intro i j hij
  apply Fin.mk_lt_mk.mpr
  dsimp [sourceLemma38CentralRungIndex]
  have hcoeff : 4 * i.1 + 2 < 4 * j.1 + 2 := by omega
  have hbase : (4 * i.1 + 2) * k < (4 * j.1 + 2) * k :=
    Nat.mul_lt_mul_of_pos_right hcoeff (by omega)
  exact Nat.sub_lt_sub_right (by nlinarith) hbase

/-- Distinct Lemma 3.8 blocks have distinct central K4-owner labels. -/
private theorem sourceLemma38_centralOwner_injective (k : ℕ) (hk : 1 ≤ k) {n : ℕ}
    (sectionOwner : Fin (4 * k^2) → Fin n)
    (hsectionOwner : Function.Injective sectionOwner) :
    Function.Injective (sourceLemma38CentralOwner k hk sectionOwner) := by
  intro i j hij
  apply (sourceLemma38_centralIndex_strictMono k hk).injective
  apply hsectionOwner
  exact hij

/-- The printed central Section-2 rung `eᵢ`. -/
private noncomputable def sourceLemma38CentralRungChord [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k)
    (Z : Finset V) (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2))
    (i : Fin k) : SourceLemma34Chord G C :=
  sourceLemma36Section2LadderRungChord G C k Z data iP matching ladder
    (sourceLemma38CentralRungIndex k hk i)

/-- The central rung lies on its two exact block segments, and both endpoints
belong to its transported K4 owner. -/
private theorem sourceLemma38_central_rung_geometry [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) {hC : C.IsHamiltonianCycle}
    (n : ℕ) (family : SourceLemma38RootedK4Family G C n) (k : ℕ) (hk : 1 ≤ k)
    (Z : Finset V) (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2))
    (sectionOwner : Fin (4 * k^2) → Fin n)
    (hfirstOwner : ∀ j, ladder.firstVertex j ∈ family.vertices (sectionOwner j))
    (hsecondOwner : ∀ j, ladder.secondVertex j ∈ family.vertices (sectionOwner j))
    (i : Fin k) :
    (sourceLemma38CentralRungChord G C k hk Z data iP matching ladder i).fst ∈
        (sourceLemma38Qu G C k hk Z data iP matching ladder i).support ∧
      (sourceLemma38CentralRungChord G C k hk Z data iP matching ladder i).snd ∈
        (sourceLemma38Qv G C k hk Z data iP matching ladder i).support ∧
      (sourceLemma38CentralRungChord G C k hk Z data iP matching ladder i).fst ∈
          family.vertices (sourceLemma38CentralOwner k hk sectionOwner i) ∧
        (sourceLemma38CentralRungChord G C k hk Z data iP matching ladder i).snd ∈
          family.vertices (sourceLemma38CentralOwner k hk sectionOwner i) := by
  let central := sourceLemma38CentralRungIndex k hk i
  have hblock := sourceLemma38_block_indices k hk i
  change ladder.firstVertex central ∈ _ ∧ ladder.secondVertex central ∈ _ ∧
    ladder.firstVertex central ∈ family.vertices (sectionOwner central) ∧
      ladder.secondVertex central ∈ family.vertices (sectionOwner central)
  exact ⟨sourceLemma38_firstVertex_mem_Qu_of_block G C k hk Z data iP matching ladder i
      central hblock.1 hblock.2.1.le,
    sourceLemma38_secondVertex_mem_Qv_of_block G C k hk Z data iP matching ladder i
      central hblock.1 hblock.2.1.le,
    hfirstOwner central, hsecondOwner central⟩

/-- The exact Lemma 3.6 case split needed by the unrooted Lemma 3.7
construction.  The decreasing case retains its certified boundary-cycle
geometry, while the increasing case retains the literal residual `4k²`-ladder.
Neither case introduces a claim about roots of later crossing chords. -/
private def SourceLemma36PreLemma37Result [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V) : Prop :=
  (∃ data : SourceLemma36PartitionData G C hC k Z,
    Nonempty (SourceLemma36ProperTruncation G C hC k Z data)) ∨
  (∃ (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (T : Finset V) (u w v x y : V), Nonempty (SourceLemma36KSquaredNet G C k Z T u w v x y)) ∨
  (∃ (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    , Nonempty (SourceLemma36KCrossladderCertificate G C k Z data iP matching)) ∨
  (∃ (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)),
      ∃ ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching,
        Nonempty (SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2)))

/-- Source Lemma 3.6, packaged only to the extent needed to begin the
unrooted Lemma 3.7 case analysis. -/
private theorem sourceLemma36_preLemma37_complete
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsHamiltonianCycle) (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (hdegree : ∀ z ∈ Z, 5 ≤ G.degree z)
    (hZlarge : sourceLemma36_c k ≤ Z.card) :
    SourceLemma36PreLemma37Result G C hC k Z := by
  let data := sourceLemma36_partition_data G C hC k hk Z hZlarge
  rcases sourceLemma36_piece_chord_split G C hC k Z data with hall | ⟨iP, hno⟩
  · exact Or.inl ⟨data, ⟨sourceLemma36_caseA_core_chords_yield_proper_truncation
      G C hC k Z data hall⟩⟩
  let matching := sourceLemma36_caseB_matchingAt G C hC k Z data iP
  by_cases hlarge : sourceLemma36MatchingThreshold k ≤ matching.P.card
  · rcases sourceLemma36_caseB_large_matching_monotone G C hC k Z data iP matching hlarge with
      hdecreasing | hincreasing
    · rcases hdecreasing with ⟨selection⟩
      obtain ⟨certificate⟩ := sourceLemma36_large_decreasing_yields_crossladder_certificate
        G C hC k Z data iP matching selection
      exact Or.inr (Or.inr (Or.inl ⟨data, iP, matching, ⟨certificate⟩⟩))
    · rcases hincreasing with ⟨selection⟩
      obtain ⟨ladder⟩ := sourceLemma36_large_increasing_yields_ladder
        G C hC k Z data iP matching selection
      exact Or.inr (Or.inr (Or.inr ⟨data, iP, matching, ladder,
        sourceLemma36_fourKSquaredLadder_section2_bridge
          G C k Z data iP matching ladder⟩))
  · have hsmall : matching.P.card < sourceLemma36MatchingThreshold k :=
      Nat.lt_of_not_ge hlarge
    have hlocalDegree : ∀ z ∈ sourceLemma36CaseBRootsAt G C hC k Z data iP,
        5 ≤ G.degree z := by
      intro z hz
      exact hdegree z ((sourceLemma36_mem_caseB_rootsAt_iff G C hC k Z data iP z).mp hz).1
    obtain ⟨T, u, w, v, x, y, hnet⟩ := sourceLemma36_caseB_small_matching_yields_net
      G C hC k Z data iP matching hno hlocalDegree hsmall
    exact Or.inr (Or.inl ⟨data, iP, matching, T, u, w, v, x, y, hnet⟩)

/-- The source Lemma 3.6 invocation in Lemma 3.7 genuinely takes place in
the retained graph from Lemma 3.5.  Its size hypothesis is exactly the source
chain `9 c(k) ≤ |C| ≤ 9 |X|`. -/
private theorem sourceLemma37_retained_preLemma37
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsHamiltonianCycle) (k : ℕ) (hk : 1 ≤ k) (Y : Finset V)
    (retained : SourceLemma35Data G C hC Y)
    (hcycle_large : 9 * sourceLemma36_c k ≤ C.length) :
    SourceLemma36PreLemma37Result (sourceLemma35Graph G C hC)
      (sourceLemma35RetainedCycle G C hC)
      (sourceLemma35_retainedCycle_hamiltonian G C hC) k retained.X := by
  have hretained_length : (sourceLemma35RetainedCycle G C hC).length = C.length := by
    simp only [sourceLemma35RetainedCycle, Walk.length_transfer]
  have hXlarge : sourceLemma36_c k ≤ retained.X.card := by
    rw [← hretained_length] at hcycle_large
    have hretained_large := retained.X_large
    omega
  exact sourceLemma36_preLemma37_complete
    (G := sourceLemma35Graph G C hC) (sourceLemma35RetainedCycle G C hC)
    (sourceLemma35_retainedCycle_hamiltonian G C hC) k hk retained.X retained.X_degree hXlarge

/-- The direct Lemma 3.6 alternatives already supply objects that remain
valid when roots are forgotten.  The two remaining alternatives are exactly
the decreasing crossladder certificate and the increasing residual ladder. -/
private theorem sourceLemma37_direct_unrooted_or_residual
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (h36 : SourceLemma36PreLemma37Result G C hC k Z) :
    ((∃ data : SourceLemma36PartitionData G C hC k Z,
      Nonempty (SourceLemma36ProperTruncation G C hC k Z data)) ∨
      (∃ (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
        (matching : SourceLemma36CaseBMatchingData
          (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
        (T : Finset V) (u w v x y : V),
          Nonempty (SourceLemma36KSquaredNet G C k Z T u w v x y))) ∨
    (∃ (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
      (matching : SourceLemma36CaseBMatchingData
        (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
      , Nonempty (SourceLemma36KCrossladderCertificate G C k Z data iP matching)) ∨
  (∃ (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)),
      ∃ ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching,
        Nonempty (SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2))) := by
  rcases h36 with hproper | hnet | hcertificate | hladder
  · exact Or.inl (Or.inl hproper)
  · exact Or.inl (Or.inr hnet)
  · exact Or.inr (Or.inl hcertificate)
  · exact Or.inr (Or.inr hladder)

/-- The first residual rung in VOR Lemma 3.7's block
`[2ik + 1, 2(i + 1)k]`, translated from the paper's one-based notation. -/
private def sourceLemma37BlockFirstIndex (k : ℕ) (i : Fin (2 * k - 1)) :
    Fin (4 * k^2) :=
  ⟨2 * i.1 * k, by
    have hi : i.1 < 2 * k - 1 := i.2
    have hk : 1 ≤ k := by
      by_contra h
      have : k = 0 := by omega
      subst k
      simp at hi
    have hi' : i.1 + 1 < 2 * k := by omega
    simp only [pow_two]
    nlinarith⟩

/-- The final residual rung in VOR Lemma 3.7's block
`[2ik + 1, 2(i + 1)k]`, translated from the paper's one-based notation. -/
private def sourceLemma37BlockLastIndex (k : ℕ) (i : Fin (2 * k - 1)) :
    Fin (4 * k^2) :=
  ⟨2 * (i.1 + 1) * k - 1, by
    have hi : i.1 < 2 * k - 1 := i.2
    have hk : 1 ≤ k := by
      by_contra h
      have : k = 0 := by omega
      subst k
      simp at hi
    have hi' : i.1 + 1 < 2 * k := by omega
    simp only [pow_two]
    have hbound : 2 * (i.1 + 1) * k < 4 * (k * k) := by
      nlinarith
    exact lt_of_le_of_lt (Nat.sub_le _ _) hbound⟩

/-- The paper's `eᵢ = u_{(2i+1)k}v_{(2i+1)k}`, with its one-based rung
number converted to Lean's zero-based finite index. -/
private def sourceLemma37CentralRungIndex (k : ℕ) (hk : 1 ≤ k)
    (i : Fin (2 * k - 1)) : Fin (4 * k^2) :=
  ⟨(2 * i.1 + 1) * k - 1, by
    have hi : i.1 < 2 * k - 1 := i.2
    have hi' : i.1 + 1 < 2 * k := by omega
    simp only [pow_two]
    have hbound : (2 * i.1 + 1) * k < 4 * (k * k) := by
      nlinarith
    exact lt_of_le_of_lt (Nat.sub_le _ _) hbound⟩

/-- The exact finite block `Eᵢ` of the residual `4k²`-ladder. -/
private def sourceLemma37BlockRungs (k : ℕ) (i : Fin (2 * k - 1)) :
    Finset (Fin (4 * k^2)) :=
  Finset.univ.filter fun j =>
    sourceLemma37BlockFirstIndex k i ≤ j ∧ j ≤ sourceLemma37BlockLastIndex k i

/-- The distinguished VOR rung lies in its block; for `k = 1` it is the
left endpoint, while it remains strictly before the right endpoint. -/
private theorem sourceLemma37_block_indices
    (k : ℕ) (hk : 1 ≤ k) (i : Fin (2 * k - 1)) :
    sourceLemma37BlockFirstIndex k i ≤ sourceLemma37CentralRungIndex k hk i ∧
      sourceLemma37CentralRungIndex k hk i < sourceLemma37BlockLastIndex k i := by
  constructor
  · apply Fin.mk_le_mk.mpr
    dsimp [sourceLemma37BlockFirstIndex,
      sourceLemma37CentralRungIndex, sourceLemma37BlockLastIndex]
    have hbase : 2 * i.1 * k + 1 ≤ (2 * i.1 + 1) * k := by
      nlinarith
    omega
  · apply Fin.mk_lt_mk.mpr
    dsimp [sourceLemma37BlockFirstIndex,
      sourceLemma37CentralRungIndex, sourceLemma37BlockLastIndex]
    have hbase : (2 * i.1 + 1) * k < 2 * (i.1 + 1) * k := by
      nlinarith
    exact Nat.sub_lt_sub_right (by nlinarith) hbase

/-- The `k` rungs from the left half of `Eᵢ`. -/
private def sourceLemma37LeftBufferIndex (k : ℕ) (hk : 1 ≤ k)
    (i : Fin (2 * k - 1)) (t : Fin k) : Fin (4 * k^2) :=
  ⟨(sourceLemma37BlockFirstIndex k i).1 + t.1, by
    have ht : t.1 < k := t.2
    have hle :
        (sourceLemma37BlockFirstIndex k i).1 + t.1 ≤
          (sourceLemma37CentralRungIndex k hk i).1 := by
      let base := 2 * i.1 * k
      have hmul : (2 * i.1 + 1) * k = base + k := by
        dsimp [base]
        ring
      dsimp [sourceLemma37BlockFirstIndex, sourceLemma37CentralRungIndex]
      rw [hmul]
      omega
    exact lt_of_le_of_lt hle
      (sourceLemma37CentralRungIndex k hk i).isLt⟩

/-- The `k` rungs from the right half of `Eᵢ`. -/
private def sourceLemma37RightBufferIndex (k : ℕ) (hk : 1 ≤ k)
    (i : Fin (2 * k - 1)) (t : Fin k) : Fin (4 * k^2) :=
  ⟨(sourceLemma37CentralRungIndex k hk i).1 + 1 + t.1, by
    have ht : t.1 < k := t.2
    have hle :
        (sourceLemma37CentralRungIndex k hk i).1 + 1 + t.1 ≤
          (sourceLemma37BlockLastIndex k i).1 := by
      let base := (2 * i.1 + 1) * k
      have hmul : 2 * (i.1 + 1) * k = base + k := by
        dsimp [base]
        ring
      have hbase : 1 ≤ base := by
        dsimp [base]
        nlinarith
      dsimp [sourceLemma37CentralRungIndex, sourceLemma37BlockLastIndex]
      rw [hmul]
      omega
    exact lt_of_le_of_lt hle (sourceLemma37BlockLastIndex k i).isLt⟩

/-- Both displayed buffers are literal subfamilies of `Eᵢ`. -/
private theorem sourceLemma37_buffer_mem_block
    (k : ℕ) (hk : 1 ≤ k) (i : Fin (2 * k - 1)) (t : Fin k) :
    sourceLemma37LeftBufferIndex k hk i t ∈ sourceLemma37BlockRungs k i ∧
      sourceLemma37RightBufferIndex k hk i t ∈ sourceLemma37BlockRungs k i := by
  simp only [sourceLemma37BlockRungs, Finset.mem_filter,
    Finset.mem_univ, true_and]

  constructor

  · constructor

    -- blockFirst ≤ leftBuffer
    · apply Fin.mk_le_mk.mpr
      dsimp [sourceLemma37LeftBufferIndex,
        sourceLemma37BlockFirstIndex]
      omega

    -- leftBuffer ≤ blockLast
    · apply le_trans
        (b := sourceLemma37CentralRungIndex k hk i)

      -- leftBuffer ≤ central
      · apply Fin.mk_le_mk.mpr
        dsimp [sourceLemma37LeftBufferIndex,
          sourceLemma37BlockFirstIndex,
          sourceLemma37CentralRungIndex]
        have ht : t.1 < k := t.2
        have hmul :
            (2 * i.1 + 1) * k = 2 * i.1 * k + k := by
          ring
        rw [hmul]
        omega

      -- central ≤ blockLast
      · exact (sourceLemma37_block_indices k hk i).2.le

  · constructor

    -- blockFirst ≤ rightBuffer
    · apply le_trans
        (b := sourceLemma37CentralRungIndex k hk i)

      · exact (sourceLemma37_block_indices k hk i).1

      · apply Fin.mk_le_mk.mpr
        change
          (sourceLemma37CentralRungIndex k hk i).1 ≤
            (sourceLemma37CentralRungIndex k hk i).1 + 1 + t.1
        omega

    -- rightBuffer ≤ blockLast
    · apply Fin.mk_le_mk.mpr
      dsimp [sourceLemma37RightBufferIndex,
        sourceLemma37CentralRungIndex,
        sourceLemma37BlockLastIndex]
      have ht : t.1 < k := t.2
      have hcentral :
          (2 * i.1 + 1) * k = 2 * i.1 * k + k := by
        ring
      have hlast :
          2 * (i.1 + 1) * k = 2 * i.1 * k + 2 * k := by
        ring
      rw [hcentral, hlast]
      omega

/-- The VOR path `Quᵢ`: the exact oriented cycle subpath between the two
first-side ends of `Eᵢ`, traversed in the direction that contains the block's
first endpoints. -/
private noncomputable def sourceLemma37Qu
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching)
    (i : Fin (2 * k - 1)) :
    G.Walk (ladder.firstVertex (sourceLemma37BlockFirstIndex k i))
      (ladder.firstVertex (sourceLemma37BlockLastIndex k i)) :=
  (sourceLemma36RotatedPositionSubpath G C hC data.anchor
    (ladder.firstPosition (sourceLemma37BlockLastIndex k i))
    (ladder.firstPosition (sourceLemma37BlockFirstIndex k i))).reverse.copy
      (by
        rw [ladder.firstPosition_vertex])
      (by
        rw [ladder.firstPosition_vertex])

/-- `Quᵢ` is a simple cycle subpath. -/
private theorem sourceLemma37Qu_isPath
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
