private theorem sourceLemma39_rootGraph_edge_bound [DecidableEq V] {n : ℕ}
    (root : Fin n → V) (hroot : Function.Injective root)
    (X : Fin n → Finset V) (hX : ∀ i, (X i).card = 4) :
    (sourceLemma39RootGraph root X).edgeFinset.card ≤ 6*n := by
  classical
  let Y := fun l => Finset.univ.filter fun i : Fin n => root i ∈ X l
  let E := fun l => (Y l).sym2.filter fun e => ¬e.IsDiag
  have hY l : (Y l).card ≤ 4 := by
    rw [← hX l]
    apply Finset.card_le_card_of_injOn root
    · intro i hi; exact (Finset.mem_filter.mp hi).2
    · exact hroot.injOn
  have hE l : (E l).card ≤ 6 := sourceLemma39_fourSet_edges_card (Y l) (hY l)
  have hsub : (sourceLemma39RootGraph root X).edgeFinset ⊆ Finset.univ.biUnion E := by
