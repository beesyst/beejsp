  have hb (i : Fin k) : b i ∈ P.support := by rw [hsup]; exact List.get_mem _ _
  have hab (i : Fin k) : P.support.idxOf (a i) < P.support.idxOf (b i) := by
    rw [idxA, idxB]; exact T.left_lt_right i
  have horder (i j : Fin k) (hij : i < j) : P.support.idxOf (b i) < P.support.idxOf (a j) := by
    rw [idxB, idxA]; exact T.endpoint_order hij
  have coverage (z : V) : z ∈ P.support ↔ z ∈ C.support := by
    have hn := T.isCycle.not_nil
    have htail : z ∈ C.tail.support ↔ z ∈ C.support := by
      rw [← C.cons_support_tail hn]
      simp only [Walk.support_cons, List.mem_cons]
      constructor
      · exact Or.inr
      · rintro (he | hz)
        · subst z; exact C.tail.end_mem_support
        · exact hz
    rw [hsup]
    simpa only [sourceLemma36RotatedCycleOrder, List.mem_rotate] using htail
  have available (i : Fin k) := sourceLemma21_linear_segment G P hP (ha i) (hb i) (le_of_lt (hab i))
  choose arc harc hmem hArcLen hArcEdges using available
  have hArcOriginal (i : Fin k) : (arc i).length =
      (sourceOrientedCycleSubpath G C (T.left_mem i) (T.right_mem i)).length := by
    rw [hArcLen, idxA, idxB]
    exact (sourceLemma21_arc_coordinates G C T.isCycle T.anchor
      (T.leftPosition i) (T.rightPosition i) (le_of_lt (T.left_lt_right i))
      (T.left_mem i) (T.right_mem i)).1.symm
  refine ⟨arc, fun i => ⟨harc i, hArcOriginal i, fun e he => hPedges e (hArcEdges i e he)⟩, ?_⟩
  intro choose
  let Q : ∀ i, G.Walk (a i) (b i) := fun i => if choose i then T.attachment i else arc i
  have hQ (i : Fin k) : (Q i).IsPath := by
    dsimp only [Q]; split_ifs
    · exact T.attachment_isPath i
    · exact harc i
  have bound (i : Fin k) (z : V) (hzQ : z ∈ (Q i).support) (hzP : z ∈ P.support) :
      P.support.idxOf (a i) ≤ P.support.idxOf z ∧ P.support.idxOf z ≤ P.support.idxOf (b i) := by
    dsimp only [Q] at hzQ
    split_ifs at hzQ with hc
    · have hzC := (coverage z).mp hzP
      have hend : z = a i ∨ z = b i := by
        by_contra hn
        push_neg at hn
        exact Set.disjoint_left.mp (T.attachment_internal_disjoint_cycle i) ⟨hzQ, hn.1, hn.2⟩ hzC
      rcases hend with rfl | rfl <;> exact ⟨by have := hab i; omega, by have := hab i; omega⟩
    · exact ((hmem i z).mp hzQ).2
  have hdis (i j : Fin k) (hij : i ≠ j) : Disjoint {z | z ∈ (Q i).support} {z | z ∈ (Q j).support} := by
    apply Set.disjoint_left.mpr
    intro z hzi hzj
    by_cases hzP : z ∈ P.support
