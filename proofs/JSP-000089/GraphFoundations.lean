    refine ⟨?_, ?_, ?_, ?_⟩
    · intro h; exact (exclusions i).1 ((hl _).1.symm.trans ((congrArg shadow.family.root h).trans hox))
    · intro h; exact (exclusions i).2.1 ((hl _).1.symm.trans ((congrArg shadow.family.root h).trans hoy))
    · intro h; exact (exclusions i).2.2.1 ((hr _).1.symm.trans ((congrArg shadow.family.root h).trans hox))
    · intro h; exact (exclusions i).2.2.2 ((hr _).1.symm.trans ((congrArg shadow.family.root h).trans hoy))
  have disjointD {a b : sourceLemma39CycleVertices G C} {o : Fin (sourceLemma36_c k)}
      (A : G.Walk a.val b.val)
