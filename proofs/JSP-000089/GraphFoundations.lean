    (C.rotate_darts hv).mem_iff.mp (sourceLemma31_firstDart_mem_darts G R hRnon)
  have hdeq : d = e := sourceLemma31_dart_eq_of_same_fst G C hLongest.1 d e hd heC rfl
  have hsucc : d.snd = sourceLemma31CycleSucc G C d.fst hv := by
    exact congrArg (fun a : G.Dart => a.snd) hdeq
  have hends : (d.fst = x ∧ d.snd = y) ∨ (d.fst = y ∧ d.snd = x) := by
    apply Sym2.eq_iff.mp
    change s(d.fst, d.snd) = s(x, y)
    exact hde
  rcases hends with ⟨hfst, hsnd⟩ | ⟨hfst, hsnd⟩
  · exact sourceLemma31_no_component_consecutive_neighbors G C hLongest A d.fst hv
      (hfst.symm ▸ hx) (hsucc ▸ (hsnd.symm ▸ hy))
  · exact sourceLemma31_no_component_consecutive_neighbors G C hLongest A d.fst hv
      (hfst.symm ▸ hy) (hsucc ▸ (hsnd.symm ▸ hx))

/-- Fixing the distinguished colour on a finite coordinate set leaves exactly
`12^(n-|T|)` colourings. This finite count is the local alteration argument. -/
private theorem sourceLemma39_fixedColours_card {W : Type*} [Fintype W]
    [DecidableEq W] (T : Finset W) :
    (Finset.univ.filter fun f : W → Fin 12 => ∀ v ∈ T, f v = 0).card =
      12 ^ (Fintype.card W - T.card) := by
  classical
  have heq : (Finset.univ.filter fun f : W → Fin 12 => ∀ v ∈ T, f v = 0) =
      Fintype.piFinset (fun v : W => if v ∈ T then {0} else Finset.univ) := by
    ext f
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Fintype.mem_piFinset]
    constructor
    · intro h v
      by_cases hv : v ∈ T <;> simp [hv, h]
    · intro h v hv
      simpa [hv] using h v
  rw [heq, Fintype.card_piFinset]
  have hcard (v : W) : (if v ∈ T then ({0} : Finset (Fin 12)) else Finset.univ).card =
      if v ∈ T then 1 else 12 := by split_ifs <;> simp
  simp_rw [hcard]
  rw [Finset.prod_ite]
  simp [Finset.filter_not, Finset.card_sdiff]

/-- Delete at most one vertex per induced edge to leave an independent set. -/
private theorem sourceLemma39_delete_edges [Fintype V] [DecidableEq V]
    (H : SimpleGraph V) (S : Finset V) :
    ∃ Z ⊆ S, H.IsIndepSet (↑Z : Set V) ∧
      S.card ≤ Z.card + (H.edgeFinset.filter fun e => e ∈ S.sym2).card := by
  classical
  induction S using Finset.strongInductionOn with
  | _ S ih =>
    let E := H.edgeFinset.filter fun e => e ∈ S.sym2
    by_cases hE : E = ∅
    · refine ⟨S, Finset.Subset.refl _, ?_, by simp [E, hE]⟩
      intro x hx y hy hxy hadj
      have he : s(x,y) ∈ E := Finset.mem_filter.mpr
        ⟨SimpleGraph.mem_edgeFinset.mpr (H.mem_edgeSet.mpr hadj), Finset.mk_mem_sym2_iff.mpr ⟨hx, hy⟩⟩
      simp [hE] at he
    · obtain ⟨e, he⟩ := Finset.nonempty_iff_ne_empty.mpr hE
      obtain ⟨x, y, rfl⟩ := Sym2.exists.mp (show ∃ a : Sym2 V, a = e from ⟨e,rfl⟩)
      have hxyS := Finset.mk_mem_sym2_iff.mp (Finset.mem_filter.mp he).2
      obtain ⟨Z, hZS, hZi, hcard⟩ := ih (S.erase x) (Finset.erase_ssubset hxyS.1)
      let E' := H.edgeFinset.filter fun e => e ∈ (S.erase x).sym2
      have hsub : E' ⊆ E := by
        intro e he'
        exact Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp he').1,
          Finset.sym2_mono (Finset.erase_subset x S) (Finset.mem_filter.mp he').2⟩
      have hnot : s(x,y) ∉ E' := by
        simp [E', Finset.mk_mem_sym2_iff]
      have hlt : E'.card < E.card := Finset.card_lt_card
        (Finset.ssubset_iff_subset_ne.mpr ⟨hsub, fun h => hnot (h ▸ he)⟩)
      refine ⟨Z, hZS.trans (Finset.erase_subset x S), hZi, ?_⟩
      have herase := Finset.card_erase_of_mem hxyS.1
      change (S.erase x).card ≤ Z.card + E'.card at hcard
      change S.card ≤ Z.card + E.card
      omega

/-- The exact finite alteration estimate needed for `24*c` roots and at most
six edges per candidate K4. No probabilistic assumption enters the result. -/
private theorem sourceLemma39_independent_roots (c : ℕ)
    (H : SimpleGraph (Fin (24 * c)))
    (hE : H.edgeFinset.card ≤ 6 * (24 * c)) :
    ∃ Z : Finset (Fin (24 * c)), H.IsIndepSet (↑Z : Set _) ∧ c ≤ Z.card := by
  classical
  by_cases hc : c = 0
  · subst c
    exact ⟨∅, by simp [SimpleGraph.isIndepSet_iff], by simp⟩
  let n := 24 * c
  let colours : Finset (Fin n → Fin 12) := Finset.univ
  let S := fun f : Fin n → Fin 12 => Finset.univ.filter fun v => f v = 0
  let E := fun f : Fin n → Fin 12 => H.edgeFinset.filter fun e => e ∈ (S f).sym2
  have hvertex (v : Fin n) : (colours.filter fun f => f v = 0).card = 12^(n-1) := by
    simpa [colours] using sourceLemma39_fixedColours_card ({v} : Finset (Fin n))
  have hedge (e : Sym2 (Fin n)) (he : e ∈ H.edgeFinset) :
      (colours.filter fun f => e ∈ (S f).sym2).card = 12^(n-2) := by
    induction e using Sym2.inductionOn with
    | hf x y =>
      have hxy : x ≠ y := (H.mem_edgeSet.mp (SimpleGraph.mem_edgeFinset.mp he)).ne
      simpa [colours, S, Finset.mk_mem_sym2_iff, hxy, and_comm] using
        sourceLemma39_fixedColours_card ({x,y} : Finset (Fin n))
  have hsumS : (∑ f ∈ colours, (S f).card) = n * 12^(n-1) := by
    simp only [S, Finset.card_filter]
    rw [Finset.sum_comm]
    simp_rw [← Finset.card_filter, hvertex]
    simp
  have hsumE : (∑ f ∈ colours, (E f).card) = H.edgeFinset.card * 12^(n-2) := by
    simp only [E, Finset.card_filter]
    rw [Finset.sum_comm]
    calc
      (∑ e ∈ H.edgeFinset, ∑ f ∈ colours, if e ∈ (S f).sym2 then 1 else 0) =
          ∑ e ∈ H.edgeFinset, 12^(n-2) := by
        apply Finset.sum_congr rfl
        intro e he
        rw [← Finset.card_filter, hedge e he]
      _ = _ := by simp
  have hex : ∃ f ∈ colours, c + (E f).card ≤ (S f).card := by
    apply Classical.byContradiction
    intro hno
    have hn : ∀ f ∈ colours, (S f).card < c + (E f).card := by
      simpa only [not_exists, not_and, Nat.not_le] using hno
    have hlt : (∑ f ∈ colours, (S f).card) <
        ∑ f ∈ colours, (c + (E f).card) :=
      Finset.sum_lt_sum_of_nonempty (by simp [colours]) (fun f hf => (hn f hf))
    rw [hsumS, Finset.sum_add_distrib, hsumE] at hlt
    have hn2 : 2 ≤ n := by dsimp [n]; omega
    have hp1 : 12^(n-1) = 12 * 12^(n-2) := by
      rw [show n-1 = (n-2)+1 by omega, pow_succ, Nat.mul_comm]
    have hp2 : 12^n = 144 * 12^(n-2) := by
      rw [show n = (n-2)+2 by omega, pow_add]
      norm_num
      omega
    have hcols : colours.card = 12^n := by simp [colours, Fintype.card_fun]
    simp only [Finset.sum_const, smul_eq_mul] at hlt
    rw [hcols, hp1, hp2] at hlt
    have hbound := Nat.mul_le_mul_right (12^(n-2)) hE
    dsimp [n] at hlt hbound
    nlinarith
  obtain ⟨f, hf, hgood⟩ := hex
  obtain ⟨Z, hZS, hZi, hcard⟩ := sourceLemma39_delete_edges H (S f)
  exact ⟨Z, hZi, by change (S f).card ≤ Z.card + (E f).card at hcard; omega⟩

/-- Cycle edges together with the complete graphs on the supplied four-sets.
This is a shadow graph; its artificial edges are not ambient graph edges. -/
private def sourceLemma39ShadowGraph {W : Type*} (H : SimpleGraph W) {r : W}
    (D : H.Walk r r) {n : ℕ} (X : Fin n → Finset W) : SimpleGraph W where
  Adj x y := s(x,y) ∈ D.edges ∨ (x ≠ y ∧ ∃ i, x ∈ X i ∧ y ∈ X i)
