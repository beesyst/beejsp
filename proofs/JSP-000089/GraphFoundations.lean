      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (certificate : SourceLemma36KCrossladderCertificate G C k Z data iP matching) :
    s(certificate.firstVertex 0, certificate.secondVertex 0) ∈
        (sourceLemma36KCrossladderBoundaryCycle G C k Z data iP matching certificate).edges ∧
      s(certificate.secondVertex (Fin.last (k + 1)),
        certificate.firstVertex (Fin.last (k + 1))) ∈
        (sourceLemma36KCrossladderBoundaryCycle G C k Z data iP matching certificate).edges := by
  exact sourceLemma36_boundaryCycle_contains_boundary_edges G
    (sourceLemma36KCrossladderInsideBoundarySubpath G C k Z data iP matching certificate)
    (sourceLemma36KCrossladderOutsideBoundarySubpath G C k Z data iP matching certificate)
    (certificate.edge 0) ((certificate.edge (Fin.last (k + 1))).symm)

/-- The proof-local geometry completed at this milestone.  It packages only
the decreasing certificate, concrete source `C′`, its two boundary paths and
edges, and the already retained middle rungs; the separate Section-2 path
`Q` is intentionally not part of this structure. -/
private structure SourceLemma36KCrossladderCycleGeometry [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) where
  certificate : SourceLemma36KCrossladderCertificate G C k Z data iP matching
  inside : G.Walk (certificate.firstVertex (Fin.last (k + 1))) (certificate.firstVertex 0)
  outside : G.Walk (certificate.secondVertex 0)
    (certificate.secondVertex (Fin.last (k + 1)))
  firstBoundary : G.Adj (certificate.firstVertex 0) (certificate.secondVertex 0)
  lastBoundary : G.Adj (certificate.secondVertex (Fin.last (k + 1)))
    (certificate.firstVertex (Fin.last (k + 1)))
  cPrime : G.Walk (certificate.secondVertex (Fin.last (k + 1)))
    (certificate.secondVertex (Fin.last (k + 1)))
  cPrime_def : cPrime = sourceLemma36BoundaryCycle G inside outside firstBoundary lastBoundary
  cPrime_isCycle : cPrime.IsCycle
  rung : (i : Fin k) → G.Walk
    (certificate.firstVertex ⟨i.1 + 1, by omega⟩)
    (certificate.secondVertex ⟨i.1 + 1, by omega⟩)
  rung_isPath : ∀ i, (rung i).IsPath

/-- Package the completed C′ milestone without asserting the still-missing
Section-2 crossladder path or its intersection requirements. -/
private noncomputable def sourceLemma36_kCrossladder_cycleGeometry
    [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (certificate : SourceLemma36KCrossladderCertificate G C k Z data iP matching) :
    SourceLemma36KCrossladderCycleGeometry G C k Z data iP matching :=
  { certificate := certificate
    inside := sourceLemma36KCrossladderInsideBoundarySubpath
      G C k Z data iP matching certificate
    outside := sourceLemma36KCrossladderOutsideBoundarySubpath
      G C k Z data iP matching certificate
    firstBoundary := certificate.edge 0
    lastBoundary := (certificate.edge (Fin.last (k + 1))).symm
    cPrime := sourceLemma36KCrossladderBoundaryCycle G C k Z data iP matching certificate
    cPrime_def := rfl
    cPrime_isCycle := sourceLemma36_kCrossladder_boundaryCycle_isCycle
      G C k Z data iP matching certificate
    rung := sourceLemma36KCrossladderRungPath G C k Z data iP matching certificate
    rung_isPath := sourceLemma36_kCrossladder_rungPath_isPath
      G C k Z data iP matching certificate }

/-- The exact vertex carrier of the source ladder already obtained from the
decreasing alternative: the concrete boundary cycle `C′` together with the
`k` retained middle rung paths. -/
private def sourceLemma36KCrossladderLadderCarrier [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (geometry : SourceLemma36KCrossladderCycleGeometry G C k Z data iP matching) :
    Finset V :=
  geometry.cPrime.support.toFinset ∪
    Finset.biUnion Finset.univ (fun i => (geometry.rung i).support.toFinset)

/-- Unfolding characterization of the proof-local ladder carrier. -/
private theorem sourceLemma36_kCrossladder_ladderCarrier_spec [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (geometry : SourceLemma36KCrossladderCycleGeometry G C k Z data iP matching) :
    sourceLemma36KCrossladderLadderCarrier G C k Z data iP matching geometry =
      geometry.cPrime.support.toFinset ∪
        Finset.biUnion Finset.univ (fun i => (geometry.rung i).support.toFinset) := rfl

/-- Membership in the source ladder carrier is exactly membership in its
boundary cycle or in one of the retained middle rung paths. -/
private theorem sourceLemma36_mem_kCrossladder_ladderCarrier_iff [Fintype V]
    [DecidableEq V] {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle}
    (k : ℕ) (Z : Finset V) (data : SourceLemma36PartitionData G C hC k Z)
    (iP : Fin k) (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (geometry : SourceLemma36KCrossladderCycleGeometry G C k Z data iP matching) (x : V) :
    x ∈ sourceLemma36KCrossladderLadderCarrier G C k Z data iP matching geometry ↔
      x ∈ geometry.cPrime.support.toFinset ∨
        ∃ i : Fin k, x ∈ (geometry.rung i).support.toFinset := by
  rw [sourceLemma36KCrossladderLadderCarrier, Finset.mem_union,
    Finset.mem_biUnion]
  simp

/-- Every middle first-side rung endpoint occurs on the inside portion of the
concrete source boundary cycle `C′`. -/
private theorem sourceLemma36_kCrossladder_middle_first_mem_inside
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (certificate : SourceLemma36KCrossladderCertificate G C k Z data iP matching)
    (i : Fin k) :
    certificate.firstVertex ⟨i.1 + 1, by omega⟩ ∈
      (sourceLemma36KCrossladderInsideBoundarySubpath
        G C k Z data iP matching certificate).support := by
  rw [sourceLemma36KCrossladderInsideBoundarySubpath,
    sourceLemma36_walkReendpoint_support G]
  apply (sourceLemma36_mem_positionSubpath_iff G C hC data.anchor
    (certificate.firstPosition (Fin.last (k + 1))) (certificate.firstPosition 0)
    (by
      exact (certificate.first_descending 0 (Fin.last (k + 1)) (by
        change 0 < k + 1
        omega)).le)
    (certificate.firstVertex ⟨i.1 + 1, by omega⟩)).mpr
  refine ⟨certificate.firstPosition ⟨i.1 + 1, by omega⟩, ?_, ?_, ?_⟩
  · exact (certificate.first_descending ⟨i.1 + 1, by omega⟩
      (Fin.last (k + 1)) (by
        change i.1 + 1 < k + 1
        omega)).le
  · exact (certificate.first_descending 0 ⟨i.1 + 1, by omega⟩ (by
      change 0 < i.1 + 1
      omega)).le
  · exact certificate.firstPosition_vertex _

/-- Every middle second-side rung endpoint occurs on the outside portion of
the concrete source boundary cycle `C′`, using its exact complement-order
interval characterization. -/
private theorem sourceLemma36_kCrossladder_middle_second_mem_outside
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (certificate : SourceLemma36KCrossladderCertificate G C k Z data iP matching)
    (i : Fin k) :
    certificate.secondVertex ⟨i.1 + 1, by omega⟩ ∈
      (sourceLemma36KCrossladderOutsideBoundarySubpath
        G C k Z data iP matching certificate).support := by
  apply (sourceLemma36_kCrossladder_outsideBoundarySubpath_spec
    G C k Z data iP matching certificate).2.1 _ |>.mpr
  refine ⟨certificate.secondPosition ⟨i.1 + 1, by omega⟩, ?_, ?_, ?_⟩
  · exact (certificate.second_descending ⟨i.1 + 1, by omega⟩
      (Fin.last (k + 1)) (by
        change i.1 + 1 < k + 1
        omega)).le
  · exact (certificate.second_descending 0 ⟨i.1 + 1, by omega⟩ (by
      change 0 < i.1 + 1
      omega)).le
  · exact certificate.secondPosition_vertex _

/-- The inside source boundary subpath is retained verbatim in `C′`. -/
private theorem sourceLemma36_mem_kCrossladder_inside_boundaryCycle_support
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (certificate : SourceLemma36KCrossladderCertificate G C k Z data iP matching)
    {x : V}
    (hx : x ∈ (sourceLemma36KCrossladderInsideBoundarySubpath
      G C k Z data iP matching certificate).support) :
    x ∈ (sourceLemma36KCrossladderBoundaryCycle
      G C k Z data iP matching certificate).support := by
  unfold sourceLemma36KCrossladderBoundaryCycle sourceLemma36BoundaryCycle
  rw [Walk.support_cons, Walk.support_append, List.mem_cons, List.mem_append]
  exact Or.inr (Or.inl hx)

/-- The outside source boundary subpath is retained verbatim in `C′`. -/
private theorem sourceLemma36_mem_kCrossladder_outside_boundaryCycle_support
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (certificate : SourceLemma36KCrossladderCertificate G C k Z data iP matching)
    {x : V}
    (hx : x ∈ (sourceLemma36KCrossladderOutsideBoundarySubpath
      G C k Z data iP matching certificate).support) :
    x ∈ (sourceLemma36KCrossladderBoundaryCycle
      G C k Z data iP matching certificate).support := by
  unfold sourceLemma36KCrossladderBoundaryCycle sourceLemma36BoundaryCycle
  rw [Walk.support_cons, Walk.support_append, Walk.support_cons,
    List.tail_cons, List.mem_cons, List.mem_append]
  exact Or.inr (Or.inr hx)

/-- Both endpoints of every retained middle rung lie on the concrete `C′`
in the canonical decreasing-branch geometry. -/
private theorem sourceLemma36_kCrossladder_middle_endpoints_mem_cPrime
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (certificate : SourceLemma36KCrossladderCertificate G C k Z data iP matching)
    (i : Fin k) :
    certificate.firstVertex ⟨i.1 + 1, by omega⟩ ∈
        (sourceLemma36_kCrossladder_cycleGeometry
          G C k Z data iP matching certificate).cPrime.support ∧
      certificate.secondVertex ⟨i.1 + 1, by omega⟩ ∈
        (sourceLemma36_kCrossladder_cycleGeometry
          G C k Z data iP matching certificate).cPrime.support := by
  change certificate.firstVertex ⟨i.1 + 1, by omega⟩ ∈
      (sourceLemma36KCrossladderBoundaryCycle G C k Z data iP matching certificate).support ∧
    certificate.secondVertex ⟨i.1 + 1, by omega⟩ ∈
      (sourceLemma36KCrossladderBoundaryCycle G C k Z data iP matching certificate).support
  constructor
  · apply sourceLemma36_mem_kCrossladder_inside_boundaryCycle_support
      G C k Z data iP matching certificate
    exact sourceLemma36_kCrossladder_middle_first_mem_inside
      G C k Z data iP matching certificate i
  · apply sourceLemma36_mem_kCrossladder_outside_boundaryCycle_support
      G C k Z data iP matching certificate
    exact sourceLemma36_kCrossladder_middle_second_mem_outside
      G C k Z data iP matching certificate i

private theorem sourceMader_exists_unreachable_of_not_connected
    {U : Type*} (H : SimpleGraph U) (p : U) (hDisconnected : ¬ H.Connected) :
    ∃ q, ¬ H.Reachable p q := by
  by_contra h
  push_neg at h
  exact hDisconnected
    ((SimpleGraph.connected_iff_exists_forall_reachable H).mpr ⟨p, h⟩)

private noncomputable def sourceMader_side_induce_iso [DecidableEq V]
    (G : SimpleGraph V) (W : Finset V) (X : Finset {v // v ∈ W}) :
    ((G.induce (↑W : Set V)).induce (↑X : Set {v // v ∈ W})) ≃g
      G.induce (↑(X.image Subtype.val) : Set V) where
  toEquiv :=
    { toFun := fun x =>
        ⟨x.1.1, Finset.mem_image.mpr ⟨x.1, x.2, rfl⟩⟩
      invFun := fun y =>
        let x := (Finset.mem_image.mp y.2).choose
        ⟨x, (Finset.mem_image.mp y.2).choose_spec.1⟩
      left_inv := by
        intro x
        apply Subtype.ext
        apply Subtype.ext
        exact (Finset.mem_image.mp
          (show x.1.1 ∈ X.image Subtype.val from
            Finset.mem_image.mpr ⟨x.1, x.2, rfl⟩)).choose_spec.2
      right_inv := by
        intro y
        apply Subtype.ext
        exact (Finset.mem_image.mp y.2).choose_spec.2 }
  map_rel_iff' := by
    intro x y
    rfl

private theorem sourceMader_reachability_partition
    {U : Type*} [Fintype U] [DecidableEq U] (H : SimpleGraph U)
    (S : Finset U) (hSsmall : S.card < Fintype.card U)
    (hdisconnected : ¬ (H.induce {x : U | x ∉ S}).Connected) :
    ∃ A B : Finset U,
      A.Nonempty ∧ B.Nonempty ∧ Disjoint A B ∧
      (∀ x : U, x ∉ S → x ∈ A ∨ x ∈ B) ∧
      (∀ x ∈ A, x ∉ S) ∧ (∀ x ∈ B, x ∉ S) ∧
      (∀ {x y : U}, x ∈ A → y ∈ B → ¬ H.Adj x y) := by
  classical
  let K : SimpleGraph {x : U | x ∉ S} := H.induce {x : U | x ∉ S}
  have hKdisconnected : ¬ K.Connected := by simpa [K] using hdisconnected
  have hK : Nonempty {x : U | x ∉ S} := by
    obtain ⟨x, _, hxS⟩ := Finset.exists_mem_not_mem_of_card_lt_card
      (s := S) (t := Finset.univ) (by simpa using hSsmall)
    exact ⟨x, hxS⟩
  let a : {x : U | x ∉ S} := Classical.choice hK
  obtain ⟨b, hab⟩ :=
    sourceMader_exists_unreachable_of_not_connected K a hKdisconnected
  let AK : Finset {x : U | x ∉ S} :=
    Finset.univ.filter fun x => K.Reachable a x
  let BK : Finset {x : U | x ∉ S} :=
    Finset.univ.filter fun x => ¬ K.Reachable a x
  have haAK : a ∈ AK := by
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, SimpleGraph.Reachable.refl _⟩
  have hbBK : b ∈ BK := by simp [BK, hab]
  have hdisjointK : Disjoint AK BK := by
    refine Finset.disjoint_left.2 ?_
    intro x hx hy
    exact (Finset.mem_filter.mp hy).2 (Finset.mem_filter.mp hx).2
  have hcoverK : AK ∪ BK = Finset.univ := by
    apply Finset.eq_univ_of_forall
    intro x
    by_cases hx : K.Reachable a x
    · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hx⟩)
    · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hx⟩)
  have hnoK : ∀ {x y : {x : U | x ∉ S}}, x ∈ AK → y ∈ BK → ¬ K.Adj x y := by
    intro x y hx hy hxy
    exact (Finset.mem_filter.mp hy).2
      ((Finset.mem_filter.mp hx).2.trans hxy.reachable)
  let A : Finset U := AK.image Subtype.val
  let B : Finset U := BK.image Subtype.val
  refine ⟨A, B, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact ⟨a.1, Finset.mem_image.mpr ⟨a, haAK, rfl⟩⟩
  · exact ⟨b.1, Finset.mem_image.mpr ⟨b, hbBK, rfl⟩⟩
  · refine Finset.disjoint_left.2 ?_
    intro x hx hy
    obtain ⟨xK, hxK, hxEq⟩ := Finset.mem_image.mp hx
    obtain ⟨yK, hyK, hyEq⟩ := Finset.mem_image.mp hy
    have hxy : xK = yK := Subtype.ext (hxEq.trans hyEq.symm)
    subst yK
    exact (Finset.disjoint_left.1 hdisjointK hxK hyK).elim
  · intro x hxS
    let xK : {x : U | x ∉ S} := ⟨x, hxS⟩
    have hmem : xK ∈ AK ∪ BK := by rw [hcoverK]; simp
    rcases Finset.mem_union.mp hmem with hAK | hBK
    · exact Or.inl (Finset.mem_image.mpr ⟨xK, hAK, rfl⟩)
    · exact Or.inr (Finset.mem_image.mpr ⟨xK, hBK, rfl⟩)
  · intro x hx
    obtain ⟨xK, _, hxEq⟩ := Finset.mem_image.mp hx
    simpa [hxEq] using xK.2
  · intro x hx
    obtain ⟨xK, _, hxEq⟩ := Finset.mem_image.mp hx
    simpa [hxEq] using xK.2
  · intro x y hx hy hxy
    obtain ⟨xK, hxK, hxEq⟩ := Finset.mem_image.mp hx
    obtain ⟨yK, hyK, hyEq⟩ := Finset.mem_image.mp hy
    have hxyK : K.Adj xK yK := by
      simpa [K, hxEq, hyEq] using hxy
    exact hnoK hxK hyK hxyK

/-- Express an induced edge count as the corresponding restriction of the
ambient edge finset.  This keeps the separator count in the ambient vertex
type after the two induced sides are mapped back through `Subtype.val`. -/
private theorem sourceMader_edgeCount_eq_restricted_edges [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (W : Finset V) :
    sourceMaderEdgeCount G W = (G.edgeFinset ∩ W.sym2).card := by
  classical
  let U : Type _ := {v : V // v ∈ (↑W : Set V)}
  letI : Fintype U := Subtype.fintype (Membership.mem (↑W : Set V))
  let H : SimpleGraph U := G.induce (↑W : Set V)
  let E : Finset (Sym2 U) := H.edgeFinset
  let f : U ↪ V := Function.Embedding.subtype (↑W : Set V)
  have hWtoFinset : (↑W : Set V).toFinset = W := by
    ext
    simp
  have hmap : E.map f.sym2Map = G.edgeFinset ∩ W.sym2 := by
    simpa only [E, f, H, U, hWtoFinset] using
      G.map_edgeFinset_induce (s := (↑W : Set V))
  have hedge : Nat.card H.edgeSet = E.card := by
    dsimp [E]
    exact @sourceMader_card_edgeSet_eq_edgeFinset U _ (Classical.decEq U) H
      (fun x y => Classical.propDecidable (H.Adj x y))
  calc
    sourceMaderEdgeCount G W = Nat.card H.edgeSet := by rfl
    _ = E.card := hedge
    _ = (E.map f.sym2Map).card := (Finset.card_map _).symm
    _ = (G.edgeFinset ∩ W.sym2).card := congrArg Finset.card hmap

/-- A nonempty side of a separator has at least seven vertices when every
vertex has degree at least six. -/
private theorem sourceMader_separator_side_card_ge_seven
    {U : Type*} [Fintype U] [DecidableEq U] (H : SimpleGraph U)
    (A B S : Finset U)
    (hcover : ∀ x : U, x ∉ S → x ∈ A ∨ x ∈ B)
    (hAnoS : ∀ x ∈ A, x ∉ S) (hno : ∀ {x y : U}, x ∈ A → y ∈ B → ¬ H.Adj x y)
    (hdegree : ∀ x : U, ∀ _ : Fintype ↑(H.neighborSet x), 6 ≤ H.degree x) (hA : A.Nonempty) :
    7 ≤ (A ∪ S).card := by
  classical
  letI : DecidableRel H.Adj := fun x y => Classical.propDecidable (H.Adj x y)
  letI hneighbors (x : U) : Fintype ↑(H.neighborSet x) := Fintype.ofFinite _
  obtain ⟨a, ha⟩ := hA
  have haXS : a ∈ A ∪ S := Finset.mem_union_left _ ha
  have hneighbour : H.neighborFinset a ⊆ (A ∪ S).erase a := by
    intro z hz
    have hadj : H.Adj a z := by simpa [SimpleGraph.mem_neighborFinset] using hz
    have hza : z ≠ a := by
      intro h
      subst z
      exact H.irrefl hadj
    refine Finset.mem_erase.mpr ⟨hza, ?_⟩
    by_cases hzS : z ∈ S
    · exact Finset.mem_union_right _ hzS
    · rcases hcover z hzS with hzA | hzB
      · exact Finset.mem_union_left _ hzA
      · exact False.elim (hno ha hzB hadj)
  have hle : (H.neighborFinset a).card ≤ ((A ∪ S).erase a).card :=
    Finset.card_le_card hneighbour
  have hdegree_card : H.degree a = (H.neighborFinset a).card :=
    H.card_neighborFinset_eq_degree a
  have herase : ((A ∪ S).erase a).card = (A ∪ S).card - 1 :=
    Finset.card_erase_of_mem haXS
  have hbound : H.degree a ≤ (A ∪ S).card - 1 := by
    calc
      H.degree a = (H.neighborFinset a).card := hdegree_card
      _ ≤ ((A ∪ S).erase a).card := hle
      _ = (A ∪ S).card - 1 := herase
  have hdegree_a := hdegree a (hneighbors a)
  omega

/-- The opposite nonempty side supplies a vertex omitted by this side. -/
private theorem sourceMader_separator_side_card_lt_univ
    {U : Type*} [Fintype U] [DecidableEq U]
    (A B S : Finset U) (hdisjoint : Disjoint A B)
    (hBnoS : ∀ x ∈ B, x ∉ S) (hB : B.Nonempty) :
    (A ∪ S).card < Fintype.card U := by
  apply Finset.card_lt_card
  rw [Finset.ssubset_iff_of_subset (Finset.subset_univ _)]
  obtain ⟨b, hb⟩ := hB
  refine ⟨b, by simp, ?_⟩
  intro hbAS
  rcases Finset.mem_union.mp hbAS with hbA | hbS
  · exact (Finset.disjoint_left.mp hdisjoint hbA hb).elim
  · exact (hBnoS b hb hbS).elim

/-- Every edge of the original induced witness belongs to one of the two
separator sides.  Edges inside the separator may occur in both side counts. -/
private theorem sourceMader_separator_edge_cover [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (W : Finset V)
    (A B S : Finset {v // v ∈ W})
    (hcover : ∀ x : {v // v ∈ W}, x ∉ S → x ∈ A ∨ x ∈ B)
    (hno : ∀ {x y : {v // v ∈ W}}, x ∈ A → y ∈ B →
      ¬ (G.induce (↑W : Set V)).Adj x y) :
    sourceMaderEdgeCount G W ≤
      sourceMaderEdgeCount G ((A ∪ S).image Subtype.val) +
        sourceMaderEdgeCount G ((B ∪ S).image Subtype.val) := by
  let H : SimpleGraph {v // v ∈ W} := G.induce (↑W : Set V)
  let X₁ : Finset {v // v ∈ W} := A ∪ S
  let X₂ : Finset {v // v ∈ W} := B ∪ S
  let W₁ : Finset V := X₁.image Subtype.val
  let W₂ : Finset V := X₂.image Subtype.val
  have hsubset : G.edgeFinset ∩ W.sym2 ⊆
      (G.edgeFinset ∩ W₁.sym2) ∪ (G.edgeFinset ∩ W₂.sym2) := by
    intro e he
    induction e using Sym2.inductionOn with
    | _ x y =>
      simp only [Finset.mem_inter, Finset.mem_union, Finset.mk_mem_sym2_iff] at he ⊢
      rcases he with ⟨hxy, hxW, hyW⟩
      let xW : {v // v ∈ W} := ⟨x, hxW⟩
      let yW : {v // v ∈ W} := ⟨y, hyW⟩
      have hxyH : H.Adj xW yW := by simpa [H, xW, yW] using hxy
      have classify : ∀ z : {v // v ∈ W}, z ∈ A ∨ z ∈ S ∨ z ∈ B := by
        intro z
        by_cases hzS : z ∈ S
        · exact Or.inr (Or.inl hzS)
        · rcases hcover z hzS with hzA | hzB
          · exact Or.inl hzA
          · exact Or.inr (Or.inr hzB)
      rcases classify xW with hxA | hxS | hxB
      · rcases classify yW with hyA | hyS | hyB
        · left
          exact ⟨hxy, Finset.mem_image.mpr ⟨xW, Finset.mem_union_left _ hxA, rfl⟩,
            Finset.mem_image.mpr ⟨yW, Finset.mem_union_left _ hyA, rfl⟩⟩
        · left
          exact ⟨hxy, Finset.mem_image.mpr ⟨xW, Finset.mem_union_left _ hxA, rfl⟩,
            Finset.mem_image.mpr ⟨yW, Finset.mem_union_right _ hyS, rfl⟩⟩
        · exact False.elim (hno hxA hyB hxyH)
      · rcases classify yW with hyA | hyS | hyB
        · left
          exact ⟨hxy, Finset.mem_image.mpr ⟨xW, Finset.mem_union_right _ hxS, rfl⟩,
            Finset.mem_image.mpr ⟨yW, Finset.mem_union_left _ hyA, rfl⟩⟩
        · left
          exact ⟨hxy, Finset.mem_image.mpr ⟨xW, Finset.mem_union_right _ hxS, rfl⟩,
            Finset.mem_image.mpr ⟨yW, Finset.mem_union_right _ hyS, rfl⟩⟩
        · right
          exact ⟨hxy, Finset.mem_image.mpr ⟨xW, Finset.mem_union_right _ hxS, rfl⟩,
            Finset.mem_image.mpr ⟨yW, Finset.mem_union_left _ hyB, rfl⟩⟩
      · rcases classify yW with hyA | hyS | hyB
        · exact False.elim (hno hyA hxB hxyH.symm)
        · right
          exact ⟨hxy, Finset.mem_image.mpr ⟨xW, Finset.mem_union_left _ hxB, rfl⟩,
            Finset.mem_image.mpr ⟨yW, Finset.mem_union_right _ hyS, rfl⟩⟩
        · right
          exact ⟨hxy, Finset.mem_image.mpr ⟨xW, Finset.mem_union_left _ hxB, rfl⟩,
            Finset.mem_image.mpr ⟨yW, Finset.mem_union_left _ hyB, rfl⟩⟩
  calc
    sourceMaderEdgeCount G W = (G.edgeFinset ∩ W.sym2).card :=
      sourceMader_edgeCount_eq_restricted_edges G W
    _ ≤ ((G.edgeFinset ∩ W₁.sym2) ∪ (G.edgeFinset ∩ W₂.sym2)).card :=
      Finset.card_le_card hsubset
    _ ≤ (G.edgeFinset ∩ W₁.sym2).card + (G.edgeFinset ∩ W₂.sym2).card :=
      Finset.card_union_le _ _
    _ = sourceMaderEdgeCount G W₁ + sourceMaderEdgeCount G W₂ := by
      rw [← sourceMader_edgeCount_eq_restricted_edges G W₁,
        ← sourceMader_edgeCount_eq_restricted_edges G W₂]

/-- The two closed separator sides cover the universe and overlap exactly in
the separator, giving the count used in Mader's extremal inequality. -/
private theorem sourceMader_separator_side_card_sum_le
    {U : Type*} [Fintype U] [DecidableEq U]
    (A B S : Finset U) (hdisjoint : Disjoint A B)
    (hcover : ∀ x : U, x ∉ S → x ∈ A ∨ x ∈ B)
    (hAnoS : ∀ x ∈ A, x ∉ S) (hBnoS : ∀ x ∈ B, x ∉ S)
    (hS : S.card ≤ 3) :
    (A ∪ S).card + (B ∪ S).card ≤ Fintype.card U + 3 := by
  have hunion : (A ∪ S) ∪ (B ∪ S) = Finset.univ := by
    apply Finset.eq_univ_of_forall
    intro x
    by_cases hxS : x ∈ S
    · exact Finset.mem_union_left _ (Finset.mem_union_right _ hxS)
    · rcases hcover x hxS with hxA | hxB
      · exact Finset.mem_union_left _ (Finset.mem_union_left _ hxA)
      · exact Finset.mem_union_right _ (Finset.mem_union_left _ hxB)
  have hinter : (A ∪ S) ∩ (B ∪ S) = S := by
    apply Finset.Subset.antisymm
    · intro x hx
      rcases Finset.mem_inter.mp hx with ⟨hxAS, hxBS⟩
      by_cases hxS : x ∈ S
      · exact hxS
      · rcases Finset.mem_union.mp hxAS with hxA | hxS'
        · rcases Finset.mem_union.mp hxBS with hxB | hxS''
          · exact False.elim (Finset.disjoint_left.mp hdisjoint hxA hxB)
          · exact False.elim (hxS hxS'')
        · exact False.elim (hxS hxS')
    · intro x hxS
      exact Finset.mem_inter.mpr
        ⟨Finset.mem_union_right _ hxS, Finset.mem_union_right _ hxS⟩
  have hcard := Finset.card_union_add_card_inter (A ∪ S) (B ∪ S)
  rw [hunion, hinter, Finset.card_univ] at hcard
  omega

/-- A minimum-cardinality induced subgraph above Mader's `5 (n - 3)` edge
threshold is 4-connected. -/
theorem sourceMader_minimal_good_connectivity_four [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (W : Finset V)
    (hWgood : sourceMaderGood G W)
    (hWmin : ∀ U : Finset V, sourceMaderGood G U → W.card ≤ U.card) :
    VertexConnectivityAtLeast (G.induce (↑W : Set V)) 4 := by
  classical
  let H : SimpleGraph {v // v ∈ W} := G.induce (↑W : Set V)
  have hHcard : 4 < Fintype.card {v // v ∈ W} := by
    rw [Fintype.card_coe]
    have hWcard := hWgood.1
    omega
  refine ⟨hHcard, ?_⟩
  intro S hS
  by_contra hconnected
  have hSsmall : S.card < Fintype.card {v // v ∈ W} := by
    rw [Fintype.card_coe]
    have hWcard := hWgood.1
    omega
  obtain ⟨A, B, hA, hB, hdisjoint, hcover, hAnoS, hBnoS, hno⟩ :=
    sourceMader_reachability_partition H S hSsmall (by simpa [H] using hconnected)
  let X₁ : Finset {v // v ∈ W} := A ∪ S
  let X₂ : Finset {v // v ∈ W} := B ∪ S
  let W₁ : Finset V := X₁.image Subtype.val
  let W₂ : Finset V := X₂.image Subtype.val
  have hminDegree : ∀ x : {v // v ∈ W},
      ∀ _ : Fintype ↑(H.neighborSet x), 6 ≤ H.degree x := by
    intro x
    exact sourceMader_minimal_good_minDegree_six G W hWgood hWmin x
  have hSle : S.card ≤ 3 := by omega
  have hX₁ge : 7 ≤ X₁.card := by
    exact sourceMader_separator_side_card_ge_seven H A B S hcover hAnoS hno
      hminDegree hA
  have hX₂ge : 7 ≤ X₂.card := by
    exact sourceMader_separator_side_card_ge_seven H B A S
      (fun x hx => (hcover x hx).symm) hBnoS
      (fun hx hy hadj => hno hy hx hadj.symm) hminDegree hB
  have hX₁lt : X₁.card < Fintype.card {v // v ∈ W} := by
    exact sourceMader_separator_side_card_lt_univ A B S hdisjoint hBnoS hB
  have hX₂lt : X₂.card < Fintype.card {v // v ∈ W} := by
    exact sourceMader_separator_side_card_lt_univ B A S hdisjoint.symm hAnoS hA
  have hsumX : X₁.card + X₂.card ≤ Fintype.card {v // v ∈ W} + 3 := by
    exact sourceMader_separator_side_card_sum_le A B S hdisjoint hcover hAnoS hBnoS hSle
  have hW₁card : W₁.card = X₁.card := by
    dsimp [W₁]
    exact Finset.card_image_of_injective _ Subtype.val_injective
  have hW₂card : W₂.card = X₂.card := by
    dsimp [W₂]
    exact Finset.card_image_of_injective _ Subtype.val_injective
  have hW₁ge : 7 ≤ W₁.card := by omega
  have hW₂ge : 7 ≤ W₂.card := by omega
  have hW₁lt : W₁.card < W.card := by
    calc
      W₁.card = X₁.card := hW₁card
      _ < Fintype.card {v // v ∈ W} := hX₁lt
      _ = W.card := Fintype.card_coe _
  have hW₂lt : W₂.card < W.card := by
    calc
      W₂.card = X₂.card := hW₂card
      _ < Fintype.card {v // v ∈ W} := hX₂lt
      _ = W.card := Fintype.card_coe _
  have hsumW : W₁.card + W₂.card ≤ W.card + 3 := by
    calc
      W₁.card + W₂.card = X₁.card + X₂.card := by rw [hW₁card, hW₂card]
      _ ≤ Fintype.card {v // v ∈ W} + 3 := hsumX
      _ = W.card + 3 := by rw [Fintype.card_coe]
  have hedgeCover : sourceMaderEdgeCount G W ≤
      sourceMaderEdgeCount G W₁ + sourceMaderEdgeCount G W₂ := by
    dsimp [W₁, W₂, X₁, X₂]
    exact sourceMader_separator_edge_cover G W A B S hcover
      (by
        intro x y hx hy
        simpa [H] using hno hx hy)
  have hW₁notgood : ¬ sourceMaderGood G W₁ := by
    intro hgood
    exact (not_lt_of_ge (hWmin W₁ hgood)) hW₁lt
  have hW₂notgood : ¬ sourceMaderGood G W₂ := by
    intro hgood
    exact (not_lt_of_ge (hWmin W₂ hgood)) hW₂lt
  have hW₁upper : sourceMaderEdgeCount G W₁ ≤ 5 * (W₁.card - 3) := by
    apply Nat.le_of_not_lt
    intro h
    apply hW₁notgood
    constructor
    · exact hW₁ge
    · omega
  have hW₂upper : sourceMaderEdgeCount G W₂ ≤ 5 * (W₂.card - 3) := by
    apply Nat.le_of_not_lt
    intro h
    apply hW₂notgood
    constructor
    · exact hW₂ge
    · omega
  have hWupper : sourceMaderEdgeCount G W ≤ 5 * (W.card - 3) := by
    have hsumEdges := hedgeCover.trans (Nat.add_le_add hW₁upper hW₂upper)
    have hbudget : (W₁.card - 3) + (W₂.card - 3) ≤ W.card - 3 := by
      omega
    calc
      sourceMaderEdgeCount G W ≤
          5 * (W₁.card - 3) + 5 * (W₂.card - 3) := hsumEdges
      _ = 5 * ((W₁.card - 3) + (W₂.card - 3)) := by omega
      _ ≤ 5 * (W.card - 3) := Nat.mul_le_mul_left _ hbudget
  have hWlower : 5 * (W.card - 3) + 1 ≤ sourceMaderEdgeCount G W := hWgood.2
  omega

/-- Source Proposition 3.10 in the form used by the remainder of the proof:
average degree at least ten supplies a 4-connected induced subgraph whose
minimum degree is at least six. -/
theorem sourceProposition310_k4 [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (hcard : 7 ≤ Fintype.card V)
    (havg : averageDegreeAtLeast G 10) :
    ∃ W : Finset V,
      VertexConnectivityAtLeast (G.induce (↑W : Set V)) 4 ∧
        ∀ v : {w // w ∈ W},
          ∀ _ : Fintype ↑((G.induce (↑W : Set V)).neighborSet v),
            6 ≤ (G.induce (↑W : Set V)).degree v := by
  obtain ⟨W, hWgood, hWmin⟩ := sourceMader_exists_minimal_good G
    ⟨Finset.univ, sourceMader_univ_good G hcard havg⟩
  exact ⟨W, sourceMader_minimal_good_connectivity_four G W hWgood hWmin,
    sourceMader_minimal_good_minDegree_six G W hWgood hWmin⟩

/-- In the Lemma 3.9 shadow graph, a `K₄` edge joining two selected roots
forces those roots to be equal.  Applied to the designated root and the root
of a ladder edge in the same off-cycle `K₄`, this is the exact label
identification needed before lifting that edge through its source component.
The theorem deliberately records no claim about the geometry of the other
two `K₄` vertices. -/
private theorem sourceLemma38_shadowK4_root_label [Fintype V] [DecidableEq V]
    (F : SimpleGraph V) {r : V} (C : F.Walk r r) (Z : Finset V) {u z : V}
    (hZind : (sourceLemma36OffCycleGraph F C).IsIndepSet (↑Z : Set V))
    (hu : u ∈ Z) (hz : z ∈ Z)
    (huz : (sourceLemma36OffCycleGraph F C).Adj u z) :
    u = z := by
  by_contra hne
  exact hZind hu hz hne huz

/-- Designated K4 roots are injective along vertex-disjoint rooted ladder
edges.  For each edge, K4 completeness supplies the displayed off-cycle
adjacency; `sourceLemma38_shadowK4_root_label` then identifies its designated
root with its ladder root.  This is the label-counting fact used to choose
crossed rungs from components different from the cross path's component. -/
private theorem sourceLemma38_shadow_labels_injective [Fintype V] [DecidableEq V]
    (F : SimpleGraph V) {r : V} (C : F.Walk r r) (Z : Finset V)
    {ι : Type*} (root label : ι → V)
    (hZind : (sourceLemma36OffCycleGraph F C).IsIndepSet (↑Z : Set V))
    (hroot_injective : Function.Injective root)
    (hroot_mem : ∀ i, root i ∈ Z) (hlabel_mem : ∀ i, label i ∈ Z)
    (hlabel_adj : ∀ i, (sourceLemma36OffCycleGraph F C).Adj (label i) (root i)) :
    Function.Injective label := by
  intro i j hij
  have hlabel_i : label i = root i := sourceLemma38_shadowK4_root_label
    F C Z hZind (hlabel_mem i) (hroot_mem i) (hlabel_adj i)
  have hlabel_j : label j = root j := sourceLemma38_shadowK4_root_label
    F C Z hZind (hlabel_mem j) (hroot_mem j) (hlabel_adj j)
  apply hroot_injective
  calc
    root i = label i := hlabel_i.symm
    _ = label j := hij
    _ = root j := hlabel_j

/-- The application-specific family of off-cycle `K₄`s in the Lemma 3.9
shadow graph.  It records only the provenance needed to identify the owner of
an off-cycle edge incident with a designated root. -/
private structure SourceLemma38RootedK4Family [Fintype V] [DecidableEq V]
    {r : V} (F : SimpleGraph V) (C : F.Walk r r) (n : ℕ) where
  root : Fin n → V
  root_injective : Function.Injective root
  vertices : Fin n → Finset V
  vertices_card : ∀ i, (vertices i).card = 4
  root_mem : ∀ i, root i ∈ vertices i
  complete : ∀ i {x y}, x ∈ vertices i → y ∈ vertices i → x ≠ y → F.Adj x y
  off_cycle : ∀ i {x y}, x ∈ vertices i → y ∈ vertices i → x ≠ y →
    s(x, y) ∉ C.edges
  off_cycle_covered : ∀ {x y}, (sourceLemma36OffCycleGraph F C).Adj x y →
    ∃ i, x ∈ vertices i ∧ y ∈ vertices i
  roots_independent : (sourceLemma36OffCycleGraph F C).IsIndepSet
    (↑(Finset.univ.image root) : Set V)

/-- An off-cycle edge incident with a designated root belongs to that root's
designated `K₄`.  This is the rooted provenance fact available in the actual
Lemma 3.9 shadow-graph application. -/
private theorem sourceLemma38_offCycleAdj_root_has_owner [Fintype V] [DecidableEq V]
    {r : V} (F : SimpleGraph V) (C : F.Walk r r) (n : ℕ)
    (family : SourceLemma38RootedK4Family F C n) (j : Fin n) {x : V}
    (h : (sourceLemma36OffCycleGraph F C).Adj (family.root j) x) :
    x ∈ family.vertices j := by
  obtain ⟨i, hrootj_mem, hx_mem⟩ := family.off_cycle_covered h
  by_cases hroot_eq : family.root j = family.root i
  · have hji : j = i := family.root_injective hroot_eq
    simpa [hji] using hx_mem
  have hFadj : F.Adj (family.root j) (family.root i) :=
    family.complete i hrootj_mem (family.root_mem i) hroot_eq
  have hoff : s(family.root j, family.root i) ∉ C.edges :=
    family.off_cycle i hrootj_mem (family.root_mem i) hroot_eq
  have hroot_adj : (sourceLemma36OffCycleGraph F C).Adj
      (family.root j) (family.root i) := by
    change (s(family.root j, family.root i) ∈ F.edgeSet ∧
      s(family.root j, family.root i) ∉ C.edges) ∧ family.root j ≠ family.root i
    exact ⟨⟨F.mem_edgeSet.mpr hFadj, hoff⟩, hroot_eq⟩
  have hj_mem : family.root j ∈ Finset.univ.image family.root :=
    Finset.mem_image.mpr ⟨j, Finset.mem_univ _, rfl⟩
  have hi_mem : family.root i ∈ Finset.univ.image family.root :=
    Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
  have hroot_eq' : family.root j = family.root i :=
    sourceLemma38_shadowK4_root_label F C (Finset.univ.image family.root)
      family.roots_independent hj_mem hi_mem hroot_adj
  exact (hroot_eq hroot_eq').elim

/-- Recover a designated-root index from membership in the family's derived
root set. -/
private theorem sourceLemma38_root_index_of_mem [Fintype V] [DecidableEq V]
    {r : V} (F : SimpleGraph V) (C : F.Walk r r) (n : ℕ)
    (family : SourceLemma38RootedK4Family F C n) {z : V}
    (hz : z ∈ Finset.univ.image family.root) :
    ∃ j : Fin n, family.root j = z := by
  obtain ⟨j, -, hj⟩ := Finset.mem_image.mp hz
  exact ⟨j, hj⟩

/-- Along the concrete inside boundary arc of the decreasing Lemma 3.6
certificate, the retained middle first endpoints occur in decreasing selected
index order.  This is a cycle-order fact only; it makes no rootedness claim
about any subsequently chosen crossing chord. -/
private theorem sourceLemma36_kCrossladder_insideBoundarySubpath_middle_order
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (certificate : SourceLemma36KCrossladderCertificate G C k Z data iP matching)
    {i j : Fin k} (hij : i < j) :
    (sourceLemma36KCrossladderInsideBoundarySubpath
      G C k Z data iP matching certificate).support.idxOf
        (certificate.firstVertex ⟨j.1 + 1, by omega⟩) <
      (sourceLemma36KCrossladderInsideBoundarySubpath
        G C k Z data iP matching certificate).support.idxOf
        (certificate.firstVertex ⟨i.1 + 1, by omega⟩) := by
  rw [sourceLemma36KCrossladderInsideBoundarySubpath,
    sourceLemma36_walkReendpoint_support G]
  simpa only [certificate.firstPosition_vertex] using
    (sourceLemma36_positionSubpath_order G C hC data.anchor
      (certificate.firstPosition (Fin.last (k + 1)))
      (certificate.firstPosition 0)
      (certificate.firstPosition ⟨j.1 + 1, by omega⟩)
      (certificate.firstPosition ⟨i.1 + 1, by omega⟩)
      (certificate.first_descending ⟨j.1 + 1, by omega⟩
        (Fin.last (k + 1)) (by
          change j.1 + 1 < k + 1
          omega)).le
      (certificate.first_descending ⟨i.1 + 1, by omega⟩
        ⟨j.1 + 1, by omega⟩ (by
          change i.1 + 1 < j.1 + 1
          omega))
      (certificate.first_descending 0 ⟨i.1 + 1, by omega⟩ (by
          change 0 < i.1 + 1
          omega)).le)

/-- The increasing alternative in source Lemma 3.6 leaves a literal
`4k²`-ladder on the original cycle.  This package deliberately contains only
the cycle and its one-edge rungs; the unrooted Lemma 3.7 residual construction
will choose its crossing chords separately. -/
private structure SourceLemma36FourKSquaredLadder [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP)) where
  selection : SourceLemma36LargeIncreasingSelection G C k Z data iP matching
  cycle : G.Walk r r
  cycle_def : cycle = C
  cycle_isCycle : cycle.IsCycle
  firstVertex : Fin (4 * k^2) → V
  secondVertex : Fin (4 * k^2) → V
  firstVertex_def : ∀ i, firstVertex i = (selection.edge i).1.1
  secondVertex_def : ∀ i, secondVertex i = (selection.edge i).1.2
  rooted_in_Z : ∀ i, firstVertex i ∈ Z
  rung : ∀ i, G.Walk (firstVertex i) (secondVertex i)
  rung_isPath : ∀ i, (rung i).IsPath
  rung_length : ∀ i, (rung i).length = 1
  rung_off_cycle : ∀ i, s(firstVertex i, secondVertex i) ∉ C.edges
  rung_disjoint : ∀ i j, i ≠ j →
    Disjoint (↑(rung i).support.toFinset : Set V) (↑(rung j).support.toFinset : Set V)
  first_on_cycle : ∀ i, firstVertex i ∈ cycle.support
  second_on_cycle : ∀ i, secondVertex i ∈ cycle.support
  firstPosition : Fin (4 * k^2) →
    Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length
  secondPosition : Fin (4 * k^2) →
    Fin (sourceLemma36ComplementOrderAt G C hC k Z data iP).length
  firstPosition_vertex : ∀ i,
    (sourceLemma36RotatedCycleOrder G C data.anchor).get (firstPosition i) = firstVertex i
  secondPosition_vertex : ∀ i,
    (sourceLemma36ComplementOrderAt G C hC k Z data iP).get (secondPosition i) =
      secondVertex i
  first_arc_order : ∀ i j, i < j → firstPosition j < firstPosition i
  second_arc_order : ∀ i j, i < j → secondPosition i < secondPosition j

/-- The literal one-edge rung for an increasing matching edge. -/
private noncomputable def sourceLemma36IncreasingRung [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (selection : SourceLemma36LargeIncreasingSelection G C k Z data iP matching)
    (i : Fin (4 * k^2)) :
    G.Walk ((selection.edge i).1.1) ((selection.edge i).1.2) := by
  have hcandidate : (selection.edge i).1 ∈
      sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP :=
    matching.matching.1 (selection.edge i).2
  exact Walk.cons (sourceLemma36_offCycle_adj G C
    ((sourceLemma36_mem_caseB_candidateAt_iff G C hC k Z data iP _).mp
      hcandidate).2.1 |>.1) .nil

/-- The increasing Erdős--Szekeres alternative supplies the source
`4k²`-ladder on the unchanged Hamiltonian cycle. -/
private theorem sourceLemma36_large_increasing_yields_ladder
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (selection : SourceLemma36LargeIncreasingSelection G C k Z data iP matching) :
    Nonempty (SourceLemma36FourKSquaredLadder G C k Z data iP matching) := by
  let firstVertex : Fin (4 * k^2) → V := fun i => (selection.edge i).1.1
  let secondVertex : Fin (4 * k^2) → V := fun i => (selection.edge i).1.2
  have hcandidate : ∀ i, (selection.edge i).1 ∈
      sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP := by
    intro i
    exact matching.matching.1 (selection.edge i).2
  have hroot : ∀ i, firstVertex i ∈ Z := by
    intro i
    exact (sourceLemma36_mem_caseB_rootsAt_iff G C hC k Z data iP _).mp
      (sourceLemma36_caseB_matchingAt_first_endpoint_mem_rootsAt
        G C hC k Z data iP matching (selection.edge i).2) |>.1
  have hedge : ∀ i, G.Adj (firstVertex i) (secondVertex i) := by
    intro i
    exact (sourceLemma36_offCycle_adj G C
      ((sourceLemma36_mem_caseB_candidateAt_iff G C hC k Z data iP _).mp
        (hcandidate i)).2.1).1
  have hoff : ∀ i, s(firstVertex i, secondVertex i) ∉ C.edges := by
    intro i
    exact (sourceLemma36_offCycle_adj G C
      ((sourceLemma36_mem_caseB_candidateAt_iff G C hC k Z data iP _).mp
        (hcandidate i)).2.1).2
  have hdisjoint : ∀ {i j}, i ≠ j →
      firstVertex i ≠ firstVertex j ∧ firstVertex i ≠ secondVertex j ∧
        secondVertex i ≠ firstVertex j ∧ secondVertex i ≠ secondVertex j := by
    intro i j hij
    have hedges : selection.edge i ≠ selection.edge j := by
      exact fun h => hij (selection.edge_injective h)
    have hraw : (selection.edge i).1 ≠ (selection.edge j).1 := by
      exact fun h => hedges (Subtype.ext h)
    simpa only [firstVertex, secondVertex] using
      matching.matching.2 (selection.edge i).1 (selection.edge i).2
        (selection.edge j).1 (selection.edge j).2 hraw
  let rung : ∀ i, G.Walk (firstVertex i) (secondVertex i) := fun i =>
    sourceLemma36IncreasingRung G C k Z data iP matching selection i
  have hrungPath : ∀ i, (rung i).IsPath := by
    intro i
    rw [show rung i = Walk.cons (hedge i) .nil by rfl, Walk.cons_isPath_iff]
    constructor
    · exact Walk.IsPath.nil
    · simpa only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] using
        (hedge i).ne
  have hrungLength : ∀ i, (rung i).length = 1 := by
    intro i
    simp [rung, sourceLemma36IncreasingRung]
  have hrungDisjoint : ∀ i j, i ≠ j →
      Disjoint (↑(rung i).support.toFinset : Set V) (↑(rung j).support.toFinset : Set V) := by
    intro i j hij
    apply Set.disjoint_left.2
    intro v hvi hvj
    have hvi' : v ∈ (rung i).support := List.mem_toFinset.mp hvi
    have hvj' : v ∈ (rung j).support := List.mem_toFinset.mp hvj
    rw [show rung i = Walk.cons (hedge i) .nil by rfl] at hvi'
    rw [show rung j = Walk.cons (hedge j) .nil by rfl] at hvj'
    simp only [Walk.support_cons, Walk.support_nil, List.mem_cons, List.not_mem_nil,
      or_false] at hvi' hvj'
    rcases hvi' with rfl | rfl <;> rcases hvj' with h | h
    · exact (hdisjoint hij).1 h
    · exact (hdisjoint hij).2.1 h
    · exact (hdisjoint hij).2.2.1 h
    · exact (hdisjoint hij).2.2.2 h
  refine ⟨{
    selection := selection
    cycle := C
    cycle_def := rfl
    cycle_isCycle := hC.isCycle
    firstVertex := firstVertex
    secondVertex := secondVertex
    firstVertex_def := by intro i; rfl
    secondVertex_def := by intro i; rfl
    rooted_in_Z := hroot
    rung := rung
    rung_isPath := hrungPath
    rung_length := hrungLength
    rung_off_cycle := hoff
    rung_disjoint := hrungDisjoint
    first_on_cycle := by intro i; simpa using hC.mem_support (firstVertex i)
    second_on_cycle := by intro i; simpa using hC.mem_support (secondVertex i)
    firstPosition := selection.ordering.firstPosition ∘ selection.edge
    secondPosition := selection.ordering.secondPosition ∘ selection.edge
    firstPosition_vertex := by
      intro i
      simpa only [Function.comp_apply, firstVertex] using
        selection.ordering.firstPosition_get (selection.edge i)
    secondPosition_vertex := by
      intro i
      simpa only [Function.comp_apply, secondVertex] using
        selection.ordering.secondPosition_get (selection.edge i)
    first_arc_order := by
      intro i j hij
      exact selection.first_descending i j hij
    second_arc_order := by
      intro i j hij
      exact selection.second_increasing i j hij }⟩

/-- Exact source-cycle visitation data for the increasing residual ladder. -/
private theorem sourceLemma36_fourKSquaredLadder_cycle_visitation
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching) :
    ladder.cycle = C ∧
      (∀ i, ladder.firstVertex i ∈ ladder.cycle.support ∧
        ladder.secondVertex i ∈ ladder.cycle.support) ∧
      (∀ i j, i < j → ladder.firstPosition j < ladder.firstPosition i) ∧
      (∀ i j, i < j → ladder.secondPosition i < ladder.secondPosition j) := by
  exact ⟨ladder.cycle_def, fun i => ⟨ladder.first_on_cycle i, ladder.second_on_cycle i⟩,
    ladder.first_arc_order, ladder.second_arc_order⟩

/-- A segment of the filtered complementary order is always represented by
the corresponding genuine oriented subpath of the original cycle.  The
filtered list is used only to choose endpoints; it is never treated as an
independent cycle. -/
private noncomputable def sourceLemma36ComplementOrderAtSegment
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (p q : Fin (sourceLemma36ComplementOrderAt G C hC k Z data iP).length) :
    G.Walk ((sourceLemma36ComplementOrderAt G C hC k Z data iP).get p)
      ((sourceLemma36ComplementOrderAt G C hC k Z data iP).get q) :=
  sourceOrientedCycleSubpath G C (hC.mem_support _) (hC.mem_support _)

private theorem sourceOrientedCycleSubpath_support_congr [DecidableEq V]
    {r a b a' b' : V} (C : G.Walk r r)
    (ha : a ∈ C.support) (hb : b ∈ C.support)
    (ha' : a' ∈ C.support) (hb' : b' ∈ C.support)
    (haa' : a = a') (hbb' : b = b') :
    (sourceOrientedCycleSubpath G C ha hb).support =
      (sourceOrientedCycleSubpath G C ha' hb').support := by
  subst a'
  subst b'
  rfl

/-- The actual complementary cycle segment contains every intervening
complement-order position. -/
private theorem sourceLemma36_complementOrderAt_segment_contains
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (p q t : Fin (sourceLemma36ComplementOrderAt G C hC k Z data iP).length)
    (hpt : p ≤ t) (htq : t ≤ q) :
    (sourceLemma36ComplementOrderAt G C hC k Z data iP).get t ∈
      (sourceLemma36ComplementOrderAtSegment G C hC k Z data iP p q).support := by
  classical
  by_cases hnext : iP.1 + 1 < k
  · let L := sourceLemma36RotatedCycleOrder G C data.anchor
    let next : Fin k := ⟨iP.1 + 1, hnext⟩
    obtain ⟨p', hp', hpget⟩ :=
      sourceLemma36_complementOrderAt_get_reanchor_of_next G C hC k Z data iP hnext p
    obtain ⟨q', hq', hqget⟩ :=
      sourceLemma36_complementOrderAt_get_reanchor_of_next G C hC k Z data iP hnext q
    obtain ⟨t', ht', htget⟩ :=
      sourceLemma36_complementOrderAt_get_reanchor_of_next G C hC k Z data iP hnext t
    have hpq : p' ≤ q' := by
      apply Fin.mk_le_mk.mpr
      rw [hp', hq']
      exact hpt.trans htq
    have hpt' : p' ≤ t' := by
      apply Fin.mk_le_mk.mpr
      rw [hp', ht']
      exact hpt
    have htq' : t' ≤ q' := by
      apply Fin.mk_le_mk.mpr
      rw [ht', hq']
      exact htq
    have hmem := sourceLemma36_position_mem_subpath G C hC (L.get (data.cutPositions next))
      p' q' t' hpt' htq'
    have hmem' :
        (sourceLemma36ComplementOrderAt G C hC k Z data iP).get t ∈
          (sourceLemma36WalkReendpoint G
            (sourceLemma36RotatedPositionSubpath G C hC
              (L.get (data.cutPositions next)) p' q') hpget hqget).support := by
      rw [sourceLemma36_walkReendpoint_support]
      simpa only [← htget] using hmem
    rw [sourceLemma36_walkReendpoint_support] at hmem'
    unfold sourceLemma36ComplementOrderAtSegment
    rw [← sourceOrientedCycleSubpath_support_congr G C
      (sourceLemma36_rotatedPosition_mem_cycle G C hC _ p')
      (sourceLemma36_rotatedPosition_mem_cycle G C hC _ q')
      (hC.mem_support _) (hC.mem_support _) hpget hqget]
    simpa only [sourceLemma36RotatedPositionSubpath] using hmem'
  · obtain ⟨p', hp', hpget⟩ :=
      sourceLemma36_complementOrderAt_get_reanchor_of_last G C hC k Z data iP hnext p
    obtain ⟨q', hq', hqget⟩ :=
      sourceLemma36_complementOrderAt_get_reanchor_of_last G C hC k Z data iP hnext q
    obtain ⟨t', ht', htget⟩ :=
      sourceLemma36_complementOrderAt_get_reanchor_of_last G C hC k Z data iP hnext t
    have hpt' : p' ≤ t' := by
      apply Fin.mk_le_mk.mpr
      rw [hp', ht']
      exact hpt
    have htq' : t' ≤ q' := by
      apply Fin.mk_le_mk.mpr
      rw [ht', hq']
      exact htq
    have hmem := sourceLemma36_position_mem_subpath G C hC data.anchor p' q' t' hpt' htq'
    have hmem' :
        (sourceLemma36ComplementOrderAt G C hC k Z data iP).get t ∈
          (sourceLemma36WalkReendpoint G
            (sourceLemma36RotatedPositionSubpath G C hC data.anchor p' q') hpget hqget).support := by
      rw [sourceLemma36_walkReendpoint_support]
      simpa only [← htget] using hmem
    rw [sourceLemma36_walkReendpoint_support] at hmem'
    unfold sourceLemma36ComplementOrderAtSegment
    rw [← sourceOrientedCycleSubpath_support_congr G C
      (sourceLemma36_rotatedPosition_mem_cycle G C hC _ p')
      (sourceLemma36_rotatedPosition_mem_cycle G C hC _ q')
      (hC.mem_support _) (hC.mem_support _) hpget hqget]
    simpa only [sourceLemma36RotatedPositionSubpath] using hmem'

/-- Membership in a complementary-order segment is exactly membership at an
index of the corresponding closed interval.  This is the converse of
`sourceLemma36_complementOrderAt_segment_contains` and keeps the filtered
complement order only as a coordinate system for an actual subpath of `C`. -/
private theorem sourceLemma36_mem_complementOrderAtSegment_iff
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (p q : Fin (sourceLemma36ComplementOrderAt G C hC k Z data iP).length)
    (hpq : p ≤ q) (x : V) :
    x ∈ (sourceLemma36ComplementOrderAtSegment
      G C hC k Z data iP p q).support ↔
      ∃ t : Fin (sourceLemma36ComplementOrderAt G C hC k Z data iP).length,
        p ≤ t ∧ t ≤ q ∧
          (sourceLemma36ComplementOrderAt G C hC k Z data iP).get t = x := by
  classical
  constructor
  · intro hx
    by_cases hnext : iP.1 + 1 < k
    · let L := sourceLemma36RotatedCycleOrder G C data.anchor
      let next : Fin k := ⟨iP.1 + 1, hnext⟩

      obtain ⟨p', hp', hpget⟩ :=
        sourceLemma36_complementOrderAt_get_reanchor_of_next
          G C hC k Z data iP hnext p
      obtain ⟨q', hq', hqget⟩ :=
        sourceLemma36_complementOrderAt_get_reanchor_of_next
          G C hC k Z data iP hnext q

      have hpq' : p' ≤ q' := by
        apply Fin.mk_le_mk.mpr
        rw [hp', hq']
        exact hpq

      have hx' :
          x ∈ (sourceLemma36RotatedPositionSubpath G C hC
            (L.get (data.cutPositions next)) p' q').support := by
        unfold sourceLemma36ComplementOrderAtSegment at hx
        rw [← sourceOrientedCycleSubpath_support_congr G C
          (sourceLemma36_rotatedPosition_mem_cycle
            G C hC (L.get (data.cutPositions next)) p')
          (sourceLemma36_rotatedPosition_mem_cycle
            G C hC (L.get (data.cutPositions next)) q')
          (hC.mem_support _) (hC.mem_support _) hpget hqget] at hx
        simpa only [sourceLemma36RotatedPositionSubpath] using hx

      obtain ⟨t', hpt', htq', htget⟩ :=
        (sourceLemma36_mem_positionSubpath_iff
          G C hC (L.get (data.cutPositions next))
          p' q' hpq' x).mp hx'

      let t :
          Fin (sourceLemma36ComplementOrderAt G C hC k Z data iP).length :=
        ⟨t'.1, by
          have htqVal : t'.1 ≤ q'.1 := htq'
          rw [hq'] at htqVal
          exact lt_of_le_of_lt htqVal q.2⟩

      obtain ⟨t'', ht'', htget''⟩ :=
        sourceLemma36_complementOrderAt_get_reanchor_of_next
          G C hC k Z data iP hnext t

      have htt : t'' = t' := by
        apply Fin.ext
        dsimp [t] at ht''
        omega

      refine ⟨t, ?_, ?_, ?_⟩
      · change p.1 ≤ t.1
        dsimp [t]
        rw [← hp']
        exact hpt'
      · change t.1 ≤ q.1
        dsimp [t]
        rw [← hq']
        exact htq'
      · rw [← htget'', htt]
        exact htget

    · obtain ⟨p', hp', hpget⟩ :=
        sourceLemma36_complementOrderAt_get_reanchor_of_last
          G C hC k Z data iP hnext p
      obtain ⟨q', hq', hqget⟩ :=
        sourceLemma36_complementOrderAt_get_reanchor_of_last
          G C hC k Z data iP hnext q

      have hpq' : p' ≤ q' := by
        apply Fin.mk_le_mk.mpr
        rw [hp', hq']
        exact hpq

      have hx' :
          x ∈ (sourceLemma36RotatedPositionSubpath
            G C hC data.anchor p' q').support := by
        unfold sourceLemma36ComplementOrderAtSegment at hx
        rw [← sourceOrientedCycleSubpath_support_congr G C
          (sourceLemma36_rotatedPosition_mem_cycle G C hC data.anchor p')
          (sourceLemma36_rotatedPosition_mem_cycle G C hC data.anchor q')
          (hC.mem_support _) (hC.mem_support _) hpget hqget] at hx
        simpa only [sourceLemma36RotatedPositionSubpath] using hx

      obtain ⟨t', hpt', htq', htget⟩ :=
        (sourceLemma36_mem_positionSubpath_iff
          G C hC data.anchor p' q' hpq' x).mp hx'

      let t :
          Fin (sourceLemma36ComplementOrderAt G C hC k Z data iP).length :=
        ⟨t'.1, by
          have htqVal : t'.1 ≤ q'.1 := htq'
          rw [hq'] at htqVal
          exact lt_of_le_of_lt htqVal q.2⟩

      obtain ⟨t'', ht'', htget''⟩ :=
        sourceLemma36_complementOrderAt_get_reanchor_of_last
          G C hC k Z data iP hnext t

      have htt : t'' = t' := by
        apply Fin.ext
        dsimp [t] at ht''
        omega

      refine ⟨t, ?_, ?_, ?_⟩
      · change p.1 ≤ t.1
        dsimp [t]
        rw [← hp']
        exact hpt'
      · change t.1 ≤ q.1
        dsimp [t]
        rw [← hq']
        exact htq'
      · rw [← htget'', htt]
        exact htget

  · rintro ⟨t, hpt, htq, htget⟩
    rw [← htget]
    exact sourceLemma36_complementOrderAt_segment_contains
      G C hC k Z data iP p q t hpt htq

