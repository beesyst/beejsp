  have hcentralEq :
      sourceLemma37_retainedChordOfChord G C hC centralOriginal hcentralH = central := by
    rfl
  refine ⟨sourceLemma37_retainedChordOfChord G C hC chosenPartner hpartnerH, ?_⟩
  have hretained' := hretained
  rw [hcentralEq] at hretained'
  simpa [central] using hretained'

/-- The retained residual branch no longer needs an externally supplied
