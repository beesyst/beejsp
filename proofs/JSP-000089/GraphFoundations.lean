  obtain ⟨partner, hcross, hclass⟩ := sourceLemma37_choose_block_dichotomies
    G C k hk Z data iP matching ladder hpartner
  refine ⟨partner, hcross, ?_⟩
  by_cases hbuffer : ∃ i,
      sourceLemma37BlockCrossladder G C k hk Z data iP matching ladder i
  · exact Or.inl hbuffer
  have hside : ∀ i : Fin (2 * k - 1),
      sourceLemma37SameSide G C k Z data iP matching ladder i (partner i) ∨
        sourceLemma37CrossSide G C k Z data iP matching ladder i (partner i) := by
    intro i
    rcases hclass i with hblock | hside
    · exact (hbuffer ⟨i, hblock⟩).elim
    · exact hside
  let sameIndices : Finset (Fin (2 * k - 1)) := Finset.univ.filter fun i =>
    sourceLemma37SameSide G C k Z data iP matching ladder i (partner i)
  let crossIndices : Finset (Fin (2 * k - 1)) := Finset.univ.filter fun i =>
    ¬ sourceLemma37SameSide G C k Z data iP matching ladder i (partner i)
  have hpartition : sameIndices.card + crossIndices.card = 2 * k - 1 := by
    simpa [sameIndices, crossIndices] using
      (Finset.filter_card_add_filter_neg_card_eq_card
        (s := (Finset.univ : Finset (Fin (2 * k - 1))))
        (fun i => sourceLemma37SameSide G C k Z data iP matching ladder i (partner i)))
  by_cases hsame_large : k ≤ sameIndices.card
  · right
    left
    let ordered := sourceLemma36_sortedSourceIndices sameIndices
    let selected : Fin k → Fin (2 * k - 1) := fun t =>
      ordered.get ⟨t, by
        rw [sourceLemma36_sortedSourceIndices_length]
        exact lt_of_lt_of_le t.isLt hsame_large⟩
    refine ⟨selected, ?_, ?_⟩
    · intro a b hab
      dsimp [selected]
      exact sourceLemma36_sortedSourceIndices_strictMono sameIndices
        hab
    · intro t
      have hmem : selected t ∈ sameIndices := by
        have hget : selected t ∈ ordered := by
          dsimp [selected]
          exact List.get_mem _ _
        have hgetFinset : selected t ∈ ordered.toFinset :=
          List.mem_toFinset.mpr hget
        have hordered : ordered.toFinset = sameIndices := by
          simpa [ordered] using
            (sourceLemma36_sortedSourceIndices_toFinset sameIndices)
        exact hordered ▸ hgetFinset
      exact (Finset.mem_filter.mp hmem).2
  · right
    right
    have hcross_large : k ≤ crossIndices.card := by
      by_contra hnot
      have hsame_small : sameIndices.card < k := Nat.lt_of_not_ge hsame_large
      have hcross_small : crossIndices.card < k := Nat.lt_of_not_ge hnot
      omega
    let ordered := sourceLemma36_sortedSourceIndices crossIndices
    let selected : Fin k → Fin (2 * k - 1) := fun t =>
      ordered.get ⟨t, by
        rw [sourceLemma36_sortedSourceIndices_length]
        exact lt_of_lt_of_le t.isLt hcross_large⟩
    refine ⟨selected, ?_, ?_⟩
    · intro a b hab
      dsimp [selected]
      exact sourceLemma36_sortedSourceIndices_strictMono crossIndices
        hab
    · intro t
      have hmem : selected t ∈ crossIndices := by
        have hget : selected t ∈ ordered := by
          dsimp [selected]
          exact List.get_mem _ _
        have hgetFinset : selected t ∈ ordered.toFinset :=
          List.mem_toFinset.mpr hget
        have hordered : ordered.toFinset = crossIndices := by
          simpa [ordered] using
            (sourceLemma36_sortedSourceIndices_toFinset crossIndices)
        exact hordered ▸ hgetFinset
      exact (hside (selected t)).resolve_left (Finset.mem_filter.mp hmem).2

