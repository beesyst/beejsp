/-- Reversing a simple rail reverses its vertex coordinates. -/
theorem sourceLemma39_path_reverse_index [DecidableEq V]
    {a b z : V} (P : G.Walk a b) (hP : P.IsPath) (hz : z ∈ P.support) :
    P.reverse.support.idxOf z + P.support.idxOf z = P.length := by
  have hi := List.idxOf_lt_length_iff.mpr hz
  let j : Fin P.reverse.support.length := ⟨P.length - P.support.idxOf z, by
    simp only [Walk.support_reverse, List.length_reverse, Walk.length_support]
    omega⟩
  have hj : P.reverse.support.get j = z := by
    simp only [Walk.support_reverse, List.get_eq_getElem, List.getElem_reverse]
    have he : P.support.length - 1 - (P.length - P.support.idxOf z) = P.support.idxOf z := by
      have := P.length_support
      omega
    simp only [j, he]
    exact List.idxOf_get hi
