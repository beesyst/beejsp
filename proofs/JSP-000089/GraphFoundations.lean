  have hsel : StrictMono sel := by intro i j hij; exact Nat.add_lt_add_right hij 1
  obtain ⟨lp, rp, hlp, hrp, hlget, hrget, hlr, exclusions⟩ :=
    sourceLemma39_direct_net_ordered_selection G shadow T u w v x y net
  obtain ⟨ox, oy, I, P, R, hox, hoy, hoxy, hI, hP, hR, hIs, hPcomp, hRcomp,
