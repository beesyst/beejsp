    {i j : Fin k} (hij : i ≠ j) :
    Disjoint (sourceLemma36CorePositions G C a Z0 q hq hlength i)
      (sourceLemma36CorePositions G C a Z0 q hq hlength j) := by
  rcases lt_or_gt_of_ne hij with hlt | hgt
  · exact sourceLemma36_corePositions_disjoint (G := G) C a Z0 q hq hlength hlt
  · exact (sourceLemma36_corePositions_disjoint (G := G) C a Z0 q hq hlength hgt).symm

private theorem sourceLemma36_corePositions_cover [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V) (Z0 : Finset V)
    (q : ℕ) {k : ℕ} (hk : 1 ≤ k) (hq : 0 < q)
    (hlength : (sourceLemma36OrderedZ G C a Z0).length = k * q)
    (ha : a ∈ Z0) (p : Fin (sourceLemma36RotatedCycleOrder G C a).length) :
    ∃ i : Fin k, p ∈ sourceLemma36CorePositions G C a Z0 q hq hlength i := by
  classical
  let i0 : Fin k := ⟨0, by omega⟩
  let cuts : Finset (Fin k) := Finset.univ.filter fun i =>
    sourceLemma36CutPosition G C a Z0 q hq hlength i ≤ p
  have hzero : (sourceLemma36CutPosition G C a Z0 q hq hlength i0).1 = 0 := by
    simpa [i0] using sourceLemma36_cutPosition_zero (G := G)
      C hC a Z0 q hk hq hlength ha
  have hi0 : i0 ∈ cuts := by
    simp only [cuts, Finset.mem_filter, Finset.mem_univ, true_and]
    change (sourceLemma36CutPosition G C a Z0 q hq hlength i0).1 ≤ p.1
    omega
  let i := cuts.max' ⟨i0, hi0⟩
  have himem : i ∈ cuts := cuts.max'_mem ⟨i0, hi0⟩
  have hilower : sourceLemma36CutPosition G C a Z0 q hq hlength i ≤ p := by
    simpa [cuts] using himem
  by_cases hnext : i.1 + 1 < k
  · let next : Fin k := ⟨i.1 + 1, hnext⟩
    have hinext : i < next := by
      change i.1 < i.1 + 1
      omega
    have hupper : p < sourceLemma36CutPosition G C a Z0 q hq hlength next := by
      apply lt_of_not_ge
      intro hnextle
      have hnextmem : next ∈ cuts := by
        simp [cuts, hnextle]
      have hle : next ≤ i := cuts.le_max' next hnextmem
      exact (not_le_of_gt hinext) hle
    refine ⟨i, ?_⟩
    unfold sourceLemma36CorePositions
    simp [hnext, next, hilower, hupper]
  · refine ⟨i, ?_⟩
    unfold sourceLemma36CorePositions
    simp [hnext, hilower]

private theorem sourceLemma36_shared_next_cut [DecidableEq V]
    (C : G.Walk r r) (a : V) (Z0 : Finset V) (q : ℕ) {k : ℕ}
    (hq : 0 < q) (hlength : (sourceLemma36OrderedZ G C a Z0).length = k * q)
    (i : Fin k) (hnext : i.1 + 1 < k) :
    let next : Fin k := ⟨i.1 + 1, hnext⟩
    sourceLemma36CutPosition G C a Z0 q hq hlength next ∈
        sourceLemma36ClosedPiecePositions G C a Z0 q hq hlength i ∧
      sourceLemma36CutPosition G C a Z0 q hq hlength next ∈
        sourceLemma36ClosedPiecePositions G C a Z0 q hq hlength next := by
  dsimp
  constructor
  · exact sourceLemma36_next_cut_mem_closed (G := G) C a Z0 q hq hlength i hnext
  · exact sourceLemma36_core_subset_closed (G := G) C a Z0 q hq hlength _
      (sourceLemma36_cut_mem_core (G := G) C a Z0 q hq hlength _)

private theorem sourceLemma36_anchor_mem_last_piece [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V) (Z0 : Finset V)
    (q : ℕ) {k : ℕ} (hk : 1 ≤ k) (hq : 0 < q)
    (hlength : (sourceLemma36OrderedZ G C a Z0).length = k * q)
    (ha : a ∈ Z0) (i : Fin k) (hlast : ¬ i.1 + 1 < k) :
    a ∈ sourceLemma36PieceVertices G C a Z0 q hq hlength i := by
  let i0 : Fin k := ⟨0, by omega⟩
  have hkpos : 0 < k := by omega
  have hclosed : sourceLemma36CutPosition G C a Z0 q hq hlength i0 ∈
      sourceLemma36ClosedPiecePositions G C a Z0 q hq hlength i := by
    exact sourceLemma36_anchor_cut_mem_last_closed (G := G)
      C a Z0 q hkpos hq hlength i hlast
  have hzero : (sourceLemma36CutPosition G C a Z0 q hq hlength i0).1 = 0 := by
    simpa [i0] using sourceLemma36_cutPosition_zero (G := G)
      C hC a Z0 q hk hq hlength ha
  have hcycle_pos : 0 < (sourceLemma36RotatedCycleOrder G C a).length := by
    apply List.length_pos_iff.mpr
    intro hnil
    have hstart := sourceLemma36_rotatedCycleOrder_starts_at G C hC a
    simp [hnil] at hstart
  let p0 : Fin (sourceLemma36RotatedCycleOrder G C a).length := ⟨0, hcycle_pos⟩
  have hcut_eq : sourceLemma36CutPosition G C a Z0 q hq hlength i0 = p0 := by
    apply Fin.ext
    simpa [p0] using hzero
  have hp0 : (sourceLemma36RotatedCycleOrder G C a).get p0 = a := by
    have hopt : (sourceLemma36RotatedCycleOrder G C a)[0]? = some a := by
      simpa only [List.head?_eq_getElem?] using
        (sourceLemma36_rotatedCycleOrder_starts_at G C hC a)
    change (sourceLemma36RotatedCycleOrder G C a)[0] = a
    exact Option.some.inj ((List.getElem?_eq_getElem hcycle_pos).symm.trans hopt)
  change ∃ p ∈ sourceLemma36ClosedPiecePositions G C a Z0 q hq hlength i,
    (sourceLemma36RotatedCycleOrder G C a).get p = a
  refine ⟨sourceLemma36CutPosition G C a Z0 q hq hlength i0, hclosed, ?_⟩
  rw [hcut_eq]
  exact hp0

/-- The exact partition interface consumed by the two remaining source
Lemma 3.6 cases.  `pieces` is deliberately represented by its root-bearing
cycle intervals: it carries both the concrete vertex set used by the chord
predicate and the canonical positional interval used for ordering. -/
private structure SourceLemma36PartitionData [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V) where
  Z0 : Finset V
  anchor : V
  Z0_subset : Z0 ⊆ Z
  Z0_card : Z0.card = k * sourceLemma36_partitionQuota k
  anchor_mem : anchor ∈ Z0
  cycleOrder : List V
  cycleOrder_def : cycleOrder = sourceLemma36RotatedCycleOrder G C anchor
  cycleOrder_nodup : cycleOrder.Nodup
  cycleOrder_toFinset : cycleOrder.toFinset = Finset.univ
  cycleOrder_starts_anchor : cycleOrder.head? = some anchor
  orderedZ : List V
  orderedZ_def : orderedZ = sourceLemma36OrderedZ G C anchor Z0
  orderedZ_nodup : orderedZ.Nodup
  orderedZ_toFinset : orderedZ.toFinset = Z0
  orderedZ_length : orderedZ.length = k * sourceLemma36_partitionQuota k
  canonical_orderedZ_length :
    (sourceLemma36OrderedZ G C anchor Z0).length = k * sourceLemma36_partitionQuota k
  blockRoots : Fin k → Finset V
  blockRoots_def : ∀ i, blockRoots i =
    sourceLemma36RootBlock orderedZ (sourceLemma36_partitionQuota k) i
  block_card : ∀ i, (blockRoots i).card = sourceLemma36_partitionQuota k
  block_subset_Z0 : ∀ i, blockRoots i ⊆ Z0
  block_subset_Z : ∀ i, blockRoots i ⊆ Z
  block_disjoint : ∀ i j, i ≠ j → Disjoint (blockRoots i) (blockRoots j)
  quota_pos : 0 < sourceLemma36_partitionQuota k
  cutPositions : Fin k → Fin (sourceLemma36RotatedCycleOrder G C anchor).length
  cutPositions_def : ∀ i, cutPositions i = sourceLemma36CutPosition G C anchor Z0
    (sourceLemma36_partitionQuota k) quota_pos canonical_orderedZ_length i
  corePositions : Fin k →
    Finset (Fin (sourceLemma36RotatedCycleOrder G C anchor).length)
  corePositions_def : ∀ i, corePositions i = sourceLemma36CorePositions G C anchor Z0
    (sourceLemma36_partitionQuota k) quota_pos canonical_orderedZ_length i
  core_disjoint : ∀ i j, i ≠ j → Disjoint (corePositions i) (corePositions j)
  core_cover : ∀ p, ∃ i, p ∈ corePositions i
  piecePositions : Fin k →
    Finset (Fin (sourceLemma36RotatedCycleOrder G C anchor).length)
  piecePositions_def : ∀ i, piecePositions i =
    sourceLemma36ClosedPiecePositions G C anchor Z0
      (sourceLemma36_partitionQuota k) quota_pos canonical_orderedZ_length i
  pieces : Fin k → Set V
  pieces_def : ∀ i, pieces i = sourceLemma36PieceVertices G C anchor Z0
    (sourceLemma36_partitionQuota k) quota_pos canonical_orderedZ_length i
  blockRoots_mem_piece : ∀ i, ↑(blockRoots i) ⊆ pieces i
  piece_contains_quota_roots : ∀ i, ∃ R : Finset V,
    R ⊆ Z ∧ (↑R : Set V) ⊆ pieces i ∧ R.card = sourceLemma36_partitionQuota k
  next_cut_shared : ∀ i (hnext : i.1 + 1 < k),
    let next : Fin k := ⟨i.1 + 1, hnext⟩
    cutPositions next ∈ piecePositions i ∧ cutPositions next ∈ piecePositions next
  anchor_mem_last_piece : ∀ i, ¬ i.1 + 1 < k → anchor ∈ pieces i

/-- Complete root partition and positional cycle-piece layer for source
Lemma 3.6.  The two later alternatives can either select chords internal to
one of `pieces`, or invoke `sourceLemma36_offCycle_neighbour_leaves_piece`
on a piece with no such chord. -/
private noncomputable def sourceLemma36_partition_data [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (hk : 1 ≤ k)
    (Z : Finset V) (hZlarge : sourceLemma36_c k ≤ Z.card) :
    SourceLemma36PartitionData G C hC k Z := by
  let hroot := sourceLemma36_exists_exact_root_subset_with_anchor k hk Z hZlarge
  let Z0 := Classical.choose hroot
  let hZ0a := Classical.choose_spec hroot
  let a := Classical.choose hZ0a
  let hparts := Classical.choose_spec hZ0a
  let orderedZ := sourceLemma36OrderedZ G C a Z0
  let q := sourceLemma36_partitionQuota k
  let hq := sourceLemma36_partitionQuota_pos k hk
  let hlength : orderedZ.length = k * q :=
    sourceLemma36_orderedZ_length G C hC a Z0 hparts.2.1
  let blockRoots : Fin k → Finset V := fun i =>
    sourceLemma36RootBlock orderedZ q i
  let cutPositions : Fin k → Fin (sourceLemma36RotatedCycleOrder G C a).length := fun i =>
    sourceLemma36CutPosition G C a Z0 q hq hlength i
  let corePositions : Fin k → Finset (Fin (sourceLemma36RotatedCycleOrder G C a).length) :=
    fun i => sourceLemma36CorePositions G C a Z0 q hq hlength i
  let piecePositions : Fin k → Finset (Fin (sourceLemma36RotatedCycleOrder G C a).length) :=
    fun i => sourceLemma36ClosedPiecePositions G C a Z0 q hq hlength i
  let pieces : Fin k → Set V := fun i =>
    sourceLemma36PieceVertices G C a Z0 q hq hlength i
  refine {
    Z0 := Z0
    anchor := a
    Z0_subset := hparts.1
    Z0_card := hparts.2.1
    anchor_mem := hparts.2.2
    cycleOrder := sourceLemma36RotatedCycleOrder G C a
    cycleOrder_def := rfl
    cycleOrder_nodup := sourceLemma36_rotatedCycleOrder_nodup G C hC a
    cycleOrder_toFinset := sourceLemma36_rotatedCycleOrder_toFinset G C hC a
    cycleOrder_starts_anchor := sourceLemma36_rotatedCycleOrder_starts_at G C hC a
    orderedZ := orderedZ
    orderedZ_def := rfl
    orderedZ_nodup := sourceLemma36_orderedZ_nodup G C hC a Z0
    orderedZ_toFinset := sourceLemma36_orderedZ_toFinset G C hC a Z0
    orderedZ_length := hlength
    canonical_orderedZ_length := hlength
    blockRoots := blockRoots
    blockRoots_def := by intro i; rfl
    block_card := ?_
    block_subset_Z0 := ?_
    block_subset_Z := ?_
    block_disjoint := ?_
    quota_pos := hq
    cutPositions := cutPositions
    cutPositions_def := by intro i; rfl
    corePositions := corePositions
    corePositions_def := by intro i; rfl
    core_disjoint := ?_
    core_cover := ?_
    piecePositions := piecePositions
    piecePositions_def := by intro i; rfl
    pieces := pieces
    pieces_def := by intro i; rfl
    blockRoots_mem_piece := ?_
    piece_contains_quota_roots := ?_
    next_cut_shared := ?_
    anchor_mem_last_piece := ?_ }
  · intro i
    exact sourceLemma36_rootBlock_card
      (sourceLemma36_orderedZ_nodup G C hC a Z0)
      (sourceLemma36_orderedZ_length G C hC a Z0 hparts.2.1) i.2
  · intro i
    exact sourceLemma36_rootBlock_subset_Z0 G C hC a Z0 q i
  · intro i
    exact (sourceLemma36_rootBlock_subset_Z0 G C hC a Z0 q i).trans hparts.1
  · intro i j hij
    rcases lt_or_gt_of_ne hij with hij | hji
    · exact sourceLemma36_rootBlock_disjoint
        (sourceLemma36_orderedZ_nodup G C hC a Z0) q hij
    · exact (sourceLemma36_rootBlock_disjoint
        (sourceLemma36_orderedZ_nodup G C hC a Z0) q hji).symm
  · intro i j hij
    exact sourceLemma36_corePositions_disjoint_ne (G := G) C a Z0 q hq hlength hij
  · intro p
    exact sourceLemma36_corePositions_cover (G := G) C hC a Z0 q hk hq hlength
      hparts.2.2 p
  · intro i
    exact sourceLemma36_rootBlock_subset_piece (G := G) C a Z0 q hq hlength i
  · intro i
    exact sourceLemma36_piece_contains_quota_roots (G := G) C hC a Z0 Z hparts.1
      q hq hlength i
  · intro i hnext
    exact sourceLemma36_shared_next_cut (G := G) C a Z0 q hq hlength i hnext
  · intro i hlast
    exact sourceLemma36_anchor_mem_last_piece (G := G) C hC a Z0 q hk hq hlength
      hparts.2.2 i hlast

/-- Case B now has the source-faithful meaning: an off-cycle neighbour of a
selected root leaves the whole consecutive Hamiltonian-cycle piece, not only
the selected-root block. -/
private theorem sourceLemma36_caseB_neighbour_leaves_piece [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (i : Fin k) {z w : V}
    (hz : z ∈ data.blockRoots i)
    (hno : ¬ sourceLemma36HasZIncidentInternalChord G C Z (data.pieces i))
    (hzw : (sourceLemma36OffCycleGraph G C).Adj z w) :
    w ∉ data.pieces i := by
  exact sourceLemma36_offCycle_neighbour_leaves_piece (G := G) C Z (data.pieces i)
    hno (data.block_subset_Z i hz) (data.blockRoots_mem_piece i hz) hzw

/-- Case A exposes exactly the source witness: its second endpoint is an
arbitrary vertex of the actual cycle piece, rather than another selected root. -/
private theorem sourceLemma36_caseA_internal_chord [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (i : Fin k)
    (h : sourceLemma36HasZIncidentInternalChord G C Z (data.pieces i)) :
    ∃ z ∈ Z, z ∈ data.pieces i ∧ ∃ w ∈ data.pieces i,
      (sourceLemma36OffCycleGraph G C).Adj z w := by
  exact h

/-- The allocated, half-open vertex carrier for the `i`th Case-A subpath.
Unlike the closed `pieces`, these carriers are pairwise disjoint. -/
private def sourceLemma36CoreVertices [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (i : Fin k) : Set V :=
  {v | ∃ p ∈ data.corePositions i,
    (sourceLemma36RotatedCycleOrder G C data.anchor).get p = v}

/-- The source partition is represented by its allocated consecutive vertex
intervals.  This is the vertex-partition reading of “partition `C` into `k`
subpaths” in Lemma 3.6: it is required because Section 2 defines a proper
truncation using pairwise vertex-disjoint attachment paths.  The closed
intervals in `data.pieces` remain positional helpers only; they are not the
Case-A/Case-B semantic carrier. -/
private def sourceLemma36CanonicalPieceVertices [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (i : Fin k) : Set V :=
  sourceLemma36CoreVertices G C hC k Z data i

/-- The one source-relevant chord predicate shared by both cases of Lemma
3.6.  Its root incidence supplies the rootedness witness required by the
proper-truncation conclusion. -/
private def sourceLemma36PieceHasChord [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (i : Fin k) : Prop :=
  ∃ z ∈ Z, z ∈ sourceLemma36CanonicalPieceVertices G C hC k Z data i ∧
    ∃ w ∈ sourceLemma36CanonicalPieceVertices G C hC k Z data i,
      (sourceLemma36OffCycleGraph G C).Adj z w

private theorem sourceLemma36_piece_chord_split [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) :
    (∀ i : Fin k, sourceLemma36PieceHasChord G C hC k Z data i) ∨
      (∃ i : Fin k, ¬ sourceLemma36PieceHasChord G C hC k Z data i) := by
  by_cases hall : ∀ i : Fin k, sourceLemma36PieceHasChord G C hC k Z data i
  · exact Or.inl hall
  · exact Or.inr (by simpa only [not_forall] using hall)

private theorem sourceLemma36_exists_caseB_piece [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z)
    (hcaseB : ¬ ∀ i : Fin k, sourceLemma36PieceHasChord G C hC k Z data i) :
    ∃ iP : Fin k,
      ¬ sourceLemma36PieceHasChord G C hC k Z data iP := by
  simpa only [not_forall] using hcaseB

private theorem sourceLemma36_mem_coreVertices_iff [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (i : Fin k) (v : V) :
    v ∈ sourceLemma36CoreVertices G C hC k Z data i ↔
      ∃ p ∈ data.corePositions i,
        (sourceLemma36RotatedCycleOrder G C data.anchor).get p = v := Iff.rfl

private theorem sourceLemma36_blockRoots_mem_canonicalPiece [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (i : Fin k) {z : V}
    (hz : z ∈ data.blockRoots i) :
    z ∈ sourceLemma36CanonicalPieceVertices G C hC k Z data i := by
  change z ∈ sourceLemma36CoreVertices G C hC k Z data i
  rw [sourceLemma36_mem_coreVertices_iff]
  rw [data.corePositions_def i]
  rw [data.blockRoots_def i] at hz
  rw [data.orderedZ_def] at hz
  exact sourceLemma36_rootBlock_mem_core (G := G) C data.anchor data.Z0
    (sourceLemma36_partitionQuota k) data.quota_pos
    data.canonical_orderedZ_length i hz

/-- Injectivity of the Hamiltonian cycle's allocated positional presentation
transports positional core disjointness to vertices. -/
private theorem sourceLemma36_coreVertices_disjoint [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) {i j : Fin k} (hij : i ≠ j) :
    Disjoint (sourceLemma36CoreVertices G C hC k Z data i)
      (sourceLemma36CoreVertices G C hC k Z data j) := by
  apply Set.disjoint_left.2
  intro v hvi hvj
  obtain ⟨p, hp, hpv⟩ := hvi
  obtain ⟨q, hq, hqv⟩ := hvj
  have hpq : p = q := by
    apply (List.nodup_iff_injective_get.mp (by
      simpa [data.cycleOrder_def] using data.cycleOrder_nodup))
    rw [hpv, hqv]
  exact (Finset.disjoint_left.mp (data.core_disjoint i j hij) hp (hpq ▸ hq))

/-- Positions in different allocated cores occur in the source cycle order.
This is the only ordering fact needed by the chord-only Case-A assembly. -/
private theorem sourceLemma36_corePositions_ordered [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) {i j : Fin k} (hij : i < j)
    {p q : Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length}
    (hp : p ∈ data.corePositions i) (hq : q ∈ data.corePositions j) : p < q := by
  rw [data.corePositions_def i] at hp
  rw [data.corePositions_def j] at hq
  have hnext : i.1 + 1 < k := by
    change i.1 < j.1 at hij
    omega
  let next : Fin k := ⟨i.1 + 1, hnext⟩
  have hpnext : p < sourceLemma36CutPosition G C data.anchor data.Z0
      (sourceLemma36_partitionQuota k) data.quota_pos data.canonical_orderedZ_length next := by
    exact sourceLemma36_core_mem_upper (G := G) C data.anchor data.Z0
      (sourceLemma36_partitionQuota k) data.quota_pos data.canonical_orderedZ_length
      i hnext hp
  have hnextle : next ≤ j := by
    change i.1 + 1 ≤ j.1
    change i.1 < j.1 at hij
    omega
  have hcuts : sourceLemma36CutPosition G C data.anchor data.Z0
      (sourceLemma36_partitionQuota k) data.quota_pos data.canonical_orderedZ_length next ≤
      sourceLemma36CutPosition G C data.anchor data.Z0
        (sourceLemma36_partitionQuota k) data.quota_pos data.canonical_orderedZ_length j := by
    rcases lt_or_eq_of_le hnextle with hlt | rfl
    · exact (sourceLemma36_cutPosition_strict (G := G) C data.anchor data.Z0
        (sourceLemma36_partitionQuota k) data.quota_pos data.canonical_orderedZ_length hlt).le
    · exact le_rfl
  have hqcut : sourceLemma36CutPosition G C data.anchor data.Z0
      (sourceLemma36_partitionQuota k) data.quota_pos data.canonical_orderedZ_length j ≤ q := by
    exact sourceLemma36_core_mem_lower (G := G) C data.anchor data.Z0
      (sourceLemma36_partitionQuota k) data.quota_pos data.canonical_orderedZ_length j hq
  exact hpnext.trans_le (hcuts.trans hqcut)

/-- A half-open allocated core is position-convex, including the terminal core. -/
private theorem sourceLemma36_corePositions_convex [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (i : Fin k)
    {p t q : Fin (sourceLemma36RotatedCycleOrder G C data.anchor).length}
    (hp : p ∈ data.corePositions i) (hq : q ∈ data.corePositions i)
    (hpt : p ≤ t) (htq : t ≤ q) : t ∈ data.corePositions i := by
  rw [data.corePositions_def i] at hp hq ⊢
  unfold sourceLemma36CorePositions at hp hq ⊢
  by_cases hnext : i.1 + 1 < k
  · simp [hnext] at hp hq ⊢
    exact ⟨hp.1.trans hpt, htq.trans_lt hq.2⟩
  · simp [hnext] at hp ⊢
    exact hp.trans hpt

