private theorem sourceLemma36_orderedZ_toFinset [Fintype V] [DecidableEq V]
    (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (a : V) (Z0 : Finset V) :
    (sourceLemma36OrderedZ G C a Z0).toFinset = Z0 := by
  rw [sourceLemma36OrderedZ, List.toFinset_filter,
