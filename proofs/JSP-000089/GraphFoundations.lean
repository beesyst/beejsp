    (orderedEntries : List (Fin k)) (hNodup : orderedEntries.Nodup)
    (hLength : orderedEntries.length = k) :
    Function.Injective (fun i : Fin k =>
      orderedEntries.get (Fin.cast hLength.symm i)) :=
  sourceLemma37_sameSide_entry_injective orderedEntries hNodup hLength

/-- Either physical side of a Lemma-3.8 same-side chord has a position in the
existing common reanchored cycle coordinate. -/
private theorem sourceLemma38_sameSide_common_position
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2))
    (i : Fin k) (x : V)
    (hx : x ∈ (sourceLemma38Qv G C k hk Z data iP matching ladder i).support ∨
      x ∈ (sourceLemma38Qu G C k hk Z data iP matching ladder i).support) :
    ∃ p : Fin (sourceLemma36RotatedCycleOrder G C
      (sourceLemma37SameSideOrderAnchor G C hC k Z data iP)).length,
      (sourceLemma36RotatedCycleOrder G C
        (sourceLemma37SameSideOrderAnchor G C hC k Z data iP)).get p = x := by
  rcases hx with hx | hx
  · have hxOutside := sourceLemma38_mem_Qv_outside_canonical
      G C k hk Z data iP matching ladder i x hx
    obtain ⟨s, hs⟩ := sourceLemma36_complementOrderAt_position
      G C hC k Z data iP hxOutside
    obtain ⟨p, -, hp⟩ := sourceLemma37_complement_position_sameSideOrderAnchor
      G C hC k Z data iP s
    exact ⟨p, hp.trans hs⟩
  · have hxCanonical := sourceLemma38_mem_Qu_canonical
      G C k hk Z data iP matching ladder i x hx
    obtain ⟨s, hsCore, hs⟩ := sourceLemma36_canonicalPiece_position
      G C hC k Z data iP hxCanonical
    obtain ⟨p, hp⟩ := sourceLemma37_canonical_position_sameSideOrderAnchor
      G C hC k Z data iP s hsCore
    exact ⟨p, hp.trans hs⟩

/-- Consecutive Section-2 blocks are separated by a genuine nonempty gap in
the ambient `4k²` ladder indexing. -/
private theorem sourceLemma38_blockLast_lt_blockFirst_of_lt
    (k : ℕ) (hk : 1 ≤ k) {i j : Fin k} (hij : i < j) :
    sourceLemma38BlockLastIndex k hk i <
      sourceLemma38BlockFirstIndex k hk j := by
  apply Fin.mk_lt_mk.mpr
  dsimp [sourceLemma38BlockLastIndex, sourceLemma38BlockFirstIndex]

  have hij' : i.1 + 1 ≤ j.1 := by
    omega

  have hkpos : 0 < k := by
    omega

  have hbasePos : 0 < 4 * (i.1 + 1) * k := by
    positivity

  have hsub :
      4 * (i.1 + 1) * k - 1 <
        4 * (i.1 + 1) * k := by
    exact Nat.sub_lt hbasePos Nat.zero_lt_one

  have hmul :
      4 * (i.1 + 1) * k ≤ 4 * j.1 * k := by
    exact Nat.mul_le_mul_right k
      (Nat.mul_le_mul_left 4 hij')

  exact lt_of_lt_of_le hsub hmul

/-- In the common SameSide coordinate, a point from a higher-index `Qv`
block precedes a point from a lower-index `Qv` block.  This is exactly the
decreasing-block order used by the repaired Lemma-3.8 enumeration. -/
private theorem sourceLemma38_sameSide_qv_common_position_order
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle}
    (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder :
      SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2))
    {i j : Fin k} (hji : j < i) {x y : V}
    {p q : Fin (sourceLemma36RotatedCycleOrder G C
      (sourceLemma37SameSideOrderAnchor G C hC k Z data iP)).length}
    (hxp :
      (sourceLemma36RotatedCycleOrder G C
        (sourceLemma37SameSideOrderAnchor G C hC k Z data iP)).get p = x)
    (hyq :
      (sourceLemma36RotatedCycleOrder G C
        (sourceLemma37SameSideOrderAnchor G C hC k Z data iP)).get q = y)
    (hx :
      x ∈ (sourceLemma38Qv
        G C k hk Z data iP matching ladder i).support)
    (hy :
      y ∈ (sourceLemma38Qv
        G C k hk Z data iP matching ladder j).support) :
    p < q := by
  obtain ⟨s, hsLast, hsFirst, hsget⟩ :=
    (sourceLemma38Qv_support_iff
      G C k hk Z data iP matching ladder i x).mp hx

  obtain ⟨t, htLast, htFirst, htget⟩ :=
    (sourceLemma38Qv_support_iff
      G C k hk Z data iP matching ladder j y).mp hy

  obtain ⟨p', hpval, hpget⟩ :=
    sourceLemma37_complement_position_sameSideOrderAnchor
      G C hC k Z data iP s

  obtain ⟨q', hqval, hqget⟩ :=
    sourceLemma37_complement_position_sameSideOrderAnchor
      G C hC k Z data iP t

  have hpp' : p = p' :=
    List.nodup_iff_injective_get.mp
      (sourceLemma36_rotatedCycleOrder_nodup G C hC
        (sourceLemma37SameSideOrderAnchor G C hC k Z data iP))
      (hxp.trans (hpget.trans hsget).symm)

  have hqq' : q = q' :=
    List.nodup_iff_injective_get.mp
      (sourceLemma36_rotatedCycleOrder_nodup G C hC
        (sourceLemma37SameSideOrderAnchor G C hC k Z data iP))
      (hyq.trans (hqget.trans htget).symm)

  have hblock :
      sourceLemma38BlockLastIndex k hk j <
        sourceLemma38BlockFirstIndex k hk i :=
    sourceLemma38_blockLast_lt_blockFirst_of_lt k hk hji

  have hsecond :
      ladder.secondPosition (sourceLemma38BlockFirstIndex k hk i) <
        ladder.secondPosition (sourceLemma38BlockLastIndex k hk j) :=
    ladder.second_arc_order
      (sourceLemma38BlockLastIndex k hk j)
      (sourceLemma38BlockFirstIndex k hk i)
      hblock

  rw [hpp', hqq']
  apply Fin.mk_lt_mk.mpr
  rw [hpval, hqval]

  exact lt_of_le_of_lt hsFirst
    (lt_of_lt_of_le hsecond htLast)

/-- In the common SameSide coordinate, points from increasing `Qu` blocks
retain increasing cyclic order. -/
private theorem sourceLemma38_sameSide_qu_common_position_order
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle}
    (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder :
      SourceLemma36Section2Ladder G C k Z data iP matching (4 * k^2))
    {i j : Fin k} (hij : i < j) {x y : V}
    {p q : Fin (sourceLemma36RotatedCycleOrder G C
      (sourceLemma37SameSideOrderAnchor G C hC k Z data iP)).length}
    (hxp :
      (sourceLemma36RotatedCycleOrder G C
        (sourceLemma37SameSideOrderAnchor G C hC k Z data iP)).get p = x)
    (hyq :
      (sourceLemma36RotatedCycleOrder G C
        (sourceLemma37SameSideOrderAnchor G C hC k Z data iP)).get q = y)
    (hx :
      x ∈ (sourceLemma38Qu
        G C k hk Z data iP matching ladder i).support)
    (hy :
      y ∈ (sourceLemma38Qu
        G C k hk Z data iP matching ladder j).support) :
    p < q := by
  classical

  obtain ⟨si, hsiFirst, hsiLast, hsiget⟩ :=
    (sourceLemma38Qu_support_iff
      G C k hk Z data iP matching ladder i x).mp hx

  obtain ⟨sj, hsjFirst, hsjLast, hsjget⟩ :=
    (sourceLemma38Qu_support_iff
      G C k hk Z data iP matching ladder j y).mp hy

  have hblock :
      sourceLemma38BlockLastIndex k hk i <
        sourceLemma38BlockFirstIndex k hk j :=
    sourceLemma38_blockLast_lt_blockFirst_of_lt k hk hij

  have hfirstGap :
      ladder.firstPosition (sourceLemma38BlockLastIndex k hk i) <
        ladder.firstPosition (sourceLemma38BlockFirstIndex k hk j) :=
    ladder.first_arc_order
      (sourceLemma38BlockLastIndex k hk i)
      (sourceLemma38BlockFirstIndex k hk j)
      hblock

  have hsij : si.1 < sj.1 := by
    exact lt_of_le_of_lt hsiLast
      (lt_of_lt_of_le hfirstGap hsjFirst)

  have hxCanonical :=
    sourceLemma38_mem_Qu_canonical
      G C k hk Z data iP matching ladder i x hx

  have hyCanonical :=
    sourceLemma38_mem_Qu_canonical
      G C k hk Z data iP matching ladder j y hy

  obtain ⟨ci, hciCore, hciget⟩ :=
    sourceLemma36_canonicalPiece_position
      G C hC k Z data iP hxCanonical

  obtain ⟨cj, hcjCore, hcjget⟩ :=
    sourceLemma36_canonicalPiece_position
      G C hC k Z data iP hyCanonical

  have hci : ci = si := by
    apply List.nodup_iff_injective_get.mp
      (sourceLemma36_rotatedCycleOrder_nodup
        G C hC data.anchor)
    exact hciget.trans hsiget.symm

  have hcj : cj = sj := by
    apply List.nodup_iff_injective_get.mp
      (sourceLemma36_rotatedCycleOrder_nodup
        G C hC data.anchor)
    exact hcjget.trans hsjget.symm

  have hcij : ci < cj := by
    apply Fin.mk_lt_mk.mpr
    rw [hci, hcj]
    exact hsij

  by_cases hnext : iP.1 + 1 < k

  · have hciUpper :
        ci < data.cutPositions ⟨iP.1 + 1, hnext⟩ := by
      rw [data.corePositions_def iP] at hciCore
      have h :=
        sourceLemma36_core_mem_upper
          (G := G) C data.anchor data.Z0
          (sourceLemma36_partitionQuota k)
          data.quota_pos
          data.canonical_orderedZ_length
          iP hnext hciCore
      simpa [data.cutPositions_def] using h

    have hcjUpper :
        cj < data.cutPositions ⟨iP.1 + 1, hnext⟩ := by
      rw [data.corePositions_def iP] at hcjCore
      have h :=
        sourceLemma36_core_mem_upper
          (G := G) C data.anchor data.Z0
          (sourceLemma36_partitionQuota k)
          data.quota_pos
          data.canonical_orderedZ_length
          iP hnext hcjCore
      simpa [data.cutPositions_def] using h

    obtain ⟨p', hpval, hpget⟩ :=
      sourceLemma37_canonical_position_reanchor_after
        G C hC k Z data iP hnext ci hciUpper

    obtain ⟨q', hqval, hqget⟩ :=
      sourceLemma37_canonical_position_reanchor_after
        G C hC k Z data iP hnext cj hcjUpper

    have hpp' : p = p' :=
      List.nodup_iff_injective_get.mp
        (sourceLemma36_rotatedCycleOrder_nodup G C hC
          (sourceLemma37SameSideOrderAnchor
            G C hC k Z data iP))
        (hxp.trans (hpget.trans hciget).symm)

    have hqq' : q = q' :=
      List.nodup_iff_injective_get.mp
        (sourceLemma36_rotatedCycleOrder_nodup G C hC
