      subst z
      exact (sourceLemma32_dropUntil_not_start G hrail hc hca hzR).elim
  refine ⟨hpath, ?_, ?_, ?_, ?_⟩
  · intro z
    simp only [Walk.mem_support_append_iff, Walk.support_reverse, List.mem_reverse]
  · intro z hz hzD
    rw [Walk.mem_support_append_iff, Walk.mem_support_append_iff,
      Walk.support_reverse, List.mem_reverse] at hz
    rcases hz with hzA | hzB | hzR
    · by_cases he : z = a
