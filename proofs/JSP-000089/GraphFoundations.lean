/-- Tie-breaking preserves the source order and gives the non-strict
Erdős--Szekeres alternative for attachment lengths, including repetitions. -/
private theorem sourceLemma39_net_lengths_erdosSzekeres
    {n k : ℕ} (a : Fin n → ℕ) (hk : 2 ≤ k)
    (hn : (k - 1) * (k - 1) < n) :
    (∃ J : Finset (Fin n), J.card = k ∧
      ∀ i ∈ J, ∀ j ∈ J, i < j → a i ≤ a j) ∨
    (∃ J : Finset (Fin n), J.card = k ∧
      ∀ i ∈ J, ∀ j ∈ J, i < j → a j < a i) := by
  classical
  let code (i : Fin n) := a i * (n + 1) + i.val
  have hcode : Function.Injective code := by
    intro i j heq
    have hi : i.val % (n + 1) = i.val := Nat.mod_eq_of_lt (by omega)
    have hj : j.val % (n + 1) = j.val := Nat.mod_eq_of_lt (by omega)
    have hm := congrArg (fun x => x % (n + 1)) heq
    simp [code, Nat.add_mod, Nat.mul_mod, hi, hj] at hm
    exact Fin.ext hm
  let xs := List.ofFn code
  have hxs : xs.Nodup := List.nodup_ofFn.mpr hcode
  have hlen : xs.length = n := List.length_ofFn
  let cast (i : Fin xs.length) : Fin n := Fin.cast hlen i
  have hcast : Function.Injective cast := by
    intro i j h
    apply Fin.ext
    exact congrArg (fun z : Fin n => z.val) h
  have hget (i : Fin xs.length) : xs.get i = code (cast i) := by
    simp only [xs, List.get_eq_getElem, List.getElem_ofFn]
    congr 1
  rcases sourceLemma36_erdosSzekeres_distinct xs hxs k k hk hk (by omega) with
    ⟨J, hJ, hchain⟩ | ⟨J, hJ, hchain⟩
  · refine Or.inl ⟨J.image cast, (Finset.card_image_of_injective J hcast).trans hJ, ?_⟩
    intro i hi j hj hij
    obtain ⟨i', hi', rfl⟩ := Finset.mem_image.mp hi
    obtain ⟨j', hj', rfl⟩ := Finset.mem_image.mp hj
    have hlt : i' < j' := by
      change i'.val < j'.val
      exact hij
    have hval := hchain hi' hj' hlt
    rw [hget, hget] at hval
    change a (cast i') ≤ a (cast j')
    apply Nat.le_of_not_lt
    intro h
    have hgap : a (cast j') + 1 ≤ a (cast i') := by omega
    have hm := Nat.mul_le_mul_right (n + 1) hgap
    have hiBound := (cast i').isLt
    have hjBound := (cast j').isLt
    dsimp [code] at hval
    nlinarith
  · refine Or.inr ⟨J.image cast, (Finset.card_image_of_injective J hcast).trans hJ, ?_⟩
    intro i hi j hj hij
    obtain ⟨i', hi', rfl⟩ := Finset.mem_image.mp hi
    obtain ⟨j', hj', rfl⟩ := Finset.mem_image.mp hj
    have hlt : i' < j' := by
      change i'.val < j'.val
      exact hij
    have hval := hchain hi' hj' hlt
    rw [hget, hget] at hval
    change a (cast j') < a (cast i')
    apply Nat.lt_of_not_ge
    intro h
    have hle : a (cast i') ≤ a (cast j') := by omega
    have hm := Nat.mul_le_mul_right (n + 1) hle
    have hvlt : (cast i').val < (cast j').val := hij
    dsimp [code] at hval
    omega

/-- The common interior candidates of the reduced net already exceed the
Erdős--Szekeres threshold. This proves the numerical route-length conclusion;
cycle realizations remain a separate geometric obligation. -/
theorem sourceLemma39_reduced_net_route_length_cardinality
    {k : ℕ} (hk : 2 ≤ k) (a b : Fin (k^2 - 1) → ℕ)
    (hb : StrictMono b) (L s t : ℕ) (hL : ∀ i, b i ≤ L) :
    k ≤ ((Finset.univ.image fun i => b i + a i + t).card) ∨
      k ≤ ((Finset.univ.image fun i => s + a i + (L - b i)).card) := by
  classical
  have hn : (k - 1) * (k - 1) < k^2 - 1 := by
    have hk1 : 1 ≤ k := by omega
    have hsq : 1 ≤ k^2 := by nlinarith
    have heq : k^2 - 1 + 1 = k^2 := Nat.sub_add_cancel hsq
    have hkEq : k - 1 + 1 = k := Nat.sub_add_cancel hk1
    nlinarith
  rcases sourceLemma39_net_lengths_erdosSzekeres a hk hn with
    ⟨J, hJ, hinc⟩ | ⟨J, hJ, hdec⟩
  · left
    have hinj : Set.InjOn (fun i => b i + a i + t) (↑J : Set (Fin (k^2 - 1))) := by
      intro i hi j hj heq
      dsimp only at heq
      rcases lt_trichotomy i j with hij | he | hij
      · have hbi := hb hij
        have hai := hinc i hi j hj hij
        omega
      · exact he
      · have hbi := hb hij
        have hai := hinc j hj i hi hij
        omega
    have hcard : (J.image fun i => b i + a i + t).card = k :=
      (Finset.card_image_iff.mpr hinj).trans hJ
    have hle : (J.image fun i => b i + a i + t).card ≤
        (Finset.univ.image fun i => b i + a i + t).card :=
      Finset.card_le_card (Finset.image_subset_image (Finset.subset_univ J))
    exact le_trans (le_of_eq hcard.symm) hle
  · right
    have hinj : Set.InjOn (fun i => s + a i + (L - b i)) (↑J : Set (Fin (k^2 - 1))) := by
      intro i hi j hj heq
      dsimp only at heq
      rcases lt_trichotomy i j with hij | he | hij
      · have hbi := hb hij
        have hai := hdec i hi j hj hij
        have hiL := hL i
        have hjL := hL j
        omega
      · exact he
      · have hbi := hb hij
        have hai := hdec j hj i hi hij
        have hiL := hL i
        have hjL := hL j
        omega
    have hcard : (J.image fun i => s + a i + (L - b i)).card = k :=
      (Finset.card_image_iff.mpr hinj).trans hJ
    have hle : (J.image fun i => s + a i + (L - b i)).card ≤
        (Finset.univ.image fun i => s + a i + (L - b i)).card :=
      Finset.card_le_card (Finset.image_subset_image (Finset.subset_univ J))
    exact le_trans (le_of_eq hcard.symm) hle

/-- The single-element spectrum conclusion needs only the genuine ambient
boundary cycle. It does not impose k ≥ 2 on the direct-net outcome. -/
theorem sourceLemma39_direct_net_cycle_spectrum_one
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r}
    (shadow : SourceLemma39BranchIIShadowApplication G C 1)
    (T : Finset (sourceLemma39CycleVertices G C))
    (u w v x y : sourceLemma39CycleVertices G C)
