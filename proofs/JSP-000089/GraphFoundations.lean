    rw [← sourceOrientedCycleSubpath_support_congr G C
      (hC.mem_support ((sourceLemma36ComplementOrderAt G C hC k Z data iP).get (ladder.secondPosition j)))
      (hC.mem_support ((sourceLemma36ComplementOrderAt G C hC k Z data iP).get (ladder.secondPosition i)))
