      · simp [Walk.transfer, Walk.dropUntil, hstart]
        exact ih (fun edge hedge => hp edge (by simp [hedge]))
          (by simpa [Walk.support_cons, hstart, eq_comm] using hx)

/-- Rotating a transferred closed walk is the transfer of the original
