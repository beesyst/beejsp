    {r x y w u v : V} (C : G.Walk r r) (hC : C.IsHamiltonianCycle)
    (k : ℕ) (Z : Finset V) (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (P : G.Path x y)
    (hPpiece : ∀ z, z ∈ (P : G.Walk x y).support → z ∈
      sourceLemma36CanonicalPieceVertices G C hC k Z data iP)
    (hu : u ∉ sourceLemma36CanonicalPieceVertices G C hC k Z data iP)
    (hv : v ∉ sourceLemma36CanonicalPieceVertices G C hC k Z data iP)
    (huw : u ≠ w) (hvw : v ≠ w)
