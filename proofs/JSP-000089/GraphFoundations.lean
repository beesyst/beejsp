/-- Complementary arcs of a genuine cycle meet only at their two ends. -/
theorem sourceLemma39_net_cycle_arc_intersection
    {x y : V} (I : G.Walk x y) (S : G.Walk y x)
    (hD : (I.append S).IsCycle) :
    ∀ z, z ∈ I.support → z ∈ S.support → z = x ∨ z = y := by
  have hn := hD.support_nodup
  rw [Walk.support_append, I.support_eq_cons, List.cons_append, List.tail_cons] at hn
  have hdis := List.disjoint_of_nodup_append hn
  intro z hzI hzS
  by_cases hzx : z = x
  · exact Or.inl hzx
  by_cases hzy : z = y
  · exact Or.inr hzy
  have hzIt := I.mem_support_iff.mp hzI |>.resolve_left hzx
  have hzSt := S.mem_support_iff.mp hzS |>.resolve_left hzy
  exact (hdis hzIt hzSt).elim

/-- Four ordered internal endpoints split the ambient boundary cycle into its
 two rails and two complementary connectors. The second connector retains
 the original closing arc; it never intersects either rail internally. -/
theorem sourceLemma39_net_ambient_rail_decomposition
    [DecidableEq V] {x y a b c d : V} (I : G.Walk x y) (S : G.Walk y x)
    (hI : I.IsPath) (hD : (I.append S).IsCycle)
    (ha : a ∈ I.support) (hb : b ∈ I.support) (hc : c ∈ I.support) (hd : d ∈ I.support)
    (hxa : I.support.idxOf x < I.support.idxOf a)
    (hab : I.support.idxOf a < I.support.idxOf b)
    (hbc : I.support.idxOf b < I.support.idxOf c)
    (hcd : I.support.idxOf c < I.support.idxOf d)
    (hdy : I.support.idxOf d < I.support.idxOf y) :
    ∃ (L : G.Walk a b) (R : G.Walk c d) (K₁ : G.Walk b c) (K₂ : G.Walk d a),
      L.IsPath ∧ R.IsPath ∧ K₁.IsPath ∧ K₂.IsPath ∧
      (∀ z, z ∈ L.support ↔ z ∈ I.support ∧
        I.support.idxOf a ≤ I.support.idxOf z ∧ I.support.idxOf z ≤ I.support.idxOf b) ∧
      (∀ z, z ∈ R.support ↔ z ∈ I.support ∧
        I.support.idxOf c ≤ I.support.idxOf z ∧ I.support.idxOf z ≤ I.support.idxOf d) ∧
      (∀ z, z ∈ L.support → L.support.idxOf z = I.support.idxOf z - I.support.idxOf a) ∧
      (∀ z, z ∈ R.support → R.support.idxOf z = I.support.idxOf z - I.support.idxOf c) ∧
      (∀ z, z ∈ K₁.support → z ∈ (I.append S).support) ∧
      (∀ z, z ∈ K₂.support → z ∈ (I.append S).support) ∧
      Disjoint {z | z ∈ L.support} {z | z ∈ R.support} ∧
      (∀ z, z ∈ L.support → z ∈ K₁.support → z = b) ∧
      (∀ z, z ∈ L.support → z ∈ K₂.support → z = a) ∧
      (∀ z, z ∈ K₁.support → z ∈ R.support → z = c) ∧
      Disjoint {z | z ∈ K₁.support} {z | z ∈ K₂.support} ∧
      (∀ z, z ∈ R.support → z ∈ K₂.support → z = d) := by
  obtain ⟨L, hL, hLm, hLi⟩ := sourceLemma39_net_rail_segment G I hI ha hb hab.le
  obtain ⟨R, hR, hRm, hRi⟩ := sourceLemma39_net_rail_segment G I hI hc hd hcd.le
  obtain ⟨K₁, hK₁, hK₁m, _⟩ := sourceLemma39_net_rail_segment G I hI hb hc hbc.le
  let U := I.dropUntil d hd
  let P := I.takeUntil a ha
  let K₂ := U.append (S.append P)
  have hxI := I.start_mem_support
  have hyI := I.end_mem_support
  have hdx : d ≠ x := by intro he; subst d; omega
  have hay : a ≠ y := by intro he; subst a; omega
  have hxy : x ≠ y := by intro he; subst y; omega
  have hS : S.IsPath := hD.isPath_of_append_right (Walk.not_nil_of_ne hxy)
  have hIS := sourceLemma39_net_cycle_arc_intersection G I S hD
  have hSP : (S.append P).IsPath := by
    apply sourceLemma39_splice_paths G _ _ hS (hI.takeUntil ha)
    intro z hzS hzP
    rcases hIS z (I.support_takeUntil_subset ha hzP) hzS with he | he
    · exact he
    · subst z
      exact (sourceLemma32_takeUntil_not_end G hI ha hay hzP).elim
  have hK₂ : K₂.IsPath := by
    apply sourceLemma39_splice_paths G _ _ (hI.dropUntil hd) hSP
    intro z hzU hz
    rw [Walk.mem_support_append_iff] at hz
    rcases hz with hzS | hzP
    · rcases hIS z (I.support_dropUntil_subset hd hzU) hzS with he | he
      · subst z
        exact (sourceLemma32_dropUntil_not_start G hI hd hdx hzU).elim
      · exact he
    · have hu := (sourceLemma39_net_suffix_mem_iff G I hI hd).mp hzU
      have hp := (sourceLemma39_net_prefix_mem_iff G I hI ha).mp hzP
      omega
  have noS (z : V) (hzI : z ∈ I.support)
      (hlow : I.support.idxOf a ≤ I.support.idxOf z)
      (hupp : I.support.idxOf z ≤ I.support.idxOf d) : z ∉ S.support := by
    intro hzS
    rcases hIS z hzI hzS with he | he <;> subst z <;> omega
  have hIinD (z : V) (hz : z ∈ I.support) : z ∈ (I.append S).support :=
    Walk.mem_support_append_iff _ _ |>.mpr (Or.inl hz)
  have hK₂cases (z : V) (hz : z ∈ K₂.support) : z ∈ U.support ∨ z ∈ S.support ∨ z ∈ P.support := by
    exact (Walk.mem_support_append_iff _ _).mp hz |>.elim Or.inl
      (fun h => Or.inr ((Walk.mem_support_append_iff _ _).mp h))
  have endEq (z t : V) (hz : z ∈ I.support) (ht : t ∈ I.support)
      (he : I.support.idxOf z = I.support.idxOf t) : z = t := (List.idxOf_inj hz ht).mp he
  refine ⟨L, R, K₁, K₂, hL, hR, hK₁, hK₂, hLm, hRm, hLi, hRi, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro z hz
    exact hIinD z ((hK₁m z).mp hz).1
  · intro z hz
    rcases hK₂cases z hz with hzU | hzS | hzP
    · exact hIinD z (I.support_dropUntil_subset hd hzU)
    · exact (Walk.mem_support_append_iff _ _).mpr (Or.inr hzS)
    · exact hIinD z (I.support_takeUntil_subset ha hzP)
  · apply Set.disjoint_left.mpr
    intro z hzL hzR
    have hl := (hLm z).mp hzL
    have hr := (hRm z).mp hzR
    omega
  · intro z hzL hzK
    have hl := (hLm z).mp hzL
    have hk := (hK₁m z).mp hzK
    exact endEq z b hl.1 hb (by omega)
  · intro z hzL hzK
    have hl := (hLm z).mp hzL
    rcases hK₂cases z hzK with hzU | hzS | hzP
    · have hu := (sourceLemma39_net_suffix_mem_iff G I hI hd).mp hzU
      omega
    · exact (noS z hl.1 hl.2.1 (by omega) hzS).elim
    · have hp := (sourceLemma39_net_prefix_mem_iff G I hI ha).mp hzP
      exact endEq z a hl.1 ha (by omega)
  · intro z hzK hzR
    have hk := (hK₁m z).mp hzK
    have hr := (hRm z).mp hzR
    exact endEq z c hk.1 hc (by omega)
  · apply Set.disjoint_left.mpr
    intro z hzK₁ hzK₂
    have hk := (hK₁m z).mp hzK₁
    rcases hK₂cases z hzK₂ with hzU | hzS | hzP
    · have hu := (sourceLemma39_net_suffix_mem_iff G I hI hd).mp hzU
      omega
    · exact noS z hk.1 (by omega) (by omega) hzS
    · have hp := (sourceLemma39_net_prefix_mem_iff G I hI ha).mp hzP
      omega
  · intro z hzR hzK
    have hr := (hRm z).mp hzR
    rcases hK₂cases z hzK with hzU | hzS | hzP
    · have hu := (sourceLemma39_net_suffix_mem_iff G I hI hd).mp hzU
      exact endEq z d hr.1 hd (by omega)
    · exact (noS z hr.1 (by omega) hr.2.2 hzS).elim
    · have hp := (sourceLemma39_net_prefix_mem_iff G I hI ha).mp hzP
      omega

/-- Complete source spectrum argument for the ambient reduced net, using
only its genuine ordered cycle rails and disjoint attachment carriers. -/
theorem sourceLemma39_net_ordered_ambient_spectrum
    [DecidableEq V] {x y u v : V} {k : ℕ} (hk : 2 ≤ k)
    (I : G.Walk x y) (S : G.Walk y x) (hI : I.IsPath) (hD : (I.append S).IsCycle)
    (p q : Fin (k^2 - 1 + 2) → V)
    (left : ∀ i, G.Walk (p i) u) (right : ∀ i, G.Walk (q i) v)
    (hp : ∀ i, p i ∈ I.support) (hq : ∀ i, q i ∈ I.support)
    (hlorder : StrictMono (fun i => I.support.idxOf (p i)))
    (hrorder : StrictMono (fun i => I.support.idxOf (q i)))
    (hsep : ∀ i j, I.support.idxOf (p i) < I.support.idxOf (q j))
    (hstart : I.support.idxOf x < I.support.idxOf (p 0))
    (hend : I.support.idxOf (q (Fin.last (k^2 - 1 + 1))) < I.support.idxOf y)
    (hu : u ∉ (I.append S).support) (hv : v ∉ (I.append S).support)
    (hlpath : ∀ i, (left i).IsPath) (hrpath : ∀ i, (right i).IsPath)
    (hlout : ∀ i, Disjoint (internalVertices G (left i)) {z | z ∈ (I.append S).support})
    (hrout : ∀ i, Disjoint (internalVertices G (right i)) {z | z ∈ (I.append S).support})
    (hldis : ∀ i j, i ≠ j → Disjoint (internalVertices G (left i)) (internalVertices G (left j)))
    (hrdis : ∀ i j, i ≠ j → Disjoint (internalVertices G (right i)) (internalVertices G (right j)))
    (hcross : ∀ i j, Disjoint {z | z ∈ (left i).support} {z | z ∈ (right j).support}) :
    ∃ A B : Finset ℕ, k ≤ A.card ∧ k ≤ B.card ∧
      (∀ a ∈ A, 0 < a) ∧ (∀ b ∈ B, 0 < b) ∧
      ∀ a ∈ A, ∀ b ∈ B, IsCycleLength G (a + b) := by
  classical
  let n := k^2 - 1
  let last : Fin (n + 2) := Fin.last (n + 1)
  have hzero : (0 : Fin (n + 2)) < last := by change 0 < n + 1; omega
  obtain ⟨L, R, K₁, K₂, hL, hR, hK₁, hK₂, hLm, hRm, hLi, hRi,
      hK₁sub, hK₂sub, hLR, hLK₁, hLK₂, hK₁R, hKK, hRK₂⟩ :=
    sourceLemma39_net_ambient_rail_decomposition G I S hI hD (hp 0) (hp last) (hq 0) (hq last)
      hstart (hlorder hzero) (hsep last 0) (hrorder hzero) hend
  have hIinD (z : V) (hz : z ∈ I.support) : z ∈ (I.append S).support :=
    (Walk.mem_support_append_iff _ _).mpr (Or.inl hz)
  have hpL (i : Fin (n + 2)) : p i ∈ L.support := by
    apply (hLm _).mpr
    exact ⟨hp i, hlorder.monotone (Fin.zero_le i), hlorder.monotone (Fin.le_last i)⟩
  have hqR (i : Fin (n + 2)) : q i ∈ R.support := by
    apply (hRm _).mpr
    exact ⟨hq i, hrorder.monotone (Fin.zero_le i), hrorder.monotone (Fin.le_last i)⟩
  have hLsub (z : V) (hz : z ∈ L.support) : z ∈ (I.append S).support := hIinD z ((hLm z).mp hz).1
  have hRsub (z : V) (hz : z ∈ R.support) : z ∈ (I.append S).support := hIinD z ((hRm z).mp hz).1
  have hlord : StrictMono (fun i => L.support.idxOf (p i)) := by
    intro i j hij
    dsimp only
    rw [hLi _ (hpL i), hLi _ (hpL j)]
    have hlo := hlorder.monotone (Fin.zero_le i)
    have hlt := hlorder hij
    dsimp only at hlo hlt
    omega
  have hrord : StrictMono (fun i => R.support.idxOf (q i)) := by
    intro i j hij
    dsimp only
    rw [hRi _ (hqR i), hRi _ (hqR j)]
    have hlo := hrorder.monotone (Fin.zero_le i)
    have hlt := hrorder hij
    dsimp only at hlo hlt
    omega
  obtain ⟨lroute, hlroute, hlD, hlcarrier, hll₁, hll₂, hbl, hLl, hposl⟩ :=
    sourceLemma39_net_route_family G (I.append S) p L left hL hLsub hpL hlord hu hlpath hlout hldis
  obtain ⟨rroute, hrroute, hrD, hrcarrier, hrl₁, hrl₂, hbr, hLr, hposr⟩ :=
    sourceLemma39_net_route_family G (I.append S) q R right hR hRsub hqR hrord hv hrpath hrout hrdis
  have hcycles := sourceLemma39_net_routes_ambient_realization G (I.append S) L R K₁ K₂
    p q left right lroute rroute hlroute (fun f j => (hrroute f j).1)
    hlD hrD hlcarrier hrcarrier hLsub hRsub hK₁sub hK₂sub hK₁ hK₂
    hcross hLR hLK₁ hLK₂ hK₁R hKK hRK₂
  let mid : Fin n → Fin (n + 2) := fun i => ⟨i.val + 1, by omega⟩
  apply sourceLemma39_net_spectrum_of_four_route_families G hk
    (fun i => (left (mid i)).length) (fun i => L.support.idxOf (p (mid i)))
    (fun i => (right (mid i)).length) (fun i => R.support.idxOf (q (mid i))) hbl hbr
    L.length (left 0).length (left last).length R.length (right 0).length (right last).length
    K₁.length K₂.length hLl hLr hposl hposr
  intro e f i j
  have hc := hcycles e f i j
  cases e <;> cases f <;> simpa only [hll₁, hll₂, hrl₁, hrl₂, Bool.false_eq_true, if_false, if_true] using hc

/-- The direct shadow net yields the complete ambient A+B cycle spectrum for
all k ≥ 1. This is a spectrum alternative, not an ambient k²-net certificate. -/
theorem sourceLemma39_direct_net_cycle_spectrum_complete
    [Fintype V] [DecidableEq V] {r : V} {C : G.Walk r r} {k : ℕ}
    (shadow : SourceLemma39BranchIIShadowApplication G C k) (hk : 1 ≤ k)
    (T : Finset (sourceLemma39CycleVertices G C))
    (u w v x y : sourceLemma39CycleVertices G C)
    (net : SourceLemma36KSquaredNet shadow.graph shadow.cycle k
      (Finset.univ.image shadow.family.root) T u w v x y) :
    ∃ A B : Finset ℕ, k ≤ A.card ∧ k ≤ B.card ∧
      (∀ a ∈ A, 0 < a) ∧ (∀ b ∈ B, 0 < b) ∧
      ∀ a ∈ A, ∀ b ∈ B, IsCycleLength G (a + b) := by
  classical
  by_cases hk2 : 2 ≤ k
  · obtain ⟨I, P, R, left, right, hsize, hD, hI, hIs, _, hu, hv,
        _, hpaths, hldis, hrdis, hcross, hlo, hro, hsep⟩ :=
      sourceLemma39_direct_net_reduced_ambient G shadow hk T u w v x y net
    obtain ⟨lp, rp, hlp, hrp, hlget, hrget, _, exclusions⟩ :=
      sourceLemma39_direct_net_ordered_selection G shadow T u w v x y net
    let sel : Fin (k^2 + 1) → Fin (k^2 + 2) := fun i => ⟨i.val + 1, by omega⟩
    let f : Fin (k^2 - 1 + 2) → Fin (k^2 + 1) := Fin.cast hsize
    let p (i : Fin (k^2 - 1 + 2)) : V := (net.leftVertex (sel (f i))).val
    let q (i : Fin (k^2 - 1 + 2)) : V := (net.rightVertex (sel (f i.rev))).val
    let S := R.append P.reverse
    let D := I.append S
    have hp (i) : p i ∈ I.support := by
      rw [hIs, List.mem_map]
      exact ⟨_, (hlget _) ▸ List.get_mem _ (lp (sel (f i))), rfl⟩
    have hq (i) : q i ∈ I.support := by
      rw [hIs, List.mem_map]
      exact ⟨_, (hrget _) ▸ List.get_mem _ (rp (sel (f i.rev))), rfl⟩
    have idxp (i) : I.support.idxOf (p i) = D.support.idxOf (p i) := by
      dsimp [D]
      rw [Walk.support_append, List.idxOf_append_of_mem (hp i)]
    have idxq (i) : I.support.idxOf (q i) = D.support.idxOf (q i) := by
      dsimp [D]
      rw [Walk.support_append, List.idxOf_append_of_mem (hq i)]
    have hlorder : StrictMono (fun i => I.support.idxOf (p i)) := by
      intro i j hij
      change I.support.idxOf (p i) < I.support.idxOf (p j)
      rw [idxp, idxp]
      exact hlo (f i) (f j) hij
    have hrorder : StrictMono (fun i => I.support.idxOf (q i)) := by
      intro i j hij
      change I.support.idxOf (q i) < I.support.idxOf (q j)
      rw [idxq, idxq]
      apply hro (f j.rev) (f i.rev)
      exact Fin.rev_lt_rev.mpr hij
    have hsep' (i j) : I.support.idxOf (p i) < I.support.idxOf (q j) := by
      rw [idxp, idxq]
      exact hsep (f i) (f j.rev)
    have hpne : p 0 ≠ x.val := by
      intro he
      exact (exclusions (f 0)).1 (Subtype.val_injective he)
    have hqne : q (Fin.last (k^2 - 1 + 1)) ≠ y.val := by
      intro he
      exact (exclusions (f (Fin.last (k^2 - 1 + 1)).rev)).2.2.2 (Subtype.val_injective he)
    have hstart : I.support.idxOf x.val < I.support.idxOf (p 0) := by
      have hxidx : I.support.idxOf x.val = 0 := by
        rw [I.support_eq_cons, List.idxOf_cons_self]
      have hne : I.support.idxOf (p 0) ≠ I.support.idxOf x.val := by
        intro he
        exact hpne ((List.idxOf_inj (hp 0) I.start_mem_support).mp he)
      omega
    have hend : I.support.idxOf (q (Fin.last (k^2 - 1 + 1))) < I.support.idxOf y.val := by
      have hyidx := sourceLemma36_idxOf_terminal I.support y.val hI.support_nodup
        (Walk.support_ne_nil I) I.getLast_support
      have hbound := List.idxOf_lt_length_iff.mpr (hq (Fin.last (k^2 - 1 + 1)))
      have hne : I.support.idxOf (q (Fin.last (k^2 - 1 + 1))) ≠ I.support.idxOf y.val := by
        intro he
        exact hqne ((List.idxOf_inj (hq _) I.end_mem_support).mp he)
      omega
    exact sourceLemma39_net_ordered_ambient_spectrum G hk2 I S hI hD p q
      (fun i => left (f i)) (fun i => right (f i.rev)) hp hq hlorder hrorder hsep' hstart hend hu hv
      (fun i => (hpaths (f i)).1) (fun i => (hpaths (f i.rev)).2.1)
      (fun i => (hpaths (f i)).2.2.1) (fun i => (hpaths (f i.rev)).2.2.2)
      (fun i j hij => hldis _ _ (fun he => hij (Fin.cast_injective _ he)))
      (fun i j hij => hrdis _ _ (fun he => hij (Fin.rev_injective (Fin.cast_injective _ he))))
      (fun i j => hcross (f i) (f j.rev))
  · have he : k = 1 := by omega
    subst k
    exact sourceLemma39_direct_net_cycle_spectrum_one G shadow T u w v x y net

/-- Directed arcs on a genuine ambient cycle follow its root-cut indices,
including the wrapping arc through the root. -/
theorem sourceLemma39_cycle_oriented_index
    [Fintype V] [DecidableEq V] {r a b z : V} (D : G.Walk r r) (hD : D.IsCycle)
    (ha : a ∈ D.support) (hb : b ∈ D.support) (hz : z ∈ D.support) :
