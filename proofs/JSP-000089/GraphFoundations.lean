    have hfstNeFst : f.fst ≠ e.fst := by
      intro hEq
      apply hcase.2
      rw [hEq]
      exact (sourceLemma34_orientedSide G C hC e dir).path.start_mem_support
    have hfstNeSnd : f.fst ≠ e.snd := by
      intro hEq
      apply hcase.2
      rw [hEq]
      exact (sourceLemma34_orientedSide G C hC e dir).path.end_mem_support
