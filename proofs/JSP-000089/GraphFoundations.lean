    {vFirst vLast uFirst uLast : V}
    (inside : G.Walk vLast vFirst) (outside : G.Walk uFirst uLast)
    (firstBoundary : G.Adj vFirst uFirst) (lastBoundary : G.Adj uLast vLast) :
    G.Walk uLast uLast :=
  Walk.cons lastBoundary (inside.append (Walk.cons firstBoundary outside))

/-- Once the two retained cycle subpaths are shown to concatenate simply and
the final boundary edge is absent from that spine, the exact boundary-cycle
expression is a genuine simple cycle. -/
private theorem sourceLemma36_boundaryCycle_isCycle [DecidableEq V]
    {vFirst vLast uFirst uLast : V}
    (inside : G.Walk vLast vFirst) (outside : G.Walk uFirst uLast)
    (firstBoundary : G.Adj vFirst uFirst) (lastBoundary : G.Adj uLast vLast)
    (hspine : (inside.append (Walk.cons firstBoundary outside)).IsPath)
    (hlast : s(uLast, vLast) ∉ (inside.append (Walk.cons firstBoundary outside)).edges) :
    (sourceLemma36BoundaryCycle G inside outside firstBoundary lastBoundary).IsCycle := by
  exact Path.cons_isCycle
    ⟨inside.append (Walk.cons firstBoundary outside), hspine⟩ lastBoundary hlast

/-- Both retained outer matching edges occur on the concrete source cycle
