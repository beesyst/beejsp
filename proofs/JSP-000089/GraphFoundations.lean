    (hinside : ∀ x, x ∈ family.vertices (sourceLemma38CentralOwner k hk sectionOwner i) →
      x ∈ (sourceLemma38Qu G C k hk Z data iP matching ladder i).support ∨
        x ∈ (sourceLemma38Qv G C k hk Z data iP matching ladder i).support) :
