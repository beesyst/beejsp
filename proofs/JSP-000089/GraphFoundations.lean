  rw [← P.cons_tail_eq hPnon, Walk.cons_append]
  exact (Walk.cons_isCycle_iff _ _).mpr ⟨hT, hfirstNotT⟩

/-- Replacing a directed arc of a longest cycle by a simple path through an
outside component cannot increase its length. The bound is non-strict:
equality gives another longest cycle, not a contradiction. -/
private theorem sourceLemma33_longest_cycle_replacement_bound [DecidableEq V]
    {r a b : V} (C : G.Walk r r) (hLongest : SourceLongestCycle G C)
    {K : Set V} (hK : SourceLemma33ComponentData G C K)
    (ha : a ∈ C.support) (hb : b ∈ C.support) (hab : a ≠ b)
    (P : G.Walk a b) (hP : P.IsPath) (hPK : internalVertices G P ⊆ K) :
    P.length ≤ (sourceOrientedCycleSubpath G C ha hb).length := by
  have hbR : b ∈ (C.rotate ha).support := by
    rw [← C.take_spec ha, Walk.mem_support_append_iff] at hb
    dsimp [Walk.rotate]
    rw [Walk.mem_support_append_iff]
    exact hb.symm
  let A := sourceOrientedCycleSubpath G C ha hb
  let S := (C.rotate ha).dropUntil b hbR
  have hdecomp : A.append S = C.rotate ha := by
    dsimp [A, S, sourceOrientedCycleSubpath]
    exact (C.rotate ha).take_spec hbR
  have hrotLength : (C.rotate ha).length = C.length := by
    rw [Walk.rotate, Walk.length_append, Nat.add_comm, ← Walk.length_append, C.take_spec ha]
  have hsum : A.length + S.length = C.length := by
    rw [← Walk.length_append, hdecomp, hrotLength]
  have hApos : 0 < A.length := by
    rw [← Walk.not_nil_iff_lt_length]
    exact Walk.not_nil_of_ne hab
  by_cases hshort : P.length ≤ 1
  · change P.length ≤ A.length
    omega
  have hS : S.IsPath := by
    apply Walk.IsCycle.isPath_of_append_right (p := A) (q := S) (Walk.not_nil_of_ne hab)
    rw [hdecomp]
    exact hLongest.1.rotate ha
  have hSC : ∀ w, w ∈ S.support → w ∈ C.support := by
    intro w hw
    have hwR := (C.rotate ha).support_dropUntil_subset hbR hw
    dsimp [Walk.rotate] at hwR
    rw [Walk.mem_support_append_iff] at hwR
    exact hwR.elim (fun h => C.support_dropUntil_subset ha h)
      (fun h => C.support_takeUntil_subset ha h)
  have hcycle := sourceLemma33_outside_path_closes_cycle G C hK P S hP hS
    (by omega) hPK hSC
  have hmax := hLongest.2 (P.append S) hcycle
  rw [Walk.length_append] at hmax
  change P.length ≤ A.length
  omega

/-- The maximality bound holds for both directions of the original cycle.
This does not supply either of the unequal-length witnesses required by the
ordered-pair good-path predicate. -/
private theorem sourceLemma33_longest_cycle_replacement_bounds [DecidableEq V]
    {r a b : V} (C : G.Walk r r) (hLongest : SourceLongestCycle G C)
    {K : Set V} (hK : SourceLemma33ComponentData G C K)
    (ha : a ∈ C.support) (hb : b ∈ C.support) (hab : a ≠ b)
    (P : G.Walk a b) (hP : P.IsPath) (hPK : internalVertices G P ⊆ K) :
    P.length ≤ (sourceOrientedCycleSubpath G C ha hb).length ∧
      P.length ≤ (sourceOrientedCycleSubpath G C hb ha).length := by
  refine ⟨sourceLemma33_longest_cycle_replacement_bound G C hLongest hK
    ha hb hab P hP hPK, ?_⟩
  have hreverse : internalVertices G P.reverse ⊆ K := by
    intro w hw
    have hwP : w ∈ P.support := by simpa using hw.1
    exact hPK ⟨hwP, hw.2.2, hw.2.1⟩
  simpa using sourceLemma33_longest_cycle_replacement_bound G C hLongest hK
    hb ha hab.symm P.reverse hP.reverse hreverse

/-- The vertices of the graph obtained by deleting every vertex of the source
cycle, rather than merely deleting its cycle edges. -/
private def sourceLemma31OutsideVertices {r : V} (G : SimpleGraph V) (C : G.Walk r r) : Set V :=
  {v | v ∉ C.support}

/-- The canonical outside graph `G - V(C)` used throughout source Lemma 3.1. -/
private def sourceLemma31OutsideGraph {r : V} (G : SimpleGraph V) (C : G.Walk r r) :
    SimpleGraph {v : V // v ∈ sourceLemma31OutsideVertices G C} :=
  G.induce (sourceLemma31OutsideVertices G C)

/-- An outside component is adjacent to a cycle vertex when one of its
outside vertices is ambient-adjacent to that cycle vertex. -/
private def sourceLemma31ComponentAdjacent [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (A : (sourceLemma31OutsideGraph G C).ConnectedComponent) (v : V) : Prop :=
  ∃ x : {v : V // v ∈ sourceLemma31OutsideVertices G C},
    x ∈ A.supp ∧ G.Adj x.1 v

/-- The number of outside components adjacent to a specified cycle vertex. -/
private noncomputable def sourceLemma31ComponentNeighborCount [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) (v : V) : ℕ := by
  classical
  letI : Fintype (sourceLemma31OutsideGraph G C).ConnectedComponent := Fintype.ofFinite _
  exact (Finset.univ.filter (fun A => sourceLemma31ComponentAdjacent G C A v)).card

/-- The source's successor is the second vertex of the cycle after rotating it
to begin at the chosen cycle vertex. -/
private noncomputable def sourceLemma31CycleSucc [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (v : V) (hv : v ∈ C.support) : V :=
  (C.rotate hv).snd

/-- The successor selected from a rotated source cycle remains a source-cycle vertex. -/
private theorem sourceLemma31CycleSucc_mem [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (hC : C.IsCycle)
    (v : V) (hv : v ∈ C.support) :
    sourceLemma31CycleSucc G C v hv ∈ C.support := by
  have hrot : (C.rotate hv).IsCycle := hC.rotate hv
  have hsndTail : (C.rotate hv).snd ∈ (C.rotate hv).support.tail := by
    cases hrotate : C.rotate hv with
    | nil =>
      exact False.elim (hrot.isCircuit.ne_nil (by simpa [hrotate]))
    | cons h p => simp [hrotate]
  have hsndCTail : (C.rotate hv).snd ∈ C.support.tail :=
    (Walk.support_rotate C hv).mem_iff.mp hsndTail
  exact List.mem_of_mem_tail hsndCTail

/-- The first dart of the rotated cycle gives the required successor edge. -/
private theorem sourceLemma31CycleSucc_adj [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (hC : C.IsCycle)
    (v : V) (hv : v ∈ C.support) :
    G.Adj v (sourceLemma31CycleSucc G C v hv) := by
  have hrot : (C.rotate hv).IsCycle := hC.rotate hv
  unfold sourceLemma31CycleSucc
  apply Walk.adj_snd
  intro hnil
  exact hrot.isCircuit.ne_nil (Walk.nil_iff_eq_nil.mp hnil)

/-- A cycle successor is distinct from its chosen cycle vertex. -/
private theorem sourceLemma31CycleSucc_ne [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (hC : C.IsCycle)
    (v : V) (hv : v ∈ C.support) :
    v ≠ sourceLemma31CycleSucc G C v hv :=
  (sourceLemma31CycleSucc_adj G C hC v hv).ne

/-- A connected component of the outside graph supplies a simple ambient path whose
vertices all remain outside the source cycle. -/
private theorem sourceLemma31_component_internal_path [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r)
    (A : (sourceLemma31OutsideGraph G C).ConnectedComponent)
    (x y : {v : V // v ∈ sourceLemma31OutsideVertices G C})
    (hx : x ∈ A.supp) (hy : y ∈ A.supp) :
    ∃ Q : G.Walk x.1 y.1, Q.IsPath ∧ ∀ z, z ∈ Q.support → z ∉ C.support := by
  let H := sourceLemma31OutsideGraph G C
  let xA : A.supp := ⟨x, hx⟩
  let yA : A.supp := ⟨y, hy⟩
  obtain ⟨q, hq⟩ := A.connected_induce_supp.exists_isPath xA yA
  let innerIncl : (H.induce A.supp) →g H := {
    toFun := fun z => z.1
    map_rel' := by
      intro a b hab
      exact hab }
  let outsideIncl : H →g G := {
    toFun := fun z => z.1
    map_rel' := by
      intro a b hab
      exact hab }
  let Q : G.Walk x.1 y.1 := (q.map innerIncl).map outsideIncl
  have hQpath : Q.IsPath := by
    dsimp [Q]
    apply Walk.map_isPath_of_injective
    · exact fun a b hab => Subtype.ext hab
    · apply Walk.map_isPath_of_injective
      · exact fun a b hab => Subtype.ext hab
      · exact hq
  refine ⟨Q, hQpath, ?_⟩
  intro z hz
  dsimp [Q] at hz
  rw [Walk.support_map, Walk.support_map] at hz
  rcases List.mem_map.mp hz with ⟨zH, hzH, hzEq⟩
  rcases List.mem_map.mp hzH with ⟨zA, hzA, hzAEq⟩
  subst z
  subst zH
  change zA.1.1 ∉ C.support
  exact zA.1.2

/-- Two attachments to one outside component are joined by a simple ambient bridge. -/
private theorem sourceLemma31_component_bridge [Fintype V] [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r)
    (A : (sourceLemma31OutsideGraph G C).ConnectedComponent)
    (u v : V) (hu : u ∈ C.support) (hv : v ∈ C.support) (huv : u ≠ v)
    (hAu : sourceLemma31ComponentAdjacent G C A u)
    (hAv : sourceLemma31ComponentAdjacent G C A v) :
    ∃ P : G.Walk u v, P.IsPath ∧ 2 ≤ P.length ∧
      internalVertices G P ⊆ sourceLemma31OutsideVertices G C := by
  rcases hAu with ⟨x, hxA, hxu⟩
  rcases hAv with ⟨y, hyA, hyv⟩
  obtain ⟨Q, hQpath, hQoutside⟩ :=
    sourceLemma31_component_internal_path G C A x y hxA hyA
  have hQnotu : u ∉ Q.support := by
    intro huQ
    exact hQoutside u huQ hu
  have hQnotv : v ∉ Q.support := by
    intro hvQ
    exact hQoutside v hvQ hv
  let P : G.Walk u v := Walk.cons hxu.symm (Q.concat hyv)
  have hPpath : P.IsPath := by
    rw [Walk.isPath_def]
    dsimp [P]
    rw [Walk.support_concat]
    apply List.Nodup.cons
    · simp [hQnotu, huv]
    · simpa [List.concat_eq_append] using
        hQpath.support_nodup.concat hQnotv
  refine ⟨P, hPpath, ?_, ?_⟩
  · dsimp [P]
    simp only [Walk.length_cons, Walk.length_concat]
    omega
  · intro z hz
    change z ∈ P.support ∧ z ≠ u ∧ z ≠ v at hz
    dsimp [P] at hz
    rw [Walk.support_concat, List.mem_cons] at hz
    rw [List.concat_eq_append, List.mem_append, List.mem_singleton] at hz
    rcases hz.1 with hzu | hzQ | hzv
    · exact (hz.2.1 hzu).elim
    · exact hQoutside z hzQ
    · exact (hz.2.2 hzv).elim

/-- A simple bridge between two cycle attachments, retaining the outside
component containing each of its internal vertices.  This is a proposition:
its witnesses come from component-adjacency hypotheses, which are themselves
propositional existentials. -/
private def SourceLemma31ComponentBridge [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r)
    (A : (sourceLemma31OutsideGraph G C).ConnectedComponent) (u v : V) : Prop :=
  ∃ path : G.Walk u v, path.IsPath ∧ 2 ≤ path.length ∧
    internalVertices G path ⊆ sourceLemma31OutsideVertices G C ∧
      ∀ z, z ∈ internalVertices G path →
        ∃ hz : z ∈ sourceLemma31OutsideVertices G C,
          (⟨z, hz⟩ : {x : V // x ∈ sourceLemma31OutsideVertices G C}) ∈ A.supp

/-- Two attachments to one outside component are joined by a simple ambient
bridge whose internal vertices retain that component label. -/
private theorem sourceLemma31_component_bridge_labelled [Fintype V] [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r)
    (A : (sourceLemma31OutsideGraph G C).ConnectedComponent)
    (u v : V) (hu : u ∈ C.support) (hv : v ∈ C.support) (huv : u ≠ v)
    (hAu : sourceLemma31ComponentAdjacent G C A u)
    (hAv : sourceLemma31ComponentAdjacent G C A v) :
    SourceLemma31ComponentBridge G C A u v := by
  rcases hAu with ⟨x, hxA, hxu⟩
  rcases hAv with ⟨y, hyA, hyv⟩
  let H := sourceLemma31OutsideGraph G C
  let xA : A.supp := ⟨x, hxA⟩
  let yA : A.supp := ⟨y, hyA⟩
  obtain ⟨q, hq⟩ := A.connected_induce_supp.exists_isPath xA yA
  let innerIncl : (H.induce A.supp) →g H := {
    toFun := fun z => z.1
    map_rel' := by
      intro a b hab
      exact hab }
  let outsideIncl : H →g G := {
    toFun := fun z => z.1
    map_rel' := by
      intro a b hab
      exact hab }
  let Q : G.Walk x.1 y.1 := (q.map innerIncl).map outsideIncl
  have hQpath : Q.IsPath := by
    dsimp [Q]
    apply Walk.map_isPath_of_injective
    · exact fun a b hab => Subtype.ext hab
    · apply Walk.map_isPath_of_injective
      · exact fun a b hab => Subtype.ext hab
      · exact hq
  have hQcomponent : ∀ z, z ∈ Q.support →
      ∃ hz : z ∈ sourceLemma31OutsideVertices G C,
        (⟨z, hz⟩ : {x : V // x ∈ sourceLemma31OutsideVertices G C}) ∈ A.supp := by
    intro z hz
    dsimp [Q] at hz
    rw [Walk.support_map, Walk.support_map] at hz
    rcases List.mem_map.mp hz with ⟨zH, hzH, hzEq⟩
    rcases List.mem_map.mp hzH with ⟨zA, hzA, hzAEq⟩
    subst z
    subst zH
    exact ⟨zA.1.2, zA.2⟩
  have hQoutside : ∀ z, z ∈ Q.support → z ∉ C.support := by
    intro z hz
    obtain ⟨hzout, _⟩ := hQcomponent z hz
    exact hzout
  have hQnotu : u ∉ Q.support := by
    intro huQ
    exact hQoutside u huQ hu
  have hQnotv : v ∉ Q.support := by
    intro hvQ
    exact hQoutside v hvQ hv
  let P : G.Walk u v := Walk.cons hxu.symm (Q.concat hyv)
  have hPpath : P.IsPath := by
    rw [Walk.isPath_def]
    dsimp [P]
    rw [Walk.support_concat]
    apply List.Nodup.cons
    · simp [hQnotu, huv]
    · simpa [List.concat_eq_append] using hQpath.support_nodup.concat hQnotv
  have hPlength : 2 ≤ P.length := by
    dsimp [P]
    simp only [Walk.length_cons, Walk.length_concat]
    omega
  have hPcomponent : ∀ z, z ∈ internalVertices G P →
      ∃ hz : z ∈ sourceLemma31OutsideVertices G C,
        (⟨z, hz⟩ : {x : V // x ∈ sourceLemma31OutsideVertices G C}) ∈ A.supp := by
    intro z hz
    change z ∈ P.support ∧ z ≠ u ∧ z ≠ v at hz
    dsimp [P] at hz
    rw [Walk.support_concat, List.mem_cons] at hz
    rw [List.concat_eq_append, List.mem_append, List.mem_singleton] at hz
    rcases hz.1 with hzu | hzQ | hzv
    · exact (hz.2.1 hzu).elim
    · exact hQcomponent z hzQ
    · exact (hz.2.2 hzv).elim
  refine ⟨P, hPpath, hPlength, ?_, hPcomponent⟩
  intro z hz
  obtain ⟨hzout, _⟩ := hPcomponent z hz
  exact hzout

/-- Distinct outside connected components have disjoint supports. -/
private theorem sourceLemma31_distinct_components_disjoint [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r)
    (A B : (sourceLemma31OutsideGraph G C).ConnectedComponent) (hAB : A ≠ B) :
    Disjoint A.supp B.supp :=
  SimpleGraph.pairwise_disjoint_supp_connectedComponent
    (sourceLemma31OutsideGraph G C) hAB

/-- Internal vertices of labelled bridges through distinct outside components
are disjoint. -/
private theorem sourceLemma31_labelled_bridges_internal_disjoint [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r)
    (A B : (sourceLemma31OutsideGraph G C).ConnectedComponent) (hAB : A ≠ B)
    {u v x y : V}
    {PA : G.Walk u v} {PB : G.Walk x y}
    (hPAcomponent : ∀ z, z ∈ internalVertices G PA →
      ∃ hz : z ∈ sourceLemma31OutsideVertices G C,
        (⟨z, hz⟩ : {x : V // x ∈ sourceLemma31OutsideVertices G C}) ∈ A.supp)
    (hPBcomponent : ∀ z, z ∈ internalVertices G PB →
      ∃ hz : z ∈ sourceLemma31OutsideVertices G C,
        (⟨z, hz⟩ : {x : V // x ∈ sourceLemma31OutsideVertices G C}) ∈ B.supp) :
    Disjoint (internalVertices G PA) (internalVertices G PB) := by
  rw [Set.disjoint_left]
  intro z hzA hzB
  obtain ⟨hzoutA, hzAcomp⟩ := hPAcomponent z hzA
  obtain ⟨hzoutB, hzBcomp⟩ := hPBcomponent z hzB
  have hcomp := Set.disjoint_left.mp
    (sourceLemma31_distinct_components_disjoint G C A B hAB)
  exact hcomp (by simpa using hzAcomp) (by simpa using hzBcomp)

/-- In the tail of a nontrivial simple bridge, every vertex is either internal
to the bridge or its prescribed terminal vertex. -/
private theorem sourceLemma31_tail_mem_internal_or_end [DecidableEq V]
    {u v : V} (P : G.Walk u v) (hP : P.IsPath) (hPnon : ¬ P.Nil)
    {z : V} (hz : z ∈ P.tail.support) :
    z ∈ internalVertices G P ∨ z = v := by
  by_cases hzv : z = v
  · exact Or.inr hzv
  · left
    have hzTail : z ∈ P.support.tail := by
      rw [← Walk.support_tail_of_not_nil P hPnon]
      exact hz
    have hzu : z ≠ u := by
      intro hzu
      subst z
      have hnodup := hP.support_nodup
      rw [P.support_eq_cons] at hnodup
      exact (List.nodup_cons.mp hnodup).1 hzTail
    exact ⟨List.mem_of_mem_tail hzTail, hzu, hzv⟩

/-- Deleting the first edge of a rotated source cycle leaves the complementary
simple path back to its chosen initial vertex. -/
private theorem sourceLemma31_rotatedCycle_tail_isPath [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (hC : C.IsCycle)
    (u : V) (hu : u ∈ C.support) :
    (C.rotate hu).tail.IsPath := by
  let R := C.rotate hu
  have hR : R.IsCycle := hC.rotate hu
  have hRnon : ¬ R.Nil := hR.not_nil
  rw [← R.cons_tail_eq hRnon] at hR
  exact (Walk.cons_isCycle_iff _ _).mp hR |>.1

/-- The rotated-cycle suffix uses only vertices of the original cycle. -/
private theorem sourceLemma31_rotatedCycle_tail_support_subset [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (hC : C.IsCycle)
    (u : V) (hu : u ∈ C.support) :
    (C.rotate hu).tail.support ⊆ C.support := by
  let R := C.rotate hu
  have hR : R.IsCycle := hC.rotate hu
  have hRnon : ¬ R.Nil := hR.not_nil
  intro z hz
  have hzRtail : z ∈ R.support.tail := by
    rw [← Walk.support_tail_of_not_nil R hRnon]
    exact hz
  have hzCtail : z ∈ C.support.tail :=
    (Walk.support_rotate C hu).mem_iff.mp hzRtail
  exact List.mem_of_mem_tail hzCtail

/-- Replacing a successor edge of a longest cycle by an internally outside
bridge produces a strictly longer simple cycle. -/
private theorem sourceLemma31_replace_successor_edge_longer [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) (hC : C.IsCycle)
    (u : V) (hu : u ∈ C.support)
    (P : G.Walk u (sourceLemma31CycleSucc G C u hu))
    (hPpath : P.IsPath) (hPlen : 2 ≤ P.length)
    (hPoutside : internalVertices G P ⊆ sourceLemma31OutsideVertices G C) :
    ∃ D : G.Walk u u, D.IsCycle ∧ C.length < D.length := by
  let s := sourceLemma31CycleSucc G C u hu
  let R := C.rotate hu
  let S : G.Walk s u := R.tail
  have hRcycle : R.IsCycle := hC.rotate hu
  have hRnon : ¬ R.Nil := hRcycle.not_nil
  have hSpath : S.IsPath := by
    dsimp [S, R]
    exact sourceLemma31_rotatedCycle_tail_isPath G C hC u hu
  have hSsubset : S.support ⊆ C.support := by
    dsimp [S, R]
    exact sourceLemma31_rotatedCycle_tail_support_subset G C hC u hu
  have hPnon : ¬ P.Nil := by
    rw [Walk.nil_iff_length_eq]
    omega
  have hPtailpath : P.tail.IsPath := hPpath.tail
  have hPnotu : u ∉ P.tail.support := by
    rw [Walk.support_tail_of_not_nil P hPnon]
    have hnodup := hPpath.support_nodup
    rw [P.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  have hSnots : s ∉ S.support.tail := by
    have hnodup := hSpath.support_nodup
    rw [S.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  have hdisjoint : P.tail.support.Disjoint S.support.tail := by
    rw [List.disjoint_left]
    intro z hzP hzS
    have hzP' : z ∈ P.support := by
      rw [Walk.support_tail_of_not_nil P hPnon] at hzP
      exact List.mem_of_mem_tail hzP
    have hzS' : z ∈ S.support := List.mem_of_mem_tail hzS
    have hzOutside : z ∉ C.support := by
      apply hPoutside
      refine ⟨hzP', ?_, ?_⟩
      · intro hzu
        subst z
        exact hPnotu hzP
      · intro hzs
        subst z
        exact hSnots hzS
    exact hzOutside (hSsubset hzS')
  let T : G.Walk P.snd u := P.tail.append S
  have hTpath : T.IsPath := by
    apply Walk.IsPath.mk'
    dsimp [T]
    rw [Walk.support_append]
    exact List.Nodup.append hPtailpath.support_nodup
      hSpath.support_nodup.tail hdisjoint
  have hxs : P.snd ≠ s := by
    intro hxs
    let Ptail : G.Walk P.snd P.snd :=
      P.tail.copy rfl hxs.symm
    have hPtail : Ptail.IsPath := by
      rw [Walk.isPath_def]
      simpa only [Ptail, Walk.support_copy, ← Walk.isPath_def]
        using hPtailpath
    have htailnil : Ptail = Walk.nil :=
      (Walk.isPath_iff_eq_nil _).mp hPtail
    have htailLength : P.tail.length = 0 := by
      have hzero : Ptail.length = 0 := by
        rw [htailnil]
        rfl
      simpa [Ptail] using hzero
    have hlength := P.length_tail_add_one hPnon
    omega
  have hPfirstOutside : P.snd ∉ C.support := by
    apply hPoutside
    refine ⟨?_, ?_, hxs⟩
    · have htail : P.snd ∈ P.tail.support := P.tail.start_mem_support
      rw [Walk.support_tail_of_not_nil P hPnon] at htail
      exact List.mem_of_mem_tail htail
    · intro hPu
      apply hPnotu
      simpa only [hPu] using P.tail.start_mem_support
  have hfirstNotPtail : s(u, P.snd) ∉ P.tail.edges := by
    have hPtrail := hPpath.isTrail
    rw [← P.cons_tail_eq hPnon] at hPtrail
    exact (Walk.cons_isTrail_iff _ _).mp hPtrail |>.2
  have hfirstNotS : s(u, P.snd) ∉ S.edges := by
    intro hfirstS
    apply hPfirstOutside
    apply hSsubset
    exact S.snd_mem_support_of_mem_edges hfirstS
  have hfirstNotT : s(u, P.snd) ∉ T.edges := by
    dsimp [T]
    rw [Walk.edges_append, List.mem_append]
    exact fun h => h.elim hfirstNotPtail hfirstNotS
  have hDcycle : (P.append S).IsCycle := by
    rw [← P.cons_tail_eq hPnon, Walk.cons_append]
    exact (Walk.cons_isCycle_iff _ _).mpr ⟨hTpath, hfirstNotT⟩
  refine ⟨P.append S, hDcycle, ?_⟩
  have hRlength : R.length = C.length := by
    dsimp [R]
    rw [Walk.rotate, Walk.length_append, Nat.add_comm, ← Walk.length_append, Walk.take_spec]
  have hSlength : S.length + 1 = C.length := by
    rw [show S = R.tail by rfl, Walk.length_tail_add_one hRnon, hRlength]
  rw [Walk.length_append]
  omega

/-- A component outside a longest cycle cannot meet two consecutive cycle
vertices, since its bridge would replace their common cycle edge. -/
private theorem sourceLemma31_no_component_consecutive_neighbors [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (hLongest : SourceLongestCycle G C)
    (A : (sourceLemma31OutsideGraph G C).ConnectedComponent)
    (v : V) (hv : v ∈ C.support)
    (hAv : sourceLemma31ComponentAdjacent G C A v)
    (hAs : sourceLemma31ComponentAdjacent G C A
      (sourceLemma31CycleSucc G C v hv)) : False := by
  have hC := hLongest.1
  have hsMem := sourceLemma31CycleSucc_mem G C hC v hv
  have hne := sourceLemma31CycleSucc_ne G C hC v hv
  obtain ⟨P, hPpath, hPlen, hPoutside⟩ :=
    sourceLemma31_component_bridge G C A v
      (sourceLemma31CycleSucc G C v hv) hv hsMem hne hAv hAs
  obtain ⟨D, hDcycle, hlonger⟩ :=
    sourceLemma31_replace_successor_edge_longer G C hC v hv P hPpath hPlen hPoutside
  have hmax := hLongest.2 D hDcycle
  omega

/-- One directed auxiliary transition of source Lemma 3.1, recorded without
introducing a global directed-multigraph object.  It remains propositional so
that vertex-indexed transition membership can be used without Prop-to-Type
elimination. -/
private def SourceLemma31TransitionWitness [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (A B : (sourceLemma31OutsideGraph G C).ConnectedComponent) : Prop :=
  ∃ vertex : V, ∃ hvertex : vertex ∈ C.support,
    sourceLemma31ComponentAdjacent G C A vertex ∧
      sourceLemma31ComponentAdjacent G C B
        (sourceLemma31CycleSucc G C vertex hvertex)

/-- A transition witness cannot be a loop: it would make one outside component
adjacent to consecutive vertices of a longest cycle. -/
private theorem sourceLemma31_transitionWitness_not_loop [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (hLongest : SourceLongestCycle G C)
    (A : (sourceLemma31OutsideGraph G C).ConnectedComponent)
    (w : SourceLemma31TransitionWitness G C A A) : False := by
  rcases w with ⟨vertex, hvertex, hsource, hsuccessor⟩
  exact sourceLemma31_no_component_consecutive_neighbors G C hLongest A vertex hvertex
    hsource hsuccessor

/-- The initial dart of a nonempty walk occurs in its dart list. -/
private theorem sourceLemma31_firstDart_mem_darts {u v : V}
    (p : G.Walk u v) (hp : ¬ p.Nil) : p.firstDart hp ∈ p.darts := by
  cases p with
  | nil => simp at hp
  | cons h q => simp [Walk.firstDart]

/-- A directed cycle contains at most one dart with a given terminal vertex. -/
private theorem sourceLemma31_dart_eq_of_same_snd [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (hC : C.IsCycle)
    (d e : G.Dart) (hd : d ∈ C.darts) (he : e ∈ C.darts) (hs : d.snd = e.snd) :
    d = e := by
  have hnodup : (C.darts.map (fun a : G.Dart => a.snd)).Nodup := by
    rw [C.map_snd_darts]
    exact hC.support_nodup
  exact List.inj_on_of_nodup_map hnodup hd he hs

/-- A directed cycle contains at most one dart with a given initial vertex. -/
private theorem sourceLemma31_dart_eq_of_same_fst [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (hC : C.IsCycle)
    (d e : G.Dart) (hd : d ∈ C.darts) (he : e ∈ C.darts) (hs : d.fst = e.fst) :
    d = e := by
  have hds : d.symm ∈ C.reverse.darts := (Walk.mem_darts_reverse).mpr hd
  have hes : e.symm ∈ C.reverse.darts := (Walk.mem_darts_reverse).mpr he
  have hrev : C.reverse.IsCycle := hC.reverse
  have hnodup : (C.reverse.darts.map (fun a : G.Dart => a.snd)).Nodup := by
    rw [C.reverse.map_snd_darts]
    exact hrev.support_nodup
  have hsymm : d.symm = e.symm :=
    List.inj_on_of_nodup_map hnodup hds hes (by simpa using hs)
  simpa using congrArg Dart.symm hsymm

/-- The directed successor of a simple cycle is injective on its vertices. -/
private theorem sourceLemma31CycleSucc_injective [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (hC : C.IsCycle)
    (u v : V) (hu : u ∈ C.support) (hv : v ∈ C.support) :
    sourceLemma31CycleSucc G C u hu = sourceLemma31CycleSucc G C v hv → u = v := by
  let Ru := C.rotate hu
  let Rv := C.rotate hv
  have hRu : Ru.IsCycle := hC.rotate hu
  have hRv : Rv.IsCycle := hC.rotate hv
  have hRuNon : ¬ Ru.Nil := hRu.not_nil
  have hRvNon : ¬ Rv.Nil := hRv.not_nil
  let du := Ru.firstDart hRuNon
  let dv := Rv.firstDart hRvNon
  have hduRu : du ∈ Ru.darts := sourceLemma31_firstDart_mem_darts G Ru hRuNon
  have hdvRv : dv ∈ Rv.darts := sourceLemma31_firstDart_mem_darts G Rv hRvNon
  have hduC : du ∈ C.darts := (C.rotate_darts hu).mem_iff.mp hduRu
  have hdvC : dv ∈ C.darts := (C.rotate_darts hv).mem_iff.mp hdvRv
  intro hs
  have hduvSnd : du.snd = dv.snd := by
    simpa [du, dv, Ru, Rv, sourceLemma31CycleSucc] using hs
  have hduv : du = dv := sourceLemma31_dart_eq_of_same_snd G C hC du dv hduC hdvC hduvSnd
  have hfst := congrArg (fun d : G.Dart => d.fst) hduv
  simpa [du, dv] using hfst

/-- A second source-cycle vertex occurs in the tail after rotating the cycle to
begin at the first vertex. -/
private theorem sourceLemma31_mem_rotate_tail_of_ne [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (hC : C.IsCycle)
    (u v : V) (hu : u ∈ C.support) (hv : v ∈ C.support) (huv : u ≠ v) :
    v ∈ (C.rotate hu).tail.support := by
  let R : G.Walk u u := C.rotate hu
  have hCnon : ¬ C.Nil := hC.not_nil
  have hRnon : ¬ R.Nil := (hC.rotate hu).not_nil
  have hvCtail : v ∈ C.support.tail := by
    rw [C.support_eq_cons] at hv
    rcases List.mem_cons.mp hv with hvr | hvtail
    · subst v
      exact C.end_mem_tail_support hCnon
    · exact hvtail
  have hvRtail : v ∈ R.support.tail :=
    (Walk.support_rotate C hu).mem_iff.mpr hvCtail
  rw [Walk.support_tail_of_not_nil R hRnon]
  exact hvRtail

/-- The suffix beginning at a second cycle vertex starts with that vertex's
directed successor on the source cycle. -/
private theorem sourceLemma31_dropUntil_snd_eq_cycleSucc [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (hC : C.IsCycle)
    (u v : V) (hu : u ∈ C.support) (hv : v ∈ C.support) (huv : u ≠ v) :
    ((C.rotate hu).tail.dropUntil v
      (sourceLemma31_mem_rotate_tail_of_ne G C hC u v hu hv huv)).snd =
      sourceLemma31CycleSucc G C v hv := by
  let R : G.Walk u u := C.rotate hu
  have hRnon : ¬ R.Nil := (hC.rotate hu).not_nil
  have hvRtail : v ∈ R.tail.support :=
    sourceLemma31_mem_rotate_tail_of_ne G C hC u v hu hv huv
  let T : G.Walk v u := R.tail.dropUntil v hvRtail
  have hTnon : ¬ T.Nil := Walk.not_nil_of_ne huv.symm
  let Rv : G.Walk v v := C.rotate hv
  have hRvnon : ¬ Rv.Nil := (hC.rotate hv).not_nil
  let dT : G.Dart := T.firstDart hTnon
  let dV : G.Dart := Rv.firstDart hRvnon
  have hdT : dT ∈ T.darts := sourceLemma31_firstDart_mem_darts G T hTnon
  have hdTRtail : dT ∈ R.tail.darts := R.tail.darts_dropUntil_subset hvRtail hdT
  have hdTR : dT ∈ R.darts := by
    rw [← R.cons_tail_eq hRnon, Walk.darts_cons, List.mem_cons]
    exact Or.inr hdTRtail
  have hdTC : dT ∈ C.darts := (C.rotate_darts hu).mem_iff.mp hdTR
  have hdV : dV ∈ Rv.darts := sourceLemma31_firstDart_mem_darts G Rv hRvnon
  have hdVC : dV ∈ C.darts := (C.rotate_darts hv).mem_iff.mp hdV
  have hfst : dT.fst = dV.fst := by
    simp [dT, dV]
  have hdart : dT = dV :=
    sourceLemma31_dart_eq_of_same_fst G C hC dT dV hdTC hdVC hfst
  have hsnd : dT.snd = dV.snd := congrArg (fun d : G.Dart => d.snd) hdart
  simpa [T, R, Rv, dT, dV, sourceLemma31CycleSucc] using hsnd

/-- The two directed cycle segments left after removing the successor edges at
two distinct source-cycle vertices. -/
private structure SourceLemma31TwoWitnessCycleGeometry [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r)
    (u v : V) (hu : u ∈ C.support) (hv : v ∈ C.support) where
  q1 : G.Walk (sourceLemma31CycleSucc G C u hu) v
  q2 : G.Walk (sourceLemma31CycleSucc G C v hv) u
  q1_isPath : q1.IsPath
  q2_isPath : q2.IsPath
  q1_support_subset : ∀ z, z ∈ q1.support → z ∈ C.support
  q2_support_subset : ∀ z, z ∈ q2.support → z ∈ C.support
  disjoint_support : q1.support.Disjoint q2.support
  total_length : q1.length + q2.length + 2 = C.length

/-- Splitting a rotated simple cycle at a second vertex gives the two disjoint
source-cycle segments between the two successor edges. -/
private noncomputable def sourceLemma31_two_transition_cycle_geometry [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (hC : C.IsCycle)
    (u v : V) (hu : u ∈ C.support) (hv : v ∈ C.support) (huv : u ≠ v) :
    SourceLemma31TwoWitnessCycleGeometry G C u v hu hv := by
  let uplus := sourceLemma31CycleSucc G C u hu
  let vplus := sourceLemma31CycleSucc G C v hv
  let R : G.Walk u u := C.rotate hu
  have hvRtail : v ∈ R.tail.support :=
    sourceLemma31_mem_rotate_tail_of_ne G C hC u v hu hv huv
  let Q1 : G.Walk uplus v := R.tail.takeUntil v hvRtail
  let T : G.Walk v u := R.tail.dropUntil v hvRtail
  have hTsucc : T.snd = vplus := by
    simpa [T, R, vplus] using
      sourceLemma31_dropUntil_snd_eq_cycleSucc G C hC u v hu hv huv
  let Q2 : G.Walk vplus u := T.tail.copy hTsucc rfl
  have hRtailPath : R.tail.IsPath := by
    simpa [R] using sourceLemma31_rotatedCycle_tail_isPath G C hC u hu
  have hQ1path : Q1.IsPath := by
    dsimp [Q1]
    exact hRtailPath.takeUntil hvRtail
  have hTpath : T.IsPath := by
    dsimp [T]
    exact hRtailPath.dropUntil hvRtail
  have hQ2path : Q2.IsPath := by
    dsimp [Q2]
    simpa using hTpath.tail
  have hQ1subset : ∀ z, z ∈ Q1.support → z ∈ C.support := by
    intro z hz
    apply sourceLemma31_rotatedCycle_tail_support_subset G C hC u hu
    exact R.tail.support_takeUntil_subset hvRtail hz
  have hTnon : ¬ T.Nil := Walk.not_nil_of_ne huv.symm
  have hQ2subset : ∀ z, z ∈ Q2.support → z ∈ C.support := by
    intro z hz
    have hzTtail : z ∈ T.tail.support := by
      simpa [Q2] using hz
    have hzT : z ∈ T.support := by
      rw [Walk.support_tail_of_not_nil T hTnon] at hzTtail
      exact List.mem_of_mem_tail hzTtail
    apply sourceLemma31_rotatedCycle_tail_support_subset G C hC u hu
    exact R.tail.support_dropUntil_subset hvRtail hzT
  have hsplitNodup : (Q1.support ++ T.support.tail).Nodup := by
    rw [← Walk.support_append, R.tail.take_spec hvRtail]
    exact hRtailPath.support_nodup
  have hdisjointQT : Q1.support.Disjoint T.support.tail :=
    List.disjoint_of_nodup_append hsplitNodup
  have hQ2support : Q2.support = T.support.tail := by
    dsimp [Q2]
    rw [Walk.support_copy, Walk.support_tail_of_not_nil T hTnon]
  have hdisjoint : Q1.support.Disjoint Q2.support := by
    rw [hQ2support]
    exact hdisjointQT
  have hsplitLength : Q1.length + T.length = R.tail.length := by
    change (R.tail.takeUntil v hvRtail).length +
      (R.tail.dropUntil v hvRtail).length = R.tail.length
    rw [← Walk.length_append, R.tail.take_spec hvRtail]
  have hQ2length : Q2.length + 1 = T.length := by
    simpa [Q2] using T.length_tail_add_one hTnon
  have hRnon : ¬ R.Nil := (hC.rotate hu).not_nil
  have hRtailLength : R.tail.length + 1 = R.length := R.length_tail_add_one hRnon
  have hRlength : R.length = C.length := by
    dsimp [R]
    rw [Walk.rotate, Walk.length_append, Nat.add_comm, ← Walk.length_append, Walk.take_spec]
  refine ⟨Q1, Q2, hQ1path, hQ2path, hQ1subset, hQ2subset, hdisjoint, ?_⟩
  omega

/-- Two distinct transitions in the same direction between distinct outside
components would splice to a cycle longer than a longest source cycle. -/
private theorem sourceLemma31_same_direction_transition_witnesses_impossible
    [Fintype V] [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r)
    (hLongest : SourceLongestCycle G C)
    (A B : (sourceLemma31OutsideGraph G C).ConnectedComponent)
    (hAB : A ≠ B)
    (u v : V) (hu : u ∈ C.support) (hv : v ∈ C.support)
    (hAu : sourceLemma31ComponentAdjacent G C A u)
    (hBu : sourceLemma31ComponentAdjacent G C B (sourceLemma31CycleSucc G C u hu))
    (hAv : sourceLemma31ComponentAdjacent G C A v)
    (hBv : sourceLemma31ComponentAdjacent G C B (sourceLemma31CycleSucc G C v hv))
    (huv : u ≠ v) : False := by
  let uplus := sourceLemma31CycleSucc G C u hu
  let vplus := sourceLemma31CycleSucc G C v hv
  have hC : C.IsCycle := hLongest.1
  have huplus : uplus ∈ C.support :=
    sourceLemma31CycleSucc_mem G C hC u hu
  have hvplus : vplus ∈ C.support :=
    sourceLemma31CycleSucc_mem G C hC v hv
  have huplusvplus : uplus ≠ vplus := by
    intro h
    apply huv
    exact sourceLemma31CycleSucc_injective G C hC u v hu hv h
  obtain ⟨PA, hPApath, hPAlen, hPAoutside, hPAcomponent⟩ :=
    sourceLemma31_component_bridge_labelled G C A u v
      hu hv huv hAu hAv
  obtain ⟨PB, hPBpath, hPBlen, hPBoutside, hPBcomponent⟩ :=
    sourceLemma31_component_bridge_labelled G C B uplus vplus
      huplus hvplus huplusvplus hBu hBv
  let geom := sourceLemma31_two_transition_cycle_geometry G C hC u v
    hu hv huv
  let Q : G.Walk v uplus := geom.q1.reverse
  let W : G.Walk vplus u := geom.q2
  have hPA_non : ¬ PA.Nil := by
    rw [Walk.nil_iff_length_eq]
    omega
  have hPB_non : ¬ PB.Nil := by
    rw [Walk.nil_iff_length_eq]
    omega
  have hApath : PA.tail.IsPath := hPApath.tail
  have hQpath : Q.IsPath := by
    dsimp [Q]
    exact geom.q1_isPath.reverse
  have hWpath : W.IsPath := by
    dsimp [W]
    exact geom.q2_isPath
  have hQsubset : ∀ z, z ∈ Q.support → z ∈ C.support := by
    intro z hz
    dsimp [Q] at hz
    rw [Walk.support_reverse, List.mem_reverse] at hz
    exact geom.q1_support_subset z hz
  have hWsubset : ∀ z, z ∈ W.support → z ∈ C.support := by
    intro z hz
    exact geom.q2_support_subset z (by simpa [W] using hz)
  have hQnotv : v ∉ Q.support.tail := by
    have hnodup := hQpath.support_nodup
    rw [Q.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  have hWnotvplus : vplus ∉ W.support.tail := by
    have hnodup := hWpath.support_nodup
    rw [W.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  have hPAQ : PA.tail.support.Disjoint Q.support.tail := by
    rw [List.disjoint_left]
    intro z hzA hzQ
    rcases sourceLemma31_tail_mem_internal_or_end G PA hPApath hPA_non hzA with hzInt | hzv
    · exact (hPAoutside hzInt) (hQsubset z (List.mem_of_mem_tail hzQ))
    · subst z
      exact hQnotv hzQ
  have hPAPB : PA.tail.support.Disjoint PB.tail.support := by
    rw [List.disjoint_left]
    intro z hzA hzB
    rcases sourceLemma31_tail_mem_internal_or_end G PA hPApath hPA_non hzA with hzAint | hzv
    · rcases sourceLemma31_tail_mem_internal_or_end G PB hPBpath hPB_non hzB with hzBint | hzvplus
      · exact Set.disjoint_left.mp
          (sourceLemma31_labelled_bridges_internal_disjoint G C A B hAB hPAcomponent hPBcomponent) hzAint hzBint
      · subst z
        exact (hPAoutside hzAint) hvplus
    · subst z
      rcases sourceLemma31_tail_mem_internal_or_end G PB hPBpath hPB_non hzB with hzBint | hzvplus
      · exact (hPBoutside hzBint) hv
      · exact (sourceLemma31CycleSucc_ne G C hC v hv) hzvplus
  have hPAW : PA.tail.support.Disjoint W.support.tail := by
    rw [List.disjoint_left]
    intro z hzA hzW
    rcases sourceLemma31_tail_mem_internal_or_end G PA hPApath hPA_non hzA with hzInt | hzv
    · exact (hPAoutside hzInt) (hWsubset z (List.mem_of_mem_tail hzW))
    · subst z
      exact List.disjoint_left.mp geom.disjoint_support geom.q1.end_mem_support
        (by simpa [W] using List.mem_of_mem_tail hzW)
  have hQPB : Q.support.tail.Disjoint PB.tail.support := by
    rw [List.disjoint_left]
    intro z hzQ hzB
    have hzQfull : z ∈ Q.support := List.mem_of_mem_tail hzQ
    have hzQ1 : z ∈ geom.q1.support := by
      dsimp [Q] at hzQfull
      rw [Walk.support_reverse, List.mem_reverse] at hzQfull
      exact hzQfull
    rcases sourceLemma31_tail_mem_internal_or_end G PB hPBpath hPB_non hzB with hzBint | hzvplus
    · exact (hPBoutside hzBint) (geom.q1_support_subset z hzQ1)
    · subst z
      exact List.disjoint_left.mp geom.disjoint_support hzQ1 geom.q2.start_mem_support
  have hQW : Q.support.tail.Disjoint W.support.tail := by
    rw [List.disjoint_left]
    intro z hzQ hzW
    have hzQfull : z ∈ Q.support := List.mem_of_mem_tail hzQ
    have hzQ1 : z ∈ geom.q1.support := by
      dsimp [Q] at hzQfull
      rw [Walk.support_reverse, List.mem_reverse] at hzQfull
      exact hzQfull
    exact List.disjoint_left.mp geom.disjoint_support hzQ1
      (by simpa [W] using List.mem_of_mem_tail hzW)
  have hPBW : PB.tail.support.Disjoint W.support.tail := by
    rw [List.disjoint_left]
    intro z hzB hzW
    rcases sourceLemma31_tail_mem_internal_or_end G PB hPBpath hPB_non hzB with hzBint | hzvplus
    · exact (hPBoutside hzBint) (hWsubset z (List.mem_of_mem_tail hzW))
    · subst z
      exact hWnotvplus hzW
  have hBWnodup : (PB.tail.support ++ W.support.tail).Nodup :=
    List.Nodup.append hPBpath.tail.support_nodup
      hWpath.support_nodup.tail hPBW
  have hQBW : Q.support.tail.Disjoint (PB.tail.support ++ W.support.tail) := by
    rw [List.disjoint_left]
    intro z hzQ hzBW
    rcases List.mem_append.mp hzBW with hzB | hzW
    · exact List.disjoint_left.mp hQPB hzQ hzB
    · exact List.disjoint_left.mp hQW hzQ hzW
  have hQBWnodup : (Q.support.tail ++ (PB.tail.support ++ W.support.tail)).Nodup :=
    List.Nodup.append hQpath.support_nodup.tail hBWnodup hQBW
  have hArest : PA.tail.support.Disjoint
      (Q.support.tail ++ (PB.tail.support ++ W.support.tail)) := by
    rw [List.disjoint_left]
    intro z hzA hzRest
    rcases List.mem_append.mp hzRest with hzQ | hzBW
    · exact List.disjoint_left.mp hPAQ hzA hzQ
    · rcases List.mem_append.mp hzBW with hzB | hzW
      · exact List.disjoint_left.mp hPAPB hzA hzB
      · exact List.disjoint_left.mp hPAW hzA hzW
  have hSnodup : (PA.tail.support ++
      (Q.support.tail ++ (PB.tail.support ++ W.support.tail))).Nodup :=
    List.Nodup.append hApath.support_nodup hQBWnodup hArest
  let S : G.Walk PA.snd u := PA.tail.append (Q.append (PB.append W))
  have hSpath : S.IsPath := by
    apply Walk.IsPath.mk'
    dsimp [S]
    rw [Walk.support_append, Walk.tail_support_append, Walk.tail_support_append]
    rw [← Walk.support_tail_of_not_nil PB hPB_non]
    exact hSnodup
  have hPA_snd_ne_v : PA.snd ≠ v := by
    intro h
    let PAtail : G.Walk PA.snd PA.snd :=
      PA.tail.copy rfl h.symm
    have hPAtail : PAtail.IsPath := by
      rw [Walk.isPath_def]
      simpa only [PAtail, Walk.support_copy, ← Walk.isPath_def]
        using hApath
    have htailnil : PAtail = Walk.nil :=
      (Walk.isPath_iff_eq_nil _).mp hPAtail
    have htailLength : PA.tail.length = 0 := by
      have hzero : PAtail.length = 0 := by
        rw [htailnil]
        rfl
      simpa [PAtail] using hzero
    have hlength := PA.length_tail_add_one hPA_non
    omega
  have hPA_snd_outside : PA.snd ∉ C.support := by
    apply hPAoutside
    refine ⟨?_, ?_, hPA_snd_ne_v⟩
    · have htail : PA.snd ∈ PA.tail.support :=
        PA.tail.start_mem_support
      rw [Walk.support_tail_of_not_nil PA hPA_non] at htail
      exact List.mem_of_mem_tail htail
    · intro h
      have hnodup := hPApath.support_nodup
      rw [PA.support_eq_cons] at hnodup
      have hnotu : u ∉ PA.support.tail :=
        (List.nodup_cons.mp hnodup).1
      apply hnotu
      rw [← Walk.support_tail_of_not_nil PA hPA_non]
      exact Eq.mp
        (congrArg (fun x : V => x ∈ PA.tail.support) h)
        PA.tail.start_mem_support
  have hfirstNotAtail : s(u, PA.snd) ∉ PA.tail.edges := by
    have htrail := hPApath.isTrail
    rw [← PA.cons_tail_eq hPA_non] at htrail
    exact (Walk.cons_isTrail_iff _ _).mp htrail |>.2
  have hfirstNotQ : s(u, PA.snd) ∉ Q.edges := by
    intro h
    exact hPA_snd_outside (hQsubset _ (Q.snd_mem_support_of_mem_edges h))
  have hfirstNotW : s(u, PA.snd) ∉ W.edges := by
    intro h
    exact hPA_snd_outside (hWsubset _ (W.snd_mem_support_of_mem_edges h))
  have hfirstNotPB : s(u, PA.snd) ∉ PB.edges := by
    intro h
    have hmem : PA.snd ∈ PB.support := PB.snd_mem_support_of_mem_edges h
    rw [PB.mem_support_iff] at hmem
    rcases hmem with huplusEq | htail
    · exact hPA_snd_outside (huplusEq ▸ huplus)
    · have htail' : PA.snd ∈ PB.tail.support := by
        rw [Walk.support_tail_of_not_nil PB hPB_non]
        exact htail
      rcases sourceLemma31_tail_mem_internal_or_end
        G PB hPBpath hPB_non htail' with hBint | hvplusEq
      · have hAint : PA.snd ∈ internalVertices G PA := by
          refine ⟨?_, ?_, hPA_snd_ne_v⟩
          · have htail : PA.snd ∈ PA.tail.support :=
              PA.tail.start_mem_support
            rw [Walk.support_tail_of_not_nil PA hPA_non] at htail
            exact List.mem_of_mem_tail htail
          · intro h
            have hnodup := hPApath.support_nodup
            rw [PA.support_eq_cons] at hnodup
            have hnotu : u ∉ PA.support.tail :=
              (List.nodup_cons.mp hnodup).1
            apply hnotu
            rw [← Walk.support_tail_of_not_nil PA hPA_non]
            exact Eq.mp
              (congrArg (fun x : V => x ∈ PA.tail.support) h)
              PA.tail.start_mem_support
        exact Set.disjoint_left.mp
          (sourceLemma31_labelled_bridges_internal_disjoint G C A B hAB hPAcomponent hPBcomponent) hAint hBint
      · exact hPA_snd_outside (hvplusEq ▸ hvplus)
  have hfirstNotS : s(u, PA.snd) ∉ S.edges := by
    dsimp [S]
    rw [Walk.edges_append, Walk.edges_append, Walk.edges_append]
    intro h
    rcases List.mem_append.mp h with hPA | hrest
    · exact hfirstNotAtail hPA
    rcases List.mem_append.mp hrest with hQ | hrest
    · exact hfirstNotQ hQ
    rcases List.mem_append.mp hrest with hPB | hW
    · exact hfirstNotPB hPB
    · exact hfirstNotW hW
  let D : G.Walk u u := PA.append (Q.append (PB.append W))
  have hDcycle : D.IsCycle := by
    change (PA.append (Q.append (PB.append W))).IsCycle
    rw [← PA.cons_tail_eq hPA_non, Walk.cons_append]
    exact (Walk.cons_isCycle_iff _ _).mpr ⟨hSpath, hfirstNotS⟩
  have hDlength : D.length = PA.length + geom.q1.length + PB.length + geom.q2.length := by
    dsimp [D, Q, W]
    simp only [Walk.length_append, Walk.length_reverse]
    omega
  have hlonger : C.length < D.length := by
    rw [hDlength]
    have hsegments := geom.total_length
    omega
  have hmax := hLongest.2 D hDcycle
  omega

/-- A directed auxiliary transition indexed by its source-cycle vertex. -/
private def sourceLemma31TransitionAt [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (A B : (sourceLemma31OutsideGraph G C).ConnectedComponent) (v : V) : Prop :=
  ∃ hv : v ∈ C.support,
    sourceLemma31ComponentAdjacent G C A v ∧
      sourceLemma31ComponentAdjacent G C B (sourceLemma31CycleSucc G C v hv)

/-- A vertex-indexed transition yields the existing splice witness. -/
private theorem sourceLemma31_transitionAt_to_witness [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (A B : (sourceLemma31OutsideGraph G C).ConnectedComponent) (v : V)
    (h : sourceLemma31TransitionAt G C A B v) :
    SourceLemma31TransitionWitness G C A B := by
  rcases h with ⟨hv, hA, hB⟩
  exact ⟨v, hv, hA, hB⟩

/-- The existing splice witness determines its source-cycle transition vertex. -/
private theorem sourceLemma31_transitionWitness_to_at [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (A B : (sourceLemma31OutsideGraph G C).ConnectedComponent)
    (w : SourceLemma31TransitionWitness G C A B) :
    ∃ v, sourceLemma31TransitionAt G C A B v := by
  rcases w with ⟨v, hv, hA, hB⟩
  exact ⟨v, hv, hA, hB⟩

/-- The source-cycle vertices realizing directed auxiliary transitions. -/
private noncomputable def sourceLemma31TransitionVertices [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (A B : (sourceLemma31OutsideGraph G C).ConnectedComponent) : Finset V := by
  classical
  exact C.support.toFinset.filter (sourceLemma31TransitionAt G C A B)

/-- Membership in the finite transition set is exactly the vertex-indexed
transition predicate. -/
private theorem sourceLemma31_mem_transitionVertices [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (A B : (sourceLemma31OutsideGraph G C).ConnectedComponent) (v : V) :
    v ∈ sourceLemma31TransitionVertices G C A B ↔
      sourceLemma31TransitionAt G C A B v := by
  classical
  constructor
  · intro hv
    exact (Finset.mem_filter.mp hv).2
  · intro hv
    obtain ⟨hmem, hA, hB⟩ := hv
    exact Finset.mem_filter.mpr
      ⟨List.mem_toFinset.mpr hmem, ⟨hmem, hA, hB⟩⟩

/-- Loop transitions are absent for a longest source cycle. -/
private theorem sourceLemma31_transitionVertices_loop_card_eq_zero [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (hLongest : SourceLongestCycle G C)
    (A : (sourceLemma31OutsideGraph G C).ConnectedComponent) :
    (sourceLemma31TransitionVertices G C A A).card = 0 := by
  classical
  rw [Finset.card_eq_zero, Finset.eq_empty_iff_forall_not_mem]
  intro v hv
  exact sourceLemma31_transitionWitness_not_loop G C hLongest A
    (sourceLemma31_transitionAt_to_witness G C A A v
      (sourceLemma31_mem_transitionVertices G C A A v |>.mp hv))

/-- Between distinct outside components, at most one source-cycle vertex gives
a transition in each fixed direction. -/
private theorem sourceLemma31_transitionVertices_card_le_one [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (hLongest : SourceLongestCycle G C)
    (A B : (sourceLemma31OutsideGraph G C).ConnectedComponent) (hAB : A ≠ B) :
    (sourceLemma31TransitionVertices G C A B).card ≤ 1 := by
  classical
  refine Finset.card_le_one.mpr ?_
  intro u hu v hv
  by_contra huv
  obtain ⟨huC, huA, huB⟩ :=
    sourceLemma31_mem_transitionVertices G C A B u |>.mp hu
  obtain ⟨hvC, hvA, hvB⟩ :=
    sourceLemma31_mem_transitionVertices G C A B v |>.mp hv
  exact sourceLemma31_same_direction_transition_witnesses_impossible
    G C hLongest A B hAB u v huC hvC huA huB hvA hvB huv

/-- Any unordered pair of outside components supports at most two directed
transitions in total, one in each direction. -/
private theorem sourceLemma31_component_pair_transition_card_le_two [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (hLongest : SourceLongestCycle G C)
    (A B : (sourceLemma31OutsideGraph G C).ConnectedComponent) :
    (sourceLemma31TransitionVertices G C A B).card +
      (sourceLemma31TransitionVertices G C B A).card ≤ 2 := by
  by_cases hAB : A = B
  · subst B
    have hzero := sourceLemma31_transitionVertices_loop_card_eq_zero G C hLongest A
    omega
  · have hforward := sourceLemma31_transitionVertices_card_le_one G C hLongest A B hAB
    have hbackward := sourceLemma31_transitionVertices_card_le_one G C hLongest B A (Ne.symm hAB)
    omega

/-- The number `h` of connected components of `G - V(C)` in source Lemma 3.1. -/
private noncomputable def sourceLemma31OutsideComponentCount [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) : ℕ := by
  classical
  letI : Fintype (sourceLemma31OutsideGraph G C).ConnectedComponent := Fintype.ofFinite _
  exact Fintype.card (sourceLemma31OutsideGraph G C).ConnectedComponent

/-- The total number `E` of directed transitions between outside components. -/
private noncomputable def sourceLemma31GlobalTransitionCount [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) : ℕ := by
  classical
  letI : Fintype (sourceLemma31OutsideGraph G C).ConnectedComponent := Fintype.ofFinite _
  exact ∑ A : (sourceLemma31OutsideGraph G C).ConnectedComponent,
    ∑ B : (sourceLemma31OutsideGraph G C).ConnectedComponent,
      (sourceLemma31TransitionVertices G C A B).card

/-- At a fixed cycle vertex, the transition predicate separates into its two
component-adjacency conditions. -/
private theorem sourceLemma31_transitionAt_iff [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (A B : (sourceLemma31OutsideGraph G C).ConnectedComponent) (v : V)
    (hv : v ∈ C.support) :
    sourceLemma31TransitionAt G C A B v ↔
      sourceLemma31ComponentAdjacent G C A v ∧
        sourceLemma31ComponentAdjacent G C B (sourceLemma31CycleSucc G C v hv) := by
  constructor
  · rintro ⟨hv', hA, hB⟩
    exact ⟨hA, by simpa using hB⟩
  · rintro ⟨hA, hB⟩
    exact ⟨hv, hA, hB⟩

/-- The ordered component pairs inducing a transition at one specified vertex. -/
private noncomputable def sourceLemma31TransitionPairs [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) (v : V) :
    Finset ((sourceLemma31OutsideGraph G C).ConnectedComponent ×
      (sourceLemma31OutsideGraph G C).ConnectedComponent) := by
  classical
  letI : Fintype (sourceLemma31OutsideGraph G C).ConnectedComponent := Fintype.ofFinite _
  exact (Finset.univ.product Finset.univ).filter fun AB =>
    sourceLemma31TransitionAt G C AB.1 AB.2 v

/-- For a fixed cycle vertex, the ordered component pairs inducing a transition
are counted by the product `f(v) f(v⁺)`. -/
private theorem sourceLemma31_transitionAt_pair_card_eq [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) (v : V)
    (hv : v ∈ C.support) :
    (sourceLemma31TransitionPairs G C v).card =
      sourceLemma31ComponentNeighborCount G C v *
        sourceLemma31ComponentNeighborCount G C (sourceLemma31CycleSucc G C v hv) := by
  classical
  letI : Fintype (sourceLemma31OutsideGraph G C).ConnectedComponent := Fintype.ofFinite _
  let s : Finset (sourceLemma31OutsideGraph G C).ConnectedComponent :=
    Finset.univ.filter fun A => sourceLemma31ComponentAdjacent G C A v
  let t : Finset (sourceLemma31OutsideGraph G C).ConnectedComponent :=
    Finset.univ.filter fun B =>
    sourceLemma31ComponentAdjacent G C B (sourceLemma31CycleSucc G C v hv)
  have hfilter :
      sourceLemma31TransitionPairs G C v = s.product t := by
    ext AB
    simp only [sourceLemma31TransitionPairs, Finset.mem_filter, Finset.mem_product]
    rw [sourceLemma31_transitionAt_iff G C AB.1 AB.2 v hv]
    simp [s, t]
  calc
    (sourceLemma31TransitionPairs G C v).card = (s.product t).card := congrArg Finset.card hfilter
    _ = s.card * t.card := Finset.card_product s t
    _ = sourceLemma31ComponentNeighborCount G C v *
        sourceLemma31ComponentNeighborCount G C (sourceLemma31CycleSucc G C v hv) := by
          simp only [sourceLemma31ComponentNeighborCount, s, t]

/-- A total notation for the successor, used only under sums restricted to the
cycle support.  Its off-cycle value is immaterial. -/
private noncomputable def sourceLemma31CycleSuccTotal [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (v : V) : V :=
  if hv : v ∈ C.support then sourceLemma31CycleSucc G C v hv else v

private theorem sourceLemma31CycleSuccTotal_eq [DecidableEq V] {r : V}
    (G : SimpleGraph V) (C : G.Walk r r) (v : V) (hv : v ∈ C.support) :
    sourceLemma31CycleSuccTotal G C v = sourceLemma31CycleSucc G C v hv := by
  simp [sourceLemma31CycleSuccTotal, hv]

/-- Double-counting the directed transitions gives the source Lemma 3.1
identity `E = ∑ᵥ f(v) f(v⁺)`, with the cycle support deduplicated by
`toFinset`. -/
private theorem sourceLemma31_global_transition_count_eq [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) :
    sourceLemma31GlobalTransitionCount G C =
      ∑ v in C.support.toFinset,
        sourceLemma31ComponentNeighborCount G C v *
          sourceLemma31ComponentNeighborCount G C
            (sourceLemma31CycleSuccTotal G C v) := by
  classical
  letI : Fintype (sourceLemma31OutsideGraph G C).ConnectedComponent := Fintype.ofFinite _
  let U : Finset (sourceLemma31OutsideGraph G C).ConnectedComponent := Finset.univ
  let S : Finset V := C.support.toFinset
  change (∑ A in U, ∑ B in U,
    (sourceLemma31TransitionVertices G C A B).card) = _
  have htransition_sum (A B : (sourceLemma31OutsideGraph G C).ConnectedComponent) :
      (sourceLemma31TransitionVertices G C A B).card =
        ∑ v in S, if sourceLemma31TransitionAt G C A B v then 1 else 0 := by
    simpa [S, sourceLemma31TransitionVertices] using
      (Finset.card_filter (sourceLemma31TransitionAt G C A B) C.support.toFinset)
  calc
    (∑ A in U, ∑ B in U,
        (sourceLemma31TransitionVertices G C A B).card) =
        ∑ A in U, ∑ B in U, ∑ v in S,
          if sourceLemma31TransitionAt G C A B v then 1 else 0 := by
            apply Finset.sum_congr rfl
            intro A hA
            apply Finset.sum_congr rfl
            intro B hB
            exact htransition_sum A B
    _ = ∑ A in U, ∑ v in S, ∑ B in U,
          if sourceLemma31TransitionAt G C A B v then 1 else 0 := by
            apply Finset.sum_congr rfl
            intro A hA
            exact Finset.sum_comm
    _ = ∑ v in S, ∑ A in U, ∑ B in U,
          if sourceLemma31TransitionAt G C A B v then 1 else 0 := by
            exact Finset.sum_comm
    _ = ∑ v in S,
        (sourceLemma31TransitionPairs G C v).card := by
            apply Finset.sum_congr rfl
            intro v hv
            rw [← Finset.sum_product']
            change (∑ AB in U.product U,
              if sourceLemma31TransitionAt G C AB.1 AB.2 v then 1 else 0) =
                (sourceLemma31TransitionPairs G C v).card
            simpa [U, sourceLemma31TransitionPairs] using
              (Finset.card_filter (fun AB :
                (sourceLemma31OutsideGraph G C).ConnectedComponent ×
                  (sourceLemma31OutsideGraph G C).ConnectedComponent =>
                sourceLemma31TransitionAt G C AB.1 AB.2 v) (U.product U)).symm
    _ = ∑ v in S,
        sourceLemma31ComponentNeighborCount G C v *
          sourceLemma31ComponentNeighborCount G C
            (sourceLemma31CycleSuccTotal G C v) := by
            apply Finset.sum_congr rfl
            intro v hv
            have hvC : v ∈ C.support := List.mem_toFinset.mp (by simpa [S] using hv)
            rw [sourceLemma31_transitionAt_pair_card_eq G C v
              hvC, sourceLemma31CycleSuccTotal_eq G C v hvC]

/-- The total number of directed transitions is at most the number of ordered
pairs of distinct outside components, namely `h (h - 1)`. -/
private theorem sourceLemma31_global_transition_count_le [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (hLongest : SourceLongestCycle G C) :
    sourceLemma31GlobalTransitionCount G C ≤
      sourceLemma31OutsideComponentCount G C *
        (sourceLemma31OutsideComponentCount G C - 1) := by
  classical
  letI : Fintype (sourceLemma31OutsideGraph G C).ConnectedComponent := Fintype.ofFinite _
  let U : Finset (sourceLemma31OutsideGraph G C).ConnectedComponent := Finset.univ
  change (∑ A in U, ∑ B in U,
    (sourceLemma31TransitionVertices G C A B).card) ≤ U.card * (U.card - 1)
  have hrow (A : (sourceLemma31OutsideGraph G C).ConnectedComponent) :
      (∑ B in U, (sourceLemma31TransitionVertices G C A B).card) ≤ (U.erase A).card := by
    rw [← U.sum_erase_add _ (show A ∈ U by simp [U])]
    rw [sourceLemma31_transitionVertices_loop_card_eq_zero G C hLongest A]
    simp only [add_zero]
    calc
      (∑ B in U.erase A, (sourceLemma31TransitionVertices G C A B).card) ≤
          ∑ _B in U.erase A, 1 := by
            apply Finset.sum_le_sum
            intro B hB
            exact sourceLemma31_transitionVertices_card_le_one G C hLongest A B
              (Finset.ne_of_mem_erase hB).symm
      _ = (U.erase A).card := by simp
  calc
    (∑ A in U, ∑ B in U, (sourceLemma31TransitionVertices G C A B).card) ≤
        ∑ A in U, (U.erase A).card := by
          apply Finset.sum_le_sum
          intro A hA
          exact hrow A
    _ = ∑ _A in U, (U.card - 1) := by
          apply Finset.sum_congr rfl
          intro A hA
          rw [Finset.card_erase_of_mem hA]
    _ = U.card * (U.card - 1) := by simp [Nat.mul_comm]

/-- The cycle vertices counted by the degree hypothesis of source Lemma 3.1. -/
private noncomputable def sourceLemma31HighDegreeVertices [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) : Finset V := by
  classical
  exact C.support.toFinset.filter fun v => 3 ≤ G.degree v

/-- The cycle vertices having no neighbour in the deleted outside graph. -/
private noncomputable def sourceLemma31ZeroOutsideVertices [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) : Finset V := by
  classical
  exact C.support.toFinset.filter fun v =>
    ∀ x, x ∉ C.support → ¬ G.Adj v x

/-- The source count `f(v)` vanishes exactly when the cycle vertex `v` has no
neighbour in `G - V(C)`.  The reverse implication uses the component containing
an arbitrary outside neighbour. -/
private theorem sourceLemma31_componentNeighborCount_eq_zero_iff [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) (v : V) (hv : v ∈ C.support) :
    sourceLemma31ComponentNeighborCount G C v = 0 ↔
      ∀ x, x ∉ C.support → ¬ G.Adj v x := by
  classical
  let H := sourceLemma31OutsideGraph G C
  letI : Fintype H.ConnectedComponent := Fintype.ofFinite _
  constructor
  · intro hcount x hxout hvx
    let xout : {x : V // x ∈ sourceLemma31OutsideVertices G C} := ⟨x, hxout⟩
    let A : H.ConnectedComponent := H.connectedComponentMk xout
    have hAadj : sourceLemma31ComponentAdjacent G C A v := by
      refine ⟨xout, ?_, hvx.symm⟩
      exact SimpleGraph.ConnectedComponent.connectedComponentMk_mem
    have hmem : A ∈ Finset.univ.filter (fun B => sourceLemma31ComponentAdjacent G C B v) :=
      Finset.mem_filter.mpr ⟨Finset.mem_univ _, hAadj⟩
    have hpos : 0 < (Finset.univ.filter (fun B => sourceLemma31ComponentAdjacent G C B v)).card :=
      Finset.card_pos.mpr ⟨A, hmem⟩
    have hzero : (Finset.univ.filter (fun B => sourceLemma31ComponentAdjacent G C B v)).card = 0 := by
      simpa [sourceLemma31ComponentNeighborCount] using hcount
    omega
  · intro hnone
    rw [sourceLemma31ComponentNeighborCount, Finset.card_eq_zero]
    apply Finset.eq_empty_iff_forall_not_mem.mpr
    intro A hA
    obtain ⟨x, hxA, hxv⟩ := (Finset.mem_filter.mp hA).2
    exact hnone x.1 x.2 hxv.symm

/-- Membership in the finite zero-outside set is the corresponding vanishing
condition for the source count. -/
private theorem sourceLemma31_mem_zeroOutsideVertices_iff [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r) (v : V) (hv : v ∈ C.support) :
    v ∈ sourceLemma31ZeroOutsideVertices G C ↔
      sourceLemma31ComponentNeighborCount G C v = 0 := by
  classical
  rw [sourceLemma31ZeroOutsideVertices, Finset.mem_filter]
  constructor
  · rintro ⟨_, hnone⟩
    exact (sourceLemma31_componentNeighborCount_eq_zero_iff G C v hv).mpr hnone
  · intro hcount
    exact ⟨List.mem_toFinset.mpr hv,
      (sourceLemma31_componentNeighborCount_eq_zero_iff G C v hv).mp hcount⟩

/-- Source Lemma 3.1, with both alternatives represented using exact natural
number inequalities. -/
theorem sourceLemma31_complete [Fintype V] [DecidableEq V]
    {r : V} (G : SimpleGraph V) (C : G.Walk r r)
    (hLongest : SourceLongestCycle G C) (k : ℕ)
    (hk : k ≤ (sourceLemma31HighDegreeVertices G C).card) :
    4 * k ≤ 9 * (sourceLemma31ZeroOutsideVertices G C).card ∨
      k ≤ 9 * (sourceLemma31OutsideComponentCount G C) ^ 2 := by
  classical
  let S : Finset V := C.support.toFinset
  let D := sourceLemma31HighDegreeVertices G C
  let Z := sourceLemma31ZeroOutsideVertices G C
  let f := sourceLemma31ComponentNeighborCount G C
  let succ := sourceLemma31CycleSuccTotal G C
  let t : V → ℕ := fun v => f v * f (succ v)
  let E := sourceLemma31GlobalTransitionCount G C
  let h := sourceLemma31OutsideComponentCount G C
  have hE : E = ∑ v in S, t v := by
    simpa [E, S, t, f, succ] using sourceLemma31_global_transition_count_eq G C
  have hEle : E ≤ h * (h - 1) := by
    simpa [E, h] using sourceLemma31_global_transition_count_le G C hLongest
  by_cases hlarge : k ≤ 9 * E
  · right
    calc
      k ≤ 9 * E := hlarge
      _ ≤ 9 * (h * (h - 1)) := Nat.mul_le_mul_left 9 hEle
      _ ≤ 9 * (h * h) := Nat.mul_le_mul_left 9 (Nat.mul_le_mul_left h (Nat.sub_le h 1))
      _ = 9 * h ^ 2 := by simp [pow_two]
  · left
    have hsmall : 9 * E < k := Nat.lt_of_not_ge hlarge
    let P : Finset V := D.filter fun v => 0 < t v
    let Q : Finset V := D.filter fun v => t v = 0
    have hPsubset : P ⊆ S := by
      intro v hv
      have hvD : v ∈ D := (Finset.mem_filter.mp hv).1
      have hvD' : v ∈ C.support.toFinset ∧ 3 ≤ G.degree v := by
        simpa only [D, sourceLemma31HighDegreeVertices, Finset.mem_filter] using hvD
      simpa only [S] using hvD'.1
    have hP_le_E : P.card ≤ E := by
      calc
        P.card = ∑ _v in P, 1 := by simp
        _ ≤ ∑ v in P, t v := by
          apply Finset.sum_le_sum
          intro v hv
