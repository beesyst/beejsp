    intro heq
    have ht := htransition v hv
    rw [← heq] at ht
    have hz := sourceLemma31_transitionVertices_loop_card_eq_zero G C hLongest (f v)
    have hp := Finset.card_pos.mpr ⟨v, ht⟩
    omega
  have hlabelinj : Set.InjOn label T := by
    intro u hu v hv huv
    have hfst : f u = f v := congrArg Prod.fst huv
    have hsnd : f (succ u) = f (succ v) := congrArg Prod.snd huv
    have ht := htransition v hv
    rw [← hfst, ← hsnd] at ht
    exact Finset.card_le_one.mp
      (sourceLemma31_transitionVertices_card_le_one G C hLongest _ _ (hne u hu))
      u (htransition u hu) v ht
  have hTle : T.card ≤ A.card * (A.card - 1) := by
    have hbound : T.card ≤ A.offDiag.card := by
      apply Finset.card_le_card_of_injOn label
      · intro v hv
        obtain ⟨hvP, hsP⟩ := Finset.mem_filter.mp hv
        exact Finset.mem_offDiag.mpr
          ⟨Finset.mem_image.mpr ⟨v, hvP, rfl⟩,
            Finset.mem_image.mpr ⟨succ v, hsP, rfl⟩, hne v hv⟩
      · exact hlabelinj
    rw [Finset.offDiag_card] at hbound
    have hmul : A.card * (A.card - 1) = A.card * A.card - A.card := by
      rw [Nat.mul_sub_left_distrib, Nat.mul_one]
    omega
  have hmany : 24 * sourceLemma36_c k ≤ A.card := by
    change 9 * Z.card < 4 * C.length at hZ
    have hsmall : C.length < 9 * T.card := by omega
    have hsq : A.card * (A.card - 1) ≤ A.card ^ 2 := by
      simpa [pow_two] using Nat.mul_le_mul_left A.card (Nat.sub_le A.card 1)
    have hlen : C.length < 9 * A.card ^ 2 :=
      hsmall.trans_le (Nat.mul_le_mul_left 9 (hTle.trans hsq))
    norm_num at hlarge
    by_contra hn
    have ha : A.card < 24 * sourceLemma36_c k := by omega
    have hsquare : A.card ^ 2 < (24 * sourceLemma36_c k) ^ 2 :=
