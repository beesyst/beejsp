    G C hC k hk Z data iP matching ladder i

/-- The geometric, unrooted part of a proper Section-2 truncation.  In
particular, no endpoint is required to belong to a designated root set. -/
private structure SourceLemma37UnrootedProperTruncation [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) where
  anchor : V
  anchor_mem : anchor ∈ C.support
  leftPosition : Fin k → Fin (sourceLemma36RotatedCycleOrder G C anchor).length
  rightPosition : Fin k → Fin (sourceLemma36RotatedCycleOrder G C anchor).length
  left_lt_right : ∀ i, leftPosition i < rightPosition i
  endpoint_order : ∀ {i j}, i < j → rightPosition i < leftPosition j
  attachment : ∀ i, G.Walk
    ((sourceLemma36RotatedCycleOrder G C anchor).get (leftPosition i))
    ((sourceLemma36RotatedCycleOrder G C anchor).get (rightPosition i))
  attachment_isPath : ∀ i, (attachment i).IsPath
  attachment_vertex_disjoint : ∀ {i j}, i ≠ j → ∀ v,
    v ∈ (attachment i).support → v ∈ (attachment j).support → False
  attachment_internal_disjoint_cycle : ∀ i,
    Disjoint (internalVertices G (attachment i)) {v | v ∈ C.support}
  attachment_edges_disjoint_cycle : ∀ i,
    Disjoint (attachment i).edges.toFinset C.edges.toFinset
  proper : ∀ i, (attachment i).length ≠
    (sourceOrientedCycleSubpath G C
      (hC.mem_support
        ((sourceLemma36RotatedCycleOrder G C anchor).get (leftPosition i)))
      (hC.mem_support
        ((sourceLemma36RotatedCycleOrder G C anchor).get (rightPosition i)))).length

/-- The unrooted Section-2 `k`-mesh needed in the CrossSide branch of source
Lemma 3.7.  The common coordinate lists the `u` attachments forward and the
`v` attachments backward; `R i` and `R' i` are consequently the two crossing
attachments of the displayed source cell. -/
private structure SourceLemma37UnrootedProperMesh [Fintype V] [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsHamiltonianCycle) (k : ℕ) where
  anchor : V
  anchor_mem : anchor ∈ C.support
  uFirst : Fin k →
    Fin (sourceLemma36RotatedCycleOrder G C anchor).length
  uSecond : Fin k →
    Fin (sourceLemma36RotatedCycleOrder G C anchor).length
  vFirst : Fin k →
    Fin (sourceLemma36RotatedCycleOrder G C anchor).length
  vSecond : Fin k →
    Fin (sourceLemma36RotatedCycleOrder G C anchor).length
  u_cell_order : ∀ i, uFirst i < uSecond i
  cell_separator : ∀ i, uSecond i < vSecond i
  v_cell_order : ∀ i, vSecond i < vFirst i
  u_global_order : ∀ {i j}, i < j → uSecond i < uFirst j
  v_global_order : ∀ {i j}, i < j → vFirst j < vSecond i
  R : Fin k → SourceLemma34Chord G C
  R' : Fin k → SourceLemma34Chord G C
  R_fst : ∀ i, (R i).fst =
    (sourceLemma36RotatedCycleOrder G C anchor).get (uFirst i)
  R_snd : ∀ i, (R i).snd =
    (sourceLemma36RotatedCycleOrder G C anchor).get (vSecond i)
  R'_fst : ∀ i, (R' i).fst =
    (sourceLemma36RotatedCycleOrder G C anchor).get (uSecond i)
  R'_snd : ∀ i, (R' i).snd =
    (sourceLemma36RotatedCycleOrder G C anchor).get (vFirst i)
  cell_attachment_disjoint : ∀ i, Disjoint
    ({(R i).fst, (R i).snd} : Set V) ({(R' i).fst, (R' i).snd} : Set V)
  cross_cell_attachment_disjoint : ∀ {i j}, i ≠ j →
    Disjoint ({(R i).fst, (R i).snd} : Set V) ({(R j).fst, (R j).snd} : Set V) ∧
      Disjoint ({(R i).fst, (R i).snd} : Set V) ({(R' j).fst, (R' j).snd} : Set V) ∧
      Disjoint ({(R' i).fst, (R' i).snd} : Set V) ({(R j).fst, (R j).snd} : Set V) ∧
      Disjoint ({(R' i).fst, (R' i).snd} : Set V) ({(R' j).fst, (R' j).snd} : Set V)
  R_internal_disjoint_cycle : ∀ i,
    Disjoint (internalVertices G (Walk.cons (R i).adj .nil)) {v | v ∈ C.support}
  R'_internal_disjoint_cycle : ∀ i,
    Disjoint (internalVertices G (Walk.cons (R' i).adj .nil)) {v | v ∈ C.support}
  proper : ∀ i,
    1 + 1 ≠
      (sourceOrientedCycleSubpath G C
        (hC.mem_support ((sourceLemma36RotatedCycleOrder G C anchor).get (uFirst i)))
        (hC.mem_support ((sourceLemma36RotatedCycleOrder G C anchor).get (uSecond i)))).length +
      (sourceOrientedCycleSubpath G C
        (hC.mem_support ((sourceLemma36RotatedCycleOrder G C anchor).get (vSecond i)))
        (hC.mem_support ((sourceLemma36RotatedCycleOrder G C anchor).get (vFirst i)))).length

/-- The only girth input needed by a CrossSide mesh cell.  If both source
cycle arcs in an alternating pair had length one, the two chords and those
two cycle edges would be a simple four-cycle. -/
private theorem sourceLemma37_crossing_unit_cell_contradicts_girth
    [DecidableEq V] {r : V} (C : G.Walk r r) (hC : C.IsHamiltonianCycle)
    (hgirth : 5 ≤ G.girth) (e f : SourceLemma34Chord G C)
    (hcross : sourceLemma34Crosses G C hC.isCycle e f)
    {u₁ u₂ v₂ v₁ : V}
    (hefst : e.fst = v₂) (hesnd : e.snd = u₁)
    (hffst : f.fst = v₁) (hfsnd : f.snd = u₂)
    (hS : (sourceOrientedCycleSubpath G C
      (hC.mem_support u₁) (hC.mem_support u₂)).length = 1)
    (hS' : (sourceOrientedCycleSubpath G C
      (hC.mem_support v₂) (hC.mem_support v₁)).length = 1) : False := by
  have hSedge : s(u₁, u₂) ∈ C.edges := by
    apply sourceLemma34_oriented_subpath_edges_subset G C
      (hC.mem_support u₁) (hC.mem_support u₂)
    exact sourceLemma36_edge_mem_edges_of_length_one G _ hS

  have hS'edge : s(v₂, v₁) ∈ C.edges := by
    apply sourceLemma34_oriented_subpath_edges_subset G C
      (hC.mem_support v₂) (hC.mem_support v₁)
    exact sourceLemma36_edge_mem_edges_of_length_one G _ hS'

  have hu : G.Adj u₁ u₂ := by
    exact (SimpleGraph.mem_edgeSet G).mp
      (C.edges_subset_edgeSet hSedge)

  have hv : G.Adj v₂ v₁ := by
    exact (SimpleGraph.mem_edgeSet G).mp
      (C.edges_subset_edgeSet hS'edge)

  have hdis :=
    sourceLemma34_crosses_endpoint_disjoint G C hC.isCycle e f hcross

  have hfAdj : G.Adj v₁ u₂ := by
    simpa [hffst, hfsnd] using f.adj

  let Q : G.Walk v₂ u₁ :=
    Walk.cons hv (Walk.cons hfAdj (Walk.cons hu.symm .nil))

  have hQpath : Q.IsPath := by
    rw [show Q =
      Walk.cons hv (Walk.cons hfAdj (Walk.cons hu.symm .nil)) by rfl,
      Walk.cons_isPath_iff]
    refine ⟨?_, ?_⟩
    · rw [Walk.cons_isPath_iff]
      refine ⟨?_, ?_⟩
      · rw [Walk.cons_isPath_iff]
        constructor
        · exact Walk.IsPath.nil
        · simpa only [Walk.support_nil, List.mem_cons,
            List.not_mem_nil, or_false] using hu.ne.symm
      · simp only [Walk.support_cons, Walk.support_nil, List.mem_cons,
          List.not_mem_nil, or_false]
        intro h
        rcases h with h | h
        · exact f.adj.ne (by
            simpa [hffst, hfsnd] using h)
        · exact hdis.2.1 (by
            simpa [hffst, hesnd] using h)
    · simp only [Walk.support_cons, Walk.support_nil, List.mem_cons,
        List.not_mem_nil, or_false]
      intro h
      rcases h with h | h | h
      · exact hdis.1 (by
          simpa [hffst, hefst] using h.symm)
      · exact hdis.2.2.1 (by
          simpa [hfsnd, hefst] using h.symm)
      · exact e.adj.ne (by
          simpa [hefst, hesnd] using h)

  have hclosing : s(u₁, v₂) ∉ Q.edges := by
    intro hedge
    change s(u₁, v₂) ∈
      [s(v₂, v₁), s(v₁, u₂), s(u₂, u₁)] at hedge
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hedge
    rcases hedge with h | h | h
    · apply e.not_cycle_edge
      change s(e.fst, e.snd) ∈ C.edges
      rw [hefst, hesnd, Sym2.eq_swap, h]
      exact hS'edge

    · rw [Sym2.eq_iff] at h
      rcases h with h | h
      · exact hdis.2.1 (by
          simpa [hffst, hesnd] using h.1.symm)
      · exact hdis.2.2.2 (by
          simpa [hfsnd, hesnd] using h.1.symm)

    · apply e.not_cycle_edge
      change s(e.fst, e.snd) ∈ C.edges
      rw [hefst, hesnd, Sym2.eq_swap, h, Sym2.eq_swap]
      exact hSedge

  have hcloseAdj : G.Adj u₁ v₂ := by
    simpa [hefst, hesnd] using e.adj.symm

  let Qp : G.Path v₂ u₁ := ⟨Q, hQpath⟩

  have hfourCycle : (Walk.cons hcloseAdj Qp.1).IsCycle :=
    Path.cons_isCycle Qp hcloseAdj hclosing

  have hfourLength : (Walk.cons hcloseAdj Qp.1).length = 4 := by
    simp [Qp, Q]

  have hegirth :
      G.egirth ≤ (Walk.cons hcloseAdj Qp.1).length :=
    (SimpleGraph.le_egirth.mp le_rfl) _ _ hfourCycle

  have hgirth_le :
      G.girth ≤ (Walk.cons hcloseAdj Qp.1).length := by
    rw [SimpleGraph.girth]
    exact ENat.toNat_le_of_le_coe hegirth

  omega

/-- A chord family with already-certified cyclic endpoint order gives an
unrooted proper truncation.  Properness is the direct Section-2 observation:
a one-edge chord cannot equal a one-edge cycle subpath. -/
private noncomputable def sourceLemma37_chord_family_yields_unrooted_proper_truncation
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    (hC : C.IsHamiltonianCycle) (k : ℕ) (anchor : V) (hanchor : anchor ∈ C.support)
    (f : Fin k → SourceLemma34Chord G C)
    (leftPosition rightPosition : Fin k →
      Fin (sourceLemma36RotatedCycleOrder G C anchor).length)
    (hleft : ∀ i, (sourceLemma36RotatedCycleOrder G C anchor).get (leftPosition i) = (f i).fst)
    (hright : ∀ i, (sourceLemma36RotatedCycleOrder G C anchor).get (rightPosition i) = (f i).snd)
    (hleft_lt_right : ∀ i, leftPosition i < rightPosition i)
    (hendpoint_order : ∀ {i j}, i < j → rightPosition i < leftPosition j)
    (hdisjoint : ∀ {i j}, i ≠ j → ∀ v,
      v = (f i).fst ∨ v = (f i).snd → v = (f j).fst ∨ v = (f j).snd → False) :
    SourceLemma37UnrootedProperTruncation G C hC k := by
  let attachment : ∀ i, G.Walk (f i).fst (f i).snd := fun i => Walk.cons (f i).adj .nil
  refine {
    anchor := anchor
    anchor_mem := hanchor
    leftPosition := leftPosition
    rightPosition := rightPosition
    left_lt_right := hleft_lt_right
    endpoint_order := hendpoint_order
    attachment := fun i => (attachment i).copy (hleft i).symm (hright i).symm
    attachment_isPath := ?_
    attachment_vertex_disjoint := ?_
    attachment_internal_disjoint_cycle := ?_
    attachment_edges_disjoint_cycle := ?_
    proper := ?_ }
  · intro i
    rw [Walk.isPath_copy]
    rw [show attachment i = Walk.cons (f i).adj .nil by rfl, Walk.cons_isPath_iff]
    constructor
    · exact Walk.IsPath.nil
    · simpa only [Walk.support_nil, List.mem_cons, List.not_mem_nil, or_false] using (f i).adj.ne
  · intro i j hij v hvi hvj
    have hviAttachment : v ∈ (attachment i).support := by
      simpa only [Walk.support_copy] using hvi
    have hvi' : v = (f i).fst ∨ v = (f i).snd := by
      rw [show attachment i = Walk.cons (f i).adj .nil by rfl] at hviAttachment
      simpa only [Walk.support_cons, Walk.support_nil, List.mem_cons,
        List.not_mem_nil, or_false] using hviAttachment
    have hvjAttachment : v ∈ (attachment j).support := by
      simpa only [Walk.support_copy] using hvj
    have hvj' : v = (f j).fst ∨ v = (f j).snd := by
      rw [show attachment j = Walk.cons (f j).adj .nil by rfl] at hvjAttachment
      simpa only [Walk.support_cons, Walk.support_nil, List.mem_cons,
        List.not_mem_nil, or_false] using hvjAttachment
    exact hdisjoint hij v hvi' hvj'
  · intro i
    rw [show attachment i = Walk.cons (f i).adj .nil by rfl,
      sourceLemma36_internalVertices_empty_of_length_one G _ (by simp)]
    exact Set.empty_disjoint _
  · intro i
    rw [Walk.edges_copy]
    apply Finset.disjoint_left.mpr
    intro e he heC
    have heq : e = s((f i).fst, (f i).snd) := by simpa [attachment] using he
    subst e
    exact (f i).not_cycle_edge (List.mem_toFinset.mp heC)
  · intro i hlength
    have hone : (attachment i).length = 1 := by simp [attachment]
    let u := (sourceLemma36RotatedCycleOrder G C anchor).get (leftPosition i)
    let v := (sourceLemma36RotatedCycleOrder G C anchor).get (rightPosition i)
    let P := sourceOrientedCycleSubpath G C (hC.mem_support u) (hC.mem_support v)
    have hPone : P.length = 1 := by
      dsimp [P]
      calc
        _ = ((attachment i).copy (hleft i).symm (hright i).symm).length :=
          hlength.symm
        _ = (attachment i).length := by
          simp only [Walk.length_copy]
        _ = 1 := hone
    have hedgeP : s(u, v) ∈ P.edges := by
      dsimp [P]
      exact sourceLemma36_edge_mem_edges_of_length_one G _ hPone
    have hedgeC : s(u, v) ∈ C.edges := by
      dsimp [P] at hedgeP
      exact sourceLemma34_oriented_subpath_edges_subset G C
        (hC.mem_support u) (hC.mem_support v) _ hedgeP
    have hu : u = (f i).fst := by
      dsimp [u]
      exact hleft i
    have hv : v = (f i).snd := by
      dsimp [v]
      exact hright i
    rw [hu, hv] at hedgeC
    exact (f i).not_cycle_edge hedgeC

/-- Every `Qu` block lies in the canonical cycle piece. -/
private theorem sourceLemma37_mem_Qu_canonical
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching)
    (i : Fin (2 * k - 1)) (x : V)
    (hx : x ∈ (sourceLemma37Qu G C k Z data iP matching ladder i).support) :
    x ∈ sourceLemma36CanonicalPieceVertices G C hC k Z data iP := by
  obtain ⟨p, hpfirst, hplast, hpget⟩ :=
    (sourceLemma37Qu_support_iff G C k Z data iP matching ladder i x).mp hx
  apply sourceLemma36_positionSubpath_support_subset_canonicalPiece
    G C hC k Z data iP
    (sourceLemma37_firstPosition_mem_canonicalCore G C k Z data iP matching ladder
      (sourceLemma37BlockLastIndex k i))
    (sourceLemma37_firstPosition_mem_canonicalCore G C k Z data iP matching ladder
      (sourceLemma37BlockFirstIndex k i))
    (by
      have hindex : sourceLemma37BlockFirstIndex k i < sourceLemma37BlockLastIndex k i :=
        lt_of_le_of_lt (sourceLemma37_block_indices k hk i).1
          (sourceLemma37_block_indices k hk i).2
      exact (ladder.first_arc_order _ _ hindex).le)
  have hmem := sourceLemma36_position_mem_subpath G C hC data.anchor
    (ladder.firstPosition (sourceLemma37BlockLastIndex k i))
    (ladder.firstPosition (sourceLemma37BlockFirstIndex k i))
    p hpfirst hplast
  rw [hpget] at hmem
  exact hmem

/-- Every `Qv` block lies outside the canonical cycle piece. -/
private theorem sourceLemma37_mem_Qv_outside_canonical
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching)
    (i : Fin (2 * k - 1)) (x : V)
    (hx : x ∈ (sourceLemma37Qv G C k Z data iP matching ladder i).support) :
    x ∉ sourceLemma36CanonicalPieceVertices G C hC k Z data iP := by
  obtain ⟨s, _, _, hsget⟩ :=
    (sourceLemma37Qv_support_iff G C k hk Z data iP matching ladder i x).mp hx
  apply (sourceLemma36_mem_complementOrderAt_iff G C hC k Z data iP x).mp
  rw [← hsget]
  exact List.get_mem _ _

/-- A first-side `Qu` block and a second-side `Qv` block never share a cycle
vertex; this is the cross-family part of SameSide attachment separation. -/
private theorem sourceLemma37_Qu_Qv_disjoint
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching)
    (i j : Fin (2 * k - 1)) :
    Disjoint (↑(sourceLemma37Qu G C k Z data iP matching ladder i).support.toFinset : Set V)
      (↑(sourceLemma37Qv G C k Z data iP matching ladder j).support.toFinset : Set V) := by
  apply Set.disjoint_left.mpr
  intro x hxQu hxQv
  have hxQu' : x ∈ (sourceLemma37Qu G C k Z data iP matching ladder i).support := by
    simpa using hxQu
  have hxQv' : x ∈ (sourceLemma37Qv G C k Z data iP matching ladder j).support := by
    simpa using hxQv
  exact (sourceLemma37_mem_Qv_outside_canonical G C k hk Z data iP matching ladder j x hxQv')
    (sourceLemma37_mem_Qu_canonical G C k hk Z data iP matching ladder i x hxQu')

/-- Distinct residual `Qu` blocks are separated intervals in the first
cycle coordinate. -/
private theorem sourceLemma37_blockLast_lt_blockFirst_of_lt
    (k : ℕ) (hk : 1 ≤ k)
    {i j : Fin (2 * k - 1)} (hij : i < j) :
    sourceLemma37BlockLastIndex k i <
      sourceLemma37BlockFirstIndex k j := by
  apply Fin.mk_lt_mk.mpr
  dsimp [sourceLemma37BlockLastIndex, sourceLemma37BlockFirstIndex]
  have hijle : i.1 + 1 ≤ j.1 := by
    omega
  have hmul : 2 * (i.1 + 1) * k ≤ 2 * j.1 * k := by
    exact Nat.mul_le_mul_right k (Nat.mul_le_mul_left 2 hijle)
  have hi' : 0 < i.1 + 1 := by
    omega
  have hk' : 0 < k := by
    omega
  have hpositive : 0 < 2 * (i.1 + 1) * k := by
    exact Nat.mul_pos (Nat.mul_pos (by omega) hi') hk'
  omega
private theorem sourceLemma37_Qu_disjoint
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r)
    {hC : C.IsHamiltonianCycle} (k : ℕ) (hk : 1 ≤ k) (Z : Finset V)
    (data : SourceLemma36PartitionData G C hC k Z) (iP : Fin k)
    (matching : SourceLemma36CaseBMatchingData
      (sourceLemma36CaseBCandidateEdgesAt G C hC k Z data iP))
    (ladder : SourceLemma36FourKSquaredLadder G C k Z data iP matching)
    (i j : Fin (2 * k - 1)) (hij : i ≠ j) :
    Disjoint (↑(sourceLemma37Qu G C k Z data iP matching ladder i).support.toFinset : Set V)
      (↑(sourceLemma37Qu G C k Z data iP matching ladder j).support.toFinset : Set V) := by
  apply Set.disjoint_left.mpr
  intro x hxI hxJ
  have hxI' : x ∈ (sourceLemma37Qu G C k Z data iP matching ladder i).support := by
    simpa using hxI
  have hxJ' : x ∈ (sourceLemma37Qu G C k Z data iP matching ladder j).support := by
    simpa using hxJ
  obtain ⟨p, hpLower, hpUpper, hpGet⟩ :=
    (sourceLemma37Qu_support_iff G C k Z data iP matching ladder i x).mp hxI'
  obtain ⟨q, hqLower, hqUpper, hqGet⟩ :=
    (sourceLemma37Qu_support_iff G C k Z data iP matching ladder j x).mp hxJ'
  have hpq : p = q := List.nodup_iff_injective_get.mp
    (sourceLemma36_rotatedCycleOrder_nodup G C hC data.anchor)
