    intro i
    by_cases hlt : p i < q i <;> simp [leftPosition, hlt, hp, hq]
  have hright_mem : ∀ i, rightPosition i ∈ data.corePositions i := by
    intro i
    by_cases hlt : p i < q i <;> simp [rightPosition, hlt, hp, hq]
  have hleft_lt_right : ∀ i, leftPosition i < rightPosition i := by
    intro i
    by_cases hlt : p i < q i
    · simpa [leftPosition, rightPosition, hlt] using hlt
    · have hgt : q i < p i := lt_of_le_of_ne (le_of_not_gt hlt) (hpq_ne i).symm
