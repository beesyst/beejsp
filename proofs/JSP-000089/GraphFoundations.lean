/-- Outside-cycle interiors and component-disjoint replacements preserve the
exact Section-2 crossing-path incidence, including its two endpoints. -/
private theorem sourceLemma39_cross_path_carrier_intersection
    [Fintype V] [DecidableEq V] {r u v : V} (C : G.Walk r r) {k : ℕ}
    (a b : Fin k → V) (ha : ∀ i, a i ∈ C.support) (hb : ∀ i, b i ∈ C.support)
    (rungs : ∀ i, G.Walk (a i) (b i)) (Q : G.Walk u v)
    (hu : u ∈ C.support) (hv : v ∈ C.support)
    (hout : Disjoint (internalVertices G Q) {w | w ∈ C.support})
    (hdis : ∀ i, Disjoint (internalVertices G Q) (internalVertices G (rungs i))) :
    Q.support.toFinset ∩ (C.support.toFinset ∪ Finset.univ.biUnion
      fun i => (rungs i).support.toFinset) = {u, v} := by
  classical
  ext w
  simp only [Finset.mem_inter, Finset.mem_union, Finset.mem_biUnion,
    Finset.mem_univ, true_and, List.mem_toFinset, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · rintro ⟨hwQ, hwC | ⟨i, hwrung⟩⟩
    · by_contra h
      push_neg at h
      exact Set.disjoint_left.mp hout ⟨hwQ, h.1, h.2⟩ hwC
    · by_contra h
      push_neg at h
      have hwint : w ∈ internalVertices G Q := ⟨hwQ, h.1, h.2⟩
      have hwout : w ∉ C.support := fun hwC => Set.disjoint_left.mp hout hwint hwC
      exact Set.disjoint_left.mp (hdis i) hwint
        ⟨hwrung, fun h => hwout (h.symm ▸ ha i), fun h => hwout (h.symm ▸ hb i)⟩
  · rintro (rfl | rfl)
    · exact ⟨Q.start_mem_support, Or.inl hu⟩
    · exact ⟨Q.end_mem_support, Or.inl hv⟩

/-- Interior disjointness alone leaves exactly the endpoint-edge collision. -/
theorem sourceLemma23_path_edges_disjoint_cycle_iff [DecidableEq V]
    {r a b : V} (C : G.Walk r r) (P : G.Walk a b)
    (hout : Disjoint (internalVertices G P) {v | v ∈ C.support}) :
    Disjoint P.edges.toFinset C.edges.toFinset ↔
      ¬ (s(a,b) ∈ P.edges ∧ s(a,b) ∈ C.edges) := by
  constructor
  · intro hd he
    exact Finset.disjoint_left.mp hd (List.mem_toFinset.mpr he.1)
      (List.mem_toFinset.mpr he.2)
  · intro hn
    apply Finset.disjoint_left.mpr
    intro e hp hc
    have he := sourceLemma21_common_edge_eq_endpoint_edge G C P hout
      (List.mem_toFinset.mp hp) (List.mem_toFinset.mp hc)
    exact hn ⟨he ▸ List.mem_toFinset.mp hp, he ▸ List.mem_toFinset.mp hc⟩

/-- Disjoint supports exclude common physical edges, irrespective of path lengths. -/
theorem sourceLemma23_edges_disjoint_of_support_disjoint [DecidableEq V]
    {a b c d : V} (P : G.Walk a b) (Q : G.Walk c d)
    (hdis : Disjoint {z | z ∈ P.support} {z | z ∈ Q.support}) :
    Disjoint P.edges.toFinset Q.edges.toFinset := by
  apply Finset.disjoint_left.mpr
  intro e hp hq
  induction e using Sym2.inductionOn with
  | hf x y =>
    exact Set.disjoint_left.mp hdis
      (P.fst_mem_support_of_mem_edges (List.mem_toFinset.mp hp))
      (Q.fst_mem_support_of_mem_edges (List.mem_toFinset.mp hq))

/-- Separate interiors and unequal endpoint edges exclude even one-edge reuse. -/
theorem sourceLemma23_path_edges_disjoint_of_endpoint_edges_ne [DecidableEq V]
    {r a b c d : V} (C : G.Walk r r) (P : G.Walk a b) (Q : G.Walk c d)
    (ha : a ∈ C.support) (hb : b ∈ C.support)
    (hc : c ∈ C.support) (hd : d ∈ C.support)
    (houtP : Disjoint (internalVertices G P) {z | z ∈ C.support})
    (houtQ : Disjoint (internalVertices G Q) {z | z ∈ C.support})
    (hPQ : Disjoint (internalVertices G P) (internalVertices G Q))
    (hne : s(a,b) ≠ s(c,d)) : Disjoint P.edges.toFinset Q.edges.toFinset := by
  have interior (z : V) (hzP : z ∈ P.support) (hzQ : z ∈ Q.support) : z ∈ C.support := by
    by_contra hzC
    exact Set.disjoint_left.mp hPQ
      ⟨hzP, fun he => hzC (he ▸ ha), fun he => hzC (he ▸ hb)⟩
      ⟨hzQ, fun he => hzC (he ▸ hc), fun he => hzC (he ▸ hd)⟩
  apply Finset.disjoint_left.mpr
  intro e heP heQ
  have hp := List.mem_toFinset.mp heP
  have hq := List.mem_toFinset.mp heQ
  induction e using Sym2.inductionOn with
  | hf x y =>
    have hxP := P.fst_mem_support_of_mem_edges hp
    have hyP := P.snd_mem_support_of_mem_edges hp
    have hxQ := Q.fst_mem_support_of_mem_edges hq
    have hyQ := Q.snd_mem_support_of_mem_edges hq
    have hxC := interior x hxP hxQ
    have hyC := interior y hyP hyQ
    have endsP (z : V) (hzP : z ∈ P.support) (hzC : z ∈ C.support) : z = a ∨ z = b := by
      by_contra hn; push_neg at hn
      exact Set.disjoint_left.mp houtP ⟨hzP, hn.1, hn.2⟩ hzC
    have endsQ (z : V) (hzQ : z ∈ Q.support) (hzC : z ∈ C.support) : z = c ∨ z = d := by
      by_contra hn; push_neg at hn
      exact Set.disjoint_left.mp houtQ ⟨hzQ, hn.1, hn.2⟩ hzC
    have hxy := (P.adj_of_mem_edges hp).ne
    have ep : s(x,y) = s(a,b) := by
      rcases endsP x hxP hxC with rfl | rfl <;> rcases endsP y hyP hyC with rfl | rfl
      · exact (hxy rfl).elim
      · rfl
      · exact Sym2.eq_swap
      · exact (hxy rfl).elim
    have eq : s(x,y) = s(c,d) := by
      rcases endsQ x hxQ hxC with rfl | rfl <;> rcases endsQ y hyQ hyC with rfl | rfl
      · exact (hxy rfl).elim
      · rfl
      · exact Sym2.eq_swap
      · exact (hxy rfl).elim
    exact hne (ep.symm.trans eq)

private theorem sourceLemma23_rooted_family_edges_ne
    [Fintype V] [DecidableEq V] {r : V} (C : G.Walk r r) {n : ℕ}
    (family : SourceLemma38RootedK4Family G C n) (i j : Fin n) (hij : i ≠ j)
    (a b : V) (ha : a ∈ family.vertices i) (hia : family.root i ≠ a) :
    s(family.root i,a) ≠ s(family.root j,b) := by
  intro he
  rcases Sym2.eq_iff.mp he with he | he
  · exact hij (family.root_injective he.1)
  · have hadj := family.complete i (family.root_mem i) ha hia
    have hoff := family.off_cycle i (family.root_mem i) ha hia
    have hrootadj : (sourceLemma36OffCycleGraph G C).Adj (family.root i) (family.root j) := by
      change (s(family.root i,family.root j) ∈ G.edgeSet ∧
        s(family.root i,family.root j) ∉ C.edges) ∧ family.root i ≠ family.root j
      rw [← he.2]
      exact ⟨⟨G.mem_edgeSet.mpr hadj, hoff⟩, hia⟩
    exact family.roots_independent
      (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩)
      (Finset.mem_image.mpr ⟨j, Finset.mem_univ _, rfl⟩)
      (fun h => hij (family.root_injective h)) hrootadj

/-- The source Section-2 k-crossladder in the ambient graph. Rail interval
membership records the visits u₁,…,uₖ,vₖ,…,v₁ on the directed cycle.
The crossing path meets the entire cycle-plus-rungs carrier exactly at its
endpoints. Hamiltonicity of the ambient graph is not required. -/
