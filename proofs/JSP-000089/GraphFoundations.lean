    intro z hz
    exact (hcommon z hz).2.1
  have hFtwo : 2 ≤ F.card := by
    have hbound : 2 ≤ 2 * (k^2 + 2) := by omega
    exact hbound.trans hFcard
  obtain ⟨x, y, px, py, hpx, hpy, hpxpy, hpxget, hpyget, hxF, hyF, hxy, hFpath⟩ :=
    sourceLemma36_exists_extremalFiberSubpath G C hC k Z data iP F hFpiece hFtwo
