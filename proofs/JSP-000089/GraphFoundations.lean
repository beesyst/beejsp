      z = L.u ∨ z = L.v := by
    have hz : z ∈ L.q.support.toFinset ∩
        (C.support.toFinset ∪ Finset.univ.biUnion fun j => (L.rung j).support.toFinset) :=
      Finset.mem_inter.mpr ⟨List.mem_toFinset.mpr hzQ,
        Finset.mem_union_right _ (Finset.mem_biUnion.mpr
          ⟨i, Finset.mem_univ _, List.mem_toFinset.mpr hzR⟩)⟩
    rw [L.q_inter_ladder] at hz
    simpa only [Finset.mem_insert, Finset.mem_singleton] using hz
  constructor
  · intro hd he
    exact Finset.disjoint_left.mp hd (List.mem_toFinset.mpr he.1)
      (List.mem_toFinset.mpr he.2)
  · intro hn
    apply Finset.disjoint_left.mpr
    intro e heQ heR
    have hp := List.mem_toFinset.mp heQ
    have hr := List.mem_toFinset.mp heR
    have he : e = s(L.u,L.v) := by
      induction e using Sym2.inductionOn with
      | hf x y =>
        have hx := meet x (L.q.fst_mem_support_of_mem_edges hp)
          ((L.rung i).fst_mem_support_of_mem_edges hr)
        have hy := meet y (L.q.snd_mem_support_of_mem_edges hp)
          ((L.rung i).snd_mem_support_of_mem_edges hr)
        have hxy := (L.q.adj_of_mem_edges hp).ne
        rcases hx with rfl | rfl <;> rcases hy with rfl | rfl
        · exact (hxy rfl).elim
        · rfl
        · exact Sym2.eq_swap
        · exact (hxy rfl).elim
    exact hn ⟨he ▸ hp, he ▸ hr⟩


