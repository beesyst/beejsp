/-- Deleting the strict interior of either chord side leaves every surviving
boundary vertex on the complementary side. -/
private theorem sourceLemma34_mem_complement_of_not_strict_inside [DecidableEq V]
    {r : V} (C : G.Walk r r) (hC : C.IsCycle)
    (e : SourceLemma34Chord G C) (dir : Bool) (x : V)
    (hx : x ∈ C.support)
    (hnot : ¬ sourceLemma34SideStrictInside G
      (sourceLemma34_orientedSide G C hC e dir) x) :
    x ∈ (sourceLemma34_orientedSide G C hC e (!dir)).path.support := by
  let R : G.Walk e.fst e.fst := C.rotate e.fst_mem
  have hsndR : e.snd ∈ R.support := sourceLemma34_snd_mem_rotate G C e
  let Q : G.Walk e.fst e.snd := R.takeUntil e.snd hsndR
  let P : G.Walk e.snd e.fst := R.dropUntil e.snd hsndR
  have hsplit : Q.append P = R := by
    dsimp [Q, P]
    exact R.take_spec hsndR
  have hxR : x ∈ R.support := by
    have hxSplit : x ∈ (C.takeUntil e.fst e.fst_mem).support ∨
        x ∈ (C.dropUntil e.fst e.fst_mem).support := by
      rw [← Walk.mem_support_append_iff, C.take_spec e.fst_mem]
      exact hx
    dsimp [R, Walk.rotate]
    rw [Walk.mem_support_append_iff]
    exact hxSplit.symm
  have hxQP : x ∈ Q.support ∨ x ∈ P.support := by
    rw [← Walk.mem_support_append_iff, hsplit]
    exact hxR
  cases dir with
  | false =>
      rcases hxQP with hxQ | hxP
      · have hboundary : x = e.fst ∨ x = e.snd := by
          by_cases hfst : x = e.fst
          · exact Or.inl hfst
          by_cases hsnd : x = e.snd
          · exact Or.inr hsnd
          exact (hnot (by
            simpa [sourceLemma34_orientedSide, Q] using And.intro hxQ ⟨hfst, hsnd⟩)).elim
        rcases hboundary with rfl | rfl
        · change e.fst ∈ P.reverse.support
          rw [Walk.support_reverse, List.mem_reverse]
          exact P.end_mem_support
        · change e.snd ∈ P.reverse.support
          rw [Walk.support_reverse, List.mem_reverse]
          exact P.start_mem_support
      · change x ∈ P.reverse.support
        rw [Walk.support_reverse, List.mem_reverse]
        exact hxP
  | true =>
      rcases hxQP with hxQ | hxP
      · change x ∈ Q.support
        exact hxQ
      · have hxPrev : x ∈ P.reverse.support := by
          rw [Walk.support_reverse, List.mem_reverse]
          exact hxP
        have hboundary : x = e.fst ∨ x = e.snd := by
          by_cases hfst : x = e.fst
          · exact Or.inl hfst
          by_cases hsnd : x = e.snd
          · exact Or.inr hsnd
          exact (hnot (by
            change x ∈ P.reverse.support ∧ x ≠ e.fst ∧ x ≠ e.snd
            exact ⟨hxPrev, hfst, hsnd⟩)).elim
        change x ∈ Q.support
        rcases hboundary with rfl | rfl
        · exact Q.start_mem_support
        · exact Q.end_mem_support
