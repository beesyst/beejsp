  have hcards : cards.Nonempty := ⟨0, Finset.mem_image.mpr ⟨∅, hempty, rfl⟩⟩
  let m := cards.max' hcards
  have hm : m ∈ cards := cards.max'_mem hcards
  let P : Finset (V × V) := (Finset.mem_image.mp hm).choose
  have hPmatching : P ∈ matchings := (Finset.mem_image.mp hm).choose_spec.1
  have hPcard : P.card = m := (Finset.mem_image.mp hm).choose_spec.2
